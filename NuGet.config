<?xml version="1.0" encoding="utf-8"?>
<!-- nuget.org is nodig om de MySQL-driver (MySqlConnector) op te halen.
     De server heeft dus internettoegang nodig bij de eerste build/restore. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
