@page "/tools/licenties"
@inject MPedeLicenties Lic
@inject HuidigeGebruiker Ik
@inject IJSRuntime JS
@inject NavigationManager Nav

@* Tools ▸ Licenties (wens gebruiker 25-11-2026): een tegel per product waarvoor MDE licentiecodes uitgeeft. Als eerste
   M-Pede Robotics (Services/Licenties.cs, overgenomen uit MPR_DebugTool.pyw van Gerard); Padplanning staat er al als
   tegel die nog niets doet. Welke tegel open staat volgt uit het adres (?product=mpede).

   M-Pede: rechts de lijst, links de gegevens van de gekozen regel (zoals in het Python-programma), met daaronder de
   knop voor een nieuwe licentie. Die opent een venster: producttype en serienummer van de robot (typen, of de QR-code
   op de robot met de telefoon fotograferen), waarna het serienummer van de vierde drive uit Producten komt.
   Toegang: het recht Licenties (Werknemers ▸ Rechten) of Directie. Een code komt nooit in het logboek. *@

<PageTitle>Licenties — MDE</PageTitle>

<div class="page cs-pagina lc-pagina">
    <header class="topbar">
        <h1>Licenties</h1>
        <span class="weeklabel">@(ProductParam == "mpede" ? "M-Pede Robotics" : "licentiecodes maken en terugvinden")</span>
    </header>

    @if (_melding is not null)
    {
        <div class="melding @(_fout ? "fout" : "ok")" style="position:static;max-width:none" @onclick="() => _melding = null">@_melding</div>
    }

    @if (!_geladen)
    {
        <p class="uitleg">Laden…</p>
    }
    else if (!_mag)
    {
        <section class="module-placeholder">
            <p><b>Geen toegang.</b></p>
            <p>Licenties is voor wie het recht Licenties heeft (Werknemers ▸ Rechten) en voor de Directie.</p>
        </section>
    }
    else if (ProductParam != "mpede")
    {
        @* ----- de tegels ----- *@
        <div class="lc-tegels">
            <a class="lc-tegel" href="tools/licenties?product=mpede">
                <span class="lc-icoon">🤖</span>
                <b>M-Pede Robotics</b>
                <span>Licentiecode voor de MPR-bibliotheek van een robot</span>
            </a>
            <div class="lc-tegel uit" aria-disabled="true" title="Volgt later">
                <span class="lc-icoon">🧭</span>
                <b>Padplanning</b>
                <span>Volgt later</span>
            </div>
        </div>
    }
    else if (!_tabel)
    {
        <section class="module-placeholder"><p>De tabel voor de licenties bestaat nog niet (Licenties_MariaDB.sql).</p></section>
    }
    else
    {
        @* ----- M-Pede Robotics ----- *@
        <div class="cs-leeskop">
            <a class="klein cs-knoplink" href="tools/licenties">‹ Licenties</a>
            <h2>🤖 M-Pede Robotics</h2>
        </div>
        @if (!Lic.SleutelAanwezig)
        {
            <div class="melding waarschuwing" style="position:static;max-width:none;box-shadow:none">
                De sleutel ontbreekt: zet de 48 hex-tekens uit <code>mpr_license.key</code> in appsettings.json bij <code>Licenties:MPedeSleutel</code> en herstart de app.
                Tot dan is de lijst te lezen, maar kan er geen code gemaakt worden.
            </div>
        }
        @if (Lic.Testsleutel)
        {
            <div class="melding waarschuwing" style="position:static;max-width:none;box-shadow:none">Testversie met een testsleutel: deze codes werken niet op een robot.</div>
        }

        <div class="lc-opmaak">
            <div class="lc-links">
                <section class="lc-kaart @(Gekozen is null ? "" : "gevuld")">
                    @if (Gekozen is not { } g)
                    {
                        <h3>Licentie</h3>
                        <p class="uitleg">Klik rechts op een regel om de code te zien, of maak hieronder een nieuwe licentie.</p>
                    }
                    else
                    {
                        <div class="lc-kaartkop">
                            <h3>@g.Robot</h3>
                            @if (g.Vervallen) { <span class="stand-chip s-rood">gewist</span> }
                        </div>
                        <div class="lc-groot">@g.Code</div>
                        <code class="lc-st">@g.StRegel</code>
                        <div class="cs-knoppen">
                            <button type="button" class="klein" @onclick='() => Kopieer(g.StRegel, "De regel voor de PLC")'>Regel kopiëren</button>
                            <button type="button" class="klein" @onclick='() => Kopieer(g.Code, "De code")'>Alleen de code</button>
                        </div>
                        <dl class="lc-velden">
                            <dt>Robot</dt>
                            <dd>
                                @if (_wijzig) { <input class="lc-in breed" value="@_wRobot" maxlength="40" @oninput="e => _wRobot = (string?)e.Value ?? string.Empty" aria-label="Robot" /> }
                                else if (g.ProductId is int pid) { <a href="@($"producten?product={pid}")" title="Deze robot openen in Producten">@g.Robot</a> }
                                else { @g.Robot }
                            </dd>
                            <dt>Serienummer 4e drive</dt><dd class="lc-mono">@g.Serienummer</dd>
                            <dt>Gemaakt</dt><dd>@g.Datum.ToString("d-M-yyyy HH:mm")@(g.Door.Length > 0 ? " · " + g.Door : "")</dd>
                            <dt>Notitie</dt>
                            <dd>
                                @if (_wijzig) { <input class="lc-in breed" value="@_wNotitie" maxlength="120" @oninput="e => _wNotitie = (string?)e.Value ?? string.Empty" aria-label="Notitie" /> }
                                else { @(g.Notitie.Length > 0 ? g.Notitie : "—") }
                            </dd>
                        </dl>
                        <div class="cs-knoppen">
                            @if (_wijzig)
                            {
                                <button type="button" class="primair klein" disabled="@_bezig" @onclick="() => BewaarWijziging(g)">Bewaren</button>
                                <button type="button" class="klein" @onclick="() => _wijzig = false">Annuleren</button>
                            }
                            else
                            {
                                @if (!g.Vervallen)
                                {
                                    <button type="button" class="klein" title="Robot en notitie wijzigen" @onclick="() => { _wijzig = true; _wRobot = g.Robot; _wNotitie = g.Notitie; }">Wijzigen</button>
                                    <button type="button" class="klein lc-wis" title="Uit de lijst halen" @onclick="() => Wis(g)">Wissen</button>
                                }
                                else
                                {
                                    <button type="button" class="klein" title="Weer in de lijst zetten" @onclick="() => ZetGewist(g, false)">Terughalen</button>
                                }
                            }
                        </div>
                    }
                </section>
                <button type="button" class="primair lc-nieuwknop" disabled="@(!Lic.SleutelAanwezig)" @onclick="OpenNieuw">+ Nieuwe licentie</button>
            </div>

            <section class="lc-lijst">
                <div class="cs-leeskop">
                    <h3>Uitgegeven codes <span class="cs-zacht">@Zichtbaar.Count()</span></h3>
                    <span class="groei"></span>
                    <input class="lc-zoek" type="search" placeholder="🔍 Zoek een robot: nummer, serienummer, notitie…" value="@_zoek" @oninput="ZoekGewijzigd" autocomplete="off" aria-label="Zoeken in de licenties" />
                    <label class="vink"><input type="checkbox" checked="@_ookGewist" @onchange="GewistGewijzigd" /> ook gewiste</label>
                </div>
                @if (_lijst.Count == 0)
                {
                    <p class="uitleg">Er staat nog geen code in de lijst.</p>
                }
                else if (!Zichtbaar.Any())
                {
                    <p class="uitleg">Geen licentie gevonden voor "@_zoek.Trim()".@(_ookGewist ? "" : " Staat hij misschien bij de gewiste? Zet \"ook gewiste\" aan.")</p>
                }
                else
                {
                    <table class="cs-tabel lc-tabel">
                        <thead><tr><th>Datum</th><th>Robot</th><th>Serienummer 4e drive</th><th>Code</th><th>Notitie</th><th>Door</th></tr></thead>
                        <tbody>
                            @foreach (var l in Zichtbaar)
                            {
                                <tr class="@(l.Vervallen ? "cs-vervallen" : "") @(l.Id == _gekozen ? "lc-raak" : "")" @key="l.Id" @onclick="() => Kies(l.Id)">
                                    <td class="wk-smal">@l.Datum.ToString("d-M-yyyy HH:mm")</td>
                                    <td>@l.Robot@if (l.Vervallen) { <span class="stand-chip s-rood">gewist</span> }</td>
                                    <td class="lc-mono">@l.Serienummer</td>
                                    <td class="lc-mono">@l.Code</td>
                                    <td>@l.Notitie</td>
                                    <td class="cs-zacht">@l.Door</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                @if (Lic.SleutelAanwezig)
                {
                    <p class="lc-import">
                        <span class="cs-rijvlak" title="Neemt de regels uit het bestand van het Python-programma over; wat er al staat wordt overgeslagen">
                            ⬆ Overnemen uit licenses_issued.csv (sleep of klik)
                            <InputFile @key="_invoer" OnChange="Importeer" accept=".csv" class="cs-invoer" />
                        </span>
                    </p>
                }
            </section>
        </div>
    }
</div>

@* ----- een nieuwe licentie: de robot kiezen, het serienummer van de vierde drive komt uit Producten ----- *@
@if (_nieuw is { } n)
{
    <div class="cmdk-overlay midden">
        <div class="factuurvenster cs-venster lc-venster">
            <header class="bijlagekop"><h2>Nieuwe licentie · M-Pede Robotics</h2></header>
            <div class="factuurvenster-inhoud">
                <div class="lc-tweekolom">
                    <label class="cs-veld"><span>Product</span>
                        <select value="@n.TypeId" @onchange="TypeGekozen">
                            @foreach (var t in _types) { <option value="@t.Id">@t.Naam</option> }
                            <option value="0">Ander (met de hand)</option>
                        </select></label>
                    <label class="cs-veld"><span>Serienummer van de robot</span>
                        <input id="lc-robot" @ref="_robotVeld" value="@n.RobotTekst" maxlength="40" autocomplete="off" list="lc-robots" placeholder="bv. 57"
                               @onchange="e => RobotGetypt((string?)e.Value)" />
                        <datalist id="lc-robots">@foreach (var r in _robots.Take(300)) { <option value="@r.Serienummer" /> }</datalist></label>
                </div>
                <div class="lc-qr">
                    <FotoVak AlleenTelefoon="true" OpNieuweFoto="QrFoto" Titel="QR-code van de robot" />
                    <label class="klein fotovak-knop" title="Een foto van de QR-code op deze pc kiezen">
                        🖼 Foto van de QR-code kiezen…
                        <InputFile @key="_qrInvoer" OnChange="QrBestand" accept="image/*" class="bon-verborgen" />
                    </label>
                    <span class="cs-zacht">Fotografeer de QR-code op de robot; de app leest het serienummer eruit.</span>
                </div>
                @if (n.Info.Length > 0)
                {
                    <p class="lc-info @(n.InfoGoed ? "goed" : "let-op")">@n.Info</p>
                }
                <label class="cs-veld"><span>Serienummer van de 4e drive in de EtherCAT-keten (decimaal of 16#hex)</span>
                    <input value="@n.DriveTekst" maxlength="20" autocomplete="off" inputmode="numeric"
                           @oninput="e => { n.DriveTekst = (string?)e.Value ?? string.Empty; n.DriveUitRobot = false; n.Uitkomst = null; }" /></label>
                <label class="cs-veld"><span>Notitie (klant, project; mag leeg)</span>
                    <input value="@n.Notitie" maxlength="120" autocomplete="off" @oninput="e => { n.Notitie = (string?)e.Value ?? string.Empty; n.Uitkomst = null; }" /></label>

                @if (n.Fout.Length > 0) { <p class="lc-info let-op">@n.Fout</p> }
                @if (n.Uitkomst is { Toegevoegd: false } u)
                {
                    <p class="lc-info let-op">
                        @if (u.Precies)
                        {
                            <text>Deze regel staat al in de lijst (zelfde robot, serienummer en notitie). Er komt geen tweede bij.</text>
                        }
                        else
                        {
                            <text>Er @(u.Bestaand.Count == 1 ? "staat al een regel" : $"staan al {u.Bestaand.Count} regels") met dit serienummer
                                (@string.Join("; ", u.Bestaand.Select(b => b.Robot + (b.Notitie.Length > 0 ? ", " + b.Notitie : "")))). De code is dezelfde. Toch als nieuwe regel toevoegen?</text>
                        }
                    </p>
                }
                <div class="cs-knoppen">
                    @if (n.Uitkomst is { Toegevoegd: false, Precies: false })
                    {
                        <button type="button" class="primair" disabled="@_bezig" @onclick="() => Maak(true)">Toch toevoegen</button>
                    }
                    else if (n.Uitkomst is { Precies: true } p)
                    {
                        <button type="button" class="primair" @onclick="() => { _nieuw = null; Kies(p.Bestaand.FirstOrDefault()?.Id); }">Die regel tonen</button>
                    }
                    else
                    {
                        <button type="button" class="primair" disabled="@_bezig" @onclick="() => Maak(false)">Licentiecode maken</button>
                    }
                    <button type="button" class="klein" disabled="@_bezig" @onclick="() => _nieuw = null">Annuleren</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>De open tegel: "mpede", of leeg voor het overzicht met de tegels.</summary>
    [SupplyParameterFromQuery(Name = "product")] public string? ProductParam { get; set; }

    /// <summary>Wat er in het venster voor een nieuwe licentie is ingevuld en gevonden.</summary>
    private class NieuwInvoer
    {
        public int TypeId;
        public string RobotTekst = "", DriveTekst = "", Notitie = "", Info = "", Fout = "";
        public bool InfoGoed;
        /// <summary>Het driveserienummer is uit Producten overgenomen (niet zelf getypt): bij een andere robot gaat het weer weg.</summary>
        public bool DriveUitRobot;
        public MPedeRobot? Robot;
        public MPedeLicentieUitkomst? Uitkomst;
    }

    private bool _geladen, _mag, _tabel, _fout, _bezig, _ookGewist, _wijzig;
    private string? _melding;
    private string _zoek = "", _wRobot = "", _wNotitie = "";
    private List<MPedeLicentie> _lijst = new();
    private int? _gekozen;
    private NieuwInvoer? _nieuw;
    private List<(int Id, string Naam)> _types = new();
    private List<MPedeRobot> _robots = new();
    private int _invoer, _qrInvoer;

    private MPedeLicentie? Gekozen => _lijst.FirstOrDefault(l => l.Id == _gekozen);
    private void Meld(string tekst, bool fout = false) { _melding = tekst; _fout = fout; }
    private void Kies(int? id) { _gekozen = id; _wijzig = false; }

    /// <summary>Is dit precies de robot die gezocht wordt? "57" en "MPR-1-0057" zijn robot "MPR-1 · 57", maar niet "157".</summary>
    private static bool IsRobot(MPedeLicentie l, string q)
        => string.Equals(l.Robot, q, StringComparison.OrdinalIgnoreCase) || (q.Any(char.IsDigit) && MPedeLicenties.Kern(l.Robot) == MPedeLicenties.Kern(q));

    /// <summary>
    /// De regels die bij de zoektekst passen: op robot, serienummer van de drive, code, notitie of wie hem maakte. De
    /// robot met precies dat nummer staat bovenaan, zodat "5" eerst robot 5 geeft en dan pas 15, 50 en 51.
    /// </summary>
    private IEnumerable<MPedeLicentie> Zichtbaar
    {
        get
        {
            var q = _zoek.Trim();
            if (q.Length == 0) return _lijst;
            return _lijst.Where(l => IsRobot(l, q) || l.Serienummer.ToString().Contains(q) || l.Code.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || l.Robot.Contains(q, StringComparison.OrdinalIgnoreCase) || l.Notitie.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || l.Door.Contains(q, StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(l => IsRobot(l, q)).ThenByDescending(l => l.Robot.Contains(q, StringComparison.OrdinalIgnoreCase));
        }
    }

    /// <summary>Zoeken: is er precies een treffer, of precies een regel van de gezochte robot, dan staan zijn gegevens meteen links.</summary>
    private void ZoekGewijzigd(ChangeEventArgs e)
    {
        _zoek = (string?)e.Value ?? "";
        var q = _zoek.Trim();
        if (q.Length == 0) return;
        var treffers = Zichtbaar.ToList();
        var vanRobot = treffers.Where(l => IsRobot(l, q)).ToList();
        if (treffers.Count == 1) Kies(treffers[0].Id);
        else if (vanRobot.Count == 1) Kies(vanRobot[0].Id);
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (!_geladen)
            {
                await Ik.ZorgGeladenAsync();
                // in de testversie (alles in het geheugen, geen login) ook zonder het recht
                _mag = Ik.MagLicenties || (Lic.Geheugen && !Ik.Ingelogd && !Ik.IsWerkplek);
            }
            if (_mag && ProductParam == "mpede")
            {
                _tabel = Lic.Beschikbaar && await Lic.AanwezigAsync();
                if (_tabel) _lijst = await Lic.LijstAsync(_ookGewist);
            }
        }
        catch (Exception ex) { Meld("Laden is niet gelukt: " + ex.GetBaseException().Message, true); }
        _geladen = true;
    }

    private async Task Herlaad() => _lijst = await Lic.LijstAsync(_ookGewist);

    private async Task GewistGewijzigd(ChangeEventArgs e)
    {
        _ookGewist = e.Value is true;
        try { await Herlaad(); } catch (Exception ex) { Meld(ex.GetBaseException().Message, true); }
    }

    // ------------------------------------------------------------------ nieuwe licentie

    // de cursor meteen in het serienummer van de robot als het venster opent
    private ElementReference _robotVeld;
    private bool _focusRobot;

    protected override async Task OnAfterRenderAsync(bool eerste)
    {
        if (!_focusRobot || _nieuw is null) return;
        _focusRobot = false;
        try { await _robotVeld.FocusAsync(); } catch { /* het venster is intussen weer dicht */ }
    }

    private async Task OpenNieuw()
    {
        if (!_mag) return;
        _melding = null;
        _focusRobot = true;
        try
        {
            if (_types.Count == 0) _types = await Lic.RobotTypesAsync();
            _nieuw = new NieuwInvoer { TypeId = _types.FirstOrDefault().Id };
            _robots = _nieuw.TypeId == 0 ? new() : await Lic.RobotsAsync(_nieuw.TypeId);
        }
        catch (Exception ex)
        {
            // zonder Producten kan het nog met de hand
            _nieuw = new NieuwInvoer();
            _robots = new();
            Meld("De robots uit Producten laden is niet gelukt (" + ex.GetBaseException().Message + "); vul de gegevens met de hand in.", true);
        }
    }

    private async Task TypeGekozen(ChangeEventArgs e)
    {
        if (_nieuw is not { } n) return;
        n.TypeId = int.TryParse((string?)e.Value, out var id) ? id : 0;
        n.Robot = null; n.Info = ""; n.Uitkomst = null;
        try { _robots = n.TypeId == 0 ? new() : await Lic.RobotsAsync(n.TypeId); } catch { _robots = new(); }
        if (n.RobotTekst.Trim().Length > 0) await RobotGetypt(n.RobotTekst);
    }

    private string TypeNaam(int id) => _types.FirstOrDefault(t => t.Id == id).Naam ?? "";

    /// <summary>Het serienummer van de robot is ingevuld (getypt of gescand): de robot opzoeken en het serienummer van zijn vierde drive erbij.</summary>
    private async Task RobotGetypt(string? tekst)
    {
        if (_nieuw is not { } n) return;
        n.RobotTekst = (tekst ?? "").Trim();
        n.Robot = null; n.Info = ""; n.InfoGoed = false; n.Uitkomst = null; n.Fout = "";
        // het nummer van de vorige robot hoort niet bij deze; wat je zelf typte blijft staan
        if (n.DriveUitRobot) { n.DriveTekst = ""; n.DriveUitRobot = false; }
        if (n.RobotTekst.Length == 0 || n.TypeId == 0) return;
        n.Robot = MPedeLicenties.ZoekRobot(_robots, n.RobotTekst);
        if (n.Robot is null)
        {
            n.Info = $"Geen {TypeNaam(n.TypeId)} met serienummer \"{n.RobotTekst}\" gevonden in Producten. Je kunt het serienummer van de vierde drive hieronder met de hand invullen.";
            return;
        }
        try
        {
            var drive = await Lic.DriveVanRobotAsync(n.Robot.ProductId);
            if (drive.Serienummer is long s)
            {
                n.DriveTekst = s.ToString();
                n.DriveUitRobot = true;
                n.Info = $"{TypeNaam(n.TypeId)} · {n.Robot.Serienummer} gevonden in Producten; het serienummer van de vierde drive is overgenomen.";
                n.InfoGoed = true;
            }
            else n.Info = $"{TypeNaam(n.TypeId)} · {n.Robot.Serienummer} gevonden. " + drive.Uitleg;
        }
        catch (Exception ex) { n.Info = "Het serienummer van de drive opzoeken is niet gelukt: " + ex.GetBaseException().Message; }
    }

    /// <summary>Een foto van de QR-code (van de telefoon of gekozen op de pc): de tekst eruit lezen en als serienummer van de robot gebruiken.</summary>
    private async Task QrFoto(FotoStuk foto)
    {
        if (_nieuw is not { } n) return;
        var tekst = await Task.Run(() => QrLezer.Lees(foto.Inhoud));
        if (tekst is null)
        {
            n.Info = "In deze foto is geen QR-code te lezen. Probeer het nog eens, recht van voren en scherp, of typ het serienummer.";
            n.InfoGoed = false;
        }
        else await RobotGetypt(tekst);
        await InvokeAsync(StateHasChanged);
    }

    private async Task QrBestand(InputFileChangeEventArgs e)
    {
        try
        {
            if (e.File.Size > 25_000_000) { if (_nieuw is not null) _nieuw.Info = "Deze foto is te groot."; return; }
            using var m = new MemoryStream();
            await using (var s = e.File.OpenReadStream(25_000_000)) await s.CopyToAsync(m);
            await QrFoto(new FotoStuk(e.File.Name, m.ToArray(), ""));
        }
        catch (Exception ex) { if (_nieuw is not null) _nieuw.Info = "De foto lezen is niet gelukt: " + ex.GetBaseException().Message; }
        _qrInvoer++;
    }

    private async Task Maak(bool toch)
    {
        if (_nieuw is not { } n || _bezig || !_mag) return;
        n.Fout = "";
        if (n.RobotTekst.Trim().Length == 0) { n.Fout = "Vul het serienummer van de robot in."; return; }
        var (nummer, fout) = MPedeLicenties.LeesSerienummer(n.DriveTekst);
        if (nummer is not uint serie) { n.Fout = fout.Replace("van de J3-drive", "van de vierde drive"); return; }
        var type = TypeNaam(n.TypeId);
        // de robot zoals hij in de lijst komt: "MPR-1 · 57"; zonder product alleen wat er getypt is
        var robot = n.Robot is { } r ? $"{type} · {r.Serienummer}" : type.Length > 0 ? $"{type} · {n.RobotTekst.Trim()}" : n.RobotTekst.Trim();
        _bezig = true;
        try
        {
            n.Uitkomst = await Lic.MaakAsync(serie, robot, n.Notitie, Ik.WerknemerId, toch, n.Robot?.ProductId);
            await Herlaad();
            if (n.Uitkomst.Toegevoegd)
            {
                _nieuw = null;
                Kies(n.Uitkomst.Id);
                Meld($"De licentie voor {robot} staat in de lijst.");
            }
        }
        catch (Exception ex) { n.Fout = ex.GetBaseException().Message; }
        _bezig = false;
    }

    // ------------------------------------------------------------------ de gekozen regel

    private async Task BewaarWijziging(MPedeLicentie l)
    {
        if (_bezig || !_mag) return;
        _bezig = true;
        try
        {
            await Lic.WijzigAsync(l.Id, _wRobot, _wNotitie);
            _wijzig = false;
            await Herlaad();
        }
        catch (Exception ex) { Meld(ex.GetBaseException().Message, true); }
        _bezig = false;
    }

    private async Task Wis(MPedeLicentie l)
    {
        if (!_mag) return;
        try
        {
            if (!await JS.InvokeAsync<bool>("mdeBevestig", $"De licentie van {l.Robot} wissen? De regel verdwijnt uit de lijst; hij is terug te halen via \"ook gewiste\".",
                    new { kop = "⚠ Licentie wissen", ja = "Wissen" })) return;
        }
        catch { return; }
        await ZetGewist(l, true);
    }

    private async Task ZetGewist(MPedeLicentie l, bool gewist)
    {
        if (!_mag) return;
        try
        {
            await Lic.ZetVervallenAsync(l.Id, gewist);
            await Herlaad();
            if (Gekozen is null) Kies(null);
            Meld(gewist ? $"De licentie van {l.Robot} is gewist." : $"De licentie van {l.Robot} staat weer in de lijst.");
        }
        catch (Exception ex) { Meld(ex.GetBaseException().Message, true); }
    }

    private async Task Kopieer(string tekst, string wat)
    {
        try
        {
            if (await JS.InvokeAsync<bool>("mdeKopieer", tekst)) Meld(wat + " staat op het klembord.");
            else Meld("Kopiëren is niet gelukt; selecteer de tekst en kopieer hem zelf.", true);
        }
        catch { Meld("Kopiëren is niet gelukt; selecteer de tekst en kopieer hem zelf.", true); }
    }

    private async Task Importeer(InputFileChangeEventArgs e)
    {
        if (!_mag) return;
        try
        {
            if (e.File.Size > 2_000_000) { Meld("Dit bestand is te groot voor een lijst met licenties.", true); return; }
            using var m = new MemoryStream();
            await using (var s = e.File.OpenReadStream(2_000_000)) await s.CopyToAsync(m);
            var (erbij, over, fouten) = await Lic.ImporteerAsync(System.Text.Encoding.UTF8.GetString(m.ToArray()), Ik.WerknemerId);
            await Herlaad();
            var tekst = $"{erbij} regel{(erbij == 1 ? "" : "s")} overgenomen, {over} stond{(over == 1 ? "" : "en")} er al.";
            if (fouten.Count > 0) Meld(tekst + " Niet overgenomen: " + string.Join(" · ", fouten.Take(5)) + (fouten.Count > 5 ? $" (en nog {fouten.Count - 5})" : ""), true);
            else Meld(tekst);
        }
        catch (Exception ex) { Meld("Overnemen is niet gelukt: " + ex.GetBaseException().Message, true); }
        _invoer++;
    }
}
