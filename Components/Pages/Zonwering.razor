@page "/gebouw/zonwering"
@inject IPlc Plc
@inject HuidigeGebruiker Ik

@* De bediening zelf zit in ZonweringPaneel, gedeeld met /mobiel/zonwering. *@

<PageTitle>Zonwering — MDE</PageTitle>

<div class="page">
    <header class="topbar">
        <h1>Zonwering</h1>
        <span class="weeklabel">@Gebouw.Zonweringen.Length ruimtes</span>
    </header>

    <ZonweringPaneel />

    <footer class="voet">
        Elke knop geeft de PLC een kort signaal; die regelt zelf het op- en neerlopen.
        @Plc.Beschrijf()
    </footer>
</div>

@code {
    protected override async Task OnInitializedAsync() => await Ik.ZorgGeladenAsync();
}
