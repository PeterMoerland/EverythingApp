@page "/productie/drivetypen"
@inject IDriveRepository Drives
@inject FilestoreService Store
@inject HuidigeGebruiker Ik
@inject IJSRuntime JS

@* Productie ▸ Drivetypen. Links de typen (Everest, Capitan …, herkend aan de
   EtherCAT-productcode), rechts de firmwareversies van het gekozen type met
   hun status en bestanden (firmware + dictionary). Test PCB gebruikt dit om
   na het uitlezen te zeggen of een drive de juiste firmware heeft. De
   parametersets (.xcf) staan niet hier maar bij het halffabricaat
   (Producten ▸ tab Drives), want die verschillen per print. *@

<PageTitle>Controllertypen — MDE</PageTitle>

<div class="page">
    <header class="topbar">
        <h1>Controllertypen</h1>
        @if (_type is not null)
        {
            <span class="weeklabel">@_type.Naam · @_firmwares.Count firmwareversie(s)</span>
        }
    </header>

    @if (!Drives.Beschikbaar)
    {
        <section class="module-placeholder"><p>Dit scherm werkt alleen met de live database.</p></section>
    }
    else
    {
        @if (_melding is not null)
        {
            <div class="melding @(_fout ? "fout" : "ok")" @onclick="() => _melding = null">@_melding</div>
        }
        @if (_tabelOntbreekt)
        {
            <div class="melding fout">De drive-tabellen ontbreken nog: voer <code>DriveTypen_MariaDB.sql</code> uit.</div>
        }

        <div class="drv-tweeluik">
            @* ---------- links: typen ---------- *@
            <section class="prod-kaart">
                <h3 class="wn-kop">Typen</h3>
                <table class="kiezer-tabel">
                    <thead>
                        <tr><th>Naam</th><th style="width:8rem">Productcode</th><th style="width:5rem">Firmw.</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var t in _typen)
                        {
                            <tr @key="t.Id" class="klikbaar @(_type?.Id == t.Id ? "gekozen" : "")" @onclick="() => KiesType(t)">
                                <td><b>@t.Naam</b><br /><small class="uitleg">@t.Fabrikant · @DriveProtocol.Naam(t.Protocol)</small></td>
                                <td><code>@t.ProductCode</code>@if (t.VendorId.Length > 0) { <br /><small class="uitleg" title="Fabrikantcode (Vendor ID)">@t.VendorId</small> }</td>
                                <td>@t.AantalFirmwares</td>
                            </tr>
                        }
                        @if (_typen.Count == 0)
                        {
                            <tr><td colspan="3" class="kiezer-info">Nog geen drivetypen.</td></tr>
                        }
                    </tbody>
                </table>
                <div class="btngroup">
                    <button class="klein" @onclick="NieuwType">+ Type</button>
                </div>

                @if (_type is not null)
                {
                    <h4 class="prod-subkop">Gegevens</h4>
                    <div class="bankfilters">
                        <label class="bankveld"><span>Naam</span>
                            <input value="@_type.Naam" @onchange="e => ZetType(v => _type.Naam = v, e)" /></label>
                        <label class="bankveld"><span>Protocol</span>
                            <select value="@_type.Protocol" @onchange="e => ZetType(v => _type.Protocol = v, e)">
                                @foreach (var p in DriveProtocol.Alle)
                                {
                                    <option value="@p.Code">@p.Naam</option>
                                }
                            </select></label>
                        <label class="bankveld"><span>@(DriveProtocol.Alle.FirstOrDefault(p => p.Code == _type.Protocol).CodeLabel ?? "Productcode")</span>
                            <input value="@_type.ProductCode" style="width:9rem" placeholder="@CodeVoorbeeld"
                                   @onchange="e => ZetType(v => _type.ProductCode = v, e)" /></label>
                        @if (DriveProtocol.OpBus(_type.Protocol))
                        {
                            <label class="bankveld" title="EtherCAT Vendor ID (0x1018:1). Leeg = nog niet vastgelegd: dan telt alleen de productcode."><span>Fabrikantcode (hex)</span>
                                <input value="@_type.VendorId" style="width:9rem" placeholder="0x000010E3"
                                       @onchange="e => ZetType(v => _type.VendorId = v, e)" /></label>
                        }
                        <label class="bankveld"><span>Fabrikant</span>
                            <input value="@_type.Fabrikant" @onchange="e => ZetType(v => _type.Fabrikant = v, e)" /></label>
                        <label class="bankveld prod-keuze"><span>Opmerking</span>
                            <input value="@_type.Opmerking" @onchange="e => ZetType(v => _type.Opmerking = v, e)" /></label>
                    </div>
                    <div class="btngroup">
                        <button class="klein rood" @onclick="VerwijderType">✕ Type verwijderen</button>
                    </div>
                    <p class="uitleg">Fabrikantcode en productcode zijn wat de slave via EtherCAT meldt (identity 0x1018; Test PCB toont ze achter
                       het type). Samen zijn ze de sleutel: MDE (0x000010E3), Ingenia en ZeroErr kunnen zo nooit botsen.
                       De naam in de EEPROM van Ingenia-drives is generiek, de code niet.</p>
                }
            </section>

            @* ---------- rechts: firmwares ---------- *@
            <section class="prod-kaart">
                @if (_type is null)
                {
                    <p class="kiezer-info">Kies links een drivetype.</p>
                }
                else
                {
                    <div class="wn-tabs drv-tabs">
                        <button class="@(_tab == "firmware" ? "actief" : "")" @onclick="@(() => KiesTab("firmware"))">Firmware (@_firmwares.Count)</button>
                        @if (DriveProtocol.ViaSdo(_type.Protocol))
                        {
                            <button class="@(_tab == "recepten" ? "actief" : "")" @onclick="@(() => KiesTab("recepten"))">Testrecepten (@_recepten.Count)</button>
                        }
                    </div>

                    @if (_tab != "recepten" || !DriveProtocol.ViaSdo(_type.Protocol))
                    {
                        <div class="drv-tabkop">
                            <h3 class="wn-kop">Firmwareversies van @_type.Naam</h3>
                            <button class="klein drv-hulp" title="Uitleg" @onclick="@(() => _hulp = "firmware")">?</button>
                        </div>
                        @if (!MagFirmware)
                        {
                            <p class="uitleg">Bekijken en downloaden kan; firmware toevoegen of wijzigen mag alleen met het recht
                               <b>MagFirmware</b> (per werknemer, Werknemers_MagFirmware_MariaDB.sql).</p>
                        }
                        @* zonder recht: alle velden en knoppen uit; de downloadlinks (a) blijven werken *@
                        <fieldset class="prod-alleen-lezen" disabled="@(!MagFirmware)">
                        <table class="kiezer-tabel drv-firmwares">
                            <thead>
                                <tr>
                                    <th style="width:6.5rem">Versie</th>
                                    <th style="width:8rem">Status</th>
                                    <th>Firmware (@DriveProtocol.FirmwareExtensies(_type.Protocol))</th>
                                    @if (!IsChip)
                                    {
                                        <th>Dictionary (.xdf)</th>
                                        <th title="EtherCAT Slave Information">ESI (.xml)</th>
                                    }
                                    <th style="width:9rem">Vrijgegeven</th>
                                    <th style="width:2.6rem"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var f in _firmwares)
                                {
                                    <tr @key="f.Id" class="drv-rij">
                                        <td><input value="@f.Versie" placeholder="2.10.0" @onchange="e => ZetFirmware(f, v => f.Versie = v, e)" /></td>
                                        <td>
                                            <select value="@f.Status" class="drv-status @DriveStatus.Kleur(f.Status)"
                                                    @onchange="e => ZetStatus(f, e)"
                                                    title="@StatusTitel(f)">
                                                @foreach (var s in DriveStatus.Firmware)
                                                {
                                                    <option value="@s.Code">@s.Code</option>
                                                }
                                            </select>
                                        </td>
                                        <td>@Bestandcel(f, f.FirmwareFileId, f.FirmwareBestand, DriveStore.Firmware)</td>
                                        @if (!IsChip)
                                        {
                                            <td>@Bestandcel(f, f.DictionaryFileId, f.DictionaryBestand, DriveStore.Dictionary)</td>
                                            <td>@Bestandcel(f, f.EsiFileId, f.EsiBestand, DriveStore.Esi)</td>
                                        }
                                        <td><input type="date" value="@(f.Vrijgegeven?.ToString("yyyy-MM-dd"))" @onchange="e => ZetDatum(f, e)" /></td>
                                        <td class="c"><button class="klein rood" title="Verwijderen" @onclick="() => VerwijderFirmware(f)">✕</button></td>
                                    </tr>
                                    <tr @key="@($"{f.Id}-opm")" class="drv-opm">
                                        <td colspan="7">
                                            <input value="@f.Opmerking" placeholder="Opmerking bij deze versie…"
                                                   @onchange="e => ZetFirmware(f, v => f.Opmerking = v, e)" />
                                        </td>
                                    </tr>
                                }
                                @if (_firmwares.Count == 0)
                                {
                                    <tr><td colspan="7" class="kiezer-info">Nog geen firmwareversies voor dit type.</td></tr>
                                }
                            </tbody>
                        </table>
                        <div class="btngroup">
                            <button class="klein" @onclick="NieuweFirmware">+ Firmwareversie</button>
                        </div>
                        </fieldset>
                    }
                    else
                    {
                        @* ---------- testrecepten: alleen bij slaves die via SDO's gaan (MDE-slaves, eRob) ---------- *@
                        <div class="drv-tabkop">
                            <h3 class="wn-kop">Testrecepten van @_type.Naam</h3>
                            <button class="klein drv-hulp" title="Uitleg en bouwstenen" @onclick="@(() => _hulp = "recepten")">?</button>
                        </div>
                        @if (_receptTabelOntbreekt)
                        {
                            <div class="melding fout">De tabel DriveRecepten ontbreekt nog: voer <code>DriveRecepten_MariaDB.sql</code> uit.</div>
                        }
                        <div class="drv-recepten">
                            <div class="drv-receptlijst">
                                <div class="drv-lijstvak" role="listbox">
                                    @foreach (var r in _recepten.OrderBy(x => x.Volgorde).ThenBy(x => x.Naam))
                                    {
                                        <button @key="r.Id" role="option" class="drv-receptitem @(_gekozen?.Id == r.Id ? "gekozen" : "")" @onclick="() => KiesRecept(r)">
                                            <b>@r.Volgorde. @r.Naam</b>
                                            <small>@r.StapNamen().Count stappen@(r.Verplicht ? " · verplicht" : "")</small>
                                        </button>
                                    }
                                    @if (_recepten.Count == 0 && !_receptTabelOntbreekt) { <p class="kiezer-info">Nog geen testrecepten voor dit type.</p> }
                                </div>
                                <div class="btngroup">
                                    <button class="klein" disabled="@_receptTabelOntbreekt" @onclick="NieuwRecept">+ Recept</button>
                                    <button class="klein" disabled="@_receptTabelOntbreekt" @onclick="VoorbeeldRecept" title="Een recept met alle bouwstenen als voorbeeld (Swivel) toevoegen, om aan te passen">+ Voorbeeld</button>
                                </div>
                            </div>

                            <div class="drv-receptbewerk">
                                @if (_gekozen is null || _concept is null)
                                {
                                    <p class="kiezer-info">Kies links een recept, of maak een nieuw recept.</p>
                                }
                                else
                                {
                                    var c = _concept;
                                    <div class="bankfilters">
                                        <label class="bankveld"><span>Volgorde</span>
                                            <input type="number" style="width:4rem" value="@c.Volgorde" @oninput="e => c.Volgorde = int.TryParse((string?)e.Value, out var v) ? v : c.Volgorde" /></label>
                                        <label class="bankveld"><span>Naam</span>
                                            <input value="@c.Naam" maxlength="60" @oninput="e => c.Naam = (string?)e.Value ?? string.Empty" /></label>
                                        <label class="bankveld prod-keuze"><span>Omschrijving</span>
                                            <input value="@c.Omschrijving" maxlength="500" @oninput="e => c.Omschrijving = (string?)e.Value ?? string.Empty" /></label>
                                        <label class="of-vink" title="Hoort bij de eindcontrole van de print">
                                            <input type="checkbox" checked="@c.Verplicht" @onchange="e => c.Verplicht = e.Value is bool b && b" /> verplicht</label>
                                    </div>
                                    <textarea class="drv-stappen drv-editor" spellcheck="false" value="@c.Stappen" @key="(_gekozen.Id, _receptVersie)"
                                              @oninput="e => c.Stappen = (string?)e.Value ?? string.Empty"></textarea>
                                    var fout = DriveRecept.Controleer(c.Stappen);
                                    @if (fout is not null) { <div class="melding fout">@fout</div> }
                                    else
                                    {
                                        var namen = new DriveRecept { Stappen = c.Stappen }.StapNamen();
                                        <small class="uitleg">@namen.Count stappen: @string.Join(" → ", namen)</small>
                                    }
                                    <div class="btngroup drv-receptknoppen">
                                        <button class="primair" disabled="@(!ConceptGewijzigd || fout is not null || c.Naam.Trim().Length == 0)" @onclick="BewaarConcept">💾 Opslaan</button>
                                        <button class="klein" disabled="@(!ConceptGewijzigd)" @onclick="HerstelConcept" title="Terug naar de opgeslagen versie">↶ Wijzigingen weggooien</button>
                                        <span style="flex:1"></span>
                                        @if (ConceptGewijzigd) { <span class="uitleg">niet opgeslagen</span> }
                                        <button class="klein rood" title="Recept verwijderen" @onclick="() => VerwijderRecept(_gekozen)">✕ Verwijderen</button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </section>
        </div>

        @if (_hulp is not null)
        {
            <div class="cmdk-overlay midden" @onclick="() => _hulp = null">
                <div class="fusion-kijker ec-venster verplaatsbaar drv-hulpvenster" @onclick:stopPropagation="true">
                    <div class="sleepkop fusion-kijker-kop">
                        <b>@(_hulp == "recepten" ? "Testrecepten: uitleg en bouwstenen" : "Firmwareversies: uitleg")</b>
                        <span style="flex:1"></span>
                        <button class="klein" @onclick="() => _hulp = null">✕ Sluiten</button>
                    </div>
                    <div class="fusion-kijker-inhoud">
                        @if (_hulp == "recepten")
                        {
                            <p>Een recept is een lijst stappen (JSON) die de werkplek-agent op de slave uitvoert. Test PCB toont per slave van
                               dit type een knop per recept en zet de uitslag in de historie. Het recept stopt bij de eerste mislukte stap;
                               <code>"stoppen": false</code> op een stap laat het doorlopen. Elke stap mag een <code>"naam"</code> hebben.</p>
                            <table class="kiezer-tabel drv-bouwstenen">
                                <thead><tr><th style="width:8rem">Bouwsteen</th><th style="width:40%">Velden</th><th>Wat het doet</th></tr></thead>
                                <tbody>
                                    @foreach (var (stap, velden, wat) in Bouwstenen)
                                    {
                                        <tr><td><code>@stap</code></td><td><small>@velden</small></td><td>@wat</td></tr>
                                    }
                                </tbody>
                            </table>
                            <p class="uitleg">Index en sub mogen als tekst (<code>"0x7020"</code>) of getal; type is BOOL, USINT, SINT, UINT, INT,
                               UDINT, DINT, REAL of STRING. Objecten die in de procesdata (PDO) zitten gaan vanzelf via de procesdata.</p>
                        }
                        else
                        {
                            <p><b>actueel</b> = de versie die nieuwe prints krijgen (één per type; een andere op actueel zetten maakt
                               de vorige 'toegestaan'). <b>toegestaan</b> = mag blijven zitten. <b>geblokkeerd</b> = moet vervangen worden.</p>
                            @if (IsChip)
                            {
                                <p>Het firmwarebestand is een .hex (adressen zitten erin) of een .bin; in Half-fabricaten ▸ stap 4
                                   kies je de versie uit deze lijst — de actuele staat voorgeselecteerd.</p>
                            }
                            else
                            {
                                <p>Elke firmwareversie heeft haar eigen dictionary (.xdf), ESI-bestand (EtherCAT Slave Information, .xml)
                                   en, per halffabricaat, haar eigen parameterset (.xcf).</p>
                            }
                        }
                    </div>
                </div>
            </div>
        }

        <footer class="voet">
            Parametersets (.xcf) leg je vast bij het halffabricaat: Producten ▸ producttype ▸ tab Drives.
        </footer>
    }
</div>

@code {
    private List<DriveSoort> _typen = new();
    private DriveSoort? _type;
    private List<DriveFirmware> _firmwares = new();
    private List<DriveRecept> _recepten = new();
    private bool _receptTabelOntbreekt;
    private int _receptVersie;
    private string _tab = "firmware";
    /// <summary>Firmwareversies toevoegen en wijzigen: kolom MagFirmware in Werknemers (per werknemer in SQL).</summary>
    private bool MagFirmware => Ik.Mag("MagFirmware");
    private string? _hulp;                       // "firmware" / "recepten": uitlegvenster open
    private DriveRecept? _gekozen;               // het recept in de editor
    private ReceptConcept? _concept;             // wat er in de editor staat (pas na Opslaan in de database)

    private sealed class ReceptConcept
    {
        public string Naam = "", Omschrijving = "", Stappen = "";
        public int Volgorde;
        public bool Verplicht;
        public static ReceptConcept Van(DriveRecept r) => new() { Naam = r.Naam, Omschrijving = r.Omschrijving, Stappen = r.Stappen, Volgorde = r.Volgorde, Verplicht = r.Verplicht };
    }

    private bool ConceptGewijzigd => _gekozen is not null && _concept is not null &&
        (_concept.Naam != _gekozen.Naam || _concept.Omschrijving != _gekozen.Omschrijving || _concept.Stappen != _gekozen.Stappen
         || _concept.Volgorde != _gekozen.Volgorde || _concept.Verplicht != _gekozen.Verplicht);

    /// <summary>Niet-opgeslagen wijzigingen in de editor: eerst vragen of ze weg mogen.</summary>
    private async Task<bool> MagWeg()
        => !ConceptGewijzigd || await JS.InvokeAsync<bool>("mdeBevestig", $"Recept '{_gekozen!.Naam}' is gewijzigd maar niet opgeslagen. Wijzigingen weggooien?");

    private async Task KiesTab(string tab)
    {
        if (tab == _tab || !await MagWeg()) return;
        _tab = tab;
        if (tab != "recepten") { _gekozen = null; _concept = null; }
    }

    private async Task KiesRecept(DriveRecept r)
    {
        if (_gekozen?.Id == r.Id || !await MagWeg()) return;
        _gekozen = r; _concept = ReceptConcept.Van(r); _receptVersie++;
    }

    private void HerstelConcept()
    {
        if (_gekozen is null) return;
        _concept = ReceptConcept.Van(_gekozen); _receptVersie++;
    }

    private async Task BewaarConcept()
    {
        if (_gekozen is null || _concept is null) return;
        var fout = DriveRecept.Controleer(_concept.Stappen);
        if (fout is not null) { Toon(fout, true); return; }
        var r = _gekozen;
        var oud = ReceptConcept.Van(r);
        r.Naam = _concept.Naam.Trim(); r.Omschrijving = _concept.Omschrijving.Trim(); r.Stappen = _concept.Stappen;
        r.Volgorde = _concept.Volgorde; r.Verplicht = _concept.Verplicht;
        try
        {
            await Drives.BewaarReceptAsync(r, Ik.WerknemerId);
            _concept = ReceptConcept.Van(r);
            Toon($"Recept '{r.Naam}' opgeslagen.", false);
        }
        catch (Exception ex)
        {
            r.Naam = oud.Naam; r.Omschrijving = oud.Omschrijving; r.Stappen = oud.Stappen; r.Volgorde = oud.Volgorde; r.Verplicht = oud.Verplicht;
            Toon("Opslaan mislukt: " + ex.Message, true);
        }
    }

    private static readonly (string Stap, string Velden, string Wat)[] Bouwstenen =
    {
        ("autostart", "seconden (0)", "Het recept start vanzelf zodra je het in Test PCB opent, na de aftelling (max. 60 s; Annuleren kan). Alleen in het recept zelf, niet in een herhaal-blok; het is geen stap voor de agent."),
        ("identiteit", "vendor, productcode, revisie, firmware", "Vergelijkt de identiteit van de slave (0x1018, 0x100A)."),
        ("lees", "index, sub, type, min / max of gelijk", "Leest een waarde en controleert de grenzen."),
        ("schrijf", "index, sub, type, waarde", "Schrijft een waarde en leest hem terug."),
        ("wacht / pauze", "seconden", "Wacht; de monitor blijft meten."),
        ("wacht_tot", "index, sub, type, gelijk / min / max, timeout (10 s)", "Wacht tot een waarde aan de grens voldoet (bv. druk onder 50 binnen 5 s)."),
        ("herhaal", "keer, stappen [ … ], stoppen", "Voert een blok stappen n keer uit."),
        ("beweging", "doel_index/sub, stand_index/sub, type, doel, tolerantie, timeout, controlword {index, sub, aan, uit}", "Stuurt naar een doel en wacht tot de stand binnen de tolerantie is."),
        ("doorgeefluik", "motor, register, verwacht of waarde (index 0x8000)", "Leest of schrijft een register van een seriële motor (Feetech)."),
        ("monitor", "objecten [{index, sub, type, naam, min, max}]", "Vanaf deze stap leest de agent de objecten elke 0,2 s; Test PCB toont de waarden en een grafiek. min/max = grenslijn in de grafiek."),
        ("bediening", "knoppen [{naam, index, sub, type, waarde}], schakelaars [{naam, index, sub, aan, uit}], invoer [{naam, index, sub, type, min, max}], seconden (3600)", "HMI: het recept wacht op de gebruiker, die met knoppen, schakelaars en invoervelden schrijft. Klaar = verder met de volgende stap."),
    };

    private string? _melding;
    private bool _fout;
    private bool _tabelOntbreekt;

    // ---- testrecepten ----
    private async Task LaadRecepten()
    {
        _recepten = new(); _receptTabelOntbreekt = false;
        var gekozenId = _gekozen?.Id;
        _gekozen = null; _concept = null;
        if (_type is null || !DriveProtocol.ViaSdo(_type.Protocol)) return;
        try { _recepten = await Drives.GetReceptenAsync(_type.Id); }
        catch (Exception ex)
        {
            _receptTabelOntbreekt = ex.Message.Contains("doesn't exist", StringComparison.OrdinalIgnoreCase);
            if (!_receptTabelOntbreekt) Toon("Recepten laden mislukt: " + ex.Message, true);
        }
        // na herladen (zelfde type) hetzelfde recept in de editor houden
        if (gekozenId is int id && _recepten.FirstOrDefault(x => x.Id == id) is { } terug) { _gekozen = terug; _concept = ReceptConcept.Van(terug); }
        _receptVersie++;
    }

    private async Task NieuwRecept() => await MaakRecept("Nieuw recept", "[\n  {\"stap\": \"identiteit\", \"vendor\": \"" + (_type?.VendorId ?? "") + "\", \"productcode\": \"" + (_type?.ProductCode ?? "") + "\"}\n]");

    private async Task VoorbeeldRecept() => await MaakRecept("Voorbeeld (alle bouwstenen)", DriveRecept.Voorbeeld);

    private async Task MaakRecept(string naam, string stappen)
    {
        if (_type is null) return;
        try
        {
            if (!await MagWeg()) return;
            var r = new DriveRecept { DriveTypeId = _type.Id, Naam = naam, Stappen = stappen, Volgorde = _recepten.Count + 1 };
            await Drives.BewaarReceptAsync(r, Ik.WerknemerId);
            await LaadRecepten();
            var nieuw = _recepten.Where(x => x.Naam == naam).OrderByDescending(x => x.Id).FirstOrDefault();
            if (nieuw is not null) { _gekozen = nieuw; _concept = ReceptConcept.Van(nieuw); _receptVersie++; }
        }
        catch (Exception ex) { Toon("Recept toevoegen mislukt: " + ex.Message, true); }
    }

    private async Task VerwijderRecept(DriveRecept r)
    {
        try
        {
            if (!await JS.InvokeAsync<bool>("mdeBevestig", $"Recept '{r.Naam}' verwijderen?")) return;
            await Drives.VerwijderReceptAsync(r.Id);
            if (_gekozen?.Id == r.Id) { _gekozen = null; _concept = null; }
            await LaadRecepten();
        }
        catch (Exception ex) { Toon("Verwijderen mislukt: " + ex.Message, true); }
    }

    protected override async Task OnInitializedAsync()
    {
        await Ik.ZorgGeladenAsync();
        if (!Drives.Beschikbaar) return;
        await LaadTypen();
        // link uit Producten ▸ Techniek: ?type=<id>&tab=recepten (&recept=<id>)
        if (TypeUitUrl is int tid && _typen.FirstOrDefault(x => x.Id == tid) is { } tu)
        {
            await KiesType(tu);
            if (TabUitUrl == "recepten" && DriveProtocol.ViaSdo(tu.Protocol)) _tab = "recepten";
            if (ReceptUitUrl is int rid && _recepten.FirstOrDefault(x => x.Id == rid) is { } ru) { _tab = "recepten"; await KiesRecept(ru); }
        }
    }

    [SupplyParameterFromQuery(Name = "type")] public int? TypeUitUrl { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? TabUitUrl { get; set; }
    [SupplyParameterFromQuery(Name = "recept")] public int? ReceptUitUrl { get; set; }

    private async Task LaadTypen()
    {
        try { _typen = await Drives.GetTypenAsync(); _tabelOntbreekt = false; }
        catch (Exception ex)
        {
            _tabelOntbreekt = ex.Message.Contains("doesn't exist", StringComparison.OrdinalIgnoreCase);
            if (!_tabelOntbreekt) Toon("Laden mislukt: " + ex.Message, true);
        }
    }

    private async Task KiesType(DriveSoort t)
    {
        if (_type?.Id != t.Id && !await MagWeg()) return;
        _type = t;
        if (!DriveProtocol.ViaSdo(t.Protocol)) _tab = "firmware";
        try { _firmwares = await Drives.GetFirmwaresAsync(t.Id); }
        catch (Exception ex) { Toon("Laden mislukt: " + ex.Message, true); }
        await LaadRecepten();
    }

    private async Task NieuwType()
    {
        try
        {
            var id = await Drives.BewaarTypeAsync(new DriveSoort { Naam = "(nieuw type)", ProductCode = "0x00000000" }, Ik.WerknemerId);
            await LaadTypen();
            var n = _typen.FirstOrDefault(t => t.Id == id);
            if (n is not null) await KiesType(n);
        }
        catch (Exception ex) { Toon("Toevoegen mislukt: " + ex.Message, true); }
    }

    private async Task ZetType(Action<string> zet, ChangeEventArgs e)
    {
        if (_type is null) return;
        zet(((string?)e.Value ?? "").Trim());
        try
        {
            await Drives.BewaarTypeAsync(_type, Ik.WerknemerId);
            var id = _type.Id;
            await LaadTypen();
            _type = _typen.FirstOrDefault(t => t.Id == id) ?? _type;
            Toon("Opgeslagen.", false);
        }
        catch (Exception ex) { Toon("Opslaan mislukt: " + ex.Message, true); }
    }

    private async Task VerwijderType()
    {
        if (_type is null) return;
        if (!await Bevestig($"Drivetype '{_type.Naam}' verwijderen, inclusief {_firmwares.Count} firmwareversie(s)?")) return;
        try
        {
            await Drives.VerwijderTypeAsync(_type.Id);
            _type = null; _firmwares = new();
            await LaadTypen();
        }
        catch (Exception ex) { Toon("Verwijderen mislukt: " + ex.Message, true); }
    }

    // ------------------------------------------------------------ firmwares
    private async Task NieuweFirmware()
    {
        if (!MagFirmware) { Toon("Firmware toevoegen of wijzigen mag alleen met het recht MagFirmware.", true); return; }
        if (_type is null) return;
        try
        {
            var status = _firmwares.Any(f => f.Status == DriveStatus.Actueel) ? DriveStatus.Toegestaan : DriveStatus.Actueel;
            await Drives.BewaarFirmwareAsync(new DriveFirmware { DriveTypeId = _type.Id, Versie = "(versie)", Status = status }, Ik.WerknemerId);
            await KiesType(_type);
        }
        catch (Exception ex) { Toon("Toevoegen mislukt: " + ex.Message, true); }
    }

    private async Task ZetFirmware(DriveFirmware f, Action<string> zet, ChangeEventArgs e)
    {
        if (!MagFirmware) { Toon("Firmware toevoegen of wijzigen mag alleen met het recht MagFirmware.", true); return; }
        zet(((string?)e.Value ?? "").Trim());
        await BewaarFirmware(f);
    }

    private async Task ZetDatum(DriveFirmware f, ChangeEventArgs e)
    {
        if (!MagFirmware) { Toon("Firmware toevoegen of wijzigen mag alleen met het recht MagFirmware.", true); return; }
        f.Vrijgegeven = DateTime.TryParse((string?)e.Value, out var d) ? d : null;
        await BewaarFirmware(f);
    }

    private async Task BewaarFirmware(DriveFirmware f)
    {
        try { await Drives.BewaarFirmwareAsync(f, Ik.WerknemerId); Toon("Opgeslagen.", false); }
        catch (Exception ex) { Toon("Opslaan mislukt: " + ex.Message, true); }
    }

    private async Task ZetStatus(DriveFirmware f, ChangeEventArgs e)
    {
        if (!MagFirmware) { Toon("Firmware toevoegen of wijzigen mag alleen met het recht MagFirmware.", true); return; }
        var status = (string?)e.Value ?? DriveStatus.Toegestaan;
        try
        {
            await Drives.ZetFirmwareStatusAsync(f.Id, status, Ik.WerknemerId);
            if (_type is not null) await KiesType(_type);   // de vorige 'actueel' is nu 'toegestaan'
            Toon($"Versie {f.Versie} is nu {status}.", false);
        }
        catch (Exception ex) { Toon("Status zetten mislukt: " + ex.Message, true); }
    }

    private async Task VerwijderFirmware(DriveFirmware f)
    {
        if (!MagFirmware) { Toon("Firmware toevoegen of wijzigen mag alleen met het recht MagFirmware.", true); return; }
        if (!await Bevestig($"Firmwareversie '{f.Versie}' verwijderen? Parametersets die eraan hangen gaan mee.")) return;
        try
        {
            if (f.FirmwareFileId is int a) await Store.VerwijderAsync(a);
            if (f.DictionaryFileId is int b) await Store.VerwijderAsync(b);
            if (f.EsiFileId is int c) await Store.VerwijderAsync(c);
            await Drives.VerwijderFirmwareAsync(f.Id);
            if (_type is not null) await KiesType(_type);
        }
        catch (Exception ex) { Toon("Verwijderen mislukt: " + ex.Message, true); }
    }

    // ------------------------------------------------------------ bestanden
    /// <summary>Cel met bestandsnaam + download, of een uploadknopje als er nog niets is.</summary>
    private RenderFragment Bestandcel(DriveFirmware f, int? fileId, string naam, int storeType) => __builder =>
    {
        if (fileId is int id)
        {
            <div class="drv-bestand">
                <a class="knopje" href="@("bestand/" + id + "/download")" title="Downloaden: @naam">⬇ @naam</a>
                <button class="klein" title="Vervangen door een ander bestand" @onclick="() => _vervang = _vervang == (f.Id, storeType) ? null : (f.Id, storeType)">↻</button>
            </div>
            @if (_vervang == (f.Id, storeType))
            {
                <InputFile OnChange="e => Upload(f, storeType, e)" />
            }
        }
        else
        {
            <InputFile OnChange="e => Upload(f, storeType, e)" />
        }
    };

    private (int, int)? _vervang;

    private async Task Upload(DriveFirmware f, int storeType, InputFileChangeEventArgs e)
    {
        if (!MagFirmware) { Toon("Firmware toevoegen of wijzigen mag alleen met het recht MagFirmware.", true); return; }
        if (!Store.Beschikbaar) { Toon("De filestore is niet ingesteld (Filestore:Pad).", true); return; }
        try
        {
            var bestand = e.File;
            await using var stroom = bestand.OpenReadStream(200 * 1024 * 1024);
            var nieuwId = await Store.ToevoegenAsync(stroom, bestand.Name, storeType, f.Id, Ik.WerknemerId ?? 0);

            int? oud;
            switch (storeType)
            {
                case DriveStore.Firmware:   oud = f.FirmwareFileId;   f.FirmwareFileId = nieuwId;   break;
                case DriveStore.Dictionary: oud = f.DictionaryFileId; f.DictionaryFileId = nieuwId; break;
                default:                    oud = f.EsiFileId;        f.EsiFileId = nieuwId;        break;
            }
            await Drives.BewaarFirmwareAsync(f, Ik.WerknemerId);
            if (oud is int o) { try { await Store.VerwijderAsync(o); } catch { } }

            _vervang = null;
            if (_type is not null) await KiesType(_type);
            Toon($"'{bestand.Name}' opgeslagen.", false);
        }
        catch (Exception ex) { Toon("Upload mislukt: " + ex.Message, true); }
    }

    private string CodeVoorbeeld => _type?.Protocol switch
    {
        DriveProtocol.Feetech => "STS3215",
        DriveProtocol.Coe => "0x00029252",
        DriveProtocol.Mde => "0x00055955",
        DriveProtocol.Esp32 => "auto",
        DriveProtocol.Stm32 => "stm32g474retx",
        _ => "0x03B11001",
    };
    private bool IsChip => _type is not null && DriveProtocol.IsChip(_type.Protocol);

    private static string StatusTitel(DriveFirmware f)
        => DriveStatus.Uitleg(f.Status) + (f.StatusOp is null ? "" : $" — {f.StatusDoor}, {f.StatusOp:dd-MM-yyyy HH:mm}");

    private async Task<bool> Bevestig(string vraag)
    {
        try { return await JS.InvokeAsync<bool>("mdeBevestig", vraag); }
        catch { return true; }
    }

    private void Toon(string tekst, bool fout) { _melding = tekst; _fout = fout; }
}
