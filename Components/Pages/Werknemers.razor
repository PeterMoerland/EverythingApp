    private List<GebeurtenisSoort> _soorten = new();
    private List<Gebeurtenis> _tijdlijn = new();
    private Gebeurtenis? _gebeurtenis;
    private bool _toonPrive = true;

    private bool MagPrive => !Ik.Gekoppeld || Ik.Mag("HRM") || Ik.Mag("Directie");

    private async Task LaadTijdlijn()
    {
        if (_gekozenId is null || !WnRepo.Beschikbaar) { _tijdlijn = new(); return; }
        try
        {
            if (_soorten.Count == 0) _soorten = await WnRepo.GetSoortenAsync();
            _tijdlijn = await WnRepo.GetTijdlijnAsync(_gekozenId.Value, MagPrive && _toonPrive);
        }
        catch (Exception ex)
        {
            _tijdlijn = new();
            Toon("Tijdlijn ophalen mislukt: " + ex.Message, true);
        }
    }

    private async Task PriveGewijzigd(ChangeEventArgs e)
    {
        _toonPrive = Vink(e);
        await LaadTijdlijn();
    }

    private void NieuweGebeurtenis()
    {
        var eerste = _soorten.FirstOrDefault();
        _gebeurtenis = new Gebeurtenis
        {
            WerknemerId = _gekozenId ?? 0,
            SoortId = eerste?.Id ?? 0,
            Moment = DateTime.Today,
            Prive = eerste?.StandaardPrive ?? false
        };
    }

    private void BewerkGebeurtenis(Gebeurtenis g) => _gebeurtenis = new Gebeurtenis
    {
        Id = g.Id, WerknemerId = g.WerknemerId, SoortId = g.SoortId, Moment = g.Moment,
        Toelichting = g.Toelichting, FunctieId = g.FunctieId, Contracturen = g.Contracturen,
        WerkzaamBij = g.WerkzaamBij, Bedrag = g.Bedrag, TotDatum = g.TotDatum, Prive = g.Prive,
        // ook de arbeidsvoorwaarden meenemen, anders worden ze bij opslaan leeggemaakt
        BrutoSalaris = g.BrutoSalaris, DertiendeMaand = g.DertiendeMaand,
        VrijeDagen = g.VrijeDagen, AtvDagen = g.AtvDagen
    };

    private void MomentGewijzigd(DateOnly? d)
    {
        if (_gebeurtenis is not null && d is not null)
            _gebeurtenis.Moment = d.Value.ToDateTime(TimeOnly.MinValue);
    }

    private void TotDatumGewijzigd(DateOnly? d)
    {
        if (_gebeurtenis is not null) _gebeurtenis.TotDatum = d;
    }

    /// <summary>Naam van een functie uit Werknemers_Functie, of null.</summary>
    private string? FunctieNaam(int? id) =>
        id is null ? null : _functies.FirstOrDefault(f => f.Id == id)?.Naam;

    private async Task BewaarGebeurtenis()
    {
        if (_gebeurtenis is null) return;
        try
        {
            var functie = _gebeurtenis.FunctieId;
            var moment = _gebeurtenis.Moment;
            var werknemer = _gebeurtenis.WerknemerId;

            await WnRepo.BewaarGebeurtenisAsync(_gebeurtenis);

            // Is de functie gewijzigd en geldt dat nu al? Dan ook de huidige functie in
            // Werknemers bijwerken, zodat Access hetzelfde ziet zolang beide systemen draaien.
            if (functie is not null && moment.Date <= DateTime.Today && _kolommen.Contains("id_functie"))
            {
                try
                {
                    await Repo.UpdateWerknemerVeldAsync(werknemer, "id_functie", functie);
                    _velden["id_functie"] = functie;
                }
                catch { /* kolom ontbreekt of geen rechten: tijdlijn blijft leidend */ }
            }

            _gebeurtenis = null;
            await LaadTijdlijn();
            Toon("Gebeurtenis opgeslagen.", false);
        }
        catch (Exception ex) { Toon("Opslaan mislukt: " + ex.Message, true); }
    }

    // ---- documenten bij een gebeurtenis ----
    private int? _documentenVoor;
    private List<Bestand> _documenten = new();
    private bool _sleepActief;
    private string? _uploadMelding;

    private async Task ToonDocumenten(Gebeurtenis g)
    {
        _uploadMelding = null;
        if (_documentenVoor == g.Id) { _documentenVoor = null; return; }   // dichtklappen
        _documentenVoor = g.Id;
        await LaadDocumenten(g.Id);
    }

    private async Task LaadDocumenten(int gebeurtenisId)
    {
        try { _documenten = await WnRepo.GetBestandenAsync(301, gebeurtenisId); }
        catch { _documenten = new(); }
    }

    /// <summary>Ja/nee-vraag, zoals MsgBox in de Access-versie.</summary>
    private async Task<bool> Bevestig(string vraag)
    {
        try { return await JS.InvokeAsync<bool>("mdeBevestig", vraag); }
        catch { return true; }   // geen dialoog beschikbaar: niet blokkeren
    }

    private async Task VerwijderDocument(Bestand b, int gebeurtenisId)
    {
        if (!await Bevestig($"'{b.Bestandsnaam}' verwijderen?\n\nHet bestand wordt ook van schijf gehaald. Weet je het zeker?"))
            return;
        try
        {
            await Store.VerwijderAsync(b.FileStoreId);
            await LaadDocumenten(gebeurtenisId);
            await LaadTijdlijn();
            _uploadMelding = $"'{b.Bestandsnaam}' verwijderd.";
        }
        catch (Exception ex)
        {
            _uploadMelding = "Verwijderen mislukt: " + ex.Message;
        }
    }

    private async Task BestandenGekozen(InputFileChangeEventArgs e, int gebeurtenisId)
    {
        _sleepActief = false;
        if (!Store.Beschikbaar)
        {
            _uploadMelding = "De filestore is niet ingesteld (Filestore:Pad in appsettings.json).";
            return;
        }

        var toegevoegd = 0;
        foreach (var bestand in e.GetMultipleFiles(20))
        {
            try
            {
                await using var stroom = bestand.OpenReadStream(50 * 1024 * 1024);   // max 50 MB
                await Store.ToevoegenAsync(stroom, bestand.Name, 301, gebeurtenisId, Ik.WerknemerId ?? 0);
                toegevoegd++;
            }
            catch (Exception ex)
            {
                _uploadMelding = $"'{bestand.Name}' mislukt: {ex.Message}";
            }
        }

        if (toegevoegd > 0) _uploadMelding = $"{toegevoegd} bestand(en) toegevoegd.";
        await LaadDocumenten(gebeurtenisId);
        await LaadTijdlijn();
    }

    private async Task VerwijderGebeurtenis()
    {
        if (_gebeurtenis is null || _gebeurtenis.Id == 0) return;
        if (!await Bevestig("Deze gebeurtenis verwijderen? Weet je het zeker?")) return;
        try
        {
            await WnRepo.VerwijderGebeurtenisAsync(_gebeurtenis.Id);
            _gebeurtenis = null;
            await LaadTijdlijn();
        }
        catch (Exception ex) { Toon("Verwijderen mislukt: " + ex.Message, true); }
    }

    /// <summary>Eerste kandidaat-kolom die in de database bestaat.</summary>
    private string? Kolom(Veld veld) => veld.Kolommen.FirstOrDefault(k => _kolommen.Contains(k));

    private string Tekst(string kolom)
    {
        if (!_velden.TryGetValue(kolom, out var v) || v is null) return "";
        if (v is DateTime dt) return dt.ToString("dd-MM-yyyy");
        return v.ToString() ?? "";
    }

    private DateOnly? DatumWaarde(string kolom)
    {
        if (!_velden.TryGetValue(kolom, out var v) || v is null) return null;
        if (v is DateTime dt) return DateOnly.FromDateTime(dt);
        return DateTime.TryParse(v.ToString(), out var d) ? DateOnly.FromDateTime(d) : null;
    }

    /// <summary>Leeftijd in hele jaren, of null als er geen datum staat.</summary>
    private int? Leeftijd(string kolom)
    {
        var d = DatumWaarde(kolom);
        if (d is null) return null;
        var vandaag = DateOnly.FromDateTime(DateTime.Today);
        var jaren = vandaag.Year - d.Value.Year;
        if (d.Value.AddYears(jaren) > vandaag) jaren--;   // verjaardag nog niet gehad
        return jaren is >= 0 and < 130 ? jaren : null;
    }

    private async Task BewaarDatumWaarde(string kolom, DateOnly? d) =>
        await Bewaar(kolom, d is null ? null : d.Value.ToDateTime(TimeOnly.MinValue));

    private bool Waar(string kolom)
    {
        if (!_velden.TryGetValue(kolom, out var v) || v is null) return false;
        if (v is bool b) return b;
        try { return Convert.ToInt64(v) != 0; } catch { return false; }
    }

    private Task? _opslaanBezig;

    /// <summary>
    /// Een lopende veldwijziging eerst laten afronden. Het onchange van een veld vuurt bij het verlaten ervan, vlak
    /// vóór de klik op een ander record; zonder wachten laadt dat record al terwijl de UPDATE nog loopt en komt de
    /// oude waarde in de velden van het nieuwe record terecht (opmerking leek dan niet opgeslagen).
    /// </summary>
    private async Task WachtOpOpslaan()
    {
        if (_opslaanBezig is { IsCompleted: false } t) { try { await t; } catch { } }
    }

    private Task Bewaar(string kolom, object? waarde) => _opslaanBezig = BewaarKern(kolom, waarde);

    private async Task BewaarKern(string kolom, object? waarde)
    {
        if (_gekozenId is null) return;
        var vanId = _gekozenId.Value;
        try
        {
            var opslaan = waarde is string s && string.IsNullOrWhiteSpace(s) ? null : waarde;
            await Repo.UpdateWerknemerVeldAsync(vanId, kolom, opslaan);
            if (_gekozenId == vanId) _velden[kolom] = opslaan;
            Toon("Opgeslagen.", false);
        }
        catch (Exception ex)
        {
            Toon("Opslaan mislukt: " + ex.Message, true);
        }
    }

    // ---- afbeeldingsvelden (handtekening, foto) ----
    private string? _sleepAfbeelding;
    private int _fotoVersie;                 // dwingt de browser de foto opnieuw te laden
    private List<Bestand> _fotos = new();    // alle foto's van deze werknemer (StoreType 302)

    // ================================================================
