    /// <summary>Naam van de huidige functie, of null als die niet bekend is.</summary>
    private string? HuidigeFunctie()
    {
        var kolom = new[] { "id_functie", "Id_functie", "functie_id" }.FirstOrDefault(_kolommen.Contains);
        if (kolom is null || !_velden.TryGetValue(kolom, out var v) || v is null) return null;
        if (!int.TryParse(v.ToString(), out var id)) return null;
        return _functies.FirstOrDefault(f => f.Id == id)?.Naam;
    }

    private DateTime? DienstSinds()
    {
        var kolom = new[] { "in dienst", "In dienst", "Datum in-dienst", "DatumInDienst", "datum_in_dienst" }
            .FirstOrDefault(_kolommen.Contains);
        if (kolom is null || !_velden.TryGetValue(kolom, out var v) || v is null) return null;
        return v is DateTime dt ? dt : DateTime.TryParse(v.ToString(), out var d) ? d : null;
    }

    private static int Dienstjaren(DateTime sinds)
    {
        var jaren = DateTime.Today.Year - sinds.Year;
        if (sinds.Date > DateTime.Today.AddYears(-jaren)) jaren--;
        return Math.Max(jaren, 0);
    }

    private void NaarLoopbaan() => _tab = "Loopbaan";

    private const int StoreTypeFoto = 302;

    /// <summary>Is er een foto: in de filestore, of in de oude kolom (bytes of pad)?</summary>
    private bool HeeftFoto(string kolom)
    {
        if (_fotos.Count > 0) return true;
        if (!_velden.TryGetValue(kolom, out var v) || v is null) return false;
        if (v is byte[] b) return b.Length > 8;
        return v is string s && !string.IsNullOrWhiteSpace(s);
    }

    /// <summary>Alleen het oude pad teruggeven als het écht tekst is (geen bytes).</summary>
    private string? OudPad(string kolom)
    {
        if (_fotos.Count > 0) return null;      // al overgezet naar de filestore
        if (!_velden.TryGetValue(kolom, out var v)) return null;
        return v is string s && !string.IsNullOrWhiteSpace(s) ? s : null;
    }

    private int? HoofdfotoId { get; set; }

    private async Task LaadFotos()
    {
        if (_gekozenId is null || !WnRepo.Beschikbaar) { _fotos = new(); HoofdfotoId = null; return; }
        try
        {
            _fotos = await WnRepo.GetBestandenAsync(StoreTypeFoto, _gekozenId.Value);
            var gekozen = await WnRepo.GetHoofdfotoAsync(_gekozenId.Value);
            // Geen keuze gemaakt (of die foto is weg)? Dan is de nieuwste de hoofdfoto.
            HoofdfotoId = _fotos.Any(f => f.FileStoreId == gekozen) ? gekozen : _fotos.FirstOrDefault()?.FileStoreId;
        }
        catch { _fotos = new(); HoofdfotoId = null; }
    }

    private async Task ZetHoofdfoto(Bestand f)
    {
        if (_gekozenId is null) return;
        try
        {
            await WnRepo.ZetHoofdfotoAsync(_gekozenId.Value, f.FileStoreId);
            HoofdfotoId = f.FileStoreId;
            _fotoVersie++;
            Toon("Hoofdfoto gewijzigd.", false);
        }
        catch (Exception ex)
        {
            Toon("Hoofdfoto instellen mislukt: " + ex.Message +
                 " — bestaat de tabel Werknemer_Hoofdfoto al?", true);
        }
    }

    private async Task VerwijderFoto(Bestand f)
    {
        if (!await Bevestig("Deze foto verwijderen? Weet je het zeker?")) return;
        try
        {
            await Store.VerwijderAsync(f.FileStoreId);
            await LaadFotos();
            _fotoVersie++;
            Toon("Foto verwijderd.", false);
        }
        catch (Exception ex)
        {
            Toon("Verwijderen mislukt: " + ex.Message, true);
        }
    }

    /// <summary>Nieuwe pasfoto: gaat naar de filestore (302), niet meer als pad in de tabel.</summary>
    private async Task PasfotoGekozen(InputFileChangeEventArgs e, string kolom)
    {
        _sleepAfbeelding = null;
        var bestand = e.File;
        if (bestand is null || _gekozenId is null) return;

        if (!Store.Beschikbaar)
        {
            Toon("De filestore is niet ingesteld (Filestore:Pad in appsettings.json).", true);
            return;
        }

        try
        {
            await using var stroom = bestand.OpenReadStream(10 * 1024 * 1024);   // max 10 MB
            await Store.ToevoegenAsync(stroom, bestand.Name, StoreTypeFoto,
                                       _gekozenId.Value, Ik.WerknemerId ?? 0);
            _fotoVersie++;
            await LaadFotos();
            Toon("Foto toegevoegd aan de filestore.", false);
        }
        catch (Exception ex)
        {
            Toon("Foto opslaan mislukt: " + ex.Message, true);
        }
    }

    private async Task AfbeeldingGekozen(InputFileChangeEventArgs e, string kolom)
    {
        _sleepAfbeelding = null;
        var bestand = e.File;
        if (bestand is null || _gekozenId is null) return;
        try
        {
            await using var stroom = bestand.OpenReadStream(4 * 1024 * 1024);   // max 4 MB
            using var geheugen = new MemoryStream();
            await stroom.CopyToAsync(geheugen);
            await Bewaar(kolom, geheugen.ToArray());
        }
        catch (Exception ex)
        {
            Toon("Afbeelding opslaan mislukt: " + ex.Message, true);
        }
    }

