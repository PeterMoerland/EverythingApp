        "BV" => _bvs,
        "Functie" => _functies,
        "Activiteit" => _activiteiten,
        _ => new List<Keuze>()
    };

    private async Task LaadKeuzelijsten()
    {
        if (!WnRepo.Beschikbaar) return;
        try
        {
            _bvs = await WnRepo.GetBVsAsync();
            _functies = await WnRepo.GetFunctiesAsync();
            _activiteiten = await WnRepo.GetActiviteitenLijstAsync();
            _pasTypes = await WnRepo.GetPasTypesAsync();
            _bankrekeningen = await WnRepo.GetBankrekeningenAsync();
        }
        catch { /* lijsten blijven leeg */ }
    }

    private async Task BewaarKeuze(string kolom, string? waarde)
    {
        if (string.IsNullOrWhiteSpace(waarde)) { await Bewaar(kolom, null); return; }
        await Bewaar(kolom, int.TryParse(waarde, out var id) ? id : null);
    }

    private async Task BewaarDatum(string kolom, string? waarde)
    {
        if (string.IsNullOrWhiteSpace(waarde)) { await Bewaar(kolom, null); return; }
        await Bewaar(kolom, DateTime.TryParse(waarde, out var d) ? d : null);
    }

    private void Toon(string tekst, bool fout)
    {
        _melding = tekst;
        _meldingFout = fout;
    }
