@page "/activityboard"
@page "/activityboard/{BoardId:int}"
@using EverythingApp.Models
@implements IAsyncDisposable
@inject IActivityBoardRepository Repo
@inject IProjectRepository Projecten
@inject IRelatieRepository Relaties
@inject IUrenRepository Uren
@inject IWerknemerRepository Bestanden
@inject FilestoreService Store
@inject ActivityBoardLive Live
@inject HuidigeGebruiker Ik
@inject IJSRuntime JS
@inject NavigationManager Nav

@* Activity board (spec "Design specificatie MDE Activity Board", Freek Moerland, prototype v0.5).
   Onderwerpen op volgorde van prioriteit; het kanbanbord heeft een baan per onderwerp in die volgorde.
   Een kaart staat één keer op het bord: in de baan van het gekoppelde onderwerp met de hoogste prioriteit.
   Elke wijziging gaat direct naar de database; collega's op hetzelfde board zien hem meteen (ActivityBoardLive).
   Slepen: wwwroot/activityboard.js. Fase 1: nog geen snel-editor met alle velden en geen ongedaan maken
   van alles (wel van verwijderen). *@

<PageTitle>@(_data is null ? "Activity board" : "Activity board · " + _data.Board.Titel)</PageTitle>

<div class="page ab">
@if (!Repo.Beschikbaar)
{
    <div class="topbar"><h1>Activity board</h1></div>
    <div class="melding">Geen database-verbinding (demo-modus).</div>
}
else if (_tabellen == false)
{
    <div class="topbar"><h1>Activity board</h1></div>
    <div class="melding fout">De tabellen ontbreken nog: voer <code>ActivityBoard_MariaDB.sql</code> uit op de MDE-database.</div>
}
else if (BoardId is null)
{
    @* ---------- startscherm: alle boards, en een board openen voor een project of klant, of een vrij board maken ---------- *@
    <div class="topbar"><h1>Activity board</h1></div>
    <p class="uitleg">Een board per project, per werkorder of per klant, of een vrij board met alleen een naam: onderwerpen op volgorde van
        prioriteit en activiteiten op een kanbanbord.</p>
    <section class="ab-paneel">
        <div class="ab-pkop-vast">
            <span class="ab-titel">Boards</span><span class="ab-count">@BoardsGefilterd.Count()</span>
            <span class="ab-soortfilter">
                <button type="button" class="ab-vtab @(_boom ? "actief" : "")" @onclick="() => ZetBoom(true)" title="Klant ▸ project ▸ werkorder">Boom</button>
                <button type="button" class="ab-vtab @(_boom ? "" : "actief")" @onclick="() => ZetBoom(false)">Lijst</button>
            </span>
            @if (_soorten)
            {
                <span class="ab-soortfilter">
                    @foreach (var (sc, sn) in SoortFilters)
                    {
                        <button type="button" class="ab-vtab @(_boardSoort == sc ? "actief" : "")" @onclick="() => _boardSoort = sc">@sn</button>
                    }
                </span>
            }
        </div>
        @if (_boards is null)
        {
            <p class="ab-leeg">Laden…</p>
        }
        else if (_boards.Count == 0)
        {
            <p class="ab-leeg">Nog geen boards. Kies hieronder een project@(_soorten ? (_metWerkorder ? ", werkorder" : "") + " of klant, of maak een vrij board" : "") om te beginnen.</p>
        }
        else if (_boom)
        {
            @* boom (wens gebruiker 24-10-2026): Klant ▸ Project ▸ Werkorder ▸ subwerkorder; vrije boards en boards zonder klant apart *@
            <div class="ab-boomkop">
                <input class="ab-boomzoek" placeholder="Zoek klant, project, werkorder of board…" value="@_boomZoek" autocomplete="off"
                       @oninput="e => _boomZoek = (string?)e.Value ?? string.Empty" />
                <button type="button" class="ab-btn klein" @onclick="AllesUit">Alles uitklappen</button>
                <button type="button" class="ab-btn klein" @onclick="() => _boomOpen.Clear()">Alles inklappen</button>
            </div>
            var wortels = Boom();
            @if (wortels.Count == 0)
            {
                <p class="ab-leeg">Niets gevonden.</p>
            }
            <ul class="ab-boom">
                @foreach (var k in wortels) { @Knoop(k, 0) }
            </ul>
        }
        else
        {
            <table class="ab-tabel ab-boards">
                <thead><tr><th>Soort</th><th>Nummer</th><th>Board</th><th>Open</th><th>Klaar</th><th>Laatst gewijzigd</th></tr></thead>
                <tbody>
                @foreach (var b in BoardsGefilterd)
                {
                    <tr class="ab-rij" tabindex="0" @key="b.BoardId" @onclick="() => NaarBoard(b.BoardId)"
                        @onkeydown="e => BoardToets(e, b.BoardId)">
                        <td><span class="ab-soort ab-soort-@b.Soort">@ActBoardSoort.Naam(b.Soort)</span></td>
                        <td class="ab-num">@(b.Soort == ActBoardSoort.Werkorder ? b.WerkorderNummer : b.ProjectNummer?.ToString())</td>
                        <td class="ab-t">@b.Titel@if (b.Naam.Length > 0 && b.Soort != ActBoardSoort.Vrij) { <small class="ab-muted"> · @(b.Soort == ActBoardSoort.Klant ? b.RelatieNaam : b.Soort == ActBoardSoort.Werkorder ? b.WerkorderNummer : b.ProjectNaam)</small> }</td>
                        <td class="ab-num">@b.Open</td>
                        <td class="ab-num">@b.Klaar</td>
                        <td class="ab-num">@(b.Gewijzigd?.ToString("dd-MM-yyyy HH:mm") ?? "")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>
    <section class="ab-paneel ab-sub">
        <div class="ab-pkop-vast"><span class="ab-titel">Board openen of maken</span></div>
        @ZoekVak(koppelen: false)
        @if (!_soorten)
        {
            <p class="ab-hint ab-hint-los">Boards voor een klant of vrije boards: voer eerst <code>ActivityBoard_Soorten_MariaDB.sql</code> uit.</p>
        }
    </section>
}
else if (_data is null)
{
    <div class="topbar"><h1>Activity board</h1></div>
    <p class="ab-leeg">@(_laadFout ?? "Laden…")</p>
}
else
{
    var idx = ProbIndex();
    var tel = TelPerProbleem();

    @* ---------- kop ---------- *@
    <div class="ab-kop">
        <div>
            <div class="ab-eyebrow">Activity board · @ActBoardSoort.Naam(_data.Board.Soort)@if (_data.Board.Naam.Length > 0 && _data.Board.Soort != ActBoardSoort.Vrij) { <span class="ab-muted"> · @_data.Board.StandaardTitel</span> }</div>
            <h1>@if (_data.Board.ProjectNummer is int nr && _data.Board.Naam.Length == 0) { <span class="ab-mono ab-nr">@nr</span> }<input class="ab-bordnaam" @key="BordNaamSleutel" value="@(_data.Board.Naam.Length > 0 ? _data.Board.Naam : _data.Board.ProjectNummer is null ? _data.Board.StandaardTitel : _data.Board.ProjectNaam)"
                       placeholder="@_data.Board.StandaardTitel" aria-label="Naam van het board" autocomplete="off" spellcheck="false"
                       title="Naam van het board; leeg = de naam van het project of de klant" @onchange="HernoemBoard" @onkeydown="InvoerEnterBlur" /></h1>
        </div>
        <div class="ab-acties">
            <a class="ab-link" href="activityboard">Alle boards</a>
            @if (_soorten)
            {
                <button class="ab-btn" type="button" @onclick="OpenKoppel" title="Dit board aan een project, werkorder of klant hangen, of losmaken">Koppelen…</button>
            }
            <button class="ab-btn" type="button" @onclick="NaarExcel" title="Activiteiten van dit board naar Excel (csv)">Naar Excel</button>
        </div>
    </div>

    @* ---------- problemen ---------- *@
    <section class="ab-paneel">
        <div class="ab-pkop @(_probDicht ? "dicht" : "")" role="button" tabindex="0" aria-expanded="@(!_probDicht)"
             @onclick="() => _probDicht = !_probDicht" @onkeydown="e => Klap(e, () => _probDicht = !_probDicht)">
            <span class="ab-caret">▼</span><span class="ab-titel">Onderwerpen</span>
            <span class="ab-count">@_data.Problemen.Count · volgorde = prioriteit</span>
            <span class="ab-hint">Sleep aan ⠿ om de prioriteit te wijzigen</span>
        </div>
        @if (!_probDicht)
        {
            <ol id="ab-problijst">
                @if (_data.Problemen.Count == 0)
                {
                    <li class="ab-leeg">Nog geen onderwerpen. Voeg hieronder het eerste onderwerp toe.</li>
                }
                @for (var i = 0; i < _data.Problemen.Count; i++)
                {
                    var p = _data.Problemen[i];
                    var t = tel.GetValueOrDefault(p.Id);
                    <li class="ab-prob" data-id="@p.Id" @key="p.Id">
                        <button class="ab-greep" type="button" title="Sleep om de prioriteit te wijzigen (of gebruik pijltjestoetsen)"
                                aria-label="@("Prioriteit van " + p.Naam + " wijzigen")">⠿</button>
                        <span class="ab-pnr">@(i + 1)</span>
                        <span class="ab-pnaam">
                            <span class="ab-pdot ab-dot-@p.Kleur"></span>
                            <input @key="NaamSleutel(p.Id)" value="@p.Naam" aria-label="@("Naam onderwerp " + (i + 1))"
                                   @onchange="e => HernoemProbleem(p, e)" @onkeydown="InvoerEnterBlur" />
                        </span>
                        @{ var nb = _bijlagen.GetValueOrDefault(p.Id)?.Count ?? 0; }
                        <button class="ab-pbijl @(nb > 0 ? "heeft" : "") @(_bijlagenOpen == p.Id ? "open" : "")" type="button"
                                title="@(nb > 0 ? $"{nb} bijlage(n): plaatjes en bestanden" : "Plaatje of bestand toevoegen")"
                                @onclick="() => WisselBijlagen(p.Id)">📎@(nb > 0 ? nb.ToString() : "")</button>
                        <span class="ab-ptel"><b>@t.Open</b> open · @t.Klaar klaar</span>
                        <button class="ab-pdel" type="button" title="Onderwerp verwijderen" aria-label="@(p.Naam + " verwijderen")"
                                @onclick="() => VerwijderProbleem(p)">×</button>
                    </li>
                    @if (_bijlagenOpen == p.Id)
                    {
                        @* geen ab-prob: het slepen (activityboard.js) slaat deze regel over *@
                        <li class="ab-prob-bijlagen" @key='("bijl", p.Id)' @ref="_bijlagenVak" tabindex="-1">
                            <div class="ab-bijl-lijst">
                                @foreach (var bst in _bijlagen.GetValueOrDefault(p.Id) ?? new())
                                {
                                    <span class="ab-bijl" @key="bst.FileStoreId">
                                        @if (IsPlaatje(bst.Bestandsnaam))
                                        {
                                            <a href="@($"bestand/{bst.FileStoreId}")" target="_blank" rel="noopener" title="@bst.Bestandsnaam">
                                                <img src="@($"bestand/{bst.FileStoreId}")" alt="@bst.Bestandsnaam" loading="lazy" /></a>
                                        }
                                        else
                                        {
                                            <a class="ab-bijl-bestand" href="@($"bestand/{bst.FileStoreId}")" target="_blank" rel="noopener">📄 @bst.Bestandsnaam</a>
                                        }
                                        <button class="ab-bijl-weg" type="button" title="Bijlage verwijderen" @onclick="() => WisBijlage(p, bst)">×</button>
                                    </span>
                                }
                            </div>
                            <div class="ab-bijl-toevoegen">
                                <span>📷 Plaatje: <b>Win+Shift+S</b>, dan <b>Ctrl+V</b> hier, of</span>
                                <label class="ab-btn klein">bestand kiezen…<InputFile OnChange="e => BijlagenGekozen(p, e)" multiple style="display:none" /></label>
                                @if (_bijlBezig) { <span class="ab-muted">opslaan…</span> }
                            </div>
                        </li>
                    }
                }
            </ol>
            <div class="ab-padd">
                <input id="ab-probnieuw" placeholder="Nieuw onderwerp toevoegen…" aria-label="Nieuw onderwerp" autocomplete="off"
                       value="@_nieuwProbleem" @oninput="e => _nieuwProbleem = (string?)e.Value ?? string.Empty"
                       @onkeydown="ProbNieuwToets" />
                <button class="ab-btn klein" type="button" @onclick="VoegProbleemToe">Toevoegen</button>
            </div>
        }
    </section>

    @* ---------- types ---------- *@
    <section class="ab-paneel ab-sub">
        <div class="ab-pkop @(_typeDicht ? "dicht" : "")" role="button" tabindex="0" aria-expanded="@(!_typeDicht)"
             @onclick="() => _typeDicht = !_typeDicht" @onkeydown="e => Klap(e, () => _typeDicht = !_typeDicht)">
            <span class="ab-caret">▼</span><span class="ab-titel">Types</span>
            <span class="ab-count">@_data.Types.Count</span>
            <span class="ab-hint">Om activiteiten in te delen; vrij te kiezen</span>
        </div>
        @if (!_typeDicht)
        {
            <div class="ab-typelijst">
                @if (_data.Types.Count == 0) { <span class="ab-leeg">Nog geen types.</span> }
                @foreach (var ty in _data.Types)
                {
                    <span class="ab-chip ab-tchip ab-k-@ty.Kleur" @key="ty.Id">
                        @if (_typeHernoem == ty.Id)
                        {
                            <input class="ab-tin" value="@ty.Naam" aria-label="Naam type" id="@("ab-type-" + ty.Id)"
                                   @onchange="e => HernoemType(ty, e)" @onkeydown="e => TypeHernoemToets(e)"
                                   @onblur="() => _typeHernoem = null" />
                        }
                        else
                        {
                            <button type="button" class="ab-tnaam" title="Klik om te hernoemen" @onclick="() => StartTypeHernoem(ty)">@ty.Naam</button>
                        }
                        <span class="ab-tn">@_data.Activiteiten.Count(a => a.Types.Contains(ty.Id))</span>
                        <button type="button" class="ab-x" title="Type verwijderen" aria-label="@("Type " + ty.Naam + " verwijderen")"
                                @onclick="() => VerwijderType(ty)">×</button>
                    </span>
                }
            </div>
            <div class="ab-padd ab-vrij">
                <input id="ab-typenieuw" placeholder="Nieuw type toevoegen…" aria-label="Nieuw type" autocomplete="off"
                       value="@_nieuwType" @oninput="e => _nieuwType = (string?)e.Value ?? string.Empty" @onkeydown="TypeNieuwToets" />
                <button class="ab-btn klein" type="button" @onclick="VoegTypeToe">Toevoegen</button>
            </div>
        }
    </section>

    @* ---------- weergavebalk ---------- *@
    <div class="ab-viewbar">
        @foreach (var (code, naam) in Weergaven)
        {
            <button type="button" class="ab-vtab @(_view == code ? "actief" : "")" @onclick="() => _view = code">@naam</button>
        }
        <button class="ab-btn primair klein" type="button" @onclick="NieuweActiviteit">+ Activiteit</button>
        <div class="ab-filters">
            <select class="@(_fProb.Length > 0 ? "aan" : "")" value="@_fProb" aria-label="Filter onderwerp"
                    @onchange="e => _fProb = (string?)e.Value ?? string.Empty">
                <option value="">Onderwerp: alle</option>
                @for (var i = 0; i < _data.Problemen.Count; i++)
                {
                    <option value="@_data.Problemen[i].Id">@(i + 1). @_data.Problemen[i].Naam</option>
                }
                <option value="geen">Geen onderwerp</option>
            </select>
            <select class="@(_fWie.Length > 0 ? "aan" : "")" value="@_fWie" aria-label="Filter toegewezen aan"
                    @onchange="e => _fWie = (string?)e.Value ?? string.Empty">
                <option value="">Toegewezen aan: iedereen</option>
                @foreach (var m in FilterPersonen())
                {
                    <option value="@m.Id">@m.Naam</option>
                }
                <option value="niemand">Niemand</option>
            </select>
            <select class="@(_fType.Length > 0 ? "aan" : "")" value="@_fType" aria-label="Filter type"
                    @onchange="e => _fType = (string?)e.Value ?? string.Empty">
                <option value="">Type: alle</option>
                @foreach (var ty in _data.Types)
                {
                    <option value="@ty.Id">@ty.Naam</option>
                }
            </select>
            <input type="search" placeholder="Zoeken…" value="@_fQ" aria-label="Zoeken"
                   @oninput="e => _fQ = (string?)e.Value ?? string.Empty" />
            @if (FiltersActief)
            {
                <button class="ab-wis" type="button" @onclick="WisFilters">Filters wissen</button>
            }
        </div>
    </div>

    @* ---------- weergave ---------- *@
    @if (_view == "kanban")
    {
        var lijst = Gefilterd(idx);
        var lanes = _data.Problemen.Select(p => p.Id.ToString()).Append("geen").ToList();
        var vak = lanes.ToDictionary(l => l, l => ActStatus.Alle.ToDictionary(s => s.Code, s => new List<Activiteit>()));
        foreach (var a in lijst) vak[Lane(a, idx)][a.Status].Add(a);
        foreach (var l in lanes) foreach (var s in ActStatus.Alle) vak[l][s.Code].Sort(OpVolgorde);

        @if (_data.Activiteiten.Count == 0)
        {
            <div class="ab-melding"><b>Dit board is nog leeg.</b> Zet eerst de onderwerpen hierboven op volgorde van prioriteit.
                Maak daarna activiteiten aan met <b>+ Activiteit</b>, of beweeg met de muis over een vak en kies <b>+ Nieuwe activiteit</b>.</div>
        }
        <div id="ab-wrap">
            <div class="ab-bord">
                @foreach (var s in ActStatus.Alle)
                {
                    <div class="ab-kolkop"><span class="ab-spill ab-k-@s.Kleur"><i class="ab-dot-@s.Kleur"></i>@s.Naam</span>
                        <span class="ab-n">@lijst.Count(a => a.Status == s.Code)</span></div>
                }
                @foreach (var l in lanes)
                {
                    var dicht = _dicht.Contains(l);
                    var p = l == "geen" ? null : _data.Problemen.FirstOrDefault(x => x.Id.ToString() == l);
                    var n = ActStatus.Alle.Sum(s => vak[l][s.Code].Count);
                    <div class="ab-baankop @(dicht ? "dicht" : "")" data-lane="@l" @key="LaneSleutel(l)">
                        <span class="ab-bk" role="button" tabindex="0" aria-expanded="@(!dicht)"
                              @onclick="() => WisselBaan(l)" @onkeydown="e => Klap(e, () => WisselBaan(l))">
                            <span class="ab-caret">▼</span>
                            @if (p is not null)
                            {
                                <span class="ab-pnr">@(idx[p.Id] + 1)</span><span class="ab-chip ab-k-@p.Kleur">@p.Naam</span>
                            }
                            else
                            {
                                <span class="ab-geenp">Geen onderwerp</span>
                            }
                            <span class="ab-count">@n</span>
                        </span>
                    </div>
                    @if (!dicht)
                    {
                        foreach (var s in ActStatus.Alle)
                        {
                            var stc = s.Code;
                            <div class="ab-cel ab-st-@stc" data-status="@stc" data-lane="@l" @key="CelSleutel(l, stc)">
                                @foreach (var a in vak[l][stc])
                                {
                                    <div class="ab-kaart" tabindex="0" role="button" data-id="@a.Id" @key="a.Id"
                                         @onkeydown="e => KaartToets(e, a)">
                                        <div class="ab-ktitel">@a.Titel</div>
                                        @if (a.Personen.Count > 0)
                                        {
                                            <div class="ab-wie">@foreach (var pid in a.Personen) { @PersoonHtml(pid) }</div>
                                        }
                                        <div class="ab-kmeta">
                                            @foreach (var tid in a.Types) { @TypeChip(tid) }
                                            @if (a.Prioriteit is int pr) { <span class="ab-chip ab-k-@ActPrioriteit.Kleur(pr)">@ActPrioriteit.Naam(pr)</span> }
                                            @foreach (var pid in ProblemenGesorteerd(a, idx).Where(x => x.ToString() != l))
                                            {
                                                @ProbleemChip(pid, idx, true)
                                            }
                                        </div>
                                    </div>
                                }
                                @if (_snel is { } sn && sn.Status == stc && sn.Lane == l)
                                {
                                    <div class="ab-snel">
                                        <input class="ab-sn-titel @(sn.Fout ? "fout" : "")" id="ab-snel" placeholder="Titel nieuwe activiteit"
                                               aria-label="Titel" autocomplete="off" value="@sn.Titel"
                                               @oninput="e => sn.Titel = (string?)e.Value ?? string.Empty"
                                               @onkeydown="SnelToets" @onblur="SnelBlur" />
                                        <div class="ab-sn-voet"><span>Enter klaar · Esc annuleren</span>
                                            <button type="button" class="ab-sn-ok" @onmousedown:preventDefault @onclick="SnelOpslaan">Klaar</button></div>
                                    </div>
                                }
                                else
                                {
                                    <button class="ab-nieuw" type="button" @onclick="() => OpenSnel(stc, l)">+ Nieuwe activiteit</button>
                                }
                            </div>
                        }
                    }
                }
            </div>
        </div>
    }
    else
    {
        @TabelWeergave(idx)
    }
}
</div>

@* ---------- detailpaneel ---------- *@
@if (_open is { } o && _data is not null)
{
    var idx2 = ProbIndex();
    var dagen = o.DagenOpen;
    <div class="ab-scrim" @onclick="SluitPaneel"></div>
    <aside class="ab-drawer" aria-label="Activiteit" tabindex="-1" @onkeydown="PaneelToets">
        <div class="ab-dkop">
            <div class="ab-eyebrow">Activiteit · @_data.Board.Titel</div>
            <textarea class="ab-dtitel" id="ab-dtitel" rows="2" placeholder="Naam van de activiteit" @key="TitelSleutel"
                      @onchange="TitelGewijzigd">@o.Titel</textarea>
            <button class="ab-dsluit" type="button" aria-label="Sluiten" @onclick="SluitPaneel">×</button>
        </div>
        <div class="ab-dbody">
            <div class="ab-eig">
                <div class="ab-lab">Status</div>
                <div><select value="@o.Status" @onchange="StatusGewijzigd">
                    @foreach (var s in ActStatus.Alle) { <option value="@s.Code">@s.Naam</option> }
                </select></div>

                <div class="ab-lab">Prioriteit</div>
                <div class="ab-kiezer">
                    @foreach (var pr in ActPrioriteit.Alle)
                    {
                        var w = pr.Waarde;
                        <button type="button" class="ab-kies @(o.Prioriteit == w ? "aan ab-k-" + pr.Kleur : "")" aria-pressed="@(o.Prioriteit == w)"
                                @onclick="() => PrioKlik(w)">@pr.Naam</button>
                    }
                </div>

                <div class="ab-lab">Toegewezen aan</div>
                @* Toegewezen personen als chips met ×; toevoegen via een keuzelijst (de hele lijst werknemers was te lang) *@
                <div class="ab-kiezer">
                    @foreach (var mid in o.Personen.ToList())
                    {
                        var pid = mid;
                        var m = _persoonOpId.GetValueOrDefault(pid);
                        if (m is null) continue;
                        <span class="ab-kies aan ab-k-gray ab-persoon">
                            <span class="ab-av" style="background:@ActKleur.Avatar(m.Naam)">@ActKleur.Initialen(m.Naam)</span>@m.Naam@(m.InDienst ? "" : " (uit dienst)")
                            <button type="button" class="ab-x" title="@("Haal " + m.Naam + " eraf")" aria-label="@(m.Naam + " eraf halen")"
                                    @onclick="() => Wissel(KoppelPersonen, pid)">×</button>
                        </span>
                    }
                    <select class="ab-persoonkies" @key="PersoonKiesSleutel" @onchange="PersoonGekozen" aria-label="Persoon toevoegen">
                        <option value="">+ persoon toevoegen…</option>
                        @if (Ik.WerknemerId is int ik && !o.Personen.Contains(ik) && _persoonOpId.GetValueOrDefault(ik)?.Kiesbaar == true)
                        {
                            <option value="@ik">Ik (@_persoonOpId[ik].Naam)</option>
                        }
                        @foreach (var m in _personen.Where(x => x.Kiesbaar && !o.Personen.Contains(x.Id)))
                        {
                            <option value="@m.Id">@m.Naam</option>
                        }
                    </select>
                </div>

                <div class="ab-lab">Type</div>
                <div class="ab-kiezer">
                    @if (_data.Types.Count == 0)
                    {
                        <span class="ab-ro ab-muted">Nog geen types. Voeg ze toe in het paneel Types bovenin.</span>
                    }
                    @foreach (var ty in _data.Types)
                    {
                        var tid = ty.Id;
                        var aan = o.Types.Contains(tid);
                        <button type="button" class="ab-kies @(aan ? "aan ab-k-" + ty.Kleur : "")" aria-pressed="@aan" @onclick="() => Wissel(KoppelTypes, tid)">@ty.Naam</button>
                    }
                </div>

                <div class="ab-lab">Onderwerpen</div>
                <div>
                    <div class="ab-kiezer">
                        @if (_data.Problemen.Count == 0)
                        {
                            <span class="ab-ro ab-muted">Nog geen onderwerpen. Voeg ze toe in de lijst bovenin.</span>
                        }
                        @for (var i = 0; i < _data.Problemen.Count; i++)
                        {
                            var pr = _data.Problemen[i];
                            var pid = pr.Id;
                            var aan = o.Problemen.Contains(pid);
                            <button type="button" class="ab-kies @(aan ? "aan ab-k-" + pr.Kleur : "")" aria-pressed="@aan" @onclick="() => Wissel(KoppelProblemen, pid)">
                                <span class="ab-pnr">@(i + 1)</span>@pr.Naam
                            </button>
                        }
                    </div>
                    <p class="ab-hint">Een activiteit kan bij meerdere onderwerpen horen. De kaart staat in de baan van het onderwerp met de
                        hoogste prioriteit. De lijst beheer je bovenin.</p>
                </div>

                <div class="ab-lab">Vervaldatum</div>
                <div><input type="date" value="@(o.Vervaldatum?.ToString("yyyy-MM-dd") ?? "")" @onchange="VervalGewijzigd" /></div>

                <div class="ab-lab">Gemaakt op</div>
                <div class="ab-ro">@(o.Id == 0 ? "nog niet opgeslagen" : o.GemaaktOp.ToString("dd-MM-yyyy HH:mm"))</div>

                <div class="ab-lab">Dagen open</div>
                <div class="ab-ro">@(dagen?.ToString() ?? "–")@if (dagen is null) { <span class="ab-muted"> (sluitdatum onbekend)</span> }</div>
            </div>
            @foreach (var v in ActTekst.Velden)
            {
                var kolom = v.Kolom;
                <div class="ab-sectie">
                    <h3>@v.Naam</h3>
                    <textarea placeholder="@v.Hulp" @onchange="e => TekstGewijzigd(kolom, e)">@o.Tekst.GetValueOrDefault(kolom)</textarea>
                </div>
            }
        </div>
        <div class="ab-dvoet">
            <button class="ab-btn klein gevaar" type="button" @onclick="VerwijderOpen">Verwijderen</button>
            <span style="flex:1"></span>
            <button class="ab-btn klein primair" type="button" @onclick="SluitPaneel">Sluiten</button>
        </div>
    </aside>
}

