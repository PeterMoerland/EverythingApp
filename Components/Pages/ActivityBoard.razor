@page "/activityboard"
@page "/activityboard/{BoardId:int}"
@using EverythingApp.Models
@implements IAsyncDisposable
@inject IActivityBoardRepository Repo
@inject IProjectRepository Projecten
@inject IRelatieRepository Relaties
@inject IUrenRepository Uren
@inject IWerknemerRepository Bestanden
@inject FilestoreService Store
@inject ActivityBoardLive Live
@inject IMeldingRepository Meldingen
@inject MeldingSignaal Signaal
@inject HuidigeGebruiker Ik
@inject IJSRuntime JS
@inject NavigationManager Nav

@* Activity board (spec "Design specificatie MDE Activity Board", Freek Moerland, prototype v0.5).
   Onderwerpen op volgorde van prioriteit; het kanbanbord heeft een baan per onderwerp in die volgorde.
   Een kaart staat één keer op het bord: in de baan van het gekoppelde onderwerp met de hoogste prioriteit.
   Elke wijziging gaat direct naar de database; collega's op hetzelfde board zien hem meteen (ActivityBoardLive).
   Slepen: wwwroot/activityboard.js. Fase 1: nog geen snel-editor met alle velden en geen ongedaan maken
   van alles (wel van verwijderen). *@

<PageTitle>@(_data is null ? "Activity board" : "Activity board · " + _data.Board.Titel)</PageTitle>

@* ab-werk: het board over de hele breedte (geen maximale paginabreedte); de eigenschappen van een activiteit staan in een
   pop-up (.ab-drawer) die opent bij dubbelklik, Enter of via het rechtermuismenu (besluit gebruiker 19-11-2026) *@
<div class="ab-werk">
<div class="page ab">
@if (!Repo.Beschikbaar)
{
    <div class="topbar"><h1>Activity board</h1></div>
    <div class="melding">Geen database-verbinding (demo-modus).</div>
}
else if (_tabellen == false)
{
    <div class="topbar"><h1>Activity board</h1></div>
    <div class="melding fout">De tabellen ontbreken nog: voer <code>ActivityBoard_MariaDB.sql</code> uit op de MDE-database.</div>
}
else if (BoardId is null)
{
    @* ---------- startscherm: alle boards, en een board openen voor een project of klant, of een vrij board maken ---------- *@
    <div class="topbar"><h1>Activity board</h1></div>
    <p class="uitleg">Een board per project, per werkorder of per klant, of een vrij board met alleen een naam: onderwerpen op volgorde van
        prioriteit en activiteiten op een kanbanbord.</p>
    <section class="ab-paneel">
        <div class="ab-pkop-vast">
            <span class="ab-titel">Boards</span><span class="ab-count">@BoardsGefilterd.Count()</span>
            <span class="ab-soortfilter">
                <button type="button" class="ab-vtab @(_boom ? "actief" : "")" @onclick="() => ZetBoom(true)" title="Klant ▸ project ▸ werkorder">Boom</button>
                <button type="button" class="ab-vtab @(_boom ? "" : "actief")" @onclick="() => ZetBoom(false)">Lijst</button>
            </span>
            @if (_soorten)
            {
                <span class="ab-soortfilter">
                    @foreach (var (sc, sn) in SoortFilters)
                    {
                        <button type="button" class="ab-vtab @(_boardSoort == sc ? "actief" : "")" @onclick="() => _boardSoort = sc">@sn</button>
                    }
                </span>
            }
        </div>
        @if (_boards is null)
        {
            <p class="ab-leeg">Laden…</p>
        }
        else if (_boards.Count == 0)
        {
            <p class="ab-leeg">Nog geen boards. Kies hieronder een project@(_soorten ? (_metWerkorder ? ", werkorder" : "") + " of klant, of maak een vrij board" : "") om te beginnen.</p>
        }
        else if (_boom)
        {
            @* boom (wens gebruiker 24-10-2026): Klant ▸ Project ▸ Werkorder ▸ subwerkorder; vrije boards en boards zonder klant apart *@
            <div class="ab-boomkop">
                <input class="ab-boomzoek" placeholder="Zoek klant, project, werkorder of board…" value="@_boomZoek" autocomplete="off"
                       @oninput="e => _boomZoek = (string?)e.Value ?? string.Empty" />
                <button type="button" class="ab-btn klein" @onclick="AllesUit">Alles uitklappen</button>
                <button type="button" class="ab-btn klein" @onclick="() => _boomOpen.Clear()">Alles inklappen</button>
            </div>
            var wortels = Boom();
            @if (wortels.Count == 0)
            {
                <p class="ab-leeg">Niets gevonden.</p>
            }
            <ul class="ab-boom">
                @foreach (var k in wortels) { @Knoop(k, 0) }
            </ul>
        }
        else
        {
            <table class="ab-tabel ab-boards">
                <thead><tr><th>Soort</th><th>Nummer</th><th>Board</th><th>Open</th><th>Klaar</th><th>Laatst gewijzigd</th></tr></thead>
                <tbody>
                @foreach (var b in BoardsGefilterd)
                {
                    <tr class="ab-rij" tabindex="0" @key="b.BoardId" @onclick="() => NaarBoard(b.BoardId)"
                        @onkeydown="e => BoardToets(e, b.BoardId)">
                        <td><span class="ab-soort ab-soort-@b.Soort">@ActBoardSoort.Naam(b.Soort)</span></td>
                        <td class="ab-num">@(b.Soort == ActBoardSoort.Werkorder ? b.WerkorderNummer : b.ProjectNummer?.ToString())</td>
                        <td class="ab-t">@b.Titel@if (b.Naam.Length > 0 && b.Soort != ActBoardSoort.Vrij) { <small class="ab-muted"> · @(b.Soort == ActBoardSoort.Klant ? b.RelatieNaam : b.Soort == ActBoardSoort.Werkorder ? b.WerkorderNummer : b.ProjectNaam)</small> }</td>
                        <td class="ab-num">@b.Open</td>
                        <td class="ab-num">@b.Klaar</td>
                        <td class="ab-num">@(b.Gewijzigd?.ToString("dd-MM-yyyy HH:mm") ?? "")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>
    <section class="ab-paneel ab-sub">
        <div class="ab-pkop-vast"><span class="ab-titel">Board openen of maken</span></div>
        @ZoekVak(koppelen: false)
        @if (!_soorten)
        {
            <p class="ab-hint ab-hint-los">Boards voor een klant of vrije boards: voer eerst <code>ActivityBoard_Soorten_MariaDB.sql</code> uit.</p>
        }
    </section>
}
else if (_data is null)
{
    <div class="topbar"><h1>Activity board</h1></div>
    <p class="ab-leeg">@(_laadFout ?? "Laden…")</p>
}
else
{
    var idx = ProbIndex();
    var tel = TelPerProbleem();

    @* ---------- kop ---------- *@
    <div class="ab-kop">
        <div>
            <div class="ab-eyebrow">Activity board · @ActBoardSoort.Naam(_data.Board.Soort)@if (_data.Board.Naam.Length > 0 && _data.Board.Soort != ActBoardSoort.Vrij) { <span class="ab-muted"> · @_data.Board.StandaardTitel</span> }</div>
            <h1>@if (_data.Board.ProjectNummer is int nr && _data.Board.Naam.Length == 0) { <span class="ab-mono ab-nr">@nr</span> }<input class="ab-bordnaam" @key="BordNaamSleutel" value="@(_data.Board.Naam.Length > 0 ? _data.Board.Naam : _data.Board.ProjectNummer is null ? _data.Board.StandaardTitel : _data.Board.ProjectNaam)"
                       placeholder="@_data.Board.StandaardTitel" aria-label="Naam van het board" autocomplete="off" spellcheck="false"
                       title="Naam van het board; leeg = de naam van het project of de klant" @onchange="HernoemBoard" @onkeydown="InvoerEnterBlur" /></h1>
        </div>
        <div class="ab-acties">
            <a class="ab-link" href="activityboard">Alle boards</a>
            @if (_soorten)
            {
                <button class="ab-btn" type="button" @onclick="OpenKoppel" title="Dit board aan een project, werkorder of klant hangen, of losmaken">Koppelen…</button>
            }
            <button class="ab-btn" type="button" @onclick="NaarExcel" title="Activiteiten van dit board naar Excel (csv)">Naar Excel</button>
            @* wissen: alleen Directie (wens gebruiker 24-10-2026); de knop staat er altijd, uit voor de rest *@
            <button class="ab-btn gevaar" type="button" disabled="@(!MagWissen)" @onclick="WisBoard"
                    title="@(MagWissen ? "Dit board met alle onderwerpen, types en activiteiten wissen" : "Een board wissen kan alleen wie het heeft aangemaakt, of Directie")">Board wissen…</button>
        </div>
    </div>

    @* ---------- problemen ---------- *@
    <section class="ab-paneel">
        <div class="ab-pkop @(_probDicht ? "dicht" : "")" role="button" tabindex="0" aria-expanded="@(!_probDicht)"
             @onclick="() => _probDicht = !_probDicht" @onkeydown="e => Klap(e, () => _probDicht = !_probDicht)">
            <span class="ab-caret">▼</span><span class="ab-titel">Onderwerpen</span>
            <span class="ab-count">@_data.Problemen.Count · volgorde = prioriteit</span>
            <span class="ab-hint">Sleep aan ⠿ om de prioriteit te wijzigen</span>
        </div>
        @if (!_probDicht)
        {
            <ol id="ab-problijst">
                @if (_data.Problemen.Count == 0)
                {
                    <li class="ab-leeg">Nog geen onderwerpen. Voeg hieronder het eerste onderwerp toe.</li>
                }
                @for (var i = 0; i < _data.Problemen.Count; i++)
                {
                    var p = _data.Problemen[i];
                    var t = tel.GetValueOrDefault(p.Id);
                    <li class="ab-prob" data-id="@p.Id" @key="p.Id">
                        <button class="ab-greep" type="button" title="Sleep om de prioriteit te wijzigen (of gebruik pijltjestoetsen)"
                                aria-label="@("Prioriteit van " + p.Naam + " wijzigen")">⠿</button>
                        <span class="ab-pnr">@(i + 1)</span>
                        <span class="ab-pnaam">
                            <span class="ab-pdot ab-dot-@p.Kleur"></span>
                            <input @key="NaamSleutel(p.Id)" value="@p.Naam" aria-label="@("Naam onderwerp " + (i + 1))"
                                   @onchange="e => HernoemProbleem(p, e)" @onkeydown="InvoerEnterBlur" />
                        </span>
                        @{ var nb = _bijlagen.GetValueOrDefault(p.Id)?.Count ?? 0; }
                        <button class="ab-pbijl @(nb > 0 ? "heeft" : "") @(_bijlagenOpen == p.Id ? "open" : "")" type="button"
                                title="@(nb > 0 ? $"{nb} bijlage(n): plaatjes en bestanden" : "Plaatje of bestand toevoegen")"
                                @onclick="() => WisselBijlagen(p.Id)">📎@(nb > 0 ? nb.ToString() : "")</button>
                        <span class="ab-ptel"><b>@t.Open</b> open · @t.Klaar klaar</span>
                        <button class="ab-pdel" type="button" title="Onderwerp verwijderen" aria-label="@(p.Naam + " verwijderen")"
                                @onclick="() => VerwijderProbleem(p)">×</button>
                    </li>
                    @if (_bijlagenOpen == p.Id)
                    {
                        @* geen ab-prob: het slepen (activityboard.js) slaat deze regel over *@
                        <li class="ab-prob-bijlagen" @key='("bijl", p.Id)' @ref="_bijlagenVak" tabindex="-1">
                            <div class="ab-bijl-lijst">
                                @foreach (var bst in _bijlagen.GetValueOrDefault(p.Id) ?? new())
                                {
                                    <span class="ab-bijl" @key="bst.FileStoreId">
                                        @if (IsPlaatje(bst.Bestandsnaam))
                                        {
                                            <a href="@($"bestand/{bst.FileStoreId}")" target="_blank" rel="noopener" title="@bst.Bestandsnaam">
                                                <img src="@($"bestand/{bst.FileStoreId}")" alt="@bst.Bestandsnaam" loading="lazy" /></a>
                                        }
                                        else
                                        {
                                            <a class="ab-bijl-bestand" href="@($"bestand/{bst.FileStoreId}")" target="_blank" rel="noopener">📄 @bst.Bestandsnaam</a>
                                        }
                                        <button class="ab-bijl-weg" type="button" title="Bijlage verwijderen" @onclick="() => WisBijlage(p, bst)">×</button>
                                    </span>
                                }
                            </div>
                            <div class="ab-bijl-toevoegen">
                                <span>📷 Plaatje: <b>Win+Shift+S</b>, dan <b>Ctrl+V</b> hier, of</span>
                                <label class="ab-btn klein">bestand kiezen…<InputFile OnChange="e => BijlagenGekozen(p, e)" multiple style="display:none" /></label>
                                @if (_bijlBezig) { <span class="ab-muted">opslaan…</span> }
                            </div>
                        </li>
                    }
                }
            </ol>
            <div class="ab-padd">
                <input id="ab-probnieuw" placeholder="Nieuw onderwerp toevoegen…" aria-label="Nieuw onderwerp" autocomplete="off"
                       value="@_nieuwProbleem" @oninput="e => _nieuwProbleem = (string?)e.Value ?? string.Empty"
                       @onkeydown="ProbNieuwToets" />
                <button class="ab-btn klein" type="button" @onclick="VoegProbleemToe">Toevoegen</button>
            </div>
        }
    </section>

    @* ---------- types ---------- *@
    <section class="ab-paneel ab-sub">
        <div class="ab-pkop @(_typeDicht ? "dicht" : "")" role="button" tabindex="0" aria-expanded="@(!_typeDicht)"
             @onclick="() => _typeDicht = !_typeDicht" @onkeydown="e => Klap(e, () => _typeDicht = !_typeDicht)">
            <span class="ab-caret">▼</span><span class="ab-titel">Types</span>
            <span class="ab-count">@_data.Types.Count</span>
            <span class="ab-hint">Om activiteiten in te delen; vrij te kiezen</span>
        </div>
        @if (!_typeDicht)
        {
            <div class="ab-typelijst">
                @if (_data.Types.Count == 0) { <span class="ab-leeg">Nog geen types.</span> }
                @foreach (var ty in _data.Types)
                {
                    <span class="ab-chip ab-tchip ab-k-@ty.Kleur" @key="ty.Id">
                        @if (_typeHernoem == ty.Id)
                        {
                            <input class="ab-tin" value="@ty.Naam" aria-label="Naam type" id="@("ab-type-" + ty.Id)"
                                   @onchange="e => HernoemType(ty, e)" @onkeydown="e => TypeHernoemToets(e)"
                                   @onblur="() => _typeHernoem = null" />
                        }
                        else
                        {
                            <button type="button" class="ab-tnaam" title="Klik om te hernoemen" @onclick="() => StartTypeHernoem(ty)">@ty.Naam</button>
                        }
                        <span class="ab-tn">@_data.Activiteiten.Count(a => a.Types.Contains(ty.Id))</span>
                        <button type="button" class="ab-x" title="Type verwijderen" aria-label="@("Type " + ty.Naam + " verwijderen")"
                                @onclick="() => VerwijderType(ty)">×</button>
                    </span>
                }
            </div>
            <div class="ab-padd ab-vrij">
                <input id="ab-typenieuw" placeholder="Nieuw type toevoegen…" aria-label="Nieuw type" autocomplete="off"
                       value="@_nieuwType" @oninput="e => _nieuwType = (string?)e.Value ?? string.Empty" @onkeydown="TypeNieuwToets" />
                <button class="ab-btn klein" type="button" @onclick="VoegTypeToe">Toevoegen</button>
            </div>
        }
    </section>

    @* ---------- weergavebalk ---------- *@
    <div class="ab-viewbar">
        @foreach (var (code, naam) in Weergaven)
        {
            <button type="button" class="ab-vtab @(_view == code ? "actief" : "")" @onclick="() => _view = code">@naam</button>
        }
        <button class="ab-btn primair klein" type="button" @onclick="NieuweActiviteit">+ Activiteit</button>
        <div class="ab-filters">
            <select class="@(_fProb.Length > 0 ? "aan" : "")" value="@_fProb" aria-label="Filter onderwerp"
                    @onchange="e => _fProb = (string?)e.Value ?? string.Empty">
                <option value="">Onderwerp: alle</option>
                @for (var i = 0; i < _data.Problemen.Count; i++)
                {
                    <option value="@_data.Problemen[i].Id">@(i + 1). @_data.Problemen[i].Naam</option>
                }
                <option value="geen">Geen onderwerp</option>
            </select>
            <select class="@(_fWie.Length > 0 ? "aan" : "")" value="@_fWie" aria-label="Filter toegewezen aan"
                    @onchange="e => _fWie = (string?)e.Value ?? string.Empty">
                <option value="">Toegewezen aan: iedereen</option>
                @if (IkKiesbaar is int ikf)
                {
                    <option value="@ikf">Ik (@_persoonOpId[ikf].Naam)</option>
                }
                @foreach (var m in FilterPersonen().Where(x => x.Id != IkKiesbaar))
                {
                    <option value="@m.Id">@m.Naam</option>
                }
                <option value="niemand">Niemand</option>
            </select>
            <button type="button" class="ab-vtab ab-markeer @(_markeer ? "actief" : "")" aria-pressed="@_markeer" @onclick="WisselMarkeer"
                    title="Niet filteren maar markeren: de kaarten van de gekozen persoon lichten op, de andere blijven zichtbaar">Markeren</button>
            <select class="@(_fType.Length > 0 ? "aan" : "")" value="@_fType" aria-label="Filter type"
                    @onchange="e => _fType = (string?)e.Value ?? string.Empty">
                <option value="">Type: alle</option>
                @foreach (var ty in _data.Types)
                {
                    <option value="@ty.Id">@ty.Naam</option>
                }
            </select>
            <input type="search" placeholder="Zoeken…" value="@_fQ" aria-label="Zoeken"
                   @oninput="e => _fQ = (string?)e.Value ?? string.Empty" />
            @if (FiltersActief)
            {
                <button class="ab-wis" type="button" @onclick="WisFilters">Filters wissen</button>
            }
        </div>
    </div>

    @* ---------- weergave ---------- *@
    @if (_view == "kanban")
    {
        var lijst = Gefilterd(idx);
        var lanes = _data.Problemen.Select(p => p.Id.ToString()).Append("geen").ToList();
        var vak = lanes.ToDictionary(l => l, l => ActStatus.Alle.ToDictionary(s => s.Code, s => new List<Activiteit>()));
        foreach (var a in lijst) vak[Lane(a, idx)][a.Status].Add(a);
        foreach (var l in lanes) foreach (var s in ActStatus.Alle) vak[l][s.Code].Sort(OpVolgorde);

        @if (_data.Activiteiten.Count == 0)
        {
            <div class="ab-melding"><b>Dit board is nog leeg.</b> Zet eerst de onderwerpen hierboven op volgorde van prioriteit.
                Maak daarna activiteiten aan met <b>+ Activiteit</b>, of beweeg met de muis over een vak en kies <b>+ Nieuwe activiteit</b>.</div>
        }
        <div id="ab-wrap">
            <div class="ab-bord">
                @foreach (var s in ActStatus.Alle)
                {
                    var kolUren = lijst.Where(a => a.Status == s.Code).Sum(a => a.BenodigdeUren ?? 0m);
                    <div class="ab-kolkop"><span class="ab-spill ab-k-@s.Kleur"><i class="ab-dot-@s.Kleur"></i>@s.Naam</span>
                        <span class="ab-n">@lijst.Count(a => a.Status == s.Code)</span>
                        @if (kolUren > 0) { <span class="ab-n ab-som" title="Benodigde tijd van de activiteiten in deze kolom">⏱ @ActTijd.Tekst(kolUren)</span> }</div>
                }
                @foreach (var l in lanes)
                {
                    var dicht = _dicht.Contains(l);
                    var p = l == "geen" ? null : _data.Problemen.FirstOrDefault(x => x.Id.ToString() == l);
                    var n = ActStatus.Alle.Sum(s => vak[l][s.Code].Count);
                    var baanUren = ActStatus.Alle.Where(s => s.Groep != ActStatus.GroepKlaar).Sum(s => vak[l][s.Code].Sum(a => a.BenodigdeUren ?? 0m));
                    <div class="ab-baankop @(dicht ? "dicht" : "")" data-lane="@l" @key="LaneSleutel(l)">
                        <span class="ab-bk" role="button" tabindex="0" aria-expanded="@(!dicht)"
                              @onclick="() => WisselBaan(l)" @onkeydown="e => Klap(e, () => WisselBaan(l))">
                            <span class="ab-caret">▼</span>
                            @if (p is not null)
                            {
                                <span class="ab-pnr">@(idx[p.Id] + 1)</span><span class="ab-chip ab-k-@p.Kleur">@p.Naam</span>
                            }
                            else
                            {
                                <span class="ab-geenp">Geen onderwerp</span>
                            }
                            <span class="ab-count">@n</span>
                            @if (baanUren > 0) { <span class="ab-count ab-som" title="Benodigde tijd van de activiteiten die nog niet klaar zijn">⏱ @ActTijd.Tekst(baanUren) open</span> }
                        </span>
                    </div>
                    @if (!dicht)
                    {
                        foreach (var s in ActStatus.Alle)
                        {
                            var stc = s.Code;
                            <div class="ab-cel ab-st-@stc" data-status="@stc" data-lane="@l" @key="CelSleutel(l, stc)">
                                @foreach (var a in vak[l][stc])
                                {
                                    <div class="ab-kaart @KaartKlasse(a)" tabindex="0" role="button" data-id="@a.Id" @key="a.Id" title="@OpenTip"
                                         @onkeydown="e => KaartToets(e, a)" @oncontextmenu="e => OpenMenu(e, a)" @oncontextmenu:preventDefault>
                                        <div class="ab-ktitel">
                                            @* knopje om de eigenschappen te openen (wens gebruiker 19-11-2026), naast dubbelklik en Enter; niet in de tabvolgorde, Enter op de kaart doet hetzelfde *@
                                            <button type="button" class="ab-kopen" tabindex="-1" title="Eigenschappen openen" aria-label="Eigenschappen openen"
                                                    @onclick="() => OpenPaneel(a)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z" /></svg></button>@a.Titel</div>
                                        @if (a.Personen.Count > 0)
                                        {
                                            <div class="ab-wie">@foreach (var pid in a.Personen) { @PersoonHtml(pid) }</div>
                                        }
                                        @* de chips, met als laatste het kaartnummer rechtsonder (wens gebruiker 19-11-2026). Het nummer is het id
                                           van de activiteit: dat is ook het nummer waarmee de API een kaart aanwijst. Het staat ín de rij
                                           chips: past het niet meer op de laatste regel, dan komt het eronder, zonder de chips smaller te maken. *@
                                        <div class="ab-kmeta">
                                            @if (a.BenodigdeUren is decimal bu) { <span class="ab-chip ab-tijd" title="Benodigde tijd">⏱ @ActTijd.Tekst(bu)</span> }
                                            @if (a.Geblokkeerd) { <span class="ab-chip ab-wacht" title="@WachtTip(a)">⛔ wacht</span> }
                                            @if (a.PuntenTotaal > 0) { <span class="ab-chip ab-vink @(a.PuntenKlaar == a.PuntenTotaal ? "af" : "")" title="Afvinklijst: @a.PuntenKlaar van de @a.PuntenTotaal punten afgevinkt">☑ @a.PuntenKlaar/@a.PuntenTotaal</span> }
                                            @foreach (var tid in a.Types) { @TypeChip(tid) }
                                            @if (a.Prioriteit is int pr) { <span class="ab-chip ab-k-@ActPrioriteit.Kleur(pr)">@ActPrioriteit.Naam(pr)</span> }
                                            @foreach (var pid in ProblemenGesorteerd(a, idx).Where(x => x.ToString() != l))
                                            {
                                                @ProbleemChip(pid, idx, true)
                                            }
                                            <span class="ab-knr" title="Kaartnummer">#@a.Id</span>
                                        </div>
                                    </div>
                                }
                                @if (_snel is { } sn && sn.Status == stc && sn.Lane == l)
                                {
                                    <div class="ab-snel">
                                        <input class="ab-sn-titel @(sn.Fout ? "fout" : "")" id="ab-snel" placeholder="Titel nieuwe activiteit"
                                               aria-label="Titel" autocomplete="off" value="@sn.Titel"
                                               @oninput="e => sn.Titel = (string?)e.Value ?? string.Empty"
                                               @onkeydown="SnelToets" @onblur="SnelBlur" />
                                        <div class="ab-sn-voet"><span>Enter klaar · Esc annuleren</span>
                                            <button type="button" class="ab-sn-ok" @onmousedown:preventDefault @onclick="() => SnelOpslaan(open: true)">Klaar</button></div>
                                    </div>
                                }
                                else
                                {
                                    <button class="ab-nieuw" type="button" @onclick="() => OpenSnel(stc, l)">+ Nieuwe activiteit</button>
                                }
                            </div>
                        }
                    }
                }
            </div>
        </div>
    }
    else
    {
        @TabelWeergave(idx)
    }
}
</div>

@* ---------- detailpaneel ---------- *@
@if (_open is { } o && _data is not null)
{
    var idx2 = ProbIndex();
    var dagen = o.DagenOpen;
    <div class="ab-scrim" @onclick="SluitPaneel"></div>
    <aside class="ab-drawer" aria-label="Activiteit" tabindex="-1" @onkeydown="PaneelToets">
        <div class="ab-dkop">
            <div class="ab-eyebrow">Activiteit@(o.Id != 0 ? " #" + o.Id : "") · @_data.Board.Titel</div>
            <textarea class="ab-dtitel" id="ab-dtitel" rows="2" placeholder="Naam van de activiteit" @key="TitelSleutel"
                      @onchange="TitelGewijzigd">@o.Titel</textarea>
            <button class="ab-dsluit" type="button" aria-label="Sluiten" @onclick="SluitPaneel">×</button>
        </div>
        @* de sleutel telt op bij een andere activiteit: de velden worden dan opnieuw gemaakt (geen resten van de vorige) *@
        <div class="ab-dbody" @key="_paneelVersie">
            <div class="ab-eig">
                <div class="ab-lab">Status</div>
                <div><select value="@o.Status" @onchange="StatusGewijzigd">
                    @foreach (var s in ActStatus.Alle) { <option value="@s.Code">@s.Naam</option> }
                </select></div>

                <div class="ab-lab">Prioriteit</div>
                <div class="ab-kiezer">
                    @foreach (var pr in ActPrioriteit.Alle)
                    {
                        var w = pr.Waarde;
                        <button type="button" class="ab-kies @(o.Prioriteit == w ? "aan ab-k-" + pr.Kleur : "")" aria-pressed="@(o.Prioriteit == w)"
                                @onclick="() => PrioKlik(w)">@pr.Naam</button>
                    }
                </div>

                <div class="ab-lab">Toegewezen aan</div>
                @* Toegewezen personen als chips met ×; toevoegen via een keuzelijst (de hele lijst werknemers was te lang) *@
                <div class="ab-kiezer">
                    @foreach (var mid in o.Personen.ToList())
                    {
                        var pid = mid;
                        var m = _persoonOpId.GetValueOrDefault(pid);
                        if (m is null) continue;
                        <span class="ab-kies aan ab-k-gray ab-persoon">
                            <span class="ab-av" style="background:@ActKleur.Avatar(m.Naam)">@ActKleur.Initialen(m.Naam)</span>@m.Naam@(m.InDienst ? "" : " (uit dienst)")
                            <button type="button" class="ab-x" title="@("Haal " + m.Naam + " eraf")" aria-label="@(m.Naam + " eraf halen")"
                                    @onclick="() => Wissel(KoppelPersonen, pid)">×</button>
                        </span>
                    }
                    <select class="ab-persoonkies" @key="PersoonKiesSleutel" @onchange="PersoonGekozen" aria-label="Persoon toevoegen">
                        <option value="">+ persoon toevoegen…</option>
                        @if (Ik.WerknemerId is int ik && !o.Personen.Contains(ik) && _persoonOpId.GetValueOrDefault(ik)?.Kiesbaar == true)
                        {
                            <option value="@ik">Ik (@_persoonOpId[ik].Naam)</option>
                        }
                        @foreach (var m in _personen.Where(x => x.Kiesbaar && !o.Personen.Contains(x.Id)))
                        {
                            <option value="@m.Id">@m.Naam</option>
                        }
                    </select>
                </div>

                @* initiator (punt van Gerard, 19-11-2026): wie de activiteit aanmaakte; daar kan de uitvoerder met vragen terecht *@
                <div class="ab-lab" title="Wie deze activiteit aanmaakte; bij hem of haar kun je terecht met vragen">Initiator</div>
                <div class="ab-ro">
                    @if (o.GemaaktDoor is int init && _persoonOpId.ContainsKey(init))
                    {
                        <span class="ab-wie ab-wie-tabel">@PersoonHtml(init)</span>
                    }
                    else
                    {
                        <span class="ab-muted">onbekend</span>
                    }
                </div>

                @* Type en Onderwerpen zoals Toegewezen aan (punt van Gerard, 19-11-2026: alle keuzes als knoppen gaf "veel
                   onnodige info"): alleen wat gekozen is als chip met ×, de rest in een keuzelijst. De uitleg staat in het wolkje. *@
                <div class="ab-lab" title="Types maak en beheer je in het paneel Types boven het bord">Type</div>
                <div class="ab-kiezer">
                    @foreach (var ty in _data.Types.Where(t => o.Types.Contains(t.Id)))
                    {
                        var tid = ty.Id;
                        <span class="ab-kies aan ab-k-@ty.Kleur ab-persoon">@ty.Naam
                            <button type="button" class="ab-x" title="@("Type " + ty.Naam + " eraf halen")" aria-label="@("Type " + ty.Naam + " eraf halen")"
                                    @onclick="() => Wissel(KoppelTypes, tid)">×</button>
                        </span>
                    }
                    @if (_data.Types.Count == 0)
                    {
                        <span class="ab-ro ab-muted">nog geen types</span>
                    }
                    else if (_data.Types.Any(t => !o.Types.Contains(t.Id)))
                    {
                        <select class="ab-persoonkies" @key="@("tk" + PersoonKiesSleutel)" @onchange="e => KoppelGekozen(KoppelTypes, e)" aria-label="Type toevoegen">
                            <option value="">+ type toevoegen…</option>
                            @foreach (var ty in _data.Types.Where(t => !o.Types.Contains(t.Id)))
                            {
                                <option value="@ty.Id">@ty.Naam</option>
                            }
                        </select>
                    }
                </div>

                <div class="ab-lab" title="Een activiteit kan bij meerdere onderwerpen horen. De kaart staat in de baan van het onderwerp met de hoogste prioriteit. De lijst beheer je boven het bord.">Onderwerpen</div>
                <div class="ab-kiezer">
                    @for (var i = 0; i < _data.Problemen.Count; i++)
                    {
                        var pr = _data.Problemen[i];
                        if (!o.Problemen.Contains(pr.Id)) continue;
                        var pid = pr.Id;
                        <span class="ab-kies aan ab-k-@pr.Kleur ab-persoon"><span class="ab-pnr">@(i + 1)</span>@pr.Naam
                            <button type="button" class="ab-x" title="@("Onderwerp " + pr.Naam + " eraf halen")" aria-label="@("Onderwerp " + pr.Naam + " eraf halen")"
                                    @onclick="() => Wissel(KoppelProblemen, pid)">×</button>
                        </span>
                    }
                    @if (_data.Problemen.Count == 0)
                    {
                        <span class="ab-ro ab-muted">nog geen onderwerpen</span>
                    }
                    else if (_data.Problemen.Any(p => !o.Problemen.Contains(p.Id)))
                    {
                        <select class="ab-persoonkies" @key="@("ok" + PersoonKiesSleutel)" @onchange="e => KoppelGekozen(KoppelProblemen, e)" aria-label="Onderwerp toevoegen">
                            <option value="">+ onderwerp toevoegen…</option>
                            @for (var i = 0; i < _data.Problemen.Count; i++)
                            {
                                var pr = _data.Problemen[i];
                                if (o.Problemen.Contains(pr.Id)) continue;
                                <option value="@pr.Id">@(i + 1). @pr.Naam</option>
                            }
                        </select>
                    }
                </div>

                <div class="ab-lab">Vervaldatum</div>
                <div><input type="date" value="@(o.Vervaldatum?.ToString("yyyy-MM-dd") ?? "")" @onchange="VervalGewijzigd" /></div>

                <div class="ab-lab">Benodigde tijd</div>
                @if (_metTijd)
                {
                    <div>
                        <span class="ab-tijdinvoer"><input type="text" inputmode="decimal" autocomplete="off" @key="TijdSleutel" id="ab-dtijd"
                                   value="@ActTijd.Invoer(o.BenodigdeUren)" placeholder="–" aria-label="Benodigde tijd in uren"
                                   @onchange="TijdGewijzigd" /> uur</span>
                        @* de uitleg achter een vraagteken in plaats van als tekst eronder (wens gebruiker 20-11-2026: minder tekst in beeld) *@
                        @Uitleg($"Hoeveel werk deze activiteit is. Typ uren (1,5), of 1:30, 45m, 2d (een dag = {ActTijd.UrenPerDag:0.##} uur).")
                    </div>
                }
                else
                {
                    <div class="ab-ro ab-muted">Kan na het uitvoeren van <code>ActivityBoard_Tijd_MariaDB.sql</code>.</div>
                }

                @* het kaartnummer, ook in de pop-up (punt van Gerard 20-11-2026), met wat je ermee doet *@
                @if (o.Id != 0)
                {
                    <div class="ab-lab">Kaartnummer</div>
                    <div class="ab-ro">
                        <b>#@o.Id</b>
                        @Uitleg($"Het vaste nummer van dit kaartje; het staat ook rechtsonder op het kaartje. Gebruik het om het aan te wijzen, bijvoorbeeld tegen een collega of tegen Claude (\"zet kaart {o.Id} op testen\").")
                    </div>
                }

                <div class="ab-lab">Gemaakt op</div>
                <div class="ab-ro">@(o.Id == 0 ? "nog niet opgeslagen" : o.GemaaktOp.ToString("dd-MM-yyyy HH:mm"))</div>

                @if (_metKoppelingen && o.Id != 0)
                {
                    @* koppelingen met andere kaartjes (vraag Gerard 20-11-2026), ook op een ander board *@
                    <div class="ab-lab">Koppelingen</div>
                    <div class="ab-ro ab-koppelingen">
                        @foreach (var k in o.Koppelingen)
                        {
                            var kop = k;
                            <div class="ab-koppeling @(kop.Blokkeert ? "wacht" : "")" @key="kop.Id">
                                <span class="ab-ksoort">@(kop.Blokkeert ? "⛔ " : "")@kop.Naam</span>
                                <a href="@($"activityboard/{kop.AnderBoardId}?kaart={kop.AnderId}")" title="Deze kaart openen@(kop.AnderBoardId != _data.Board.Id ? " (op het board " + kop.AnderBoard + ")" : "")">#@kop.AnderId @kop.AnderTitel</a>
                                <span class="ab-chip ab-k-@ActStatus.Van(kop.AnderStatus).Kleur">@ActStatus.Naam(kop.AnderStatus)</span>
                                @if (kop.AnderBoardId != _data.Board.Id) { <span class="ab-kboard">@kop.AnderBoard</span> }
                                <button type="button" class="ab-pweg" title="Deze koppeling verwijderen" @onclick="() => Ontkoppel(kop)">×</button>
                            </div>
                        }
                        @if (_koppelNieuw)
                        {
                            <div class="ab-koppelnieuw">
                                <select @bind="_koppelKeuze" aria-label="Soort koppeling">
                                    @for (var i = 0; i < ActKoppelSoort.Keuzes.Length; i++) { <option value="@i">@ActKoppelSoort.Keuzes[i].Naam</option> }
                                </select>
                                <input id="ab-koppelzoek" placeholder="nummer of titel van de andere kaart" autocomplete="off" value="@_koppelZoek"
                                       @oninput="KaartKoppelZoek" @onkeydown="KaartKoppelToets" aria-label="Kaart zoeken" />
                                @foreach (var t in _koppelTreffers)
                                {
                                    var doel = t;
                                    <button type="button" class="ab-koppeltreffer" @onclick="() => KaartKoppel(doel)">
                                        <b>#@doel.Id</b> @doel.Titel <span class="ab-kboard">@ActStatus.Naam(doel.Status)@(doel.BoardId != _data.Board.Id ? " · " + doel.Board : "")</span>
                                    </button>
                                }
                                @if (_koppelZoek.Trim().Length >= 2 && _koppelTreffers.Count == 0) { <div class="ab-hint">Geen kaart gevonden.</div> }
                            </div>
                        }
                        else
                        {
                            <button type="button" class="ab-btn klein" @onclick="KaartKoppelOpen">+ koppelen</button>
                        }
                    </div>
                }

                @if (_metOpmaak)
                {
                    <div class="ab-lab">Opmaak</div>
                    <div class="ab-ro">
                        <label class="ab-opmaak"><input type="checkbox" checked="@o.Opmaak" @onchange="e => OpmaakGewijzigd(e.Value is true)" /> Markdown in de tekstvelden</label>
                        @Uitleg("Aan: kopjes, lijsten, vet en code worden opgemaakt getoond. Uit: de tekst staat er precies zoals hij is getypt.")
                    </div>
                }

                <div class="ab-lab">Dagen open</div>
                <div class="ab-ro">@(dagen?.ToString() ?? "–")@if (dagen is null) { <span class="ab-muted"> (sluitdatum onbekend)</span> }</div>
            </div>
            @foreach (var v in ActTekst.Velden)
            {
                var kolom = v.Kolom;
                var inhoud = o.Tekst.GetValueOrDefault(kolom) ?? "";
                // met opmaak (Markdown, vraag Gerard 20-11-2026): de tekst staat opgemaakt in beeld en wordt een tekstvak als
                // je hem bewerkt (knop of dubbelklik); een leeg veld is meteen een tekstvak. Zonder opmaak: zoals het was.
                var toon = o.Opmaak && inhoud.Length > 0 && _bewerkVeld != kolom;
                <div class="ab-sectie">
                    @* de uitleg van het veld achter een vraagteken; het vak zelf blijft leeg (wens gebruiker 20-11-2026) *@
                    <h3>@v.Naam @Uitleg(v.Hulp)
                        @if (toon) { <button type="button" class="ab-md-knop" title="Tekst bewerken (dubbelklik op de tekst kan ook)" @onclick="() => BewerkVeld(kolom)">✎ bewerken</button> }
                    </h3>
                    @if (toon)
                    {
                        <div class="ab-md" @ondblclick="() => BewerkVeld(kolom)">@((MarkupString)ActMarkdown.Html(inhoud))</div>
                    }
                    else
                    {
                        <textarea id="@($"ab-tx-{kolom}")" aria-label="@v.Naam" @onchange="e => TekstGewijzigd(kolom, e)"
                                  @onblur="() => { if (_bewerkVeld == kolom) _bewerkVeld = null; }">@inhoud</textarea>
                        @if (o.Opmaak && _bewerkVeld == kolom)
                        {
                            <div class="ab-hint">Markdown: <code># kop</code> · <code>**vet**</code> · <code>*cursief*</code> · <code>- lijst</code> · <code>1. genummerd</code> · <code>`code`</code> · <code>[tekst](https://…)</code>. Klik buiten het vak om de opmaak te zien.</div>
                        }
                    }
                </div>
                @if (kolom == "Samenvatting" && _metChecklist)
                {
                    @* de afvinklijst (vraag Gerard 20-11-2026): kopjes met punten; elke wijziging gaat meteen naar de database *@
                    <div class="ab-sectie ab-lijst">
                        <h3>Afvinklijst @if (o.PuntenTotaal > 0) { <span class="ab-lijst-tel @(o.PuntenKlaar == o.PuntenTotaal ? "af" : "")">@o.PuntenKlaar/@o.PuntenTotaal</span> }</h3>
                        @if (o.Id == 0)
                        {
                            <div class="ab-hint">Geef de activiteit eerst een titel; daarna kun je punten toevoegen.</div>
                        }
                        else
                        {
                            var groepen = ActPunt.Groepen(o.Checklist);
                            @foreach (var groep in groepen)
                            {
                                var g = groep;
                                var gid = g.Kop?.Id ?? 0;
                                @if (g.Kop is { } kop)
                                {
                                    <div class="ab-pkop" @key="kop.Id" @ondragover:preventDefault @ondrop="() => PuntDrop(kop.Id)">
                                        <span class="ab-pgreep" draggable="true" title="Slepen om te verplaatsen (of Alt+pijl omhoog/omlaag)" @ondragstart="() => _sleepPunt = kop.Id">⠿</span>
                                        <input id="@($"ab-pk-{kop.Id}")" value="@kop.Tekst" maxlength="200" aria-label="Kopje" @onchange="e => PuntTekst(kop, e)" @onkeydown="e => PuntToets(e, kop)" />
                                        <button type="button" class="ab-pweg" title="Kopje verwijderen (de punten blijven staan)" @onclick="() => PuntWeg(kop)">×</button>
                                    </div>
                                }
                                @foreach (var p in g.Punten)
                                {
                                    var punt = p;
                                    <div class="ab-punt @(punt.Klaar ? "klaar" : "")" @key="punt.Id" @ondragover:preventDefault @ondrop="() => PuntDrop(punt.Id)">
                                        <span class="ab-pgreep" draggable="true" title="Slepen om te verplaatsen (of Alt+pijl omhoog/omlaag)" @ondragstart="() => _sleepPunt = punt.Id">⠿</span>
                                        <input type="checkbox" checked="@punt.Klaar" title="@PuntTip(punt)" aria-label="Afgevinkt" @onchange="e => PuntKlaar(punt, e.Value is true)" />
                                        <input class="ab-ptekst" value="@punt.Tekst" maxlength="@ActPunt.MaxTekst" aria-label="Punt" title="@PuntTip(punt)" @onchange="e => PuntTekst(punt, e)" @onkeydown="e => PuntToets(e, punt)" />
                                        <button type="button" class="ab-pweg" title="Punt verwijderen" @onclick="() => PuntWeg(punt)">×</button>
                                    </div>
                                }
                                @* onderaan elk groepje: een punt erbij (Enter); ook de plek om een punt naar het eind van het groepje te slepen *@
                                @if (g.Kop is not null || groepen.Count == 1 || g.Punten.Count > 0)
                                {
                                    <div class="ab-pnieuw" @ondragover:preventDefault @ondrop="() => PuntDropEinde(gid)">
                                        <input id="@($"ab-pn-{gid}")" @key="@($"pn-{gid}-{_puntVersie}")" placeholder="+ punt (Enter)" maxlength="@ActPunt.MaxTekst" aria-label="Nieuw punt"
                                               @oninput="e => _nieuwPunt[gid] = (string?)e.Value ?? string.Empty" @onkeydown="e => NieuwPuntToets(e, gid)" />
                                    </div>
                                }
                            }
                            <button class="ab-btn klein" type="button" @onclick="NieuwKopje">+ Kopje</button>
                        }
                    </div>
                }
            }
        </div>
        <div class="ab-dvoet">
            <button class="ab-btn klein gevaar" type="button" @onclick="VerwijderOpen">Verwijderen</button>
            <span style="flex:1"></span>
            <button class="ab-btn klein primair" type="button" @onclick="SluitPaneel">Sluiten</button>
        </div>
    </aside>
}
</div>

@* ---------- rechtermuismenu op een kaart of tabelregel ---------- *@
@if (_menu is { } mn && _data?.Activiteiten.FirstOrDefault(x => x.Id == mn.Id) is { } ma)
{
    <div class="ab-menuvang" @onclick="() => _menu = null" @oncontextmenu="() => _menu = null" @oncontextmenu:preventDefault></div>
    <div class="ab-menu" role="menu" tabindex="-1" aria-label="@("Acties voor " + ma.Titel)" @onkeydown="MenuToets"
         style="left:min(@(mn.X)px, calc(100vw - 244px)); top:max(8px, min(@(mn.Y)px, calc(100vh - 490px)))">
        <div class="ab-menukop" title="@ma.Titel">@ma.Titel</div>
        <button type="button" role="menuitem" @onclick="() => MenuOpen(ma)">Openen</button>
        <div class="ab-menulab">Status</div>
        @foreach (var s in ActStatus.Alle)
        {
            var code = s.Code;
            <button type="button" role="menuitem" @onclick="() => MenuStatus(ma, code)">
                <span class="ab-pdot ab-dot-@s.Kleur"></span>@s.Naam@if (ma.Status == code) { <span class="ab-menuvink">✓</span> }
            </button>
        }
        <div class="ab-menulab">Prioriteit</div>
        <div class="ab-menurij">
            @foreach (var pr in ActPrioriteit.Alle)
            {
                var w = pr.Waarde;
                <button type="button" class="ab-kies @(ma.Prioriteit == w ? "aan ab-k-" + pr.Kleur : "")" aria-pressed="@(ma.Prioriteit == w)"
                        @onclick="() => MenuPrio(ma, w)">@pr.Naam</button>
            }
        </div>
        <div class="ab-menulijn"></div>
        @if (Ik.WerknemerId is int ikm && (ma.Personen.Contains(ikm) || _persoonOpId.GetValueOrDefault(ikm)?.Kiesbaar == true))
        {
            <button type="button" role="menuitem" @onclick="() => MenuIk(ma, ikm)">@(ma.Personen.Contains(ikm) ? "Mij eraf halen" : "Aan mij toewijzen")</button>
        }
        <button type="button" role="menuitem" @onclick="() => MenuDupliceer(ma)">Dupliceren</button>
        <div class="ab-menulijn"></div>
        <button type="button" role="menuitem" class="gevaar" @onclick="() => MenuVerwijder(ma)">Verwijderen</button>
    </div>
}

@* ---------- bevestiging in de pagina (geen browser-pop-ups, spec §7) ---------- *@
@if (_modal is { } md)
{
    <div class="ab-modal" @onkeydown="ModalToets">
        <div class="ab-mbox" role="dialog" aria-modal="true">
            <h3>@md.Titel</h3>
            <p>@md.Tekst</p>
            <div class="ab-mknop">
                <button class="ab-btn klein" type="button" id="ab-mnee" @onclick="() => _modal = null">Annuleren</button>
                <button class="ab-btn klein primair" type="button" @onclick="ModalJa">@md.Ja</button>
            </div>
        </div>
    </div>
}

@* ---------- board koppelen aan een project of klant, of losmaken ---------- *@
@if (_koppelOpen && _data is not null)
{
    <div class="ab-modal" @onkeydown="KoppelToets">
        <div class="ab-mbox ab-koppel" role="dialog" aria-modal="true">
            <h3>Board koppelen</h3>
            <p>Nu: <b>@ActBoardSoort.Naam(_data.Board.Soort)</b>@(_data.Board.Soort == ActBoardSoort.Vrij ? "" : " · " + _data.Board.StandaardTitel).
                Kies een project, werkorder of klant; alle onderwerpen, types en activiteiten gaan mee. Eén board per project, per werkorder en per klant.</p>
            @ZoekVak(koppelen: true)
            <div class="ab-mknop">
                @if (_data.Board.Soort != ActBoardSoort.Vrij)
                {
                    <button class="ab-btn klein" type="button" @onclick="Losmaken" title="Geen project, werkorder of klant meer; het board houdt zijn naam">Losmaken (vrij board)</button>
                }
                <span style="flex:1"></span>
                <button class="ab-btn klein" type="button" id="ab-knee" @onclick="() => _koppelOpen = false">Sluiten</button>
            </div>
        </div>
    </div>
}

@* ---------- melding onderin ---------- *@
@if (_toast is { } ts)
{
    <div class="ab-toast @(ts.Fout ? "fout" : "") @(_open is not null ? "naast" : "")" role="status" aria-live="polite">
        <span>@ts.Tekst</span>
        @if (ts.Ongedaan is not null)
        {
            <button type="button" @onclick="Ongedaan">Ongedaan maken</button>
        }
    </div>
}

