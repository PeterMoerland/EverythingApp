    // ================================================================ live

    private void OpLive(int boardId, Guid bron, string door)
    {
        if (bron == _sleutel || _data is null || boardId != _data.Board.Id) return;
        _ = InvokeAsync(async () =>
        {
            if (_sleept) { _herladen = true; return; }
            await HerlaadAsync();
            StateHasChanged();
        });
    }

    /// <summary>Het board opnieuw uit de database; het open detailpaneel houdt titel en tekst die je aan het typen bent.</summary>
    private async Task HerlaadAsync()
    {
        if (_data is null) return;
        try
        {
            var vers = await Repo.LaadAsync(_data.Board.Id);
            if (vers is null) { _data = null; _laadFout = "Dit board is verwijderd."; _open = null; return; }
            _data = vers;
            await LaadBijlagen();
            if (_open is { Id: > 0 } o)
            {
                var a = vers.Activiteiten.FirstOrDefault(x => x.Id == o.Id);
                if (a is null) { _open = null; Toon("Deze activiteit is door een collega verwijderd."); }
                else
                {
                    o.Status = a.Status; o.Prioriteit = a.Prioriteit; o.Vervaldatum = a.Vervaldatum; o.GeslotenOp = a.GeslotenOp;
                    o.BenodigdeUren = a.BenodigdeUren;
                    o.Problemen = new(a.Problemen); o.Types = new(a.Types); o.Personen = new(a.Personen);
                    o.Checklist = a.Checklist.Select(p => p.Kopie()).ToList();
                    o.Opmaak = a.Opmaak;
                    o.Koppelingen = new(a.Koppelingen);
                    // de tekst van een collega of de API, behalve in het veld waar je zelf in typt
                    foreach (var veld in ActTekst.Velden.Select(x => x.Kolom).Where(k => k != _bewerkVeld))
                        if (a.Tekst.TryGetValue(veld, out var nieuweTekst)) o.Tekst[veld] = nieuweTekst; else o.Tekst.Remove(veld);
                }
            }
            if (_typeHernoem is int t && !vers.Types.Any(x => x.Id == t)) _typeHernoem = null;
            ValideerFilters();
        }
        catch (Exception ex) { Toon("Verversen mislukt: " + ex.Message, fout: true); }
    }

    private void Meld() { if (_data is not null) Live.Meld(_data.Board.Id, _sleutel, Ik.Naam); }

    /// <summary>Een eigen wijziging naar de database; lukt het niet, dan melden en het board opnieuw laden.</summary>
    private async Task<bool> Bewaar(Func<Task> doe)
    {
        try { await doe(); Meld(); return true; }
        catch (Exception ex)
        {
            Toon("Opslaan mislukt: " + ex.Message, fout: true);
            await HerlaadAsync();
            return false;
        }
    }

    // ================================================================ rekenregels

    private Dictionary<int, int> ProbIndex()
    {
        var idx = new Dictionary<int, int>();
        if (_data is null) return idx;
        for (var i = 0; i < _data.Problemen.Count; i++) idx[_data.Problemen[i].Id] = i;
        return idx;
    }

    /// <summary>De baan: het gekoppelde probleem met de hoogste prioriteit, anders "geen".</summary>
    private static string Lane(Activiteit a, Dictionary<int, int> idx)
    {
        int? best = null; var bi = int.MaxValue;
        foreach (var id in a.Problemen)
            if (idx.TryGetValue(id, out var i) && i < bi) { bi = i; best = id; }
        return best?.ToString() ?? "geen";
    }

    private static List<int> ProblemenGesorteerd(Activiteit a, Dictionary<int, int> idx)
        => a.Problemen.Where(idx.ContainsKey).OrderBy(id => idx[id]).ToList();

    private static int OpVolgorde(Activiteit x, Activiteit y)
        => x.Volgorde != y.Volgorde ? x.Volgorde.CompareTo(y.Volgorde) : x.GemaaktOp.CompareTo(y.GemaaktOp);

    private Dictionary<int, (int Open, int Klaar)> TelPerProbleem()
    {
        var t = new Dictionary<int, (int Open, int Klaar)>();
        if (_data is null) return t;
        foreach (var p in _data.Problemen) t[p.Id] = (0, 0);
        foreach (var a in _data.Activiteiten)
            foreach (var id in a.Problemen)
                if (t.TryGetValue(id, out var x))
                    t[id] = ActStatus.Groep(a.Status) == ActStatus.GroepKlaar ? (x.Open, x.Klaar + 1) : (x.Open + 1, x.Klaar);
        return t;
    }

    private bool FiltersActief => _fProb.Length > 0 || _fWie.Length > 0 || _fType.Length > 0 || _fQ.Trim().Length > 0;

    private void WisFilters() { _fProb = ""; _fWie = ""; _fType = ""; _fQ = ""; }

    /// <summary>Een filter dat naar iets verwijderds wijst, wordt gewist (spec §5).</summary>
    private void ValideerFilters()
    {
        if (_data is null) return;
        if (_fProb.Length > 0 && _fProb != "geen" && !_data.Problemen.Any(p => p.Id.ToString() == _fProb)) _fProb = "";
        if (_fType.Length > 0 && !_data.Types.Any(t => t.Id.ToString() == _fType)) _fType = "";
        if (_fWie.Length > 0 && _fWie != "niemand" && !_persoonOpId.ContainsKey(int.TryParse(_fWie, out var w) ? w : -1)) _fWie = "";
    }

    private List<Activiteit> Gefilterd(Dictionary<int, int> idx)
    {
        if (_data is null) return new();
        var q = _fQ.Trim();
        return _data.Activiteiten.Where(a =>
        {
            if (_fProb == "geen" && Lane(a, idx) != "geen") return false;
            if (_fProb.Length > 0 && _fProb != "geen" && !a.Problemen.Any(p => p.ToString() == _fProb)) return false;
            if (!_markeer && _fWie.Length > 0 && !VanPersoon(a)) return false;      // bij markeren blijft alles staan
            if (_fType.Length > 0 && !a.Types.Any(t => t.ToString() == _fType)) return false;
            if (q.Length > 0 && !a.Titel.Contains(q, StringComparison.OrdinalIgnoreCase)) return false;
            return true;
        }).ToList();
    }

    // ---- persoon: filteren of markeren (wens gebruiker 19-11-2026: "wat staat er voor mij open", de rest blijft zichtbaar)
    private bool _markeer;                                 // onthouden per pc (mdeOpslag "ab-markeer")

    /// <summary>Ikzelf, als ik in de lijst gekozen kan worden (gekoppeld, in dienst).</summary>
    private int? IkKiesbaar => Ik.WerknemerId is int ik && _persoonOpId.GetValueOrDefault(ik)?.Kiesbaar == true ? ik : null;

    /// <summary>Hoort de activiteit bij de persoon uit "Toegewezen aan" (of bij niemand, als dat gekozen is)?</summary>
    private bool VanPersoon(Activiteit a)
        => _fWie == "niemand" ? a.Personen.Count == 0 : a.Personen.Any(p => p.ToString() == _fWie);

    /// <summary>
    /// Klassen van een kaart of tabelregel: open in het paneel (of het menu), van mijzelf (eigen: ik ben eraan toegewezen;
    /// altijd een opvallende rand, wens gebruiker 19-11-2026), en met Markeren aan: gemarkeerd of juist gedimd.
    /// </summary>
    private string KaartKlasse(Activiteit a)
        => (a.Id != 0 && (_open?.Id == a.Id || _menu?.Id == a.Id || _kaartGekozen == a.Id) ? "gekozen " : "")
           + (Ik.WerknemerId is int ik && a.Personen.Contains(ik) ? "eigen " : "")
           + (_markeer && _fWie.Length > 0 ? VanPersoon(a) ? "mijn" : "dim" : "");

    private async Task WisselMarkeer()
    {
        _markeer = !_markeer;
        // nog niemand gekozen: jezelf, want daar gaat het meestal om
        if (_markeer && _fWie.Length == 0 && IkKiesbaar is int ik) _fWie = ik.ToString();
        try { await JS.InvokeVoidAsync("mdeOpslag.schrijf", "ab-markeer", _markeer ? "ja" : "nee"); } catch { }
        if (_markeer && _fWie.Length == 0) Toon("Kies bij \"Toegewezen aan\" wie je wilt markeren.");
    }

    // ================================================================ rechtermuismenu op een kaart of tabelregel
    // Wens gebruiker 19-11-2026. Werkt op de activiteit in de lijst van het board; het open paneel volgt (NaarPaneel).
    private sealed record KaartMenu(int Id, int X, int Y);
    private KaartMenu? _menu;

    private void OpenMenu(MouseEventArgs e, Activiteit a)
    {
        if (_sleept || a.Id == 0) return;      // touch: lang vasthouden sleept (activityboard.js), dan geen menu
        _snel = null;
        _menu = new KaartMenu(a.Id, (int)e.ClientX, (int)e.ClientY);
        _focusNa = ".ab-menu";
    }

    private void MenuToets(KeyboardEventArgs e) { if (e.Key == "Escape") _menu = null; }
    private void MenuOpen(Activiteit a) { _menu = null; OpenPaneel(a); }

    /// <summary>Het open paneel laat dezelfde activiteit zien: status, prioriteit en personen overnemen.</summary>
    private void NaarPaneel(Activiteit a)
    {
        if (_open is not { } o || o.Id != a.Id) return;
        o.Status = a.Status; o.GeslotenOp = a.GeslotenOp; o.Prioriteit = a.Prioriteit; o.Personen = new(a.Personen);
    }

    private async Task MenuStatus(Activiteit a, string status)
    {
        _menu = null;
        if (!ActStatus.IsGeldig(status) || status == a.Status) return;
        ZetStatus(a, status);
        if (!await Bewaar(() => Repo.ZetStatusAsync(a.Id, a.Status, a.GeslotenOp, Ik.WerknemerId))) return;   // mislukt: Bewaar laadt het board opnieuw
        NaarPaneel(a);
        Toon($"\"{a.Titel}\": status {ActStatus.Naam(status)}");
    }

    private async Task MenuPrio(Activiteit a, int waarde)
    {
        _menu = null;
        a.Prioriteit = a.Prioriteit == waarde ? null : waarde;
        if (!await Bewaar(() => Repo.ZetVeldAsync(a.Id, "Prioriteit", a.Prioriteit, Ik.WerknemerId))) return;
        NaarPaneel(a);
        Toon($"\"{a.Titel}\": prioriteit {(a.Prioriteit is null ? "weg" : ActPrioriteit.Naam(a.Prioriteit))}");
    }

    private async Task MenuIk(Activiteit a, int ik)
    {
        _menu = null;
        var erbij = !a.Personen.Remove(ik);
        if (erbij) a.Personen.Add(ik);
        if (!await Bewaar(() => Repo.ZetKoppelingenAsync(a.Id, KoppelPersonen, a.Personen.ToList(), Ik.WerknemerId))) return;
        NaarPaneel(a);
        Toon(erbij ? $"\"{a.Titel}\" is aan jou toegewezen" : $"Je bent van \"{a.Titel}\" af");
    }

    /// <summary>Kopie met alles erop en eraan, onderaan hetzelfde vak; de datum is nu.</summary>
    private async Task MenuDupliceer(Activiteit a)
    {
        _menu = null;
        if (_data is null) return;
        var idx = ProbIndex();
        var lane = Lane(a, idx);
        var k = a.Kopie();
        k.Id = 0;
        k.GemaaktDoor = Ik.WerknemerId;          // de kopie is van wie hem maakt
        k.Titel = a.Titel + " (kopie)";
        if (k.Titel.Length > 300) k.Titel = k.Titel[..300];
        k.GemaaktOp = DateTime.Now;
        k.GeslotenOp = ActStatus.Groep(k.Status) == ActStatus.GroepKlaar ? k.GemaaktOp : null;
        k.Volgorde = _data.Activiteiten.Where(x => x.Status == a.Status && Lane(x, idx) == lane).Select(x => x.Volgorde).DefaultIfEmpty(-1).Max() + 1;
        if (!await Bewaar(async () => k.Id = await Repo.NieuweActiviteitAsync(_data.Board.Id, k, Ik.WerknemerId))) return;
        _data.Activiteiten.Add(k);
        await MeldToewijzing(k, k.Personen, nieuw: true);
        Toon($"Kopie gemaakt: \"{k.Titel}\"");
    }

    private async Task MenuVerwijder(Activiteit a) { _menu = null; await Verwijder(a); }

    /// <summary>Staat deze activiteit in de huidige weergave met de huidige filters?</summary>
    private bool Zichtbaar(Activiteit a)
    {
        if (_data is null) return false;
        if (!Gefilterd(ProbIndex()).Any(x => x.Id == a.Id)) return false;
        if (_view == "mijn") return Ik.WerknemerId is int ik && a.Personen.Contains(ik);
        if (_view == "voltooid") return ActStatus.Groep(a.Status) == ActStatus.GroepKlaar;
        return true;
    }

