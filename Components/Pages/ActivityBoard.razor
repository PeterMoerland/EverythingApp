    // ================================================================ bijlagen bij een onderwerp
    // Plaatjes en bestanden (wens gebruiker 24-10-2026): filestore-soort 342, MasterID = het onderwerp (ProbleemID).
    // Meteen opgeslagen; FileStoreType 342 komt uit ActivityBoard_Werkorder_Bijlagen_MariaDB.sql.
    private const int StoreTypeOnderwerp = 342;
    private const long MaxBijlage = 20_000_000;
    private Dictionary<int, List<Bestand>> _bijlagen = new();
