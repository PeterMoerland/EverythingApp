        {
            using var m = new MemoryStream(inhoud);
            await Store.ToevoegenAsync(m, naam, StoreTypeOnderwerp, probleemId, Ik.WerknemerId ?? 0);
            _bijlagen[probleemId] = await Bestanden.GetBestandenAsync(StoreTypeOnderwerp, probleemId);
            Toon($"Bijlage ‘{naam}’ toegevoegd");
        }
        catch (Exception ex)
        {
            Toon("Bijlage opslaan mislukt: " + ex.GetBaseException().Message
                 + " (is ActivityBoard_Werkorder_Bijlagen_MariaDB.sql uitgevoerd?)", fout: true);
        }
        finally { _bijlBezig = false; }
