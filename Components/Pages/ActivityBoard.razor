    private static bool IsPlaatje(string naam)
        => Path.GetExtension(naam).ToLowerInvariant() is ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp" or ".bmp";

    private async Task BijlagenGekozen(ActProbleem p, InputFileChangeEventArgs e)
    {
        foreach (var f in e.GetMultipleFiles(10))
        {
            try
            {
                await using var s = f.OpenReadStream(maxAllowedSize: MaxBijlage);
                using var m = new MemoryStream();
                await s.CopyToAsync(m);
                await BewaarBijlage(p.Id, m.ToArray(), f.Name);
