    private async Task SnelToets(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _snel = null;
        else if (e.Key == "Enter") await SnelOpslaan();
    }

    private async Task SnelBlur()
    {
        // klik buiten de editor slaat op (aanname A4); zonder titel gewoon dicht
        if (_snel is null) return;
        if (_snel.Titel.Trim().Length == 0) { _snel = null; return; }
        await SnelOpslaan();
    }

    private async Task SnelOpslaan()
    {
        if (_snel is not { } sn || _data is null) return;
        var titel = sn.Titel.Trim();
        if (titel.Length == 0) { sn.Fout = true; Toon("Een activiteit heeft een titel nodig", fout: true); _focusNa = "#ab-snel"; return; }
        _snel = null;
        var idx = ProbIndex();
        var zelfde = _data.Activiteiten.Where(x => x.Status == sn.Status && Lane(x, idx) == sn.Lane).Select(x => x.Volgorde).ToList();
        var a = new Activiteit
        {
            Titel = titel, Status = sn.Status, GemaaktOp = DateTime.Now,
            Volgorde = zelfde.Count > 0 ? zelfde.Max() + 1 : 0,          // snel aanmaken: onderaan het vak
        };
        if (sn.Lane != "geen") a.Problemen.Add(int.Parse(sn.Lane));
        // actieve filters op persoon en type worden overgenomen
        if (int.TryParse(_fWie, out var w) && _persoonOpId.ContainsKey(w)) a.Personen.Add(w);
        if (int.TryParse(_fType, out var t) && _data.Types.Any(x => x.Id == t)) a.Types.Add(t);
        if (ActStatus.Groep(a.Status) == ActStatus.GroepKlaar) a.GeslotenOp = a.GemaaktOp;
        if (!await Bewaar(async () => a.Id = await Repo.NieuweActiviteitAsync(_data.Board.Id, a, Ik.WerknemerId))) return;
        _data.Activiteiten.Add(a);
        Toon(Zichtbaar(a) ? $"\"{a.Titel}\" toegevoegd" : "Activiteit toegevoegd, maar met deze filters niet zichtbaar.");
    }

