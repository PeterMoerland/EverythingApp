    protected override void OnInitialized() => Live.Gewijzigd += OpLive;

    protected override async Task OnParametersSetAsync()
    {
        await Ik.ZorgGeladenAsync();
        if (!Repo.Beschikbaar) return;
        _tabellen ??= await Repo.TabellenAanwezigAsync();
        if (_tabellen != true) return;
        _soorten = await Repo.SoortenAanwezigAsync();
        _metWerkorder = _soorten && await Repo.WerkorderAanwezigAsync();
        _metTijd = await Repo.TijdAanwezigAsync();
        _metChecklist = await Repo.ChecklistAanwezigAsync();
        _metOpmaak = await Repo.OpmaakAanwezigAsync();
        _metKoppelingen = await Repo.KoppelingenAanwezigAsync();

        if (KaartUitUrl is null) _kaartUitUrlGedaan = null;
        if (BoardId is null && KaartUitUrl is int kaart)
        {
            int? bord = null;
            try { bord = await Repo.BoardVanActiviteitAsync(kaart); } catch { }
            if (bord is int naarBord) { Nav.NavigateTo($"activityboard/{naarBord}?kaart={kaart}", replace: true); return; }
            Toon("Deze activiteit bestaat niet meer.", fout: true);
        }

        if (BoardId is null)
        {
            _data = null; _geladenBoard = null; _open = null;
            try { _boards = await Repo.GetBoardsAsync(); }
            catch (Exception ex) { _boards = new(); Toon("Boards laden mislukt: " + ex.Message, fout: true); }
            if (_zoek.Trim().Length < 2) await LaadKeuzelijst();
            return;
        }
        if (_geladenBoard == BoardId) { OpenKaartUitUrl(); return; }
        _geladenBoard = BoardId;
        _open = null; _snel = null; _dicht.Clear(); WisFilters();
        try
        {
            if (_personen.Count == 0)
            {
                _personen = await Repo.GetPersonenAsync();
                _persoonOpId = _personen.ToDictionary(p => p.Id);
            }
            _data = await Repo.LaadAsync(BoardId.Value);
            if (_data is null) _laadFout = "Dit board bestaat niet (meer).";
            else await LaadBijlagen();
        }
        catch (Exception ex) { _data = null; _laadFout = "Laden mislukt: " + ex.Message; }
        OpenKaartUitUrl();
    }

    /// <summary>De activiteit uit het adres (?kaart=) één keer openen, zodra het board er is.</summary>
    private void OpenKaartUitUrl()
    {
        if (KaartUitUrl is not int id || _kaartUitUrlGedaan == id || _data is null) return;
        _kaartUitUrlGedaan = id;
        if (_data.Activiteiten.FirstOrDefault(x => x.Id == id) is { } a) OpenPaneel(a);
        else Toon("Deze activiteit staat niet (meer) op dit board.", fout: true);
    }

    // ================================================================ melding bij toewijzen
    // Punt van Gerard (19-11-2026): een melding in de bel als iemand anders een kaartje voor je aanmaakt of je eraan
    // toewijst. Soort 'activiteit', OrderID = de activiteit (MeldingBel linkt naar activityboard?kaart=…). Niet aan jezelf,
    // en alleen als bekend is wie het doet (op een gedeelde werkplek of zonder aanmelding geen melding).
    private async Task MeldToewijzing(Activiteit a, IEnumerable<int> personen, bool nieuw)
    {
        if (a.Id == 0 || _data is null || Ik.WerknemerId is not int ik || !Meldingen.Beschikbaar) return;
        var wie = personen.Distinct().Where(p => p != ik && _persoonOpId.GetValueOrDefault(p)?.Kiesbaar == true).ToList();
        if (wie.Count == 0) return;
        var titel = a.Titel.Trim().ReplaceLineEndings(" ");
        if (titel.Length > 90) titel = titel[..87] + "…";
        var tekst = (nieuw ? $"{Ik.Naam} heeft een activiteit voor je aangemaakt: ‘{titel}’" : $"{Ik.Naam} heeft je toegewezen aan ‘{titel}’")
                    + $" (Activity board {_data.Board.Titel})";
        if (tekst.Length > 250) tekst = tekst[..249] + "…";      // Meldingen.Tekst is minstens VARCHAR(250)
        var gelukt = 0;
        foreach (var p in wie)
        {
            try { await Meldingen.MaakAsync(p, "activiteit", a.Id, tekst); gelukt++; }
            catch { /* de toewijzing zelf is gelukt; de melding is een extra */ }
        }
        if (gelukt > 0) Signaal.Geef();
    }

    protected override async Task OnAfterRenderAsync(bool eerste)
    {
        if (eerste)
        {
            _zelf = DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("mdeAb.koppel", _zelf); } catch { }
        }
        if (!_weergaveGelezen)
        {
            _weergaveGelezen = true;
            try
            {
                if (await JS.InvokeAsync<string?>("mdeOpslag.lees", "ab-weergave") == "lijst") { _boom = false; StateHasChanged(); }
                if (await JS.InvokeAsync<string?>("mdeOpslag.lees", "ab-markeer") == "ja") { _markeer = true; StateHasChanged(); }
            }
            catch { }
        }
        if (_focusNa is { } f)
        {
            _focusNa = null;
            // "eind:" = de cursor achteraan zetten in plaats van alles selecteren (een tekstveld dat je gaat bewerken)
            try { await JS.InvokeVoidAsync(f.StartsWith("eind:") ? "mdeAb.focusEind" : "mdeAb.focusEl", f.StartsWith("eind:") ? f[5..] : f); } catch { }
        }
        if (_focusKaart is int k)
        {
            _focusKaart = null;
            try { await JS.InvokeVoidAsync("mdeAb.focus", k); } catch { }
        }
        if (_koppelPlakken && _bijlagenOpen is not null && _zelf is not null)
        {
            // Ctrl+V met een plaatje in de uitgeklapte bijlagen (zelfde opzet als het lampje: mdeKlembord in klembord.js)
            _koppelPlakken = false;
            try { await JS.InvokeVoidAsync("mdeKlembord.koppelPlakken", _bijlagenVak, _zelf); } catch { }
            try { await _bijlagenVak.FocusAsync(); } catch { }
        }
    }

    // ================================================================ bijlagen bij een onderwerp
    // Plaatjes en bestanden (wens gebruiker 24-10-2026): filestore-soort 342, MasterID = het onderwerp (ProbleemID).
    // Meteen opgeslagen; FileStoreType 342 komt uit ActivityBoard_Werkorder_Bijlagen_MariaDB.sql.
    private const int StoreTypeOnderwerp = 342;
    private const long MaxBijlage = 20_000_000;
    private Dictionary<int, List<Bestand>> _bijlagen = new();
    private int? _bijlagenOpen;
    private ElementReference _bijlagenVak;
    private bool _koppelPlakken, _bijlBezig;

    private async Task LaadBijlagen()
    {
        if (_data is null || !Bestanden.Beschikbaar) { _bijlagen = new(); return; }
        var uit = new Dictionary<int, List<Bestand>>();
        foreach (var p in _data.Problemen)
        {
            try { uit[p.Id] = await Bestanden.GetBestandenAsync(StoreTypeOnderwerp, p.Id); }
            catch { uit[p.Id] = new(); }
        }
        _bijlagen = uit;
    }

    private void WisselBijlagen(int id)
    {
        _bijlagenOpen = _bijlagenOpen == id ? null : id;
        _koppelPlakken = _bijlagenOpen is not null;
    }

    private static bool IsPlaatje(string naam)
        => Path.GetExtension(naam).ToLowerInvariant() is ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp" or ".bmp";

    private async Task BijlagenGekozen(ActProbleem p, InputFileChangeEventArgs e)
    {
        foreach (var f in e.GetMultipleFiles(10))
        {
            try
            {
                await using var s = f.OpenReadStream(maxAllowedSize: MaxBijlage);
                using var m = new MemoryStream();
                await s.CopyToAsync(m);
                await BewaarBijlage(p.Id, m.ToArray(), f.Name);
            }
            catch (Exception ex) { Toon($"{f.Name} toevoegen mislukt: {ex.GetBaseException().Message}", fout: true); }
        }
    }

    private async Task BewaarBijlage(int probleemId, byte[] inhoud, string naam)
    {
        _bijlBezig = true;
        try
        {
            using var m = new MemoryStream(inhoud);
            await Store.ToevoegenAsync(m, naam, StoreTypeOnderwerp, probleemId, Ik.WerknemerId ?? 0);
            _bijlagen[probleemId] = await Bestanden.GetBestandenAsync(StoreTypeOnderwerp, probleemId);
            Toon($"Bijlage ‘{naam}’ toegevoegd");
        }
        catch (Exception ex)
        {
            Toon("Bijlage opslaan mislukt: " + ex.GetBaseException().Message
                 + " (is ActivityBoard_Werkorder_Bijlagen_MariaDB.sql uitgevoerd?)", fout: true);
        }
        finally { _bijlBezig = false; }
    }

    [JSInvokable]
    public async Task AfbeeldingGeplakt(string soort, int grootte)
    {
        if (_bijlagenOpen is not int id) return;
        try
        {
            var stroom = await JS.InvokeAsync<IJSStreamReference?>("mdeKlembord.afbeelding");
            if (stroom is null) return;
            await using var s = await stroom.OpenReadStreamAsync(maxAllowedSize: MaxBijlage);
            using var m = new MemoryStream();
            await s.CopyToAsync(m);
            var ext = soort.ToLowerInvariant() switch { "image/jpeg" or "image/jpg" => ".jpg", "image/gif" => ".gif", "image/webp" => ".webp", _ => ".png" };
            await InvokeAsync(async () => { await BewaarBijlage(id, m.ToArray(), $"plaatje {DateTime.Now:yyyy-MM-dd HHmmss}{ext}"); StateHasChanged(); });
        }
        catch (Exception ex) { Toon("Plakken mislukt: " + ex.Message, fout: true); await InvokeAsync(StateHasChanged); }
    }

    /// <summary>Gewone tekst geplakt: niets aan de hand.</summary>
    [JSInvokable]
    public Task GeenAfbeelding() => Task.CompletedTask;

    private async Task WisBijlage(ActProbleem p, Bestand b)
    {
        if (!await JS.InvokeAsync<bool>("mdeBevestig", $"Bijlage ‘{b.Bestandsnaam}’ bij ‘{p.Naam}’ verwijderen?")) return;
        try
        {
            await Store.VerwijderAsync(b.FileStoreId);
            _bijlagen[p.Id] = await Bestanden.GetBestandenAsync(StoreTypeOnderwerp, p.Id);
            Toon("Bijlage verwijderd");
        }
        catch (Exception ex) { Toon("Verwijderen mislukt: " + ex.Message, fout: true); }
    }
