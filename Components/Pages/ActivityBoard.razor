    /// <summary>Kaart losgelaten (spec §4): kolom = status, baan = probleem, plek = volgorde. status null = op een baankop.</summary>
    [JSInvokable]
    public async Task KaartLosgelaten(int id, string lane, string? status, string? prevId, string? nextId)
    {
        if (_data is null) return;
        var a = _data.Activiteiten.FirstOrDefault(x => x.Id == id);
        if (a is null) return;
        var idx = ProbIndex();
        var oudeLane = Lane(a, idx);
        var oudeStatus = a.Status;
        var nieuweStatus = status is not null && ActStatus.IsGeldig(status) ? status : a.Status;
        var nieuweLane = lane;
        if (nieuweLane != "geen" && !_data.Problemen.Any(p => p.Id.ToString() == nieuweLane)) return;

        List<Activiteit> CelVan(string l, string st, Activiteit? zonder)
        {
            var c = _data.Activiteiten.Where(x => x != zonder && x.Status == st && Lane(x, idx) == l).ToList();
            c.Sort(OpVolgorde);
            return c;
        }
        // op een baankop: achteraan in dezelfde status
        if (status is null) { var c = CelVan(nieuweLane, a.Status, a); prevId = c.Count > 0 ? c[^1].Id.ToString() : null; nextId = null; }

        int Plaats(List<Activiteit> lijst)
        {
            if (nextId is not null) { var i = lijst.FindIndex(x => x.Id.ToString() == nextId); if (i >= 0) return i; }
            if (prevId is not null) { var i = lijst.FindIndex(x => x.Id.ToString() == prevId); if (i >= 0) return i + 1; }
            return prevId is not null ? lijst.Count : 0;
        }
        if (nieuweStatus == oudeStatus && nieuweLane == oudeLane && CelVan(oudeLane, oudeStatus, null).IndexOf(a) == Plaats(CelVan(oudeLane, oudeStatus, a)))
            return;

        var meldingen = new List<string>();
        if (nieuweStatus != oudeStatus) { ZetStatus(a, nieuweStatus); meldingen.Add("Status: " + ActStatus.Naam(nieuweStatus)); }
        if (nieuweLane != oudeLane)
        {
            if (nieuweLane == "geen") { a.Problemen.Clear(); meldingen.Add("Koppeling met onderwerpen verwijderd"); }
            else
            {
                var nl = int.Parse(nieuweLane);
                if (oudeLane != "geen") a.Problemen.Remove(int.Parse(oudeLane));
                if (!a.Problemen.Contains(nl)) a.Problemen.Add(nl);
                meldingen.Add($"Onderwerp: {(oudeLane == "geen" ? "geen" : ProbNaam(int.Parse(oudeLane)))} → {ProbNaam(nl)}");
            }
        }
        var echt = Lane(a, idx);
        if (nieuweLane != "geen" && echt != nieuweLane)
            meldingen.Add($"staat bij \"{ProbNaam(int.Parse(echt))}\" omdat dat gekoppelde onderwerp een hogere prioriteit heeft");
        // het doelvak opnieuw nummeren, zodat gelijke waarden nooit blijven hangen
        var lijst = CelVan(echt, a.Status, a);
        lijst.Insert(echt == nieuweLane ? Plaats(lijst) : lijst.Count, a);
        for (var i = 0; i < lijst.Count; i++) lijst[i].Volgorde = i;
        if (_open?.Id == a.Id) { _open.Status = a.Status; _open.GeslotenOp = a.GeslotenOp; _open.Problemen = new(a.Problemen); }
        StateHasChanged();

        var ids = lijst.Select(x => x.Id).ToList();
        if (await Bewaar(() => Repo.VerplaatsAsync(a.Id, a.Status, a.GeslotenOp, a.Problemen, ids, Ik.WerknemerId)) && meldingen.Count > 0)
            Toon($"\"{a.Titel}\": {string.Join(" · ", meldingen)}");
        StateHasChanged();
    }

    private string ProbNaam(int id) => _data?.Problemen.FirstOrDefault(p => p.Id == id)?.Naam ?? "?";

    // ---- snel aanmaken in een vak (fase 1: alleen de titel; wie/type volgen de filters) ----

    private void OpenSnel(string status, string lane)
    {
        // een nieuwe kaart typen in een vak: de kaart in het paneel is niet meer gekozen, dus het paneel gaat dicht
        if (_open is not null) { SluitPaneel(); _focusKaart = null; }
        _snel = new SnelInvoer { Status = status, Lane = lane };
        _focusNa = "#ab-snel";
    }

    private async Task SnelToets(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _snel = null;
        else if (e.Key == "Enter") await SnelOpslaan(open: true);
    }

    private async Task SnelBlur()
    {
        // klik buiten de editor slaat op (aanname A4); zonder titel gewoon dicht
        if (_snel is null) return;
        if (_snel.Titel.Trim().Length == 0) { _snel = null; return; }
        await SnelOpslaan(open: false);
    }

    /// <summary>
    /// De getypte kaart aanmaken. Met Enter of Klaar (<paramref name="open"/>) gaan daarna meteen de eigenschappen open
    /// (wens gebruiker 19-11-2026); bij een klik ernaast niet, dan wilde je ergens anders heen.
    /// </summary>
    private async Task SnelOpslaan(bool open)
    {
        if (_snel is not { } sn || _data is null) return;
        var titel = sn.Titel.Trim();
        if (titel.Length == 0) { sn.Fout = true; Toon("Een activiteit heeft een titel nodig", fout: true); _focusNa = "#ab-snel"; return; }
        _snel = null;
        var idx = ProbIndex();
        var zelfde = _data.Activiteiten.Where(x => x.Status == sn.Status && Lane(x, idx) == sn.Lane).Select(x => x.Volgorde).ToList();
        var a = new Activiteit
        {
            Titel = titel, Status = sn.Status, GemaaktOp = DateTime.Now, GemaaktDoor = Ik.WerknemerId, Opmaak = _metOpmaak,
            Volgorde = zelfde.Count > 0 ? zelfde.Max() + 1 : 0,          // snel aanmaken: onderaan het vak
        };
        if (sn.Lane != "geen") a.Problemen.Add(int.Parse(sn.Lane));
        // actieve filters op persoon en type worden overgenomen
        if (!_markeer && int.TryParse(_fWie, out var w) && _persoonOpId.ContainsKey(w)) a.Personen.Add(w);
        if (int.TryParse(_fType, out var t) && _data.Types.Any(x => x.Id == t)) a.Types.Add(t);
        if (ActStatus.Groep(a.Status) == ActStatus.GroepKlaar) a.GeslotenOp = a.GemaaktOp;
        if (!await Bewaar(async () => a.Id = await Repo.NieuweActiviteitAsync(_data.Board.Id, a, Ik.WerknemerId))) return;
        _data.Activiteiten.Add(a);
        await MeldToewijzing(a, a.Personen, nieuw: true);
        if (open)
        {
            OpenPaneel(a);
            _openNieuw = true;      // bij het sluiten melden als hij met deze filters niet te zien is (Verlaten)
            return;
        }
        Toon(Zichtbaar(a) ? $"\"{a.Titel}\" toegevoegd" : "Activiteit toegevoegd, maar met deze filters niet zichtbaar.");
    }

    // ================================================================ detailpaneel

    /// <summary>+ Activiteit: bovenaan Voorstel (code backlog), paneel open met de focus op de titel. Pas met een titel komt hij in de database.</summary>
    private void NieuweActiviteit()
    {
        if (_data is null) return;
        var idx = ProbIndex();
        var zelfde = _data.Activiteiten.Where(x => x.Status == ActStatus.Backlog && Lane(x, idx) == "geen").Select(x => x.Volgorde).ToList();
        var a = new Activiteit { Status = ActStatus.Backlog, GemaaktOp = DateTime.Now, GemaaktDoor = Ik.WerknemerId, Opmaak = _metOpmaak,
                                 Volgorde = zelfde.Count > 0 ? zelfde.Min() - 1 : 0 };
        if (_view == "mijn" && Ik.WerknemerId is int ik) a.Personen.Add(ik);
        if (_open is { } vorige) Verlaten(vorige);
        _open = a;
        _openNieuw = true;
        _titelVersie++; _tijdVersie++; _paneelVersie++;
        _focusNa = "#ab-dtitel";
    }

    private int _paneelVersie;      // telt op bij een andere activiteit in het paneel (sleutel van de velden)

    /// <summary>
    /// De activiteit in het paneel zetten. Staat er al een andere open, dan wisselt het paneel meteen (op een breed
    /// scherm staat het naast het bord en blijft het bord bruikbaar; wens gebruiker 19-11-2026). Wat in het vorige veld
    /// getypt was, is bij het verlaten van dat veld al bewaard (change komt voor de klik).
    /// </summary>
    private void OpenPaneel(Activiteit a)
    {
        _snel = null;
        if (_open is { } vorige)
        {
            // dezelfde nog eens aanklikken: laten staan, anders raakt een wijziging die nog onderweg is uit het paneel
            if (vorige.Id != 0 && vorige.Id == a.Id) { _focusNa = ".ab-drawer"; return; }
            Verlaten(vorige);
        }
        _open = a.Kopie();
        _kaartGekozen = a.Id;
        _openNieuw = false;
        _titelVersie++; _tijdVersie++; _paneelVersie++;
        _focusNa = ".ab-drawer";
    }

    /// <summary>Het paneel verlaat deze activiteit (dicht of een andere): een net gemaakte die nu niet te zien is, melden.</summary>
    private void Verlaten(Activiteit o)
    {
        if (o.Id == 0 || !_openNieuw) return;      // nieuw zonder titel: niet aangemaakt
        var a = _data?.Activiteiten.FirstOrDefault(x => x.Id == o.Id);
        if (a is not null && !Zichtbaar(a)) Toon("Activiteit toegevoegd, maar in deze weergave of met deze filters niet zichtbaar.");
    }

    private void SluitPaneel()
    {
        if (_open is null) return;
        var o = _open;
        _open = null;
        if (o.Id == 0) return;      // nieuw zonder titel: niet aangemaakt
        Verlaten(o);
        _focusKaart = o.Id;
    }

    private void PaneelToets(KeyboardEventArgs e) { if (e.Key == "Escape" && _modal is null) SluitPaneel(); }

    /// <summary>Esc terwijl de cursor niet in de pop-up staat (activityboard.js).</summary>
    [JSInvokable]
    public Task SluitPopup()
    {
        if (_open is not null && _modal is null) { SluitPaneel(); StateHasChanged(); }
        return Task.CompletedTask;
    }

    /// <summary>
    /// Klik op een lege plek van het board (activityboard.js): geen kaart meer gekozen, dus het paneel gaat dicht
    /// (wens gebruiker 19-11-2026). De focus gaat niet terug naar de kaart, anders lijkt hij nog gekozen.
    /// </summary>
    [JSInvokable]
    public Task LeegGeklikt()
    {
        if (_modal is not null || _menu is not null || (_open is null && _kaartGekozen is null)) return Task.CompletedTask;
        _kaartGekozen = null;
        if (_open is not null) { SluitPaneel(); _focusKaart = null; }
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// De wijziging ook in de lijst van het board zetten (kaart en tabellen tonen die). Met de activiteit erbij en niet
    /// via _open: tijdens het bewaren kan het paneel al naar een andere kaart gewisseld zijn. De plek in het vak komt
    /// uit de lijst (slepen van andere kaarten nummert het vak opnieuw terwijl het paneel open staat).
    /// </summary>
    private void SchrijfTerug(Activiteit o)
    {
        if (_data is null || o.Id == 0) return;
        var i = _data.Activiteiten.FindIndex(x => x.Id == o.Id);
        if (i < 0) return;
        var k = o.Kopie();
        k.Volgorde = _data.Activiteiten[i].Volgorde;
        _data.Activiteiten[i] = k;
    }

    private async Task TitelGewijzigd(ChangeEventArgs e)
    {
        if (_open is not { } o || _data is null) return;
        var titel = ((string?)e.Value ?? "").Trim();
        if (titel.Length == 0)
        {
            if (o.Id > 0) { _titelVersie++; Toon("Een activiteit heeft een titel nodig. De vorige titel is teruggezet.", fout: true); }
            return;
        }
        o.Titel = titel;
        if (o.Id == 0)
        {
            // nu pas aanmaken, met alles wat al gekozen is
            var a = o.Kopie();
            if (!await Bewaar(async () => a.Id = await Repo.NieuweActiviteitAsync(_data.Board.Id, a, Ik.WerknemerId))) return;
            o.Id = a.Id;
            _data.Activiteiten.Add(a);
            await MeldToewijzing(a, a.Personen, nieuw: true);
            return;
        }
        if (await Bewaar(() => Repo.ZetVeldAsync(o.Id, "Titel", titel, Ik.WerknemerId))) SchrijfTerug(o);
    }

    private async Task StatusGewijzigd(ChangeEventArgs e)
    {
        if (_open is not { } o) return;
        var st = (string?)e.Value ?? "";
        if (!ActStatus.IsGeldig(st) || st == o.Status) return;
        ZetStatus(o, st);
        if (o.Id == 0) return;
        if (await Bewaar(() => Repo.ZetStatusAsync(o.Id, o.Status, o.GeslotenOp, Ik.WerknemerId))) SchrijfTerug(o);
    }

    private async Task PrioKlik(int waarde)
    {
        if (_open is not { } o) return;
        o.Prioriteit = o.Prioriteit == waarde ? null : waarde;
        if (o.Id == 0) return;
        if (await Bewaar(() => Repo.ZetVeldAsync(o.Id, "Prioriteit", o.Prioriteit, Ik.WerknemerId))) SchrijfTerug(o);
    }

    private async Task Wissel(string soort, int id)
    {
        if (_open is not { } o) return;
        var lijst = soort == KoppelProblemen ? o.Problemen : soort == KoppelTypes ? o.Types : o.Personen;
        var erbij = !lijst.Remove(id);
        if (erbij) lijst.Add(id);
        if (o.Id == 0) return;
        if (!await Bewaar(() => Repo.ZetKoppelingenAsync(o.Id, soort, lijst.ToList(), Ik.WerknemerId))) return;
        SchrijfTerug(o);
        if (soort == KoppelPersonen && erbij) await MeldToewijzing(o, new[] { id }, nieuw: false);
    }

    private async Task VervalGewijzigd(ChangeEventArgs e)
    {
        if (_open is not { } o) return;
        o.Vervaldatum = DateTime.TryParseExact((string?)e.Value, "yyyy-MM-dd", null, System.Globalization.DateTimeStyles.None, out var d) ? d.Date : null;
        if (o.Id == 0) return;
        if (await Bewaar(() => Repo.ZetVeldAsync(o.Id, "Vervaldatum", o.Vervaldatum, Ik.WerknemerId))) SchrijfTerug(o);
    }

    private int _tijdVersie;
    // zonder het id: een nieuwe activiteit krijgt zijn id zodra de titel bewaard is, en dan mag dit vak de focus niet verliezen
    private string TijdSleutel => $"tijd-{_tijdVersie}";

    /// <summary>Benodigde tijd: uren, 1:30, 45m of 2d (zie ActTijd.Lees); leeg = geen tijd. Het vak toont daarna de uren.</summary>
    private async Task TijdGewijzigd(ChangeEventArgs e)
    {
        if (_open is not { } o) return;
        // "1:30" wordt vanzelf "1,5" (de waarde verandert). Verandert de waarde niet (onleesbaar, of "2u" bij 2), dan het
        // vak opnieuw maken zodat er weer staat wat bewaard is; alleen dan, want opnieuw maken kost de focus.
        if (!ActTijd.Lees((string?)e.Value, out var uren))
        {
            _tijdVersie++;
            Toon($"Die tijd begrijp ik niet. Typ uren (1,5), of 1:30, 45m, 2d; hooguit {ActTijd.Max:0} uur.", fout: true);
            return;
        }
        if (uren == o.BenodigdeUren) { _tijdVersie++; return; }
        o.BenodigdeUren = uren;
        if (o.Id == 0) return;
        if (await Bewaar(() => Repo.ZetVeldAsync(o.Id, "BenodigdeUren", uren, Ik.WerknemerId))) SchrijfTerug(o);
    }

    /// <summary>Een opgemaakt tekstveld als tekstvak openen, met de cursor achteraan.</summary>
    private void BewerkVeld(string kolom)
    {
        _bewerkVeld = kolom;
        _focusNa = $"eind:#ab-tx-{kolom}";
    }

    private async Task OpmaakGewijzigd(bool aan)
    {
        if (_open is not { } o || o.Opmaak == aan) return;
        o.Opmaak = aan;
        _bewerkVeld = null;
        if (o.Id == 0) return;
        if (await Bewaar(() => Repo.ZetOpmaakAsync(o.Id, aan, Ik.WerknemerId))) SchrijfTerug(o);
    }

    private async Task TekstGewijzigd(string kolom, ChangeEventArgs e)
    {
        if (_open is not { } o) return;
        var tekst = (string?)e.Value ?? "";
        if (tekst.Length == 0) o.Tekst.Remove(kolom); else o.Tekst[kolom] = tekst;
        if (o.Id == 0) return;
        if (await Bewaar(() => Repo.ZetVeldAsync(o.Id, kolom, tekst, Ik.WerknemerId))) SchrijfTerug(o);
    }

    // ---------------------------------------------------------------- koppelingen met andere kaartjes

    private bool _koppelNieuw;                               // het zoekvak om te koppelen staat open
    private int _koppelKeuze;                                // index in ActKoppelSoort.Keuzes
    private string _koppelZoek = "";
    private List<ActKoppelDoel> _koppelTreffers = new();

    /// <summary>
    /// Een vraagteken met de uitleg van een veld: de tekst komt in beeld als je erop wijst, erop klikt of er met Tab op
    /// komt (wens gebruiker 20-11-2026: minder tekst in de pop-up). Alleen opmaak, geen code: het wolkje is CSS.
    /// </summary>
    private static RenderFragment Uitleg(string tekst) => @<span class="ab-uitleg" tabindex="0" role="button" aria-label="Uitleg: @tekst">?<span class="ab-uitleg-tekst" role="tooltip">@tekst</span></span>;

    private string WachtTip(Activiteit a)
        => "Hangt af van " + string.Join(", ", a.Koppelingen.Where(k => k.Blokkeert).Select(k => $"#{k.AnderId} {k.AnderTitel} ({ActStatus.Naam(k.AnderStatus)})"));

    private void KaartKoppelOpen()
    {
        _koppelNieuw = true; _koppelZoek = ""; _koppelTreffers = new();
        _focusNa = "#ab-koppelzoek";
    }

    private async Task KaartKoppelZoek(ChangeEventArgs e)
    {
        _koppelZoek = (string?)e.Value ?? "";
        var z = _koppelZoek.Trim();
        if (_open is not { } o || (z.Length < 2 && !int.TryParse(z.TrimStart('#'), out _))) { _koppelTreffers = new(); return; }
        try
        {
            var gevonden = await Repo.ZoekActiviteitenAsync(z, 9);
            if (z != _koppelZoek.Trim()) return;      // er is intussen verder getypt
            _koppelTreffers = gevonden.Where(t => t.Id != o.Id).Take(8).ToList();
        }
        catch (Exception ex) { Toon("Zoeken mislukt: " + ex.Message, fout: true); }
    }

    private async Task KaartKoppelToets(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && _koppelTreffers.Count > 0) await KaartKoppel(_koppelTreffers[0]);
    }

    private async Task KaartKoppel(ActKoppelDoel doel)
    {
        if (_open is not { } o || _data is null || o.Id == 0) return;
        var keuze = ActKoppelSoort.Keuzes[Math.Clamp(_koppelKeuze, 0, ActKoppelSoort.Keuzes.Length - 1)];
        int id;
        try { id = keuze.Heen ? await Repo.NieuweKoppelingAsync(o.Id, doel.Id, keuze.Soort, Ik.WerknemerId) : await Repo.NieuweKoppelingAsync(doel.Id, o.Id, keuze.Soort, Ik.WerknemerId); }
        catch (InvalidOperationException ex) { Toon(ex.Message, fout: true); return; }
        catch (Exception ex) { Toon("Koppelen mislukt: " + ex.Message, fout: true); return; }
        if (!o.Koppelingen.Any(k => k.Id == id))
            o.Koppelingen.Add(new ActKoppeling(id, keuze.Soort, keuze.Heen, doel.Id, doel.Titel, doel.Status, doel.BoardId, doel.Board));
        _koppelNieuw = false; _koppelZoek = ""; _koppelTreffers = new();
        SchrijfTerug(o);
        Meld();
        // de andere kaart staat misschien op een ander board: ook daar verversen, en hier de andere kant bijwerken
        if (doel.BoardId != _data.Board.Id) Live.Meld(doel.BoardId, _sleutel, Ik.Naam);
        else await HerlaadAsync();
    }

    private async Task Ontkoppel(ActKoppeling k)
    {
        if (_open is not { } o || _data is null || !o.Koppelingen.Remove(k)) return;
        if (!await Bewaar(() => Repo.VerwijderKoppelingAsync(k.Id, Ik.WerknemerId))) return;
        SchrijfTerug(o);
        if (k.AnderBoardId != _data.Board.Id) Live.Meld(k.AnderBoardId, _sleutel, Ik.Naam);
        else await HerlaadAsync();
    }

    // ---------------------------------------------------------------- afvinklijst

    private int? _sleepPunt;                                 // de regel die gesleept wordt
    private int _puntVersie;                                 // telt op na een nieuw punt: de invoervakken worden dan leeg opnieuw gemaakt
    private readonly Dictionary<int, string> _nieuwPunt = new();   // wat er in "+ punt" staat, per kopje (0 = zonder kopje)

    private string PuntTip(ActPunt p)
        => p.Klaar && p.KlaarOp is DateTime op
            ? $"Afgevinkt{(p.KlaarDoor is int w && _persoonOpId.TryGetValue(w, out var wie) ? " door " + wie.Naam : "")} op {op:dd-MM-yyyy HH:mm}"
            : "";

    /// <summary>Een wijziging aan de lijst bewaren; mislukt het, dan laadt Bewaar het board (en de lijst) opnieuw.</summary>
    private async Task BewaarLijst(Activiteit o, Func<Task> doe)
    {
        if (await Bewaar(doe)) SchrijfTerug(o);
    }

    private async Task PuntKlaar(ActPunt p, bool klaar)
    {
        if (_open is not { } o || p.Klaar == klaar) return;
        p.Klaar = klaar; p.KlaarOp = klaar ? DateTime.Now : null; p.KlaarDoor = klaar ? Ik.WerknemerId : null;
        await BewaarLijst(o, () => Repo.ZetPuntKlaarAsync(p.Id, klaar, Ik.WerknemerId));
    }

    /// <summary>De tekst van een punt of kopje; leeggemaakt = weg ermee.</summary>
    private async Task PuntTekst(ActPunt p, ChangeEventArgs e)
    {
        if (_open is not { } o) return;
        var tekst = ((string?)e.Value ?? "").Trim();
        if (tekst.Length == 0) { await PuntWeg(p); return; }
        if (tekst == p.Tekst) return;
        p.Tekst = tekst;
        await BewaarLijst(o, () => Repo.ZetPuntTekstAsync(p.Id, tekst, Ik.WerknemerId));
    }

    private async Task PuntWeg(ActPunt p)
    {
        if (_open is not { } o || !o.Checklist.Remove(p)) return;
        await BewaarLijst(o, () => Repo.VerwijderPuntAsync(p.Id, Ik.WerknemerId));
    }

    private Task BewaarVolgorde(Activiteit o)
    {
        var ids = o.Checklist.Select(p => p.Id).ToList();
        return BewaarLijst(o, () => Repo.ZetPuntVolgordeAsync(o.Id, ids, Ik.WerknemerId));
    }

    /// <summary>Alt+pijl omhoog/omlaag: de regel een plek opschuiven.</summary>
    private async Task PuntToets(KeyboardEventArgs e, ActPunt p)
    {
        if (_open is not { } o || !e.AltKey || e.Key is not ("ArrowUp" or "ArrowDown")) return;
        var i = o.Checklist.IndexOf(p);
        var naar = e.Key == "ArrowUp" ? i - 1 : i + 1;
        if (i < 0 || naar < 0 || naar >= o.Checklist.Count) return;
        (o.Checklist[i], o.Checklist[naar]) = (o.Checklist[naar], o.Checklist[i]);
        await BewaarVolgorde(o);
    }

    /// <summary>Losgelaten op een regel: de gesleepte regel komt ervoor.</summary>
    private async Task PuntDrop(int doelId)
    {
        var sleep = _sleepPunt; _sleepPunt = null;
        if (_open is not { } o || sleep is not int id || id == doelId) return;
        var p = o.Checklist.FirstOrDefault(x => x.Id == id);
        if (p is null) return;
        o.Checklist.Remove(p);
        var plek = o.Checklist.FindIndex(x => x.Id == doelId);
        o.Checklist.Insert(plek < 0 ? o.Checklist.Count : plek, p);
        await BewaarVolgorde(o);
    }

    /// <summary>Losgelaten op "+ punt" van een groepje: de regel komt onderaan dat groepje (kopId 0 = zonder kopje).</summary>
    private async Task PuntDropEinde(int kopId)
    {
        var sleep = _sleepPunt; _sleepPunt = null;
        if (_open is not { } o || sleep is not int id || id == kopId) return;
        var p = o.Checklist.FirstOrDefault(x => x.Id == id);
        if (p is null) return;
        o.Checklist.Remove(p);
        o.Checklist.Insert(EindeVanGroep(o, kopId), p);
        await BewaarVolgorde(o);
    }

    /// <summary>De plek direct na het laatste punt van het groepje (kopId 0 = de punten zonder kopje, vooraan).</summary>
    private static int EindeVanGroep(Activiteit o, int kopId)
    {
        var start = kopId == 0 ? 0 : o.Checklist.FindIndex(x => x.Id == kopId) + 1;
        var volgende = o.Checklist.FindIndex(start, x => x.Kop);
        return volgende < 0 ? o.Checklist.Count : volgende;
    }

    private async Task NieuwPuntToets(KeyboardEventArgs e, int kopId)
    {
        if (e.Key != "Enter" || _open is not { } o || o.Id == 0) return;
        var tekst = _nieuwPunt.GetValueOrDefault(kopId, "").Trim();
        if (tekst.Length == 0) return;
        if (o.Checklist.Count >= ActPunt.MaxPerActiviteit) { Toon($"Een afvinklijst heeft hooguit {ActPunt.MaxPerActiviteit} regels.", fout: true); return; }
        var plek = EindeVanGroep(o, kopId);
        var p = new ActPunt { Tekst = tekst.Length > ActPunt.MaxTekst ? tekst[..ActPunt.MaxTekst] : tekst };
        int? na = plek == 0 ? 0 : o.Checklist[plek - 1].Id;
        o.Checklist.Insert(plek, p);
        _nieuwPunt.Remove(kopId);
        _puntVersie++;                       // het vak leeg opnieuw maken, en de cursor er weer in
        _focusNa = $"#ab-pn-{kopId}";
        if (!await Bewaar(() => Repo.NieuwPuntAsync(o.Id, p, na, Ik.WerknemerId))) return;
        SchrijfTerug(o);
    }

    private async Task NieuwKopje()
    {
        if (_open is not { } o || o.Id == 0) return;
        if (o.Checklist.Count >= ActPunt.MaxPerActiviteit) { Toon($"Een afvinklijst heeft hooguit {ActPunt.MaxPerActiviteit} regels.", fout: true); return; }
        var n = o.Checklist.Count(x => x.Kop) + 1;
        var p = new ActPunt { Kop = true, Tekst = $"Kopje {n}" };
        o.Checklist.Add(p);
        if (!await Bewaar(() => Repo.NieuwPuntAsync(o.Id, p, null, Ik.WerknemerId))) return;
        SchrijfTerug(o);
        _focusNa = $"#ab-pk-{p.Id}";         // de naam staat geselecteerd: meteen overtypen
    }

    /// <summary>Verwijderen zonder vraag vooraf, met ongedaan maken (aanname A3): de kopie komt terug als nieuwe regel.</summary>
    private async Task VerwijderOpen()
    {
        if (_open is not { } o || _data is null) return;
        _open = null;
        await Verwijder(o);
    }

    /// <summary>Vanuit het paneel of het rechtermuismenu; staat de activiteit in het paneel, dan gaat dat dicht.</summary>
    private async Task Verwijder(Activiteit o)
    {
        if (_data is null || o.Id == 0) return;
        if (_open?.Id == o.Id) _open = null;
        if (_kaartGekozen == o.Id) _kaartGekozen = null;
        var kopie = o.Kopie();
        if (!await Bewaar(() => Repo.VerwijderActiviteitAsync(o.Id))) return;
        _data.Activiteiten.RemoveAll(x => x.Id == o.Id);
        Toon($"\"{o.Titel}\" verwijderd", ongedaan: async () =>
        {
            if (_data is null) return;
            var terug = kopie.Kopie();
            terug.Problemen = terug.Problemen.Where(id => _data.Problemen.Any(p => p.Id == id)).ToList();
            terug.Types = terug.Types.Where(id => _data.Types.Any(t => t.Id == id)).ToList();
            if (!await Bewaar(async () => terug.Id = await Repo.NieuweActiviteitAsync(_data.Board.Id, terug, Ik.WerknemerId))) return;
            _data.Activiteiten.Add(terug);
            Toon($"\"{terug.Titel}\" is terug");
        });
    }

    // ================================================================ export

    private static string CsvVeld(string v)
    {
        if (v.Length > 0 && "=+-@\t\r".Contains(v[0])) v = "'" + v;    // geen formules in Excel (spec §7)
        return v.IndexOfAny(new[] { '"', ';', '\r', '\n' }) >= 0 ? "\"" + v.Replace("\"", "\"\"") + "\"" : v;
    }

    private async Task NaarExcel()
    {
        if (_data is null) return;
        var idx = ProbIndex();
        var kop = new[] { "Board", "Activiteit", "Status", "Prioriteit", "Type", "Onderwerpen (op prioriteit)", "Baan op bord",
                          "Toegewezen aan", "Vervaldatum", "Gemaakt op", "Dagen open", "Benodigde tijd (uur)", "Initiator" };
        var regels = new List<string> { string.Join(";", kop.Select(CsvVeld)) };
        foreach (var a in _data.Activiteiten.OrderByDescending(x => x.GemaaktOp))
        {
            var lane = Lane(a, idx);
            regels.Add(string.Join(";", new[]
            {
                _data.Board.Titel, a.Titel, ActStatus.Naam(a.Status), ActPrioriteit.Naam(a.Prioriteit),
                string.Join(", ", a.Types.Select(t => _data.Types.FirstOrDefault(x => x.Id == t)?.Naam).Where(n => n is not null)),
                string.Join(", ", ProblemenGesorteerd(a, idx).Select(id => $"{idx[id] + 1}. {ProbNaam(id)}")),
                lane == "geen" ? "Geen onderwerp" : ProbNaam(int.Parse(lane)),
                string.Join(", ", a.Personen.Where(_persoonOpId.ContainsKey).Select(p => _persoonOpId[p].Naam)),
                a.Vervaldatum?.ToString("dd-MM-yyyy") ?? "", a.GemaaktOp.ToString("dd-MM-yyyy"), a.DagenOpen?.ToString() ?? "",
                ActTijd.Invoer(a.BenodigdeUren),
                a.GemaaktDoor is int maker && _persoonOpId.TryGetValue(maker, out var mp) ? mp.Naam : "",
            }.Select(CsvVeld)));
        }
        var tekst = "﻿" + string.Join("\r\n", regels);
        var naam = System.Text.RegularExpressions.Regex.Replace(_data.Board.Titel, @"[^\w-]+", "_").Trim('_');
        try
        {
            await JS.InvokeVoidAsync("mdeBestand.download",
                $"MDE_Activity_Board_{(naam.Length > 0 ? naam + "_" : "")}{DateTime.Today:yyyy-MM-dd}.csv",
                System.Text.Encoding.UTF8.GetBytes(tekst));
        }
        catch (Exception ex) { Toon("Downloaden mislukt: " + ex.Message, fout: true); }
    }

    // ================================================================ melding en bevestiging

    private async Task ModalJa()
    {
        var m = _modal; _modal = null;
        if (m is not null) await m.Doe();
    }

    private async Task Ongedaan()
    {
        var t = _toast; _toast = null;
        if (t?.Ongedaan is { } doe) await doe();
    }

    /// <summary>Melding onderin: 6,5 s met de knop Ongedaan maken, anders 3,2 s (spec §5).</summary>
    private void Toon(string tekst, bool fout = false, Func<Task>? ongedaan = null)
    {
        _toastStop?.Cancel();
        var stop = _toastStop = new CancellationTokenSource();
        _toast = new Toast(tekst, fout, ongedaan);
        _ = Task.Delay(ongedaan is null ? 3200 : 6500, stop.Token).ContinueWith(t =>
        {
            if (t.IsCanceled) return;
            _ = InvokeAsync(() => { if (_toastStop == stop) { _toast = null; StateHasChanged(); } });
        }, TaskScheduler.Default);
    }

    private void InvoerEnterBlur(KeyboardEventArgs e)
    {
        // Enter in een naamveld: bevestigen (de change komt bij het verlaten van het veld)
        if (e.Key == "Enter") _focusNa = "#ab-probnieuw";
    }
