        var n = d.Activiteiten.Count;
        _modal = new Modal("Board wissen?",
            $"\"{d.Board.Titel}\" wordt gewist met {d.Problemen.Count} onderwerp{(d.Problemen.Count == 1 ? "" : "en")}, " +
