    // ================================================================ export

    private static string CsvVeld(string v)
    {
        if (v.Length > 0 && "=+-@\t\r".Contains(v[0])) v = "'" + v;    // geen formules in Excel (spec §7)
        return v.IndexOfAny(new[] { '"', ';', '\r', '\n' }) >= 0 ? "\"" + v.Replace("\"", "\"\"") + "\"" : v;
    }

    private async Task NaarExcel()
    {
        if (_data is null) return;
        var idx = ProbIndex();
        var kop = new[] { "Board", "Activiteit", "Status", "Prioriteit", "Type", "Onderwerpen (op prioriteit)", "Baan op bord",
                          "Toegewezen aan", "Vervaldatum", "Gemaakt op", "Dagen open" };
        var regels = new List<string> { string.Join(";", kop.Select(CsvVeld)) };
        foreach (var a in _data.Activiteiten.OrderByDescending(x => x.GemaaktOp))
        {
            var lane = Lane(a, idx);
            regels.Add(string.Join(";", new[]
            {
                _data.Board.Titel, a.Titel, ActStatus.Naam(a.Status), ActPrioriteit.Naam(a.Prioriteit),
                string.Join(", ", a.Types.Select(t => _data.Types.FirstOrDefault(x => x.Id == t)?.Naam).Where(n => n is not null)),
                string.Join(", ", ProblemenGesorteerd(a, idx).Select(id => $"{idx[id] + 1}. {ProbNaam(id)}")),
                lane == "geen" ? "Geen onderwerp" : ProbNaam(int.Parse(lane)),
                string.Join(", ", a.Personen.Where(_persoonOpId.ContainsKey).Select(p => _persoonOpId[p].Naam)),
                a.Vervaldatum?.ToString("dd-MM-yyyy") ?? "", a.GemaaktOp.ToString("dd-MM-yyyy"), a.DagenOpen?.ToString() ?? "",
            }.Select(CsvVeld)));
        }
        var tekst = "﻿" + string.Join("\r\n", regels);
        var naam = System.Text.RegularExpressions.Regex.Replace(_data.Board.Titel, @"[^\w-]+", "_").Trim('_');
        try
        {
            await JS.InvokeVoidAsync("mdeBestand.download",
                $"MDE_Activity_Board_{(naam.Length > 0 ? naam + "_" : "")}{DateTime.Today:yyyy-MM-dd}.csv",
                System.Text.Encoding.UTF8.GetBytes(tekst));
        }
        catch (Exception ex) { Toon("Downloaden mislukt: " + ex.Message, fout: true); }
    }

