            await s.CopyToAsync(m);
            var ext = soort.ToLowerInvariant() switch { "image/jpeg" or "image/jpg" => ".jpg", "image/gif" => ".gif", "image/webp" => ".webp", _ => ".png" };
            await InvokeAsync(async () => { await BewaarBijlage(id, m.ToArray(), $"plaatje {DateTime.Now:yyyy-MM-dd HHmmss}{ext}"); StateHasChanged(); });
