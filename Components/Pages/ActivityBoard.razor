    // ================================================================ startscherm

    private void NaarBoard(int id) => Nav.NavigateTo($"activityboard/{id}");

    private IEnumerable<ActBoardRegel> BoardsGefilterd
        => (_boards ?? new()).Where(b => _boardSoort.Length == 0 || b.Soort == _boardSoort);

    // ---- boom op het startscherm ----
    private bool _boom = true;                   // onthouden per pc (mdeOpslag "ab-weergave")
    private string _boomZoek = "";
    private readonly HashSet<string> _boomOpen = new();
    private bool _weergaveGelezen;

    private sealed class BoomKnoop
    {
        public string Sleutel = "", Soort = "", Label = "", Sub = "";
        public ActBoardRegel? Board;
        public List<BoomKnoop> Kinderen = new();
        public IEnumerable<ActBoardRegel> AlleBoards() => (Board is null ? Enumerable.Empty<ActBoardRegel>() : new[] { Board })
            .Concat(Kinderen.SelectMany(k => k.AlleBoards()));
    }

    private async Task ZetBoom(bool boom)
    {
        _boom = boom;
        try { await JS.InvokeVoidAsync("mdeOpslag.schrijf", "ab-weergave", boom ? "boom" : "lijst"); } catch { }
    }

    private void AllesUit()
    {
        void Open(BoomKnoop k) { if (k.Kinderen.Count > 0) _boomOpen.Add(k.Sleutel); k.Kinderen.ForEach(Open); }
        Boom().ForEach(Open);
    }

    /// <summary>De boom uit de (gefilterde) boards; alleen takken met een board, en bij zoeken alleen wat past.</summary>
    private List<BoomKnoop> Boom()
    {
        var knopen = new Dictionary<string, BoomKnoop>();
        var wortels = new List<BoomKnoop>();
        BoomKnoop Haal(string sleutel, string soort, string label, string sub, BoomKnoop? ouder)
        {
            if (!knopen.TryGetValue(sleutel, out var k))
            {
                k = knopen[sleutel] = new BoomKnoop { Sleutel = sleutel, Soort = soort, Label = label, Sub = sub };
                (ouder?.Kinderen ?? wortels).Add(k);
            }
            return k;
        }
        BoomKnoop KlantKnoop(int? id, string naam) => id is int k
            ? Haal($"k{k}", ActBoardSoort.Klant, naam.Length > 0 ? naam : $"Klant #{k}", "", null)
            : Haal("k-", "groep", "Zonder klant", "", null);

        foreach (var b in BoardsGefilterd)
        {
            switch (b.Soort)
            {
                case ActBoardSoort.Klant:
                    KlantKnoop(b.RelatieId, b.RelatieNaam).Board = b;
                    break;
                case ActBoardSoort.Project:
                    Haal($"p{b.ProjectId}", ActBoardSoort.Project, $"{b.ProjectNummer}", b.ProjectNaam, KlantKnoop(b.KlantId, b.KlantNaam)).Board = b;
                    break;
                case ActBoardSoort.Werkorder:
                {
                    var ouder = b.HoofdProjectId is int hp
                        ? Haal($"p{hp}", ActBoardSoort.Project, $"{b.HoofdProjectNummer}", b.HoofdProjectNaam, KlantKnoop(b.KlantId, b.KlantNaam))
                        : KlantKnoop(b.KlantId, b.KlantNaam);
                    if (b.OuderWerkorderId is int ow)
                        ouder = Haal($"w{ow}", ActBoardSoort.Werkorder, b.OuderWerkorderNummer, b.OuderWerkorderNaam, ouder);
                    Haal($"w{b.WerkorderId}", ActBoardSoort.Werkorder, b.WerkorderNummer, b.WerkorderNaam, ouder).Board = b;
                    break;
                }
                default:
                    Haal($"b{b.BoardId}", ActBoardSoort.Vrij, b.Titel, "", Haal("vrij", "groep", "Vrije boards", "", null)).Board = b;
                    break;
            }
        }

        // zoeken: een knoop blijft als hij zelf past of iets eronder past; past hij zelf, dan alles eronder
        var woorden = _boomZoek.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        bool Past(BoomKnoop k) => woorden.All(w => $"{k.Label} {k.Sub} {k.Board?.Titel}".Contains(w, StringComparison.OrdinalIgnoreCase));
        List<BoomKnoop> Filter(List<BoomKnoop> lijst) => lijst
            .Select(k => Past(k) ? k : new BoomKnoop { Sleutel = k.Sleutel, Soort = k.Soort, Label = k.Label, Sub = k.Sub, Board = k.Board, Kinderen = Filter(k.Kinderen) })
            .Where(k => Past(k) || k.Kinderen.Count > 0).ToList();
        var uit = woorden.Length == 0 ? wortels : Filter(wortels);

        // volgorde: klanten op naam (zonder klant en vrije boards achteraan), projecten nieuwste eerst, werkorders op nummer
        void Sorteer(List<BoomKnoop> l)
        {
            l.Sort((a, b) =>
            {
                int Rang(BoomKnoop k) => k.Sleutel == "vrij" ? 3 : k.Sleutel == "k-" ? 2 : 1;
                var r = Rang(a).CompareTo(Rang(b));
                if (r != 0) return r;
                if (a.Soort == ActBoardSoort.Project && b.Soort == ActBoardSoort.Project)
                    return string.Compare(b.Label, a.Label, StringComparison.OrdinalIgnoreCase);
                return string.Compare(a.Label, b.Label, StringComparison.OrdinalIgnoreCase);
            });
            l.ForEach(k => Sorteer(k.Kinderen));
        }
        Sorteer(uit);
        return uit;
    }

    /// <summary>Eén regel van de boom met zijn kinderen; uitgeklapt als hij open staat of als er gezocht wordt.</summary>
    private RenderFragment Knoop(BoomKnoop k, int diepte) => __builder =>
    {
        var open = _boomZoek.Trim().Length > 0 || _boomOpen.Contains(k.Sleutel);
        var boards = k.AlleBoards().ToList();
        var eigen = k.Board;
        <li class="ab-boomknoop" @key="k.Sleutel">
            <div class="ab-boomregel @(eigen is not null ? "met-board" : "")" style="padding-left:@((diepte * 1.25 + .3).ToString(System.Globalization.CultureInfo.InvariantCulture))rem">
                @if (k.Kinderen.Count > 0)
                {
                    <button type="button" class="ab-boomcaret @(open ? "open" : "")" aria-label="@(open ? "Inklappen" : "Uitklappen")"
                            @onclick="() => { if (!_boomOpen.Remove(k.Sleutel)) _boomOpen.Add(k.Sleutel); }">▸</button>
                }
                else
                {
                    <span class="ab-boomcaret leeg"></span>
                }
                @if (k.Soort != "groep") { <span class="ab-soort ab-soort-@k.Soort">@ActBoardSoort.Naam(k.Soort)</span> }
                @if (eigen is not null)
                {
                    <button type="button" class="ab-boomnaam link" title="Board openen" @onclick="() => NaarBoard(eigen.BoardId)">
                        <b>@k.Label</b>@if (k.Sub.Length > 0) { <span> · @k.Sub</span> }@if (eigen.Naam.Length > 0 && eigen.Soort != ActBoardSoort.Vrij) { <small class="ab-muted"> (@eigen.Naam)</small> }
                    </button>
                    <span class="ab-boomtel">@eigen.Open open · @eigen.Klaar klaar</span>
                }
                else
                {
                    <span class="ab-boomnaam ab-boomgroep" @onclick="() => { if (!_boomOpen.Remove(k.Sleutel)) _boomOpen.Add(k.Sleutel); }">
                        <b>@k.Label</b>@if (k.Sub.Length > 0) { <span> · @k.Sub</span> }
                    </span>
                }
                @if (k.Kinderen.Count > 0)
                {
                    <span class="ab-muted ab-boomsom">@boards.Count board@(boards.Count == 1 ? "" : "s") · @boards.Sum(x => x.Open) open</span>
                }
            </div>
            @if (open && k.Kinderen.Count > 0)
            {
                <ul class="ab-boom">
                    @foreach (var kind in k.Kinderen) { @Knoop(kind, diepte + 1) }
                </ul>
            }
        </li>
    };

    /// <summary>Zoeken naar een project of klant, of een naam voor een vrij board; op het startscherm of bij Koppelen.</summary>
    private RenderFragment ZoekVak(bool koppelen) => @<div class="ab-zoekvak">
        @if (_soorten)
        {
            <div class="ab-soortkeuze">
                <button type="button" class="ab-vtab @(_zoekSoort == ActBoardSoort.Project ? "actief" : "")" @onclick="() => KiesZoekSoort(ActBoardSoort.Project)">Project</button>
                @if (_metWerkorder)
                {
                    <button type="button" class="ab-vtab @(_zoekSoort == ActBoardSoort.Werkorder ? "actief" : "")" @onclick="() => KiesZoekSoort(ActBoardSoort.Werkorder)">Werkorder</button>
                }
                <button type="button" class="ab-vtab @(_zoekSoort == ActBoardSoort.Klant ? "actief" : "")" @onclick="() => KiesZoekSoort(ActBoardSoort.Klant)">Klant</button>
                @if (!koppelen)
                {
                    <button type="button" class="ab-vtab @(_zoekSoort == ActBoardSoort.Vrij ? "actief" : "")" @onclick="() => KiesZoekSoort(ActBoardSoort.Vrij)">Vrij board</button>
                }
            </div>
        }
        @if (_zoekSoort == ActBoardSoort.Vrij)
        {
            <div class="ab-padd ab-vrij">
                <input id="ab-zoek" placeholder="Naam van het nieuwe board…" value="@_zoek" autocomplete="off" aria-label="Naam vrij board"
                       @oninput="e => _zoek = (string?)e.Value ?? string.Empty" @onkeydown="VrijToets" />
                <button class="ab-btn klein" type="button" @onclick="MaakVrijBoard">Maken</button>
            </div>
        }
        else
        {
            <div class="ab-padd ab-vrij">
                <input id="ab-zoek" placeholder="@(_zoekSoort == ActBoardSoort.Klant ? "Naam van de klant…" : _zoekSoort == ActBoardSoort.Werkorder ? "Werkordernummer, omschrijving of klant…" : "Projectnummer of omschrijving…")"
                       value="@_zoek" autocomplete="off" aria-label="Zoeken" @oninput="ZoekGewijzigd" />
            </div>
            @if (_treffers.Count > 0)
            {
                <div class="ab-treffers">
                    @foreach (var tr in _treffers)
                    {
                        <button type="button" class="ab-treffer" @key="tr.Id" @onclick="() => Gekozen(tr.Id, koppelen)">
                            @if (tr.Nummer.Length > 0) { <span class="ab-mono">@tr.Nummer</span> }@tr.Naam
                        </button>
                    }
                </div>
            }
            else if (_zoek.Trim().Length >= 2 && !_zoekt)
            {
                <p class="ab-leeg">@(_zoekSoort == ActBoardSoort.Klant ? "Geen klant gevonden." : _zoekSoort == ActBoardSoort.Werkorder ? "Geen werkorder gevonden." : "Geen project gevonden.")</p>
            }
        }
    </div>;

    private void KiesZoekSoort(string soort)
    {
        if (_zoekSoort == soort) return;
        _zoekSoort = soort;
        _zoek = "";
        _treffers = new();
        _zoekStop?.Cancel();
        _focusNa = "#ab-zoek";
    }

    private async Task ZoekGewijzigd(ChangeEventArgs e)
    {
        _zoek = (string?)e.Value ?? "";
        _zoekStop?.Cancel();
        var stop = _zoekStop = new CancellationTokenSource();
        var q = _zoek.Trim();
        var soort = _zoekSoort;
        if (q.Length < 2) { _treffers = new(); return; }
        _zoekt = true;
        try
        {
            await Task.Delay(250, stop.Token);
            List<Treffer> gevonden = soort == ActBoardSoort.Klant
                ? (await Relaties.ZoekAsync(q, alleenKlanten: true, alleenLeveranciers: false, 0, 15)).Select(k => new Treffer(k.Id, "", k.Naam)).ToList()
                : soort == ActBoardSoort.Werkorder
                ? (await Uren.ZoekWerkordersAsync(q, alleenOpen: false, 15))
                    .Select(w => new Treffer(w.WerkbonId, w.Nummer, w.Omschrijving + (w.Klant.Length > 0 ? " · " + w.Klant : ""))).ToList()
                : (await Projecten.ZoekProjectenAsync(null, q, null, 0, 15)).Select(p => new Treffer(p.Id, p.Nummer?.ToString() ?? "", p.Omschrijving)).ToList();
            if (!stop.IsCancellationRequested) _treffers = gevonden;
        }
        catch (TaskCanceledException) { return; }
        catch (Exception ex) { Toon("Zoeken mislukt: " + ex.Message, fout: true); }
        if (!stop.IsCancellationRequested) _zoekt = false;
    }

    /// <summary>Een treffer gekozen: het board van dat project of die klant openen (of maken), of dit board eraan koppelen.</summary>
    private async Task Gekozen(int id, bool koppelen)
    {
        if (koppelen)
        {
            await Koppel(_zoekSoort == ActBoardSoort.Project ? id : null, _zoekSoort == ActBoardSoort.Klant ? id : null,
                         _zoekSoort == ActBoardSoort.Werkorder ? id : null);
            return;
        }
        try
        {
            var board = _zoekSoort == ActBoardSoort.Klant ? await Repo.ZorgVoorKlantBoardAsync(id, Ik.WerknemerId)
                      : _zoekSoort == ActBoardSoort.Werkorder ? await Repo.ZorgVoorWerkorderBoardAsync(id, Ik.WerknemerId)
                      : await Repo.ZorgVoorBoardAsync(id, Ik.WerknemerId);
            _zoek = ""; _treffers = new();
            Nav.NavigateTo($"activityboard/{board}");
        }
        catch (Exception ex) { Toon("Board openen mislukt: " + ex.Message, fout: true); }
    }

    private async Task VrijToets(KeyboardEventArgs e) { if (e.Key == "Enter") await MaakVrijBoard(); }

    private async Task MaakVrijBoard()
    {
        var naam = _zoek.Trim();
        if (naam.Length == 0) { Toon("Typ eerst een naam voor het board", fout: true); _focusNa = "#ab-zoek"; return; }
        try
        {
            var id = await Repo.NieuwVrijBoardAsync(naam, Ik.WerknemerId);
            _zoek = "";
            Nav.NavigateTo($"activityboard/{id}");
        }
        catch (Exception ex) { Toon("Board maken mislukt: " + ex.Message, fout: true); }
    }

    // ---- naam en koppeling van het open board ----

    private string BordNaamSleutel => $"bordnaam-{_data?.Board.Id}-{_bordNaamVersie}";

    private async Task HernoemBoard(ChangeEventArgs e)
    {
        if (_data is null) return;
        var naam = ((string?)e.Value ?? "").Trim();
        // de standaardnaam (project of klant) is geen eigen naam; een vrij board houdt altijd een naam
        var standaard = _data.Board.ProjectNummer is null ? _data.Board.StandaardTitel : _data.Board.ProjectNaam;
        if (naam == standaard && _data.Board.Soort != ActBoardSoort.Vrij) naam = "";
        if (naam.Length == 0 && _data.Board.Soort == ActBoardSoort.Vrij)
        { _bordNaamVersie++; Toon("Een vrij board heeft een naam nodig", fout: true); return; }
        if (naam == _data.Board.Naam) { _bordNaamVersie++; return; }
        if (!await Bewaar(() => Repo.HernoemBoardAsync(_data.Board.Id, naam))) return;
        _data.Board = _data.Board with { Naam = naam };
        _bordNaamVersie++;
        Toon(naam.Length > 0 ? "Board hernoemd" : "Board heet weer naar " + (_data.Board.Soort == ActBoardSoort.Klant ? "de klant"
             : _data.Board.Soort == ActBoardSoort.Werkorder ? "de werkorder" : "het project"));
    }

    private void OpenKoppel()
    {
        _koppelOpen = true;
        _zoekSoort = _data?.Board.Soort is ActBoardSoort.Klant or ActBoardSoort.Werkorder ? _data.Board.Soort : ActBoardSoort.Project;
        _zoek = ""; _treffers = new();
        _focusNa = "#ab-zoek";
    }

    private void KoppelToets(KeyboardEventArgs e) { if (e.Key == "Escape") _koppelOpen = false; }

    private async Task Koppel(int? projectId, int? relatieId, int? werkorderId = null)
    {
        if (_data is null) return;
        string? fout = null;
        if (!await Bewaar(async () => fout = await Repo.KoppelBoardAsync(_data.Board.Id, projectId, relatieId, werkorderId))) return;
        if (fout is not null) { Toon(fout, fout: true); return; }
        _koppelOpen = false;
        await HerlaadAsync();
        _bordNaamVersie++;
        Toon("Board gekoppeld aan " + (werkorderId is not null ? "werkorder " : projectId is not null ? "project " : "klant ") + _data?.Board.StandaardTitel);
    }

    /// <summary>Geen project of klant meer. Zonder eigen naam krijgt het board de naam die het nu toont.</summary>
    private async Task Losmaken()
    {
        if (_data is null) return;
        var titel = _data.Board.Titel;
        if (_data.Board.Naam.Length == 0 && !await Bewaar(() => Repo.HernoemBoardAsync(_data.Board.Id, titel))) return;
        await Koppel(null, null);
        Toon("Board losgemaakt; het is nu een vrij board met de naam \"" + titel + "\"");
    }

    // ================================================================ live

    private void OpLive(int boardId, Guid bron, string door)
    {
        if (bron == _sleutel || _data is null || boardId != _data.Board.Id) return;
        _ = InvokeAsync(async () =>
        {
            if (_sleept) { _herladen = true; return; }
            await HerlaadAsync();
            StateHasChanged();
        });
    }

    /// <summary>Het board opnieuw uit de database; het open detailpaneel houdt titel en tekst die je aan het typen bent.</summary>
    private async Task HerlaadAsync()
    {
        if (_data is null) return;
        try
        {
            var vers = await Repo.LaadAsync(_data.Board.Id);
            if (vers is null) { _data = null; _laadFout = "Dit board is verwijderd."; _open = null; return; }
            _data = vers;
            await LaadBijlagen();
            if (_open is { Id: > 0 } o)
            {
                var a = vers.Activiteiten.FirstOrDefault(x => x.Id == o.Id);
                if (a is null) { _open = null; Toon("Deze activiteit is door een collega verwijderd."); }
                else
                {
                    o.Status = a.Status; o.Prioriteit = a.Prioriteit; o.Vervaldatum = a.Vervaldatum; o.GeslotenOp = a.GeslotenOp;
                    o.Problemen = new(a.Problemen); o.Types = new(a.Types); o.Personen = new(a.Personen);
                }
            }
            if (_typeHernoem is int t && !vers.Types.Any(x => x.Id == t)) _typeHernoem = null;
            ValideerFilters();
        }
        catch (Exception ex) { Toon("Verversen mislukt: " + ex.Message, fout: true); }
    }

    private void Meld() { if (_data is not null) Live.Meld(_data.Board.Id, _sleutel, Ik.Naam); }

    /// <summary>Een eigen wijziging naar de database; lukt het niet, dan melden en het board opnieuw laden.</summary>
    private async Task<bool> Bewaar(Func<Task> doe)
    {
        try { await doe(); Meld(); return true; }
        catch (Exception ex)
        {
            Toon("Opslaan mislukt: " + ex.Message, fout: true);
            await HerlaadAsync();
            return false;
        }
    }

    // ================================================================ rekenregels

    private Dictionary<int, int> ProbIndex()
    {
        var idx = new Dictionary<int, int>();
        if (_data is null) return idx;
        for (var i = 0; i < _data.Problemen.Count; i++) idx[_data.Problemen[i].Id] = i;
        return idx;
    }

    /// <summary>De baan: het gekoppelde probleem met de hoogste prioriteit, anders "geen".</summary>
    private static string Lane(Activiteit a, Dictionary<int, int> idx)
    {
        int? best = null; var bi = int.MaxValue;
        foreach (var id in a.Problemen)
            if (idx.TryGetValue(id, out var i) && i < bi) { bi = i; best = id; }
        return best?.ToString() ?? "geen";
    }

    private static List<int> ProblemenGesorteerd(Activiteit a, Dictionary<int, int> idx)
        => a.Problemen.Where(idx.ContainsKey).OrderBy(id => idx[id]).ToList();

    private static int OpVolgorde(Activiteit x, Activiteit y)
        => x.Volgorde != y.Volgorde ? x.Volgorde.CompareTo(y.Volgorde) : x.GemaaktOp.CompareTo(y.GemaaktOp);

    private Dictionary<int, (int Open, int Klaar)> TelPerProbleem()
    {
        var t = new Dictionary<int, (int Open, int Klaar)>();
        if (_data is null) return t;
        foreach (var p in _data.Problemen) t[p.Id] = (0, 0);
        foreach (var a in _data.Activiteiten)
            foreach (var id in a.Problemen)
                if (t.TryGetValue(id, out var x))
                    t[id] = ActStatus.Groep(a.Status) == ActStatus.GroepKlaar ? (x.Open, x.Klaar + 1) : (x.Open + 1, x.Klaar);
        return t;
    }

    private bool FiltersActief => _fProb.Length > 0 || _fWie.Length > 0 || _fType.Length > 0 || _fQ.Trim().Length > 0;

    private void WisFilters() { _fProb = ""; _fWie = ""; _fType = ""; _fQ = ""; }

    /// <summary>Een filter dat naar iets verwijderds wijst, wordt gewist (spec §5).</summary>
    private void ValideerFilters()
    {
        if (_data is null) return;
        if (_fProb.Length > 0 && _fProb != "geen" && !_data.Problemen.Any(p => p.Id.ToString() == _fProb)) _fProb = "";
        if (_fType.Length > 0 && !_data.Types.Any(t => t.Id.ToString() == _fType)) _fType = "";
        if (_fWie.Length > 0 && _fWie != "niemand" && !_persoonOpId.ContainsKey(int.TryParse(_fWie, out var w) ? w : -1)) _fWie = "";
    }

    private List<Activiteit> Gefilterd(Dictionary<int, int> idx)
    {
        if (_data is null) return new();
        var q = _fQ.Trim();
        return _data.Activiteiten.Where(a =>
        {
            if (_fProb == "geen" && Lane(a, idx) != "geen") return false;
            if (_fProb.Length > 0 && _fProb != "geen" && !a.Problemen.Any(p => p.ToString() == _fProb)) return false;
            if (_fWie == "niemand" && a.Personen.Count > 0) return false;
            if (_fWie.Length > 0 && _fWie != "niemand" && !a.Personen.Any(p => p.ToString() == _fWie)) return false;
            if (_fType.Length > 0 && !a.Types.Any(t => t.ToString() == _fType)) return false;
            if (q.Length > 0 && !a.Titel.Contains(q, StringComparison.OrdinalIgnoreCase)) return false;
            return true;
        }).ToList();
    }

    /// <summary>Staat deze activiteit in de huidige weergave met de huidige filters?</summary>
    private bool Zichtbaar(Activiteit a)
    {
        if (_data is null) return false;
        if (!Gefilterd(ProbIndex()).Any(x => x.Id == a.Id)) return false;
        if (_view == "mijn") return Ik.WerknemerId is int ik && a.Personen.Contains(ik);
        if (_view == "voltooid") return ActStatus.Groep(a.Status) == ActStatus.GroepKlaar;
        return true;
    }

    /// <summary>Personen in de filter: alleen echte personen die in dienst zijn (`Uit dienst` = nee, `Persoon` = ja).</summary>
    private IEnumerable<ActPersoon> FilterPersonen() => _personen.Where(p => p.Kiesbaar);

    private int _persoonKiesVersie;
    private string PersoonKiesSleutel => $"pk-{_open?.Id}-{_persoonKiesVersie}";

    /// <summary>Persoon uit de keuzelijst toevoegen; de lijst springt daarna terug op "+ persoon toevoegen…".</summary>
    private async Task PersoonGekozen(ChangeEventArgs e)
    {
        _persoonKiesVersie++;
        if (_open is null || !int.TryParse((string?)e.Value, out var id) || _open.Personen.Contains(id)) return;
        await Wissel(KoppelPersonen, id);
    }

    private static void ZetStatus(Activiteit a, string nieuw)
    {
        var oud = ActStatus.Groep(a.Status);
        a.Status = nieuw;
        var g = ActStatus.Groep(nieuw);
        if (g == ActStatus.GroepKlaar && oud != ActStatus.GroepKlaar) a.GeslotenOp = DateTime.Now;
        if (g != ActStatus.GroepKlaar) a.GeslotenOp = null;
    }

    private string NaamSleutel(int id) => $"pn-{id}-{_versie}";
    private string TitelSleutel => $"titel-{_open?.Id}-{_titelVersie}";

    // ================================================================ weergave-stukjes

    private RenderFragment PersoonHtml(int id) => __b =>
    {
        if (!_persoonOpId.TryGetValue(id, out var p)) return;   // onbekende persoon: weglaten (zoals het prototype)
        __b.OpenElement(0, "span"); __b.AddAttribute(1, "class", "ab-p");
        __b.OpenElement(2, "span"); __b.AddAttribute(3, "class", "ab-av"); __b.AddAttribute(4, "style", "background:" + ActKleur.Avatar(p.Naam));
        __b.AddContent(5, ActKleur.Initialen(p.Naam)); __b.CloseElement();
        __b.AddContent(6, p.Naam);
        __b.CloseElement();
    };

    private RenderFragment TypeChip(int id) => __b =>
    {
        var t = _data?.Types.FirstOrDefault(x => x.Id == id);
        if (t is null) return;
        __b.OpenElement(0, "span"); __b.AddAttribute(1, "class", "ab-chip ab-k-" + t.Kleur); __b.AddAttribute(2, "title", t.Naam);
        __b.AddContent(3, t.Naam); __b.CloseElement();
    };

    private RenderFragment ProbleemChip(int id, Dictionary<int, int> idx, bool label) => __b =>
    {
        var p = _data?.Problemen.FirstOrDefault(x => x.Id == id);
        if (p is null || !idx.TryGetValue(id, out var i)) return;
        __b.OpenElement(0, "span"); __b.AddAttribute(1, "class", "ab-chip ab-k-" + p.Kleur + (label ? " ab-pr" : ""));
        __b.AddAttribute(2, "title", p.Naam);
        __b.OpenElement(3, "b"); __b.AddContent(4, (i + 1).ToString()); __b.CloseElement();
        __b.AddContent(5, " " + p.Naam); __b.CloseElement();
    };

    private RenderFragment StatusPill(string code) => __b =>
    {
        var s = ActStatus.Van(code);
        __b.OpenElement(0, "span"); __b.AddAttribute(1, "class", "ab-spill ab-k-" + s.Kleur);
        __b.OpenElement(2, "i"); __b.AddAttribute(3, "class", "ab-dot-" + s.Kleur); __b.CloseElement();
        __b.AddContent(4, s.Naam); __b.CloseElement();
    };

    private static readonly Dictionary<string, string[]> TabelKolommen = new()
    {
        ["alle"] = new[] { "titel", "wie", "status", "type", "prio", "gemaakt", "verval", "dagen", "prob" },
        ["mijn"] = new[] { "titel", "status", "dagen", "wie", "type", "gemaakt", "prob" },
        ["voltooid"] = new[] { "titel", "wie", "status", "type", "gemaakt", "verval", "dagen", "prob" },
    };
    private static readonly Dictionary<string, string> KolomNaam = new()
    {
        ["titel"] = "Activiteit", ["wie"] = "Toegewezen aan", ["status"] = "Status", ["type"] = "Type", ["prio"] = "Prioriteit",
        ["gemaakt"] = "Gemaakt op", ["verval"] = "Vervaldatum", ["dagen"] = "Dagen open", ["prob"] = "Onderwerpen",
    };

    private RenderFragment TabelWeergave(Dictionary<int, int> idx) => @<text>
        @{
            var v = _view;
            var kol = TabelKolommen[v];
            var lijst = Gefilterd(idx);
            if (v == "mijn") lijst = Ik.WerknemerId is int ik ? lijst.Where(a => a.Personen.Contains(ik)).ToList() : new();
            if (v == "voltooid") lijst = lijst.Where(a => ActStatus.Groep(a.Status) == ActStatus.GroepKlaar).ToList();
            lijst = v == "mijn" ? lijst.OrderBy(a => a.GemaaktOp).ToList() : lijst.OrderByDescending(a => a.GemaaktOp).ToList();
        }
        @if (v == "mijn" && Ik.WerknemerId is null)
        {
            <div class="ab-melding">Je account is niet aan een werknemer gekoppeld, dus er is niet te zien welke activiteiten van jou zijn.</div>
        }
        else
        {
            <div class="ab-tabwrap">
                <table class="ab-tabel">
                    <thead><tr>@foreach (var c in kol) { <th>@KolomNaam[c]</th> }</tr></thead>
                    <tbody>
                    @if (v == "alle")
                    {
                        @foreach (var a in lijst) { @TabelRij(a, kol, idx) }
                    }
                    else
                    {
                        foreach (var groep in ActPrioriteit.Alle.Select(p => (int?)p.Waarde).Append(null))
                        {
                            var g = lijst.Where(a => a.Prioriteit == groep).ToList();
                            if (g.Count == 0) continue;
                            <tr class="ab-groep"><td colspan="@kol.Length">
                                @if (groep is int gp) { <span class="ab-chip ab-k-@ActPrioriteit.Kleur(gp)">@ActPrioriteit.Naam(gp)</span> }
                                else { <span>Geen prioriteit</span> }
                                <span class="ab-muted ab-gtel">@g.Count</span></td></tr>
                            @foreach (var a in g) { @TabelRij(a, kol, idx) }
                        }
                    }
                    @if (lijst.Count == 0)
                    {
                        <tr><td colspan="@kol.Length" class="ab-leeg">Geen activiteiten@(FiltersActief ? " binnen de filters" : "").</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </text>;

    private RenderFragment TabelRij(Activiteit a, string[] kol, Dictionary<int, int> idx) => @<tr class="ab-rij" data-id="@a.Id" tabindex="0" @key="a.Id"
            @onclick="() => OpenPaneel(a)" @onkeydown="e => KaartToets(e, a)">
        @foreach (var c in kol)
        {
            switch (c)
            {
                case "titel": <td class="ab-t">@a.Titel</td> break;
                case "wie": <td><div class="ab-wie ab-wie-tabel">@foreach (var pid in a.Personen) { @PersoonHtml(pid) }</div></td> break;
                case "status": <td>@StatusPill(a.Status)</td> break;
                case "type": <td><div class="ab-chips">@foreach (var tid in a.Types) { @TypeChip(tid) }</div></td> break;
                case "prio": <td>@if (a.Prioriteit is int pr) { <span class="ab-chip ab-k-@ActPrioriteit.Kleur(pr)">@ActPrioriteit.Naam(pr)</span> }</td> break;
                case "gemaakt": <td class="ab-num">@a.GemaaktOp.ToString("dd-MM-yyyy")</td> break;
                case "verval": <td class="ab-num">@(a.Vervaldatum?.ToString("dd-MM-yyyy") ?? "")</td> break;
                case "dagen": <td class="ab-num">@(a.DagenOpen?.ToString() ?? "–")</td> break;
                case "prob": <td><div class="ab-chips">@foreach (var pid in ProblemenGesorteerd(a, idx)) { @ProbleemChip(pid, idx, false) }</div></td> break;
            }
        }
    </tr>;

    // ================================================================ problemen

    private async Task ProbNieuwToets(KeyboardEventArgs e) { if (e.Key == "Enter") await VoegProbleemToe(); }

    private async Task VoegProbleemToe()
    {
        if (_data is null) return;
        var naam = _nieuwProbleem.Trim();
        if (naam.Length == 0) { Toon("Typ eerst de naam van het onderwerp", fout: true); _focusNa = "#ab-probnieuw"; return; }
        if (_data.Problemen.Any(p => p.Naam.Equals(naam, StringComparison.OrdinalIgnoreCase)))
        { Toon("Dit onderwerp staat al in de lijst", fout: true); _focusNa = "#ab-probnieuw"; return; }
        var kleur = ActKleur.Volgende(ActKleur.Problemen, _data.Problemen.Select(p => p.Kleur), _data.Problemen.Count);
        var p = new ActProbleem { Naam = naam, Kleur = kleur, Positie = _data.Problemen.Count + 1 };
        if (!await Bewaar(async () => p.Id = await Repo.VoegProbleemToeAsync(_data.Board.Id, naam, kleur))) return;
        _data.Problemen.Add(p);
        _nieuwProbleem = "";
        _focusNa = "#ab-probnieuw";
