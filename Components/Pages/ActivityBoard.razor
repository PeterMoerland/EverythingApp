    /// <summary>Melding onderin: 6,5 s met de knop Ongedaan maken, anders 3,2 s (spec §5).</summary>
    private void Toon(string tekst, bool fout = false, Func<Task>? ongedaan = null)
    {
        _toastStop?.Cancel();
        var stop = _toastStop = new CancellationTokenSource();
        _toast = new Toast(tekst, fout, ongedaan);
        _ = Task.Delay(ongedaan is null ? 3200 : 6500, stop.Token).ContinueWith(t =>
        {
            if (t.IsCanceled) return;
            _ = InvokeAsync(() => { if (_toastStop == stop) { _toast = null; StateHasChanged(); } });
        }, TaskScheduler.Default);
    }

    private void InvoerEnterBlur(KeyboardEventArgs e)
    {
        // Enter in een naamveld: bevestigen (de change komt bij het verlaten van het veld)
        if (e.Key == "Enter") _focusNa = "#ab-probnieuw";
    }
}
