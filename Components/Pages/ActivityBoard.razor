    private async Task HernoemProbleem(ActProbleem p, ChangeEventArgs e)
    {
        if (_data is null) return;
        var naam = ((string?)e.Value ?? "").Trim();
        if (naam == p.Naam) { _versie++; return; }
        if (naam.Length == 0) { _versie++; Toon("Een onderwerp heeft een naam nodig", fout: true); return; }
        if (_data.Problemen.Any(x => x != p && x.Naam.Equals(naam, StringComparison.OrdinalIgnoreCase)))
        { _versie++; Toon("Deze naam bestaat al", fout: true); return; }
        if (!await Bewaar(() => Repo.HernoemProbleemAsync(p.Id, naam))) return;
        p.Naam = naam;
        Toon("Onderwerp hernoemd. Overal bijgewerkt.");
    }

    private async Task VerwijderProbleem(ActProbleem p)
    {
        if (_data is null) return;
        var n = _data.Activiteiten.Count(a => a.Problemen.Contains(p.Id));
        if (n == 0) { await DoeVerwijderProbleem(p); return; }
        _modal = new Modal("Onderwerp verwijderen?",
            $"\"{p.Naam}\" is gekoppeld aan {n} activiteit{(n == 1 ? "" : "en")}. Die blijven bestaan; alleen de koppeling verdwijnt.",
            "Verwijderen", () => DoeVerwijderProbleem(p));
        _focusNa = "#ab-mnee";
    }

    private async Task DoeVerwijderProbleem(ActProbleem p)
    {
        if (_data is null) return;
        if (!await Bewaar(() => Repo.VerwijderProbleemAsync(p.Id))) return;
        _data.Problemen.Remove(p);
        foreach (var a in _data.Activiteiten) a.Problemen.Remove(p.Id);
        _open?.Problemen.Remove(p.Id);
        _dicht.Remove(p.Id.ToString());
        await HerlaadVolgorde();
        ValideerFilters();
        Toon($"Onderwerp \"{p.Naam}\" verwijderd");
        StateHasChanged();
    }

    /// <summary>Posities weer 1..n na verwijderen, zodat ze aaneensluiten.</summary>
    private Task HerlaadVolgorde()
        => _data is null ? Task.CompletedTask : Bewaar(() => Repo.ZetProbleemVolgordeAsync(_data.Board.Id, _data.Problemen.Select(p => p.Id).ToList()));

    [JSInvokable]
    public async Task ProblemenGeordend(int[] ids, int verplaatstId)
    {
        if (_data is null) return;
        var oud = _data.Problemen.Select(p => p.Id).ToList();
        var nieuw = ids.Where(oud.Contains).Distinct().ToList();
        nieuw.AddRange(oud.Where(x => !nieuw.Contains(x)));
        if (nieuw.SequenceEqual(oud)) return;
        await ZetVolgorde(nieuw, verplaatstId);
    }

    [JSInvokable]
    public async Task ProbleemSchuif(int id, int richting)
    {
        if (_data is null) return;
        var lijst = _data.Problemen.Select(p => p.Id).ToList();
        var i = lijst.IndexOf(id);
        var j = i + richting;
        if (i < 0 || j < 0 || j >= lijst.Count) return;
        (lijst[i], lijst[j]) = (lijst[j], lijst[i]);
        await ZetVolgorde(lijst, id);
    }

    private async Task ZetVolgorde(List<int> volgorde, int verplaatstId)
    {
        if (_data is null) return;
        var opId = _data.Problemen.ToDictionary(p => p.Id);
        _data.Problemen = volgorde.Select(id => opId[id]).ToList();
        for (var i = 0; i < _data.Problemen.Count; i++) _data.Problemen[i].Positie = i + 1;
        StateHasChanged();
        if (!await Bewaar(() => Repo.ZetProbleemVolgordeAsync(_data.Board.Id, volgorde))) { StateHasChanged(); return; }
        if (opId.TryGetValue(verplaatstId, out var p))
            Toon($"\"{p.Naam}\" heeft nu prioriteit {_data.Problemen.IndexOf(p) + 1}. Het bord is meeverhuisd.");
        StateHasChanged();
    }

