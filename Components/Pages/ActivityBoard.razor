    /// <summary>Kaart losgelaten (spec §4): kolom = status, baan = probleem, plek = volgorde. status null = op een baankop.</summary>
    [JSInvokable]
    public async Task KaartLosgelaten(int id, string lane, string? status, string? prevId, string? nextId)
    {
        if (_data is null) return;
        var a = _data.Activiteiten.FirstOrDefault(x => x.Id == id);
        if (a is null) return;
        var idx = ProbIndex();
        var oudeLane = Lane(a, idx);
        var oudeStatus = a.Status;
        var nieuweStatus = status is not null && ActStatus.IsGeldig(status) ? status : a.Status;
        var nieuweLane = lane;
        if (nieuweLane != "geen" && !_data.Problemen.Any(p => p.Id.ToString() == nieuweLane)) return;

        List<Activiteit> CelVan(string l, string st, Activiteit? zonder)
        {
            var c = _data.Activiteiten.Where(x => x != zonder && x.Status == st && Lane(x, idx) == l).ToList();
            c.Sort(OpVolgorde);
            return c;
        }
        // op een baankop: achteraan in dezelfde status
        if (status is null) { var c = CelVan(nieuweLane, a.Status, a); prevId = c.Count > 0 ? c[^1].Id.ToString() : null; nextId = null; }

        int Plaats(List<Activiteit> lijst)
        {
            if (nextId is not null) { var i = lijst.FindIndex(x => x.Id.ToString() == nextId); if (i >= 0) return i; }
            if (prevId is not null) { var i = lijst.FindIndex(x => x.Id.ToString() == prevId); if (i >= 0) return i + 1; }
            return prevId is not null ? lijst.Count : 0;
        }
        if (nieuweStatus == oudeStatus && nieuweLane == oudeLane && CelVan(oudeLane, oudeStatus, null).IndexOf(a) == Plaats(CelVan(oudeLane, oudeStatus, a)))
            return;

        var meldingen = new List<string>();
        if (nieuweStatus != oudeStatus) { ZetStatus(a, nieuweStatus); meldingen.Add("Status: " + ActStatus.Naam(nieuweStatus)); }
        if (nieuweLane != oudeLane)
        {
            if (nieuweLane == "geen") { a.Problemen.Clear(); meldingen.Add("Koppeling met onderwerpen verwijderd"); }
            else
            {
                var nl = int.Parse(nieuweLane);
                if (oudeLane != "geen") a.Problemen.Remove(int.Parse(oudeLane));
                if (!a.Problemen.Contains(nl)) a.Problemen.Add(nl);
                meldingen.Add($"Onderwerp: {(oudeLane == "geen" ? "geen" : ProbNaam(int.Parse(oudeLane)))} → {ProbNaam(nl)}");
            }
        }
        var echt = Lane(a, idx);
        if (nieuweLane != "geen" && echt != nieuweLane)
            meldingen.Add($"staat bij \"{ProbNaam(int.Parse(echt))}\" omdat dat gekoppelde onderwerp een hogere prioriteit heeft");
        // het doelvak opnieuw nummeren, zodat gelijke waarden nooit blijven hangen
        var lijst = CelVan(echt, a.Status, a);
        lijst.Insert(echt == nieuweLane ? Plaats(lijst) : lijst.Count, a);
        for (var i = 0; i < lijst.Count; i++) lijst[i].Volgorde = i;
        if (_open?.Id == a.Id) { _open.Status = a.Status; _open.GeslotenOp = a.GeslotenOp; _open.Problemen = new(a.Problemen); }
        StateHasChanged();

        var ids = lijst.Select(x => x.Id).ToList();
        if (await Bewaar(() => Repo.VerplaatsAsync(a.Id, a.Status, a.GeslotenOp, a.Problemen, ids, Ik.WerknemerId)) && meldingen.Count > 0)
            Toon($"\"{a.Titel}\": {string.Join(" · ", meldingen)}");
        StateHasChanged();
    }

