@page "/beheer/laptops"
@inject ILaptopRepository Repo
@inject IUrenRepository Uren
@inject IJSRuntime JS

@* Het laptopregister: elke laptop meldt zichzelf bij het starten van de app
   (MDE-Starten.bat). Hier zie je wie welke laptop gebruikt, met de Dell
   service tag als link naar de supportpagina van precies dat apparaat. *@

<PageTitle>Laptops — MDE</PageTitle>

<div class="page">
    <header class="topbar">
        <h1>Laptops</h1>
        <span class="weeklabel">@_regels.Count geregistreerd</span>
        <button class="klein" @onclick="Laad">⟳ Verversen</button>
    </header>

    @if (!Repo.Beschikbaar)
    {
        <section class="module-placeholder"><p>Dit scherm werkt alleen met de live database.</p></section>
    }
    else
    {
        @if (_melding is not null)
        {
            <div class="melding @(_fout ? "fout" : "ok")" @onclick="() => _melding = null">@_melding</div>
        }

        @if (_regels.Count == 0)
        {
            <section class="module-placeholder">
                <p>
                    Nog geen laptops gemeld. Start de app op een laptop via
                    <code>MDE-Starten.bat</code> (staat op de share, naast de app) —
                    die meldt de laptop onzichtbaar aan en opent daarna de browser.
                </p>
            </section>
        }
        else
        {
            <div class="regels-omhulsel">
                <table class="kiezer-tabel">
                    <thead>
                        <tr>
                            <th style="width:11rem">Computer</th>
                            <th style="width:9rem">Windows-gebruiker</th>
                            <th style="width:12rem">Werknemer</th>
                            <th style="width:8rem">Service tag</th>
                            <th style="width:13rem">Merk / model</th>
                            <th>Processor</th>
                            <th style="width:4rem" class="r">GB</th>
                            <th style="width:6.5rem" title="Laatste melding">Laatst</th>
                            <th style="width:4rem" class="r" title="Aantal meldingen">#</th>
                            <th style="width:2.4rem"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var regel in _regels)
                        {
                            <tr @key="regel.Id">
                                <td><b>@regel.Computernaam</b></td>
                                <td>@regel.Gebruikersnaam</td>
                                <td>
                                    <select value="@(regel.WerknemerId?.ToString() ?? "")"
                                            @onchange="e => Koppel(regel, e)">
                                        <option value="">—</option>
                                        @foreach (var w in _werknemers)
                                        {
                                            <option value="@w.WerknemerId">@w.Naam</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    @if (regel.ServiceTag.Length > 0)
                                    {
                                        @* Rechtstreeks naar de Dell-supportpagina van dit apparaat. *@
                                        <a href="@("https://www.dell.com/support/home/nl-nl/product-support/servicetag/" + regel.ServiceTag)"
                                           target="_blank" title="Openen bij Dell Support">@regel.ServiceTag</a>
                                    }
                                </td>
                                <td class="omschrijving" title="@(regel.Merk + " " + regel.Model)">
                                    @regel.Merk @regel.Model
                                </td>
                                <td class="omschrijving" title="@regel.Processor">@KorteCpu(regel.Processor)</td>
                                <td class="r">@(regel.GeheugenGB?.ToString() ?? "")</td>
                                <td title="@($"eerste keer {regel.EersteKeer:dd-MM-yyyy}, laatste keer {regel.LaatsteKeer:dd-MM-yyyy HH:mm}")">
                                    @(regel.LaatsteKeer?.ToString("dd-MM-yy") ?? "")
                                </td>
                                <td class="r">@regel.Meldingen</td>
                                <td class="c">
                                    <button class="klein rood" title="Uit het register halen"
                                            @onclick="() => Verwijder(regel)">✕</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <p class="uitleg">
                Laptops melden zichzelf via MDE-Starten.bat; dezelfde combinatie van
                computer en gebruiker wordt nooit dubbel opgeslagen, alleen bijgewerkt.
                De kolom # telt hoe vaak er gemeld is — dat verraadt wie de laptop echt
                dagelijks gebruikt. Verwijderde regels komen bij de eerstvolgende start
                gewoon terug; verwijderen is dus vooral voor afgevoerde apparaten.
            </p>
        }
    }
</div>

@code {
    private List<LaptopRegel> _regels = new();
    private List<Werknemer> _werknemers = new();
    private string? _melding;
    private bool _fout;

    protected override async Task OnInitializedAsync()
    {
        if (!Repo.Beschikbaar) return;
        try { _werknemers = await Uren.GetWerknemersAsync(); } catch { }
        await Laad();
    }

    private async Task Laad()
    {
        try { _regels = await Repo.GetAllesAsync(); }
        catch (Exception ex) { Toon("Ophalen mislukt: " + ex.Message, true); }
    }

    private async Task Koppel(LaptopRegel regel, ChangeEventArgs e)
    {
        var werknemerId = int.TryParse((string?)e.Value, out var v) ? v : (int?)null;
        try
        {
            await Repo.KoppelWerknemerAsync(regel.Id, werknemerId);
            regel.WerknemerId = werknemerId;
            Toon("Opgeslagen.", false);
        }
        catch (Exception ex) { Toon("Opslaan mislukt: " + ex.Message, true); }
    }

    private async Task Verwijder(LaptopRegel regel)
    {
        try
        {
            var zeker = await JS.InvokeAsync<bool>("confirm",
                $"{regel.Computernaam} ({regel.Gebruikersnaam}) uit het register halen?");
            if (!zeker) return;
        }
        catch { return; }

        try
        {
            await Repo.VerwijderAsync(regel.Id);
            _regels.Remove(regel);
            Toon("Verwijderd.", false);
        }
        catch (Exception ex) { Toon("Verwijderen mislukt: " + ex.Message, true); }
    }

    /// <summary>"Intel(R) Core(TM) i7-1185G7 @ 3.00GHz" is een mond vol; de
    /// merkfranje mag eraf, de kern blijft leesbaar.</summary>
    private static string KorteCpu(string cpu)
        => cpu.Replace("(R)", "").Replace("(TM)", "").Replace("CPU ", "")
              .Replace("  ", " ").Trim();

    private void Toon(string tekst, bool fout) { _melding = tekst; _fout = fout; }
}
