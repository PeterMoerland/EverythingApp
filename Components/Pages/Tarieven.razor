@page "/financien/tarieven"
@inject IUrenImportRepository Repo
@inject IRelatieRepository Relaties
@inject HuidigeGebruiker Ik
@inject IJSRuntime JS

@* Tarieven berekenen: het losse gebruik van het Access-formulier InvoiceImportHours. Uren van een klant (project,
   werkorders, periode) bekijken met het opnieuw gerekende tarief, de tarieven in Uren opslaan ("Bereken tarieven"),
   en van hieruit een factuur maken met deze uren als regels. Het importeren vanuit een bestaande factuur blijft in
   Components/UrenImportVenster.razor (zelfde repository en rekenregels, Services/Tariefregels.cs). *@

<PageTitle>Tarieven berekenen — MDE</PageTitle>

<div class="page">
    <header class="topbar">
        <h1>Tarieven berekenen</h1>
        @if (_uren.Count > 0)
        {
            <span class="weeklabel">@_uren.Count urenregels · @Getal(_uren.Sum(u => u.Uren)) uur · @Geld(_uren.Sum(u => u.BedragVoorFactuur))</span>
        }
    </header>

    @if (!Mag)
    {
        <div class="melding fout">Hiervoor is het recht Financial of Directie nodig.</div>
    }
    else
    {
        @if (_melding is not null)
        {
            <div class="melding @(_meldingFout ? "fout" : "ok")" @onclick="() => _melding = null">@_melding</div>
        }

        <div class="tar-keuze">
            <div class="wn-velden een-kolom">
                <div class="wn-veld">
                    <label>Klant</label>
                    <div class="factuur-leverancier">
                        @if (_klant is { } kl) { <span class="factuur-gekozen">@kl.Naam</span> }
                        else { <span class="zij-extra">nog niet gekozen</span> }
                        <button class="klein" @onclick="() => _klantZoekOpen = !_klantZoekOpen">🔍 zoeken</button>
                    </div>
                </div>
                @if (_klantZoekOpen)
                {
                    <div class="wn-veld breed">
                        <label></label>
                        <div class="factuur-zoekvak">
                            <input data-zoeklijst placeholder="Naam of plaats…" value="@_klantZoek" @oninput="KlantZoekGewijzigd" autofocus />
                            @if (_klanten.Count == 0 && _klantZoek.Trim().Length >= 2)
                            {
                                <p class="zij-extra">Niets gevonden. Staat hij als klant bij Relaties?</p>
                            }
                            <div class="wn-namen kort">
                                @foreach (var k in _klanten)
                                {
                                    <button class="wn-naam" @key="k.Id" @onclick="() => KiesKlant(k)">@k.Naam</button>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (_klant is not null)
                {
                    <div class="wn-veld">
                        <label>Project</label>
                        <select value="@(_selectie.ProjectId?.ToString() ?? "")" @onchange="ProjectGewijzigd">
                            <option value="">— alle projecten van de klant —</option>
                            @foreach (var p in _projecten)
                            {
                                <option value="@p.Id">@p.Nummer — @p.Omschrijving</option>
                            }
                        </select>
                    </div>
                    @if (_werkorders.Count > 0)
                    {
                        <div class="wn-veld breed">
                            <label>Werkorders</label>
                            <div class="ui-werkorders">
                                @* subwerkorders ingesprongen; een ouder aanvinken vinkt ze mee aan (wens gebruiker 24-10-2026) *@
                                @foreach (var (w, diepte) in WerkorderBoom.Ordenen(_werkorders, x => x.WerkbonId, x => x.OuderId, x => x.Nummer))
                                {
                                    <label class="vinkje" @key="w.WerkbonId" style="@(diepte == 0 ? "" : FormattableString.Invariant($"padding-left:{diepte * 1.2m}rem"))">
                                        @if (diepte > 0) { <span class="zij-extra">↳</span> }
                                        <input type="checkbox" checked="@_selectie.WerkbonIds.Contains(w.WerkbonId)"
                                               @onchange="e => WerkorderGewijzigd(w.WerkbonId, e)" />
                                        @w.Nummer @w.Omschrijving
                                        @if (w.Soort.Length > 0) { <span class="zij-extra">(@w.Soort)</span> }
                                    </label>
                                }
                                <span class="zij-extra">Niets aangevinkt = alle werkorders van het project.</span>
                            </div>
                        </div>
                    }
                    <div class="wn-veld breed">
                        <label>Periode</label>
                        <span class="factuur-termijn">
                            <NlDatum Waarde="_selectie.Van" WaardeChanged="VanGewijzigd" />
                            <span>t/m</span>
                            <NlDatum Waarde="_selectie.Tot" WaardeChanged="TotGewijzigd" />
                            <button class="klein" @onclick="() => ZetMaand(-1)">Vorige maand</button>
                            <button class="klein" @onclick="() => ZetMaand(0)">Deze maand</button>
                            <button class="klein" title="Van de eerste tot de laatste dag met uren in deze keuze" @onclick="AlleUren">Alle uren</button>
                        </span>
                    </div>
                }
            </div>

            @if (_klant is not null)
            {
                <div class="btngroup">
                    <button class="primair" disabled="@_bezig" @onclick="Toon">@(_bezig ? "Bezig…" : "Uren tonen")</button>
                    @if (_getoond && _uren.Count > 0)
                    {
                        <button class="klein" disabled="@_bezig" title="Zoals 'Bereken tarieven' in Access: de gerekende bedragen in de urenregistratie zetten"
                                @onclick="TarievenOpslaan">Tarieven opslaan (@AantalAnders)</button>
                        <button class="klein" disabled="@_bezig" title="Een nieuwe factuur voor deze klant, met deze uren als regels"
                                @onclick="FactuurMaken">＋ Factuur maken met deze uren</button>
                    }
                </div>
            }
        </div>

        @if (_getoond && _meldingen.Count > 0)
        {
            <div class="factuur-ai">
                <strong>Let op:</strong>
                <ul>@foreach (var m in _meldingen) { <li @key="m">@m</li> }</ul>
            </div>
        }

        @if (_getoond)
        {
            @* samenvatting zoals de factuurregels straks: per werkorder, medewerker en uurtype *@
            <h3 class="wn-kop">Samenvatting <small class="zij-extra">(@Groepeer().Count factuurregels)</small></h3>
            <table class="kiezer-tabel tar-tabel">
                <thead>
                    <tr>
                        <th style="width:7rem">Werkorder</th><th>Omschrijving</th><th style="width:12rem">Medewerker</th>
                        <th style="width:7rem">Uurtype</th><th style="width:4.5rem" class="r">Uren</th>
                        <th style="width:4.5rem" class="r">Km</th><th style="width:7.5rem" class="r">Bedrag</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in Groepeer())
                    {
                        <tr>
                            <td>@g.Werkorder</td><td class="omschrijving" title="@g.ProjectOmschrijving">@g.WerkorderOmschrijving</td>
                            <td>@g.Naam</td><td>@g.Uurtype</td>
                            <td class="r">@Getal(g.Uren ?? 0)</td><td class="r">@((g.Kilometers ?? 0) == 0 ? "" : Getal(g.Kilometers ?? 0))</td>
                            <td class="r">@Geld(g.Totaal)</td>
                        </tr>
                    }
                    @if (_uren.Count == 0) { <tr><td colspan="7" class="kiezer-info">Geen uren in deze keuze en periode.</td></tr> }
                </tbody>
            </table>

            @if (_uren.Count > 0)
            {
                <h3 class="wn-kop">
                    Urenregels
                    <button class="klein" @onclick="() => _details = !_details">@(_details ? "Verbergen" : "Tonen")</button>
                </h3>
                @if (_details)
                {
                    <div class="ui-lijst tar-details">
                        <table class="kiezer-tabel">
                            <thead>
                                <tr>
                                    <th style="width:5.6rem">Datum</th><th>Medewerker</th><th style="width:6.5rem">Werkorder</th>
                                    <th style="width:5.5rem">Uurtype</th><th style="width:3.5rem" class="r">Uren</th>
                                    <th style="width:3.5rem" class="r">Km</th><th style="width:5rem" class="r">Vast</th>
                                    <th style="width:6.5rem" class="r" title="Wat nu in de urenregistratie staat">Was</th>
                                    <th style="width:6.5rem" class="r" title="Opnieuw gerekend met de huidige tarieven">Bedrag</th>
                                    <th style="width:9rem">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in _uren)
                                {
                                    <tr @key="u.UrenId" class="@(AlElders(u) ? "ui-elders" : "")">
                                        <td>@u.Datum.ToString("dd-MM-yy")</td>
                                        <td class="omschrijving">@u.Werknemer</td>
                                        <td title="@u.WerkorderOmschrijving">@u.Wo</td>
                                        <td>@u.Tariefsoort</td>
                                        <td class="r">@Getal(u.Uren)</td>
                                        <td class="r">@(u.Kilometers == 0 ? "" : Getal(u.Kilometers))</td>
                                        <td class="r">@(u.VastBedrag == 0 ? "" : Geld(u.VastBedrag))</td>
                                        <td class="r">@Geld(u.Bedrag)</td>
                                        <td class="r @(u.NieuwBedrag is null ? "factuur-credit" : u.NieuwBedrag != u.Bedrag ? "ui-anders" : "")" title="@u.Melding">
                                            @(u.NieuwBedrag is decimal nieuw ? Geld(nieuw) : "—")
                                        </td>
                                        <td class="omschrijving">@Status(u)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        }
    }
</div>

<VerkoopFactuurVenster FactuurId="_factuurOpen" Voorstel="_voorstel" Sluiten="FactuurGesloten" />

@code {
    private bool Mag => Ik.Mag("Financial") || Ik.Mag("Directie");

    private Keuze? _klant;
    private bool _klantZoekOpen = true;
    private string _klantZoek = "";
    private List<Keuze> _klanten = new();

    private UrenSelectie _selectie = new();
    private List<ProjectKeuze> _projecten = new();
    private List<WerkorderKeuzeUren> _werkorders = new();
    private List<UurRegel> _uren = new();
    private List<string> _meldingen = new();
    private bool _getoond, _bezig, _details;
    private string? _melding;
    private bool _meldingFout;

    private int? _factuurOpen;
    private FactuurVoorstel? _voorstel;

    private static readonly System.Globalization.CultureInfo Nl = new("nl-NL");
    private static string Geld(decimal w) => w.ToString("C2", Nl);
    private static string Getal(decimal w) => w.ToString("0.##", Nl);

    protected override async Task OnInitializedAsync() => await Ik.ZorgGeladenAsync();

    // ---- klant ----
    private async Task KlantZoekGewijzigd(ChangeEventArgs e)
    {
        _klantZoek = (string?)e.Value ?? "";
        var zoek = _klantZoek.Trim();
        if (zoek.Length < 2) { _klanten = new(); return; }
        try { _klanten = await Relaties.ZoekAsync(zoek, true, false, 0, 15); }
        catch { _klanten = new(); }
    }

    private async Task KiesKlant(Keuze k)
    {
        _klant = k;
        _klantZoekOpen = false; _klantZoek = ""; _klanten = new();
        var vandaag = DateOnly.FromDateTime(DateTime.Today);
        _selectie = new UrenSelectie { KlantId = k.Id, Van = vandaag.AddDays(-7), Tot = vandaag };   // zoals Access: afgelopen week
        _werkorders = new();
        WisLijst();
        try { _projecten = await Repo.GetProjectenAsync(k.Id); }
        catch (Exception ex) { _projecten = new(); Toon("Projecten ophalen mislukt: " + ex.Message, true); }
    }

    // ---- keuze ----
    private async Task ProjectGewijzigd(ChangeEventArgs e)
    {
        _selectie.ProjectId = int.TryParse((string?)e.Value, out var v) ? v : null;
        _selectie.WerkbonIds.Clear();
        WisLijst();
        try { _werkorders = _selectie.ProjectId is int p ? await Repo.GetWerkordersAsync(p) : new(); }
        catch { _werkorders = new(); }
    }

    /// <summary>Werkorder aan- of uitgevinkt: de periode volgt de uren van die keuze; geen uren = periode blijft staan.</summary>
    private async Task WerkorderGewijzigd(int werkbonId, ChangeEventArgs e)
    {
        // de subwerkorders gaan mee aan of uit
        var groep = WerkorderBoom.MetNakomelingen(_werkorders, x => x.WerkbonId, x => x.OuderId, new[] { werkbonId });
        if (e.Value is true) { foreach (var id in groep) if (!_selectie.WerkbonIds.Contains(id)) _selectie.WerkbonIds.Add(id); }
        else _selectie.WerkbonIds.RemoveAll(groep.Contains);
        WisLijst();
        try
        {
            if (await Repo.PeriodeVanUrenAsync(_selectie) is { } periode)
            {
                _selectie.Van = periode.Van;
                _selectie.Tot = periode.Tot;
            }
        }
        catch { }
    }

    private void VanGewijzigd(DateOnly? d) { if (d is DateOnly dag) _selectie.Van = dag; WisLijst(); }
    private void TotGewijzigd(DateOnly? d) { if (d is DateOnly dag) _selectie.Tot = dag; WisLijst(); }

    private void ZetMaand(int verschuiving)
    {
        var eerste = new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(verschuiving);
        _selectie.Van = eerste;
        _selectie.Tot = eerste.AddMonths(1).AddDays(-1);
        WisLijst();
    }

    private async Task AlleUren()
    {
        try
        {
            var periode = await Repo.PeriodeVanUrenAsync(_selectie);
            if (periode is null) { Toon("Geen uren gevonden in deze keuze.", true); return; }
            _selectie.Van = periode.Value.Van;
            _selectie.Tot = periode.Value.Tot;
            WisLijst();
        }
        catch (Exception ex) { Toon("Periode ophalen mislukt: " + ex.Message, true); }
    }

    private void WisLijst() { _uren = new(); _meldingen = new(); _getoond = false; }

    // ---- tonen en rekenen ----
    private async Task Toon()
    {
        if (_klant is null) return;
        if (_selectie.Tot < _selectie.Van) { Toon("De einddatum ligt voor de begindatum.", true); return; }
        _bezig = true;
        try
        {
            _uren = await Repo.GetUrenAsync(_selectie);
            await Repo.RekenAsync(_klant.Id, _uren);
            _meldingen = Meldingen();
            _getoond = true;
            _melding = null;
        }
        catch (Exception ex) { Toon("Uren ophalen mislukt: " + ex.Message, true); }
        finally { _bezig = false; }
    }

    private bool AlElders(UurRegel u) => u.GefactureerdOp is not null || u.GereserveerdOp is not null;

    private static string Status(UurRegel u)
    {
        if (u.GefactureerdOp is not null) return "gefactureerd " + (u.GefactureerdNr.Length > 0 ? u.GefactureerdNr : "#" + u.GefactureerdOp);
        if (u.GereserveerdOp is int r) return "op factuur " + (u.GereserveerdNr.Length > 0 ? u.GereserveerdNr : "#" + r);
        return "";
    }

    private int AantalAnders => _uren.Count(u => u.NieuwBedrag is decimal n && n != u.Bedrag);

    private List<string> Meldingen()
    {
        var lijst = _uren.Where(u => u.Melding.Length > 0)
            .GroupBy(u => u.Melding)
            .Select(g => g.First().NieuwBedrag is null
                ? $"{g.Key}: {g.Count()} regel(s) houden het bedrag dat er nu staat"
                : $"{g.Key} ({g.Count()}×)")
            .ToList();
        var elders = _uren.Count(AlElders);
        if (elders > 0) lijst.Add($"{elders} regel(s) staan al op een factuur (oranje); die gaan niet mee in een nieuwe factuur.");
        if (AantalAnders > 0) lijst.Add($"Bij {AantalAnders} regel(s) wijkt het gerekende bedrag af van wat er stond (vetgedrukt); 'Tarieven opslaan' zet het nieuwe bedrag in de urenregistratie.");
        return lijst;
    }

    /// <summary>Access cmdBerekenTarieven: de gerekende bedragen in Uren zetten, los van een factuur.</summary>
    private async Task TarievenOpslaan()
    {
        if (_uren.Count == 0 || _bezig) return;
        var fout = _uren.Count(u => u.NieuwBedrag is null);
        if (fout > 0 && !await Vraag($"Bij {fout} urenregel(s) kon het tarief niet gerekend worden; die blijven zoals ze staan. Doorgaan?")) return;
        _bezig = true;
        try
        {
            var n = await Repo.SchrijfTarievenAsync(_uren);
            foreach (var u in _uren.Where(u => u.NieuwBedrag is decimal)) u.Bedrag = u.NieuwBedrag!.Value;
            _meldingen = Meldingen();
            Toon(n > 0 ? $"{n} tarieven bijgewerkt in de urenregistratie." : "Alle tarieven stonden al goed.", false);
        }
        catch (Exception ex) { Toon("Opslaan mislukt: " + ex.Message, true); }
        finally { _bezig = false; }
    }

    // ---- factuur maken ----

    /// <summary>Zoals het importvenster: één regel per project, werkorder, medewerker en uurtype; uren die al op een
    /// factuur staan doen niet mee (bij een nieuwe factuur zijn die altijd 'elders').</summary>
    private List<VerkoopFactuurItem> Groepeer()
        => _uren.Where(u => !AlElders(u))
            .GroupBy(u => (u.ProjectId, u.WerkbonId, u.WerknemerId, u.TariefsoortId))
            .Select(g =>
            {
                var eerste = g.First();
                var bedrag = g.Sum(u => u.BedragVoorFactuur);
                return new VerkoopFactuurItem
                {
                    Werkorder = eerste.Wo, WerkorderOmschrijving = eerste.WerkorderOmschrijving, ProjectOmschrijving = eerste.ProjectOmschrijving,
                    Naam = eerste.Werknemer, Uurtype = eerste.Tariefsoort,
                    Uren = g.Sum(u => u.Uren), Kilometers = g.Sum(u => u.Kilometers),
                    Stuksprijs = bedrag, Korting = 0, Totaal = bedrag,
                    Herkomst = new UrenHerkomst(eerste.ProjectId, eerste.ProjectOmschrijving, eerste.WerkbonId,
                                                eerste.WerknemerId, eerste.TariefsoortId, _selectie.Van, _selectie.Tot),
                };
            })
            .OrderBy(r => r.Werkorder).ThenBy(r => r.Naam).ThenBy(r => r.Uurtype)
            .ToList();

    private async Task FactuurMaken()
    {
        if (_klant is null || _bezig) return;
        var regels = Groepeer();
        if (regels.Count == 0) { Toon("Er zijn geen uren die nog niet op een factuur staan.", true); return; }
        // eerst de tarieven vastleggen, net als bij importeren vanuit een factuur
        try { await Repo.SchrijfTarievenAsync(_uren); } catch (Exception ex) { Toon("Tarieven opslaan mislukt: " + ex.Message, true); return; }
        var project = _selectie.ProjectId is int p ? _projecten.FirstOrDefault(x => x.Id == p) : null;
        var omschrijving = project is null ? $"Uren {_selectie.Van:dd-MM-yyyy} t/m {_selectie.Tot:dd-MM-yyyy}"
                                           : $"{project.Nummer} {project.Omschrijving} · uren {_selectie.Van:dd-MM-yyyy} t/m {_selectie.Tot:dd-MM-yyyy}";
        _voorstel = new FactuurVoorstel(null, _klant.Id, _klant.Naam, "", omschrijving, "", 0) { Regels = regels };
        _factuurOpen = 0;
    }

    private async Task FactuurGesloten(bool bewaard)
    {
        _factuurOpen = null;
        _voorstel = null;
        if (bewaard && _getoond) await Toon();        // de uren staan nu op een factuur: status bijwerken
    }

    private async Task<bool> Vraag(string tekst)
    {
        try { return await JS.InvokeAsync<bool>("mdeBevestig", tekst); }
        catch { return false; }
    }

    private void Toon(string tekst, bool fout) { _melding = tekst; _meldingFout = fout; }
}
