@page "/wiki"
@inject Wiki Wiki
@inject SnelIconen Iconen
@inject IProjectRepository Projecten
@inject HuidigeGebruiker Ik
@inject IJSRuntime JS
@inject NavigationManager Nav

@* Wiki (opzet van Freek, fase 1; 25-11-2026): links de ruimtes en het zoekvak, rechts de artikelen van een ruimte of
   een artikel. Lezen mag iedereen; schrijven elke aangemelde medewerker (review komt later). Elke keer opslaan maakt
   een versie, een oude versie is terug te zetten, en weghalen is "inactief" zetten. Wat er open staat volgt uit het
   adres (?ruimte=, ?artikel=), zodat een link naar een artikel werkt en de terugknop van de browser ook.
   Opslag: Services/Wiki.cs, tabellen uit Wiki_MariaDB.sql. De opmaak leunt op die van Claude Shares (.cs-…). *@

<PageTitle>@(_artikel is null ? "Wiki" : _artikel.Titel + " — Wiki") — MDE</PageTitle>

<div class="page cs-pagina wk-pagina">
    <header class="topbar">
        <h1>Wiki</h1>
        <span class="weeklabel">de kennisbank van MDE</span>
    </header>

    @if (_melding is not null)
    {
        <div class="melding @(_fout ? "fout" : "ok")" style="position:static;max-width:none" @onclick="() => _melding = null">@_melding</div>
    }

    @if (!_geladen)
    {
        <p class="uitleg">Laden…</p>
    }
    else if (!_tabel)
    {
        <section class="module-placeholder"><p>De tabellen voor de wiki bestaan nog niet (Wiki_MariaDB.sql).</p></section>
    }
    else
    {
        <div class="cs-opmaak">
            <aside class="cs-links">
                <input class="cs-zoek" placeholder="Zoeken in de wiki…" value="@_zoek" @oninput="ZoekInput" autocomplete="off" aria-label="Zoeken in de wiki" />
                <button type="button" class="cs-project @(_ruimte is null && _artikel is null && !Zoekt ? "actief" : "")" @onclick="@(() => Ga("wiki"))">🏠 Start</button>
                @* de boom met de lege plek eronder: daar vangt de rechtermuisknop (niet op het zoekvak, daar hoort het menu van de browser) *@
                <div class="wk-boom @(_sleeptRuimte is not null && _sleepBoven ? "sleepdoel" : "")" @oncontextmenu="e => OpenMenu(e, null)" @oncontextmenu:preventDefault="MagSchrijven"
                     ondragstart="event.dataTransfer.setData('text/plain', 'ruimte'); event.dataTransfer.effectAllowed = 'move';"
                     ondragover="event.preventDefault()" @ondragenter="() => { if (_sleeptRuimte is not null) { _sleepBoven = true; _sleepDoel = null; _sleepVoor = null; } }" @ondrop="LaatVallenBoven">
                <div class="cs-kopje">Ruimtes</div>
                @foreach (var (r, diepte) in Zichtbaar())
                {
                    var kinderen = _ruimtes.Any(x => x.OuderId == r.Id);
                    var totaal = Totaal(r.Id);
                    @* de smalle strook boven een ruimte: laat je een ruimte hier vallen, dan komt hij ervoor te staan (zelfde laag) *@
                    <div class="wk-tussen @(_sleeptRuimte is not null && _sleepVoor == r.Id ? "sleepdoel" : "")" style="@($"margin-left:{(diepte - 1) * 12 + 18}px")" @key="@("voor" + r.Id)"
                         ondragover="event.preventDefault()" @ondragenter="() => SleepVoor(r.Id)" @ondragenter:stopPropagation="true"
                         @ondrop="() => LaatVallenVoor(r)" @ondrop:stopPropagation="true"></div>
                    <div class="wk-tak @(_menu?.Ruimte?.Id == r.Id ? "gekozen" : "") @(Sleept && _sleepDoel == r.Id ? "sleepdoel" : "") @(_sleeptRuimte?.Id == r.Id ? "wk-sleept" : "")" style="@($"padding-left:{(diepte - 1) * 12}px")" @key="r.Id"
                         draggable="@(MagSchrijven ? "true" : "false")" @ondragstart="() => BeginSleepRuimte(r)" @ondragstart:stopPropagation="false" @ondragend="EindeSlepen"
                         ondragover="event.preventDefault()" @ondragenter="() => SleepOver(r.Id)" @ondragenter:stopPropagation="true" @ondrop="() => LaatVallen(r.Id)" @ondrop:stopPropagation="true"
                         @oncontextmenu="e => OpenMenu(e, r)" @oncontextmenu:preventDefault="MagSchrijven" @oncontextmenu:stopPropagation="true">
                        @if (kinderen)
                        {
                            <button type="button" class="wk-pijl" title="@(_open.Contains(r.Id) ? "Dichtklappen" : "Openklappen")" aria-expanded="@_open.Contains(r.Id)"
                                    @onclick="() => { if (!_open.Remove(r.Id)) _open.Add(r.Id); }">@(_open.Contains(r.Id) ? "▾" : "▸")</button>
                        }
                        else { <span class="wk-pijl"></span> }
                        <button type="button" class="cs-project @(r.Id == HuidigeRuimte ? "actief" : "")" @onclick="@(() => Ga($"wiki?ruimte={r.Id}"))" title="@r.Omschrijving">
                            @Ico(r.Icoon) @r.Naam <span class="cs-aantal">@(totaal > 0 ? totaal : "")</span>
                        </button>
                    </div>
                }
                @if (MagSchrijven)
                {
                    <p class="wk-tip">Rechtermuisknop op een ruimte: subruimte toevoegen, naam of icoon wijzigen, wissen. Op de lege plek hieronder: een nieuwe ruimte.
                        Slepen: een artikel naar een ruimte; een ruimte óp een andere ruimte (eronder hangen), tússen twee ruimtes (de volgorde), of naar de lege plek (bovenaan, achteraan).</p>
                }
                </div>
            </aside>

            <main class="cs-rechts">
                @if (_bewerk is { } b)
                {
                    @* ----- schrijven ----- *@
                    <div class="cs-leeskop">
                        <h2>@(b.Id == 0 ? "Nieuw artikel" : "Bewerken")</h2>
                        <span class="groei"></span>
                        <label class="vink"><input type="checkbox" checked="@_voorbeeld" @onchange="e => _voorbeeld = e.Value is true" /> voorbeeld tonen</label>
                    </div>
                    <div class="wk-velden">
                        <label class="cs-veld wk-breed"><span>Titel (het onderwerp, niet het projectnummer)</span>
                            <input id="wk-titel" @ref="_titelVeld" value="@b.Titel" maxlength="200" @oninput="e => b.Titel = (string?)e.Value ?? string.Empty" /></label>
                        <label class="cs-veld"><span>Ruimte</span>
                            <select value="@b.RuimteId" @onchange="RuimteGekozen">
                                @foreach (var (r, _) in Boom(null, 1)) { <option value="@r.Id">@Pad(r.Id)</option> }
                            </select></label>
                        <label class="cs-veld"><span>Sectie (kopje in de ruimte; mag leeg)</span>
                            <input value="@b.Sectie" maxlength="100" list="wk-secties" @oninput="e => b.Sectie = (string?)e.Value ?? string.Empty" />
                            <datalist id="wk-secties">@foreach (var s in _secties) { <option value="@s" /> }</datalist></label>
                        <label class="cs-veld"><span>Tags (met komma's ertussen; hoogstens 20)</span>
                            <input value="@b.Tags" maxlength="500" @oninput="e => b.Tags = (string?)e.Value ?? string.Empty" /></label>
                        <div class="cs-veld"><span>Project (mag leeg)</span>
                            @if (b.ProjectId is not null)
                            {
                                <span class="wk-project">@b.ProjectTekst <button type="button" class="klein" @onclick="() => { b.ProjectId = null; b.ProjectTekst = string.Empty; }">✕</button></span>
                            }
                            else
                            {
                                <input placeholder="Projectnummer of omschrijving…" value="@_projectZoek" @oninput="ProjectZoekInput" autocomplete="off" />
                                @foreach (var p in _projectGevonden)
                                {
                                    <button type="button" class="cs-project" @onclick="() => KiesProject(b, p)">@Label(p)</button>
                                }
                            }
                        </div>
                    </div>
                    @if (_alleTags.Count > 0)
                    {
                        <p class="cs-zacht">Bestaande tags: @string.Join(", ", _alleTags.Take(40))</p>
                    }
                    <div class="@(_voorbeeld ? "wk-schrijf met-voorbeeld" : "wk-schrijf")">
                        <textarea class="wk-tekst" rows="24" spellcheck="true" value="@b.Inhoud" @oninput="e => b.Inhoud = (string?)e.Value ?? string.Empty"
                                  placeholder="Schrijf hier. # Kop, ## Tussenkop, **vet**, - lijst, 1. genummerd, `code`, [tekst](https://adres), [[Titel van een ander artikel]]"></textarea>
                        @if (_voorbeeld)
                        {
                            <div class="cs-tekst"><div class="cs-md">@((MarkupString)Opmaak(b.Inhoud))</div></div>
                        }
                    </div>
                    <p class="cs-zacht"># Kop · ## Tussenkop · **vet** · *cursief* · - lijst · 1. genummerd · `code` · [tekst](https://adres) · | tabel | met | strepen | · [[Titel]] verwijst naar een ander artikel</p>
                    @if (b.Id != 0)
                    {
                        <div class="wk-bijlagen">
                            <div class="cs-kopje">Bijlagen en plaatjes</div>
                            @foreach (var x in _bijlagen)
                            {
                                <span class="wk-bijlage">@(x.IsAfbeelding ? "🖼" : "📎") @x.Naam
                                    <button type="button" class="klein" title="Zet de verwijzing onderaan de tekst; verplaats hem daarna naar de goede plek" @onclick="() => b.Inhoud = b.Inhoud.TrimEnd() + Environment.NewLine + Environment.NewLine + x.Verwijzing + Environment.NewLine">in de tekst zetten</button></span>
                            }
                            <span class="cs-rijvlak">⬆ bestand toevoegen (sleep of klik)
                                <InputFile @key="_invoer" OnChange="e => BijlageOntvangen(e, b.Id)" multiple class="cs-invoer" /></span>
                        </div>
                    }
                    else
                    {
                        <p class="cs-zacht">Plaatjes en bijlagen toevoegen kan nadat het artikel een keer is opgeslagen.</p>
                    }
                    <label class="cs-veld"><span>@(b.Id == 0 ? "Opmerking (mag leeg)" : "Wat is er veranderd? (mag leeg)")</span>
                        <input value="@_opmerking" maxlength="500" @oninput="e => _opmerking = (string?)e.Value ?? string.Empty" /></label>
                    <div class="cs-knoppen">
                        <button type="button" class="primair" disabled="@(_bezig || b.Titel.Trim().Length == 0)" @onclick="Bewaar">Opslaan</button>
                        <button type="button" class="klein" disabled="@_bezig" @onclick="Annuleer">Annuleren</button>
                    </div>
                }
                else if (Zoekt)
                {
                    @* ----- zoeken ----- *@
                    <div class="cs-leeskop"><h2>Zoeken: @_zoek.Trim()</h2></div>
                    @if (_treffers.Count == 0) { <p class="uitleg">@(_zoekBezig ? "Zoeken…" : "Niets gevonden.")</p> }
                    @foreach (var t in _treffers)
                    {
                        <div class="wk-treffer" @key="t.Artikel.Id">
                            <a class="wk-titel" href="@(Wiki.ArtikelAdres + t.Artikel.Id)">@t.Artikel.Titel</a>
                            <span class="cs-zacht">@RuimteNaam(t.Artikel.RuimteId)@(t.Artikel.Sectie.Length > 0 ? " · " + t.Artikel.Sectie : "")</span>
                            <div class="wk-fragment">@t.Fragment</div>
                        </div>
                    }
                }
                else if (_artikel is { } a)
                {
                    @* ----- een artikel lezen ----- *@
                    <div class="cs-leeskop">
                        <button type="button" class="klein" @onclick="@(() => Ga($"wiki?ruimte={a.RuimteId}"))">‹ @RuimteNaam(a.RuimteId)</button>
                        <h2>@(_oud?.Titel ?? a.Titel)</h2>
                        <span class="stand-chip @(_oud is null ? "s-groen" : "s-grijs")">v@(_oud?.Versie ?? a.Versie)@(_oud is null ? "" : " · oude versie")</span>
                        @if (!a.Actief) { <span class="stand-chip s-rood">inactief</span> }
                        <span class="groei"></span>
                        @if (MagSchrijven && _oud is null)
                        {
                            <button type="button" class="primair klein" @onclick="() => Bewerk(a)">✎ Bewerken</button>
                        }
                        <button type="button" class="klein @(VersiesOpen ? "actief" : "")" aria-pressed="@VersiesOpen" title="De eerdere versies van dit artikel tonen of verbergen"
                                @onclick="WisselVersies">🕘 Versies @_versies.Count</button>
                        <button type="button" class="klein" title="Het adres van dit artikel naar het klembord" @onclick="KopieerLink">Link</button>
                        @if (MagSchrijven)
                        {
                            <button type="button" class="klein" title="@(a.Actief ? "Uit de lijsten en het zoeken halen; het artikel blijft bewaard" : "Weer in de lijsten zetten")" @onclick="() => ZetActief(a, !a.Actief)">@(a.Actief ? "Inactief zetten" : "Terughalen")</button>
                        }
                    </div>
                    <div class="wk-meta">
                        @if (a.Sectie.Length > 0) { <span>@a.Sectie</span> }
                        @if (a.ProjectId is int pid) { <a href="@($"projecten?project={pid}")" title="Naar het project">📁 @a.ProjectTekst</a> }
                        @foreach (var tag in a.TagLijst) { <button type="button" class="wk-tag" @onclick="() => ZoekOp(tag)">#@tag</button> }
                        <span class="cs-zacht">laatst gewijzigd @a.GewijzigdOp.ToString("d-M-yyyy HH:mm")@(a.GewijzigdDoor.Length > 0 ? " door " + a.GewijzigdDoor : "")</span>
                    </div>

                    <div class="cs-lees @(VersiesOpen ? "" : "wk-zonder-versies")">
                        <div>
                            @* zonder tekst geen leeg vak: dan is het artikel zijn bijlage (bv. een HTML-bestand dat eronder staat) *@
                            @if (_html.Length > 0)
                            {
                                <div class="cs-tekst"><div class="cs-md">@((MarkupString)_html)</div></div>
                            }
                            else if (_bijlagen.Count == 0)
                            {
                                <p class="uitleg">Dit artikel heeft nog geen tekst@(MagSchrijven ? "; klik op Bewerken om te schrijven, of zet er een bestand bij" : "").</p>
                            }
                            @if (_bijlagen.Count > 0 || MagSchrijven)
                            {
                                <div class="wk-bijlagen">
                                    <div class="cs-kopje">Bijlagen</div>
                                    @foreach (var x in _bijlagen)
                                    {
                                        <a class="wk-bijlage @(_menu?.Bijlage?.FileStoreId == x.FileStoreId ? "gekozen" : "")" href="@(Wiki.BijlageAdres + x.FileStoreId)" target="_blank" rel="noopener"
                                           @oncontextmenu="e => OpenBijlageMenu(e, x)" @oncontextmenu:preventDefault="MagSchrijven"
                                           title="@(x.IsAfbeelding ? "Openen" : "Downloaden")">@(x.IsAfbeelding ? "🖼" : x.IsHtml ? "🌐" : "📎") @x.Naam</a>
                                        @if (x.IsHtml)
                                        {
                                            <button type="button" class="klein @(_voorbeeldVan == x.FileStoreId ? "primair" : "")" title="Het HTML-bestand hieronder tonen"
                                                    @onclick="() => _voorbeeldVan = _voorbeeldVan == x.FileStoreId ? null : x.FileStoreId">@(_voorbeeldVan == x.FileStoreId ? "Sluiten" : "Bekijken")</button>
                                        }
                                    }
                                    @if (_bijlagen.Count == 0) { <span class="cs-zacht">Nog geen.</span> }
                                    else if (MagSchrijven) { <span class="cs-zacht wk-biltip">rechtermuisknop op een bijlage: wissen</span> }
                                    @if (MagSchrijven && a.Actief)
                                    {
                                        <span class="cs-rijvlak">⬆ bestand toevoegen (sleep of klik)
                                            <InputFile @key="_invoer" OnChange="e => BijlageOntvangen(e, a.Id)" multiple class="cs-invoer" /></span>
                                    }
                                </div>
                            }
                        </div>
                        @* de versies staan achter de knop "Versies" in de kop; alleen bij een oude versie in beeld altijd open *@
                        @if (VersiesOpen)
                        {
                        <aside class="cs-versies">
                            <div class="cs-kopje">Versies</div>
                            @foreach (var v in _versies)
                            {
                                var huidig = v.Versie == a.Versie;
                                <div class="cs-versie @((_oud?.Id ?? (huidig ? v.Id : 0)) == v.Id ? "actief" : "")" @onclick="() => ToonVersie(a, v)">
                                    <div><b>v@(v.Versie)</b> <span class="cs-zacht">@(huidig ? "geldend" : "archief")</span></div>
                                    <div class="cs-zacht">@v.Op.ToString("d-M-yyyy HH:mm")@(v.Door.Length > 0 ? " · " + v.Door : "")</div>
                                    @if (v.Opmerking.Length > 0) { <div class="cs-opm">@v.Opmerking</div> }
                                    @if (!huidig && MagSchrijven && a.Actief)
                                    {
                                        <button type="button" class="klein" title="Titel en tekst van toen worden de nieuwe geldende versie; de versies ertussen blijven bewaard"
                                                @onclick="() => ZetTerug(a, v)" @onclick:stopPropagation="true">Terugzetten</button>
                                    }
                                </div>
                            }
                        </aside>
                        }
                    </div>
                    @if (_bijlagen.FirstOrDefault(x => x.FileStoreId == _voorbeeldVan && x.IsHtml) is { } html)
                    {
                        @* afgeschermd: het bestand draait in een eigen herkomst en kan niet bij de app (WikiApi.VoorbeeldBeleid) *@
                        <div class="wk-voorbeeld">
                            <div class="wk-voorbeeldkop">
                                <b>🌐 @html.Naam</b>
                                <span class="groei"></span>
                                <a class="klein cs-knoplink" href="@(Wiki.BijlageAdres + html.FileStoreId + "/voorbeeld")" target="_blank" rel="noopener">Groot, in een nieuw tabblad</a>
                                <button type="button" class="klein" @onclick="() => _voorbeeldVan = null">Sluiten</button>
                            </div>
                            <iframe @key="html.FileStoreId" sandbox="allow-scripts" referrerpolicy="no-referrer"
                                    src="@(Wiki.BijlageAdres + html.FileStoreId + "/voorbeeld")" title="@html.Naam"></iframe>
                        </div>
                    }
                }
                else if (_ruimte is { } ru)
                {
                    @* ----- de artikelen van een ruimte ----- *@
                    @if (ru.OuderId is not null)
                    {
                        <div class="wk-kruimels">
                            @foreach (var o in Voorouders(ru.Id)) { <a href="@($"wiki?ruimte={o.Id}")">@o.Naam</a><span>›</span> }
                        </div>
                    }
                    <div class="cs-leeskop">
                        <h2>@Ico(ru.Icoon) @ru.Naam</h2>
                        <span class="cs-zacht">@ru.Omschrijving</span>
                        <span class="groei"></span>
                        <label class="vink"><input type="checkbox" checked="@_ookInactief" @onchange="InactiefGewijzigd" /> ook inactief</label>
                        @if (MagSchrijven) { <button type="button" class="primair klein" @onclick="() => Nieuw(ru.Id)">+ Nieuw artikel</button> }
                    </div>
                    @if (_ruimtes.Any(x => x.OuderId == ru.Id))
                    {
                        @* rechtermuisknop op een tegel: het menu van die subruimte; ernaast: een subruimte erbij *@
                        <div class="wk-subs" @oncontextmenu="e => OpenMenu(e, ru)" @oncontextmenu:preventDefault="MagSchrijven">
                            @foreach (var sub in _ruimtes.Where(x => x.OuderId == ru.Id))
                            {
                                var n = Totaal(sub.Id);
                                <a class="wk-sub @(_menu?.Ruimte?.Id == sub.Id ? "gekozen" : "") @(Sleept && _sleepDoel == sub.Id ? "sleepdoel" : "")" href="@($"wiki?ruimte={sub.Id}")" title="@sub.Omschrijving"
                                   ondragover="event.preventDefault()" @ondragenter="() => SleepOver(sub.Id)" @ondrop="() => LaatVallen(sub.Id)"
                                   @oncontextmenu="e => OpenMenu(e, sub)" @oncontextmenu:preventDefault="MagSchrijven" @oncontextmenu:stopPropagation="true">
                                    <b>@Ico(sub.Icoon) @sub.Naam</b>
                                    <span class="cs-zacht">@(n == 0 ? "leeg" : n == 1 ? "1 artikel" : n + " artikelen")</span>
                                </a>
                            }
                        </div>
                    }
                    @if (_artikelen.Count == 0)
                    {
                        <p class="uitleg">In deze ruimte zelf staat nog niets.@(MagSchrijven ? " Begin met \"+ Nieuw artikel\"." : "")</p>
                    }
                    @foreach (var groep in _artikelen.GroupBy(x => x.Sectie.Length > 0 ? x.Sectie : "Algemeen").OrderBy(g => g.Key == "Algemeen" ? "" : g.Key))
                    {
                        <div class="cs-kopje">@groep.Key</div>
                        @* Firefox begint pas te slepen als er iets "meegegeven" wordt; dat doet de browser hier zelf, de app hoort het van de regel *@
                        <table class="cs-tabel" ondragstart="event.dataTransfer.setData('text/plain', 'artikel'); event.dataTransfer.effectAllowed = 'move';">
                            <tbody>
                                @foreach (var x in groep)
                                {
                                    @* slepen: de regel op een ruimte in de zijbalk of op een tegel laten vallen zet het artikel daarheen *@
                                    <tr class="@(x.Actief ? "" : "cs-vervallen") @(_sleept?.Id == x.Id ? "wk-sleept" : "")" @key="x.Id" draggable="@(MagSchrijven ? "true" : "false")"
                                        @ondragstart="() => { _sleept = x; _sleepDoel = null; }" @ondragend="() => { _sleept = null; _sleepDoel = null; }"
                                        title="@(MagSchrijven ? "Sleep de regel naar een andere ruimte om het artikel te verplaatsen" : null)">
                                        <td><a class="wk-titel" draggable="false" href="@(Wiki.ArtikelAdres + x.Id)">@x.Titel</a>@if (!x.Actief) { <span class="stand-chip s-rood">inactief</span> }</td>
                                        <td class="cs-zacht">@string.Join(" ", x.TagLijst.Select(t => "#" + t))</td>
                                        <td class="cs-zacht wk-smal">@(x.ProjectId is null ? "" : x.ProjectTekst)</td>
                                        <td class="cs-zacht wk-smal">@x.GewijzigdOp.ToString("d-M-yyyy")@(x.GewijzigdDoor.Length > 0 ? " · " + x.GewijzigdDoor : "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }
                else
                {
                    @* ----- de startpagina ----- *@
                    <div class="cs-tekst wk-start">
                        <h2>Welkom op de wiki</h2>
                        <p>Hier staat wat we als MDE willen onthouden: hoe we werken, wat we geleerd hebben, en waar je iets vindt.
                            Kies links een ruimte, of zoek in alles tegelijk.</p>
                        <ul>
                            <li><b>Schrijven kan direct.</b> Open een ruimte en kies "+ Nieuw artikel", of klik in een artikel op Bewerken.</li>
                            <li><b>Elke wijziging is terug te draaien.</b> Bij elk artikel staan alle versies; een oude versie zet je met een klik terug.</li>
                            <li><b>Inactief, niet weg.</b> Een verouderd artikel zet je inactief; het is terug te halen via "ook inactief".</li>
                            <li><b>Verwijzen.</b> Met <code>[[Titel]]</code> in de tekst maak je een link naar een ander artikel.</li>
                            <li><b>Niet in de wiki:</b> CAD-bestanden, 3D-modellen en schema's blijven op hun eigen plek; schrijf hier waar ze staan.</li>
                        </ul>
                    </div>
                    <div class="cs-kopje">Laatst gewijzigd</div>
                    @if (_recent.Count == 0) { <p class="uitleg">Er staat nog geen artikel in de wiki.</p> }
                    else
                    {
                        <table class="cs-tabel">
                            <tbody>
                                @foreach (var x in _recent)
                                {
                                    <tr @key="x.Id">
                                        <td><a class="wk-titel" href="@(Wiki.ArtikelAdres + x.Id)">@x.Titel</a></td>
                                        <td class="cs-zacht">@RuimteNaam(x.RuimteId)@(x.Sectie.Length > 0 ? " · " + x.Sectie : "")</td>
                                        <td class="cs-zacht wk-smal">@x.GewijzigdOp.ToString("d-M-yyyy HH:mm")@(x.GewijzigdDoor.Length > 0 ? " · " + x.GewijzigdDoor : "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }
            </main>
        </div>
    }
</div>

@* ----- het menu van de rechtermuisknop: op een ruimte, of op de lege plek in de zijbalk ----- *@
@if (_menu is { } mn)
{
    <div class="wk-menuscherm" @onclick="() => _menu = null" @oncontextmenu="() => _menu = null" @oncontextmenu:preventDefault="true"></div>
    <div class="wk-menu" role="menu" style="@($"left:min({mn.X}px, calc(100vw - 350px));top:min({mn.Y}px, calc(100vh - 200px))")">
        @if (mn.Bijlage is { } mb)
        {
            <div class="wk-menukop">@(mb.IsAfbeelding ? "🖼" : mb.IsHtml ? "🌐" : "📎") @mb.Naam</div>
            @if (mb.IsHtml)
            {
                <button type="button" role="menuitem" @onclick="() => { _menu = null; _voorbeeldVan = mb.FileStoreId; }">Bekijken</button>
            }
            <a role="menuitem" href="@(Wiki.BijlageAdres + mb.FileStoreId)" target="_blank" rel="noopener" @onclick="() => _menu = null">@(mb.IsAfbeelding ? "Openen in een nieuw tabblad" : "Downloaden")</a>
            <button type="button" role="menuitem" class="gevaar" @onclick="() => WisBijlage(mb)">Wissen…</button>
        }
        else if (mn.Ruimte is { } mr)
        {
            <div class="wk-menukop">@Ico(mr.Icoon) @mr.Naam</div>
            @if (Wiki.Diepte(_ruimtes, mr.Id) < Wiki.MaxDiepte)
            {
                <button type="button" role="menuitem" @onclick="() => { _menu = null; BeginRuimte(null, mr.Id); }">+ Subruimte onder @mr.Naam</button>
            }
            <button type="button" role="menuitem" @onclick="() => { _menu = null; BeginRuimte(null, mr.OuderId); }">+ Ruimte naast @mr.Naam</button>
            <button type="button" role="menuitem" @onclick="async () => { _menu = null; await Nieuw(mr.Id); }">+ Nieuw artikel in @mr.Naam</button>
            <button type="button" role="menuitem" @onclick="() => { _menu = null; BeginRuimte(mr, null); }">Naam, icoon en omschrijving…</button>
            var leeg = Totaal(mr.Id) == 0 && !_ruimtes.Any(x => x.OuderId == mr.Id);
            <button type="button" role="menuitem" class="gevaar" disabled="@(!leeg)" title="@(leeg ? "Deze lege ruimte weghalen" : "Kan alleen als de ruimte leeg is: zonder artikelen en zonder subruimtes")"
                    @onclick="() => WisRuimte(mr)">Wissen…</button>
        }
        else
        {
            <button type="button" role="menuitem" @onclick="() => { _menu = null; BeginRuimte(null, null); }">+ Nieuwe ruimte</button>
        }
    </div>
}

@* ----- een ruimte toevoegen of hernoemen ----- *@
@if (_ruimteVenster is { } rv)
{
    <div class="cmdk-overlay midden">
        <div class="factuurvenster cs-venster">
            <header class="bijlagekop">
                <h2>@(rv.Id != 0 ? "Ruimte wijzigen" : rv.OuderId is int oid ? "Nieuwe ruimte onder " + Pad(oid) : "Nieuwe ruimte")</h2>
            </header>
            <div class="factuurvenster-inhoud">
                <label class="cs-veld"><span>Naam</span>
                    <input id="wk-ruimtenaam" @ref="_ruimteNaamVeld" value="@rv.Naam" maxlength="100" @oninput="e => rv.Naam = (string?)e.Value ?? string.Empty" /></label>
                <div class="cs-veld"><span>Icoon (kies er een, of typ zelf een emoji; mag leeg)</span>
                    <div class="wk-icoonrij">
                        <span class="wk-icoongroot" title="Zo ziet het eruit">@Ico(rv.Icoon)</span>
                        <input value="@rv.Icoon" maxlength="16" style="max-width:9rem" aria-label="Icoon" @oninput="e => rv.Icoon = (string?)e.Value ?? string.Empty" />
                        <input value="@_icoonZoek" placeholder="Zoek een icoon: printplaat, tandwiel…" aria-label="Icoon zoeken" autocomplete="off"
                               @oninput="e => _icoonZoek = (string?)e.Value ?? string.Empty" />
                        @if (rv.Icoon.Length > 0) { <button type="button" class="klein" @onclick="() => rv.Icoon = string.Empty">Geen</button> }
                    </div>
                    <div class="wk-iconen">
                        @foreach (var naam in IcoonKeuzes())
                        {
                            var n = naam;
                            <button type="button" class="@(rv.Icoon == n ? "gekozen" : "")" title="@n" @onclick="() => rv.Icoon = n">@((MarkupString)(Iconen.Svg(n) ?? ""))</button>
                        }
                    </div>
                </div>
                <label class="cs-veld"><span>Omschrijving (mag leeg)</span>
                    <input value="@rv.Omschrijving" maxlength="300" @oninput="e => rv.Omschrijving = (string?)e.Value ?? string.Empty" /></label>
                <div class="cs-knoppen">
                    <button type="button" class="primair" disabled="@(_bezig || rv.Naam.Trim().Length == 0)" @onclick="BewaarRuimte">Bewaren</button>
                    <button type="button" class="klein" disabled="@_bezig" @onclick="() => _ruimteVenster = null">Annuleren</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Wat er open staat volgt uit het adres.</summary>
    [SupplyParameterFromQuery(Name = "ruimte")] public int? RuimteParam { get; set; }
    [SupplyParameterFromQuery(Name = "artikel")] public int? ArtikelParam { get; set; }

    private bool _geladen, _tabel, _fout, _bezig, _ookInactief, _voorbeeld, _zoekBezig;
    private string? _melding;
    private string _zoek = "", _opmerking = "", _projectZoek = "", _html = "";
    private List<WikiRuimte> _ruimtes = new();
    private WikiRuimte? _ruimte;
    private List<WikiArtikel> _artikelen = new(), _recent = new();
    private WikiArtikel? _artikel, _bewerk;
    private List<WikiVersie> _versies = new();
    private WikiVersie? _oud;                   // een oude versie die nu in beeld staat
    private List<WikiBijlage> _bijlagen = new();
    private List<WikiTreffer> _treffers = new();
    private List<ProjectRegel> _projectGevonden = new();
    private List<string> _secties = new(), _alleTags = new();
    private Dictionary<string, int> _titels = new(StringComparer.OrdinalIgnoreCase);
    private CancellationTokenSource? _pauze, _projectPauze;
    private int _invoer;
    private int? _voorbeeldVan;                 // de HTML-bijlage die nu in het kader staat
    private bool _toonVersies;                  // de lijst met versies is opengeklapt (blijft zo tijdens het bladeren)

    /// <summary>Hangt er precies een HTML-bestand aan het artikel, dan staat het meteen in beeld (zonder eerst Bekijken).</summary>
    private void ToonEnigeHtml()
    {
        var html = _bijlagen.Where(b => b.IsHtml).ToList();
        if (html.Count == 1) _voorbeeldVan = html[0].FileStoreId;
    }

    /// <summary>De versies staan in beeld: opengeklapt, of er staat een oude versie voor (dan moet je terug kunnen).</summary>
    private bool VersiesOpen => _toonVersies || _oud is not null;

    private void WisselVersies()
    {
        if (VersiesOpen)
        {
            _toonVersies = false;
            // dicht = terug naar de geldende versie, anders lees je ongemerkt een oude
            if (_oud is not null && _artikel is not null) { _oud = null; _html = Opmaak(_artikel.Inhoud); }
        }
        else _toonVersies = true;
    }
    private readonly HashSet<int> _open = new();    // de opengeklapte ruimtes in de zijbalk

    /// <summary>Het venster voor een nieuwe ruimte (Id 0, onder OuderId) of het wijzigen van een bestaande.</summary>
    private class RuimteInvoer { public int Id; public int? OuderId; public string Naam = "", Icoon = "", Omschrijving = ""; }
    private RuimteInvoer? _ruimteVenster;

    /// <summary>Het open menu van de rechtermuisknop: op welke ruimte (leeg = de lege plek in de zijbalk) en waar op het scherm.</summary>
    private record MenuPlek(WikiRuimte? Ruimte, int X, int Y, WikiBijlage? Bijlage = null);
    private MenuPlek? _menu;

    private void OpenBijlageMenu(MouseEventArgs e, WikiBijlage bijlage)
    {
        if (!MagSchrijven) return;
        _menu = new MenuPlek(null, (int)e.ClientX, (int)e.ClientY, bijlage);
    }

    /// <summary>
    /// Een bijlage wissen, na een vraag: het bestand gaat echt weg (anders dan een artikel, dat inactief wordt). Staat
    /// er in de tekst nog een verwijzing naar, dan zegt de vraag dat erbij.
    /// </summary>
    private async Task WisBijlage(WikiBijlage b)
    {
        _menu = null;
        if (_artikel is not { } a || !MagSchrijven) return;
        var inTekst = a.Inhoud.Contains($"({Wiki.BijlageAdres}{b.FileStoreId})", StringComparison.Ordinal);
        try
        {
            var ja = await JS.InvokeAsync<bool>("mdeBevestig",
                $"{b.Naam} wissen? Het bestand gaat echt weg en is niet terug te halen."
                + (inTekst ? " In de tekst van dit artikel staat nog een verwijzing naar dit bestand; die werkt daarna niet meer." : ""),
                new { kop = "⚠ Bijlage wissen", ja = "Wissen" });
            if (!ja) return;
            var weg = await Wiki.BijlageVerwijderAsync(a.Id, b.FileStoreId);
            if (_voorbeeldVan == b.FileStoreId) _voorbeeldVan = null;
            _bijlagen = await Wiki.BijlagenAsync(a.Id);
            Meld(weg ? $"{b.Naam} is gewist." : $"{b.Naam} stond er al niet meer.");
        }
        catch (Exception ex) { Meld("Wissen is niet gelukt: " + ex.GetBaseException().Message, true); }
    }

    private void OpenMenu(MouseEventArgs e, WikiRuimte? ruimte)
    {
        if (!MagSchrijven) return;      // dan blijft het gewone menu van de browser
        _menu = new MenuPlek(ruimte, (int)e.ClientX, (int)e.ClientY);
    }
    private (int? Ruimte, int? Artikel) _getoond = (-1, -1);

    private bool Zoekt => _zoek.Trim().Length >= 2;
    private int? HuidigeRuimte => _artikel?.RuimteId ?? _ruimte?.Id;
    /// <summary>Schrijven: elke aangemelde medewerker (review komt later). Zonder login (lokaal testen) ook.</summary>
    private bool MagSchrijven => Ik.WerknemerId is not null || (!Ik.Ingelogd && !Ik.IsWerkplek);

    private static string Label(ProjectRegel p) => $"{p.Nummer} {p.Omschrijving}".Trim();
    private string RuimteNaam(int id) => Pad(id);

    // ---- de boom van ruimtes ----

    /// <summary>De ruimtes onder <paramref name="ouder"/> met alles eronder, in de volgorde van de boom.</summary>
    private IEnumerable<(WikiRuimte R, int Diepte)> Boom(int? ouder, int diepte, bool alleenOpen = false)
    {
        if (diepte > 10) yield break;
        foreach (var r in _ruimtes.Where(x => x.OuderId == ouder))
        {
            yield return (r, diepte);
            if (alleenOpen && !_open.Contains(r.Id)) continue;
            foreach (var k in Boom(r.Id, diepte + 1, alleenOpen)) yield return k;
        }
    }

    /// <summary>Wat er in de zijbalk staat: de bovenste ruimtes en wat onder een opengeklapte ruimte hangt.</summary>
    private IEnumerable<(WikiRuimte R, int Diepte)> Zichtbaar() => Boom(null, 1, alleenOpen: true);

    /// <summary>De ruimtes boven deze, van boven naar beneden (zonder de ruimte zelf).</summary>
    private List<WikiRuimte> Voorouders(int id)
    {
        var uit = new List<WikiRuimte>();
        for (var r = _ruimtes.FirstOrDefault(x => x.Id == _ruimtes.FirstOrDefault(y => y.Id == id)?.OuderId); r is not null && uit.Count < 10;
             r = _ruimtes.FirstOrDefault(x => x.Id == r.OuderId)) uit.Insert(0, r);
        return uit;
    }

    /// <summary>"Software › PLC › Omron": waar een ruimte staat.</summary>
    private string Pad(int id)
        => string.Join(" › ", Voorouders(id).Select(r => r.Naam).Append(_ruimtes.FirstOrDefault(r => r.Id == id)?.Naam ?? ""));

    /// <summary>Het aantal artikelen in een ruimte en alles eronder.</summary>
    private int Totaal(int id) => (_ruimtes.FirstOrDefault(r => r.Id == id)?.Aantal ?? 0) + Boom(id, 1).Sum(x => x.R.Aantal);

    // ---- de cursor meteen in het eerste veld van een venster (wens gebruiker 25-11-2026) ----
    private ElementReference _ruimteNaamVeld, _titelVeld;
    private string? _focusNa;       // "ruimte" of "titel": na het tekenen de cursor daarin zetten

    protected override async Task OnAfterRenderAsync(bool eerste)
    {
        if (_focusNa is not { } wat) return;
        _focusNa = null;
        try
        {
            if (wat == "ruimte" && _ruimteVenster is not null) await _ruimteNaamVeld.FocusAsync();
            else if (wat == "titel" && _bewerk is not null) await _titelVeld.FocusAsync();
        }
        catch { /* het veld is intussen weer weg */ }
    }

    // ---- een artikel naar een andere ruimte slepen (wens gebruiker 25-11-2026) ----
    private WikiArtikel? _sleept;       // de regel die nu gesleept wordt
    private int? _sleepDoel;            // de ruimte waar hij boven hangt

    // ---- een ruimte verslepen: op een andere ruimte = eronder hangen, op de lege plek in de boom = bovenaan ----
    private WikiRuimte? _sleeptRuimte;  // de ruimte die nu gesleept wordt
    private bool _sleepBoven;           // hij hangt boven de lege plek van de boom
    private bool Sleept => _sleept is not null || _sleeptRuimte is not null;

    private void BeginSleepRuimte(WikiRuimte r) { if (MagSchrijven) { _sleeptRuimte = r; _sleept = null; _sleepDoel = null; _sleepBoven = false; } }
    private int? _sleepVoor;            // hij hangt boven de strook vóór deze ruimte
    private void EindeSlepen() { _sleeptRuimte = null; _sleept = null; _sleepDoel = null; _sleepBoven = false; _sleepVoor = null; }

    private void SleepOver(int ruimteId) { if (Sleept) { _sleepDoel = ruimteId; _sleepBoven = false; _sleepVoor = null; } }
    private void SleepVoor(int ruimteId) { if (_sleeptRuimte is not null) { _sleepVoor = ruimteId; _sleepDoel = null; _sleepBoven = false; } }

    /// <summary>Losgelaten op de strook vóór een ruimte: zelfde ouder als die ruimte, en ervoor.</summary>
    private async Task LaatVallenVoor(WikiRuimte voor)
    {
        var ruimte = _sleeptRuimte;
        EindeSlepen();
        if (ruimte is null || !MagSchrijven || ruimte.Id == voor.Id) return;
        try
        {
            await Wiki.VerplaatsRuimteAsync(ruimte.Id, voor.OuderId, voor.Id);
            if (voor.OuderId is int o) _open.Add(o);
            await Laad();
            Meld($"{ruimte.Naam} staat nu vóór {voor.Naam}.");
        }
        catch (Exception ex) { Meld(ex.GetBaseException().Message, true); }
    }

    private Task LaatVallenBoven() => _sleeptRuimte is null ? Task.CompletedTask : VerplaatsRuimte(null);

    private async Task VerplaatsRuimte(int? naar)
    {
        var ruimte = _sleeptRuimte;
        EindeSlepen();
        if (ruimte is null || !MagSchrijven || ruimte.Id == naar || ruimte.OuderId == naar) return;
        try
        {
            await Wiki.VerplaatsRuimteAsync(ruimte.Id, naar);
            if (naar is int o) _open.Add(o);
            await Laad();
            Meld(naar is int n ? $"{ruimte.Naam} hangt nu onder {Pad(n)}." : $"{ruimte.Naam} staat nu bovenaan in de boom.");
        }
        catch (Exception ex) { Meld(ex.GetBaseException().Message, true); }
    }

    /// <summary>Een lege ruimte wissen, na een vraag. Sta je in die ruimte, dan ga je naar de ruimte erboven (of de startpagina).</summary>
    private async Task WisRuimte(WikiRuimte r)
    {
        _menu = null;
        if (!MagSchrijven) return;
        try
        {
            if (!await JS.InvokeAsync<bool>("mdeBevestig", $"De ruimte {Pad(r.Id)} wissen? Dat kan alleen als hij leeg is, en is niet terug te draaien.",
                    new { kop = "⚠ Ruimte wissen", ja = "Wissen" })) return;
            await Wiki.VerwijderRuimteAsync(r.Id);
            Meld($"De ruimte {r.Naam} is gewist.");
            if (_ruimte?.Id == r.Id) Ga(r.OuderId is int o ? $"wiki?ruimte={o}" : "wiki");
            else await Laad();
        }
        catch (Exception ex) { Meld(ex.GetBaseException().Message, true); }
    }

    // ---- iconen: een naam uit de iconenset van de app (Lucide, zoals in de snelbalk) of een emoji ----
    private string _icoonZoek = "";
    private static readonly string[] IcoonVoorstel =
    {
        "circuit-board", "cpu", "cog", "wrench", "zap", "code", "factory", "bot", "ruler", "cable", "plug", "hammer", "banknote", "briefcase",
        "folder", "file-text", "book-open", "layers", "truck", "users", "shield", "lightbulb", "flask-conical", "wind",
    };

    /// <summary>De iconen om uit te kiezen: bij een zoektekst wat daarbij past, anders een rijtje voor de hand liggende.</summary>
    private IEnumerable<string> IcoonKeuzes()
        => (_icoonZoek.Trim().Length > 0 ? Iconen.Zoek(_icoonZoek, 60) : IcoonVoorstel.Where(Iconen.Bestaat))
           .Where(n => n.Length <= 16).Take(36);       // de kolom Icoon is 16 tekens

    /// <summary>Het icoon van een ruimte: een getekend icoon als het een naam uit de set is, anders de tekst zelf (een emoji).</summary>
    private MarkupString Ico(string? icoon)
        => Iconen.Svg(icoon) is { } svg ? new MarkupString($"<span class=\"wk-ico\">{svg}</span>")
                                        : new MarkupString(System.Net.WebUtility.HtmlEncode(icoon ?? ""));

    private async Task LaatVallen(int ruimteId)
    {
        if (_sleeptRuimte is not null) { await VerplaatsRuimte(ruimteId); return; }
        var artikel = _sleept;
        EindeSlepen();
        if (artikel is null || !MagSchrijven || artikel.RuimteId == ruimteId) return;
        try
        {
            await Wiki.VerplaatsAsync(artikel.Id, ruimteId);
            _open.Add(ruimteId);
            await Laad();
            Meld($"{artikel.Titel} staat nu in {Pad(ruimteId)}.");
        }
        catch (Exception ex) { Meld("Verplaatsen is niet gelukt: " + ex.GetBaseException().Message, true); }
    }

    private void BeginRuimte(WikiRuimte? bestaand, int? ouderId)
    {
        if (!MagSchrijven) return;
        _focusNa = "ruimte";
        _icoonZoek = "";
        _ruimteVenster = bestaand is null ? new RuimteInvoer { OuderId = ouderId }
            : new RuimteInvoer { Id = bestaand.Id, OuderId = bestaand.OuderId, Naam = bestaand.Naam, Icoon = bestaand.Icoon, Omschrijving = bestaand.Omschrijving };
    }

    private async Task BewaarRuimte()
    {
        if (_ruimteVenster is not { } rv || _bezig || !MagSchrijven) return;
        _bezig = true;
        try
        {
            var id = await Wiki.BewaarRuimteAsync(rv.Id, rv.OuderId, rv.Naam, rv.Icoon, rv.Omschrijving);
            _ruimteVenster = null;
            if (rv.OuderId is int o) _open.Add(o);
            if (rv.Id == 0) { Meld($"De ruimte {rv.Naam.Trim()} is toegevoegd."); Ga($"wiki?ruimte={id}"); }
            else { await Laad(); Meld("De ruimte is gewijzigd."); }
        }
        catch (Exception ex) { Meld(ex.GetBaseException().Message, true); }
        _bezig = false;
    }
    private string Opmaak(string? tekst) => ActMarkdown.Html(Wiki.MetVerwijzingen(tekst ?? "", _titels), document: true, wiki: true);
    private void Meld(string tekst, bool fout = false) { _melding = tekst; _fout = fout; }
    private void Ga(string adres) { _zoek = ""; _treffers = new(); Nav.NavigateTo(adres); }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (!_geladen)
            {
                await Ik.ZorgGeladenAsync();
                _tabel = Wiki.Beschikbaar && await Wiki.AanwezigAsync();
            }
            if (_tabel && _getoond != (RuimteParam, ArtikelParam))
            {
                _getoond = (RuimteParam, ArtikelParam);
                _bewerk = null; _zoek = ""; _treffers = new();
                await Laad();
            }
        }
        catch (Exception ex) { Meld("Laden is niet gelukt: " + ex.GetBaseException().Message, true); }
        _geladen = true;
    }

    /// <summary>Alles voor wat het adres vraagt: het artikel, of de ruimte, of de startpagina.</summary>
    private async Task Laad()
    {
        _ruimtes = await Wiki.RuimtesAsync();
        _artikel = null; _ruimte = null; _oud = null; _html = ""; _voorbeeldVan = null;
        try { await LaadInhoud(); }
        finally
        {
            // de takken boven wat er open staat uitklappen, zodat je in de zijbalk ziet waar je bent
            if (HuidigeRuimte is int nu)
            {
                foreach (var o in Voorouders(nu)) _open.Add(o.Id);
                if (_ruimte is not null) _open.Add(nu);     // in een ruimte: ook zijn eigen subruimtes tonen
            }
        }
    }

    private async Task LaadInhoud()
    {
        if (ArtikelParam is int aid)
        {
            _artikel = await Wiki.ArtikelAsync(aid);
            if (_artikel is null) { Meld("Dit artikel bestaat niet (meer).", true); }
            else
            {
                _titels = await Wiki.TitelsAsync();
                _html = Opmaak(_artikel.Inhoud);
                _versies = await Wiki.VersiesAsync(aid);
                _bijlagen = await Wiki.BijlagenAsync(aid);
                ToonEnigeHtml();
                return;
            }
        }
        if (RuimteParam is int rid && _ruimtes.FirstOrDefault(r => r.Id == rid) is { } ru)
        {
            _ruimte = ru;
            _artikelen = await Wiki.ArtikelenAsync(rid, _ookInactief);
            return;
        }
        _recent = await Wiki.RecentAsync();
    }

    private async Task InactiefGewijzigd(ChangeEventArgs e)
    {
        _ookInactief = e.Value is true;
        if (_ruimte is not null) _artikelen = await Wiki.ArtikelenAsync(_ruimte.Id, _ookInactief);
    }

    // ------------------------------------------------------------------ zoeken

    private async Task ZoekInput(ChangeEventArgs e)
    {
        _zoek = (string?)e.Value ?? "";
        _pauze?.Cancel();
        var pauze = _pauze = new CancellationTokenSource();
        _zoekBezig = true;
        try { await Task.Delay(250, pauze.Token); } catch (TaskCanceledException) { return; }
        await Zoek(pauze);
    }

    private async Task ZoekOp(string tag) { _zoek = tag; await Zoek(null); }

    private async Task Zoek(CancellationTokenSource? pauze)
    {
        try
        {
            var gevonden = Zoekt ? await Wiki.ZoekAsync(_zoek) : new();
            if (pauze is null || !pauze.IsCancellationRequested) _treffers = gevonden;
        }
        catch (Exception ex) { Meld("Zoeken is niet gelukt: " + ex.GetBaseException().Message, true); }
        _zoekBezig = false;
    }

    // ------------------------------------------------------------------ lezen: versies

    private async Task ToonVersie(WikiArtikel a, WikiVersie v)
    {
        if (v.Versie == a.Versie) { _oud = null; _html = Opmaak(a.Inhoud); return; }
        try
        {
            _html = Opmaak(await Wiki.VersieInhoudAsync(v.Id) ?? "");
            _oud = v;
        }
        catch (Exception ex) { Meld("De versie ophalen is niet gelukt: " + ex.GetBaseException().Message, true); }
    }

    private async Task ZetTerug(WikiArtikel a, WikiVersie v)
    {
        if (!MagSchrijven) return;
        try
        {
            await Wiki.TerugzettenAsync(a.Id, v, Ik.WerknemerId);
            await Laad();
            Meld($"v{v.Versie} is teruggezet als v{_artikel?.Versie}.");
        }
        catch (Exception ex) { Meld("Terugzetten is niet gelukt: " + ex.GetBaseException().Message, true); }
    }

    private async Task ZetActief(WikiArtikel a, bool actief)
    {
        if (!MagSchrijven) return;
        try
        {
            await Wiki.ZetActiefAsync(a.Id, actief);
            await Laad();
            Meld(actief ? $"{a.Titel} staat weer in de lijsten." : $"{a.Titel} is inactief. Het staat nog in de ruimte onder \"ook inactief\" en is daar terug te halen.");
        }
        catch (Exception ex) { Meld("Dat is niet gelukt: " + ex.GetBaseException().Message, true); }
    }

    private async Task KopieerLink()
    {
        if (_artikel is null) return;
        var adres = Nav.ToAbsoluteUri(Wiki.ArtikelAdres + _artikel.Id).ToString();
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", adres); Meld("Het adres van dit artikel staat op het klembord."); }
        catch { Meld(adres); }
    }

    // ------------------------------------------------------------------ schrijven

    private async Task Nieuw(int ruimteId)
    {
        if (!MagSchrijven) return;
        _bewerk = new WikiArtikel { RuimteId = ruimteId };
        _focusNa = "titel";       // nieuw artikel: meteen de titel typen (bij bewerken niet, daar lees je eerst)
        await Begin();
    }

    private async Task Bewerk(WikiArtikel a)
    {
        if (!MagSchrijven) return;
        // een eigen kopie: Annuleren laat het artikel zoals het was
        _bewerk = new WikiArtikel
        {
            Id = a.Id, RuimteId = a.RuimteId, Titel = a.Titel, Sectie = a.Sectie, Tags = a.Tags, Inhoud = a.Inhoud, Versie = a.Versie,
            ProjectId = a.ProjectId, ProjectTekst = a.ProjectTekst,
        };
        await Begin();
    }

    private async Task Begin()
    {
        _opmerking = ""; _projectZoek = ""; _projectGevonden = new(); _voorbeeld = false;
        try
        {
            _titels = await Wiki.TitelsAsync();
            (_secties, _alleTags) = await Wiki.VoorstellenAsync(_bewerk!.RuimteId);
        }
        catch { }
    }

    private async Task RuimteGekozen(ChangeEventArgs e)
    {
        if (_bewerk is null || !int.TryParse((string?)e.Value, out var id)) return;
        _bewerk.RuimteId = id;
        try { (_secties, _alleTags) = await Wiki.VoorstellenAsync(id); } catch { }
    }

    private async Task ProjectZoekInput(ChangeEventArgs e)
    {
        _projectZoek = (string?)e.Value ?? "";
        _projectPauze?.Cancel();
        var pauze = _projectPauze = new CancellationTokenSource();
        try { await Task.Delay(250, pauze.Token); } catch (TaskCanceledException) { return; }
        var q = _projectZoek.Trim();
        try { _projectGevonden = q.Length == 0 ? new() : await Projecten.ZoekProjectenAsync(null, q, null, 0, 8); }
        catch { _projectGevonden = new(); }
    }

    private void KiesProject(WikiArtikel b, ProjectRegel p)
    {
        b.ProjectId = p.Id; b.ProjectTekst = Label(p);
        _projectZoek = ""; _projectGevonden = new();
    }

    private void Annuleer() => _bewerk = null;

    private async Task Bewaar()
    {
        if (_bewerk is not { } b || _bezig || !MagSchrijven) return;
        _bezig = true;
        try
        {
            var id = await Wiki.BewaarAsync(b, _opmerking, Ik.WerknemerId);
            _bewerk = null;
            Meld($"{b.Titel.Trim()} is opgeslagen.");
            if (ArtikelParam == id) await Laad();
            else Nav.NavigateTo(Wiki.ArtikelAdres + id);
        }
        catch (WikiConflictException ex) { Meld(ex.Message, true); }
        catch (Exception ex) { Meld("Opslaan is niet gelukt: " + ex.GetBaseException().Message, true); }
        _bezig = false;
    }

    // ------------------------------------------------------------------ bijlagen

    private async Task BijlageOntvangen(InputFileChangeEventArgs e, int artikelId)
    {
        if (!MagSchrijven) return;
        var geweigerd = new List<string>();
        var gelukt = 0;
        foreach (var f in e.GetMultipleFiles(10))
        {
            if (f.Size == 0 || f.Size > Wiki.MaxBijlage) { geweigerd.Add($"{f.Name}: leeg of groter dan 25 MB"); continue; }
            try
            {
                using var m = new MemoryStream();
                await using (var s = f.OpenReadStream(Wiki.MaxBijlage)) await s.CopyToAsync(m);
                await Wiki.BijlageToevoegenAsync(artikelId, f.Name, m.ToArray(), Ik.WerknemerId);
                gelukt++;
            }
            catch (Exception ex) { geweigerd.Add($"{f.Name}: {ex.GetBaseException().Message}"); }
        }
        _invoer++;
        try { _bijlagen = await Wiki.BijlagenAsync(artikelId); if (_bewerk is null) ToonEnigeHtml(); } catch { }
        if (geweigerd.Count > 0) Meld("Niet toegevoegd: " + string.Join("; ", geweigerd), true);
        else if (gelukt > 0) Meld(gelukt == 1 ? "De bijlage is toegevoegd." : $"{gelukt} bijlagen zijn toegevoegd.");
    }
}
