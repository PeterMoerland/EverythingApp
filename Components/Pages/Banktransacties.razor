@page "/financien/banktransacties"
@inject IBankRepository Repo
@inject HuidigeGebruiker Ik
@inject RabobankOphaler Rabobank
@inject NavigationManager Nav

<div class="page">
    <header class="topbar">
        <h1>Banktransacties</h1>
        <span class="weeklabel">@_totalen.Aantal transacties · @Bedrag(_totalen.Totaal)</span>
        @if (_rekeningen.Count > 0)
        {
            <button class="klein" @onclick="OpenImport">⭱ Importeren</button>
        }
    </header>

    @if (_rabo is not null)
    {
        <section class="rabo-blok @(_rabo.Fout.Length > 0 ? "fout" : "")">
            <div class="rabo-kop">
                <strong>Rabobank</strong>
                @if (_rabo.Sandbox) { <span class="rabo-label">sandbox</span> }
                else if (!Rabobank.SchrijftWeg) { <span class="rabo-label">alleen kijken</span> }

                @if (!_rabo.Ingesteld)
                {
                    <span class="rabo-tekst">Nog niet ingesteld (sectie Rabobank in appsettings.json).</span>
                }
                else if (!_rabo.Gekoppeld)
                {
                    <span class="rabo-tekst">Niet gekoppeld.</span>
                    <a class="knop klein" href="rabobank/koppel">Koppelen</a>
                }
                else
                {
                    <span class="rabo-tekst">
                        Gekoppeld@(_rabo.GekoppeldOp is DateTime gk ? " sinds " + gk.ToString("d-M-yyyy") : "")
                        · laatst opgehaald @(_rabo.LaatstOpgehaald is DateTime lo ? lo.ToString("d-M HH:mm") : "nog niet")
                        @if (_rabo.VolgendeKeer is DateTime vk) { <text> · volgende @vk.ToString("HH:mm")</text> }
                    </span>
                    <button class="klein" disabled="@(_rabo.Bezig || _raboBezig)" @onclick="RabobankNu">
                        @(_rabo.Bezig || _raboBezig ? "Bezig…" : "Nu ophalen")
                    </button>
                    <a class="knop klein" href="rabobank/koppel" title="Opnieuw toestemming geven">Opnieuw koppelen</a>
                }
            </div>

            @if (_rabo.Fout.Length > 0)
            {
                <div class="rabo-fout">@_rabo.Fout</div>
            }

            @if (_rabo.Rekeningen.Count > 0)
            {
                <table class="rabo-rek">
                    <tr><th>Rekening</th><th>Opgehaald</th><th>@(Rabobank.SchrijftWeg ? "Nieuw" : "Zou nieuw zijn")</th><th>Al aanwezig</th><th>Saldo bank</th></tr>
                    @foreach (var rr in _rabo.Rekeningen)
                    {
                        <tr>
                            <td>@rr.Iban</td><td>@rr.Opgehaald</td><td>@rr.Toegevoegd</td><td>@rr.AlAanwezig</td>
                            <td class="bedrag">@Saldo(rr.Saldo)</td>
                        </tr>
                    }
                </table>
            }

            @if (_rabo.Proef.Count > 0)
            {
                <details class="rabo-proef">
                    <summary>Wat er binnenkwam (@_rabo.Proef.Count regels, niet weggeschreven)</summary>
                    <table>
                        <tr><th>Datum</th><th>Rekening</th><th>Volgnr</th><th>Bedrag</th><th>Saldo na</th><th>Tegenpartij</th><th>Omschrijving</th></tr>
                        @foreach (var pr in _rabo.Proef)
                        {
                            <tr>
                                <td>@pr.Datum.ToString("d-M-yyyy")</td><td>@pr.Rekening</td><td>@pr.Volgnummer</td>
                                <td class="bedrag">@Bedrag(pr.Bedrag)</td><td class="bedrag">@Bedrag(pr.SaldoNa)</td>
                                <td>@pr.NaamTegenpartij @pr.Tegenrekening</td><td>@pr.Omschrijving</td>
                            </tr>
                        }
                    </table>
                </details>
            }
        </section>
    }

    @if (!Repo.Beschikbaar)
    {
        <section class="module-placeholder"><p>Dit scherm werkt alleen met de live database.</p></section>
    }
    else if (_rekeningen.Count == 0)
    {
        <section class="module-placeholder">
            <p>
                Je hebt (nog) geen rechten op een bankrekening. Wie welke rekening mag zien
                staat in de tabel BankRekeningRechten.
            </p>
        </section>
    }
    else
    {
        @if (_melding is not null)
        {
            <div class="melding @(_fout ? "fout" : "ok")" @onclick="SluitMelding">@_melding</div>
        }

        @* ---------- filters ---------- *@
        <div class="bankfilters">
            <label class="bankveld">
                <span>Van</span>
                <NlDatum Waarde="_van" WaardeChanged="VanGewijzigd" />
            </label>
            <label class="bankveld">
                <span>Tot en met</span>
                <NlDatum Waarde="_tot" WaardeChanged="TotGewijzigd" />
            </label>

            <div class="btngroup">
                <button class="klein" title="Vorige periode" @onclick="VorigePeriode">◀</button>
                <button class="klein" @onclick="DezeMaand">Deze maand</button>
                <button class="klein" @onclick="DitKwartaal">Dit kwartaal</button>
                <button class="klein" @onclick="DitJaar">Dit jaar</button>
                <button class="klein" title="Volgende periode" @onclick="VolgendePeriode">▶</button>
            </div>

            <label class="bankveld groei">
                <span>Zoeken</span>
                <span class="zoekregel">
                    <input placeholder="Omschrijving, tegenpartij, opmerking…" value="@_zoek"
                           @onchange="ZoekGewijzigd" />
                    <button class="klein" disabled="@(_zoek.Length == 0)" @onclick="WisZoek">✕</button>
                </span>
            </label>

            <label class="bankveld">
                <span>Rekening</span>
                <select value="@RekeningTekst" @onchange="RekeningGewijzigd">
                    <option value="">Alle rekeningen</option>
                    @foreach (var r in _rekeningen)
                    {
                        <option value="@r.Nummer">@r.Volledig</option>
                    }
                </select>
            </label>

            @if (_pasnummers.Count > 0)
            {
                <label class="bankveld">
                    <span>Bankpas</span>
                    <select value="@PasTekst" @onchange="PasGewijzigd">
                        <option value="">Alle</option>
                        @foreach (var p in _pasnummers)
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                </label>
            }

            <label class="bankveld">
                <span>Bij/Af</span>
                <select value="@_bijAf.ToString()" @onchange="BijAfGewijzigd">
                    <option value="@BijAf.Beide">Bij en Af</option>
                    <option value="@BijAf.Bij">Alleen bij</option>
                    <option value="@BijAf.Af">Alleen af</option>
                </select>
            </label>
        </div>

        @* ---------- de transacties ---------- *@
        <div class="regels-omhulsel">
            <table class="kiezer-tabel banktabel">
                <thead>
                    <tr>
                        <th style="width:6.5rem">Datum</th>
                        <th style="width:8rem" class="r">Bedrag</th>
                        <th style="width:12rem">Tegenrekening</th>
                        <th style="width:15rem">Tenaamstelling</th>
                        <th>Omschrijving</th>
                        <th style="width:14rem">Opmerking</th>
                        <th style="width:3rem"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in _lijst)
                    {
                        <tr @key="t.Id" class="@(t.Id == _detail?.Id ? "gekozen-rij" : "")">
                            <td>@(t.Datum?.ToString("dd-MM-yyyy") ?? "")</td>
                            <td class="r @(t.Bij ? "bedrag-bij" : "")">@Bedrag(t.Bedrag)</td>
                            <td class="iban">@t.Tegenrekening</td>
                            <td>@t.Tenaamstelling</td>
                            <td class="omschrijving" title="@t.Omschrijving">@t.Omschrijving</td>
                            <td>
                                <input value="@t.Opmerking" maxlength="50"
                                       @onchange="e => ZetOpmerking(t, e)" />
                            </td>
                            <td class="c">
                                <button class="klein" title="Alle gegevens van deze transactie"
                                        @onclick="() => OpenDetail(t)">🔍</button>
                            </td>
                        </tr>
                    }
                    @if (_lijst.Count == 0)
                    {
                        <tr><td colspan="7" class="kiezer-info">Geen transacties in deze periode.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        @* ---------- de cijfers eronder ---------- *@
        <div class="banktotalen">
            <span><b>Totaal</b> @Bedrag(_totalen.Totaal)</span>
            <span><b>Aantal</b> @_totalen.Aantal</span>
            <span><b>Saldo gekozen rekening</b> @Saldo(_totalen.SaldoRekening)</span>
            <span><b>Saldo alle rekeningen</b> @Saldo(_totalen.SaldoAlle)</span>
            <span>
                <b>Laatste transactie</b>
                @(_totalen.Laatste?.ToString("dd-MM-yyyy") ?? "—")
                @if (_totalen.DagenOud is int dagen)
                {
                    <span class="@(dagen > 3 ? "oud" : "")">(@dagen dagen oud)</span>
                }
            </span>
        </div>
    }

    <footer class="voet">
        Het koppelen van transacties aan facturen volgt zodra de facturenmodule
        is omgezet; daarvoor gebruik je voorlopig Access.
    </footer>
</div>

@* ---------- importvenster ---------- *@
@if (_importOpen)
{
    <div class="cmdk-overlay" @onclick="SluitImport">
        <div class="prijsvenster" @onclick:stopPropagation>
            <header class="bijlagekop">
                <h2>Banktransacties importeren</h2>
                <button class="klein" @onclick="SluitImport">✕</button>
            </header>

            <div class="prijs-inhoud">
                <p class="uitleg">
                    Download de transacties op rabobank.nl in CSV-formaat en kies
                    hieronder het bestand. Transacties die er al staan worden
                    overgeslagen — dubbel importeren kan dus geen kwaad.
                </p>

                @* De @key maakt het invoerveld nieuw na elke import; anders doet
                   nogmaals hetzelfde bestand kiezen niets (browsergedrag). *@
                <label class="bestandknop" @key="_importRonde">
                    @(_importBezig ? "Bezig met importeren…" : "Kies het CSV-bestand…")
                    <InputFile OnChange="ImportBestand" accept=".csv" disabled="@_importBezig" />
                </label>

                @if (_import is not null)
                {
                    <div class="importcijfers">
                        <span><b>@_import.Verwerkt</b> regels gelezen</span>
                        <span class="import-nieuw"><b>@_import.Toegevoegd</b> toegevoegd</span>
                        <span><b>@_import.AlAanwezig</b> stonden er al</span>
                    </div>

                    @foreach (var fout in _import.Fouten)
                    {
                        <p class="import-fout">@fout</p>
                    }

                    @if (_import.Gelukt)
                    {
                        <p class="uitleg">
                            Klaar. Het overzicht hieronder is bijgewerkt; het venster kan dicht.
                        </p>
                    }
                }
            </div>
        </div>
    </div>
}

@* ---------- detailvenster ---------- *@
@if (_detail is not null)
{
    <div class="cmdk-overlay" @onclick="SluitDetail">
        <div class="voorbeeldvenster bankdetail" @onclick:stopPropagation>
            <header class="bijlagekop">
                <h2>Transactie @(_detail.Datum?.ToString("dd-MM-yyyy") ?? "") · @Bedrag(_detail.Bedrag)</h2>
                <button class="klein" @onclick="SluitDetail">✕</button>
            </header>

            <div class="voorbeeld-inhoud bankdetail-inhoud">
                <div class="wn-velden">
                    <div class="wn-veld"><label>Rekening</label><span class="alleen-lezen">@_detail.Rekening @_detail.Bic</span></div>
                    <div class="wn-veld"><label>Datum</label><span class="alleen-lezen">@(_detail.Datum?.ToString("dd-MM-yyyy") ?? "")</span></div>
                    <div class="wn-veld"><label>Volgnummer</label><span class="alleen-lezen">@_detail.Volgnummer</span></div>
                    <div class="wn-veld"><label>Rentedatum</label><span class="alleen-lezen">@(_detail.Rentedatum?.ToString("dd-MM-yyyy") ?? "")</span></div>
                    <div class="wn-veld"><label>Bedrag</label><span class="alleen-lezen">@Bedrag(_detail.Bedrag) @_detail.Munt</span></div>
                    <div class="wn-veld"><label>Saldo na transactie</label><span class="alleen-lezen">@Saldo(_detail.SaldoNa)</span></div>
                    <div class="wn-veld"><label>Sombedrag</label><span class="alleen-lezen">@Saldo(_detail.Sombedrag)</span></div>
                    <div class="wn-veld"><label>Oorspronkelijk bedrag</label><span class="alleen-lezen">@Saldo(_detail.OorspronkelijkBedrag) @_detail.OorspronkelijkeMunt</span></div>

                    <div class="wn-veld breed"><label>Omschrijving</label><span class="alleen-lezen">@_detail.Omschrijving</span></div>

                    <div class="wn-veld"><label>Tegenrekening</label><span class="alleen-lezen">@_detail.Tegenrekening</span></div>
                    <div class="wn-veld"><label>BIC tegenpartij</label><span class="alleen-lezen">@_detail.BicTegenpartij</span></div>
                    <div class="wn-veld"><label>Naam tegenpartij</label><span class="alleen-lezen">@_detail.NaamTegenpartij</span></div>
                    <div class="wn-veld"><label>Uiteindelijke partij</label><span class="alleen-lezen">@_detail.NaamUiteindelijkePartij</span></div>
                    <div class="wn-veld"><label>Initiërende partij</label><span class="alleen-lezen">@_detail.NaamInitierendePartij</span></div>

                    <div class="wn-veld"><label>Code</label><span class="alleen-lezen">@_detail.Code</span></div>
                    <div class="wn-veld"><label>Batch-ID</label><span class="alleen-lezen">@_detail.BatchId</span></div>
                    <div class="wn-veld"><label>Transactiereferentie</label><span class="alleen-lezen">@_detail.Transactiereferentie</span></div>
                    <div class="wn-veld"><label>Machtigingskenmerk</label><span class="alleen-lezen">@_detail.MachtigingsKenmerk</span></div>
                    <div class="wn-veld"><label>Incassant-ID</label><span class="alleen-lezen">@_detail.IncassantId</span></div>
                    <div class="wn-veld"><label>Betalingskenmerk</label><span class="alleen-lezen">@_detail.Betalingskenmerk</span></div>
                    <div class="wn-veld"><label>Reden retour</label><span class="alleen-lezen">@_detail.RedenRetour</span></div>
                    <div class="wn-veld"><label>Bankpas</label><span class="alleen-lezen">@_detail.Pasnummer</span></div>

                    <div class="wn-veld"><label>Geïmporteerd</label>
                        <span class="alleen-lezen">
                            @(_detail.Importdatum?.ToString("dd-MM-yyyy HH:mm") ?? "")
                            @if (!string.IsNullOrWhiteSpace(_detail.GeimporteerdDoor))
                            {
                                <text> door @_detail.GeimporteerdDoor</text>
                            }
                        </span>
                    </div>

                    <div class="wn-veld breed">
                        <label>Opmerking</label>
                        <input value="@_detail.Opmerking" maxlength="50" @onchange="DetailOpmerkingGewijzigd" />
                    </div>
                </div>

                <p class="uitleg">
                    De gekoppelde facturen komen erbij zodra de facturenmodule is omgezet.
                </p>
            </div>
        </div>
    </div>
}

@code {
    private List<Bankrekening> _rekeningen = new();
    private List<Banktransactie> _lijst = new();
    private List<int> _pasnummers = new();
    private BankTotalen _totalen = new(0, 0, null, null, null);

    private DateOnly _van = DateOnly.FromDateTime(DateTime.Today.AddMonths(-1));
    private DateOnly _tot = DateOnly.FromDateTime(DateTime.Today);
    private string _zoek = "";
    private string _rekening = "";       // leeg = alle rekeningen waar ik bij mag
    private int? _pas;
    private BijAf _bijAf = BijAf.Beide;

    private BanktransactieDetail? _detail;
    private string? _melding;
    private bool _fout;

    private string RekeningTekst => _rekening;
    private string PasTekst => _pas is int p ? p.ToString() : "";

    private static string Bedrag(decimal waarde)
        => waarde.ToString("C2", new System.Globalization.CultureInfo("nl-NL"));

    private static string Saldo(decimal? waarde) => waarde is null ? "—" : Bedrag(waarde.Value);

    /// <summary>De rekeningnummers waar deze gebruiker bij mag, of alleen de gekozene.</summary>
    private List<string> Gekozen()
        => string.IsNullOrWhiteSpace(_rekening)
            ? _rekeningen.Select(r => r.Nummer).ToList()
            : new List<string> { _rekening };

    private List<string> Alle() => _rekeningen.Select(r => r.Nummer).ToList();

    // ---- Rabobank-koppeling (alleen voor Financial en Directie) ----
    private RabobankStand? _rabo;
    private bool _raboBezig;

    private void LeesRabobank()
        => _rabo = Ik.MagEenVan("Financial", "Directie") ? Rabobank.Stand : null;

    private async Task RabobankNu()
    {
        _raboBezig = true;
        var fout = await Rabobank.HaalOpAsync();
        _raboBezig = false;
        LeesRabobank();
        if (fout is null)
        {
            Toon(Rabobank.SchrijftWeg ? "Opgehaald bij de Rabobank." : "Opgehaald bij de Rabobank (niets weggeschreven).", false);
            if (Rabobank.SchrijftWeg) await Laad();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Ik.ZorgGeladenAsync();
        LeesRabobank();
        var vraag = Nav.ToAbsoluteUri(Nav.Uri).Query;
        if (vraag.Contains("rabobank=ok")) Toon("Gekoppeld met de Rabobank; de eerste keer ophalen loopt.", false);
        if (!Repo.Beschikbaar) return;

        try
        {
            _rekeningen = await Repo.GetRekeningenAsync(Ik.WerknemerId);
            if (_rekeningen.Count == 0) return;

            try { _pasnummers = await Repo.GetPasnummersAsync(Alle()); } catch { }
            await Laad();
        }
        catch (Exception ex) { Toon("Ophalen mislukt: " + ex.Message, true); }
    }

    private async Task Laad()
    {
        try
        {
            _lijst = await Repo.ZoekAsync(Gekozen(), _van, _tot, _zoek, _bijAf, _pas, 1000);
            _totalen = await Repo.GetTotalenAsync(Alle(), Gekozen(), _van, _tot, _zoek, _bijAf, _pas);
        }
        catch (Exception ex) { _lijst = new(); Toon("Zoeken mislukt: " + ex.Message, true); }
    }

    // ---- periode ----
    private async Task VanGewijzigd(DateOnly? d) { if (d is not null) { _van = d.Value; await Laad(); } }
    private async Task TotGewijzigd(DateOnly? d) { if (d is not null) { _tot = d.Value; await Laad(); } }

    private async Task DezeMaand()
    {
        var nu = DateTime.Today;
        _van = new DateOnly(nu.Year, nu.Month, 1);
        _tot = _van.AddMonths(1).AddDays(-1);
        await Laad();
    }

    private async Task DitKwartaal()
    {
        var nu = DateTime.Today;
        var eerste = ((nu.Month - 1) / 3) * 3 + 1;
        _van = new DateOnly(nu.Year, eerste, 1);
        _tot = _van.AddMonths(3).AddDays(-1);
        await Laad();
    }

    private async Task DitJaar()
    {
        var jaar = DateTime.Today.Year;
        _van = new DateOnly(jaar, 1, 1);
        _tot = new DateOnly(jaar, 12, 31);
        await Laad();
    }

    /// <summary>Schuift de hele periode een lengte terug of vooruit.</summary>
    private async Task Schuif(int richting)
    {
        var dagen = _tot.DayNumber - _van.DayNumber + 1;
        _van = _van.AddDays(richting * dagen);
        _tot = _tot.AddDays(richting * dagen);
        await Laad();
    }

    private Task VorigePeriode() => Schuif(-1);
    private Task VolgendePeriode() => Schuif(1);

    // ---- filters ----
    private async Task ZoekGewijzigd(ChangeEventArgs e)
    {
        _zoek = (string?)e.Value ?? "";
        await Laad();
    }

    private async Task WisZoek()
    {
        _zoek = "";
        await Laad();
    }

    private async Task RekeningGewijzigd(ChangeEventArgs e)
    {
        _rekening = (string?)e.Value ?? "";
        await Laad();
    }

    private async Task PasGewijzigd(ChangeEventArgs e)
    {
        _pas = int.TryParse((string?)e.Value, out var v) ? v : null;
        await Laad();
    }

    private async Task BijAfGewijzigd(ChangeEventArgs e)
    {
        _bijAf = Enum.TryParse<BijAf>((string?)e.Value, out var v) ? v : BijAf.Beide;
        await Laad();
    }

    // ================================================================
    //  Importeren
    //  Het bestand komt via de browser binnen en gaat als tekst naar de
    //  repository; die bevat de logica uit het oude Access-formulier @ImportBank.
    // ================================================================
    private bool _importOpen;
    private bool _importBezig;
    private int _importRonde;
    private BankImportResultaat? _import;

    private void OpenImport() { _importOpen = true; _import = null; }
    private void SluitImport() { if (!_importBezig) _importOpen = false; }

    private async Task ImportBestand(InputFileChangeEventArgs e)
    {
        _importBezig = true;
        _import = null;

        try
        {
            // Ruim genomen: een jaar transacties is een paar megabyte.
            using var geheugen = new MemoryStream();
            await e.File.OpenReadStream(maxAllowedSize: 10_000_000).CopyToAsync(geheugen);
            var inhoud = LeesTekst(geheugen.ToArray());

            _import = await Repo.ImporteerAsync(inhoud, Ik.WerknemerId);

            if (_import.Toegevoegd > 0)
            {
                await Laad();
                try { _pasnummers = await Repo.GetPasnummersAsync(Alle()); } catch { }
            }
        }
        catch (Exception ex)
        {
            _import = new BankImportResultaat(0, 0, 0,
                new List<string> { "Bestand lezen mislukt: " + ex.Message });
        }
        finally
        {
            _importBezig = false;
            _importRonde++;   // vers invoerveld, zodat hetzelfde bestand nogmaals kan
        }
    }

    /// <summary>
    /// De bank levert tegenwoordig UTF-8, maar oudere exports zijn ANSI. Leesbaar
    /// UTF-8 nemen we zoals het is; alles wat daar niet aan voldoet lezen we als
    /// West-Europees, dan blijven é en ë ook in oude bestanden heel.
    /// </summary>
    private static string LeesTekst(byte[] bytes)
    {
        try
        {
            var streng = new System.Text.UTF8Encoding(
                encoderShouldEmitUTF8Identifier: false, throwOnInvalidBytes: true);
            return streng.GetString(bytes).TrimStart('\uFEFF');   // eventuele bytevolgorde-markering eraf
        }
        catch (System.Text.DecoderFallbackException)
        {
            return System.Text.Encoding.Latin1.GetString(bytes);
        }
    }

    // ---- opmerking en detail ----
    private async Task ZetOpmerking(Banktransactie t, ChangeEventArgs e)
    {
        t.Opmerking = (string?)e.Value ?? "";
        try
        {
            await Repo.ZetOpmerkingAsync(t.Id, t.Opmerking);
            Toon("Opgeslagen.", false);
        }
        catch (Exception ex) { Toon("Opslaan mislukt: " + ex.Message, true); }
    }

    private async Task OpenDetail(Banktransactie t)
    {
        try { _detail = await Repo.GetDetailAsync(t.Id); }
        catch (Exception ex) { Toon("Gegevens ophalen mislukt: " + ex.Message, true); }
    }

    private void SluitDetail() => _detail = null;

    private async Task DetailOpmerkingGewijzigd(ChangeEventArgs e)
    {
        if (_detail is null) return;
        _detail.Opmerking = (string?)e.Value ?? "";
        try
        {
            await Repo.ZetOpmerkingAsync(_detail.Id, _detail.Opmerking);

            var regel = _lijst.FirstOrDefault(t => t.Id == _detail.Id);
            if (regel is not null) regel.Opmerking = _detail.Opmerking;

            Toon("Opgeslagen.", false);
        }
        catch (Exception ex) { Toon("Opslaan mislukt: " + ex.Message, true); }
    }

    private void SluitMelding() => _melding = null;
    private void Toon(string tekst, bool fout) { _melding = tekst; _fout = fout; }
}
