@page "/financien/banktransacties"
@inject IBankRepository Repo
@inject HuidigeGebruiker Ik
@inject RabobankOphaler Rabobank
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IGrootboekRepository Grootboek

<div class="page">
    <header class="topbar">
        <h1>Banktransacties</h1>
        <span class="weeklabel">@_totalen.Aantal transacties · @Bedrag(_totalen.Totaal)</span>
        @if (_rekeningen.Count > 0)
        {
            <button class="klein" @onclick="OpenImport">⭱ Importeren</button>
            @if (MagKoppelen)
            {
                <button class="klein" title="De transacties hieronder zonder factuur nalopen op een sterk voorstel" @onclick="OpenScan">🔗 Ongekoppeld…</button>
            }
        }
    </header>

    @if (_rabo is not null)
    {
        <section class="rabo-blok @(_rabo.Fout.Length > 0 ? "fout" : "")">
            <div class="rabo-kop">
                <strong>Rabobank</strong>
                @if (_rabo.Sandbox) { <span class="rabo-label">sandbox</span> }
                else if (!Rabobank.SchrijftWeg) { <span class="rabo-label">alleen kijken</span> }

                @if (!_rabo.Ingesteld)
                {
                    <span class="rabo-tekst">Nog niet ingesteld (sectie Rabobank in appsettings.json).</span>
                }
                else if (!_rabo.Gekoppeld)
                {
                    <span class="rabo-tekst">Niet gekoppeld.</span>
                    <a class="knop klein" href="rabobank/koppel">Koppelen</a>
                }
                else
                {
                    <span class="rabo-tekst">
                        Gekoppeld@(_rabo.GekoppeldOp is DateTime gk ? " sinds " + gk.ToString("d-M-yyyy") : "")
                        · laatst opgehaald @(_rabo.LaatstOpgehaald is DateTime lo ? lo.ToString("d-M HH:mm") : "nog niet")
                        @if (_rabo.VolgendeKeer is DateTime vk) { <text> · volgende @vk.ToString("HH:mm")</text> }
                    </span>
                    <button class="klein" disabled="@(_rabo.Bezig || _raboBezig)" @onclick="RabobankNu">
                        @(_rabo.Bezig || _raboBezig ? "Bezig…" : "Nu ophalen")
                    </button>
                    <a class="knop klein" href="rabobank/koppel" title="Opnieuw toestemming geven">Opnieuw koppelen</a>
                }
            </div>

            @if (_rabo.Fout.Length > 0)
            {
                <div class="rabo-fout">@_rabo.Fout</div>
            }

            @if (_rabo.Rekeningen.Count > 0)
            {
                <table class="rabo-rek">
                    <tr><th>Rekening</th><th>Opgehaald</th><th>@(Rabobank.SchrijftWeg ? "Nieuw" : "Zou nieuw zijn")</th><th>Al aanwezig</th><th>Saldo bank</th></tr>
                    @foreach (var rr in _rabo.Rekeningen)
                    {
                        <tr>
                            <td>@rr.Iban</td><td>@rr.Opgehaald</td><td>@rr.Toegevoegd</td><td>@rr.AlAanwezig</td>
                            <td class="bedrag">@Saldo(rr.Saldo)</td>
                        </tr>
                    }
                </table>
            }

            @if (_rabo.Proef.Count > 0)
            {
                <details class="rabo-proef">
                    <summary>Wat er binnenkwam (@_rabo.Proef.Count regels, niet weggeschreven)</summary>
                    <table>
                        <tr><th>Datum</th><th>Rekening</th><th>Volgnr</th><th>Bedrag</th><th>Saldo na</th><th>Tegenpartij</th><th>Omschrijving</th></tr>
                        @foreach (var pr in _rabo.Proef)
                        {
                            <tr>
                                <td>@pr.Datum.ToString("d-M-yyyy")</td><td>@pr.Rekening</td><td>@pr.Volgnummer</td>
                                <td class="bedrag">@Bedrag(pr.Bedrag)</td><td class="bedrag">@Bedrag(pr.SaldoNa)</td>
                                <td>@pr.NaamTegenpartij @pr.Tegenrekening</td><td>@pr.Omschrijving</td>
                            </tr>
                        }
                    </table>
                </details>
            }
        </section>
    }

    @if (!Repo.Beschikbaar)
    {
        <section class="module-placeholder"><p>Dit scherm werkt alleen met de live database.</p></section>
    }
    else if (_rekeningen.Count == 0)
    {
        <section class="module-placeholder">
            <p>
                Je hebt (nog) geen rechten op een bankrekening. Wie welke rekening mag zien
                staat in de tabel BankRekeningRechten.
            </p>
        </section>
    }
    else
    {
        @if (_melding is not null)
        {
            <div class="melding @(_fout ? "fout" : "ok")" @onclick="SluitMelding">@_melding</div>
        }

        @* ---------- filters ---------- *@
        <div class="bankfilters">
            <label class="bankveld">
                <span>Van</span>
                <NlDatum Waarde="_van" WaardeChanged="VanGewijzigd" />
            </label>
            <label class="bankveld">
                <span>Tot en met</span>
                <NlDatum Waarde="_tot" WaardeChanged="TotGewijzigd" />
            </label>

            <div class="btngroup">
                <button class="klein" title="Vorige periode" @onclick="VorigePeriode">◀</button>
                <button class="klein" @onclick="DezeMaand">Deze maand</button>
                <button class="klein" @onclick="DitKwartaal">Dit kwartaal</button>
                <button class="klein" @onclick="DitJaar">Dit jaar</button>
                <button class="klein" title="Volgende periode" @onclick="VolgendePeriode">▶</button>
            </div>

            <label class="bankveld groei">
                <span>Zoeken</span>
                <span class="zoekregel">
                    <input placeholder="Omschrijving, tegenpartij, opmerking…" value="@_zoek"
                           @onchange="ZoekGewijzigd" />
                    <button class="klein" disabled="@(_zoek.Length == 0)" @onclick="WisZoek">✕</button>
                </span>
            </label>

            @* eerst de BV, dan de rekeningen van die BV (wens gebruiker 10-11-2026); één BV = geen keuze nodig *@
            @if (Bvs.Count > 1)
            {
                <label class="bankveld">
                    <span>BV</span>
                    <select value="@(_bv?.ToString() ?? "")" @onchange="BvGewijzigd">
                        <option value="">Alle BV's</option>
                        @foreach (var (id, naam) in Bvs)
                        {
                            <option value="@id">@naam</option>
                        }
                    </select>
                </label>
            }

            <label class="bankveld">
                <span>Rekening</span>
                <select value="@RekeningTekst" @onchange="RekeningGewijzigd">
                    <option value="">@(_bv is null ? "Alle rekeningen" : $"Alle rekeningen van {BvNaam(_bv.Value)}")</option>
                    @foreach (var r in RekeningenVanBv)
                    {
                        <option value="@r.Nummer">@r.Volledig</option>
                    }
                </select>
            </label>

            @if (_pasnummers.Count > 0)
            {
                <label class="bankveld">
                    <span>Bankpas</span>
                    <select value="@PasTekst" @onchange="PasGewijzigd">
                        <option value="">Alle</option>
                        @foreach (var p in _pasnummers)
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                </label>
            }

            <label class="bankveld">
                <span>Bij/Af</span>
                <select value="@_bijAf.ToString()" @onchange="BijAfGewijzigd">
                    <option value="@BijAf.Beide">Bij en Af</option>
                    <option value="@BijAf.Bij">Alleen bij</option>
                    <option value="@BijAf.Af">Alleen af</option>
                </select>
            </label>
        </div>

        @* ---------- de transacties ---------- *@
        <div class="regels-omhulsel">
            <table class="kiezer-tabel banktabel">
                <thead>
                    <tr>
                        <th style="width:6.5rem">Datum</th>
                        <th style="width:8rem" class="r">Bedrag</th>
                        <th style="width:12rem">Tegenrekening</th>
                        <th style="width:15rem" title="Naam tegenpartij (anders de tenaamstelling)">Tegenpartij</th>
                        <th>Omschrijving</th>
                        @if (_grootboekAan) { <th style="width:7rem" title="Grootboekrekening">Grootboek</th> }
                        <th style="width:14rem">Opmerking</th>
                        <th style="width:4.5rem" class="c" title="Gekoppelde facturen">Facturen</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in _lijst)
                    {
                        <tr @key="t.Id" class="bt-rij @(t.Id == _detail?.Id ? "gekozen-rij" : "")" title="Dubbelklik voor alle gegevens en de gekoppelde facturen"
                            @ondblclick="() => OpenDetail(t)">
                            <td>@(t.Datum?.ToString("dd-MM-yyyy") ?? "")</td>
                            <td class="r @(t.Bij ? "bedrag-bij" : "")">@Bedrag(t.Bedrag)</td>
                            <td class="iban">@t.Tegenrekening</td>
                            <td>@t.Tenaamstelling</td>
                            <td class="omschrijving" title="@t.Omschrijving">@t.Omschrijving</td>
                            @if (_grootboekAan) { <td class="iban" title="@t.GrootboekNaam">@t.Grootboek</td> }
                            <td>
                                <input value="@t.Opmerking" maxlength="50"
                                       @onchange="e => ZetOpmerking(t, e)" />
                            </td>
                            <td class="c">
                                @if (t.Facturen > 0)
                                {
                                    <button class="bt-gekoppeld" title="@t.Facturen gekoppelde factu(u)r(en): klik voor de details" @onclick="() => OpenDetail(t)">🔗 @t.Facturen</button>
                                }
                            </td>
                        </tr>
                    }
                    @if (_lijst.Count == 0)
                    {
                        <tr><td colspan="7" class="kiezer-info">Geen transacties in deze periode.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        @* ---------- de cijfers eronder ---------- *@
        <div class="banktotalen">
            <span><b>Totaal</b> @Bedrag(_totalen.Totaal)</span>
            <span><b>Aantal</b> @_totalen.Aantal</span>
            <span><b>@SaldoKop</b> @Saldo(_totalen.SaldoRekening)</span>
            <span><b>Saldo alle rekeningen</b> @Saldo(_totalen.SaldoAlle)</span>
            <span>
                <b>Laatste transactie</b>
                @(_totalen.Laatste?.ToString("dd-MM-yyyy") ?? "—")
                @if (_totalen.DagenOud is int dagen)
                {
                    <span class="@(dagen > 3 ? "oud" : "")">(@dagen dagen oud)</span>
                }
            </span>
        </div>
    }

    <footer class="voet">
        Dubbelklik op een transactie voor alle gegevens en de gekoppelde facturen.
    </footer>
</div>

@* ---------- importvenster ---------- *@
@if (_importOpen)
{
    <div class="cmdk-overlay" @onclick="SluitImport">
        <div class="prijsvenster" @onclick:stopPropagation>
            <header class="bijlagekop">
                <h2>Banktransacties importeren</h2>
                <button class="klein" @onclick="SluitImport">✕</button>
            </header>

            <div class="prijs-inhoud">
                <p class="uitleg">
                    Download de transacties op rabobank.nl in CSV-formaat en kies
                    hieronder het bestand. Transacties die er al staan worden
                    overgeslagen — dubbel importeren kan dus geen kwaad.
                </p>

                @* De @key maakt het invoerveld nieuw na elke import; anders doet
                   nogmaals hetzelfde bestand kiezen niets (browsergedrag). *@
                <label class="bestandknop" @key="_importRonde">
                    @(_importBezig ? "Bezig met importeren…" : "Kies het CSV-bestand…")
                    <InputFile OnChange="ImportBestand" accept=".csv" disabled="@_importBezig" />
                </label>

                @if (_import is not null)
                {
                    <div class="importcijfers">
                        <span><b>@_import.Verwerkt</b> regels gelezen</span>
                        <span class="import-nieuw"><b>@_import.Toegevoegd</b> toegevoegd</span>
                        <span><b>@_import.AlAanwezig</b> stonden er al</span>
                    </div>

                    @foreach (var fout in _import.Fouten)
                    {
                        <p class="import-fout">@fout</p>
                    }

                    @if (_import.Gelukt)
                    {
                        <p class="uitleg">
                            Klaar. Het overzicht hieronder is bijgewerkt; het venster kan dicht.
                        </p>
                    }
                }
            </div>
        </div>
    </div>
}

@* ---------- detailvenster ---------- *@
@if (_detail is not null)
{
    <div class="cmdk-overlay" @onclick="SluitDetail">
        <div class="voorbeeldvenster bankdetail" @onclick:stopPropagation>
            <header class="bijlagekop">
                <h2>Transactie @(_detail.Datum?.ToString("dd-MM-yyyy") ?? "") · @Bedrag(_detail.Bedrag)</h2>
                <button class="klein" @onclick="SluitDetail">✕</button>
            </header>

            <div class="voorbeeld-inhoud bankdetail-inhoud">
                <div class="wn-velden">
                    <div class="wn-veld"><label>Rekening</label><span class="alleen-lezen">@_detail.Rekening @_detail.Bic@(_detail.RekeningBv.Length > 0 ? $" ({_detail.RekeningBv})" : "")</span></div>
                    <div class="wn-veld"><label>Datum</label><span class="alleen-lezen">@(_detail.Datum?.ToString("dd-MM-yyyy") ?? "")</span></div>
                    <div class="wn-veld"><label>Volgnummer</label><span class="alleen-lezen">@_detail.Volgnummer</span></div>
                    <div class="wn-veld"><label>Rentedatum</label><span class="alleen-lezen">@(_detail.Rentedatum?.ToString("dd-MM-yyyy") ?? "")</span></div>
                    <div class="wn-veld"><label>Bedrag</label><span class="alleen-lezen">@Bedrag(_detail.Bedrag) @_detail.Munt</span></div>
                    <div class="wn-veld"><label>Saldo na transactie</label><span class="alleen-lezen">@Saldo(_detail.SaldoNa)</span></div>
                    <div class="wn-veld"><label>Sombedrag</label><span class="alleen-lezen">@Saldo(_detail.Sombedrag)</span></div>
                    <div class="wn-veld"><label>Oorspronkelijk bedrag</label><span class="alleen-lezen">@Saldo(_detail.OorspronkelijkBedrag) @_detail.OorspronkelijkeMunt</span></div>

                    <div class="wn-veld breed"><label>Omschrijving</label><span class="alleen-lezen">@_detail.Omschrijving</span></div>

                    <div class="wn-veld"><label>Tegenrekening</label><span class="alleen-lezen" title="@(_detail.TegenrekeningRelatie.Length > 0 ? "Relatie met dit IBAN" : null)">@_detail.Tegenrekening@(_detail.TegenrekeningRelatie.Length > 0 ? $" ({_detail.TegenrekeningRelatie})" : "")</span></div>
                    <div class="wn-veld"><label>BIC tegenpartij</label><span class="alleen-lezen">@_detail.BicTegenpartij</span></div>
                    <div class="wn-veld"><label>Naam tegenpartij</label><span class="alleen-lezen">@_detail.NaamTegenpartij</span></div>
                    <div class="wn-veld"><label>Uiteindelijke partij</label><span class="alleen-lezen">@_detail.NaamUiteindelijkePartij</span></div>
                    <div class="wn-veld"><label>Initiërende partij</label><span class="alleen-lezen">@_detail.NaamInitierendePartij</span></div>

                    <div class="wn-veld"><label>Code</label><span class="alleen-lezen">@_detail.Code</span></div>
                    <div class="wn-veld"><label>Batch-ID</label><span class="alleen-lezen">@_detail.BatchId</span></div>
                    <div class="wn-veld"><label>Transactiereferentie</label><span class="alleen-lezen">@_detail.Transactiereferentie</span></div>
                    <div class="wn-veld"><label>Machtigingskenmerk</label><span class="alleen-lezen">@_detail.MachtigingsKenmerk</span></div>
                    <div class="wn-veld"><label>Incassant-ID</label><span class="alleen-lezen">@_detail.IncassantId</span></div>
                    <div class="wn-veld"><label>Betalingskenmerk</label><span class="alleen-lezen">@_detail.Betalingskenmerk</span></div>
                    <div class="wn-veld"><label>Reden retour</label><span class="alleen-lezen">@_detail.RedenRetour</span></div>
                    <div class="wn-veld"><label>Bankpas</label><span class="alleen-lezen">@_detail.Pasnummer</span></div>

                    <div class="wn-veld"><label>Geïmporteerd</label>
                        <span class="alleen-lezen">
                            @(_detail.Importdatum?.ToString("dd-MM-yyyy HH:mm") ?? "")
                            @if (!string.IsNullOrWhiteSpace(_detail.GeimporteerdDoor))
                            {
                                <text> door @_detail.GeimporteerdDoor</text>
                            }
                        </span>
                    </div>

                    <div class="wn-veld breed">
                        <label>Opmerking</label>
                        <input value="@_detail.Opmerking" maxlength="50" @onchange="DetailOpmerkingGewijzigd" />
                    </div>
                    @if (_grootboekAan)
                    {
                        @* grootboekrekening van dit afschriftrecord (wens gebruiker 11-11-2026): de rekeningen van de BV van deze bankrekening *@
                        <div class="wn-veld breed">
                            <label>Grootboekrekening</label>
                            @if (MagKoppelen)
                            {
                                <select @key="(_detail.Id, _gbHerteken)" value="@(_detail.GrootboekId?.ToString() ?? "")" @onchange="GrootboekGewijzigd">
                                    <option value="">— geen —</option>
                                    @foreach (var g in GrootboekKeuzes)
                                    {
                                        <option value="@g.Id">@g.Code  @g.Naam@(g.Actief ? "" : " (niet actief)")</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <span class="alleen-lezen">@(_grootboeken.FirstOrDefault(g => g.Id == _detail.GrootboekId)?.Weergave ?? "")</span>
                            }
                        </div>
                    }
                </div>

                @* gekoppelde facturen (banktransacties_facturen_crossref), klik = de factuur openen (wens gebruiker 10-11-2026) *@
                <h3 class="wn-kop">Gekoppelde facturen</h3>
                @if (_facturen is null)
                {
                    <p class="uitleg">Laden…</p>
                }
                else if (_facturen.Count == 0)
                {
                    <p class="uitleg">Er zijn geen facturen aan deze transactie gekoppeld.</p>
                }
                else
                {
                    <table class="kiezer-tabel bt-facturen">
                        <thead>
                            <tr><th style="width:6rem">Soort</th><th style="width:9rem">Factuur</th><th>Relatie</th><th style="width:6.5rem">Datum</th><th style="width:7rem" class="r">Bedrag</th><th style="width:5rem">Betaald</th>
                                @if (MagKoppelen) { <th style="width:2.5rem"></th> }</tr>
                        </thead>
                        <tbody>
                            @foreach (var f in _facturen)
                            {
                                <tr @key="(f.Verkoop, f.FactuurId)">
                                    <td>@(f.Verkoop ? "uitgaand" : "inkomend")</td>
                                    <td><button class="lq-factuur" title="Factuur openen" @onclick="() => OpenFactuur(f)">@FactuurTekst(f)</button></td>
                                    <td>@f.Relatie</td>
                                    <td>@(f.Datum?.ToString("dd-MM-yyyy") ?? "")</td>
                                    <td class="r">@Bedrag(f.Bedrag)</td>
                                    <td>@(f.Betaald ? "✓" : "")</td>
                                    @if (MagKoppelen)
                                    {
                                        <td><button class="klein rood" title="Koppeling weghalen" disabled="@_kopBezig" @onclick="() => Ontkoppel(f)">✕</button></td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @* factuur koppelen in hetzelfde venster (wens gebruiker 11-11-2026: een tweede venster werkte niet handig). Open als
                   het bedrag nog niet gedekt is; anders achter een knop. Alleen de koppeling; de betaald-status verandert niet. *@
                @if (MagKoppelen && !_koppelOpen)
                {
                    <div class="bt-koppel-knop">
                        <button class="klein" @onclick="OpenKoppelen">🔗 Toch nog een factuur koppelen…</button>
                        <span class="uitleg">De gekoppelde facturen dekken het hele bedrag.</span>
                    </div>
                }
                else if (MagKoppelen)
                {
                    <h3 class="wn-kop">Factuur koppelen</h3>
                    <div class="bt-koppel-balk">
                        <select value="@(_kopVerkoop ? "uit" : "in")" @onchange="KopSoortGewijzigd">
                            <option value="uit">Uitgaande facturen (verkoop)</option>
                            <option value="in">Inkomende facturen (inkoop)</option>
                        </select>
                        <input class="groei" placeholder="Factuurnummer, relatie, omschrijving of bedrag…" value="@_kopZoek"
                               @onchange="KopZoekGewijzigd" />
                        @if (_kopZoek.Length > 0)
                        {
                            <button class="klein" title="Terug naar de voorstellen" @onclick="WisKopZoek">✕</button>
                        }
                    </div>
                    @if (_kandidaten is null)
                    {
                        <p class="uitleg">Zoeken…</p>
                    }
                    else if (_kandidaten.Count == 0)
                    {
                        <p class="uitleg">@(_kopZoek.Length == 0 ? "Geen voorstel: geen factuur met een nummer uit de omschrijving of met hetzelfde bedrag. Zoek hierboven op nummer, relatie of bedrag." : "Niets gevonden.")</p>
                    }
                    else
                    {
                        <p class="uitleg">@(AlleenVolledig ? "Nummer, bedrag en rekening kloppen." : _kopZoek.Length == 0 ? "Voorstellen op nummer in de omschrijving en op bedrag; de beste bovenaan." : $"{_kandidaten.Count} gevonden{(_kandidaten.Count >= KopMax ? " (de eerste " + KopMax + ")" : "")}.")@KopBvTekst</p>
                        <table class="kiezer-tabel bt-facturen">
                            <thead>
                                <tr><th style="width:9rem">Factuur</th><th>Relatie</th><th style="width:6.5rem">Datum</th><th style="width:7rem" class="r">Bedrag</th>
                                    <th style="width:5rem">Betaald</th><th>Waarom</th><th style="width:6rem"></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var k in KandidatenTonen)
                                {
                                    <tr @key="(k.Verkoop, k.FactuurId)">
                                        <td><button class="lq-factuur" title="@(k.Omschrijving.Length > 0 ? k.Omschrijving : "Factuur openen")"
                                                    @onclick="() => OpenKandidaat(k)">@(k.Nummer.Length > 0 ? k.Nummer : "#" + k.FactuurId)</button></td>
                                        <td>@k.Relatie</td>
                                        <td>@(k.Datum?.ToString("dd-MM-yyyy") ?? "")</td>
                                        <td class="r">@Bedrag(k.Bedrag)</td>
                                        <td>@(k.Betaald ? "✓" : "")</td>
                                        <td class="bt-waarom">
                                            @if (k.NummerInTekst) { <span class="bt-chip goed">nummer in omschrijving</span> }
                                            @if (k.IbanGelijk) { <span class="bt-chip goed" title="De tegenrekening is het IBAN van deze relatie">zelfde rekening</span> }
                                            @if (k.BedragGelijk) { <span class="bt-chip goed">zelfde bedrag</span> }
                                            @if (k.DatumPast) { <span class="bt-chip goed" title="Factuur @k.Dagen dagen voor de betaling">datum past</span> }
                                            @if (k.NaBetaling) { <span class="bt-chip let" title="De factuur is van na de betaling">factuur na betaling</span> }
                                            @if (k.Oud) { <span class="bt-chip let" title="De factuur was al @k.Dagen dagen oud bij de betaling">@k.Dagen dagen oud</span> }
                                            @if (k.Elders > 0) { <span class="bt-chip let" title="Deze factuur hangt al aan @k.Elders andere transactie(s)">al elders gekoppeld</span> }
                                        </td>
                                        <td><button class="klein primair" disabled="@_kopBezig" @onclick="() => Koppel(k)">🔗 Koppelen</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (AlleenVolledig)
                        {
                            <button class="link" @onclick="() => _toonHalf = true">Ook @(_kandidaten.Count - KandidatenTonen.Count) gedeeltelijke overeenkomst@(_kandidaten.Count - KandidatenTonen.Count == 1 ? "" : "en") tonen</button>
                        }
                        else if (_toonHalf && _kopZoek.Length == 0 && _kandidaten.Any(Volledig))
                        {
                            <button class="link" @onclick="() => _toonHalf = false">Alleen de volledige overeenkomst tonen</button>
                        }
                    }
                }
            </div>
        </div>
    </div>
}

@* ---------- ongekoppelde transacties met een sterk voorstel (wens gebruiker 11-11-2026): de transacties in de lijst (periode,
     rekeningen, filters) zonder factuur, elk nagelopen met FactuurKandidatenAsync. Zeker = nummer, bedrag en rekening
     kloppen (of nummer en bedrag als geen voorstel de rekening kent); "rekening en bedrag" staat er ook, niet aangevinkt. ---------- *@
@if (_scanOpen)
{
    <div class="cmdk-overlay" @onclick="SluitScan">
        <div class="voorbeeldvenster bankdetail bankkoppel" @onclick:stopPropagation>
            <header class="bijlagekop">
                <h2>Ongekoppelde transacties met een voorstel</h2>
                <button class="klein" @onclick="SluitScan">✕</button>
            </header>
            <div class="voorbeeld-inhoud bankdetail-inhoud">
                <p class="uitleg">
                    @if (_scanBezig)
                    {
                        <text>Bezig: @_scanGedaan van @_scanTotaal transacties zonder factuur bekeken…</text>
                    }
                    else
                    {
                        <text>@_scanTotaal transacties zonder factuur in de lijst (@_van.ToString("dd-MM-yyyy") t/m @_tot.ToString("dd-MM-yyyy")); @_scan.Count met een voorstel.</text>
                    }
                    @if (_scanTotaal >= ScanMax) { <text> Alleen de eerste @ScanMax; kies een kortere periode voor de rest.</text> }
                </p>
                @if (_scan.Count > 0)
                {
                    <table class="kiezer-tabel bt-facturen">
                        <thead>
                            <tr><th style="width:2rem"></th><th style="width:6.5rem">Datum</th><th style="width:7.5rem" class="r">Bedrag</th><th>Transactie</th>
                                <th>Voorstel</th><th>Waarom</th><th style="width:6rem"></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var s in _scan)
                            {
                                <tr @key="s.T.Id" class="@(s.Gekoppeld ? "bt-scan-klaar" : "")">
                                    <td>@if (!s.Gekoppeld) { <input type="checkbox" checked="@s.Aan" @onchange="e => s.Aan = e.Value is true" /> }</td>
                                    <td>@(s.T.Datum?.ToString("dd-MM-yyyy") ?? "")</td>
                                    <td class="r">@Bedrag(s.T.Bedrag)</td>
                                    <td class="omschrijving" title="@s.T.Omschrijving">@(s.T.Tenaamstelling.Length > 0 ? s.T.Tenaamstelling : s.T.Omschrijving)</td>
                                    <td><button class="lq-factuur" title="Factuur openen" @onclick="() => OpenKandidaat(s.K)">@(s.K.Nummer.Length > 0 ? s.K.Nummer : "#" + s.K.FactuurId)</button>
                                        @s.K.Relatie · @(s.K.Datum?.ToString("dd-MM-yyyy") ?? "") · @Bedrag(s.K.Bedrag)</td>
                                    <td class="bt-waarom">
                                        @if (s.K.NummerInTekst) { <span class="bt-chip goed">nummer</span> }
                                        @if (s.K.IbanGelijk) { <span class="bt-chip goed">rekening</span> }
                                        @if (s.K.BedragGelijk) { <span class="bt-chip goed">bedrag</span> }
                                        @if (s.K.DatumPast) { <span class="bt-chip goed" title="Factuur @s.K.Dagen dagen voor de betaling">datum</span> }
                                        @if (!s.Zeker) { <span class="bt-chip let" title="Geen factuurnummer in de omschrijving: zelf beoordelen">zelf bekijken</span> }
                                    </td>
                                    <td>@if (s.Gekoppeld) { <span class="klein-grijs">✓ gekoppeld</span> }
                                        else { <button class="klein" disabled="@_kopBezig" @onclick="() => KoppelScan(s)">🔗 Koppelen</button> }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="bt-koppel-knop">
                        <button class="primair" disabled="@(_scanBezig || _kopBezig || !_scan.Any(s => s.Aan && !s.Gekoppeld))" @onclick="KoppelAangevinkt">
                            🔗 @_scan.Count(s => s.Aan && !s.Gekoppeld) aangevinkte koppelen</button>
                        <span class="uitleg">Aangevinkt zijn de zekere: nummer, bedrag en rekening kloppen, en de factuur is niet van na de betaling.</span>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* gekoppelde factuur openen vanuit het detailvenster (na het detailvenster, zodat hij erboven ligt) *@
<FactuurVenster FactuurId="_inkoopId" Sluiten="FactuurDicht" />
<VerkoopFactuurVenster FactuurId="_verkoopId" Sluiten="FactuurDicht" />

@code {
    private List<Bankrekening> _rekeningen = new();
    private List<Banktransactie> _lijst = new();
    private List<int> _pasnummers = new();
    private BankTotalen _totalen = new(0, 0, null, null, null);

    private DateOnly _van = DateOnly.FromDateTime(DateTime.Today.AddMonths(-1));
    private DateOnly _tot = DateOnly.FromDateTime(DateTime.Today);
    private string _zoek = "";
    private string _rekening = "";       // leeg = alle rekeningen waar ik bij mag (van de gekozen BV)
    private int? _bv;                    // null = alle BV's; 0 = rekeningen zonder BV
    private int? _pas;
    private BijAf _bijAf = BijAf.Beide;

    private BanktransactieDetail? _detail;
    private string? _melding;
    private bool _fout;

    private string RekeningTekst => _rekening;
    private string PasTekst => _pas is int p ? p.ToString() : "";

    private static string Bedrag(decimal waarde)
        => waarde.ToString("C2", new System.Globalization.CultureInfo("nl-NL"));

    private static string Saldo(decimal? waarde) => waarde is null ? "—" : Bedrag(waarde.Value);

    /// <summary>De rekeningnummers waar deze gebruiker bij mag (van de gekozen BV), of alleen de gekozene.</summary>
    private List<string> Gekozen()
        => string.IsNullOrWhiteSpace(_rekening)
            ? RekeningenVanBv.Select(r => r.Nummer).ToList()
            : new List<string> { _rekening };

    // ---- BV ----
    private static int BvVan(Bankrekening r) => r.BvId ?? 0;

    /// <summary>De BV's van de rekeningen waar ik bij mag, op naam; "zonder BV" achteraan.</summary>
    private List<(int Id, string Naam)> Bvs
        => _rekeningen.GroupBy(BvVan)
                      .Select(g => (g.Key, Naam: BvNaam(g.Key)))
                      .OrderBy(b => b.Key == 0).ThenBy(b => b.Naam, StringComparer.CurrentCultureIgnoreCase)
                      .ToList();

    private string BvNaam(int id)
        => id == 0 ? "zonder BV"
         : _rekeningen.FirstOrDefault(r => BvVan(r) == id && r.Bv.Length > 0)?.Bv ?? $"BV {id}";

    private List<Bankrekening> RekeningenVanBv
        => _bv is int bv ? _rekeningen.Where(r => BvVan(r) == bv).ToList() : _rekeningen;

    private string SaldoKop
        => _rekening.Length > 0 ? "Saldo gekozen rekening"
         : _bv is int bv ? $"Saldo {BvNaam(bv)}"
         : "Saldo gekozen rekeningen";

    private async Task BvGewijzigd(ChangeEventArgs e)
    {
        _bv = int.TryParse((string?)e.Value, out var v) ? v : null;
        // een rekening van een andere BV past niet meer
        if (_rekening.Length > 0 && RekeningenVanBv.All(r => r.Nummer != _rekening)) _rekening = "";
        await Laad();
    }

    private List<string> Alle() => _rekeningen.Select(r => r.Nummer).ToList();

    // ---- Rabobank-koppeling (alleen voor Financial en Directie) ----
    private RabobankStand? _rabo;
    private bool _raboBezig;

    private void LeesRabobank()
        => _rabo = Ik.MagEenVan("Financial", "Directie") ? Rabobank.Stand : null;

    private async Task RabobankNu()
    {
        _raboBezig = true;
        var fout = await Rabobank.HaalOpAsync();
        _raboBezig = false;
        LeesRabobank();
        if (fout is null)
        {
            Toon(Rabobank.SchrijftWeg ? "Opgehaald bij de Rabobank." : "Opgehaald bij de Rabobank (niets weggeschreven).", false);
            if (Rabobank.SchrijftWeg) await Laad();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Ik.ZorgGeladenAsync();
        LeesRabobank();
        var vraag = Nav.ToAbsoluteUri(Nav.Uri).Query;
        if (vraag.Contains("rabobank=ok")) Toon("Gekoppeld met de Rabobank; de eerste keer ophalen loopt.", false);
        if (!Repo.Beschikbaar) return;

        try
        {
            _rekeningen = await Repo.GetRekeningenAsync(Ik.WerknemerId);
            if (_rekeningen.Count == 0) return;
            await LaadGrootboek();

            try { _pasnummers = await Repo.GetPasnummersAsync(Alle()); } catch { }
            await Laad();
        }
        catch (Exception ex) { Toon("Ophalen mislukt: " + ex.Message, true); }
    }

    private async Task Laad()
    {
        try
        {
            _lijst = await Repo.ZoekAsync(Gekozen(), _van, _tot, _zoek, _bijAf, _pas, 1000);
            _totalen = await Repo.GetTotalenAsync(Alle(), Gekozen(), _van, _tot, _zoek, _bijAf, _pas);
        }
        catch (Exception ex) { _lijst = new(); Toon("Zoeken mislukt: " + ex.Message, true); }
    }

    // ---- periode ----
    private async Task VanGewijzigd(DateOnly? d) { if (d is not null) { _van = d.Value; await Laad(); } }
    private async Task TotGewijzigd(DateOnly? d) { if (d is not null) { _tot = d.Value; await Laad(); } }

    private async Task DezeMaand()
    {
        var nu = DateTime.Today;
        _van = new DateOnly(nu.Year, nu.Month, 1);
        _tot = _van.AddMonths(1).AddDays(-1);
        await Laad();
    }

    private async Task DitKwartaal()
    {
        var nu = DateTime.Today;
        var eerste = ((nu.Month - 1) / 3) * 3 + 1;
        _van = new DateOnly(nu.Year, eerste, 1);
        _tot = _van.AddMonths(3).AddDays(-1);
        await Laad();
    }

    private async Task DitJaar()
    {
        var jaar = DateTime.Today.Year;
        _van = new DateOnly(jaar, 1, 1);
        _tot = new DateOnly(jaar, 12, 31);
        await Laad();
    }

    /// <summary>Schuift de hele periode een lengte terug of vooruit.</summary>
    private async Task Schuif(int richting)
    {
        var dagen = _tot.DayNumber - _van.DayNumber + 1;
        _van = _van.AddDays(richting * dagen);
        _tot = _tot.AddDays(richting * dagen);
        await Laad();
    }

    private Task VorigePeriode() => Schuif(-1);
    private Task VolgendePeriode() => Schuif(1);

    // ---- filters ----
    private async Task ZoekGewijzigd(ChangeEventArgs e)
    {
        _zoek = (string?)e.Value ?? "";
        await Laad();
    }

    private async Task WisZoek()
    {
        _zoek = "";
        await Laad();
    }

    private async Task RekeningGewijzigd(ChangeEventArgs e)
    {
        _rekening = (string?)e.Value ?? "";
        await Laad();
    }

    private async Task PasGewijzigd(ChangeEventArgs e)
    {
        _pas = int.TryParse((string?)e.Value, out var v) ? v : null;
        await Laad();
    }

    private async Task BijAfGewijzigd(ChangeEventArgs e)
    {
        _bijAf = Enum.TryParse<BijAf>((string?)e.Value, out var v) ? v : BijAf.Beide;
        await Laad();
    }

    // ================================================================
    //  Importeren
    //  Het bestand komt via de browser binnen en gaat als tekst naar de
    //  repository; die bevat de logica uit het oude Access-formulier @ImportBank.
    // ================================================================
    private bool _importOpen;
    private bool _importBezig;
    private int _importRonde;
    private BankImportResultaat? _import;

    private void OpenImport() { _importOpen = true; _import = null; }
    private void SluitImport() { if (!_importBezig) _importOpen = false; }

    private async Task ImportBestand(InputFileChangeEventArgs e)
    {
        _importBezig = true;
        _import = null;

        try
        {
            // Ruim genomen: een jaar transacties is een paar megabyte.
            using var geheugen = new MemoryStream();
            await e.File.OpenReadStream(maxAllowedSize: 10_000_000).CopyToAsync(geheugen);
            var inhoud = LeesTekst(geheugen.ToArray());

            _import = await Repo.ImporteerAsync(inhoud, Ik.WerknemerId);

            if (_import.Toegevoegd > 0)
            {
                await Laad();
                try { _pasnummers = await Repo.GetPasnummersAsync(Alle()); } catch { }
            }
        }
        catch (Exception ex)
        {
            _import = new BankImportResultaat(0, 0, 0,
                new List<string> { "Bestand lezen mislukt: " + ex.Message });
        }
        finally
        {
            _importBezig = false;
            _importRonde++;   // vers invoerveld, zodat hetzelfde bestand nogmaals kan
        }
    }

    /// <summary>
    /// De bank levert tegenwoordig UTF-8, maar oudere exports zijn ANSI. Leesbaar
    /// UTF-8 nemen we zoals het is; alles wat daar niet aan voldoet lezen we als
    /// West-Europees, dan blijven é en ë ook in oude bestanden heel.
    /// </summary>
    private static string LeesTekst(byte[] bytes)
    {
        try
        {
            var streng = new System.Text.UTF8Encoding(
                encoderShouldEmitUTF8Identifier: false, throwOnInvalidBytes: true);
            return streng.GetString(bytes).TrimStart('\uFEFF');   // eventuele bytevolgorde-markering eraf
        }
        catch (System.Text.DecoderFallbackException)
        {
            return System.Text.Encoding.Latin1.GetString(bytes);
        }
    }

    // ---- opmerking en detail ----
    private async Task ZetOpmerking(Banktransactie t, ChangeEventArgs e)
    {
        t.Opmerking = (string?)e.Value ?? "";
        try
        {
            await Repo.ZetOpmerkingAsync(t.Id, t.Opmerking);
            Toon("Opgeslagen.", false);
        }
        catch (Exception ex) { Toon("Opslaan mislukt: " + ex.Message, true); }
    }

    private async Task OpenDetail(Banktransactie t)
    {
        _facturen = null;
        _kandidaten = null;
        _kopZoek = "";
        _toonHalf = false;
        try { _detail = await Repo.GetDetailAsync(t.Id); }
        catch (Exception ex) { Toon("Gegevens ophalen mislukt: " + ex.Message, true); return; }
        try { _facturen = await Repo.GekoppeldeFacturenAsync(t.Id); }
        catch (Exception ex) { _facturen = new(); Toon("Gekoppelde facturen ophalen mislukt: " + ex.Message, true); }
        // bij: een klant betaalt (uitgaande factuur); af: wij betalen (inkomende factuur)
        _kopVerkoop = (_detail?.Bedrag ?? 0) > 0;
        _koppelOpen = false;
        if (MagKoppelen && !VolledigGekoppeld) await OpenKoppelen();
    }

    // ---- handmatig een factuur koppelen (Financial of Directie) ----
    private const int KopMax = 30;
    private List<FactuurKandidaat>? _kandidaten;
    private bool _kopVerkoop, _kopBezig;
    private string _kopZoek = "";

    private bool MagKoppelen => Ik.MagEenVan("Financial", "Directie");

    // ---- grootboekrekening per afschriftrecord (Grootboekrekeningen_MariaDB.sql) ----
    private bool _grootboekAan;
    private int _gbHerteken;
    private List<Grootboekrekening> _grootboeken = new();

    /// <summary>De actieve rekeningen van de BV van deze bankrekening (anders alle actieve), plus de huidige.</summary>
    private List<Grootboekrekening> GrootboekKeuzes
    {
        get
        {
            if (_detail is null) return new();
            var bv = _rekeningen.FirstOrDefault(r => r.Nummer.Replace(" ", "") == _detail.Rekening.Replace(" ", ""))?.BvId;
            var vanBv = _grootboeken.Where(g => g.Actief && bv is not null && g.BvId == bv).ToList();
            var lijst = vanBv.Count > 0 ? vanBv : _grootboeken.Where(g => g.Actief).ToList();
            if (_detail.GrootboekId is int huidig && lijst.All(g => g.Id != huidig) && _grootboeken.FirstOrDefault(g => g.Id == huidig) is { } h)
                lijst.Insert(0, h);
            return lijst;
        }
    }

    private async Task LaadGrootboek()
    {
        try
        {
            _grootboekAan = Grootboek.Beschikbaar && await Grootboek.KoppelingAanwezigAsync();
            if (_grootboekAan) _grootboeken = await Grootboek.LijstAsync();
        }
        catch { _grootboekAan = false; }
    }

    private async Task GrootboekGewijzigd(ChangeEventArgs e)
    {
        if (_detail is null || !MagKoppelen) return;
        int? id = int.TryParse((string?)e.Value, out var v) ? v : null;
        try
        {
            await Grootboek.ZetTransactieAsync(_detail.Id, id);
            _detail.GrootboekId = id;
            var g = _grootboeken.FirstOrDefault(x => x.Id == id);
            var regel = _lijst.FirstOrDefault(t => t.Id == _detail.Id);
            if (regel is not null) { regel.GrootboekId = id; regel.Grootboek = g?.Code ?? ""; regel.GrootboekNaam = g?.Naam ?? ""; }
            Toon(g is null ? "Grootboekrekening weggehaald." : $"Grootboekrekening {g.Code} {g.Naam}.", false);
        }
        catch (Exception ex) { Toon("Opslaan mislukt: " + ex.Message, true); _gbHerteken++; }
    }
    private bool _koppelOpen;

    private async Task OpenKoppelen()
    {
        _koppelOpen = true;
        _kopZoek = "";
        _toonHalf = false;
        await ZoekKandidaten();
    }

    private void SluitKoppelen() => _koppelOpen = false;

    // ---- wat er van de voorstellen getoond wordt (wens gebruiker 11-11-2026) ----
    private bool _toonHalf;

    /// <summary>De gekoppelde facturen samen dekken het bedrag van de transactie (op een cent).</summary>
    private bool VolledigGekoppeld
        => _detail is not null && _facturen is { Count: > 0 } f
           && Math.Abs(Math.Abs(f.Sum(x => x.Bedrag)) - Math.Abs(_detail.Bedrag)) < 0.01m;

    /// <summary>
    /// Nummer in de omschrijving, zelfde bedrag en de rekening van de relatie. Kent geen enkel voorstel de rekening
    /// (de relatie heeft geen IBAN), dan is nummer + bedrag genoeg.
    /// </summary>
    private bool Volledig(FactuurKandidaat k)
        => k.NummerInTekst && k.BedragGelijk && !k.NaBetaling && (k.IbanGelijk || _kandidaten?.Any(x => x.IbanGelijk) != true);

    /// <summary>Alleen de volledige overeenkomst(en) tonen, met een knop voor de rest.</summary>
    private bool AlleenVolledig
        => !_toonHalf && _kopZoek.Length == 0 && _kandidaten is { } l && l.Any(Volledig) && l.Any(k => !Volledig(k));

    private List<FactuurKandidaat> KandidatenTonen
        => _kandidaten is null ? new() : AlleenVolledig ? _kandidaten.Where(Volledig).ToList() : _kandidaten;

    /// <summary>Factuurnummers zijn per BV: alleen facturen van de BV van de rekening (zie FactuurKandidatenAsync).</summary>
    private string KopBvTekst
        => _detail is not null && _rekeningen.FirstOrDefault(r => r.Nummer.Replace(" ", "") == _detail.Rekening.Replace(" ", "")) is { Bv.Length: > 0 } rk
            ? $" Alleen facturen van {rk.Bv}." : "";

    private async Task ZoekKandidaten()
    {
        if (_detail is null) return;
        _kandidaten = null;
        try { _kandidaten = await Repo.FactuurKandidatenAsync(_detail.Id, _kopVerkoop, _kopZoek, KopMax); }
        catch (Exception ex) { _kandidaten = new(); Toon("Facturen zoeken mislukt: " + ex.Message, true); }
    }

    private async Task KopSoortGewijzigd(ChangeEventArgs e) { _kopVerkoop = (string?)e.Value == "uit"; await ZoekKandidaten(); }
    private async Task KopZoekGewijzigd(ChangeEventArgs e) { _kopZoek = ((string?)e.Value ?? "").Trim(); _toonHalf = false; await ZoekKandidaten(); }
    private async Task WisKopZoek() { _kopZoek = ""; _toonHalf = false; await ZoekKandidaten(); }

    private void OpenKandidaat(FactuurKandidaat k)
    {
        if (k.Verkoop) _verkoopId = k.FactuurId; else _inkoopId = k.FactuurId;
    }

    private async Task Koppel(FactuurKandidaat k)
    {
        if (_detail is null || _kopBezig || !MagKoppelen) return;
        _kopBezig = true;
        try
        {
            await Repo.KoppelFactuurAsync(_detail.Id, k.Verkoop, k.FactuurId, Ik.WerknemerId);
            await NaKoppelWijziging();
            if (VolledigGekoppeld) _koppelOpen = false;
            Toon($"Factuur {(k.Nummer.Length > 0 ? k.Nummer : "#" + k.FactuurId)} gekoppeld" +
                 (k.Verkoop && !k.Betaald ? "; de factuur staat nog op onbetaald." : "."), false);
        }
        catch (Exception ex) { Toon("Koppelen mislukt: " + ex.Message, true); }
        finally { _kopBezig = false; }
    }

    private async Task Ontkoppel(GekoppeldeFactuur f)
    {
        if (_detail is null || _kopBezig || !MagKoppelen) return;
        bool ja;
        try { ja = await JS.InvokeAsync<bool>("mdeBevestig", $"De koppeling met factuur {FactuurTekst(f)} ({f.Relatie}) weghalen?"); }
        catch { ja = false; }
        if (!ja) return;
        _kopBezig = true;
        try
        {
            var reden = await Repo.OntkoppelFactuurAsync(_detail.Id, f.Verkoop, f.FactuurId);
            if (reden is not null) { Toon(reden, true); return; }
            await NaKoppelWijziging();
            Toon($"Koppeling met factuur {FactuurTekst(f)} weggehaald.", false);
        }
        catch (Exception ex) { Toon("Weghalen mislukt: " + ex.Message, true); }
        finally { _kopBezig = false; }
    }

    // ---- ongekoppelde transacties nalopen ----
    private const int ScanMax = 300;
    private sealed class ScanRegel
    {
        public required Banktransactie T { get; init; }
        public required FactuurKandidaat K { get; init; }
        public bool Zeker { get; init; }
        public bool Aan { get; set; }
        public bool Gekoppeld { get; set; }
    }
    private List<ScanRegel> _scan = new();
    private bool _scanOpen, _scanBezig;
    private int _scanGedaan, _scanTotaal;

    /// <summary>
    /// Het beste voorstel voor één transactie, of null. Zeker: precies één factuur met nummer, bedrag en rekening (of nummer
    /// en bedrag als geen voorstel de rekening kent). Anders: precies één met rekening en bedrag, nog nergens gekoppeld.
    /// </summary>
    private static (FactuurKandidaat K, bool Zeker)? Beste(List<FactuurKandidaat> l)
    {
        var zeker = l.Where(k => k.NummerInTekst && k.BedragGelijk && !k.NaBetaling && (k.IbanGelijk || !l.Any(x => x.IbanGelijk))).ToList();
        if (zeker.Count == 1) return (zeker[0], true);
        if (zeker.Count > 1) return null;
        // rekening en bedrag, de datum past; bij meer (een maandelijkse factuur) de laatste factuur vóór de betaling
        var rekening = l.Where(k => k.IbanGelijk && k.BedragGelijk && k.Elders == 0 && k.DatumPast)
                        .OrderBy(k => k.Dagen is int d && d >= 0 ? d : 1000 - (k.Dagen ?? 0)).ToList();
        return rekening.Count > 0 ? (rekening[0], false) : null;
    }

    private async Task OpenScan()
    {
        _scanOpen = true;
        _scan = new();
        var lijst = _lijst.Where(t => t.Facturen == 0 && t.Bedrag != 0).Take(ScanMax).ToList();
        _scanTotaal = lijst.Count;
        _scanGedaan = 0;
        _scanBezig = true;
        StateHasChanged();
        var gebruikt = new HashSet<(bool, int)>();     // een factuur maar bij één transactie voorstellen
        try
        {
            foreach (var t in lijst)
            {
                if (!_scanOpen) break;                  // venster dicht: stoppen
                try
                {
                    var l = await Repo.FactuurKandidatenAsync(t.Id, t.Bedrag > 0, null, 10);
                    if (Beste(l) is { } b && gebruikt.Add((b.K.Verkoop, b.K.FactuurId)) && b.K.Elders == 0)
                        _scan.Add(new ScanRegel { T = t, K = b.K, Zeker = b.Zeker, Aan = b.Zeker });
                }
                catch { /* een transactie die niet lukt, slaan we over */ }
                if (++_scanGedaan % 10 == 0) StateHasChanged();
            }
        }
        finally { _scanBezig = false; }
    }

    private void SluitScan() => _scanOpen = false;

    private async Task<bool> KoppelScanStil(ScanRegel s)
    {
        await Repo.KoppelFactuurAsync(s.T.Id, s.K.Verkoop, s.K.FactuurId, Ik.WerknemerId);
        s.Gekoppeld = true;
        s.Aan = false;
        s.T.Facturen = Math.Max(1, s.T.Facturen);
        return true;
    }

    private async Task KoppelScan(ScanRegel s)
    {
        if (_kopBezig || !MagKoppelen) return;
        _kopBezig = true;
        try { await KoppelScanStil(s); Toon($"Factuur {s.K.Nummer} gekoppeld.", false); }
        catch (Exception ex) { Toon("Koppelen mislukt: " + ex.Message, true); }
        finally { _kopBezig = false; }
    }

    private async Task KoppelAangevinkt()
    {
        var aan = _scan.Where(s => s.Aan && !s.Gekoppeld).ToList();
        if (aan.Count == 0 || _kopBezig || !MagKoppelen) return;
        bool ja;
        try { ja = await JS.InvokeAsync<bool>("mdeBevestig", $"{aan.Count} transactie(s) aan de voorgestelde factuur koppelen?\n\nAlleen de koppeling; de betaald-status van de facturen verandert niet."); }
        catch { ja = false; }
        if (!ja) return;
        _kopBezig = true;
        var n = 0;
        try
        {
            foreach (var s in aan) { await KoppelScanStil(s); n++; }
            Toon($"{n} transactie(s) gekoppeld.", false);
        }
        catch (Exception ex) { Toon($"{n} gekoppeld; daarna mislukt: {ex.Message}", true); }
        finally { _kopBezig = false; }
    }

    /// <summary>Gekoppelde facturen, voorstellen en het aantal in de lijst bijwerken.</summary>
    private async Task NaKoppelWijziging()
    {
        if (_detail is null) return;
        _facturen = await Repo.GekoppeldeFacturenAsync(_detail.Id);
        var regel = _lijst.FirstOrDefault(x => x.Id == _detail.Id);
        if (regel is not null) regel.Facturen = _facturen.Count;
        await ZoekKandidaten();
    }

    // ---- gekoppelde facturen: openen in het factuurvenster (inkomend of uitgaand) ----
    private List<GekoppeldeFactuur>? _facturen;
    private int? _inkoopId, _verkoopId;

    private static string FactuurTekst(GekoppeldeFactuur f) => f.Nummer.Length > 0 ? f.Nummer : "#" + f.FactuurId;

    private void OpenFactuur(GekoppeldeFactuur f)
    {
        if (f.Verkoop) _verkoopId = f.FactuurId; else _inkoopId = f.FactuurId;
    }

    private void FactuurDicht(bool _) { _inkoopId = null; _verkoopId = null; }

    private void SluitDetail() { _detail = null; _koppelOpen = false; }

    private async Task DetailOpmerkingGewijzigd(ChangeEventArgs e)
    {
        if (_detail is null) return;
        _detail.Opmerking = (string?)e.Value ?? "";
        try
        {
            await Repo.ZetOpmerkingAsync(_detail.Id, _detail.Opmerking);

            var regel = _lijst.FirstOrDefault(t => t.Id == _detail.Id);
            if (regel is not null) regel.Opmerking = _detail.Opmerking;

            Toon("Opgeslagen.", false);
        }
        catch (Exception ex) { Toon("Opslaan mislukt: " + ex.Message, true); }
    }

    private void SluitMelding() => _melding = null;
    private void Toon(string tekst, bool fout) { _melding = tekst; _fout = fout; }
}
