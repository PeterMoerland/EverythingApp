        {
            // LIKE op het nummer vindt ook PO-18123 bij 123; daarom ruim zoeken en op het id filteren
            try { b = (await Repo.ZoekAsync(id.ToString(), null, null, null, 500)).FirstOrDefault(x => x.Id == id); } catch { }
        }
