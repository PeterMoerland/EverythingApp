@* de gegevens van het artikel achter een orderregel *@
<ArtikelVenster ArtikelId="_bekeken" Sluiten="() => _bekeken = null" />
<InkoopBevestigingenPaneel Open="_bevestigingenOpen" Sluiten="() => _bevestigingenOpen = false"
                           OpOrder="NaarOrderUitBevestiging" OpGewijzigd="TelBevestigingen" />

@code {
    private List<BestelRegel> _lijst = new();
    private List<Bestelstatus> _statussen = new();
    private string _zoek = "";
    private int? _statusFilter;
    private int? _besteldDoor;
    private int? _bvFilter;

    private async Task BvFilterGewijzigd(ChangeEventArgs e)
    {
        _bvFilter = int.TryParse((string?)e.Value, out var v) ? v : null;
        await Laad();
    }

    private int? _orderId;
    private BestelRegel? _bestelling;
    private int _status;
    private string _tab = "Algemeen";

    private HashSet<string> _kolommen = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, object?> _velden = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, List<Keuze>> _lijsten = new();
    private static readonly List<Keuze> GeenLijst = new();

    private List<Orderregel> _regels = new();
    private List<Keuze> _eenheden = new();
    private List<Keuze> _leveranciers = new();
    private List<Keuze> _werkorders = new();
    private List<Workorder> _openWerkorders = new();
    /// <summary>Werkorders van projecten van BV's die niet mogen bestellen (Relaties > tab BV > Mag bestellen).</summary>
    private HashSet<int> _zonderBestelrecht = new();
    /// <summary>Per open werkorder de BV van zijn project (voor de BV-keuze in Nieuwe bestelling).</summary>
    private Dictionary<int, int> _werkorderBv = new();
    private List<Keuze> BestelBvs => Lijst("BestelBV");
    private List<Workorder> NieuwWerkorders => _openWerkorders.Where(w => !_zonderBestelrecht.Contains(w.WerkbonId)).ToList();

    private List<Bestand> _documenten = new();
    private bool _sleepActief;

    private bool _nieuwOpen;

    private string? _melding;
    private bool _fout;

    private string Titel => _bestelling is null ? "Bestellingen"
                          : $"{_bestelling.Nummer} · {_bestelling.Leverancier}";

    private VeldTab HuidigeTab
        => BestelVelden.Tabs.FirstOrDefault(t => t.Naam == _tab) ?? BestelVelden.Tabs[0];

    private string StatusFilterTekst => _statusFilter is int s ? s.ToString() : "";
    private string BesteldDoorTekst => _besteldDoor is int d ? d.ToString() : "";

    private List<Keuze> Lijst(string naam) => _lijsten.TryGetValue(naam, out var l) ? l : GeenLijst;

    private static string BekijkUrl(int id) => "bestand/" + id;
    private static string DownloadUrl(int id) => "bestand/" + id + "/download";

    private static string Bedrag(decimal waarde) => waarde.ToString("C2", new System.Globalization.CultureInfo("nl-NL"));

    /// <summary>
    /// Kleur van de onderregel, afgeleid van de statusnaam zelf. Dat is steviger
    /// dan werken met nummers: verandert er iets in OrderState, dan blijft dit werken.
    /// Groen = klaar, oranje = loopt en we wachten ergens op, grijs = eraf.
    /// </summary>
    private static string StatusKleur(string? status)
    {
        var s = (status ?? "").ToLowerInvariant();

        if (s.Contains("gereed") || s.Contains("afgehandeld") || s.Contains("compleet")) return "st-groen";
        if (s.Contains("annul") || s.Contains("vervallen")) return "st-grijs";
        if (s.Contains("levering") || s.Contains("bestell") || s.Contains("besteld")) return "st-oranje";

        return "";
    }
    private static string Getal(decimal? waarde) => waarde is null ? "" : waarde.Value.ToString("0.##");

    /// <summary>Stuksprijs in euro: "€ 1.234,50", met tot 4 decimalen als die er zijn (kleine onderdelen).</summary>
    private static string Euro(decimal? waarde)
        => waarde is null ? "" : "€ " + waarde.Value.ToString("#,##0.00##", new System.Globalization.CultureInfo("nl-NL"));

    /// <summary>bestellingen?order=123: die bestelling meteen openen (bv. vanuit de bel, in een nieuw tabblad).</summary>
    [SupplyParameterFromQuery(Name = "order")] public int? OrderParam { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Ik.ZorgGeladenAsync();
        if (!Repo.Beschikbaar) return;
        if (Ik.WerknemerId is int ikId)
        {
            try { _ik = await Repo.GoedkeurderAsync(ikId); } catch { }
        }

        try
        {
            _kolommen = await Repo.KolommenAsync();
            try { _statussen = await Repo.GetStatussenAsync(); } catch { }
            try { _eenheden = await Repo.GetEenhedenAsync(); } catch { }
            try { _leveranciers = await Repo.GetLeveranciersAsync(); } catch { }
            try
            {
                var open = await Uren.GetOpenWorkordersAsync();
                _openWerkorders = open;
                // alleen werkorders waarop ingekocht mag worden (Workorders.InkoopToegestaan); de huidige van een
                // bestelling komt er per bestelling bij (WerkorderLijst), anders is het veld leeg
                _werkorders = open.Where(w => w.InkoopToegestaan)
                                  // de klant staat niet in de tekst (wens gebruiker), maar je kunt er wel op zoeken
                                  .Select(w => (Keuze)new ZoekbareKeuze(w.WerkbonId, WerkorderTekst(w), w.Klant ?? "")).ToList();
            }
            catch { }

            _lijsten["Leverancier"] = _leveranciers;
            _lijsten["Werkorder"] = _werkorders;
            _lijsten["Taal"] = await Repo.GetTalenAsync();
            try
            {
                var wn = await Uren.GetWerknemersAsync();
                _lijsten["Werknemer"] = wn.Select(w => new Keuze(w.WerknemerId, w.Naam)).ToList();
            }
            catch { _lijsten["Werknemer"] = new List<Keuze>(); }
            _lijsten["Contact"] = new List<Keuze>();
            try { _lijsten["BV"] = await Repo.EigenBvsAsync(); } catch { _lijsten["BV"] = new List<Keuze>(); }
            // alleen BV's met "Mag bestellen" (Relaties > tab BV) in het filter en bij de werkorders
            try { _lijsten["BestelBV"] = await Repo.BestelBvsAsync(); } catch { _lijsten["BestelBV"] = new List<Keuze>(); }
            try
            {
                _zonderBestelrecht = await Repo.WerkordersZonderBestelrechtAsync();
                if (Lijst("BestelBV").Count > 1) _werkorderBv = await Repo.WerkorderBvsAsync();
                _werkorders = _werkorders.Where(w => !_zonderBestelrecht.Contains(w.Id)).ToList();
                _lijsten["Werkorder"] = _werkorders;
            }
            catch { }

            await Laad();
            await TelBevestigingen();
            if (OrderParam is int teOpenen) await OpenOrder(teOpenen);
        }
        catch (Exception ex) { Toon("Ophalen mislukt: " + ex.Message, true); }
    }

    /// <summary>Geannuleerde bestellingen (Cancel) standaard niet in de lijst (wens gebruiker).</summary>
    private bool _metGeannuleerd;

    private async Task GeannuleerdGewijzigd(ChangeEventArgs e)
    {
        _metGeannuleerd = e.Value is true;
        await Laad();
    }

    private async Task Laad(bool kiesBijEen = false)
    {
        try { _lijst = await Repo.ZoekAsync(_zoek, _statusFilter, null, _besteldDoor, 100, _metGeannuleerd, _bvFilter); }
        catch (Exception ex) { _lijst = new(); Toon("Zoeken mislukt: " + ex.Message, true); return; }

        if (kiesBijEen && _lijst.Count == 1) { await Kies(_lijst[0]); return; }
        if (kiesBijEen) Leegmaken();
    }

    private void Leegmaken()
    {
        _orderId = null;
        _bestelling = null;
        _velden = new(StringComparer.OrdinalIgnoreCase);
        _regels = new();
        _documenten = new();
        _facturen = new();
        _tab = "Algemeen";
    }

    private async Task ZoekGewijzigd(ChangeEventArgs e)
    {
        _zoek = (string?)e.Value ?? "";
        await Laad(kiesBijEen: true);
    }

    private async Task WisZoek()
    {
        _zoek = "";
        _statusFilter = null;
        _besteldDoor = null;
        Leegmaken();
        await Laad();
    }

    private async Task StatusFilterGewijzigd(ChangeEventArgs e)
    {
        _statusFilter = int.TryParse((string?)e.Value, out var v) ? v : null;
        await Laad(kiesBijEen: true);
    }

    private async Task BesteldDoorGewijzigd(ChangeEventArgs e)
    {
        _besteldDoor = int.TryParse((string?)e.Value, out var v) ? v : null;
        await Laad(kiesBijEen: true);
    }

    /// <summary>Snelknop: alleen wat ik zelf besteld heb, of weer alles.</summary>
    private async Task AlleenIk()
    {
        _besteldDoor = _besteldDoor == Ik.WerknemerId ? null : Ik.WerknemerId;
        await Laad(kiesBijEen: true);
    }

    // ================================================================
    //  Bladeren met het toetsenbord
    //  De kop verspringt meteen; de rest (regels, documenten) wordt pas geladen
    //  als je even stilstaat, zodat doorhouden van de pijltjestoets de database
    //  niet plat legt.
    // ================================================================
    private bool _pijltje;
    private int _laadteller;

    private async Task Toetsen(KeyboardEventArgs e)
    {
        if (_lijst.Count == 0) return;

        var huidig = _lijst.FindIndex(b => b.Id == _orderId);
        var nieuw = e.Key switch
        {
            "ArrowDown" => huidig + 1,
            "ArrowUp" => huidig - 1,
            "PageDown" => huidig + 10,
            "PageUp" => huidig - 10,
            "Home" => 0,
            "End" => _lijst.Count - 1,
            _ => -1,
        };

        // Andere toetsen (Tab, letters) gewoon hun gang laten gaan
        _pijltje = nieuw >= -1 && e.Key.StartsWith("Arrow") || e.Key is "PageDown" or "PageUp" or "Home" or "End";
        if (nieuw == -1 && !_pijltje) return;

        nieuw = Math.Clamp(nieuw, 0, _lijst.Count - 1);
        if (nieuw == huidig) return;

        var gekozen = _lijst[nieuw];

        // meteen zichtbaar: markering en kop
        _orderId = gekozen.Id;
        _bestelling = gekozen;
        _status = gekozen.Status;
        _regels = new();
        _documenten = new();
        _facturen = new();
        StateHasChanged();

        try { await JS.InvokeVoidAsync("mdeLijst.naarActief", "bestellijst"); } catch { }

        // en na een korte stilte de rest erbij
        var teller = ++_laadteller;
        await Task.Delay(180);
        if (teller != _laadteller) return;

        await Kies(gekozen);
        StateHasChanged();
    }

    private async Task Kies(BestelRegel b)
    {
        _orderId = b.Id;
        _bestelling = b;
        _status = b.Status;
        _laadteller++;          // een klik annuleert een lopende toetsenbordronde
        await WachtOpOpslaan();

        try { _velden = await Repo.GetVeldenAsync(b.Id); }
        catch (Exception ex) { Toon("Gegevens ophalen mislukt: " + ex.Message, true); }

        await WerkorderLijst();
        await LaadWerkorder();
        await LaadContacten();
        await LaadStandaard();
        await LaadFlow();
        await LaadRegels();
        await LaadDocumenten();
        await LaadFacturen();
    }

