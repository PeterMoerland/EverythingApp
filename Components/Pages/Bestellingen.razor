    // ================================================================
    //  Bladeren met het toetsenbord
    //  De kop verspringt meteen; de rest (regels, documenten) wordt pas geladen
    //  als je even stilstaat, zodat doorhouden van de pijltjestoets de database
    //  niet plat legt.
    // ================================================================
    private bool _pijltje;
    private int _laadteller;

    private async Task Toetsen(KeyboardEventArgs e)
    {
        if (_lijst.Count == 0) return;

        var huidig = _lijst.FindIndex(b => b.Id == _orderId);
        var nieuw = e.Key switch
        {
            "ArrowDown" => huidig + 1,
            "ArrowUp" => huidig - 1,
            "PageDown" => huidig + 10,
            "PageUp" => huidig - 10,
            "Home" => 0,
            "End" => _lijst.Count - 1,
            _ => -1,
        };

        // Andere toetsen (Tab, letters) gewoon hun gang laten gaan
        _pijltje = nieuw >= -1 && e.Key.StartsWith("Arrow") || e.Key is "PageDown" or "PageUp" or "Home" or "End";
        if (nieuw == -1 && !_pijltje) return;

        nieuw = Math.Clamp(nieuw, 0, _lijst.Count - 1);
        if (nieuw == huidig) return;

        var gekozen = _lijst[nieuw];

        // meteen zichtbaar: markering en kop
        _orderId = gekozen.Id;
        _bestelling = gekozen;
        _status = gekozen.Status;
        _regels = new();
        _documenten = new();
        StateHasChanged();

        try { await JS.InvokeVoidAsync("mdeLijst.naarActief", "bestellijst"); } catch { }

        // en na een korte stilte de rest erbij
        var teller = ++_laadteller;
        await Task.Delay(180);
        if (teller != _laadteller) return;

        await Kies(gekozen);
        StateHasChanged();
    }

    private async Task Kies(BestelRegel b)
    {
        _orderId = b.Id;
        _bestelling = b;
        _status = b.Status;
        _laadteller++;          // een klik annuleert een lopende toetsenbordronde

        try { _velden = await Repo.GetVeldenAsync(b.Id); }
        catch (Exception ex) { Toon("Gegevens ophalen mislukt: " + ex.Message, true); }

        await WerkorderLijst();
        await LaadWerkorder();
        await LaadContacten();
        await LaadStandaard();
        await LaadRegels();
        await LaadDocumenten();
    }

    /// <summary>
    /// Keuzelijst Werkorder in het orderformulier: de werkorders waarop ingekocht mag worden, plus de huidige van deze
    /// bestelling als die er niet bij zit (gesloten of geen inkoop toegestaan), zodat het veld niet leeg lijkt.
    /// </summary>
    private async Task WerkorderLijst()
    {
        var lijst = _werkorders;
        if (Nummer("Workorder-id") is int huidig && !lijst.Any(k => k.Id == huidig))
        {
            string naam;
            try
            {
                var w = await Uren.GetWorkorderAsync(huidig);
                naam = w is null ? $"#{huidig}"
                     : WerkorderTekst(w) + (w.InkoopToegestaan ? " (gesloten)" : " (geen inkoop toegestaan)");
            }
            catch { naam = $"#{huidig}"; }
            lijst = lijst.Prepend(new Keuze(huidig, naam)).ToList();
        }
        _lijsten["Werkorder"] = lijst;
    }

    /// <summary>
    /// Tekst in de keuzelijst Werkorder: nummer · project · werkorder ("Inkoop" alleen zegt weinig). De klant staat
    /// bewust niet in de lijst maar rechts in het blok Werkorder (wens gebruiker).
    /// </summary>
    private static string WerkorderTekst(Workorder w)
        => string.Join(" · ", new[] { w.Weergave, w.Project?.Trim(), w.Omschrijving?.Trim() }.Where(s => !string.IsNullOrWhiteSpace(s)));

