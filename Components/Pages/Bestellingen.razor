@page "/bestellingen"
@inject IBestelRepository Repo
@inject IUrenRepository Uren
@inject IWerknemerRepository WnRepo
@inject FilestoreService Store
@inject HuidigeGebruiker Ik
@inject IJSRuntime JS
@inject IMeldingRepository Meldingen
@inject MeldingSignaal Signaal
@inject BestelregelLezer Schermlezer
@inject IArtikelRepository Artikelen
@inject IPakbonRepository Pakbonnen
@inject PakbonPdfService PakbonPdf
@inject IInkoopBevestigingRepository BevestigingRepo
@inject InkoopBevestigingOphaler BevestigingOphaler
@inject IOntvangstRepository Ontvangst
@inject GeleverdMelding GeleverdMelder

<div class="page">
    <header class="topbar">
        <h1>@Titel</h1>
        <span class="weeklabel">
            @if (_orderId is not null)
            {
                <span class="po-totaal">Totaal @Bedrag(_regels.Sum(r => r.Regeltotaal))</span>
            }
            else
            {
                @($"{_lijst.Count} bestellingen")
            }
        </span>
    </header>

    @if (!Repo.Beschikbaar)
    {
        <section class="module-placeholder"><p>Dit scherm werkt alleen met de live database.</p></section>
    }
    else
    {
        @if (_melding is not null)
        {
            <div class="melding @(_fout ? "fout" : "ok")" @onclick="SluitMelding">@_melding</div>
        }

        <div class="wn-scherm">
            @* ---------- links: zoeken ---------- *@
            <aside class="wn-lijst bestel-lijst">
                <div class="wn-filters">
                    <div class="zoekregel">
                        <input data-zoeklijst placeholder="PO-nummer, leverancier, omschrijving…" value="@_zoek"
                               @onchange="ZoekGewijzigd" />
                        <button class="klein" title="Wissen" disabled="@(_zoek.Length == 0)" @onclick="WisZoek">✕</button>
                    </div>
                    <div class="zoekregel">
                        <select value="@StatusFilterTekst" @onchange="StatusFilterGewijzigd">
                            <option value="">Alle statussen</option>
                            @foreach (var s in FilterStatussen)
                            {
                                <option value="@s.Id">@s.Omschrijving</option>
                            }
                        </select>
                    </div>
                    @if (Lijst("BestelBV").Count > 1)
                    {
                        <div class="zoekregel">
                            <select value="@(_bvFilter?.ToString() ?? string.Empty)" @onchange="BvFilterGewijzigd">
                                <option value="">Alle BV's</option>
                                @foreach (var bv in Lijst("BestelBV"))
                                {
                                    <option value="@bv.Id">@bv.Naam</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="zoekregel">
                        <select value="@BesteldDoorTekst" @onchange="BesteldDoorGewijzigd">
                            <option value="">Besteld door iedereen</option>
                            @foreach (var w in Lijst("Werknemer"))
                            {
                                <option value="@w.Id">@w.Naam</option>
                            }
                        </select>
                        <button class="klein" title="Alleen mijn bestellingen"
                                disabled="@(Ik.WerknemerId is null)" @onclick="AlleenIk">Ik</button>
                    </div>
                    <div class="btngroup">
                        <button class="klein" @onclick="OpenNieuw">+ Nieuwe bestelling</button>
                        <button class="klein" title="Zoeken door de regels van alle bestellingen (artikelnummer, omschrijving, MDE-nummer)"
                                @onclick="OpenZoekRegels">🔍 In regels…</button>
                        @if (BevestigingRepo.Beschikbaar)
                        {
                            <button class="klein" title="Orderbevestigingen uit de inkooppostbus: wat vanzelf bij een bestelling is gezet, en wat je zelf moet toewijzen"
                                    @onclick="() => _bevestigingenOpen = true">📥 Bevestigingen@(_bevestigingenTeDoen > 0 ? $" ({_bevestigingenTeDoen})" : "")</button>
                        }
                        <label class="vink" title="Bestellingen met status Cancel ook in de lijst">
                            <input type="checkbox" checked="@_metGeannuleerd" @onchange="GeannuleerdGewijzigd" /> Geannuleerde tonen
                        </label>
                    </div>
                </div>

                <NieuweBestellingVenster Open="_nieuwOpen" Leveranciers="_leveranciers" Werkorders="NieuwWerkorders"
                                         Bvs="BestelBvs" WerkorderBv="_werkorderBv"
                                         WerknemerId="Ik.WerknemerId" OpAanmaken="MaakBestelling" OpGesloten="SluitNieuw" />
                <BestelZoekVenster Open="_zoekRegelsOpen" OpGekozen="ZoekRegelGekozen" OpGesloten="SluitZoekRegels" />

                @* tabindex maakt de lijst zelf bereikbaar, zodat de pijltjestoetsen
                   hier binnenkomen in plaats van bij de losse knoppen *@
                <div id="bestellijst" class="wn-namen" tabindex="0"
                     @onkeydown="Toetsen" @onkeydown:preventDefault="_pijltje">
                    @if (_lijst.Count == 0)
                    {
                        <div class="kiezer-info">Niets gevonden.</div>
                    }
                    else
                    {
                        @foreach (var b in _lijst)
                        {
                            <button class="wn-naam @(b.Id == _orderId ? "actief" : "")"
                                    @key="b.Id" @onclick="() => Kies(b)">
                                <span class="nda-regel">
                                    <span class="nda-naam">@b.Nummer · @b.Leverancier@if (b.Bv.Length > 0 && b.Bv != "AUTO") {<span class="av-bv">@b.Bv</span>}</span>
                                    <span class="nda-onder @StatusKleur(b.StatusNaam)">
                                        @b.StatusNaam
                                        @if (b.Totaal > 0)
                                        {
                                            <text> · @Bedrag(b.Totaal)</text>
                                        }
                                    </span>
                                </span>
                            </button>
                        }
                    }
                </div>
                <p class="uitleg toetsuitleg">Klik in de lijst en blader met ↑ en ↓.</p>
            </aside>

            @* ---------- rechts: de bestelling ---------- *@
            <section class="wn-detail">
                @if (_orderId is null)
                {
                    <div class="kiezer-info">Kies links een bestelling, of maak een nieuwe aan.</div>
                }
                else
                {
                    @* statusbalk: waar staat deze bestelling? Vrij springen alleen voor de Directie (rechtzetten);
                       de gewone weg is Volgende (Services/BestelFlow.cs). *@
                    @* Volgende (en Afkeuren) vóór de statuslampjes, met ruimte ertussen (wens gebruiker) *@
                    <div class="status-rij @(HeeftKnoppen ? "" : "zonder-knop")">
                        @if (_flow is { } fl && HeeftKnoppen)
                        {
                            <div class="volgende-knoppen">
                                @* mail aan de leverancier: offerte aanvragen bij Aanmaken, de bestelling bij In bestelling *@
                                @if (fl.Status == BestelFlow.Aanmaken)
                                {
                                    <button class="klein" @onclick="() => _mailOrder = _orderId" title="Prijs en levertijd vragen (PI-)">✉ Offerte aanvragen…</button>
                                }
                                else if (fl.Status == BestelFlow.InBestelling)
                                {
                                    <button class="klein" @onclick="() => _mailOrder = _orderId" title="De bestelling naar de leverancier mailen (PO-)">✉ Bestelling versturen…</button>
                                }
                                @if (fl.Status <= BestelFlow.WachtOpLevering)
                                {
                                    <button class="primair" disabled="@(_volgendeBezig || BestelFlow.MagNiet(fl, _ik) is not null)"
                                            title="@(BestelFlow.MagNiet(fl, _ik) ?? (fl.Status == BestelFlow.WachtOpLevering ? "De bestelling is binnen: op Gereed zetten (met de vraag of de geleverde aantallen gelijk moeten worden aan wat besteld is)" : ""))" @onclick="Volgende">
                                        @(fl.Status == BestelFlow.InBestelling ? "Besteld ▸" : fl.Status == BestelFlow.WachtOpLevering ? "Gereed ▸" : "Volgende ▸")
                                    </button>
                                }
                                @if (BestelFlow.MagAfkeuren(fl, _ik))
                                {
                                    <button class="klein rood" disabled="@_volgendeBezig" @onclick="OpenAfkeuren"
                                            title="Terug naar Aanmaken, met een reden voor de besteller">Afkeuren…</button>
                                }
                            </div>
                        }
                        <div class="statusbalk">
                            @foreach (var s in Lampjes)
                            {
                                <button class="stap @(s.Id == _status ? "nu" : "") @StapKlasse(s)"
                                        @key="s.Id" disabled="@(!MagSpringen)" title="@StapTip(s)" @onclick="() => ZetStatus(s)">
                                    @(StapKlasse(s) == "gehad" ? "✓ " : "")@s.Omschrijving
                                </button>
                            }
                        </div>
                        @if (_flow is { } fu && BestelFlow.Uitleg(fu).Length > 0)
                        {
                            <div class="volgende-uitleg">@BestelFlow.Uitleg(fu)</div>
                        }
                    </div>
                    @if (_afkeurOpen)
                    {
                        <div class="cmdk-overlay midden" @onclick="() => _afkeurOpen = false">
                            <div class="kiezer afkeur-venster" @onclick:stopPropagation role="dialog" aria-label="Afkeuren">
                                <div class="kiezer-kop"><b>PO-@_orderId afkeuren</b></div>
                                <div class="afkeur-inhoud">
                                    <p class="uitleg">De bestelling gaat terug naar Aanmaken. De besteller krijgt een melding met de reden;
                                        die komt ook in de interne opmerking.</p>
                                    <textarea rows="4" placeholder="Reden (verplicht), bv. andere leverancier kiezen, aantallen te hoog…"
                                              value="@_afkeurReden" @oninput="e => _afkeurReden = (string?)e.Value ?? string.Empty"></textarea>
                                </div>
                                <div class="kiezer-voet">
                                    <span style="flex:1"></span>
                                    <button class="klein" @onclick="() => _afkeurOpen = false">Annuleren</button>
                                    <button class="primair rood-vlak" disabled="@(_afkeurReden.Trim().Length == 0 || _volgendeBezig)" @onclick="Afkeuren">Afkeuren</button>
                                </div>
                            </div>
                        </div>
                    }

                    @* gereed melden (Volgende bij Wacht op levering): de vraag uit Access of de geleverde aantallen gelijk
                       moeten worden aan wat besteld is. Ja / Nee / Annuleren. *@
                    @if (_gereedOrder is not null && _gereedOrder == _orderId)
                    {
                        <div class="cmdk-overlay midden" @onclick="() => _gereedOrder = null">
                            <div class="kiezer gereed-venster" @onclick:stopPropagation role="dialog" aria-label="Gereed melden">
                                <div class="kiezer-kop"><b>PO-@_orderId gereed melden</b></div>
                                <div class="afkeur-inhoud">
                                    @if (_gereedRegels.Count == 0)
                                    {
                                        <p>Alles van deze bestelling is al als geleverd geboekt. De bestelling op <b>Gereed</b> zetten?</p>
                                    }
                                    else
                                    {
                                        <p><b>Wil je alle geleverde aantallen aanpassen aan wat besteld is?</b></p>
                                        <p class="uitleg">
                                            Van @_gereedRegels.Count regel@(_gereedRegels.Count == 1 ? "" : "s") is nog niet alles als geleverd geboekt.
                                            <b>Ja</b>: wat hieronder openstaat wordt als geleverd geboekt (pakbon @MySqlOntvangstRepository.PakbonGelijkGemaakt, zoals in Access) en de bestelling gaat op Gereed.
                                            <b>Nee</b>: de bestelling gaat op Gereed en de aantallen blijven zoals ze zijn.
                                        </p>
                                        <div class="gereed-regels">
                                            <table class="kiezer-tabel">
                                                <thead>
                                                    <tr>
                                                        <th style="width:9rem">Artikelcode</th>
                                                        <th>Omschrijving</th>
                                                        <th style="width:4.6rem" class="r">Besteld</th>
                                                        <th style="width:4.6rem" class="r">Geleverd</th>
                                                        <th style="width:4.6rem" class="r">Open</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var r in _gereedRegels)
                                                    {
                                                        <tr @key="r.RegelId">
                                                            <td class="omschrijving" title="@r.Artikel">@r.Artikel</td>
                                                            <td class="omschrijving" title="@r.Omschrijving">@r.Omschrijving</td>
                                                            <td class="r">@r.Besteld.ToString("0.##")</td>
                                                            <td class="r">@(r.Geleverd != 0 ? r.Geleverd.ToString("0.##") : "")</td>
                                                            <td class="r"><b>@r.Open.ToString("0.##")</b></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                                <div class="kiezer-voet">
                                    <span style="flex:1"></span>
                                    <button class="klein" disabled="@_volgendeBezig" @onclick="() => _gereedOrder = null">Annuleren</button>
                                    @if (_gereedRegels.Count == 0)
                                    {
                                        <button class="primair" disabled="@_volgendeBezig" @onclick="() => GereedMelden(false)">Gereed melden</button>
                                    }
                                    else
                                    {
                                        <button class="klein" disabled="@_volgendeBezig" @onclick="() => GereedMelden(false)">Nee, alleen gereed melden</button>
                                        <button class="primair" disabled="@_volgendeBezig" @onclick="() => GereedMelden(true)">Ja, aanpassen en gereed melden</button>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <div class="wn-tabs">
                        @foreach (var tab in BestelVelden.Tabs)
                        {
                            <button class="@(tab.Naam == _tab ? "actief" : "")"
                                    @onclick="() => _tab = tab.Naam">@tab.Naam</button>
                        }
                        <button class="@("Documenten" == _tab ? "actief" : "")"
                                @onclick="KiesDocumenten">Documenten (@_documenten.Count)</button>
                        @* de inkomende facturen die aan deze bestelling gekoppeld zijn; voor iedereen (wens gebruiker 13-11-2026) *@
                        <button class="@("Facturen" == _tab ? "actief" : "")"
                                title="De facturen van de leverancier die aan deze bestelling gekoppeld zijn"
                                @onclick="KiesFacturen">Facturen (@_facturen.Count)</button>
                    </div>

                    @if (_tab == "Documenten")
                    {
                        @* tegels met een miniatuur (wens gebruiker 13-11-2026): afbeeldingen en PDF's in het klein, de rest met de
                           bestandssoort. Het vlak heeft een vaste minimale hoogte, zodat de regels eronder niet omhoog springen. *@
                        <div class="tabvlak">
                            @if (_documenten.Count == 0)
                            {
                                <p class="uitleg">Nog geen documenten.</p>
                            }
                            else
                            {
                                <div class="doc-tegels">
                                    @foreach (var d in _documenten)
                                    {
                                        <div class="doc-tegel" @key="d.FileStoreId">
                                            @Mini(d)
                                            <button class="bestandnaam doc-naam" title="@d.Bestandsnaam"
                                                    @onclick="() => ToonVoorbeeld(d)">@d.Bestandsnaam</button>
                                            <div class="doc-voet">
                                                <span class="doc-wanneer" title="@(d.ToegevoegdDoor + (d.Toegevoegd is DateTime t ? " · " + t.ToString("dd-MM-yyyy HH:mm") : ""))">
                                                    @(d.Toegevoegd?.ToString("dd-MM-yyyy") ?? "") @d.ToegevoegdDoor
                                                </span>
                                                <a class="knopje" href="@DownloadUrl(d.FileStoreId)" title="Downloaden">⭳</a>
                                                <button class="klein rood" title="Verwijderen" @onclick="() => VerwijderDocument(d)">✕</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            <div class="sleepzone @(_sleepActief ? "actief" : "")"
                                 @ondragenter="() => _sleepActief = true"
                                 @ondragleave="() => _sleepActief = false"
                                 @ondragover:preventDefault="true">
                                <span>Sleep hier een bestand, of klik om te kiezen</span>
                                <InputFile OnChange="BestandenGekozen" multiple />
                            </div>
                        </div>
                    }
                    else if (_tab == "Facturen")
                    {
                        @* per factuurbestand een tegel met een miniatuur; klikken toont alleen het voorbeeld. Bewust geen link naar
                           Financiën of een nieuw venster (wens gebruiker 13-11-2026): vanuit Bestellingen kijk je alleen. *@
                        <div class="tabvlak">
                            @if (_facturen.Count == 0)
                            {
                                <p class="uitleg">Er is nog geen factuur aan deze bestelling gekoppeld.</p>
                            }
                            else
                            {
                                <div class="doc-tegels">
                                    @foreach (var f in _facturen)
                                    {
                                        @foreach (var d in f.Bestanden)
                                        {
                                            <div class="doc-tegel" @key="d.FileStoreId">
                                                @Mini(d)
                                                <button class="bestandnaam doc-naam" title="@("Factuur " + FactuurNaam(f) + " bekijken (" + d.Bestandsnaam + ")")"
                                                        @onclick="() => ToonVoorbeeld(d)"><b>@FactuurNaam(f)</b></button>
                                                <div class="doc-voet">
                                                    <span class="doc-wanneer" title="@FactuurUitleg(f)">
                                                        @(f.Factuurdatum?.ToString("dd-MM-yyyy") ?? "") · @Bedrag(f.Gekoppeld)
                                                    </span>
                                                    <span class="stand-chip @(f.Betaald ? "s-groen" : "s-grijs")">@(f.Betaald ? "betaald" : "open")</span>
                                                </div>
                                            </div>
                                        }
                                        @if (f.Bestanden.Count == 0)
                                        {
                                            <div class="doc-tegel" @key="@("f" + f.FactuurId)">
                                                <div class="doc-mini leeg"><span class="uitleg">geen bestand</span></div>
                                                <span class="doc-naam"><b>@FactuurNaam(f)</b></span>
                                                <div class="doc-voet">
                                                    <span class="doc-wanneer" title="@FactuurUitleg(f)">
                                                        @(f.Factuurdatum?.ToString("dd-MM-yyyy") ?? "") · @Bedrag(f.Gekoppeld)
                                                    </span>
                                                    <span class="stand-chip @(f.Betaald ? "s-groen" : "s-grijs")">@(f.Betaald ? "betaald" : "open")</span>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                                <p class="uitleg">
                                    Besteld @Bedrag(_regels.Sum(r => r.Regeltotaal)), gefactureerd op deze bestelling @Bedrag(_facturen.Sum(f => f.Gekoppeld)) (ex btw).
                                    Klik op een factuur om hem te bekijken.
                                </p>
                            }
                        </div>
                    }
                    else
                    {
                        <DetailMetZij>
                            <Hoofd>
                                @if (_tab == "Voortgang")
                                {
                                    @* per stap: wanneer en door wie (de *date- en *by-kolommen van Orders) *@
                                    <div class="voortgang">
                                        @foreach (var st in Voortgang())
                                        {
                                            <div class="vg-stap @st.Klasse">
                                                <span class="vg-naam">@st.Naam</span>
                                                <span class="vg-wanneer">@st.Wanneer</span>
                                                <span class="vg-wie">@st.Wie</span>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <VeldRaster @key="_orderId" Tab="HuidigeTab" Kolommen="_kolommen" Velden="_velden"
                                                Lijsten="_lijsten" OpSlaan="Bewaar" />
                                }
                            </Hoofd>
                            <Zij>
                                <ZijBlok Titel="Leverancier" Leeg="@(LeverancierNaam() is null)"
                                         LeegTekst="Nog geen leverancier gekozen.">
                                    <div class="zij-regel">
                                        <span class="zij-naam">@LeverancierNaam()</span>
                                        @* telefoonnummers om erachteraan te bellen (wens gebruiker 13-11-2026): van de leverancier en van de contactpersoon *@
                                        @if (_levBereik is { } lb && (lb.Telefoon.Length > 0 || lb.Mobiel.Length > 0))
                                        {
                                            <span class="zij-extra zij-bel">
                                                @Bel(lb.Telefoon, "☎", "Telefoon van de leverancier")
                                                @Bel(lb.Mobiel, "📱", "Mobiel nummer van de leverancier")
                                            </span>
                                        }
                                        <span class="zij-extra">@ContactNaam()</span>
                                        @if (ContactBereik() is { } cb && (cb.Telefoon.Length > 0 || cb.Mobiel.Length > 0))
                                        {
                                            <span class="zij-extra zij-bel">
                                                @Bel(cb.Telefoon, "☎", "Telefoon van de contactpersoon")
                                                @Bel(cb.Mobiel, "📱", "Mobiel nummer van de contactpersoon")
                                            </span>
                                        }
                                        @if (_levStandaard is { Cc: true } cc)
                                        {
                                            <span class="zij-extra" title="Relaties: CC bij bestelling. Access vroeg dit bij het versturen van de bestelling.">CC bij bestelling: @cc.CcAdres</span>
                                        }
                                    </div>
                                </ZijBlok>

                                <ZijBlok Titel="Werkorder" Leeg="@(_werkorder is null)" LeegTekst="Geen werkorder gekozen.">
                                    @if (_werkorder is { } wo)
                                    {
                                        <div class="zij-regel">
                                            <span class="zij-naam">@wo.Weergave · @wo.Omschrijving</span>
                                            <span class="zij-extra">Project: @(string.IsNullOrWhiteSpace(wo.Project) ? "—" : wo.Project)</span>
                                            <span class="zij-extra">Klant: @(string.IsNullOrWhiteSpace(wo.Klant) ? "—" : wo.Klant)</span>
                                        </div>
                                    }
                                </ZijBlok>

                                <ZijBlok Titel="Regels" Aantal="_regels.Count"
                                         Leeg="@(_regels.Count == 0)" LeegTekst="Nog geen regels.">
                                    <div class="zij-regel">
                                        <span class="zij-naam">@Bedrag(_regels.Sum(r => r.Regeltotaal))</span>
                                        <span class="zij-extra">
                                            @_regels.Count(r => r.Compleet) van @_regels.Count geleverd
                                        </span>
                                    </div>
                                </ZijBlok>

                                @* wie de bestelling aanmaakte (Orders.Created by), en wie hem bij de leverancier bestelde als dat iemand anders was *@
                                <ZijBlok Titel="Besteller" Leeg="@(VeldId("Created by") is null)" LeegTekst="Onbekend.">
                                    <div class="zij-regel">
                                        <span class="zij-naam">@WerknemerNaam(VeldId("Created by"))</span>
                                        @if (Datum("Creation date") is DateTime aangemaakt)
                                        {
                                            <span class="zij-extra">Aangemaakt @aangemaakt.ToString("dd-MM-yyyy")</span>
                                        }
                                        @if (VeldId("Ordered by") is int besteld && besteld != VeldId("Created by"))
                                        {
                                            <span class="zij-extra">Besteld door @WerknemerNaam(besteld)@(Datum("Ordered date") is DateTime op ? " op " + op.ToString("dd-MM-yyyy") : "")</span>
                                        }
                                    </div>
                                </ZijBlok>
                            </Zij>
                        </DetailMetZij>
                    }

                    @* ---------- de regels ----------
                       Werkbalk: alles wat regels toevoegt staat hier (besluit gebruiker 16-10-2026). Nieuwe imports
                       (SMC-, Solar-website, Materialise-prijzen uit Access) komen in het menu Importeren. *@
                    <div class="regels-balk">
                        <h3 class="wn-kop">Regels</h3>
                        <div class="btngroup">
                            <button class="klein" @onclick="NieuweRegel">+ Regel</button>
                            <button class="klein" disabled="@(_pakbonBezig || _regels.Count == 0)" @onclick="PakbonMaken"
                                    title="Een pakbon voor deze leverancier met de regels van deze bestelling, om mee te geven (bv. delen die naar de anodiseerder gaan)">
                                @(_pakbonBezig ? "Bezig…" : "📦 Pakbon")</button>
                            <div class="menu-knop">
                                <button class="klein" @onclick="() => _importMenu = !_importMenu">Importeren ▾</button>
                                @if (_importMenu)
                                {
                                    <div class="menu-dicht" @onclick="() => _importMenu = false"></div>
                                    <div class="menu-lijst" @onclick="() => _importMenu = false">
                                        <button @onclick="() => _plakOpen = true"
                                                title="Onderdelen van het klembord toevoegen, bv. uit Inventor (Collect Parts ▸ stuklijst naar klembord)">📋 Plakken uit klembord</button>
                                        <button disabled="@(!Schermlezer.Beschikbaar)" @onclick="() => _schermOpen = true"
                                                title="@(Schermlezer.Beschikbaar ? "Een screenshot (Win+Shift+S) of PDF van een winkelwagen, offerte of orderbevestiging laten lezen door de AI" : "Bedrock is niet ingesteld")">📷 Uit screenshot of PDF</button>
                                        <button @onclick="() => _uitBestellingOpen = true"
                                                title="Regels uit een andere bestelling overnemen, bv. gefreesde delen die nu geanodiseerd moeten worden">📦 Uit andere bestelling</button>
                                        <button disabled title="Volgt: staat nog in Access">SMC-website <small>volgt</small></button>
                                        <button disabled title="Volgt: staat nog in Access">Solar-website <small>volgt</small></button>
                                        <button disabled title="Volgt: staat nog in Access">Materialise-prijzen <small>volgt</small></button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="regels-omhulsel">
                        <table class="kiezer-tabel regels">
                            <thead>
                                <tr>
                                    <th style="width:3.6rem" class="c">Aantal</th>
                                    <th style="width:4.2rem">Eenh.</th>
                                    <th style="width:10rem">Artikelcode</th>
                                    <th>Omschrijving</th>
                                    <th style="width:5.5rem">MDE</th>
                                    <th style="width:6.6rem">Leverdatum</th>
                                    <th style="width:5.5rem" class="r">Prijs</th>
                                    <th style="width:3.8rem" class="r" title="Korting in procenten">Korting</th>
                                    <th style="width:6rem" class="r">Totaal</th>
                                    <th style="width:3.6rem" class="c" title="Geleverd">Gelev.</th>
                                    <th style="width:4.6rem"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var regel in _regels)
                                {
                                    <tr @key="regel.Id" class="@(regel.Compleet ? "geleverd" : "")">
                                        <td><input class="c" value="@regel.Aantal"
                                                   @onchange="e => ZetGetal(regel, v => regel.Aantal = v, e)" /></td>
                                        <td>
                                            <select value="@EenheidTekst(regel)" @onchange="e => ZetEenheid(regel, e)">
                                                <option value="">—</option>
                                                @foreach (var ve in _eenheden)
                                                {
                                                    <option value="@ve.Id">@ve.Naam</option>
                                                }
                                            </select>
                                        </td>
                                        <td><input value="@regel.Artikelcode" maxlength="100" title="Dubbelklik of Alt+Enter: artikel zoeken"
                                                   @oninput="e => _artikelTekst[regel.Id] = (string?)e.Value ?? string.Empty"
                                                   @ondblclick="() => OpenArtikelZoek(regel)"
                                                   @onkeydown="e => ArtikelcodeToets(regel, e)"
                                                   @onchange="e => Zet(regel, v => regel.Artikelcode = v, e)" /></td>
                                        <td><input value="@regel.Omschrijving" maxlength="400"
                                                   @onchange="e => Zet(regel, v => regel.Omschrijving = v, e)" /></td>
                                        @* Het MDE-nummer blijft te wijzigen; staat er een geldig
                                           nummer, dan opent het knopje de artikelgegevens. *@
                                        <td>
                                            <div class="mde-cel">
                                                <input value="@regel.MdeCode"
                                                       @onchange="e => Zet(regel, v => regel.MdeCode = v, e)" />
                                                @if (MdeNummer(regel.MdeCode) is int nr)
                                                {
                                                    <button class="klein" title="Gegevens van dit artikel"
                                                            @onclick="() => _bekeken = nr">🔍</button>
                                                }
                                            </div>
                                        </td>
                                        <td><NlDatum Waarde="regel.Leverdatum"
                                                     WaardeChanged="d => ZetDatum(regel, d)" /></td>
                                        <td><input class="r" value="@Euro(regel.Prijs)"
                                                   @onchange="e => ZetBedrag(regel, v => regel.Prijs = v, e)" /></td>
                                        <td><input class="r" value="@Getal(regel.KortingProcent)" title="Korting in procenten"
                                                   @onchange="e => ZetKorting(regel, e)" /></td>
                                        <td class="r">@Bedrag(regel.Regeltotaal)</td>
                                        <td class="c" title="@(regel.Geleverd + " van " + regel.Aantal)">
                                            @(regel.Geleverd > 0 ? regel.Geleverd.ToString("0.##") : "")
                                        </td>
                                        <td class="c">
                                            <button class="klein @(regel.Bijlagen > 0 ? "metbijlage" : "")"
                                                    title="Bijlagen bij deze regel"
                                                    @onclick="() => OpenBijlagen(regel)">
                                                📎@(regel.Bijlagen > 0 ? regel.Bijlagen.ToString() : "")
                                            </button>
                                            <button class="klein rood" title="Regel verwijderen"
                                                    @onclick="() => VerwijderRegel(regel)">✕</button>
                                        </td>
                                    </tr>
                                }
                                @if (_regels.Count == 0)
                                {
                                    <tr><td colspan="11" class="kiezer-info">Nog geen regels op deze bestelling.</td></tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="8" class="r"><b>Totaal</b></td>
                                    <td class="r"><b>@Bedrag(_regels.Sum(r => r.Regeltotaal))</b></td>
                                    <td colspan="2"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <BestelMailVenster OrderId="_mailOrder" OpGesloten="MailGesloten" />
                    <ArtikelZoekVenster Open="_artZoekRegel is not null" Zoek="@_artZoekTekst" Maakdelen="_artZoekMaakdelen"
                                        OpGekozen="ArtikelGekozen" OpGesloten="() => _artZoekRegel = null" />
                    <PlakVenster Open="_plakOpen" OrderId="_orderId" LeverancierId="LeverancierVanOrder" Leverdatum="StandaardLeverdatum"
                                 OpToegevoegd="NaPlakken" OpGesloten="() => _plakOpen = false" />
                    <ScreenshotVenster Open="_schermOpen" OrderId="_orderId" LeverancierId="LeverancierVanOrder" Leverdatum="StandaardLeverdatum"
                                       OpToegevoegd="NaPlakken" OpGesloten="() => _schermOpen = false" />
                    @if (_pakbonUrl is not null)
                    {
                        <div class="cmdk-overlay midden" @onclick="SluitPakbonPdf">
                            <div class="factuurvenster pb-pdf" @onclick:stopPropagation>
                                <header class="bijlagekop">
                                    <h2>Pakbon PS-@_pakbonId</h2>
                                    <div class="btngroup">
                                        <button class="klein" @onclick="() => ToonPakbon(!_pakbonPlaatjes)">
                                            @(_pakbonPlaatjes ? "📄 Zonder afbeeldingen" : "🖼 Met afbeeldingen")</button>
                                        <button class="klein" @onclick="DownloadPakbon">⭳ Downloaden</button>
                                        <a class="knopje" href="@($"bestellingen/pakbonnen?pakbon={_pakbonId}")" title="De pakbon bewerken (t.a.v., opmerking op de bon, regels)">✎ In Pakbonnen</a>
                                        <button class="klein" @onclick="SluitPakbonPdf">✕</button>
                                    </div>
                                </header>
                                <iframe src="@_pakbonUrl" title="Pakbon PS-@_pakbonId"></iframe>
                            </div>
                        </div>
                    }
                    <ImportBestellingVenster Open="_uitBestellingOpen" OrderId="_orderId" Leverdatum="StandaardLeverdatum"
                                             OpToegevoegd="NaPlakken" OpGesloten="() => _uitBestellingOpen = false" />
                }
            </section>
        </div>
    }

    <footer class="voet">
        Offertes aanvragen, het officiële orderformulier en het mailen naar de leverancier
        volgen later; daarvoor gebruik je voorlopig Access.
    </footer>
</div>

@* ===== bijlagen bij een orderregel ===== *@
@if (_bijlageRegel is not null)
{
    <div class="cmdk-overlay" @onclick="SluitBijlagen">
        <div class="bijlagevenster" @onclick:stopPropagation>
            <header class="bijlagekop">
                <h2>Bijlagen bij regel @_bijlageRegel.Artikelcode</h2>
                <button class="klein" @onclick="SluitBijlagen">✕</button>
            </header>

            <div class="bijlage-boven">
                <div class="bijlage-samenvatting">
                    <span><b>Aantal</b> @_bijlageRegel.Aantal</span>
                    <span><b>Artikel</b> @_bijlageRegel.Artikelcode</span>
                    <span><b>Omschrijving</b> @_bijlageRegel.Omschrijving</span>
                    <span><b>MDE-code</b> @_bijlageRegel.MdeCode</span>
                    <span><b>Leverdatum</b> @(_bijlageRegel.Leverdatum?.ToString("dd-MM-yyyy") ?? "")</span>
                    <span><b>Totaal</b> @Bedrag(_bijlageRegel.Regeltotaal)</span>
                </div>

                @* rechtsboven de artikelfoto uit de oude fotomap *@
                <div class="bijlage-beeld">
                    @if (ArtikelNummer() is int nr)
                    {
                        @* onload zet de foto weer zichtbaar: het element wordt hergebruikt
                           tussen orderregels, en anders blijft 'hidden' van een regel
                           zonder foto staan. *@
                        <img class="artikelfoto" src="@($"artikelfoto/{nr}")" alt="" @key="nr"
                             onload="this.style.visibility=''"
                             onerror="this.style.visibility='hidden'" />
                    }
                </div>
            </div>

            <div class="bijlage-kolommen">
                @* links: wat er bij het artikel hoort *@
                <section class="bijlage-kolom">
                    <h3>Artikeldocumentatie (laatste versie)</h3>
                    @if (string.IsNullOrWhiteSpace(_bijlageRegel.MdeCode))
                    {
                        <p class="uitleg">Deze regel heeft geen MDE-code, dus er is geen artikeldocumentatie.</p>
                    }
                    else if (_artikelDocs.Count == 0)
                    {
                        <p class="uitleg">Geen documentatie gevonden bij artikel @_bijlageRegel.MdeCode.</p>
                    }
                    else
                    {
                        <table class="kiezer-tabel">
                            <thead>
                                <tr><th>Bestand</th><th style="width:5rem" class="r">Dagen</th><th style="width:3rem"></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var d in _artikelDocs)
                                {
                                    <tr @key="d.FileStoreId">
                                        <td>
                                            <button class="bestandnaam" title="Bekijken"
                                                    @onclick="() => ToonVoorbeeld(d)">@d.Bestandsnaam</button>
                                        </td>
                                        <td class="r">@DagenOud(d)</td>
                                        <td class="c">
                                            <button class="klein" title="Overnemen als bijlage bij deze regel"
                                                    @onclick="() => NeemOver(d)">»</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>

                @* rechts: de bijlagen van deze regel *@
                <section class="bijlage-kolom">
                    <h3>Bijlagen</h3>
                    @if (_regelBijlagen.Count == 0)
                    {
                        <p class="uitleg">Nog geen bijlagen bij deze regel.</p>
                    }
                    else
                    {
                        <table class="kiezer-tabel">
                            <thead>
                                <tr><th>Bestand</th><th style="width:5rem" class="r">Dagen</th><th style="width:5rem"></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var d in _regelBijlagen)
                                {
                                    <tr @key="d.FileStoreId">
                                        <td>
                                            <button class="bestandnaam" title="Bekijken"
                                                    @onclick="() => ToonVoorbeeld(d)">@d.Bestandsnaam</button>
                                        </td>
                                        <td class="r">@DagenOud(d)</td>
                                        <td class="c">
                                            <a class="knopje" href="@DownloadUrl(d.FileStoreId)" title="Downloaden">⭳</a>
                                            <button class="klein rood" title="Verwijderen"
                                                    @onclick="() => VerwijderBijlage(d)">✕</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    <div class="sleepzone @(_sleepBijlage ? "actief" : "")"
                         @ondragenter="() => _sleepBijlage = true"
                         @ondragleave="() => _sleepBijlage = false"
                         @ondragover:preventDefault="true">
                        <span>Sleep een werktekening, of klik om te kiezen</span>
                        <InputFile OnChange="BijlagenGekozen" multiple />
                    </div>
                </section>
            </div>

            <footer class="bijlagevoet">
                <button class="primair" @onclick="SluitBijlagen">Klaar</button>
            </footer>
        </div>
    </div>
}

@* voorbeeld van één bestand: 3D, PDF, Word/Excel of afbeelding *@
