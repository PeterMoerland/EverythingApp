    // ---- afkeuren ----
    private bool _afkeurOpen;
    private string _afkeurReden = "";

    private void OpenAfkeuren() { _afkeurReden = ""; _afkeurOpen = true; }

    private async Task Afkeuren()
    {
        if (_orderId is not int id || _volgendeBezig) return;
        var reden = _afkeurReden.Trim();
        if (reden.Length == 0) return;
        _volgendeBezig = true;
        try
        {
            var info = await Repo.FlowInfoAsync(id);
            if (info is null || !BestelFlow.MagAfkeuren(info, _ik))
            {
                Toon("Deze bestelling kun je (nu) niet afkeuren.", true);
                return;
            }
            var ik = _ik!;
            await Repo.ZetStatusAsync(id, info.Status, BestelFlow.Aanmaken, ik.Id);
            await Repo.VoegOpmerkingToeAsync(id, $"[{DateTime.Now:dd-MM-yyyy HH:mm}] Afgekeurd door {ik.Naam}: {reden}");
            if (info.BesteldDoor is int besteller && besteller != ik.Id)
            {
                try
                {
                    await Meldingen.MaakAsync(besteller, "afgekeurd", id,
                        $"PO-{id} ({info.Leverancier}) is afgekeurd door {ik.Naam}: {reden}");
                }
                catch { }
            }
            _afkeurOpen = false;
            _velden = await Repo.GetVeldenAsync(id);
            _status = BestelFlow.Aanmaken;
            await LaadFlow();
            await Laad();
            Signaal.Geef();
            Toon("Afgekeurd; de bestelling staat weer op Aanmaken en de besteller krijgt een melding.", false);
        }
        catch (Exception ex) { Toon("Afkeuren mislukt: " + ex.Message, true); }
        finally { _volgendeBezig = false; }
    }

