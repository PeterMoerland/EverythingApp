    }

    private async Task Volgende()
    {
        if (_orderId is not int id || _volgendeBezig) return;
        _volgendeBezig = true;
        try
        {
            var info = await Repo.FlowInfoAsync(id);
            if (info is null) { Toon("Bestelling niet gevonden.", true); return; }
            if (BestelFlow.MagNiet(info, _ik) is { } niet) { Toon(niet, true); return; }
            var ik = _ik!;
            await LaadRegels();
            var totaal = _regels.Sum(r => r.Regeltotaal);
            int naar;

            switch (info.Status)
            {
                case BestelFlow.Aanmaken:
                    if (info.LeverancierId is null) { Toon("Kies eerst een leverancier.", true); return; }
                    if (info.WerkorderId is null) { Toon("Een werkorder is verplicht om de bestelling door te zetten.", true); return; }
                    if (await WerkorderNiet(info.WerkorderId) is { } woNiet) { Toon(woNiet, true); return; }
                    if (_regels.Count == 0) { Toon("Er staan nog geen regels op deze bestelling.", true); return; }

                    // toeslagen, zoals Access: minimum orderbedrag en next-day levering
                    if (info.MinimumOrder > 0 && totaal < info.MinimumOrder && !_regels.Any(r => r.Omschrijving == "Ordercosts"))
                    {
                        if (!await Bevestig($"Het minimum bedrag voor deze leverancier is {Bedrag(info.MinimumOrder)}. Accepteer de toeslag van {Bedrag(info.Orderkosten)}?"))
                            return;
                        await Repo.VoegToeslagToeAsync(id, "Ordercosts", info.Orderkosten, ik.Afkorting);
                    }
                    var vroegste = _regels.Where(r => r.Leverdatum is not null).Select(r => r.Leverdatum!.Value).DefaultIfEmpty().Min();
                    if (info.NextDayFee > 0 && vroegste != default
                        && vroegste.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber < 2
                        && !_regels.Any(r => r.Omschrijving == "Next-day delivery fee"))
                    {
                        if (!await Bevestig($"Om de goederen next-day te laten leveren is een toeslag vereist. Accepteer je de toeslag van {Bedrag(info.NextDayFee)}?"))
                            return;
                        await Repo.VoegToeslagToeAsync(id, "Next-day delivery fee", info.NextDayFee, ik.Afkorting);
                    }
                    await LaadRegels();
                    totaal = _regels.Sum(r => r.Regeltotaal);

                    naar = BestelFlow.NaAanmaken(totaal, ik, info.PmId);
                    await Repo.ZetStatusAsync(id, BestelFlow.Aanmaken, naar, ik.Id);
                    Toon(naar switch
                    {
                        BestelFlow.InBestelling => "Binnen je eigen goedkeurgrens: je kunt bestellen.",
                        BestelFlow.GoedkeuringPm => $"Ter goedkeuring bij {(info.PmNaam.Length > 0 ? info.PmNaam : "de projectmanager")}.",
                        _ => "Ter goedkeuring bij de Directie.",
                    }, false);
                    break;

                case BestelFlow.GoedkeuringPm:
                    naar = BestelFlow.NaPm(totaal, ik);
                    await Repo.ZetStatusAsync(id, BestelFlow.GoedkeuringPm, naar, ik.Id);
                    if (naar == BestelFlow.InBestelling) await MeldGoedgekeurd(info, id, ik);
                    Toon(naar == BestelFlow.InBestelling ? "Goedgekeurd; de besteller krijgt een melding." : "Goedgekeurd; nu nog de Directie.", false);
                    break;

                case BestelFlow.GoedkeuringDirectie:
                    await Repo.ZetStatusAsync(id, BestelFlow.GoedkeuringDirectie, BestelFlow.InBestelling, ik.Id);
                    await MeldGoedgekeurd(info, id, ik);
                    Toon("Goedgekeurd; de besteller krijgt een melding.", false);
                    break;

                case BestelFlow.InBestelling:
                    // zoals Access: elke regel moet een prijs of schatting hebben
                    if (_regels.FirstOrDefault(r => r.Aantal != 0 && (r.Prijs ?? 0) + (r.Schatprijs ?? 0) == 0) is { } zonder)
                    {
                        Toon($"Bij '{zonder.Artikelcode}, {zonder.Omschrijving}' staat geen stuksprijs of schatting. Order niet door te zetten.", true);
                        return;
                    }
                    if (!info.MeldingBijLevering && await Bevestig("Wil je een e-mail ontvangen als de order gereed is?"))
                        await Repo.ZetMeldingBijLeveringAsync(id, ik.Id);
                    await Repo.ZetStatusAsync(id, BestelFlow.InBestelling, BestelFlow.WachtOpLevering, ik.Id);
                    if (info.DirectGeleverd)      // leverancier levert meteen (DirectGeleverdBijBestellen): meteen gereed
                        await Repo.ZetStatusAsync(id, BestelFlow.WachtOpLevering, BestelFlow.Gereed, ik.Id);
                    Toon(info.DirectGeleverd ? "Besteld en meteen geleverd (gereed)." : "Besteld; wacht op levering.", false);
                    break;

                case BestelFlow.WachtOpLevering:
                    // zoals Access: eerst de vraag of de geleverde aantallen gelijk moeten worden aan wat besteld is
                    _gereedRegels = (await Ontvangst.RegelsAsync(id)).Where(r => !r.Toeslag && r.Open > 0).ToList();
                    _gereedOrder = id;
                    return;
            }

            _velden = await Repo.GetVeldenAsync(id);
            _status = Convert.ToInt32(_velden.TryGetValue("Status", out var st) && st is not null ? st : _status);
            await LaadFlow();
            await Laad();
            Signaal.Geef();
        }
        catch (Exception ex) { Toon("Doorzetten mislukt: " + ex.Message, true); }
        finally { _volgendeBezig = false; }
    }

    // ---- gereed melden (Volgende bij Wacht op levering; Access: Order main form, Case 4) ----
    private int? _gereedOrder;
    private List<OntvangstRegel> _gereedRegels = new();

    /// <summary>Zet de bestelling op Gereed; met <paramref name="gelijk"/> wordt eerst wat openstaat als geleverd geboekt.</summary>
    private async Task GereedMelden(bool gelijk)
    {
        if (_gereedOrder is not int id || id != _orderId || _ik is not { } ik || _volgendeBezig) return;
        _volgendeBezig = true;
        try
        {
            var uit = await Ontvangst.GereedMeldenAsync(id, ik.Id, gelijk);
            _gereedOrder = null;
            var tekst = uit.Regels > 0
                ? $"PO-{id} staat op Gereed; {uit.Regels} regel{(uit.Regels == 1 ? "" : "s")} als geleverd geboekt."
                : $"PO-{id} staat op Gereed.";
            // compleet: wie erom vroeg hoort het (melding in de bel, en de mail als die gevraagd is); niet als je het zelf bent
            if (uit.Compleet && uit.Ontvanger is int wie && wie != ik.Id)
                tekst += await GeleverdMelder.MeldAsync(id, _flow?.Leverancier ?? "", uit, ik.Naam);

            _velden = await Repo.GetVeldenAsync(id);
            _status = Convert.ToInt32(_velden.TryGetValue("Status", out var st) && st is not null ? st : _status);
            await LaadFlow();
            await LaadRegels();
            await Laad();
            Signaal.Geef();
            Toon(tekst, false);
        }
        catch (Exception ex) { Toon("Gereed melden mislukt: " + ex.Message, true); }
        finally { _volgendeBezig = false; }
