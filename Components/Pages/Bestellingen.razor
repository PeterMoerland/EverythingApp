@page "/bestellingen"
@inject IBestelRepository Repo
@inject IUrenRepository Uren
@inject IWerknemerRepository WnRepo
@inject FilestoreService Store
@inject HuidigeGebruiker Ik
@inject IJSRuntime JS

<div class="page">
    <header class="topbar">
        <h1>@Titel</h1>
        <span class="weeklabel">
            @if (_orderId is not null)
            {
                <span class="po-totaal">Totaal @Bedrag(_regels.Sum(r => r.Regeltotaal))</span>
            }
            else
            {
                @($"{_lijst.Count} bestellingen")
            }
        </span>
    </header>

    @if (!Repo.Beschikbaar)
    {
        <section class="module-placeholder"><p>Dit scherm werkt alleen met de live database.</p></section>
    }
    else
    {
        @if (_melding is not null)
        {
            <div class="melding @(_fout ? "fout" : "ok")" @onclick="SluitMelding">@_melding</div>
        }

        <div class="wn-scherm">
            @* ---------- links: zoeken ---------- *@
            <aside class="wn-lijst bestel-lijst">
                <div class="wn-filters">
                    <div class="zoekregel">
                        <input placeholder="PO-nummer, leverancier, omschrijving…" value="@_zoek"
                               @onchange="ZoekGewijzigd" />
                        <button class="klein" title="Wissen" disabled="@(_zoek.Length == 0)" @onclick="WisZoek">✕</button>
                    </div>
                    <div class="zoekregel">
                        <select value="@StatusFilterTekst" @onchange="StatusFilterGewijzigd">
                            <option value="">Alle statussen</option>
                            @foreach (var s in _statussen)
                            {
                                <option value="@s.Id">@s.Omschrijving</option>
                            }
                        </select>
                    </div>
                    <div class="zoekregel">
                        <select value="@BesteldDoorTekst" @onchange="BesteldDoorGewijzigd">
                            <option value="">Besteld door iedereen</option>
                            @foreach (var w in Lijst("Werknemer"))
                            {
                                <option value="@w.Id">@w.Naam</option>
                            }
                        </select>
                        <button class="klein" title="Alleen mijn bestellingen"
                                disabled="@(Ik.WerknemerId is null)" @onclick="AlleenIk">Ik</button>
                    </div>
                    <div class="btngroup">
                        <button class="klein" @onclick="OpenNieuw">+ Nieuwe bestelling</button>
                    </div>
                </div>

                <NieuweBestellingVenster Open="_nieuwOpen" Leveranciers="_leveranciers" Werkorders="_openWerkorders"
                                         WerknemerId="Ik.WerknemerId" OpAanmaken="MaakBestelling" OpGesloten="SluitNieuw" />

                @* tabindex maakt de lijst zelf bereikbaar, zodat de pijltjestoetsen
                   hier binnenkomen in plaats van bij de losse knoppen *@
                <div id="bestellijst" class="wn-namen" tabindex="0"
                     @onkeydown="Toetsen" @onkeydown:preventDefault="_pijltje">
                    @if (_lijst.Count == 0)
                    {
                        <div class="kiezer-info">Niets gevonden.</div>
                    }
                    else
                    {
                        @foreach (var b in _lijst)
                        {
                            <button class="wn-naam @(b.Id == _orderId ? "actief" : "")"
                                    @key="b.Id" @onclick="() => Kies(b)">
                                <span class="nda-regel">
                                    <span class="nda-naam">@b.Nummer · @b.Leverancier</span>
                                    <span class="nda-onder @StatusKleur(b.StatusNaam)">
                                        @b.StatusNaam
                                        @if (b.Totaal > 0)
                                        {
                                            <text> · @Bedrag(b.Totaal)</text>
                                        }
                                    </span>
                                </span>
                            </button>
                        }
                    }
                </div>
                <p class="uitleg toetsuitleg">Klik in de lijst en blader met ↑ en ↓.</p>
            </aside>

            @* ---------- rechts: de bestelling ---------- *@
            <section class="wn-detail">
                @if (_orderId is null)
                {
                    <div class="kiezer-info">Kies links een bestelling, of maak een nieuwe aan.</div>
                }
                else
                {
                    @* statusbalk: waar staat deze bestelling? *@
                    <div class="statusbalk">
                        @foreach (var s in _statussen)
                        {
                            <button class="stap @(s.Id == _status ? "nu" : "") @(s.Id < _status ? "gehad" : "")"
                                    @key="s.Id" @onclick="() => ZetStatus(s)">
                                @s.Omschrijving
                            </button>
                        }
                    </div>

                    <div class="wn-tabs">
                        @foreach (var tab in BestelVelden.Tabs)
                        {
                            <button class="@(tab.Naam == _tab ? "actief" : "")"
                                    @onclick="() => _tab = tab.Naam">@tab.Naam</button>
                        }
                        <button class="@("Documenten" == _tab ? "actief" : "")"
                                @onclick="KiesDocumenten">Documenten (@_documenten.Count)</button>
                    </div>

                    @if (_tab == "Documenten")
                    {
                        <table class="kiezer-tabel">
                            <thead>
                                <tr>
                                    <th>Bestand</th>
                                    <th style="width:10rem">Toegevoegd</th>
                                    <th style="width:11rem">Door</th>
                                    <th style="width:6rem"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in _documenten)
                                {
                                    <tr @key="d.FileStoreId">
                                        <td>
                                            <button class="bestandnaam" title="Bekijken"
                                                    @onclick="() => ToonVoorbeeld(d)">@d.Bestandsnaam</button>
                                        </td>
                                        <td>@(d.Toegevoegd?.ToString("dd-MM-yyyy HH:mm") ?? "")</td>
                                        <td>@d.ToegevoegdDoor</td>
                                        <td class="c">
                                            <a class="knopje" href="@DownloadUrl(d.FileStoreId)" title="Downloaden">⭳</a>
                                            <button class="klein rood" @onclick="() => VerwijderDocument(d)">✕</button>
                                        </td>
                                    </tr>
                                }
                                @if (_documenten.Count == 0)
                                {
                                    <tr><td colspan="4" class="kiezer-info">Nog geen documenten.</td></tr>
                                }
                            </tbody>
                        </table>

                        <div class="sleepzone @(_sleepActief ? "actief" : "")"
                             @ondragenter="() => _sleepActief = true"
                             @ondragleave="() => _sleepActief = false"
                             @ondragover:preventDefault="true">
                            <span>Sleep hier een bestand, of klik om te kiezen</span>
                            <InputFile OnChange="BestandenGekozen" multiple />
                        </div>
                    }
                    else
                    {
                        <DetailMetZij>
                            <Hoofd>
                                <VeldRaster Tab="HuidigeTab" Kolommen="_kolommen" Velden="_velden"
                                            Lijsten="_lijsten" OpSlaan="Bewaar" />
                            </Hoofd>
                            <Zij>
                                <ZijBlok Titel="Leverancier" Leeg="@(LeverancierNaam() is null)"
                                         LeegTekst="Nog geen leverancier gekozen.">
                                    <div class="zij-regel">
                                        <span class="zij-naam">@LeverancierNaam()</span>
                                        <span class="zij-extra">@ContactNaam()</span>
                                        @if (_levStandaard is { Cc: true } cc)
                                        {
                                            <span class="zij-extra" title="Relaties: CC bij bestelling. Access vroeg dit bij het versturen van de bestelling.">CC bij bestelling: @cc.CcAdres</span>
                                        }
                                    </div>
                                </ZijBlok>

                                <ZijBlok Titel="Werkorder" Leeg="@(_werkorder is null)" LeegTekst="Geen werkorder gekozen.">
                                    @if (_werkorder is { } wo)
                                    {
                                        <div class="zij-regel">
                                            <span class="zij-naam">@wo.Weergave · @wo.Omschrijving</span>
                                            <span class="zij-extra">Project: @(string.IsNullOrWhiteSpace(wo.Project) ? "—" : wo.Project)</span>
                                            <span class="zij-extra">Klant: @(string.IsNullOrWhiteSpace(wo.Klant) ? "—" : wo.Klant)</span>
                                        </div>
                                    }
                                </ZijBlok>

                                <ZijBlok Titel="Regels" Aantal="_regels.Count"
                                         Leeg="@(_regels.Count == 0)" LeegTekst="Nog geen regels.">
                                    <div class="zij-regel">
                                        <span class="zij-naam">@Bedrag(_regels.Sum(r => r.Regeltotaal))</span>
                                        <span class="zij-extra">
                                            @_regels.Count(r => r.Compleet) van @_regels.Count geleverd
                                        </span>
                                    </div>
                                </ZijBlok>
                            </Zij>
                        </DetailMetZij>
                    }

                    @* ---------- de regels ----------
                       Werkbalk: alles wat regels toevoegt staat hier (besluit gebruiker 16-10-2026). Nieuwe imports
                       (SMC-, Solar-website, Materialise-prijzen uit Access) komen in het menu Importeren. *@
                    <div class="regels-balk">
                        <h3 class="wn-kop">Regels</h3>
                        <div class="btngroup">
                            <button class="klein" @onclick="NieuweRegel">+ Regel</button>
                            <button class="klein" @onclick="() => _plakOpen = true"
                                    title="Onderdelen van het klembord toevoegen, bv. uit Inventor (Collect Parts ▸ stuklijst naar klembord)">📋 Plakken uit klembord</button>
                            <div class="menu-knop">
                                <button class="klein" @onclick="() => _importMenu = !_importMenu">Importeren ▾</button>
                                @if (_importMenu)
                                {
                                    <div class="menu-dicht" @onclick="() => _importMenu = false"></div>
                                    <div class="menu-lijst" @onclick="() => _importMenu = false">
                                        <button disabled title="Volgt: staat nog in Access">SMC-website <small>volgt</small></button>
                                        <button disabled title="Volgt: staat nog in Access">Solar-website <small>volgt</small></button>
                                        <button disabled title="Volgt: staat nog in Access">Materialise-prijzen <small>volgt</small></button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="regels-omhulsel">
                        <table class="kiezer-tabel regels">
                            <thead>
                                <tr>
                                    <th style="width:3.6rem" class="r">Aantal</th>
                                    <th style="width:4.2rem">Eenh.</th>
                                    <th style="width:10rem">Artikelcode</th>
                                    <th>Omschrijving</th>
                                    <th style="width:5.5rem">MDE</th>
                                    <th style="width:6.6rem">Leverdatum</th>
                                    <th style="width:5.5rem" class="r">Prijs</th>
                                    <th style="width:3.8rem" class="r" title="Korting in procenten">Korting</th>
                                    <th style="width:6rem" class="r">Totaal</th>
                                    <th style="width:3.6rem" class="c" title="Geleverd">Gelev.</th>
                                    <th style="width:4.6rem"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var regel in _regels)
                                {
                                    <tr @key="regel.Id" class="@(regel.Compleet ? "geleverd" : "")">
                                        <td><input class="r" value="@regel.Aantal"
                                                   @onchange="e => ZetGetal(regel, v => regel.Aantal = v, e)" /></td>
                                        <td>
                                            <select value="@EenheidTekst(regel)" @onchange="e => ZetEenheid(regel, e)">
                                                <option value="">—</option>
                                                @foreach (var ve in _eenheden)
                                                {
                                                    <option value="@ve.Id">@ve.Naam</option>
                                                }
                                            </select>
                                        </td>
                                        <td><input value="@regel.Artikelcode" maxlength="100"
                                                   @onchange="e => Zet(regel, v => regel.Artikelcode = v, e)" /></td>
                                        <td><input value="@regel.Omschrijving" maxlength="400"
                                                   @onchange="e => Zet(regel, v => regel.Omschrijving = v, e)" /></td>
                                        @* Het MDE-nummer blijft te wijzigen; staat er een geldig
                                           nummer, dan opent het knopje de artikelgegevens. *@
                                        <td>
                                            <div class="mde-cel">
                                                <input value="@regel.MdeCode"
                                                       @onchange="e => Zet(regel, v => regel.MdeCode = v, e)" />
                                                @if (MdeNummer(regel.MdeCode) is int nr)
                                                {
                                                    <button class="klein" title="Gegevens van dit artikel"
                                                            @onclick="() => _bekeken = nr">🔍</button>
                                                }
                                            </div>
                                        </td>
                                        <td><NlDatum Waarde="regel.Leverdatum"
                                                     WaardeChanged="d => ZetDatum(regel, d)" /></td>
                                        <td><input class="r" value="@Getal(regel.Prijs)"
                                                   @onchange="e => ZetBedrag(regel, v => regel.Prijs = v, e)" /></td>
                                        <td><input class="r" value="@Getal(regel.KortingProcent)" title="Korting in procenten"
                                                   @onchange="e => ZetKorting(regel, e)" /></td>
                                        <td class="r">@Bedrag(regel.Regeltotaal)</td>
                                        <td class="c" title="@(regel.Geleverd + " van " + regel.Aantal)">
                                            @(regel.Geleverd > 0 ? regel.Geleverd.ToString("0.##") : "")
                                        </td>
                                        <td class="c">
                                            <button class="klein @(regel.Bijlagen > 0 ? "metbijlage" : "")"
                                                    title="Bijlagen bij deze regel"
                                                    @onclick="() => OpenBijlagen(regel)">
                                                📎@(regel.Bijlagen > 0 ? regel.Bijlagen.ToString() : "")
                                            </button>
                                            <button class="klein rood" title="Regel verwijderen"
                                                    @onclick="() => VerwijderRegel(regel)">✕</button>
                                        </td>
                                    </tr>
                                }
                                @if (_regels.Count == 0)
                                {
                                    <tr><td colspan="11" class="kiezer-info">Nog geen regels op deze bestelling.</td></tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="8" class="r"><b>Totaal</b></td>
                                    <td class="r"><b>@Bedrag(_regels.Sum(r => r.Regeltotaal))</b></td>
                                    <td colspan="2"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <PlakVenster Open="_plakOpen" OrderId="_orderId" LeverancierId="LeverancierVanOrder" Leverdatum="StandaardLeverdatum"
                                 OpToegevoegd="NaPlakken" OpGesloten="() => _plakOpen = false" />
                }
            </section>
        </div>
    }

    <footer class="voet">
        Offertes aanvragen, het officiële orderformulier en het mailen naar de leverancier
        volgen later; daarvoor gebruik je voorlopig Access.
    </footer>
</div>

@* ===== bijlagen bij een orderregel ===== *@
@if (_bijlageRegel is not null)
{
    <div class="cmdk-overlay" @onclick="SluitBijlagen">
        <div class="bijlagevenster" @onclick:stopPropagation>
            <header class="bijlagekop">
                <h2>Bijlagen bij regel @_bijlageRegel.Artikelcode</h2>
                <button class="klein" @onclick="SluitBijlagen">✕</button>
            </header>

            <div class="bijlage-boven">
                <div class="bijlage-samenvatting">
                    <span><b>Aantal</b> @_bijlageRegel.Aantal</span>
                    <span><b>Artikel</b> @_bijlageRegel.Artikelcode</span>
                    <span><b>Omschrijving</b> @_bijlageRegel.Omschrijving</span>
                    <span><b>MDE-code</b> @_bijlageRegel.MdeCode</span>
                    <span><b>Leverdatum</b> @(_bijlageRegel.Leverdatum?.ToString("dd-MM-yyyy") ?? "")</span>
                    <span><b>Totaal</b> @Bedrag(_bijlageRegel.Regeltotaal)</span>
                </div>

                @* rechtsboven de artikelfoto uit de oude fotomap *@
                <div class="bijlage-beeld">
                    @if (ArtikelNummer() is int nr)
                    {
                        @* onload zet de foto weer zichtbaar: het element wordt hergebruikt
                           tussen orderregels, en anders blijft 'hidden' van een regel
                           zonder foto staan. *@
                        <img class="artikelfoto" src="@($"artikelfoto/{nr}")" alt="" @key="nr"
                             onload="this.style.visibility=''"
                             onerror="this.style.visibility='hidden'" />
                    }
                </div>
            </div>

            <div class="bijlage-kolommen">
                @* links: wat er bij het artikel hoort *@
                <section class="bijlage-kolom">
                    <h3>Artikeldocumentatie (laatste versie)</h3>
                    @if (string.IsNullOrWhiteSpace(_bijlageRegel.MdeCode))
                    {
                        <p class="uitleg">Deze regel heeft geen MDE-code, dus er is geen artikeldocumentatie.</p>
                    }
                    else if (_artikelDocs.Count == 0)
                    {
                        <p class="uitleg">Geen documentatie gevonden bij artikel @_bijlageRegel.MdeCode.</p>
                    }
                    else
                    {
                        <table class="kiezer-tabel">
                            <thead>
                                <tr><th>Bestand</th><th style="width:5rem" class="r">Dagen</th><th style="width:3rem"></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var d in _artikelDocs)
                                {
                                    <tr @key="d.FileStoreId">
                                        <td>
                                            <button class="bestandnaam" title="Bekijken"
                                                    @onclick="() => ToonVoorbeeld(d)">@d.Bestandsnaam</button>
                                        </td>
                                        <td class="r">@DagenOud(d)</td>
                                        <td class="c">
                                            <button class="klein" title="Overnemen als bijlage bij deze regel"
                                                    @onclick="() => NeemOver(d)">»</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>

                @* rechts: de bijlagen van deze regel *@
                <section class="bijlage-kolom">
                    <h3>Bijlagen</h3>
                    @if (_regelBijlagen.Count == 0)
                    {
                        <p class="uitleg">Nog geen bijlagen bij deze regel.</p>
                    }
                    else
                    {
                        <table class="kiezer-tabel">
                            <thead>
                                <tr><th>Bestand</th><th style="width:5rem" class="r">Dagen</th><th style="width:5rem"></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var d in _regelBijlagen)
                                {
                                    <tr @key="d.FileStoreId">
                                        <td>
                                            <button class="bestandnaam" title="Bekijken"
                                                    @onclick="() => ToonVoorbeeld(d)">@d.Bestandsnaam</button>
                                        </td>
                                        <td class="r">@DagenOud(d)</td>
                                        <td class="c">
                                            <a class="knopje" href="@DownloadUrl(d.FileStoreId)" title="Downloaden">⭳</a>
                                            <button class="klein rood" title="Verwijderen"
                                                    @onclick="() => VerwijderBijlage(d)">✕</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    <div class="sleepzone @(_sleepBijlage ? "actief" : "")"
                         @ondragenter="() => _sleepBijlage = true"
                         @ondragleave="() => _sleepBijlage = false"
                         @ondragover:preventDefault="true">
                        <span>Sleep een werktekening, of klik om te kiezen</span>
                        <InputFile OnChange="BijlagenGekozen" multiple />
                    </div>
                </section>
            </div>

            <footer class="bijlagevoet">
                <button class="primair" @onclick="SluitBijlagen">Klaar</button>
            </footer>
        </div>
    </div>
}

@* voorbeeld van één bestand: 3D, PDF, Word/Excel of afbeelding *@
<BestandVoorbeeld Id="_voorbeeld?.FileStoreId" Naam="@(_voorbeeld?.Bestandsnaam ?? "")"
                  Sluiten="SluitVoorbeeld" />

@* de gegevens van het artikel achter een orderregel *@
<ArtikelVenster ArtikelId="_bekeken" Sluiten="() => _bekeken = null" />

@code {
    private List<BestelRegel> _lijst = new();
    private List<Bestelstatus> _statussen = new();
    private string _zoek = "";
    private int? _statusFilter;
    private int? _besteldDoor;

    private int? _orderId;
    private BestelRegel? _bestelling;
    private int _status;
    private string _tab = "Algemeen";

    private HashSet<string> _kolommen = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, object?> _velden = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, List<Keuze>> _lijsten = new();
    private static readonly List<Keuze> GeenLijst = new();

    private List<Orderregel> _regels = new();
    private List<Keuze> _eenheden = new();
    private List<Keuze> _leveranciers = new();
    private List<Keuze> _werkorders = new();
    private List<Workorder> _openWerkorders = new();

    private List<Bestand> _documenten = new();
    private bool _sleepActief;

    private bool _nieuwOpen;

    private string? _melding;
    private bool _fout;

    private string Titel => _bestelling is null ? "Bestellingen"
                          : $"{_bestelling.Nummer} · {_bestelling.Leverancier}";

    private VeldTab HuidigeTab
        => BestelVelden.Tabs.FirstOrDefault(t => t.Naam == _tab) ?? BestelVelden.Tabs[0];

    private string StatusFilterTekst => _statusFilter is int s ? s.ToString() : "";
    private string BesteldDoorTekst => _besteldDoor is int d ? d.ToString() : "";

    private List<Keuze> Lijst(string naam) => _lijsten.TryGetValue(naam, out var l) ? l : GeenLijst;

    private static string BekijkUrl(int id) => "bestand/" + id;
    private static string DownloadUrl(int id) => "bestand/" + id + "/download";

    private static string Bedrag(decimal waarde) => waarde.ToString("C2", new System.Globalization.CultureInfo("nl-NL"));

    /// <summary>
    /// Kleur van de onderregel, afgeleid van de statusnaam zelf. Dat is steviger
    /// dan werken met nummers: verandert er iets in OrderState, dan blijft dit werken.
    /// Groen = klaar, oranje = loopt en we wachten ergens op, grijs = eraf.
    /// </summary>
    private static string StatusKleur(string? status)
    {
        var s = (status ?? "").ToLowerInvariant();

        if (s.Contains("gereed") || s.Contains("afgehandeld") || s.Contains("compleet")) return "st-groen";
        if (s.Contains("annul") || s.Contains("vervallen")) return "st-grijs";
        if (s.Contains("levering") || s.Contains("bestell") || s.Contains("besteld")) return "st-oranje";

        return "";
    }
    private static string Getal(decimal? waarde) => waarde is null ? "" : waarde.Value.ToString("0.##");

    protected override async Task OnInitializedAsync()
    {
        await Ik.ZorgGeladenAsync();
        if (!Repo.Beschikbaar) return;

        try
        {
            _kolommen = await Repo.KolommenAsync();
            try { _statussen = await Repo.GetStatussenAsync(); } catch { }
            try { _eenheden = await Repo.GetEenhedenAsync(); } catch { }
            try { _leveranciers = await Repo.GetLeveranciersAsync(); } catch { }
            try
            {
                var open = await Uren.GetOpenWorkordersAsync();
                _openWerkorders = open;
                // alleen werkorders waarop ingekocht mag worden (Workorders.InkoopToegestaan); de huidige van een
                // bestelling komt er per bestelling bij (WerkorderLijst), anders is het veld leeg
                _werkorders = open.Where(w => w.InkoopToegestaan)
                                  .Select(w => new Keuze(w.WerkbonId, WerkorderTekst(w))).ToList();
            }
            catch { }

            _lijsten["Leverancier"] = _leveranciers;
            _lijsten["Werkorder"] = _werkorders;
