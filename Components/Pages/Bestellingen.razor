    /// <summary>
    /// Het gekozen artikel in de regel zetten, zoals Access (GetArtikelData): code = bestelnummer bij deze leverancier,
    /// anders de fabrikantcode, anders de MDE-code; omschrijving uit het artikel; MDE-nummer; prijs per stuk en korting
    /// van deze leverancier als die bekend is; de minimale bestelhoeveelheid. Daarna de bijlages zoals bij Plakken.
    /// </summary>
    private async Task ArtikelGekozen(int artikelId)
    {
        var regel = _artZoekRegel;
        _artZoekRegel = null;
        if (regel is null) return;
        _artikelTekst.Remove(regel.Id);
        try
        {
            var a = await Artikelen.GetAsync(artikelId);
            if (a is null) { Toon($"Artikel #{artikelId} niet gevonden.", true); return; }

            ArtikelLeverancier? lev = null;
            if (LeverancierVanOrder is int l)
                try { lev = (await Artikelen.LeveranciersAsync(artikelId)).FirstOrDefault(x => x.LeverancierId == l); } catch { }

            var bestel = (lev?.Artikelnummer ?? "").Trim();
            var fabriek = (a.CodeFabrikant ?? "").Trim();
            var code = bestel.Length > 0 ? bestel : fabriek.Length > 0 ? fabriek : a.Code;
            var oms = a.OmschrijvingNl ?? "";
            if (bestel.Length > 0 && fabriek.Length > 0 && fabriek != bestel) oms = fabriek + " " + oms;

            regel.Artikelcode = code.Length > 100 ? code[..100] : code;
            regel.Omschrijving = oms.Length > 400 ? oms[..400] : oms;
            regel.MdeCode = artikelId.ToString();
            if (lev is not null)
            {
                regel.Prijs = lev.StuksPerVe == 0 ? lev.PrijsPerVe : Math.Round(lev.PrijsPerVe / lev.StuksPerVe, 4);
                regel.Korting = lev.Korting == 0 ? null : lev.Korting;
            }
            if (a.Bestelhoeveelheid is double min && min > 0 && regel.Aantal < min) regel.Aantal = min;

            await BewaarRegel(regel);
            var bijlagen = await BijlagenVanArtikel(regel, artikelId);
            Toon($"Artikel {regel.Artikelcode} (#{artikelId}) in de regel gezet" +
                 (lev is null && LeverancierVanOrder is not null ? "; geen prijs bekend bij deze leverancier" : "") +
                 (bijlagen > 0 ? $"; {bijlagen} bijlage(s) toegevoegd" : "") + ".", false);
        }
        catch (Exception ex) { Toon("Artikel invullen mislukt: " + ex.Message, true); }
    }

    /// <summary>
    /// Bijlages zoals bij Plakken uit klembord: alleen bij een artikel uit Inventor, de bestandssoorten die de leverancier
    /// wil (Relations.ExportPDF/DXF/STP/STL), de nieuwste per bestandsnaam en alleen als er precies één van die soort is.
    /// </summary>
    private async Task<int> BijlagenVanArtikel(Orderregel regel, int artikelId)
    {
        if (regel.Id <= 0 || !WnRepo.Beschikbaar) return 0;
        try
        {
            var lev = await Repo.PlakLeverancierAsync(LeverancierVanOrder);
            if (!lev.Extensies().Any() || !await Repo.IsInventorArtikelAsync(artikelId)) return 0;
            var nieuwste = (await WnRepo.GetBestandenAsync(StoreTypeArtikel, artikelId))
                .GroupBy(d => d.Bestandsnaam, StringComparer.OrdinalIgnoreCase)
                .Select(g => g.OrderByDescending(d => d.Toegevoegd ?? DateTime.MinValue).ThenByDescending(d => d.FileStoreId).First())
                .ToList();
            var al = (await WnRepo.GetBestandenAsync(BestelVelden.StoreTypeOrderregel, regel.Id))
                .Select(d => d.Bestandsnaam).ToHashSet(StringComparer.OrdinalIgnoreCase);
            var n = 0;
            foreach (var ext in lev.Extensies())
            {
                var treffers = nieuwste.Where(d => d.Bestandsnaam.EndsWith(ext, StringComparison.OrdinalIgnoreCase)).ToList();
                if (treffers.Count != 1 || al.Contains(treffers[0].Bestandsnaam)) continue;
                var gevonden = await Store.ZoekAsync(treffers[0].FileStoreId);
                if (gevonden is null) continue;
                await using var bron = File.OpenRead(gevonden.Value.Pad);
                await Store.ToevoegenAsync(bron, gevonden.Value.Naam, BestelVelden.StoreTypeOrderregel, regel.Id, Ik.WerknemerId ?? 0);
                n++;
            }
            if (n > 0) await LaadRegels();
            return n;
        }
        catch { return 0; }
    }


    private async Task LaadBijlagen()
    {
        if (_bijlageRegel is null || !WnRepo.Beschikbaar) return;

        try { _regelBijlagen = await WnRepo.GetBestandenAsync(BestelVelden.StoreTypeOrderregel, _bijlageRegel.Id); }
        catch { _regelBijlagen = new(); }

        if (int.TryParse(_bijlageRegel.MdeCode, out var artikel))
        {
            try
            {
                var alles = await WnRepo.GetBestandenAsync(StoreTypeArtikel, artikel);

                // alleen de nieuwste versie per bestandsnaam, zoals in Access
                _artikelDocs = alles
                    .GroupBy(d => d.Bestandsnaam, StringComparer.OrdinalIgnoreCase)
                    .Select(g => g.OrderByDescending(d => d.Toegevoegd ?? DateTime.MinValue).First())
                    .OrderBy(d => d.Bestandsnaam)
                    .ToList();
            }
            catch { _artikelDocs = new(); }
        }
    }

    /// <summary>Neemt een artikeldocument over als bijlage bij deze regel.</summary>
    private async Task NeemOver(Bestand doc)
    {
        if (_bijlageRegel is null) return;
        try
        {
            var gevonden = await Store.ZoekAsync(doc.FileStoreId);
            if (gevonden is null) { Toon("Het bestand is niet gevonden in de filestore.", true); return; }

            await using var bron = File.OpenRead(gevonden.Value.Pad);
            await Store.ToevoegenAsync(bron, gevonden.Value.Naam, BestelVelden.StoreTypeOrderregel,
                                       _bijlageRegel.Id, Ik.WerknemerId ?? 0);

            await LaadBijlagen();
            await LaadRegels();
            Toon($"'{doc.Bestandsnaam}' toegevoegd aan deze regel.", false);
        }
        catch (Exception ex) { Toon("Overnemen mislukt: " + ex.Message, true); }
    }

    private async Task BijlagenGekozen(InputFileChangeEventArgs e)
    {
        _sleepBijlage = false;
        if (_bijlageRegel is null) return;
        if (!Store.Beschikbaar)
        {
            Toon("De filestore is niet ingesteld (Filestore:Pad in appsettings.json).", true);
            return;
        }

        var gelukt = 0;
        foreach (var bestand in e.GetMultipleFiles(20))
        {
            try
            {
                await using var stroom = bestand.OpenReadStream(50 * 1024 * 1024);
                await Store.ToevoegenAsync(stroom, bestand.Name, BestelVelden.StoreTypeOrderregel,
                                           _bijlageRegel.Id, Ik.WerknemerId ?? 0);
                gelukt++;
            }
            catch (Exception ex) { Toon($"'{bestand.Name}' toevoegen mislukt: {ex.Message}", true); }
        }

        await LaadBijlagen();
        await LaadRegels();
        if (gelukt > 0) Toon($"{gelukt} bijlage(n) toegevoegd.", false);
    }

    private async Task VerwijderBijlage(Bestand d)
    {
        if (!await Bevestig($"'{d.Bestandsnaam}' verwijderen?\n\nHet bestand gaat ook van schijf af.")) return;

        try
        {
            await Store.VerwijderAsync(d.FileStoreId);
            await LaadBijlagen();
            await LaadRegels();
            Toon("Bijlage verwijderd.", false);
        }
        catch (Exception ex) { Toon("Verwijderen mislukt: " + ex.Message, true); }
    }

    // ================================================================
    //  Documenten
    // ================================================================
    /// <summary>Wat er als miniatuur van een document te tonen is: de afbeelding zelf, de eerste pagina van een PDF, of
    /// alleen de bestandssoort (Word en Excel zouden eerst omgezet moeten worden; dat gebeurt pas bij Bekijken).</summary>
    private static string MiniSoort(string naam)
    {
        var n = (naam ?? "").ToLowerInvariant();
        if (n.EndsWith(".pdf")) return "pdf";
        return n.EndsWith(".jpg") || n.EndsWith(".jpeg") || n.EndsWith(".png") || n.EndsWith(".gif") || n.EndsWith(".webp") ? "afbeelding" : "";
    }

    /// <summary>De miniatuur van één bestand (tabs Documenten en Facturen); klikken opent het voorbeeldvenster.</summary>
    private RenderFragment Mini(Bestand d) => __builder =>
    {
        <div class="doc-mini" role="button" tabindex="0" title="@("Bekijken: " + d.Bestandsnaam)"
             @onclick="() => ToonVoorbeeld(d)">
            @switch (MiniSoort(d.Bestandsnaam))
            {
                case "afbeelding":
                    <img src="@BekijkUrl(d.FileStoreId)" alt="" loading="lazy" />
                    break;
                case "pdf":
                    <iframe src="@(BekijkUrl(d.FileStoreId) + "#toolbar=0&navpanes=0&scrollbar=0&view=FitH")"
                            loading="lazy" tabindex="-1" aria-hidden="true"></iframe>
                    break;
                default:
                    <span class="doc-ext">@Extensie(d.Bestandsnaam)</span>
                    break;
            }
        </div>
    };

    private static string Extensie(string naam)
        => System.IO.Path.GetExtension(naam ?? "").TrimStart('.') is { Length: > 0 and <= 5 } e ? e.ToUpperInvariant() : "bestand";

    private async Task KiesDocumenten()
    {
        _tab = "Documenten";
        await LaadDocumenten();
    }

    // ================================================================
    //  Facturen: de inkomende facturen die aan deze bestelling gekoppeld zijn, met hun bestanden. Alleen lezen en voor
    //  iedereen (wens gebruiker 13-11-2026); koppelen blijft bij Financiën ▸ Inkomende facturen.
    // ================================================================
    /// <summary>Filestore-soort van een inkomende factuur (MasterID = FacturenInkomend-ID), zoals in Facturen.razor.</summary>
    private const int StoreTypeFactuur = 1;
    private List<BestelFactuur> _facturen = new();

    private async Task KiesFacturen()
    {
        _tab = "Facturen";
        await LaadFacturen();
    }

    private async Task LaadFacturen()
    {
        if (_orderId is not int id || !Repo.Beschikbaar) { _facturen = new(); return; }
        try
        {
            var lijst = await Repo.FacturenAsync(id);
            if (WnRepo.Beschikbaar)
                foreach (var f in lijst)
                {
                    try { f.Bestanden = await WnRepo.GetBestandenAsync(StoreTypeFactuur, f.FactuurId); } catch { }
                }
            if (_orderId == id) _facturen = lijst;      // intussen een andere bestelling gekozen: niet overschrijven
        }
        catch { _facturen = new(); }
    }

    private static string FactuurNaam(BestelFactuur f) => f.Factuurnummer.Length > 0 ? f.Factuurnummer : "factuur #" + f.FactuurId;

    /// <summary>De gekoppelde factuur waar het bestand in het voorbeeldvenster bij hoort (null bij een gewoon document).</summary>
    private BestelFactuur? VoorbeeldFactuur()
        => _voorbeeld is { } v ? _facturen.FirstOrDefault(f => f.Bestanden.Any(b => b.FileStoreId == v.FileStoreId)) : null;

    /// <summary>Wolkje bij een factuurtegel: wat er op deze bestelling staat, het hele factuurbedrag en de stand.</summary>
    private static string FactuurUitleg(BestelFactuur f)
        => $"Op deze bestelling {Bedrag(f.Gekoppeld)} (ex btw); de hele factuur {Bedrag(f.BedragExBtw)} ex btw. "
         + (f.Betaald ? "Betaald." : f.Goedgekeurd ? "Goedgekeurd, nog niet betaald." : "Nog niet goedgekeurd.")
         + (f.Omschrijving.Length > 0 ? " " + f.Omschrijving : "");

    private async Task LaadDocumenten()
    {
        if (_orderId is null || !WnRepo.Beschikbaar) { _documenten = new(); return; }
        try { _documenten = await WnRepo.GetBestandenAsync(BestelVelden.StoreTypeOrder, _orderId.Value); }
        catch { _documenten = new(); }
    }

    private async Task BestandenGekozen(InputFileChangeEventArgs e)
    {
        _sleepActief = false;
        if (_orderId is null) return;
        if (!Store.Beschikbaar)
        {
            Toon("De filestore is niet ingesteld (Filestore:Pad in appsettings.json).", true);
            return;
        }

        var gelukt = 0;
        foreach (var bestand in e.GetMultipleFiles(20))
        {
            try
            {
                await using var stroom = bestand.OpenReadStream(50 * 1024 * 1024);
                await Store.ToevoegenAsync(stroom, bestand.Name, BestelVelden.StoreTypeOrder,
                                           _orderId.Value, Ik.WerknemerId ?? 0);
                gelukt++;
            }
            catch (Exception ex) { Toon($"'{bestand.Name}' toevoegen mislukt: {ex.Message}", true); }
        }

        await LaadDocumenten();
        if (gelukt > 0) Toon($"{gelukt} bestand(en) toegevoegd.", false);
    }

    private async Task VerwijderDocument(Bestand d)
    {
        if (!await Bevestig($"'{d.Bestandsnaam}' verwijderen?\n\nHet bestand gaat ook van schijf af.")) return;

        try
        {
            await Store.VerwijderAsync(d.FileStoreId);
            await LaadDocumenten();
            Toon("Document verwijderd.", false);
        }
        catch (Exception ex) { Toon("Verwijderen mislukt: " + ex.Message, true); }
    }

    // ================================================================
    private async Task<bool> Bevestig(string vraag)
    {
        try { return await JS.InvokeAsync<bool>("mdeBevestig", vraag); }
        catch { return true; }
    }

    private void SluitMelding() => _melding = null;
    private void Toon(string tekst, bool fout) { _melding = tekst; _fout = fout; }
}
