    private Task? _opslaanBezig;

    /// <summary>
    /// Een lopende veldwijziging eerst laten afronden. Het onchange van een veld vuurt bij het verlaten ervan, vlak
    /// vóór de klik op een ander record; zonder wachten laadt dat record al terwijl de UPDATE nog loopt en komt de
    /// oude waarde in de velden van het nieuwe record terecht (opmerking leek dan niet opgeslagen).
    /// </summary>
    private async Task WachtOpOpslaan()
    {
        if (_opslaanBezig is { IsCompleted: false } t) { try { await t; } catch { } }
    }

    private Task Bewaar((string Kolom, object? Waarde) wijziging) => _opslaanBezig = BewaarKern(wijziging);

    private async Task BewaarKern((string Kolom, object? Waarde) wijziging)
    {
        if (_orderId is null) return;
        var vanId = _orderId.Value;         // de bestelling van de wijziging, ook als er intussen een andere gekozen is
        try
        {
            var opslaan = wijziging.Waarde is string s && string.IsNullOrWhiteSpace(s) ? null : wijziging.Waarde;
            if (wijziging.Kolom.Equals("Workorder-id", StringComparison.OrdinalIgnoreCase)
                && (await WerkorderNiet(opslaan is null ? null : Convert.ToInt32(opslaan)) ?? await BvMagNiet(opslaan)) is { } niet)
            {
                Toon(niet, true);
                return;
            }
            await Repo.UpdateVeldAsync(vanId, wijziging.Kolom, opslaan);
            if (_orderId == vanId) _velden[wijziging.Kolom] = opslaan;

            // andere leverancier: zijn standaardwaarden (contact, taal, leverdatum als die leeg is) en de vraag over
            // het afleveradres, zoals OrderSupplier_AfterUpdate -> FillInDefaults_Order in Access
            if (wijziging.Kolom.Equals("Supplier", StringComparison.OrdinalIgnoreCase))
            {
                if (opslaan is not null && await Repo.LeverancierStandaardAsync(Convert.ToInt32(opslaan)) is { } st)
                {
                    var aflever = st.HeeftAfleveradres && await Bevestig($"Wil je de bestelling laten afleveren bij {st.AfleverTekst}?");
                    await Repo.VulStandaardAsync(vanId, st, aflever);
                }
                else
                {
                    await Repo.UpdateVeldAsync(vanId, "Contact", null);
                }
                if (_orderId == vanId) _velden = await Repo.GetVeldenAsync(vanId);
                await LaadContacten();
                await LaadStandaard();
                await Laad();
            }
            else if (wijziging.Kolom.Equals("AfleverKlant-id", StringComparison.OrdinalIgnoreCase))
            {
                // ander afleveradres: de contactpersoon (t.a.v.) hoort bij dat adres
                await Repo.UpdateVeldAsync(vanId, "AfleverTAV-id", null);
                _velden["AfleverTAV-id"] = null;
                await LaadContacten();
            }
            else if (wijziging.Kolom.Equals("Workorder-id", StringComparison.OrdinalIgnoreCase))
            {
                await LaadWerkorder();
                // de BV die bestelt volgt het project van de werkorder (wens gebruiker 10-11-2026)
                if (_kolommen.Contains("BvID") && opslaan is not null
                    && await Repo.ProjectBvAsync(Convert.ToInt32(opslaan)) is int pbv && Nummer("BvID") != pbv)
                {
                    await Repo.UpdateVeldAsync(vanId, "BvID", pbv);
                    if (_orderId == vanId) _velden["BvID"] = pbv;
                    await Laad();
                    Toon($"Opgeslagen. De BV is nu {BvNaam(pbv)} (die van het project).", false);
                    return;
                }
            }

            else if (wijziging.Kolom.Equals("Description", StringComparison.OrdinalIgnoreCase))
                await Laad();

            Toon("Opgeslagen.", false);
        }
        catch (Exception ex) { Toon("Opslaan mislukt: " + ex.Message, true); }
    }

