    // ---- Voortgang: per stap wanneer en door wie ----
    private record VoortgangStap(string Naam, string Wanneer, string Wie, string Klasse);

    private static readonly (string Naam, string Datum, string Door)[] Stappen =
    {
        ("Aangemaakt", "Creation date", "Created by"),
        ("Aangevraagd (Volgende)", "Request date", "Requested by"),
        ("Goedgekeurd door PM", "Approved1 date", "Approved1 by"),
        ("Goedgekeurd door Directie", "Approved2 date", "Approved2 by"),
        ("Gemaild aan leverancier", "MailAangemaakt", ""),
        ("Besteld", "Ordered date", "Ordered by"),
        ("Geleverd", "Delivered date", "Delivered by"),
        ("Geannuleerd", "Canceled date", "Canceled by"),
    };

    private DateTime? Datum(string kolom)
        => _velden.TryGetValue(kolom, out var v) && v is not null && DateTime.TryParse(v.ToString(), out var d) ? d : null;

    /// <summary>Een id-veld van de bestelling (Created by, Ordered by); 0 of leeg = geen.</summary>
    private int? VeldId(string kolom)
        => _velden.TryGetValue(kolom, out var v) && v is not null && int.TryParse(v.ToString(), out var i) && i != 0 ? i : null;

    private string WerknemerNaam(int? id)
        => id is int i ? Lijst("Werknemer").FirstOrDefault(w => w.Id == i)?.Naam ?? $"#{i}" : "";

    /// <summary>Is een goedkeurstap overgeslagen (geen datum, terwijl de bestelling al verder is)?</summary>
    private bool Overgeslagen(int stap)
        => stap is BestelFlow.GoedkeuringPm or BestelFlow.GoedkeuringDirectie && _status > stap
           && _status != BestelVelden.StatusGeannuleerd
           && Datum(stap == BestelFlow.GoedkeuringPm ? "Approved1 date" : "Approved2 date") is null;

    private string StapKlasse(Bestelstatus s) => s.Id >= _status ? "" : Overgeslagen(s.Id) ? "overgeslagen" : "gehad";
    private string StapTip(Bestelstatus s) => Overgeslagen(s.Id) ? "Niet nodig: binnen de goedkeurgrens" : StapTitel;

    private IEnumerable<VoortgangStap> Voortgang()
    {
        foreach (var (naam, datumKolom, doorKolom) in Stappen)
        {
            if (!_kolommen.Contains(datumKolom)) continue;
            var d = Datum(datumKolom);
            if (d is null && datumKolom == "Canceled date") continue;          // alleen tonen als hij geannuleerd is
            var wie = d is not null && doorKolom.Length > 0 ? WerknemerNaam(Nummer(doorKolom)) : "";
            var stap = datumKolom == "Approved1 date" ? BestelFlow.GoedkeuringPm : datumKolom == "Approved2 date" ? BestelFlow.GoedkeuringDirectie : -1;
            if (d is null && Overgeslagen(stap))
                yield return new VoortgangStap(naam, "niet nodig", "binnen de goedkeurgrens", "overgeslagen");
            else
                yield return new VoortgangStap(naam, d is { } x ? x.ToString(x.TimeOfDay == TimeSpan.Zero ? "dd-MM-yyyy" : "dd-MM-yyyy HH:mm") : "—",
                                               wie.Length > 0 ? "door " + wie : "", d is null ? "open" : "klaar");
        }
    }

    private int? Nummer(string kolom)
    {
        if (!_velden.TryGetValue(kolom, out var v) || v is null) return null;
        return int.TryParse(v.ToString(), out var n) ? n : null;
    }

