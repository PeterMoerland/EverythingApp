    /// <summary>Springt naar een ander exemplaar; links wordt de selectie meegenomen.</summary>
    private async Task GaNaar(SamenstellingRegel regel)
    {
        var naam = _namen.FirstOrDefault(n => n.Id == regel.ProductNameId);
        if (naam is null)
        {
            // buiten het huidige filter: filters wissen en opnieuw zoeken
            _zoek = "";
            _typeId = null;
            await LaadNamen();
            naam = _namen.FirstOrDefault(n => n.Id == regel.ProductNameId);
        }
        if (naam is null) { Toon("Het producttype van dat exemplaar is niet gevonden.", true); return; }

        await KiesNaam(naam);

        var doel = _producten.FirstOrDefault(p => p.Id == regel.ProductId);
        if (doel is null)
        {
            // staat misschien op gewist
            _inclGewist = true;
            await LaadProducten();
            doel = _producten.FirstOrDefault(p => p.Id == regel.ProductId);
        }
        if (doel is null) { Toon("Dat exemplaar is niet gevonden.", true); return; }

        await KiesProduct(doel);
        _tab = "Samenstelling";
    }

    private async Task NaarOuder()
    {
        if (_gebruiktIn is not null) await GaNaar(_gebruiktIn);
    }

    private async Task VrijZoekGewijzigd(ChangeEventArgs e)
    {
        _vrijZoek = (string?)e.Value ?? "";
        if (_vrijZoek.Trim().Length < 2) { _vrije = new(); return; }
        try { _vrije = await Repo.ZoekVrijeExemplarenAsync(_vrijZoek, 15); }
        catch (Exception ex) { _vrije = new(); Toon("Zoeken mislukt: " + ex.Message, true); }
    }

    private async Task Koppel(SamenstellingRegel v)
    {
        if (_productId is null) return;
        if (v.ProductId == _productId) { Toon("Een product kan niet in zichzelf zitten.", true); return; }

        try
        {
            await Repo.KoppelAsync(v.ProductId, _productId);
            await Repo.VoegHistorieToeAsync(_productId.Value,
                $"Product {v.Serienummer} aan samenstelling toegevoegd",
                ProductVelden.HistorieLevensloop, Ik.WerknemerId);
            await Repo.VoegHistorieToeAsync(v.ProductId,
                $"Toegevoegd aan samenstelling van {_product?.Serienummer}",
                ProductVelden.HistorieLevensloop, Ik.WerknemerId);

            _vrijZoek = "";
            _vrije = new();
            await LaadSamenstelling();
            _historie = await Repo.GetHistorieAsync(_productId.Value);
            Toon($"{v.Serienummer} toegevoegd aan de samenstelling.", false);
        }
        catch (Exception ex) { Toon("Toevoegen mislukt: " + ex.Message, true); }
    }

    private async Task Ontkoppel(SamenstellingRegel o)
    {
        if (_productId is null) return;
        if (!await Bevestig($"{o.Serienummer} uit de samenstelling halen?\n\n" +
                            "Het exemplaar blijft bestaan, het hangt alleen niet meer hieronder.")) return;

        try
        {
            await Repo.KoppelAsync(o.ProductId, null);
            await Repo.VoegHistorieToeAsync(_productId.Value,
                $"Product {o.Serienummer} uit samenstelling gehaald",
                ProductVelden.HistorieLevensloop, Ik.WerknemerId);
            await LaadSamenstelling();
            _historie = await Repo.GetHistorieAsync(_productId.Value);
            Toon($"{o.Serienummer} uit de samenstelling gehaald.", false);
        }
        catch (Exception ex) { Toon("Verwijderen mislukt: " + ex.Message, true); }
    }

