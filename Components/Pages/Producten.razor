    private async Task NieuwType()
    {
        // ProductName is varchar(15), dus afkappen in plaats van een SQL-fout
        var naam = string.IsNullOrWhiteSpace(_zoek)
            ? "NIEUW"
            : new string(_zoek.Trim().Take(15).ToArray());
