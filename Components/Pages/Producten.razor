    private void ToonVoorbeeld(int fileStoreId, string naam)
    {
        _voorbeeldId = fileStoreId;
        _voorbeeldNaam = naam;
    }

    private void SluitVoorbeeld() => _voorbeeldId = null;
    private int HuidigStoreType => _productId is null
        ? ProductVelden.StoreTypeProductgroep
        : ProductVelden.StoreTypeProduct;

    private int? HuidigMasterId => _productId ?? _naamId;

    private async Task LaadDocumenten()
    {
        if (HuidigMasterId is null || !WnRepo.Beschikbaar) { _documenten = new(); return; }
        try { _documenten = await WnRepo.GetBestandenAsync(HuidigStoreType, HuidigMasterId.Value); }
        catch { _documenten = new(); }
    }

    private async Task BestandenGekozen(InputFileChangeEventArgs e)
    {
        _sleepActief = false;
        if (HuidigMasterId is null) return;
        if (!Store.Beschikbaar)
        {
            Toon("De filestore is niet ingesteld (Filestore:Pad in appsettings.json).", true);
            return;
        }

        var gelukt = 0;
        foreach (var bestand in e.GetMultipleFiles(20))
        {
            try
            {
                await using var stroom = bestand.OpenReadStream(50 * 1024 * 1024);
                await Store.ToevoegenAsync(stroom, bestand.Name, HuidigStoreType,
                                           HuidigMasterId.Value, Ik.WerknemerId ?? 0);
                gelukt++;
            }
            catch (Exception ex) { Toon($"'{bestand.Name}' toevoegen mislukt: {ex.Message}", true); }
        }

        await LaadDocumenten();
        if (gelukt > 0)
        {
            if (_productId is not null)
                await Repo.VoegHistorieToeAsync(_productId.Value,
                    $"{gelukt} document(en) toegevoegd.", null, Ik.WerknemerId);
            Toon($"{gelukt} bestand(en) toegevoegd.", false);
        }
    }

    private async Task VerwijderDocument(Bestand d)
    {
        if (!await Bevestig($"'{d.Bestandsnaam}' verwijderen?\n\nHet bestand gaat ook van schijf af.")) return;

        try
        {
            await Store.VerwijderAsync(d.FileStoreId);
            await LaadDocumenten();
            Toon("Document verwijderd.", false);
        }
        catch (Exception ex) { Toon("Verwijderen mislukt: " + ex.Message, true); }
    }

