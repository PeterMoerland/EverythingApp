    private async Task UploadParam(DriveParameterset ps, InputFileChangeEventArgs e)
    {
        if (!Store.Beschikbaar) { Toon("De filestore is niet ingesteld (Filestore:Pad).", true); return; }
        try
        {
            var bestand = e.File;
            using var geheugen = new MemoryStream();
            await bestand.OpenReadStream(20 * 1024 * 1024).CopyToAsync(geheugen);

            // De kop van het .xcf zegt voor welke drive hij is: <Device ProductCode="57741313"
            // PartNumber="CAP-NET-E" firmwareVersion="…">. Past dat niet bij het drivetype
            // van deze positie, dan waarschuwen — opslaan mag wel, jij beslist.
            var waarschuwing = "";
            var kop = XcfKop(geheugen.ToArray());
            if (kop is not null)
            {
                var positie = _posities.FirstOrDefault(p => p.Positie == ps.Positie);
                var type = _driveTypen.FirstOrDefault(t => t.Id == positie?.DriveTypeId);
                if (type is not null && !string.Equals(MySqlDriveRepository.NormaliseerCode(type.ProductCode), kop.Value.Code, StringComparison.OrdinalIgnoreCase))
                    waarschuwing = $" Let op: dit bestand is voor {kop.Value.PartNumber} ({kop.Value.Code}), positie {ps.Positie} verwacht {type.Naam}.";
                if (ps.Opmerking.Length == 0)
                    ps.Opmerking = $"{kop.Value.PartNumber}, xcf-firmware {kop.Value.Firmware}, {kop.Value.Registers} registers";
            }

            geheugen.Position = 0;
            var nieuwId = await Store.ToevoegenAsync(geheugen, bestand.Name, DriveStore.Parameters, ps.Id, Ik.WerknemerId ?? 0);
            var oud = ps.ParameterFileId;
            ps.ParameterFileId = nieuwId;
            if (ps.Omschrijving.Length == 0) ps.Omschrijving = Path.GetFileNameWithoutExtension(bestand.Name);
            await Drives.BewaarParametersetAsync(ps, Ik.WerknemerId);
            if (oud is int o) { try { await Store.VerwijderAsync(o); } catch { } }
            _drvVervang = null;
            if (_naamId is int n) await LaadDrives(n);
            Toon($"'{bestand.Name}' opgeslagen." + waarschuwing, waarschuwing.Length > 0);
        }
        catch (Exception ex) { Toon("Upload mislukt: " + ex.Message, true); }
    }

    /// <summary>Kop van een Ingenia .xcf: productcode (hex), partnumber, firmware, aantal registers.</summary>
    private static (string Code, string PartNumber, string Firmware, int Registers)? XcfKop(byte[] inhoud)
    {
        try
        {
            var doc = System.Xml.Linq.XDocument.Load(new MemoryStream(inhoud));
            var dev = doc.Descendants("Device").FirstOrDefault();
            if (dev is null) return null;
            var code = MySqlDriveRepository.NormaliseerCode((string?)dev.Attribute("ProductCode") ?? "");
            return (code, (string?)dev.Attribute("PartNumber") ?? "", (string?)dev.Attribute("firmwareVersion") ?? "",
                    doc.Descendants("Register").Count());
        }
        catch { return null; }
    }

    private async Task VerwijderParam(DriveParameterset ps)
    {
        if (!await Bevestig($"Parameterset '{ps.Omschrijving}' (positie {ps.Positie}, firmware {ps.FirmwareVersie}) verwijderen?")) return;
        try
        {
            if (ps.ParameterFileId is int f) { try { await Store.VerwijderAsync(f); } catch { } }
            await Drives.VerwijderParametersetAsync(ps.Id);
            if (_naamId is int n) await LaadDrives(n);
        }
        catch (Exception ex) { Toon("Verwijderen mislukt: " + ex.Message, true); }
    }

