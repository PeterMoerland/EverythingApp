    /// <summary>Een stap omhoog/omlaag binnen zijn eigen soort (opbouw of controle).</summary>
    private async Task Verschuif(OpbouwStap stap, int richting)
    {
        var lijst = _stappen.Where(s => s.Soort == stap.Soort).ToList();
        var index = lijst.IndexOf(stap);
        var nieuw = index + richting;
        if (index < 0 || nieuw < 0 || nieuw >= lijst.Count) return;
        (lijst[index], lijst[nieuw]) = (lijst[nieuw], lijst[index]);
        try { await Opbouw.ZetVolgordeAsync(lijst.Select(s => s.Id).ToList()); await LaadOpbouw(); }
        catch (Exception ex) { Toon("Volgorde opslaan mislukt: " + ex.Message, true); }
    }

