    private async Task UploadStapDoc(OpbouwStap s, InputFileChangeEventArgs e)
    {
        if (!Store.Beschikbaar) { Toon("De filestore is niet ingesteld (Filestore:Pad).", true); return; }
        var gelukt = 0;
        foreach (var bestand in e.GetMultipleFiles(10))
        {
            try
            {
                await using var stroom = bestand.OpenReadStream(50 * 1024 * 1024);
                await Store.ToevoegenAsync(stroom, bestand.Name, OpbouwStore.Stap, s.Id, Ik.WerknemerId ?? 0);
                gelukt++;
            }
            catch (Exception ex) { Toon($"'{bestand.Name}' toevoegen mislukt: {ex.Message}", true); }
        }
        _stapDocumenten = await WnRepo.GetBestandenAsync(OpbouwStore.Stap, s.Id);
        s.AantalDocumenten = _stapDocumenten.Count;
        if (gelukt > 0) Toon($"{gelukt} document(en) bij '{s.Naam}'.", false);
    }

    private async Task VerwijderStapDoc(Bestand d)
    {
        if (!await Bevestig($"'{d.Bestandsnaam}' verwijderen?")) return;
        try
        {
            await Store.VerwijderAsync(d.FileStoreId);
            if (_stapDocs is int id)
            {
                _stapDocumenten = await WnRepo.GetBestandenAsync(OpbouwStore.Stap, id);
                var s = _stappen.FirstOrDefault(x => x.Id == id);
                if (s is not null) s.AantalDocumenten = _stapDocumenten.Count;
            }
        }
        catch (Exception ex) { Toon("Verwijderen mislukt: " + ex.Message, true); }
    }

