    private bool HeeftDrivesOfServo => _technieken.Contains(ProductTechniek.Drives) || _technieken.Contains(ProductTechniek.Feetech);
    private bool HeeftChip => _technieken.Contains(ProductTechniek.Esp32) || _technieken.Contains(ProductTechniek.Stm32);

    /// <summary>Controllertypen die bij de aangevinkte technieken passen (ESP32-print: geen Everest in de lijst).</summary>
    private IEnumerable<DriveSoort> TypenVoorProduct => _driveTypen.Where(t =>
        t.Protocol switch
        {
            DriveProtocol.Esp32 => _technieken.Contains(ProductTechniek.Esp32),
            DriveProtocol.Stm32 => _technieken.Contains(ProductTechniek.Stm32),
            DriveProtocol.Feetech => _technieken.Contains(ProductTechniek.Feetech),
            DriveProtocol.Coe => _technieken.Contains(ProductTechniek.Drives) || _technieken.Contains(ProductTechniek.Can),   // eRob: EtherCAT óf CAN
            _ => _technieken.Contains(ProductTechniek.Drives),
        });

    /// <summary>Vinkje 'stap zichtbaar in Half-fabricaten' — kolom Toon… in ProductNameExtra.</summary>
    private async Task ZetStapZichtbaar(string code, ChangeEventArgs e)
    {
        if (_naamId is null || _naam is null) return;
        var toon = e.Value is bool b && b;
        try
        {
            await Repo.ZetStapZichtbaarAsync(_naamId.Value, code, toon);
            if (toon) _naam.VerborgenStappen.Remove(code); else _naam.VerborgenStappen.Add(code);
            Toon("Opgeslagen.", false);
        }
        catch (Exception ex) { Toon(ex.Message, true); }
    }

    /// <summary>Parametersets laden staat aan zolang er géén regel 'geenparams' is (zie ProductTechniek.GeenParameters).</summary>
    private bool MetParameters => !_technieken.Contains(ProductTechniek.GeenParameters);

    private Task ZetMetParameters(ChangeEventArgs e)
        => ZetTechniek(ProductTechniek.GeenParameters, new ChangeEventArgs { Value = !(e.Value is bool b && b) });

    private async Task ZetTechniek(string code, ChangeEventArgs e)
    {
        if (_naamId is null) return;
        var aan = e.Value is bool b && b;
        try
        {
            await Repo.ZetTechniekAsync(_naamId.Value, code, aan);
            if (aan) _technieken.Add(code); else _technieken.Remove(code);
            Toon("Opgeslagen.", false);
        }
        catch (Exception ex)
        {
            Toon(ex.Message.Contains("doesn't exist", StringComparison.OrdinalIgnoreCase)
                ? "De tabel ProductTechnieken ontbreekt nog: voer ProductTechniek_MariaDB.sql uit."
                : "Opslaan mislukt: " + ex.Message, true);
        }
    }

    private async Task LaadDrives(int productNameId)
    {
        if (!Drives.Beschikbaar) return;
        try { _technieken = await Repo.GetTechniekenAsync(productNameId); } catch { _technieken = new(StringComparer.OrdinalIgnoreCase); }
        try
        {
            _driveTypen = await Drives.GetTypenAsync();
            _alleFirmwares = new();
            foreach (var t in _driveTypen)
                foreach (var f in await Drives.GetFirmwaresAsync(t.Id))
                    _alleFirmwares.Add((f.Id, t.Naam, f.Versie, f.Status));
            _posities = await Drives.GetPositiesAsync(productNameId);
            _parametersets = await Drives.GetParametersetsAsync(productNameId);
            _drvOntbreekt = false;
        }
        catch (Exception ex)
        {
            _drvOntbreekt = ex.Message.Contains("doesn't exist", StringComparison.OrdinalIgnoreCase);
            if (!_drvOntbreekt) Toon("Drives laden mislukt: " + ex.Message, true);
        }
    }

    private async Task NieuwePositie()
    {
        if (_naamId is null) return;
        try
        {
            var volgende = _posities.Count == 0 ? 1 : _posities.Max(p => p.Positie) + 1;
            await Drives.BewaarPositieAsync(new DrivePositie { ProductNameId = _naamId.Value, Positie = volgende, Naam = $"Drive {volgende}" });
            await LaadDrives(_naamId.Value);
        }
        catch (Exception ex) { Toon("Toevoegen mislukt: " + ex.Message, true); }
    }

