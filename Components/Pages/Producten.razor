    // ================================================================
    //  Exemplaren
    // ================================================================
    private async Task LaadProducten()
    {
        if (_naamId is null) { _producten = new(); return; }
        try
        {
            var alle = await Repo.GetProductenAsync(_naamId.Value, _inclGewist);
            _alleProducten = alle;
            if (!_statusFilterGeladen && _statusFilter.Count == 0) StatusStandaardZetten();
            // het geopende exemplaar blijft altijd zichtbaar, ook als zijn status niet aangevinkt is
            _producten = NieuwsteBoven(alle.Where(p => StatusZichtbaar(p) || p.Id == _productId)).ToList();
        }
        catch (Exception ex) { _producten = new(); _alleProducten = new(); Toon("Exemplaren ophalen mislukt: " + ex.Message, true); }

        // Aangevinkte exemplaren die niet meer in de lijst staan (bijvoorbeeld nadat
        // 'Inclusief gewist' uitging) uit de selectie halen — anders werkt een
        // groepsbewerking op iets dat je niet ziet.
        _gekozen.RemoveWhere(id => _producten.All(p => p.Id != id));

        if (_productId is null) return;

        _product = _producten.FirstOrDefault(p => p.Id == _productId);

        // Uit de lijst gevallen (bijvoorbeeld 'Inclusief gewist' uitgezet)?
        // Dan ook de rechterkant vrijgeven, anders klopt het scherm niet meer.
        if (_product is null) LeegmakenProduct();
    }

    /// <summary>
    /// Zoekt een exemplaar (scan, link, samenstelling) in de lijst. Staat het buiten het
    /// filter — andere status of gewist — dan komt het er als geopend exemplaar tóch bij,
    /// zonder de statuskeuze van de gebruiker te veranderen.
    /// </summary>
    private async Task<ProductRegel?> ZoekInLijst(int id)
    {
        var regel = _producten.FirstOrDefault(p => p.Id == id);
        if (regel is not null) return regel;

        if (_alleProducten.All(p => p.Id != id) && !_inclGewist)
        {
            _inclGewist = true;                       // staat op gewist: dan ook die tonen
            await LaadProducten();
        }
        if (_alleProducten.All(p => p.Id != id)) return null;

        _productId = id;                              // het geopende exemplaar staat altijd in de lijst
        await LaadProducten();
        return _producten.FirstOrDefault(p => p.Id == id);
    }

    private async Task KiesProduct(ProductRegel p)
    {
        _productId = p.Id;
        _product = p;
        if (!Tabs.Contains(_tab)) _tab = "Algemeen";
        await WachtOpOpslaan();

        try { _velden = await Repo.GetVeldenAsync(p.Id); }
        catch (Exception ex) { Toon("Gegevens ophalen mislukt: " + ex.Message, true); }

        try { _historie = await Repo.GetHistorieAsync(p.Id); } catch { _historie = new(); }
        try { _attributen = await Repo.GetAttributenAsync(p.Id); } catch { _attributen = new(); }
        await LaadSamenstelling();
        if (_histMetOnderdelen) await LaadHistorieOnderdelen();
        await LaadDocumenten();
        await LaadOpbouw();
    }

