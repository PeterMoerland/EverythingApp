    // Zoeken/filteren in de historie van het geopende exemplaar (alleen in het scherm, niets wordt bewaard).
    private string _histZoek = "", _histSoortFilter = "", _histUitkomst = "";
    private bool _histMetOnderdelen;
    private List<ProductGebeurtenis> _histOnderdelen = new();            // historie van de gekoppelde halffabricaten
    private readonly Dictionary<int, string> _histVan = new();           // historie-id → 'code · serienummer' van het onderdeel

    // ---- historie opschonen: regels aanvinken en wissen, alleen Directie ----
    private bool MagHistorieWissen => Ik.Mag("Directie");
    private readonly HashSet<int> _histGekozen = new();
    /// <summary>Aangevinkt én nu zichtbaar: alleen die worden gewist (filter of ander exemplaar laat oude vinkjes vallen).</summary>
    private List<ProductGebeurtenis> HistGekozen => HistorieGefilterd.Where(h => _histGekozen.Contains(h.Id)).ToList();
    private int HistKolommen => 4 + (_histMetOnderdelen ? 1 : 0) + (MagHistorieWissen ? 1 : 0);
    private bool AlleHistGekozen
    {
        get { var z = HistorieGefilterd; return z.Count > 0 && z.All(h => _histGekozen.Contains(h.Id)); }
    }

    private void KiesHist(int id, ChangeEventArgs e)
    {
        if (e.Value is bool b && b) _histGekozen.Add(id); else _histGekozen.Remove(id);
    }

    private void KiesAlleHist(ChangeEventArgs e)
    {
        var aan = e.Value is bool b && b;
        foreach (var h in HistorieGefilterd)
            if (aan) _histGekozen.Add(h.Id); else _histGekozen.Remove(h.Id);
    }

    private async Task WisHistorie()
    {
        if (!MagHistorieWissen || _productId is null) return;
        var regels = HistGekozen;
        if (regels.Count == 0) return;

        var vanOnderdelen = regels.Count(h => _histVan.ContainsKey(h.Id));
        var voorbeeld = string.Join("\n", regels.Take(6).Select(h =>
            $"• {h.Wanneer:dd-MM-yyyy HH:mm}  {(h.Event.Length > 70 ? h.Event[..70] + "…" : h.Event)}"));
        if (regels.Count > 6) voorbeeld += $"\n… en nog {regels.Count - 6}";
        var vraag = $"{regels.Count} historieregel(s) definitief wissen?\n\n{voorbeeld}" +
                    (vanOnderdelen > 0 ? $"\n\n{vanOnderdelen} daarvan horen bij een onderdeel en verdwijnen ook daar." : "") +
                    "\n\nDit kan niet ongedaan worden gemaakt.";
        // geen terugval op 'ja' als de vraag niet getoond kan worden
        bool ja;
        try { ja = await JS.InvokeAsync<bool>("mdeBevestig", vraag); } catch { ja = false; }
        if (!ja) return;

        try
        {
            var n = await Repo.VerwijderHistorieAsync(regels.Select(h => h.Id).ToList());
            _histGekozen.Clear();
            _historie = await Repo.GetHistorieAsync(_productId.Value);
            if (_histMetOnderdelen) await LaadHistorieOnderdelen();
            Toon($"{n} historieregel(s) gewist.", false);
        }
        catch (Exception ex) { Toon("Wissen mislukt: " + ex.Message, true); }
    }

    private async Task HistOnderdelenGewijzigd(ChangeEventArgs e)
    {
        _histMetOnderdelen = e.Value is bool b && b;
        if (_histMetOnderdelen) await LaadHistorieOnderdelen();
    }

    /// <summary>Historie van alle onderdelen in de samenstelling, recursief tot 3 niveaus (onderdeel van onderdeel).</summary>
    private async Task LaadHistorieOnderdelen()
    {
        _histOnderdelen = new(); _histVan.Clear();
        if (_productId is null) return;
        var gezien = new HashSet<int> { _productId.Value };
        async Task Verzamel(int productId, string pad, int diepte)
        {
            if (diepte > 3) return;
            List<SamenstellingRegel> onderdelen;
            try { onderdelen = await Repo.GetOnderdelenAsync(productId); } catch { return; }
            foreach (var o in onderdelen)
            {
                if (!gezien.Add(o.ProductId)) continue;
                var naam = (pad.Length > 0 ? pad + " › " : "") + $"{o.Code} {o.Serienummer}".Trim();
                try
                {
                    foreach (var h in await Repo.GetHistorieAsync(o.ProductId))
                    {
                        _histOnderdelen.Add(h);
                        _histVan[h.Id] = naam;
                    }
                }
                catch { }
                await Verzamel(o.ProductId, naam, diepte + 1);
            }
        }
        await Verzamel(_productId.Value, "", 1);
    }

    private List<ProductGebeurtenis> HistorieGefilterd
    {
        get
        {
            IEnumerable<ProductGebeurtenis> q = _histMetOnderdelen
                ? _historie.Concat(_histOnderdelen).OrderByDescending(h => h.Wanneer ?? DateTime.MinValue).ThenByDescending(h => h.Id)
                : _historie;
            if (_histSoortFilter.Length > 0) q = q.Where(h => h.Soort == _histSoortFilter);
            if (_histUitkomst == "ok") q = q.Where(h => h.Uitkomst == true);
            else if (_histUitkomst == "fout") q = q.Where(h => h.Uitkomst == false);
            var termen = _histZoek.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            foreach (var t in termen)
                q = q.Where(h => h.Event.Contains(t, StringComparison.OrdinalIgnoreCase)
                              || h.Soort.Contains(t, StringComparison.OrdinalIgnoreCase)
                              || (_histVan.TryGetValue(h.Id, out var bron) && bron.Contains(t, StringComparison.OrdinalIgnoreCase))
                              || h.Door.Contains(t, StringComparison.OrdinalIgnoreCase)
                              || (h.Wanneer?.ToString("dd-MM-yyyy HH:mm") ?? "").Contains(t, StringComparison.OrdinalIgnoreCase));
            return q.ToList();
        }
    }

    private async Task VoegHistorieToe()
    {
        if (_productId is null) return;
        if (string.IsNullOrWhiteSpace(_nieuwEvent))
        {
            Toon("Vul in wat er gebeurd is.", true);
            return;
        }

        try
        {
            await Repo.VoegHistorieToeAsync(_productId.Value, _nieuwEvent.Trim(),
                                            _historieSoortId, Ik.WerknemerId);
            _nieuwEvent = "";
            _historie = await Repo.GetHistorieAsync(_productId.Value);
            Toon("Toegevoegd aan de historie.", false);
        }
        catch (Exception ex) { Toon("Toevoegen mislukt: " + ex.Message, true); }
    }

