    private Task Bewaar((string Kolom, object? Waarde) wijziging) => _opslaanBezig = BewaarKern(wijziging);

    private async Task BewaarKern((string Kolom, object? Waarde) wijziging)
    {
        if (_productId is null) return;
        var vanId = _productId.Value;       // het exemplaar van de wijziging, ook als er intussen een ander gekozen is
        try
        {
            var opslaan = wijziging.Waarde is string s && string.IsNullOrWhiteSpace(s) ? null : wijziging.Waarde;
            await Repo.UpdateVeldAsync(vanId, wijziging.Kolom, opslaan);
            if (_productId == vanId) _velden[wijziging.Kolom] = opslaan;

            // Serienummer, status of klant gewijzigd? dan klopt de lijst links niet meer
            if (wijziging.Kolom.Equals("ProductNameID", StringComparison.OrdinalIgnoreCase))
            {
                // Het exemplaar hangt nu onder een ander type: selectie vrijgeven,
                // anders staat links iets anders dan rechts.
                if (_productId == vanId) LeegmakenProduct();
                await LaadProducten();
                Toon("Verplaatst naar het andere producttype.", false);
                return;
            }

            // serienummer of bouwjaar staan op het typeplaatje
            if (wijziging.Kolom.StartsWith("Serie", StringComparison.OrdinalIgnoreCase)
                || wijziging.Kolom.Equals("Bouwjaar", StringComparison.OrdinalIgnoreCase))
                _labelVersie++;

            if (wijziging.Kolom.StartsWith("Serie", StringComparison.OrdinalIgnoreCase)
                || wijziging.Kolom.Equals("ProductStatusID", StringComparison.OrdinalIgnoreCase)
                || wijziging.Kolom.Equals("KlantID", StringComparison.OrdinalIgnoreCase)
                || wijziging.Kolom.Equals("Opmerking", StringComparison.OrdinalIgnoreCase))
                await LaadProducten();

            Toon("Opgeslagen.", false);
        }
        catch (Exception ex) { Toon("Opslaan mislukt: " + ex.Message, true); }
    }

    private async Task NieuwProduct()
    {
        if (_naamId is null) return;
        try
        {
            var ids = await Repo.NieuweProductenAsync(_naamId.Value, _nieuwAantal, null, null, Ik.WerknemerId);
            if (ids.Count == 0) { Toon("Er is niets aangemaakt.", true); return; }

            await LaadProducten();

            // bij één stuk meteen openen, bij meer de nieuwe alvast aanvinken
            if (ids.Count == 1)
            {
                var nieuw = _producten.FirstOrDefault(p => p.Id == ids[0]);
                if (nieuw is not null) await KiesProduct(nieuw);
                Toon($"Exemplaar {nieuw?.Serienummer} aangemaakt.", false);
            }
            else
            {
                _gekozen.Clear();
                foreach (var id in ids) _gekozen.Add(id);
                Toon($"{ids.Count} exemplaren aangemaakt en aangevinkt, klaar voor een groepsbewerking.", false);
            }
        }
        catch (Exception ex) { Toon("Aanmaken mislukt: " + ex.Message, true); }
    }

    private async Task WisProduct()
    {
        if (_productId is null || _product is null) return;
        var sn = string.IsNullOrWhiteSpace(_product.Serienummer) ? "dit exemplaar" : _product.Serienummer;

        if (!await Bevestig($"Serienummer {sn} wissen?\n\n" +
                            "Het verdwijnt uit de lijst maar blijft met historie bewaard; " +
                            "met 'Inclusief gewist' kun je het terugzetten.")) return;

        try
        {
            await Repo.ZetGewistAsync(_productId.Value, true);
            await Repo.VoegHistorieToeAsync(_productId.Value, "Product gewist.",
                                            ProductVelden.HistorieLevensloop, Ik.WerknemerId);
            LeegmakenProduct();
            await LaadProducten();
            await LaadDocumenten();     // nu weer de documenten van het producttype
            Toon("Exemplaar gewist.", false);
        }
        catch (Exception ex) { Toon("Wissen mislukt: " + ex.Message, true); }
