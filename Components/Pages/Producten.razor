    /// <summary>Springt naar een ander exemplaar; links wordt de selectie meegenomen.</summary>
    private async Task GaNaar(SamenstellingRegel regel)
    {
        var naam = _namen.FirstOrDefault(n => n.Id == regel.ProductNameId);
        if (naam is null)
        {
            // buiten het huidige filter: filters wissen en opnieuw zoeken
            _zoek = "";
            _typeId = null;
            await LaadNamen();
            naam = _namen.FirstOrDefault(n => n.Id == regel.ProductNameId);
        }
        if (naam is null) { Toon("Het producttype van dat exemplaar is niet gevonden.", true); return; }

        await KiesNaam(naam);

        var doel = await ZoekInLijst(regel.ProductId);
        if (doel is null) { Toon("Dat exemplaar is niet gevonden.", true); return; }

        await KiesProduct(doel);
        _tab = "Samenstelling";
    }

