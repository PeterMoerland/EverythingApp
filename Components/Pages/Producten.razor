    private async Task WisType()
    {
        if (_naamId is null || _naam is null) return;
        try
        {
            var reden = await Repo.ProductnaamInGebruikAsync(_naamId.Value);
            if (reden is not null)
            {
                Toon($"'{_naam.Naam}' kan niet worden verwijderd. {reden}", true);
                return;
