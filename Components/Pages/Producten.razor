    /// <summary>Eindproduct (geen halffabricaat/motor): dan hoort de duurtest bij de tab Programmeren.</summary>
    private bool IsEindproduct
    {
        get
        {
            static string Kaal(string s) => new string(s.Where(char.IsLetter).ToArray()).ToLowerInvariant();
            var type = _types.FirstOrDefault(t => t.Id == _naamTypeId);
            if (type is null) return false;
            var k = Kaal(type.Naam);
            return k.Contains("product") && !k.Contains("half");
        }
