    {
        wijzig();
        try { await Drives.BewaarPositieAsync(p); if (_naamId is int n) await LaadDrives(n); Toon("Opgeslagen.", false); }
        catch (Exception ex) { Toon("Opslaan mislukt: " + ex.Message, true); }
