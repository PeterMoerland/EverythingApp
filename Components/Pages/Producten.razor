    private List<ProductNaam> _stuklijstTreffers = new();

    private async Task LaadStuklijst()
    {
        _stuklijst = new(); _stuklijstZoek = ""; _stuklijstTreffers = new();
        if (_naamId is null) return;
        try
        {
            _heeftStuklijst = await Repo.HeeftStuklijstAsync();
            _stuklijst = await Repo.GetStuklijstAsync(_naamId.Value);
        }
        catch (Exception ex) { Toon("Stuklijst laden mislukt: " + ex.Message, true); }
    }

    private async Task StuklijstZoekGewijzigd(ChangeEventArgs e)
    {
        _stuklijstZoek = ((string?)e.Value ?? "").Trim();
        _stuklijstTreffers = new();
        if (_stuklijstZoek.Length < 2) return;
        try
        {
            // Alle producttypes behalve het product zelf en wat er al in staat; halffabricaten eerst.
            var alles = await Repo.ZoekProductnamenAsync(_stuklijstZoek, null);
            _stuklijstTreffers = alles
                .Where(n => n.Id != _naamId && _stuklijst.All(s => s.OnderdeelNameId != n.Id))
                .OrderBy(n => n.TypeId == _naamTypeId ? 1 : 0)   // eigen type (eindproducten) achteraan
                .ThenBy(n => n.Naam)
                .Take(30).ToList();
        }
        catch (Exception ex) { Toon("Zoeken mislukt: " + ex.Message, true); }
    }

    private async Task VoegStuklijstToe(ProductNaam n)
    {
        if (_naamId is null) return;
        try
        {
            await Repo.BewaarStuklijstRegelAsync(new StuklijstRegel { ProductNameId = _naamId.Value, OnderdeelNameId = n.Id, Aantal = 1 }, Ik.WerknemerId);
            await LaadStuklijst();
            Toon($"{n.Naam} toegevoegd aan de stuklijst.", false);
        }
        catch (Exception ex) { Toon(ex.Message, true); }
    }

    private async Task ZetStuklijst(StuklijstRegel s, Action wijzig)
    {
        wijzig();
        try { await Repo.BewaarStuklijstRegelAsync(s, Ik.WerknemerId); Toon("Opgeslagen.", false); }
        catch (Exception ex) { Toon(ex.Message, true); await LaadStuklijst(); }
    }

    private async Task VerwijderStuklijst(StuklijstRegel s)
    {
        if (!await Bevestig($"'{s.OnderdeelNaam}' uit de stuklijst van {_naamNaam} halen?")) return;
        try { await Repo.VerwijderStuklijstRegelAsync(s.Id); await LaadStuklijst(); }
        catch (Exception ex) { Toon(ex.Message, true); }
    }

    private async Task VerschuifStuklijst(StuklijstRegel s, int richting)
    {
        var index = _stuklijst.IndexOf(s);
        var nieuw = index + richting;
        if (index < 0 || nieuw < 0 || nieuw >= _stuklijst.Count) return;
        (_stuklijst[index], _stuklijst[nieuw]) = (_stuklijst[nieuw], _stuklijst[index]);
        try
        {
            for (var i = 0; i < _stuklijst.Count; i++)
            {
                if (_stuklijst[i].Volgorde == i + 1) continue;
                _stuklijst[i].Volgorde = i + 1;
                await Repo.BewaarStuklijstRegelAsync(_stuklijst[i], Ik.WerknemerId);
            }
        }
        catch (Exception ex) { Toon("Volgorde opslaan mislukt: " + ex.Message, true); await LaadStuklijst(); }
    }

