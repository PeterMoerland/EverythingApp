    /// <summary>Nieuwe parameterset voor de eerste positie, en meteen de editor erop.</summary>
    private async Task NieuweFeetechSet()
    {
        if (_naamId is null || _posities.Count == 0 || _alleFirmwares.Count == 0) return;
        try
        {
            var pos = _posities.OrderBy(p => p.Positie).First();
            var fw = _alleFirmwares.FirstOrDefault(f => f.TypeNaam == pos.DriveTypeNaam && f.Status == DriveStatus.Actueel);
            if (fw.Id == 0) fw = _alleFirmwares.FirstOrDefault(f => f.TypeNaam == pos.DriveTypeNaam);
            if (fw.Id == 0) fw = _alleFirmwares.First();
            var id = await Drives.BewaarParametersetAsync(new DriveParameterset
            {
                ProductNameId = _naamId.Value, Positie = pos.Positie, DriveFirmwareId = fw.Id,
                Omschrijving = $"{_naam?.Naam} parameters", Status = DriveStatus.Actueel
            }, Ik.WerknemerId);
            await LaadDrives(_naamId.Value);
            _editorPs = _parametersets.FirstOrDefault(p => p.Id == id);
        }
        catch (Exception ex) { Toon("Aanmaken mislukt: " + ex.Message, true); }
    }

