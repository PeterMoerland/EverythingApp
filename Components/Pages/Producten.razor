    private List<ArtikelRegel> _artikelTreffers = new();
    private bool _artikelZoekt;
    private string ArtikelPlaceholder => _naam?.ArtikelId is null ? "zoek artikel: nummer of code…" : "ander artikel zoeken…";

    /// <summary>Live zoeken in de artikeltabel: op nummer (#56083 of 56083) of op code/omschrijving.</summary>
    private async Task ArtikelZoekGewijzigd(ChangeEventArgs e)
    {
        _artikelZoek = ((string?)e.Value ?? "").Trim();
        _artikelTreffers = new();
        if (_artikelZoek.Length < 2) return;
        _artikelZoekt = true;
        try
        {
            var z = _artikelZoek.TrimStart('#');
            if (int.TryParse(z, out var nr))
            {
                var a = await Artikelen.GetAsync(nr);
                if (a is not null) _artikelTreffers.Add(new ArtikelRegel(a.Id, a.Code, a.OmschrijvingNl, ""));
            }
            if (_artikelTreffers.Count == 0)
                _artikelTreffers = await Artikelen.ZoekAsync(z, null, false, 12);
        }
        catch (Exception ex) { Toon("Artikel zoeken mislukt: " + ex.Message, true); }
        finally { _artikelZoekt = false; }
    }

    private async Task GroepGewijzigd(ChangeEventArgs e)
    {
        if (_naam is null) return;
        var groepId = int.TryParse((string?)e.Value, out var g) ? g : (int?)null;
        await BewaarExtra(groepId, _naam.ArtikelId);
    }

    private async Task ZetArtikel(int? artikelId)
    {
        if (_naam is null) return;
        _artikelZoek = ""; _artikelTreffers = new();
        await BewaarExtra(_naam.GroepId, artikelId);
    }

    private async Task BewaarExtra(int? groepId, int? artikelId)
    {
        if (_naam is null) return;
        try
        {
            await Repo.ZetProductnaamExtraAsync(_naam.Id, groepId, artikelId);
            var id = _naam.Id;
            await LaadNamen();
            _naam = _namen.FirstOrDefault(n => n.Id == id)
                    ?? (await Repo.ZoekProductnamenAsync(null, null)).FirstOrDefault(n => n.Id == id) ?? _naam;
            Toon("Opgeslagen.", false);
        }
        catch (Exception ex) { Toon(ex.Message, true); }
    }

