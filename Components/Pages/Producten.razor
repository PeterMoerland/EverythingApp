@page "/producten"
@inject IProductRepository Repo
@inject IWerknemerRepository WnRepo
@inject IUrenRepository Uren
@inject IRelatieRepository RelatieRepo
@inject FilestoreService Store
@inject LabelService Labels
@inject AltecPrinter Altec
@inject IDriveRepository Drives
@inject IArtikelRepository Artikelen
@inject IOpbouwRepository Opbouw
@inject HuidigeGebruiker Ik
@inject IJSRuntime JS
@inject IConfiguration Config
@inject WerkplekAgent Agent

<div class="page">
    <header class="topbar">
        <h1>@Titel</h1>
        <span class="weeklabel">
            @if (_naam is not null)
            {
                @($"{_producten.Count} exemplaar" + (_producten.Count == 1 ? "" : "en"))
            }
        </span>
    </header>

    @if (!Repo.Beschikbaar)
    {
        <section class="module-placeholder"><p>Dit scherm werkt alleen met de live database.</p></section>
    }
    else
    {
        @if (_melding is not null)
        {
            <div class="melding @(_fout ? "fout" : "ok")" @onclick="SluitMelding">@_melding</div>
        }

        <div class="wn-scherm">
            @* ---------- links: types en exemplaren ---------- *@
            <aside class="wn-lijst product-lijst">
                <div class="wn-filters">
                    <div class="zoekregel">
                        <input placeholder="Zoek type of omschrijving…" value="@_zoek" @onchange="ZoekGewijzigd" />
                        <button class="klein" title="Wissen" disabled="@(_zoek.Length == 0)" @onclick="WisZoek">✕</button>
                    </div>
                    <div class="zoekregel">
                        @* @key laat Blazor het veld vervangen, zodat de gescande tekst
                           er na het springen niet in blijft staan *@
                        <input @key="_scanTeller" placeholder="Serienummer of scan (PN…)"
                               value="@_scan" @onchange="ScanGewijzigd" />
                    </div>
                    <div class="zoekregel">
                        <select value="@TypeTekst" @onchange="TypeGewijzigd">
                            <option value="">Alle producttypes</option>
                            @foreach (var t in _types)
                            {
                                <option value="@t.Id">@t.Naam</option>
                            }
                        </select>
                        @if (_groepen.Count > 0)
                        {
                            <select value="@(_groepFilter?.ToString() ?? string.Empty)" @onchange="GroepFilterGewijzigd" title="Groep (Motor, PCBA, Kabel)">
                                <option value="">Alle groepen</option>
                                @foreach (var g in _groepen)
                                {
                                    <option value="@g.Id">@g.Naam</option>
                                }
                            </select>
                        }
                    </div>
                </div>

                <div class="wn-namen product-namen">
                    @if (NamenGefilterd().Count == 0)
                    {
                        <div class="kiezer-info">Niets gevonden.</div>
                    }
                    else
                    {
                        @foreach (var n in NamenGefilterd())
                        {
                            <button class="wn-naam @(n.Id == _naamId ? "actief" : "")"
                                    @key="n.Id" @onclick="() => KiesNaam(n)">
                                <span class="nda-regel">
                                    <span class="nda-naam">
                                        @n.Naam
                                        @if (n.ArtikelId is int a)
                                        {
                                            <span class="art-nr" title="Gekoppeld artikel">#@a</span>
                                        }
                                    </span>
                                    <span class="nda-onder">
                                        @if (!string.IsNullOrWhiteSpace(n.TypeCode))
                                        {
                                            <span class="type-code">@n.TypeCode</span>
                                        }
                                        @if (n.Groep.Length > 0)
                                        {
                                            <span class="type-code groep-code">@n.Groep</span>
                                        }
                                        @n.Omschrijving
                                    </span>
                                </span>
                            </button>
                        }
                    }
                </div>
                <div class="btngroep-rand">
                    <button class="klein" @onclick="NieuwType">+ Type</button>
                    <button class="klein rood" disabled="@(_naamId is null)" @onclick="WisType">✕ Type wissen</button>
                </div>

                <h3 class="wn-kop">Exemplaren <small class="uitleg">(@_producten.Count, nieuwste boven)</small></h3>
                @* Filter op status (meerkeuze) en gewist; de keuze wordt per pc onthouden. *@
                <div class="exemplaar-filter">
                    <button class="klein statusknop" @onclick="() => _statusOpen = !_statusOpen" title="Welke statussen in de lijst staan">
                        Status: @StatusFilterTekst <span class="navpijl">@(_statusOpen ? "▴" : "▾")</span>
                    </button>
                    @if (_inclGewist) { <span class="stand-chip s-rood" title="Gewiste exemplaren staan ook in de lijst">+ gewist</span> }
                    @if (_statusOpen)
                    {
                        <div class="status-popover">
                            <div class="status-popover-kop">
                                <button class="knopje" @onclick="StatusAlles">alles</button>
                                <button class="knopje" @onclick="StatusGeen">geen</button>
                                <button class="knopje" @onclick="StatusStandaard" title="Alles behalve de eindstatus">standaard</button>
                                <span style="flex:1"></span>
                                <button class="knopje" @onclick="() => _statusOpen = false">✕</button>
                            </div>
                            @foreach (var s in Lijst("Status"))
                            {
                                var id = s.Id;
                                <label class="vink status-keuze" @key="id">
                                    <input type="checkbox" checked="@_statusFilter.Contains(id)" @onchange="e => ZetStatusFilter(id, e)" />
                                    <span>@s.Naam</span><small class="uitleg">@AantalMetStatus(id)</small>
                                </label>
                            }
                            <label class="vink status-keuze">
                                <input type="checkbox" checked="@_statusFilter.Contains(0)" @onchange="e => ZetStatusFilter(0, e)" />
                                <span>(geen status)</span><small class="uitleg">@AantalMetStatus(0)</small>
                            </label>
                            <hr />
                            <label class="vink status-keuze" title="Zacht gewiste exemplaren (isDeleted) ook tonen">
                                <input type="checkbox" checked="@_inclGewist" @onchange="GewistGewijzigd" />
                                <span>ook gewiste exemplaren</span>
                            </label>
                        </div>
                    }
                </div>
                <div class="wn-namen kort product-exemplaren">
                    @if (_naamId is null)
                    {
                        <div class="kiezer-info">Kies eerst een producttype.</div>
                    }
                    else if (_producten.Count == 0)
                    {
                        <div class="kiezer-info">@(_alleProducten.Count > 0 ? $"Geen exemplaren met de gekozen status ({_alleProducten.Count} verborgen)." : "Nog geen exemplaren.")</div>
                    }
                    else
                    {
                        @foreach (var p in _producten)
                        {
                            <div class="mail-regel @(p.Id == _productId ? "actief" : "")" @key="p.Id">
                                <input type="checkbox" title="Selecteren voor een groepsbewerking (Shift-klik: reeks)"
                                       checked="@_gekozen.Contains(p.Id)" @onclick="e => VinkKlik(p, e)" />
                                <button class="wn-naam exemplaar-regel @(p.Gewist ? "vervallen" : "")"
                                        @onclick="e => RegelKlik(p, e)" title="@RegelTitel(p)">
                                    <span class="nummer">@p.Serienummer</span>
                                    <span class="stat">@p.StatusKort</span>
                                    <span class="klant">@p.Klant</span>
                                    <span class="project">@p.Project</span>
                                </button>
                            </div>
                        }
                    }
                </div>
                <div class="btngroep-rand">
                    <button class="klein" disabled="@(_naamId is null)" @onclick="NieuwProduct">+ Exemplaar</button>
                    <input class="aantal" type="number" min="1" max="100" title="Hoeveel exemplaren"
                           value="@_nieuwAantal" @onchange="AantalGewijzigd" />
                    @if (_product is not null && _product.Gewist)
                    {
                        <button class="klein" @onclick="Terugzetten">↺ Terugzetten</button>
                    }
                    else
                    {
                        <button class="klein rood" disabled="@(_productId is null)" @onclick="WisProduct">✕ Wissen</button>
                    }
                </div>

                @if (_producten.Count > 0)
                {
                    <div class="btngroep-rand">
                        <button class="klein" @onclick="AllesAanUit">
                            @(_gekozen.Count == _producten.Count ? "Geen" : "Alles")
                        </button>
                        @if (_gekozen.Count > 0)
                        {
                            <span class="uitleg">@_gekozen.Count geselecteerd</span>
                        }
                    </div>
                }

                @if (_gekozen.Count > 0)
                {
                    <div class="groepsblok">
                        <div class="wn-veld">
                            <label>Status</label>
                            <select @key="_groepTeller" value="" @onchange="GroepStatus">
                                <option value="">— wijzig naar —</option>
                                @foreach (var s in Lijst("Status"))
                                {
                                    <option value="@s.Id">@s.Naam</option>
                                }
                            </select>
                        </div>
                        <div class="wn-veld">
                            <label>Klant</label>
                            <select @key="_groepTeller" value="" @onchange="GroepKlant">
                                <option value="">— wijzig naar —</option>
                                @foreach (var k in Lijst("Klant"))
                                {
                                    <option value="@k.Id">@k.Naam</option>
                                }
                            </select>
                        </div>
                        @if (_kolommen.Contains("Project"))
                        {
                            <div class="wn-veld">
                                <label>Project</label>
                                <span class="zoekregel">
                                    <input @key="_groepTeller" maxlength="100" placeholder="Projectnaam of -nummer"
                                           value="@_groepProject" @onchange="e => _groepProject = ((string?)e.Value ?? string.Empty).Trim()" />
                                    <button class="klein" @onclick="GroepProject">Toewijzen</button>
                                </span>
                            </div>
                        }
                        <div class="wn-veld">
                            <label>Werkorder</label>
                            <select @key="_groepTeller" value="" @onchange="GroepWerkorder">
                                <option value="">— koppel aan —</option>
                                @foreach (var w in Lijst("Werkorder"))
                                {
                                    <option value="@w.Id">@w.Naam</option>
                                }
                            </select>
                        </div>
                        <div class="btngroup">
                            <button class="klein" @onclick="GroepLabels">🏷 Labels naar de laser</button>
                            <button class="klein rood" @onclick="GroepWissen">✕ Wissen</button>
                        </div>
                    </div>
                }
            </aside>

            @* ---------- rechts: type of exemplaar ---------- *@
            <section class="wn-detail">
                @if (_naamId is null)
                {
                    <div class="kiezer-info">Kies links een producttype, of scan een serienummer.</div>
                }
                else
                {
                    <div class="wn-tabs">
                        @if (_productId is not null)
                        {
                            <button class="terug" title="Terug naar het producttype" @onclick="TerugNaarType">↩ Type</button>
                        }
                        @foreach (var tab in Tabs)
                        {
                            <button class="@(tab == _tab ? "actief" : "")" @onclick="() => _tab = tab">@TabTitel(tab)</button>
                        }
                    </div>

                    @* ===== ALGEMEEN ===== *@
                    @if (_tab == "Algemeen")
                    {
                        <DetailMetZij>
                            <Hoofd>
                                @if (_productId is null)
                                {
                                    @* het producttype zelf *@
                                    <div class="wn-velden een-kolom">
                                        <div class="wn-veld">
                                            <label>Producttype</label>
                                            <select value="@NaamTypeTekst" @onchange="NaamTypeGewijzigd">
                                                <option value="">—</option>
                                                @foreach (var t in _types)
                                                {
                                                    <option value="@t.Id">@t.Naam</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="wn-veld">
                                            <label>Naam</label>
                                            <input value="@_naamNaam" maxlength="15" @onchange="NaamNaamGewijzigd" />
                                        </div>
                                        <div class="wn-veld">
                                            <label>Omschrijving</label>
                                            <input value="@_naamOms" maxlength="100" @onchange="NaamOmsGewijzigd" />
                                        </div>
                                        <div class="wn-veld">
                                            <label>Groep</label>
                                            <select value="@(_naam?.GroepId?.ToString() ?? string.Empty)" @onchange="GroepGewijzigd"
                                                    disabled="@(_groepen.Count == 0)" title="@GroepTitel">
                                                <option value="">—</option>
                                                @foreach (var g in _groepen)
                                                {
                                                    <option value="@g.Id">@g.Naam</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="wn-veld">
                                            <label>Artikel</label>
                                            <div class="prod-artikel">
                                                @if (_naam?.ArtikelId is int aid)
                                                {
                                                    <span class="stand-chip s-blauw" title="@_naam.ArtikelOmschrijving">#@aid @_naam.ArtikelCode</span>
                                                    <a class="knopje" href="artikelen?nr=@aid" target="_blank" rel="noopener" title="Openen in Artikelen (samenstelling)">Artikel openen ↗</a>
                                                    <button class="klein" title="Koppeling weghalen" @onclick="() => ZetArtikel(null)">✕</button>
                                                }
                                                <input value="@_artikelZoek" placeholder="@ArtikelPlaceholder" style="flex:1"
                                                       @oninput="ArtikelZoekGewijzigd" />
                                            </div>
                                            @if (_artikelZoek.Length >= 2)
                                            {
                                                <div class="prod-artikel-lijst">
                                                    @foreach (var a in _artikelTreffers)
                                                    {
                                                        <button class="klein" title="@a.Omschrijving" @onclick="() => ZetArtikel(a.Id)">#@a.Id @a.Code <small class="uitleg">@a.Omschrijving</small></button>
                                                    }
                                                    @if (_artikelTreffers.Count == 0)
                                                    {
                                                        <span class="uitleg">@(_artikelZoekt ? "zoeken…" : "geen artikel gevonden")</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <p class="uitleg">
                                        Dit is het producttype. Groep (Motor, PCBA, Kabel) en artikel worden gebruikt in
                                        Productie ▸ Test PCB / Motor programmeren: het artikel wijst naar de samenstelling
                                        (bijvoorbeeld hoe een kabel is opgebouwd). Kies links een serienummer om een exemplaar
                                        te zien, met zijn eigen status, werkorder en historie.
                                    </p>
                                }
                                else
                                {
                                    <VeldRaster @key="_productId" Tab="ProductVelden.Tabs[0]" Kolommen="_kolommen" Velden="_velden"
                                                Lijsten="_lijsten" OpSlaan="Bewaar" />

                                    <h3 class="wn-kop">Typeplaatje</h3>
                                    <div class="label-blok">
                                        <img class="label-voorbeeld" src="@LabelUrl()" alt="Typeplaatje" />
                                        <div class="btngroup">
                                            <a class="knopje" href="@LabelUrl()" target="_blank">Bekijken</a>
                                            <a class="knopje" href="@LabelPdfUrl()" target="_blank">PDF openen</a>
                                            <button class="primair" disabled="@_laserBezig" @onclick="ExporteerLaser">
                                                @(_laserBezig ? "Bezig…" : "Naar de laser")
                                            </button>
                                            @if (Altec.Beschikbaar)
                                            {
                                                <input type="number" min="1" max="100" style="width:4rem"
                                                       title="Aantal labels" @bind="_altecAantal" />
                                                <button class="primair" disabled="@_altecBezig" @onclick="PrintAltec">
                                                    @(_altecBezig ? "Bezig…" : "Print label (Altec)")
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </Hoofd>
                            <Zij>
                                @if (_productId is null)
                                {
                                    <ZijBlok Titel="Standaardattributen" Aantal="_typeAttributen.Count"
                                             Meer="NaarAttributen"
                                             Leeg="@(_typeAttributen.Count == 0)" LeegTekst="Nog geen attributen.">
                                        @foreach (var a in _typeAttributen.Take(8))
                                        {
                                            <div class="zij-regel" @key="a.Id">
                                                <span class="zij-naam">@a.Attribuut</span>
                                                <span class="zij-extra">
                                                    @a.Eenheid
                                                    @if (a.Verplicht) { <text> · verplicht</text> }
                                                </span>
                                            </div>
                                        }
                                    </ZijBlok>
                                }
                                else
                                {
                                    <ZijBlok Titel="Laatste historie" Aantal="_historie.Count" Meer="NaarHistorie"
                                             Leeg="@(_historie.Count == 0)" LeegTekst="Nog geen historie.">
                                        @foreach (var h in _historie.Take(6))
                                        {
                                            <div class="zij-regel" @key="h.Id">
                                                <span class="zij-naam">@h.Event</span>
                                                <span class="zij-extra">
                                                    @(h.Wanneer?.ToString("dd-MM-yyyy HH:mm") ?? "")
                                                    @if (!string.IsNullOrWhiteSpace(h.Door)) { <text> · @h.Door</text> }
                                                </span>
                                            </div>
                                        }
                                    </ZijBlok>
                                    <ZijBlok Titel="Attributen" Aantal="_attributen.Count"
                                             Leeg="@(_attributen.Count == 0)" LeegTekst="Geen attributen.">
                                        @foreach (var a in _attributen.Take(10))
                                        {
                                            <div class="zij-regel" @key="a.Id">
                                                <span class="zij-naam">@a.Attribuut</span>
                                                <span class="zij-extra">
                                                    @(string.IsNullOrWhiteSpace(a.Waarde) ? "—" : a.Waarde) @a.Eenheid
                                                </span>
                                            </div>
                                        }
                                    </ZijBlok>
                                }
                            </Zij>
                        </DetailMetZij>
                    }

                    @* ===== HISTORIE (alleen bij een exemplaar) ===== *@
                    @if (_tab == "Historie")
                    {
                        <div class="tl-balk">
                            <input class="mail-zoek" placeholder="Wat is er gebeurd?" value="@_nieuwEvent"
                                   @onchange="NieuwEventGewijzigd" />
                            <select value="@HistorieSoortTekst" @onchange="HistorieSoortGewijzigd">
                                <option value="">— soort —</option>
                                @foreach (var s in _historieSoorten)
                                {
                                    <option value="@s.Id">@s.Naam</option>
                                }
                            </select>
                            <button class="primair" @onclick="VoegHistorieToe">+ Toevoegen</button>
                        </div>
                        <div class="tl-balk hist-filter">
                            <input class="mail-zoek" placeholder="🔍 Zoeken in historie (tekst, soort, door)…" value="@_histZoek"
                                   @oninput="e => _histZoek = (string?)e.Value ?? string.Empty" />
                            <select value="@_histSoortFilter" @onchange="e => _histSoortFilter = (string?)e.Value ?? string.Empty">
                                <option value="">alle soorten</option>
                                @foreach (var s in _historie.Select(h => h.Soort).Where(x => x.Length > 0).Distinct().OrderBy(x => x))
                                {
                                    <option value="@s">@s</option>
                                }
                            </select>
                            <select value="@_histUitkomst" @onchange="e => _histUitkomst = (string?)e.Value ?? string.Empty">
                                <option value="">alles</option>
                                <option value="ok">alleen geslaagd</option>
                                <option value="fout">alleen mislukt</option>
                            </select>
                            <label class="vink" title="Ook de historie van de gekoppelde halffabricaten (samenstelling, tot 3 niveaus diep) tonen">
                                <input type="checkbox" checked="@_histMetOnderdelen" @onchange="HistOnderdelenGewijzigd" /> incl. onderdelen
                            </label>
                            <span class="uitleg">@HistorieGefilterd.Count van @(_historie.Count + (_histMetOnderdelen ? _histOnderdelen.Count : 0))</span>
                            @if (_histZoek.Length > 0 || _histSoortFilter.Length > 0 || _histUitkomst.Length > 0)
                            {
                                <button class="klein" @onclick="() => { _histZoek = string.Empty; _histSoortFilter = string.Empty; _histUitkomst = string.Empty; }">✕ wissen</button>
                            }
                            @if (MagHistorieWissen && HistGekozen.Count > 0)
                            {
                                <button class="klein rood" @onclick="WisHistorie"
                                        title="De aangevinkte regels definitief uit de historie halen (alleen Directie)">🗑 @HistGekozen.Count regel(s) wissen…</button>
                            }
                        </div>

                        <table class="kiezer-tabel">
                            <thead>
                                <tr>
                                    @if (MagHistorieWissen)
                                    {
                                        <th style="width:2rem"><input type="checkbox" checked="@AlleHistGekozen" @onchange="KiesAlleHist"
                                                                      title="Alle getoonde regels aanvinken (combineer met het filter 'alleen mislukt')" /></th>
                                    }
                                    <th style="width:10rem">Wanneer</th>
                                    @if (_histMetOnderdelen) { <th style="width:12rem">Van</th> }
                                    <th style="width:10rem">Soort</th>
                                    <th>Gebeurtenis</th>
                                    <th style="width:11rem">Door</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in HistorieGefilterd)
                                {
                                    var hvan = _histVan.TryGetValue(h.Id, out var hvw) ? hvw : "";
                                    <tr @key="h.Id" class="@(h.Uitkomst is null ? "" : h.Uitkomst.Value ? "hist-ok" : "hist-fout") @(hvan.Length > 0 ? "hist-onderdeel" : "")">
                                        @if (MagHistorieWissen)
                                        {
                                            <td><input type="checkbox" checked="@_histGekozen.Contains(h.Id)" @onchange="e => KiesHist(h.Id, e)" /></td>
                                        }
                                        <td>@(h.Wanneer?.ToString("dd-MM-yyyy HH:mm") ?? "")</td>
                                        @if (_histMetOnderdelen) { <td><small class="@(hvan.Length > 0 ? "uitleg" : "")">@(hvan.Length > 0 ? hvan : "dit exemplaar")</small></td> }
                                        <td>@h.Soort</td>
                                        <td>@h.Event</td>
                                        <td>@h.Door</td>
                                    </tr>
                                }
                                @if (_historie.Count == 0)
                                {
                                    <tr><td colspan="@HistKolommen" class="kiezer-info">Nog geen historie.</td></tr>
                                }
                                else if (HistorieGefilterd.Count == 0)
                                {
                                    <tr><td colspan="@HistKolommen" class="kiezer-info">Niets gevonden voor dit filter.</td></tr>
                                }
                            </tbody>
                        </table>
                    }

                    @* ===== DOCUMENTEN ===== *@
                    @if (_tab == "Documenten")
                    {
                        <div class="tl-balk">
                            <label class="vink">
                                <input type="checkbox" checked="@_alleenNieuwste" @onchange="NieuwsteGewijzigd" />
                                Alleen nieuwste versies weergeven
                            </label>
                        </div>
                        <p class="uitleg">
                            @(_productId is null
                                ? "Documentatie van dit producttype — geldt voor alle exemplaren."
                                : "Documenten van dit exemplaar. De documentatie van het type staat op het tabblad van het producttype.")
                        </p>

                        <table class="kiezer-tabel">
                            <thead>
                                <tr>
                                    <th>Bestand</th>
                                    <th style="width:10rem">Toegevoegd</th>
                                    <th style="width:6rem" class="r">Dagen</th>
                                    <th style="width:11rem">Door</th>
                                    <th style="width:6rem"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in ZichtbareDocumenten())
                                {
                                    <tr @key="d.FileStoreId">
                                        <td>
                                            <button class="bestandnaam" title="Bekijken"
                                                    @onclick="() => ToonVoorbeeld(d.FileStoreId, d.Bestandsnaam)">
                                                @d.Bestandsnaam
                                            </button>
                                        </td>
                                        <td>@(d.Toegevoegd?.ToString("dd-MM-yyyy HH:mm") ?? "")</td>
                                        <td class="r">@DagenOud(d)</td>
                                        <td>@d.ToegevoegdDoor</td>
                                        <td class="c">
                                            <a class="knopje" href="@DownloadUrl(d.FileStoreId)"
                                               title="Downloaden">⭳</a>
                                            <button class="klein rood" title="Verwijderen"
                                                    @onclick="() => VerwijderDocument(d)">✕</button>
                                        </td>
                                    </tr>
                                }
                                @if (ZichtbareDocumenten().Count == 0)
                                {
                                    <tr><td colspan="5" class="kiezer-info">Nog geen documenten.</td></tr>
                                }
                            </tbody>
                        </table>

                        <div class="sleepzone @(_sleepActief ? "actief" : "")"
                             @ondragenter="() => _sleepActief = true"
                             @ondragleave="() => _sleepActief = false"
                             @ondragover:preventDefault="true">
                            <span>Sleep hier een bestand, of klik om te kiezen</span>
                            <InputFile OnChange="BestandenGekozen" multiple />
                        </div>
                    }

                    @* ===== SAMENSTELLING (alleen bij een exemplaar) ===== *@
                    @* ===== SAMENSTELLING van een producttype: de stuklijst (welke halffabricaten, hoeveel) ===== *@
                    @if (_tab == "Samenstelling" && _productId is null && _naamId is not null)
                    {
                        <p class="uitleg">
                            Welke halffabricaten er in dit product gaan en hoeveel. Bij het samenstellen van een exemplaar
                            (tab Samenstelling, en Productie ▸ Producten) worden dan alleen vrije exemplaren van precies deze
                            halffabricaten aangeboden en zie je wat er nog ontbreekt.
                        </p>
                        @if (!_heeftStuklijst)
                        {
                            <div class="melding fout">De tabel <code>ProductSamenstelling</code> ontbreekt nog: voer <code>ProductSamenstelling_MariaDB.sql</code> uit.</div>
                        }
                        <table class="kiezer-tabel">
                            <thead>
                                <tr>
                                    <th style="width:5rem">#</th>
                                    <th>Halffabricaat</th>
                                    <th style="width:6rem">Aantal</th>
                                    <th style="width:18rem">Opmerking</th>
                                    <th style="width:3rem"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < _stuklijst.Count; i++)
                                {
                                    var s = _stuklijst[i]; var idx = i;
                                    <tr @key="s.Id">
                                        <td class="opb-volgorde">
                                            <button class="klein" disabled="@(idx == 0)" title="Omhoog" @onclick="() => VerschuifStuklijst(s, -1)">▲</button>
                                            <button class="klein" disabled="@(idx == _stuklijst.Count - 1)" title="Omlaag" @onclick="() => VerschuifStuklijst(s, 1)">▼</button>
                                        </td>
                                        <td>
                                            <b>@s.OnderdeelNaam</b>
                                            @if (s.OnderdeelGroep.Length > 0) { <small class="uitleg"> · @s.OnderdeelGroep</small> }
                                            @if (s.OnderdeelOmschrijving.Length > 0) { <br /><small class="uitleg">@s.OnderdeelOmschrijving</small> }
                                        </td>
                                        <td><input type="number" min="1" max="999" value="@s.Aantal" style="width:4.5rem"
                                                   @onchange="e => ZetStuklijst(s, () => s.Aantal = int.TryParse((string?)e.Value, out var n) && n > 0 ? n : s.Aantal)" /></td>
                                        <td><input value="@s.Opmerking" maxlength="200" placeholder="bv. links/rechts"
                                                   @onchange="e => ZetStuklijst(s, () => s.Opmerking = (string?)e.Value ?? string.Empty)" /></td>
                                        <td class="c"><button class="klein rood" title="Uit de stuklijst" @onclick="() => VerwijderStuklijst(s)">✕</button></td>
                                    </tr>
                                }
                                @if (_stuklijst.Count == 0)
                                {
                                    <tr><td colspan="5" class="kiezer-info">Nog geen halffabricaten in de stuklijst.</td></tr>
                                }
                            </tbody>
                        </table>
                        <div class="bankfilters">
                            <label class="bankveld prod-keuze">
                                <span>Halffabricaat toevoegen (zoek op naam, omschrijving, groep)</span>
                                <input value="@_stuklijstZoek" placeholder="bv. PCBA, kabel, motor…" @oninput="StuklijstZoekGewijzigd" />
                            </label>
                        </div>
                        @if (_stuklijstTreffers.Count > 0)
                        {
                            <div class="wn-namen kort">
                                @foreach (var n in _stuklijstTreffers)
                                {
                                    <button class="wn-naam" @key="n.Id" @onclick="() => VoegStuklijstToe(n)">
                                        <span class="stat">@(n.Groep.Length > 0 ? n.Groep : n.TypeCode)</span>
                                        <b>@n.Naam</b> @n.Omschrijving
                                    </button>
                                }
                            </div>
                        }
                    }

                    @* ===== SAMENSTELLING van een exemplaar: koppelen volgens de stuklijst ===== *@
                    @if (_tab == "Samenstelling" && _naamId is int samNaam && _productId is int samProduct)
                    {
                        <h3 class="wn-kop">Gebruikt</h3>
                        <SamenstellingKiezer @key="samProduct" ProductNameId="samNaam" ProductId="samProduct" OpGewijzigd="NaSamenstellingWijziging" />
                        @if (_onderdelen.Count > 0)
                        {
                            <p class="uitleg">
                                Springen naar een onderdeel:
                                @foreach (var o in _onderdelen)
                                {
                                    <button class="klein" @key="o.ProductId" title="Naar dit exemplaar" @onclick="() => GaNaar(o)">↗ @o.Code @o.Serienummer</button>
                                }
                            </p>
                        }

                        <h3 class="wn-kop">Wordt gebruikt in</h3>
                        @if (_gebruiktIn is null)
                        {
                            <p class="uitleg">Dit exemplaar zit niet in een ander product.</p>
                        }
                        else
                        {
                            <table class="kiezer-tabel">
                                <tbody>
                                    <tr>
                                        <td style="width:11rem">@_gebruiktIn.Code</td>
                                        <td style="width:7rem">@_gebruiktIn.Serienummer</td>
                                        <td>@_gebruiktIn.Omschrijving</td>
                                        <td style="width:8rem">@_gebruiktIn.TypeCode</td>
                                        <td class="c" style="width:7rem">
                                            <button class="klein" @onclick="NaarOuder">↗ Goto</button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        }
                    }

                    @* ===== ATTRIBUTEN van een exemplaar: met waarde ===== *@
                    @if (_tab == "Attributen" && _productId is not null)
                    {
                        <table class="kiezer-tabel">
                            <thead>
                                <tr>
                                    <th>Attribuut</th>
                                    <th style="width:12rem">Waarde</th>
                                    <th style="width:6rem">Eenheid</th>
                                    <th>Opmerking</th>
                                    <th style="width:3rem"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in _attributen)
                                {
                                    <tr @key="a.Id" class="@(a.Verplicht && string.IsNullOrWhiteSpace(a.Waarde) ? "ontbreekt" : "")">
                                        <td>
                                            @a.Attribuut
                                            @if (a.Verplicht) { <span class="tl-vlag">verplicht</span> }
                                        </td>
                                        <td>
                                            <input value="@a.Waarde" maxlength="45"
                                                   @onchange="e => ZetWaarde(a, e)" />
                                        </td>
                                        <td>@a.Eenheid</td>
                                        <td>@a.Opmerking</td>
                                        <td class="c">
                                            <button class="klein rood" title="Verwijderen"
                                                    @onclick="() => VerwijderProductAttribuut(a)">✕</button>
                                        </td>
                                    </tr>
                                }
                                @if (_attributen.Count == 0)
                                {
                                    <tr><td colspan="5" class="kiezer-info">Geen attributen bij dit exemplaar.</td></tr>
                                }
                            </tbody>
                        </table>

                        <div class="btngroup">
                            <button class="klein" @onclick="SyncAttributen"
                                    title="Attributen die het producttype inmiddels heeft erbij halen">
                                ↻ Sync met producttype
                            </button>
                        </div>
                    }

                    @* ===== ATTRIBUTEN van een producttype: de standaardlijst ===== *@
                    @if (_tab == "Attributen" && _productId is null)
                    {
                        <p class="uitleg">
                            Deze attributen horen bij het producttype. Bij het aanmaken van een nieuw
                            exemplaar worden ze meegegeven, zodat je de waarden per exemplaar kunt vullen.
                            Met <i>Automatisch gevuld uit</i> vult Productie ▸ Test PCB het attribuut zelf
                            (serienummer van drive 1, 2, …, MAC van de ESP32, UID van de STM32); de naam
                            mag je vrij kiezen.
                        </p>
                        @if (_heeftBron == false)
                        {
                            <div class="melding fout">
                                De kolom <b>Bron</b> ontbreekt nog in de database: de keuze bij
                                <i>Automatisch gevuld uit</i> wordt niet bewaard. Voer
                                <code>ProductAttribuutBron_MariaDB.sql</code> uit en herstart de app.
                            </div>
                        }

                        <table class="kiezer-tabel">
                            <thead>
                                <tr>
                                    <th>Attribuut</th>
                                    <th style="width:6rem">Eenheid</th>
                                    <th>Opmerking</th>
                                    <th style="width:5rem">Verplicht</th>
                                    <th style="width:7rem" title="Wordt gevraagd bij het aanmaken">Bij aanmaak</th>
                                    <th style="width:15rem" title="Test PCB vult dit attribuut automatisch vanuit de werkplek-agent">Automatisch gevuld uit</th>
                                    <th style="width:3rem"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in _typeAttributen)
                                {
                                    <tr @key="a.Id">
                                        <td><input value="@a.Attribuut" maxlength="45" @onchange="e => ZetAttribuut(a, v => a.Attribuut = v, e)" /></td>
                                        <td><input value="@a.Eenheid" maxlength="10" @onchange="e => ZetAttribuut(a, v => a.Eenheid = v, e)" /></td>
                                        <td><input value="@a.Opmerking" maxlength="500" @onchange="e => ZetAttribuut(a, v => a.Opmerking = v, e)" /></td>
                                        <td class="c"><input type="checkbox" checked="@a.Verplicht"
                                                             @onchange="e => ZetAttribuutVlag(a, b => a.Verplicht = b, e)" /></td>
                                        <td class="c"><input type="checkbox" checked="@a.VraagBijAanmaak"
                                                             @onchange="e => ZetAttribuutVlag(a, b => a.VraagBijAanmaak = b, e)" /></td>
                                        <td>
                                            <select value="@a.Bron" @onchange="e => ZetAttribuut(a, v => a.Bron = v, e)"
                                                    class="@(a.Bron.Length > 0 ? "prod-bron-actief" : "")">
                                                @foreach (var b in AttribuutBronnen.Alle)
                                                {
                                                    <option value="@b.Code">@b.Omschrijving</option>
                                                }
                                            </select>
                                        </td>
                                        <td class="c">
                                            <button class="klein rood" title="Verwijderen"
                                                    @onclick="() => VerwijderAttribuut(a)">✕</button>
                                        </td>
                                    </tr>
                                }
                                @if (_typeAttributen.Count == 0)
                                {
                                    <tr><td colspan="7" class="kiezer-info">Nog geen attributen.</td></tr>
                                }
                            </tbody>
                        </table>

                        <div class="btngroup">
                            <button class="klein" @onclick="NieuwAttribuut">+ Attribuut toevoegen</button>
                        </div>
                    }

                    @* ===== PROGRAMMEREN van een exemplaar: uitlezen, programmeren, testen, duurtest — dezelfde
                       component als op de werkplek (Productie ▸ Half-fabricaten), zonder stapnummers. ===== *@
                    @if (_tab == "Programmeren" && _naam is not null && _product is not null && _productId is int progId)
                    {
                        <p class="uitleg">
                            Werkt via de MDE Werkplek-agent op déze pc (EtherCAT-adapter, USB). Opbouw en eindcontrole staan in hun eigen tabs.
                        </p>
                        <ExemplaarWerk @key="progId" Naam="_naam" Exemplaar="_product" ProductId="progId"
                                       MetNummers="false" ToonOpbouwStap="false" ToonDuurtestStap="IsEindproduct"
                                       OpGewijzigd="NaProgrammeerWijziging" OpGereed="NaProgrammeerGereed" />
                    }

                    @* ===== OPBOUW: de stappen (bij het type: beheren; bij een exemplaar: afvinken) ===== *@
                    @if (_tab is "Opbouw" or "Eindcheck")
                    {
                        @if (_opbouwOntbreekt)
                        {
                            <div class="melding fout">De opbouw-tabellen ontbreken nog: voer <code>ProductOpbouw_MariaDB.sql</code> uit (en 330 in FileStoreType).</div>
                        }
                        else if (!_heeftSoort)
                        {
                            <div class="melding fout">
                                De kolom <code>Soort</code> ontbreekt nog in <code>ProductOpbouwStappen</code>; daardoor komt alles onder Opbouw terecht.
                                Voer uit: <code>ALTER TABLE `ProductOpbouwStappen` ADD COLUMN IF NOT EXISTS `Soort` VARCHAR(12) NOT NULL DEFAULT 'opbouw' AFTER `Volgorde`;</code>
                            </div>
                        }
                        @if (!_opbouwOntbreekt)
                        {
                        @if (_productId is null)
                        {
                            var soort = _tab == "Eindcheck" ? OpbouwSoort.Controle : OpbouwSoort.Opbouw;
                            var lijst = _stappen.Where(s => s.Soort == soort).ToList();
                            <p class="uitleg">
                                @if (soort == OpbouwSoort.Controle)
                                {
                                    <text>De handmatige eindcheck vóór het gereedmelden. Bij een exemplaar wordt elke check afgevinkt;
                                    zijn alle checks en verplichte opbouwstappen klaar, dan kan de status op 'Gereed'.</text>
                                }
                                else
                                {
                                    <text>De opbouwvolgorde van dit producttype: Mechanische opbouw, Elektrische opbouw, Parameters
                                    inschieten, Testen … Per stap kun je documenten met hands-on uitleg toevoegen. Bij een exemplaar
                                    worden de stappen afgevinkt; elke wijziging komt in de historie.</text>
                                }
                            </p>
                            <table class="kiezer-tabel opb-tabel">
                                <thead>
                                    <tr>
                                        <th style="width:5rem">#</th>
                                        <th style="width:18rem">@(soort == OpbouwSoort.Controle ? "Check" : "Stap")</th>
                                        <th>Omschrijving</th>
                                        <th style="width:6rem">Verplicht</th>
                                        <th style="width:12rem">Documenten</th>
                                        <th style="width:3rem"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < lijst.Count; i++)
                                    {
                                        var s = lijst[i]; var idx = i;
                                        <tr @key="s.Id">
                                            <td class="opb-volgorde">
                                                <button class="klein" disabled="@(idx == 0)" title="Omhoog" @onclick="() => Verschuif(s, -1)">▲</button>
                                                <button class="klein" disabled="@(idx == lijst.Count - 1)" title="Omlaag" @onclick="() => Verschuif(s, 1)">▼</button>
                                            </td>
                                            <td><input value="@s.Naam" maxlength="80" @onchange="e => ZetStap(s, () => s.Naam = (string?)e.Value ?? string.Empty)" /></td>
                                            <td><input value="@s.Omschrijving" maxlength="500" @onchange="e => ZetStap(s, () => s.Omschrijving = (string?)e.Value ?? string.Empty)" /></td>
                                            <td class="c"><input type="checkbox" checked="@s.Verplicht" @onchange="e => ZetStap(s, () => s.Verplicht = e.Value is bool b && b)" /></td>
                                            <td>
                                                <button class="klein" @onclick="() => ToonStapDocs(s)">📎 @s.AantalDocumenten</button>
                                            </td>
                                            <td class="c"><button class="klein rood" title="Stap verwijderen" @onclick="() => VerwijderStap(s)">✕</button></td>
                                        </tr>
                                        @if (_stapDocs == s.Id)
                                        {
                                            <tr @key="@($"{s.Id}-docs")" class="opb-docs">
                                                <td></td>
                                                <td colspan="5">
                                                    @foreach (var d in _stapDocumenten)
                                                    {
                                                        <span class="opb-doc">
                                                            <a href="@("bestand/" + d.FileStoreId)" target="_blank" rel="noopener">@d.Bestandsnaam</a>
                                                            <a class="knopje" href="@DownloadUrl(d.FileStoreId)" title="Downloaden">⬇</a>
                                                            <button class="klein rood" title="Verwijderen" @onclick="() => VerwijderStapDoc(d)">✕</button>
                                                        </span>
                                                    }
                                                    <InputFile OnChange="e => UploadStapDoc(s, e)" multiple />
                                                </td>
                                            </tr>
                                        }
                                    }
                                    @if (lijst.Count == 0)
                                    {
                                        <tr><td colspan="6" class="kiezer-info">@(soort == OpbouwSoort.Controle ? "Nog geen controles." : "Nog geen stappen.")</td></tr>
                                    }
                                </tbody>
                            </table>
                            <div class="btngroup">
                                <button class="klein" @onclick="() => NieuweStap(soort)">@(soort == OpbouwSoort.Controle ? "+ Check" : "+ Stap")</button>
                            </div>
                        }
                        else if (_naamId is int nid && _productId is int pid)
                        {
                            <p class="uitleg">Vink af wat klaar is; elke wijziging komt in de historie van dit exemplaar.</p>
                            <OpbouwLijst @key="_tab" ProductNameId="nid" ProductId="pid" HuidigeStatus="@(_product?.StatusKort ?? "")"
                                         ToonOpbouw="TabIsOpbouw" ToonControle="TabIsEindcheck" OpGewijzigd="NaOpbouwWijziging" />
                        }
                        }
                    }

                    @* ===== TECHNIEK van een halffabricaat: wat zit erop, drives, parametersets ===== *@
                    @if (_tab == "Techniek" && _productId is null)
                    {
                        <p class="uitleg">
                            Wat er op deze print zit bepaalt welke stappen Productie ▸ Test PCB aanbiedt:
                            uitlezen/firmware/parameters/IO-test voor drives, chip programmeren voor ESP32 en STM32.
                        </p>
                        <div class="prod-techniek">
                            @foreach (var t in ProductTechniek.Alle)
                            {
                                var code = t.Code;
                                <label class="prod-techniek-vink" title="@t.Uitleg">
                                    <input type="checkbox" checked="@_technieken.Contains(code)" @onchange="e => ZetTechniek(code, e)" />
                                    <b>@t.Naam</b> <small class="uitleg">@t.Uitleg</small>
                                </label>
                                @if (code == ProductTechniek.Drives && _technieken.Contains(ProductTechniek.Drives))
                                {
                                    <label class="prod-techniek-vink prod-techniek-sub" title="Uit = op deze print wordt alleen firmware geladen; de keuze en knop voor parametersets verdwijnen uit Programmeren">
                                        <input type="checkbox" checked="@MetParameters" @onchange="ZetMetParameters" />
                                        <b>Parametersets laden</b> <small class="uitleg">per positie een parameterset (.xcf / .json) bij de firmware; uit als deze print alleen firmware krijgt</small>
                                    </label>
                                    <label class="prod-techniek-vink prod-techniek-sub" title="Voor eigen MDE-prints: het serienummer van het exemplaar in de EEPROM van de ESC zetten (SII 0x0E), zodat de print zijn eigen nummer meldt">
                                        <input type="checkbox" checked="@_technieken.Contains(ProductTechniek.SerienummerSchrijven)" @onchange="e => ZetTechniek(ProductTechniek.SerienummerSchrijven, e)" />
                                        <b>Serienummer schrijven</b> <small class="uitleg">het serienummer van het exemplaar in de EEPROM van de eigen MDE-slave zetten (knop in Programmeren)</small>
                                    </label>
                                    <label class="prod-techniek-vink prod-techniek-sub" title="Voor eigen MDE-prints met een lege of verkeerde EEPROM: de complete EEPROM-inhoud (PDI/SPI, identiteit, mailboxen, PDO's) uit het ESI van het controllertype schrijven, zoals TwinCAT 'Write EEPROM'">
                                        <input type="checkbox" checked="@_technieken.Contains(ProductTechniek.EepromVullen)" @onchange="e => ZetTechniek(ProductTechniek.EepromVullen, e)" />
                                        <b>EEPROM vullen uit ESI</b> <small class="uitleg">nieuwe print met lege EEPROM: PDI (SPI), fabrikant, productcode, revisie, serienummer, mailboxen en PDO's uit het ESI</small>
                                    </label>
                                    <label class="prod-techniek-vink prod-techniek-sub" title="Knop Objecten in Programmeren: de complete objectdictionary van de slave lezen en losse SDO's lezen/schrijven">
                                        <input type="checkbox" checked="@_technieken.Contains(ProductTechniek.Objecten)" @onchange="e => ZetTechniek(ProductTechniek.Objecten, e)" />
                                        <b>Objecten</b> <small class="uitleg">objectdictionary lezen en losse SDO's lezen/schrijven (eigen MDE-slave, eRob)</small>
                                    </label>
                                    <label class="prod-techniek-vink prod-techniek-sub" title="Knop Monitoring in Programmeren: objecten van de eigen MDE-slave live volgen in een grafiek, alleen lezen">
                                        <input type="checkbox" checked="@_technieken.Contains(ProductTechniek.Monitoring)" @onchange="e => ZetTechniek(ProductTechniek.Monitoring, e)" />
                                        <b>Monitoring</b> <small class="uitleg">objecten van de eigen MDE-slave live volgen (druk, joints, statusword …), alleen lezen</small>
                                    </label>
                                }
                            }
                        </div>
                        @if (_drvOntbreekt)
                        {
                            <div class="melding fout">De drive-tabellen ontbreken nog: voer <code>DriveTypen_MariaDB.sql</code> en <code>ProductTechniek_MariaDB.sql</code> uit.</div>
                        }

                        <h4 class="prod-subkop">Stappen in Half-fabricaten en Producten</h4>
                        <p class="uitleg">
                            Welke onderdelen de productieschermen tonen voor dit producttype. Een kabel hoeft niet
                            geprogrammeerd of automatisch getest te worden — vink die stappen dan uit; de handmatige eindcheck
                            (tab Eindcheck) blijft beschikbaar in 'Opbouw en eindcontrole'. Zonder techniek verdwijnen
                            Programmeren en Testen sowieso. Niet elk product gaat de testrig in: zet dan 'Stap Duurtest' uit.
                        </p>
                        <div class="prod-techniek">
                            @foreach (var s in ProductStap.Alle)
                            {
                                var code = s.Code;
                                <label class="prod-techniek-vink" title="@s.Uitleg">
                                    <input type="checkbox" checked="@(_naam?.ToonStap(code) ?? true)" @onchange="e => ZetStapZichtbaar(code, e)" />
                                    <b>@s.Naam</b> <small class="uitleg">@s.Uitleg</small>
                                </label>
                            }
                        </div>
                    }
                    @if (_tab == "Techniek" && _productId is null && (HeeftDrivesOfServo || HeeftChip))
                    {
                        <p class="uitleg">
                            @if (HeeftChip && !HeeftDrivesOfServo)
                            {
                                <text>Voor een chip: maak één positie met het controllertype (bv. 'ESP32 (alle varianten)' of 'STM32 …').
                                De firmwareversies (.hex/.bin) met status staan bij dat type onder Productie ▸ Controllertypen en firmware;
                                in Half-fabricaten ▸ stap 4 wordt de actuele versie voorgeselecteerd.</text>
                            }
                            else if (_technieken.Contains(ProductTechniek.Feetech))
                            {
                                <text>Voor een servo: maak één positie (1) met het controllertype (bv. Feetech STS3215) en koppel daaraan de
                                parameterset (.json) bij de firmwareversie van de servo. Sjabloon: MdeAgent\voorbeelden\feetech-sts3215.json.</text>
                            }
                            else
                            {
                                <text>Welke slaves er op deze print zitten (per positie op de EtherCAT-bus) en welke
                                parameterset erin moet (.xcf voor Ingenia-drives, .json met SDO's voor eRob en MDE-slaves) — die hoort
                                bij een firmwareversie, want elke firmware heeft haar eigen set. Het firmwarebestand zelf staat bij
                                Productie ▸ Controllertypen.</text>
                            }
                        </p>

                        <h4 class="prod-subkop">Posities</h4>
                        <table class="kiezer-tabel drv-posities">
                            <thead>
                                <tr>
                                    <th style="width:5rem">Positie</th>
                                    <th style="width:12rem">Naam</th>
                                    <th>Verwacht controllertype</th>
                                    <th style="width:4rem"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in _posities)
                                {
                                    <tr @key="p.Id">
                                        <td><input type="number" min="1" max="16" value="@p.Positie"
                                                   @onchange="e => ZetPositie(p, () => p.Positie = int.TryParse((string?)e.Value, out var n) ? n : p.Positie)" /></td>
                                        <td><input value="@p.Naam" placeholder="bv. R-as" @onchange="e => ZetPositie(p, () => p.Naam = (string?)e.Value ?? string.Empty)" /></td>
                                        <td>
                                            <select value="@(p.DriveTypeId?.ToString() ?? string.Empty)"
                                                    @onchange="e => ZetPositie(p, () => p.DriveTypeId = int.TryParse((string?)e.Value, out var t) ? t : null)">
                                                <option value="">— niet controleren —</option>
                                                @foreach (var t in TypenVoorProduct)
                                                {
                                                    <option value="@t.Id">@t.Naam (@t.ProductCode)</option>
                                                }
                                            </select>
                                        </td>
                                        <td class="c"><button class="klein rood" @onclick="() => VerwijderPositie(p)">✕</button></td>
                                    </tr>
                                }
                                @if (_posities.Count == 0)
                                {
                                    <tr><td colspan="4" class="kiezer-info">Nog geen posities. Voeg er één toe per drive op de print.</td></tr>
                                }
                            </tbody>
                        </table>
                        <div class="btngroup">
                            <button class="klein" @onclick="NieuwePositie">+ Positie</button>
                            @if (HeeftChip && !HeeftDrivesOfServo)
                            {
                                <a class="knopje" href="productie/drivetypen">Controllertypen en firmware beheren ↗</a>
                            }
                        </div>
                    }
                    @if (_tab == "Techniek" && _productId is null && HeeftDrivesOfServo && (MetParameters || _technieken.Contains(ProductTechniek.Feetech)))
                    {
                        <h4 class="prod-subkop">Parametersets</h4>
                        <div class="drv-params-wrap">
                        <table class="kiezer-tabel drv-params">
                            <thead>
                                <tr>
                                    <th style="width:8rem">Positie</th>
                                    <th>Firmwareversie</th>
                                    <th style="width:11rem">Omschrijving</th>
                                    <th title="De parameterset zelf: .xcf voor Ingenia-drives, .json (SDO's of Feetech-registers) voor eRob, MDE-slaves en servo's. Het firmwarebestand staat bij Controllertypen.">Parameterbestand (.xcf / .json)</th>
                                    <th style="width:7rem">Status</th>
                                    <th style="width:4rem"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @* Vaste volgorde (aanmaakvolgorde), zodat een regel niet verspringt als je de positie of firmware wijzigt. *@
                                @foreach (var ps in _parametersets.OrderBy(x => x.Id))
                                {
                                    var extensie = _driveTypen.FirstOrDefault(t => t.Naam == ps.DriveTypeNaam)?.Protocol is null or DriveProtocol.EtherCat ? ".xcf" : ".json";
                                    <tr @key="ps.Id" class="drv-rij">
                                        <td>
                                            <select value="@ps.Positie" @onchange="e => ZetParam(ps, () => ps.Positie = int.TryParse((string?)e.Value, out var n) ? n : ps.Positie)">
                                                @foreach (var p in _posities.OrderBy(p => p.Positie))
                                                {
                                                    <option value="@p.Positie">@p.Positie @(p.Naam.Length > 0 ? "· " + p.Naam : "")</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <select value="@ps.DriveFirmwareId" @onchange="e => ZetParam(ps, () => ps.DriveFirmwareId = int.TryParse((string?)e.Value, out var f) ? f : ps.DriveFirmwareId)">
                                                @foreach (var f in _alleFirmwares)
                                                {
                                                    <option value="@f.Id">@f.TypeNaam · @f.Versie (@f.Status)</option>
                                                }
                                            </select>
                                        </td>
                                        <td><input value="@ps.Omschrijving" placeholder="bv. R_drive A v0.0.2"
                                                   @onchange="e => ZetParam(ps, () => ps.Omschrijving = (string?)e.Value ?? string.Empty)" /></td>
                                        <td>
                                            @if (ps.ParameterFileId is int fid)
                                            {
                                                <a class="knopje" href="@DownloadUrl(fid)" target="_blank" rel="noopener">⬇ @ps.ParameterBestand</a>
                                                <button class="klein" title="Vervangen" @onclick="() => _drvVervang = ps.Id">↻</button>
                                                @if (_drvVervang == ps.Id)
                                                {
                                                    <InputFile OnChange="e => UploadParam(ps, e)" accept=".xcf,.json" />
                                                }
                                            }
                                            else
                                            {
                                                <InputFile OnChange="e => UploadParam(ps, e)" accept=".xcf,.json" />
                                                <small class="uitleg">@extensie</small>
                                            }
                                        </td>
                                        <td>
                                            <select value="@ps.Status" class="drv-status @DriveStatus.Kleur(ps.Status)"
                                                    @onchange="e => ZetParam(ps, () => ps.Status = (string?)e.Value ?? DriveStatus.Actueel)">
                                                @foreach (var s in DriveStatus.Parameters)
                                                {
                                                    <option value="@s.Code">@s.Tekst</option>
                                                }
                                            </select>
                                        </td>
                                        <td class="c drv-knoppen">
                                            @if (IsFeetechSet(ps))
                                            {
                                                <button class="klein" title="Registers bewerken in de app" @onclick="() => _editorPs = ps">✎</button>
                                            }
                                            <button class="klein rood" title="Parameterset verwijderen" @onclick="() => VerwijderParam(ps)">✕</button>
                                        </td>
                                    </tr>
                                    <tr @key="@($"{ps.Id}-opm")" class="drv-opm">
                                        <td colspan="6">
                                            <input value="@ps.Opmerking" placeholder="Opmerking bij deze parameterset…"
                                                   @onchange="e => ZetParam(ps, () => ps.Opmerking = (string?)e.Value ?? string.Empty)" />
                                        </td>
                                    </tr>
                                }
                                @if (_parametersets.Count == 0)
                                {
                                    <tr><td colspan="6" class="kiezer-info">Nog geen parametersets.</td></tr>
                                }
                            </tbody>
                        </table>
                        </div>
                        <div class="btngroup">
                            <button class="klein" disabled="@(_posities.Count == 0 || _alleFirmwares.Count == 0)" @onclick="NieuweParam"
                                    title="@(_alleFirmwares.Count == 0 ? "Maak eerst een firmwareversie aan bij Productie ▸ Drivetypen" : "")">+ Parameterset</button>
                            @if (_technieken.Contains(ProductTechniek.Feetech))
                            {
                                <button class="klein" disabled="@(_posities.Count == 0 || _alleFirmwares.Count == 0)" @onclick="NieuweFeetechSet"
                                        title="Een Feetech-parameterset maken uit het sjabloon en meteen bewerken — geen JSON-bestand nodig">+ Feetech-set uit sjabloon…</button>
                            }
                            <a class="knopje" href="productie/drivetypen">Drivetypen en firmware beheren ↗</a>
                        </div>
                    }
                }
            </section>
        </div>
    }

</div>

<BestandVoorbeeld Id="_voorbeeldId" Naam="_voorbeeldNaam" Sluiten="SluitVoorbeeld" />
<FeetechParamEditor Open="@(_editorPs is not null)" Parameterset="_editorPs"
                    OpSluiten="() => _editorPs = null" OpOpgeslagen="EditorOpgeslagen" />

@code {
    // ---- lijst links ----
    private string _zoek = "";
    private string _scan = "";
    private int _scanTeller;
    private int? _typeId;
    private List<Keuze> _types = new();
    private List<ProductNaam> _namen = new();

    // ---- gekozen producttype ----
    private int? _naamId;
    private ProductNaam? _naam;
    private string _naamNaam = "";
    private string _naamOms = "";
    private int? _naamTypeId;
    private List<ProductAttribuut> _typeAttributen = new();

    // ---- gekozen exemplaar ----
    private bool _inclGewist;
    private List<ProductRegel> _producten = new();
    private int? _productId;
    private ProductRegel? _product;
    private HashSet<string> _kolommen = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, object?> _velden = new(StringComparer.OrdinalIgnoreCase);
    private List<ProductGebeurtenis> _historie = new();
    private List<ProductAttribuut> _attributen = new();

    // ---- samenstelling ----
    private List<SamenstellingRegel> _onderdelen = new();
    private SamenstellingRegel? _gebruiktIn;
    private string _vrijZoek = "";
    private List<SamenstellingRegel> _vrije = new();

    // ---- documenten ----
    private List<Bestand> _documenten = new();
    private bool _alleenNieuwste = true;
    private bool _sleepActief;

    // ---- overig ----
    private Dictionary<string, List<Keuze>> _lijsten = new();
    private static readonly List<Keuze> GeenLijst = new();
    private List<Keuze> _historieSoorten = new();
    private string _tab = "Algemeen";
    private string _nieuwEvent = "";
    private int _nieuwAantal = 1;
    private int? _historieSoortId;
    private string? _melding;
    private bool _fout;

    private List<Keuze> Lijst(string naam) => _lijsten.TryGetValue(naam, out var l) ? l : GeenLijst;

    /// <summary>
    /// Bij een producttype drie tabbladen (zoals in Access), bij een exemplaar vijf.
    /// </summary>
    private bool TabIsOpbouw => _tab == "Opbouw";
    private bool TabIsEindcheck => _tab == "Eindcheck";

    /// <summary>Opschrift van een tab; de interne naam blijft 'Programmeren' (per-pc onthouden, URL's).</summary>
    private static string TabTitel(string tab) => tab == "Programmeren" ? "Programmeren en testen" : tab;

    private string[] Tabs => _productId is null
        ? new[] { "Algemeen", "Documenten", "Attributen", "Samenstelling", "Opbouw", "Eindcheck", "Techniek" }
        : Agent.Aanwezig == true && Ik.Werkplek?.Productie != false
            ? new[] { "Algemeen", "Historie", "Documenten", "Samenstelling", "Attributen", "Programmeren", "Opbouw", "Eindcheck" }
            : new[] { "Algemeen", "Historie", "Documenten", "Samenstelling", "Attributen", "Opbouw", "Eindcheck" };   // zonder werkplek-agent op deze pc geen Programmeren

    private string Titel
    {
        get
        {
            if (_naam is null) return "Producten";
            if (_product is null) return _naam.Volledig;
            return $"{_naam.Naam} · {_product.Serienummer}";
        }
    }

    private string TypeTekst => _typeId is int t ? t.ToString() : "";
    private string NaamTypeTekst => _naamTypeId is int t ? t.ToString() : "";
    private string HistorieSoortTekst => _historieSoortId is int s ? s.ToString() : "";

    private static string BekijkUrl(int id) => "bestand/" + id;
    private static string DownloadUrl(int id) => "bestand/" + id + "/download";

    protected override async Task OnInitializedAsync()
    {
        await Ik.ZorgGeladenAsync();
        if (!Repo.Beschikbaar) return;

        try
        {
            _kolommen = await Repo.KolommenAsync();

            await Vul("Status", Repo.GetStatussenAsync);
            try { _okStatusIds = await Repo.GetStatusIdsMetNaamAsync(OkStatusNaam); } catch { }
            await Vul("Artikel", Repo.GetArtikelenAsync);
            await Vul("Klant", Repo.GetKlantenAsync);
            await Vul("Werkorder", WerkordersAsync);
            await Vul("ProductNaam", ProductnamenLijstAsync);

            try { _types = await Repo.GetProducttypesAsync(); } catch { }
            try { _historieSoorten = await Repo.GetHistorieSoortenAsync(); } catch { }
            try { _groepen = await Repo.GetProductgroepenAsync(); } catch { }

            await LaadNamen();
        }
        catch (Exception ex) { Toon("Ophalen mislukt: " + ex.Message, true); }
    }

    private async Task Vul(string naam, Func<Task<List<Keuze>>> ophalen)
    {
        try { _lijsten[naam] = await ophalen(); }
        catch { _lijsten[naam] = new List<Keuze>(); }
    }

    // ================================================================
    //  Groepsbewerkingen
    //  Elke wijziging schrijft per exemplaar een eigen historieregel, zodat je
    //  later bij dat ene product ziet wat er is gebeurd — niet alleen dat er
    //  ooit een groep is bijgewerkt.
    // ================================================================
    private readonly HashSet<int> _gekozen = new();

    /// <summary>Loopt op na elke groepskeuze, zodat de keuzelijst weer op '—' springt.</summary>
    private int _groepTeller;

    /// <summary>Het exemplaar waar een Shift-klik vanaf telt: de laatst aangeklikte regel of het laatste vinkje.</summary>
    private int? _anker;

    /// <summary>Vinkje: gewone klik zet dit exemplaar aan/uit, Shift-klik de hele reeks vanaf het anker.</summary>
    private void VinkKlik(ProductRegel p, MouseEventArgs e)
    {
        var aan = !_gekozen.Contains(p.Id);
        if (e.ShiftKey && ZetReeks(p, aan)) return;
        if (aan) _gekozen.Add(p.Id); else _gekozen.Remove(p.Id);
        _anker = p.Id;
    }

    /// <summary>Regel: gewone klik opent het exemplaar, Shift-klik selecteert de reeks, Ctrl-klik zet hem aan/uit.</summary>
    private async Task RegelKlik(ProductRegel p, MouseEventArgs e)
    {
        if (e.ShiftKey)
        {
            if (!ZetReeks(p, true)) { _gekozen.Add(p.Id); _anker = p.Id; }
            return;
        }
        if (e.CtrlKey || e.MetaKey)
        {
            if (!_gekozen.Remove(p.Id)) _gekozen.Add(p.Id);
            _anker = p.Id;
            return;
        }
        _anker = p.Id;
        await KiesProduct(p);
    }

    /// <summary>Alles tussen het anker en dit exemplaar (in de getoonde volgorde) aan of uit. False zonder bruikbaar anker.</summary>
    private bool ZetReeks(ProductRegel p, bool aan)
    {
        var van = _producten.FindIndex(x => x.Id == _anker);
        var tot = _producten.FindIndex(x => x.Id == p.Id);
        if (van < 0 || tot < 0) return false;
        for (var i = Math.Min(van, tot); i <= Math.Max(van, tot); i++)
            if (aan) _gekozen.Add(_producten[i].Id); else _gekozen.Remove(_producten[i].Id);
        return true;
    }

    private void AllesAanUit()
    {
        if (_gekozen.Count == _producten.Count) _gekozen.Clear();
        else foreach (var p in _producten) _gekozen.Add(p.Id);
    }

    private void AantalGewijzigd(ChangeEventArgs e)
        => _nieuwAantal = int.TryParse((string?)e.Value, out var v) ? Math.Clamp(v, 1, 100) : 1;

    /// <summary>Serienummers van de selectie, voor de bevestigingsvraag.</summary>
    private string GekozenTekst()
    {
        var nummers = _producten.Where(p => _gekozen.Contains(p.Id))
                                .Select(p => p.Serienummer)
                                .ToList();
        return nummers.Count <= 6
            ? string.Join(", ", nummers)
            : string.Join(", ", nummers.Take(6)) + $" en nog {nummers.Count - 6}";
    }

    private async Task GroepStatus(ChangeEventArgs e)
    {
        if (!int.TryParse((string?)e.Value, out var statusId)) return;
        _groepTeller++;
        var naam = Lijst("Status").FirstOrDefault(s => s.Id == statusId)?.Naam ?? statusId.ToString();

        if (!await Bevestig($"Status van {_gekozen.Count} exemplaar/exemplaren op '{naam}' zetten?\n\n"
                            + GekozenTekst())) return;

        await GroepVeld("ProductStatusID", statusId, $"Status gewijzigd naar {naam}.");
    }

    private async Task GroepKlant(ChangeEventArgs e)
    {
        if (!int.TryParse((string?)e.Value, out var klantId)) return;
        _groepTeller++;
        var naam = Lijst("Klant").FirstOrDefault(k => k.Id == klantId)?.Naam ?? klantId.ToString();

        if (!await Bevestig($"Klant van {_gekozen.Count} exemplaar/exemplaren op '{naam}' zetten?\n\n"
                            + GekozenTekst())) return;

        await GroepVeld("KlantID", klantId, $"Klant gewijzigd naar {naam}.");
    }

    // ---- project (vrije tekst) voor de aangevinkte exemplaren ----
    private string _groepProject = "";

    private async Task GroepProject()
    {
        var project = _groepProject.Trim();
        var vraag = project.Length == 0
            ? $"Het project leegmaken bij {_gekozen.Count} exemplaar/exemplaren?\n\n" + GekozenTekst()
            : $"Project '{project}' toewijzen aan {_gekozen.Count} exemplaar/exemplaren?\n\n" + GekozenTekst();
        if (!await Bevestig(vraag)) return;

        _groepTeller++;
        await GroepVeld("Project", project.Length == 0 ? null : project,
                        project.Length == 0 ? "Project leeggemaakt." : $"Project gewijzigd naar {project}.");
        _groepProject = "";
    }

    private static string RegelTitel(ProductRegel p)
        => string.Join(" · ", new[] { p.Serienummer, p.StatusKort, p.Klant, p.Project }.Where(s => s.Length > 0));

    private async Task GroepWerkorder(ChangeEventArgs e)
    {
        if (!int.TryParse((string?)e.Value, out var werkorderId)) return;
        _groepTeller++;
        var naam = Lijst("Werkorder").FirstOrDefault(w => w.Id == werkorderId)?.Naam ?? werkorderId.ToString();

        if (!await Bevestig($"{_gekozen.Count} exemplaar/exemplaren koppelen aan {naam}?\n\n"
                            + GekozenTekst())) return;

        await GroepVeld("WorkorderID", werkorderId, $"Gekoppeld aan werkorder {naam}.");
    }

    private async Task GroepVeld(string kolom, object? waarde, string historie)
    {
        try
        {
            var ids = _gekozen.ToList();
            await Repo.WijzigVeldVoorAsync(ids, kolom, waarde);

            foreach (var id in ids)
                await Repo.VoegHistorieToeAsync(id, historie, ProductVelden.HistorieLevensloop, Ik.WerknemerId);

            _gekozen.Clear();
            await LaadProducten();

            if (_productId is not null)
            {
                _velden = await Repo.GetVeldenAsync(_productId.Value);
                _historie = await Repo.GetHistorieAsync(_productId.Value);
            }
            Toon($"{ids.Count} exemplaar/exemplaren bijgewerkt.", false);
        }
        catch (Exception ex) { Toon("Bijwerken mislukt: " + ex.Message, true); }
    }

    private async Task GroepWissen()
    {
        if (!await Bevestig($"{_gekozen.Count} exemplaar/exemplaren wissen?\n\n" + GekozenTekst() +
                            "\n\nZe verdwijnen uit de lijst maar blijven met historie bewaard.")) return;

        try
        {
            // al gewiste exemplaren overslaan: anders krijgen ze een tweede regel
            var ids = _producten.Where(p => _gekozen.Contains(p.Id) && !p.Gewist)
                                .Select(p => p.Id).ToList();
            if (ids.Count == 0) { Toon("Er staat niets in de selectie dat nog gewist kan worden.", true); return; }

            foreach (var id in ids)
            {
                await Repo.ZetGewistAsync(id, true);
                await Repo.VoegHistorieToeAsync(id, "Product gewist.",
                                                ProductVelden.HistorieLevensloop, Ik.WerknemerId);
            }

            _gekozen.Clear();
            if (_productId is not null && ids.Contains(_productId.Value)) LeegmakenProduct();
            await LaadProducten();
            await LaadDocumenten();
            Toon($"{ids.Count} exemplaar/exemplaren gewist.", false);
        }
        catch (Exception ex) { Toon("Wissen mislukt: " + ex.Message, true); }
    }

    /// <summary>Alle geselecteerde typeplaatjes op één vel naar de laser.</summary>
    private async Task GroepLabels()
    {
        try
        {
            var labels = new List<(string Type, string Serienummer, string Bouwjaar, string Code)>();
            foreach (var id in _gekozen.OrderBy(i => i))
            {
                var g = await Repo.GetLabelGegevensAsync(id);
                if (g is null) continue;
                labels.Add((g.Value.Type, g.Value.Serienummer, g.Value.Bouwjaar, LabelService.CodeVoor(id)));
            }

            if (labels.Count == 0) { Toon("Geen gegevens gevonden voor deze exemplaren.", true); return; }

            var pad = await Labels.ExporteerAsync(Labels.MaakVelSvg(labels));

            foreach (var id in _gekozen)
                await Repo.VoegHistorieToeAsync(id, "Typeplaatje geëxporteerd naar de laser.",
                                                ProductVelden.HistorieLevensloop, Ik.WerknemerId);

            if (_productId is not null) _historie = await Repo.GetHistorieAsync(_productId.Value);
            Toon($"{labels.Count} typeplaatjes klaargezet: {pad}", false);
        }
        catch (Exception ex) { Toon("Exporteren mislukt: " + ex.Message, true); }
    }

    /// <summary>Open werkorders voor de keuzelijst, met het nummer vooraan.</summary>
    private async Task<List<Keuze>> WerkordersAsync()
    {
        var lijst = await Uren.GetOpenWorkordersAsync();
        return lijst.Select(w => new Keuze(w.WerkbonId, $"{w.Nummer} · {w.Omschrijving}")).ToList();
    }

    private async Task<List<Keuze>> ProductnamenLijstAsync()
    {
        var lijst = await Repo.ZoekProductnamenAsync(null, null);
        return lijst.Select(n => new Keuze(n.Id, n.Volledig)).ToList();
    }

    // ================================================================
    //  Lijst links
    // ================================================================
    private async Task LaadNamen(bool kiesBijEen = false)
    {
        try { _namen = await Repo.ZoekProductnamenAsync(_zoek, _typeId); }
        catch (Exception ex) { _namen = new(); Toon("Zoeken mislukt: " + ex.Message, true); return; }

        if (kiesBijEen && _namen.Count == 1) { await KiesNaam(_namen[0]); return; }
        if (kiesBijEen) Leegmaken();
    }

    private void Leegmaken()
    {
        _naamId = null;
        _naam = null;
        _naamNaam = "";
        _naamOms = "";
        _naamTypeId = null;
        _typeAttributen = new();
        _producten = new();
        _gekozen.Clear();
        LeegmakenProduct();
        _documenten = new();
        _tab = "Algemeen";
    }

    private void LeegmakenProduct()
    {
        _productId = null;
        _product = null;
        _velden = new(StringComparer.OrdinalIgnoreCase);
        _historie = new();
        _attributen = new();
        _onderdelen = new();
        _gebruiktIn = null;
        _vrije = new();
        _vrijZoek = "";

        // Tabbladen verschillen per stand; sta je op een tabblad dat nu niet
        // bestaat, dan terug naar Algemeen.
        if (!Tabs.Contains(_tab)) _tab = "Algemeen";
    }

    private async Task ZoekGewijzigd(ChangeEventArgs e)
    {
        _zoek = (string?)e.Value ?? "";
        await LaadNamen(kiesBijEen: true);
    }

    private async Task WisZoek()
    {
        _zoek = "";
        Leegmaken();
        await LaadNamen();
    }

    private async Task TypeGewijzigd(ChangeEventArgs e)
    {
        _typeId = int.TryParse((string?)e.Value, out var v) ? v : null;
        // Ander type = andere wereld: groepfilter los, en de eerste uit de lijst openen.
        _groepFilter = null;
        Leegmaken();
        await LaadNamen();
        await KiesEerste();
        // Onthouden per toestel (localStorage): de volgende keer staat hetzelfde type voor.
        try { await JS.InvokeVoidAsync("localStorage.setItem", TypeSleutel, TypeTekst); } catch { }
    }

    private const string TypeSleutel = "mde-producten-type";
    private bool _typeHersteld;

    /// <summary>
    /// De laatst gekozen producttype terugzetten. Kan pas na de eerste render:
    /// eerder is er nog geen verbinding met de browser voor localStorage.
    /// </summary>
    private bool _agentGecontroleerd;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Tab Programmeren alleen op een pc met de werkplek-agent; één keer controleren (de layout doet dat meestal al).
        if (!_agentGecontroleerd && Repo.Beschikbaar)
        {
            _agentGecontroleerd = true;
            var had = Agent.Aanwezig;
            try { await Agent.ControleerAsync(JS); } catch { }
            if (had != Agent.Aanwezig) StateHasChanged();
        }

        // Niet aan firstRender hangen: de eerste render komt vóór de typelijst geladen
        // is. Pas als _types gevuld is kunnen we de bewaarde keuze controleren.
        if (_typeHersteld || !Repo.Beschikbaar || _types.Count == 0) return;
        _typeHersteld = true;
        try
        {
            // filters van de exemplarenlijst, per pc onthouden
            _inclGewist = await JS.InvokeAsync<string?>("mdeOpslag.lees", GewistSleutel) == "1";
            var statussen = await JS.InvokeAsync<string?>("mdeOpslag.lees", StatusSleutel);
            if (!string.IsNullOrWhiteSpace(statussen))
                _statusFilter = statussen.Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(t => int.TryParse(t, out var v) ? v : -1).Where(v => v >= 0).ToHashSet();
            else
                StatusStandaardZetten();
            _statusFilterGeladen = true;
            if (_naamId is not null) { await LaadProducten(); StateHasChanged(); }

            var bewaard = await JS.InvokeAsync<string?>("localStorage.getItem", TypeSleutel);
            if (int.TryParse(bewaard, out var id) && _types.Any(t => t.Id == id) && _typeId != id)
            {
                _typeId = id;
                await LaadNamen();
                StateHasChanged();
            }
        }
        catch { }

        // Geopend vanuit een ander scherm (producten?naam=…&product=…): dat type en exemplaar tonen.
        if (NaamQuery is not null || ProductQuery is not null)
        {
            await OpenUitUrl();
            StateHasChanged();
        }
    }

    /// <summary>ProductNameID uit de URL (?naam=), bv. vanuit Productie ▸ Producten.</summary>
    [SupplyParameterFromQuery(Name = "naam")] public int? NaamQuery { get; set; }
    /// <summary>ProductenID uit de URL (?product=): het exemplaar openen.</summary>
    [SupplyParameterFromQuery(Name = "product")] public int? ProductQuery { get; set; }

    private async Task OpenUitUrl()
    {
        try
        {
            var naamId = NaamQuery;
            if (naamId is null && ProductQuery is int pq)
            {
                // Alleen een exemplaar meegegeven: het type erbij zoeken.
                var velden = await Repo.GetVeldenAsync(pq);
                if (velden.TryGetValue("ProductNameID", out var v) && v is not null && int.TryParse(v.ToString(), out var n)) naamId = n;
            }
            if (naamId is null) return;

            var naam = _namen.FirstOrDefault(n => n.Id == naamId);
            if (naam is null)
            {
                // buiten het huidige filter: filters wissen en opnieuw zoeken
                _zoek = ""; _typeId = null; _groepFilter = null;
                await LaadNamen();
                naam = _namen.FirstOrDefault(n => n.Id == naamId);
            }
            if (naam is null) { Toon($"Producttype #{naamId} niet gevonden.", true); return; }
            await KiesNaam(naam);

            if (ProductQuery is not int pid) return;
            var regel = await ZoekInLijst(pid);
            if (regel is null) { Toon($"Exemplaar #{pid} niet gevonden.", true); return; }
            await KiesProduct(regel);
        }
        catch (Exception ex) { Toon("Openen mislukt: " + ex.Message, true); }
    }

    /// <summary>Serienummer scannen of typen: zoekt het exemplaar op en opent het.</summary>
    private async Task ScanGewijzigd(ChangeEventArgs e)
    {
        _scan = (string?)e.Value ?? "";
        if (string.IsNullOrWhiteSpace(_scan)) return;

        try
        {
            var gevonden = await Repo.ZoekOpSerienummerAsync(_scan);
            if (gevonden is null) { Toon($"Geen product met serienummer '{_scan}'.", true); return; }

            var naam = _namen.FirstOrDefault(n => n.Id == gevonden.Value.ProductNameId);
            if (naam is null)
            {
                // buiten het huidige filter: filters wissen en opnieuw zoeken
                _zoek = "";
                _typeId = null;
                await LaadNamen();
                naam = _namen.FirstOrDefault(n => n.Id == gevonden.Value.ProductNameId);
            }
            if (naam is null) { Toon("Het producttype van dit exemplaar is niet gevonden.", true); return; }

            await KiesNaam(naam);

            var regel = await ZoekInLijst(gevonden.Value.ProductId);
            if (regel is null) { Toon("Het exemplaar is niet gevonden.", true); return; }
            await KiesProduct(regel);
            _scan = "";
            _scanTeller++;      // veld leegmaken in de browser
        }
        catch (Exception ex) { Toon("Zoeken mislukt: " + ex.Message, true); }
    }

    private async Task GewistGewijzigd(ChangeEventArgs e)
    {
        _inclGewist = e.Value is bool b && b;
        try { await JS.InvokeVoidAsync("mdeOpslag.schrijf", GewistSleutel, _inclGewist ? "1" : "0"); } catch { }
        await LaadProducten();
    }

    // Statusfilter van de exemplarenlijst (meerkeuze; 0 = zonder status). Standaard alles behalve
    // de eindstatus (Productie:OkStatus, meestal 'OK') — wie hier werkt is met de laatst geproduceerde
    // bezig. De keuze wordt per pc onthouden.
    private const string GewistSleutel = "mde-producten-inclgewist";
    private const string StatusSleutel = "mde-producten-statussen";
    private HashSet<int> _statusFilter = new();
    private bool _statusFilterGeladen;
    private bool _statusOpen;
    private List<ProductRegel> _alleProducten = new();     // ongefilterd (voor de aantallen per status)
    private string OkStatusNaam => Config["Productie:OkStatus"] ?? "OK";
    private HashSet<int> _okStatusIds = new();               // uit de tabel: Status óf StatusShort = OkStatusNaam
    private bool IsOkStatus(Keuze s)
    {
        if (_okStatusIds.Contains(s.Id)) return true;
        var n = s.Naam.Trim();
        return n.Equals(OkStatusNaam, StringComparison.OrdinalIgnoreCase)
            || n.EndsWith(" " + OkStatusNaam, StringComparison.OrdinalIgnoreCase);   // 'n - OK' met nummer ervoor
    }

    private string StatusFilterTekst
    {
        get
        {
            var alle = Lijst("Status");
            var totaal = alle.Count + 1;   // + (geen status)
            var gekozen = _statusFilter.Count(id => id == 0 || alle.Any(s => s.Id == id));
            if (gekozen == 0) return "geen";
            if (gekozen >= totaal) return "alle";
            var uit = alle.Where(s => !_statusFilter.Contains(s.Id)).Select(s => s.Naam.Trim()).ToList();
            if (!_statusFilter.Contains(0)) uit.Add("geen status");
            return uit.Count <= 2 ? "alle behalve " + string.Join(", ", uit) : $"{gekozen} van {totaal}";
        }
    }

    private int AantalMetStatus(int id) => _alleProducten.Count(p => (p.StatusId ?? 0) == id);
    private bool StatusZichtbaar(ProductRegel p) => _statusFilter.Contains(p.StatusId ?? 0);

    /// <summary>Standaard: alles behalve de eindstatus.</summary>
    private void StatusStandaardZetten()
    {
        _statusFilter = Lijst("Status").Where(s => !IsOkStatus(s)).Select(s => s.Id).ToHashSet();
        _statusFilter.Add(0);
    }

    private async Task StatusBewaar()
    {
        try { await JS.InvokeVoidAsync("mdeOpslag.schrijf", StatusSleutel, string.Join(",", _statusFilter.OrderBy(i => i))); } catch { }
        await LaadProducten();
    }

    private async Task ZetStatusFilter(int id, ChangeEventArgs e)
    {
        if (e.Value is bool b && b) _statusFilter.Add(id); else _statusFilter.Remove(id);
        await StatusBewaar();
    }

    private async Task StatusAlles()
    {
        _statusFilter = Lijst("Status").Select(s => s.Id).ToHashSet();
        _statusFilter.Add(0);
        await StatusBewaar();
    }

    private async Task StatusGeen() { _statusFilter = new(); await StatusBewaar(); }

    private async Task StatusStandaard() { StatusStandaardZetten(); await StatusBewaar(); }

    /// <summary>Nieuwste boven: op serienummer als getal, anders als tekst.</summary>
    private static IEnumerable<ProductRegel> NieuwsteBoven(IEnumerable<ProductRegel> lijst)
        => lijst.OrderByDescending(p => long.TryParse(new string(p.Serienummer.Where(char.IsDigit).ToArray()), out var n) ? n : -1)
                .ThenByDescending(p => p.Serienummer, StringComparer.OrdinalIgnoreCase);

