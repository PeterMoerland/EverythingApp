    private async Task VerwijderPositie(DrivePositie p)
    {
        if (!await Bevestig($"Positie {p.Positie} ({p.Naam}) verwijderen?")) return;
        try { await Drives.VerwijderPositieAsync(p.Id); if (_naamId is int n) await LaadDrives(n); }
        catch (Exception ex) { Toon("Verwijderen mislukt: " + ex.Message, true); }
    }

    private async Task NieuweParam()
    {
        if (_naamId is null || _posities.Count == 0 || _alleFirmwares.Count == 0) return;
        try
        {
            // Standaard: eerste positie en de actuele firmware van het verwachte type als die er is.
            var pos = _posities.OrderBy(p => p.Positie).First();
            var typeNaam = pos.DriveTypeNaam;
            var fw = _alleFirmwares.FirstOrDefault(f => f.TypeNaam == typeNaam && f.Status == DriveStatus.Actueel);
            if (fw.Id == 0) fw = _alleFirmwares.First();
            await Drives.BewaarParametersetAsync(new DriveParameterset
            {
                ProductNameId = _naamId.Value, Positie = pos.Positie, DriveFirmwareId = fw.Id, Status = DriveStatus.Actueel
            }, Ik.WerknemerId);
            await LaadDrives(_naamId.Value);
        }
        catch (Exception ex) { Toon("Toevoegen mislukt: " + ex.Message, true); }
    }

