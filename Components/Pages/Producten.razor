    {
        if (_stapDocs == s.Id) { _stapDocs = null; return; }
        _stapDocs = s.Id;
        try { _stapDocumenten = await WnRepo.GetBestandenAsync(OpbouwStore.Stap, s.Id); } catch { _stapDocumenten = new(); }
