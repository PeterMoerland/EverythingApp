    private bool _laserBezig;

    /// <summary>?v= verandert mee met de gegevens, zodat het voorbeeld ververst.</summary>
    private string LabelUrl() => $"label/{_productId}?v={_labelVersie}";
    private string LabelPdfUrl() => $"label/{_productId}/pdf?v={_labelVersie}";
    private int _labelVersie;

    private async Task ExporteerLaser()
    {
        if (_productId is null) return;

        _laserBezig = true;
        StateHasChanged();
        try
        {
            var gegevens = await Repo.GetLabelGegevensAsync(_productId.Value);
            if (gegevens is null) { Toon("Product niet gevonden.", true); return; }

            var svg = Labels.MaakSvg(gegevens.Value.Type, gegevens.Value.Serienummer,
                                     gegevens.Value.Bouwjaar, LabelService.CodeVoor(_productId.Value));
            var pad = await Labels.ExporteerAsync(svg);

            await Repo.VoegHistorieToeAsync(_productId.Value, "Typeplaatje geëxporteerd naar de laser.",
                                            ProductVelden.HistorieLevensloop, Ik.WerknemerId);
            _historie = await Repo.GetHistorieAsync(_productId.Value);
            Toon($"Klaargezet voor de laser: {pad}", false);
        }
        catch (Exception ex) { Toon("Exporteren mislukt: " + ex.Message, true); }
        finally { _laserBezig = false; }
    }

    // ================================================================
    //  Serienummerlabel naar de Altec-labelprinter
    // ================================================================

    private bool _altecBezig;
    private int _altecAantal = 1;

    private async Task PrintAltec()
    {
        if (_productId is null) return;

        _altecBezig = true;
        StateHasChanged();
        try
        {
            var gegevens = await Repo.GetLabelGegevensAsync(_productId.Value);
            if (gegevens is null) { Toon("Product niet gevonden.", true); return; }

            var aantal = Math.Clamp(_altecAantal, 1, 100);
            await Altec.PrintSerienummerAsync(gegevens.Value.Serienummer, aantal);

            await Repo.VoegHistorieToeAsync(_productId.Value,
                $"Serienummerlabel geprint op de Altec ({aantal}×).",
                ProductVelden.HistorieLevensloop, Ik.WerknemerId);
            _historie = await Repo.GetHistorieAsync(_productId.Value);
            Toon($"{aantal} label{(aantal == 1 ? "" : "s")} naar de labelprinter gestuurd.", false);
        }
        catch (Exception ex) { Toon("Printen mislukt: " + ex.Message, true); }
        finally { _altecBezig = false; }
    }

