@page "/module/{Sleutel}"
@inject HuidigeGebruiker Ik
@inject SnelIconen Iconen

@if (_module is null)
{
    <div class="page">
        <header class="topbar"><h1>Onbekende module</h1></header>
        <section class="module-placeholder">
            <p>Deze module bestaat niet. Kies er een in de zijbalk.</p>
        </section>
    </div>
}
else
{
    <div class="page">
        <header class="topbar">
            <h1>
                @if (_boven is not null)
                {
                    <span class="kruimel">@_boven.Naam ▸</span>
                }
                @_module.Naam
            </h1>
        </header>

        @* Financiën: vragen stellen aan de AI (Components/AiVraagInvoer.razor) *@
        @if (_module.Sleutel == "financien" && Ik.MagFinancien)
        {
            <AiVraagInvoer />
        }

        @* Een klapper zoals Tools heeft zelf geen schermen: dan de pakketten als tegels *@
        @if (_module.HeeftOnder)
        {
            <section class="groep">
                <h2>Pakketten</h2>
                <div class="groep-items">
                    @foreach (var onder in _module.Onder)
                    {
                        <a class="tegel klaar" href="@onder.Adres">
                            <span class="tegel-icoon">@Svg(onder.Icoon)</span>
                            <span class="tegel-tekst"><span class="tegel-label">@Afbreekbaar(onder.Naam)</span></span>
                        </a>
                    }
                </div>
            </section>
        }

        <div class="groepen">
            @foreach (var groep in _module.Groepen)
            {
                var items = groep.Items.Where(Zichtbaar).ToList();
                @if (items.Count > 0)
                {
                    <section class="groep">
                        <h2>@groep.Naam</h2>
                        <div class="groep-items">
                            @foreach (var item in items)
                            {
                                <a class="tegel klaar" href="@item.Url.TrimStart('/')">
                                    <span class="tegel-icoon">@Svg(item.Icoon ?? _module.Icoon)</span>
                                    <span class="tegel-tekst"><span class="tegel-label">@Afbreekbaar(item.Label)</span></span>
                                </a>
                            }
                        </div>
                    </section>
                }
            }
        </div>

    </div>
}

@code {
    /// <summary>Icoon van een tegel (Lucide, Menu.cs); onbekend = niets.</summary>
    private MarkupString Svg(string? naam) => new(Iconen.MenuSvg(naam) ?? "");

    /// <summary>
    /// Lange samenstellingen in een tegel netjes laten afbreken (melding gebruiker 10-11-2026: "Geheimhoudingsovereenkomsten"
    /// liep over de rand). De browser heeft niet altijd een Nederlands afbreekwoordenboek, dus een zacht afbreekstreepje na
    /// de tussen-s van -ings, -heids en -teits (alleen in de tegel; het menulabel en zoeken blijven zoals ze zijn).
    /// </summary>
    private static string Afbreekbaar(string label)
        => System.Text.RegularExpressions.Regex.Replace(label, @"(?<=\p{L}{4}(?:ings|heids|teits))(?=\p{L}{5})", "\u00AD");

    [Parameter] public string? Sleutel { get; set; }

    private MenuModule? _module;
    private MenuModule? _boven;

    protected override async Task OnParametersSetAsync()
    {
        await Ik.ZorgGeladenAsync();
        _module = Menu.Zoek(Sleutel);
        _boven = Menu.Boven(Sleutel);
    }

    // Alleen tegels met een scherm in de app (besluit gebruiker 12-11-2026): de grijze "in Access"-tegels zijn weg; ze staan
    // nog in Menu.cs (zonder Url) en worden pas gebouwd als daar behoefte aan is.
    // Zolang er geen rechten in de database staan, alles laten zien.
    // Directie ziet ook de tegels met het recht Financial (de schermen zelf laten Directie al toe).
    private bool Zichtbaar(MenuItem item)
        => item.Klaar && Mag(item);

    private bool Mag(MenuItem item)
        => item.Recht is null || !Ik.Gekoppeld || Ik.Mag(item.Recht) || (item.Recht == "Financial" && Ik.MagFinancien)
           || (item.Recht == "Budgetverantwoordelijke" && Ik.Mag("Directie"))    // welkomstscherm: ook Directie
           || (item.Recht == "Fusion" && Ik.MagFusion)
           || (item.Recht == "Verkoop" && Ik.MagVerkoop);                        // Verkooporders: ook Directie                          // Fusion: ook Directie

}
