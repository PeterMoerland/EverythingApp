@page "/financien/liquiditeit"
@inject ILiquiditeitRepository Repo
@inject IVasteLastenRepository VasteLasten
@inject HuidigeGebruiker Ik
@inject IJSRuntime JS
@inject IBvStructuurRepository Structuur
@inject NavigationManager Nav
@implements IAsyncDisposable

@* Overgezet van Access' Report_LiquiditeitsOverzicht en de formulieren 'Liquiditeit Te laat
   inkomend/uitgaand'. Alleen lezen. Rekenregels in Services/Liquiditeitsrekenaar.cs.
   BV kiezen in de boom van de MDE-groep (wens gebruiker 9-11-2026, Financiën > BV-structuur): een BV, of met "met
   dochters" ook alles eronder (standaard MDE Holding met dochters). Tellen mee: de bankrekeningen, openstaande facturen
   en btw van die BV's, en de vaste lasten van die BV's (VasteLasten.BvID). Facturen tussen de gekozen BV's tellen niet
   mee (geld binnen de groep). Zonder vastgelegde structuur: de oude knoppen (alleen MDE-groep, niet opgeheven). *@

<div class="page">
    <header class="topbar">
        <h1>Liquiditeitsoverzicht</h1>
        @if (_p is not null)
        {
            <span class="weeklabel">vanaf het banksaldo van @_p.Start.ToString("dd-MM-yyyy") · @_dagen dagen vooruit</span>
        }
    </header>

    @if (!Repo.Beschikbaar)
    {
        <section class="module-placeholder"><p>Dit scherm werkt alleen met de live database.</p></section>
    }
    else
    {
        @if (_melding is not null)
        {
            <div class="melding fout" @onclick="() => _melding = null">@_melding</div>
        }

        <div class="bankfilters">
            @if (_boom.Count > 0)
            {
                <div class="bankveld lq-bvkeuze">
                    <span>BV <small class="zij-extra">(klik een BV)</small></span>
                    <div class="bvs-org lq-org" @ref="_org">
                        @foreach (var laag in _boom)
                        {
                            <div class="bvs-laag">
                                @foreach (var b in laag)
                                {
                                    <button class="bvs-kaart @(b.Id == _kern ? "actief" : "") @(_gekozen.Contains(b.Id) ? "mee" : "")" data-bv="@b.Id"
                                            title="@b.Naam" @onclick="() => KiesKern(b.Id)">
                                        <span class="bvs-naam">@b.Kort</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <label class="vink" title="Ook alle BV's onder de gekozen BV meetellen (de groep vanaf die BV)">
                        <input type="checkbox" checked="@_metDochters" @onchange="DochtersGewijzigd" /> met dochters
                    </label>
                </div>
            }
            else
            {
                <div class="bankveld">
                    <span>BV's</span>
                    <div class="btngroup">
                        @foreach (var bv in _bvs)
                        {
                            <button class="klein @(_gekozen.Contains(bv.Id) ? "actief" : "")" @key="bv.Id" title="@bv.Naam"
                                    @onclick="() => WisselBv(bv.Id)">@(_gekozen.Contains(bv.Id) ? "✓ " : "")@(bv.Afkorting.Length > 0 ? bv.Afkorting : bv.Naam)</button>
                        }
                        <button class="klein" title="Terug naar alle BV's van de MDE-groep" @onclick="StandaardBvs">Alle</button>
                    </div>
                </div>
            }
            <label class="bankveld">
                <span>Periode</span>
                <select value="@_dagen" @onchange="PeriodeGewijzigd">
                    <option value="30">30 dagen</option>
                    <option value="60">60 dagen</option>
                    <option value="90">90 dagen</option>
                </select>
            </label>
            <div class="btngroup">
                <button class="klein" disabled="@_bezig" @onclick="Laad">@(_bezig ? "Bezig…" : "Vernieuwen")</button>
            </div>
        </div>

        @if (_p is not null)
        {
            <p class="uitleg lq-keuze">@KeuzeTekst()</p>

            @* ---------- kaarten ---------- *@
            <div class="lq-kaarten">
                <div class="lq-kaart" title="@RekeningenTekst()">
                    <span class="lq-label">Banksaldo @_p.Start.ToString("dd-MM")</span>
                    <span class="lq-getal">@Geld(_p.Beginsaldo)</span>
                    <span class="zij-extra">@_p.Rekeningen.Count rekeningen@(OudeRekeningen())</span>
                </div>
                <div class="lq-kaart klik" @onclick="() => _toonTeLaat = !_toonTeLaat">
                    <span class="lq-label">Te laat van klanten</span>
                    <span class="lq-getal lq-plus">+ @Geld(_p.TeLaatVanKlanten)</span>
                    <span class="zij-extra">@_p.TeLaatKlanten.Count facturen · klik voor de lijst</span>
                </div>
                <div class="lq-kaart klik" @onclick="() => _toonTeLaat = !_toonTeLaat">
                    <span class="lq-label">Te laat aan leveranciers</span>
                    <span class="lq-getal lq-min">− @Geld(_p.TeLaatAanLeveranciers)</span>
                    <span class="zij-extra">@_p.TeLaatLeveranciers.Count facturen · klik voor de lijst</span>
                </div>
                @foreach (var n in Mijlpalen)
                {
                    var dag = _p.Na(n);
                    @if (dag is not null)
                    {
                        <div class="lq-kaart" @key="n">
                            <span class="lq-label">Over @n dagen (@dag.Datum.ToString("dd-MM"))</span>
                            <span class="lq-getal @(dag.SaldoNaTeLaatLeveranciers < 0 ? "lq-min" : "")">@Geld(dag.SaldoNaTeLaatLeveranciers)</span>
                            <span class="zij-extra">incl. te laat van klanten @Geld(dag.SaldoInclTeLaatKlanten)</span>
                        </div>
                    }
                }
            </div>

            @* ---------- grafiek ---------- *@
            <div class="lq-grafiek">
                <div class="lq-grafiek-binnen">
                @* De bedragen van de y-as in HTML: tekst in de uitgerekte SVG zou vervormen. *@
                <div class="lq-yas">
                    @foreach (var waarde in Schaalstreepjes)
                    {
                        <span @key="waarde" style="top:@Getal(Y(waarde) / Hoogte * 100)%">@Geld(waarde)</span>
                    }
                </div>
                <svg viewBox="0 0 @Breedte @Hoogte" preserveAspectRatio="none" role="img"
                     aria-label="Verwacht saldo per dag">
                    @foreach (var waarde in Schaalstreepjes)
                    {
                        <line @key="waarde" x1="0" x2="@Breedte" y1="@Getal(Y(waarde))" y2="@Getal(Y(waarde))" class="lq-raster" />
                    }
                    @if (Nullijn is double nul)
                    {
                        <line x1="0" x2="@Breedte" y1="@Getal(nul)" y2="@Getal(nul)" class="lq-nul" />
                    }
                    <polyline points="@Lijn(d => d.SaldoInclTeLaatKlanten)" class="lq-lijn-incl" />
                    <polyline points="@Lijn(d => d.SaldoNaTeLaatLeveranciers)" class="lq-lijn" />
                    @for (var i = 0; i < _p.Dagen.Count; i++)
                    {
                        var dag = _p.Dagen[i];
                        var x = X(i);
                        <rect x="@Getal(x - Stap / 2)" y="0" width="@Getal(Stap)" height="@Hoogte"
                              class="lq-dagvlak @(dag.Datum == _dag ? "gekozen" : "")"
                              @onclick="() => KiesDag(dag.Datum)">
                            <title>@dag.Datum.ToString("ddd dd-MM", Nl): @Geld(dag.SaldoNaTeLaatLeveranciers)</title>
                        </rect>
                        @if (dag.Erbij + dag.Eraf > 0)
                        {
                            <circle cx="@Getal(x)" cy="@Getal(Y(dag.SaldoNaTeLaatLeveranciers))" r="3" class="lq-punt" />
                        }
                    }
                </svg>
                </div>
                <div class="lq-as">
                    <span>@_p.Start.AddDays(1).ToString("dd-MM")</span>
                    <span class="zij-extra">— saldo minus te laat aan leveranciers · - - plus te laat van klanten · klik een dag of gebruik ↑ ↓ in de lijst</span>
                    <span>@_p.Start.AddDays(_dagen).ToString("dd-MM")</span>
                </div>
            </div>

            @* ---------- details van een dag, of alle dagen met beweging ---------- *@
            <div class="lq-onder">
                @* tabindex: de lijst zelf krijgt de focus, zodat ↑ ↓ hier binnenkomen (zoals bij Bestellingen) *@
                <div id="lq-dagen" class="regels-omhulsel lq-dagen" tabindex="0"
                     @onkeydown="Toetsen" @onkeydown:preventDefault="_pijltje">
                    <table class="kiezer-tabel banktabel">
                        <thead>
                            <tr>
                                <th style="width:7rem">Datum</th>
                                <th style="width:8rem" class="r">Erbij</th>
                                <th style="width:8rem" class="r">Eraf</th>
                                <th style="width:9rem" class="r">Saldo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in _p.Dagen.Where(x => x.Erbij + x.Eraf > 0))
                            {
                                <tr @key="d.Datum" class="@(d.Datum == _dag ? "gekozen-rij actief" : "")" @onclick="() => KiesDag(d.Datum)">
                                    <td>@d.Datum.ToString("ddd dd-MM", Nl)</td>
                                    <td class="r">@(d.Erbij == 0 ? "" : Geld(d.Erbij))</td>
                                    <td class="r">@(d.Eraf == 0 ? "" : Geld(d.Eraf))</td>
                                    <td class="r @(d.SaldoNaTeLaatLeveranciers < 0 ? "factuur-telaat" : "")">@Geld(d.SaldoNaTeLaatLeveranciers)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <aside class="lq-details">
                    @if (_dag is DateOnly gekozenDag)
                    {
                        var vandaag = _p.Posten.Where(x => x.Datum == gekozenDag).ToList();
                        <h3 class="wn-kop">@gekozenDag.ToString("dddd d MMMM", Nl)</h3>
                        @if (vandaag.Count == 0)
                        {
                            <p class="kiezer-info">Op deze dag gebeurt er niets.</p>
                        }
                        else
                        {
                            @* Drie kolommen: wie, wat er binnenkomt (klanten) en wat eraf gaat (leveranciers,
                               vaste lasten, btw). Binnenkomend eerst. *@
                            <table class="kiezer-tabel lq-dagtabel">
                                <thead>
                                    <tr>
                                        <th>Relatie</th>
                                        <th style="width:7.5rem" class="r">Bij</th>
                                        <th style="width:7.5rem" class="r">Af</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var post in vandaag.OrderByDescending(x => x.Bedrag > 0).ThenByDescending(x => Math.Abs(x.Bedrag)))
                                    {
                                        <tr @key="post" class="@(Openbaar(post) ? "lq-open" : "")" title="@Uitleg(post)"
                                            @ondblclick="() => Open(post)">
                                            <td>
                                                @post.Relatie
                                                <span class="zij-extra">@post.Kenmerk</span>
                                            </td>
                                            <td class="r lq-plus">@(post.Bedrag > 0 ? Geld(post.Bedrag) : "")</td>
                                            <td class="r lq-min">@(post.Bedrag < 0 ? Geld(-post.Bedrag) : "")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td><b>Totaal</b> <span class="zij-extra">saldo @Geld(vandaag.Sum(x => x.Bedrag))</span></td>
                                        <td class="r lq-plus"><b>@Geld(vandaag.Where(x => x.Bedrag > 0).Sum(x => x.Bedrag))</b></td>
                                        <td class="r lq-min"><b>@Geld(-vandaag.Where(x => x.Bedrag < 0).Sum(x => x.Bedrag))</b></td>
                                    </tr>
                                </tfoot>
                            </table>
                        }
                    }
                    else
                    {
                        <p class="kiezer-info">Klik een dag in de grafiek of de lijst om te zien wat er die dag binnenkomt en afgaat.</p>
                    }
                </aside>
            </div>

            @* ---------- te laat ---------- *@
            @if (_toonTeLaat)
            {
                <div class="lq-onder">
                    @foreach (var (titel, lijst) in new[] { ("Te laat van klanten", _p.TeLaatKlanten), ("Te laat aan leveranciers", _p.TeLaatLeveranciers) })
                    {
                        <div class="regels-omhulsel" @key="titel">
                            <h3 class="wn-kop">@titel <span class="zij-extra">(@lijst.Count · @Geld(lijst.Sum(f => f.Bedrag)))</span></h3>
                            @* Doorklikken naar de factuur (wens gebruiker 10-11-2026): klik op het factuurnummer of dubbelklik
                               op de regel; verkoop opent het uitgaande-factuurvenster, inkoop het inkomende. *@
                            <table class="kiezer-tabel lq-telaat">
                                <thead>
                                    <tr>
                                        <th style="width:5.5rem">Vervallen</th>
                                        <th style="width:3.5rem" class="r">Dagen</th>
                                        <th>Relatie</th>
                                        <th style="width:9.5rem">Factuur</th>
                                        <th style="width:7rem" class="r">Bedrag</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var f in lijst.OrderBy(f => f.Vervaldatum))
                                    {
                                        <tr @key="(f.Verkoop, f.Id)" class="lq-open" title="Klik op de factuur (of dubbelklik) om hem te openen"
                                            @ondblclick="() => OpenFactuur(f)">
                                            <td>@f.Vervaldatum.ToString("dd-MM-yy")</td>
                                            <td class="r">@(_p.Start.DayNumber - f.Vervaldatum.DayNumber)</td>
                                            <td class="lq-kap" title="@f.Relatie">@f.Relatie</td>
                                            <td class="lq-kap"><button class="lq-factuur" title="@f.Bv @f.Nummer openen" @onclick="() => OpenFactuur(f)">@f.Bv @f.Nummer</button></td>
                                            <td class="r">@Geld(f.Bedrag)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
        }
        else if (_bezig)
        {
            <p class="uitleg">Bezig met rekenen…</p>
        }
    }
</div>

@* dubbelklik op een regel van de gekozen dag: de factuur of vaste last erachter *@
<VerkoopFactuurVenster FactuurId="_verkoopId" Sluiten="VensterDicht" />
<FactuurVenster FactuurId="_inkoopId" Sluiten="VensterDicht" />
<VasteLastVenster Last="_vasteLast" Categorieen="_categorieen" Bvs="_vlBvs" Sluiten="VensterDicht" />

@code {
    private List<LiquiditeitBv> _bvs = new();
    private readonly HashSet<int> _gekozen = new();
    private int _dagen = 60;
    private LiquiditeitPrognose? _p;
    private DateOnly? _dag;
    private bool _toonTeLaat;
    private bool _bezig;
    private string? _melding;

    private static readonly System.Globalization.CultureInfo Nl = new("nl-NL");
    private static string Geld(decimal w) => w.ToString("C0", Nl);
    private static string Getal(double w) => w.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>De saldi na 7, 30 en de hele periode, zoals Access (7/30/60).</summary>
    private IEnumerable<int> Mijlpalen => new[] { 7, 30, _dagen }.Distinct().Where(n => n <= _dagen);

    protected override async Task OnInitializedAsync()
    {
        await Ik.ZorgGeladenAsync();
        if (!Repo.Beschikbaar) return;
        try { _bvs = await Repo.BvsAsync(); } catch (Exception ex) { _melding = "BV's ophalen mislukt: " + ex.Message; }
        await LaadBoom();
        if (_boom.Count > 0) ZetKeuze(); else StandaardBvsZonderLaden();
        await Laad();
    }

    // ---------- BV kiezen in de boom (Financiën > BV-structuur) ----------
    private List<EigenBv> _eigen = new();
    private List<BvAandeel> _randen = new();
    private List<List<EigenBv>> _boom = new();
    private int? _kern;
    private bool _metDochters = true;
    private const int StandaardKern = 5660;     // MDE Holding (besluit gebruiker: standaard Holding met dochters)
    private ElementReference _org;
    private bool _tekenen;

    /// <summary>De MDE-groep (niet opgeheven) in lagen: wie geen aandeelhouder binnen de groep heeft bovenaan.</summary>
    private async Task LaadBoom()
    {
        if (!Structuur.Beschikbaar) return;
        try
        {
            _eigen = (await Structuur.BvsAsync()).Where(b => b.MdeGroep && !b.IsOpgeheven).ToList();
            var ids = _eigen.Select(b => b.Id).ToHashSet();
            _randen = (await Structuur.AandelenAsync()).Where(a => a.Actueel && ids.Contains(a.BvId) && ids.Contains(a.AandeelhouderId)).ToList();
        }
        catch { _eigen = new(); _randen = new(); }
        if (_randen.Count == 0) { _boom = new(); return; }    // geen structuur vastgelegd: de oude knoppen
        // alleen wat in de structuur hangt (een losse BV, bv. een die nog opgeheven moet worden, niet)
        _eigen = _eigen.Where(b => _randen.Any(a => a.BvId == b.Id || a.AandeelhouderId == b.Id)).ToList();

        var laag = new Dictionary<int, int>();
        int Laag(int id, int diepte)
        {
            if (laag.TryGetValue(id, out var l)) return l;
            if (diepte > 20) return 0;
            var boven = _randen.Where(a => a.BvId == id).ToList();
            l = boven.Count == 0 ? 0 : boven.Max(a => Laag(a.AandeelhouderId, diepte + 1)) + 1;
            laag[id] = l;
            return l;
        }
        foreach (var b in _eigen) Laag(b.Id, 0);
        _boom = _eigen.GroupBy(b => laag[b.Id]).OrderBy(g => g.Key).Select(g => g.OrderBy(b => b.Naam).ToList()).ToList();
        _kern = _eigen.Any(b => b.Id == StandaardKern) ? StandaardKern
              : _eigen.OrderByDescending(b => Dochters(b.Id).Count).First().Id;
        _tekenen = true;
    }

    /// <summary>Alle BV's onder deze BV (via de aandeelhouders), zonder hemzelf.</summary>
    private HashSet<int> Dochters(int id)
    {
        var onder = new HashSet<int>();
        var rij = new Queue<int>(new[] { id });
        while (rij.Count > 0)
        {
            var x = rij.Dequeue();
            foreach (var a in _randen.Where(a => a.AandeelhouderId == x))
                if (a.BvId != id && onder.Add(a.BvId)) rij.Enqueue(a.BvId);
        }
        return onder;
    }

    private void ZetKeuze()
    {
        _gekozen.Clear();
        if (_kern is not int k) return;
        _gekozen.Add(k);
        if (_metDochters) _gekozen.UnionWith(Dochters(k));
    }

    private async Task KiesKern(int id) { _kern = id; ZetKeuze(); await Laad(); }

    private async Task DochtersGewijzigd(ChangeEventArgs e) { _metDochters = e.Value is true; ZetKeuze(); await Laad(); }

    private string BvNaam(int id)
    {
        if (_eigen.FirstOrDefault(b => b.Id == id) is { } e) return e.Kort;
        if (_bvs.FirstOrDefault(b => b.Id == id) is { } l) return l.Afkorting.Length > 0 ? l.Afkorting : l.Naam;
        return id.ToString();
    }

    /// <summary>Wat je bekijkt, in één zin.</summary>
    private string KeuzeTekst()
    {
        if (_gekozen.Count == 0) return "Geen BV gekozen.";
        var namen = string.Join(", ", _gekozen.Select(BvNaam).OrderBy(n => n));
        var wat = _boom.Count > 0 && _kern is int k
            ? (_metDochters && _gekozen.Count > 1 ? $"{_eigen.FirstOrDefault(b => b.Id == k)?.Naam} met dochters ({namen})" : _eigen.FirstOrDefault(b => b.Id == k)?.Naam ?? namen)
            : namen;
        return $"{wat}: {_p?.Rekeningen.Count ?? 0} rekening(en), de vaste lasten en openstaande facturen van "
             + (_gekozen.Count == 1 ? "deze BV." : "deze BV's; facturen tussen deze BV's tellen niet mee.");
    }

    protected override async Task OnAfterRenderAsync(bool eersteKeer)
    {
        if (!_tekenen) return;
        _tekenen = false;
        var randen = _randen.Select(a => new { van = a.AandeelhouderId, naar = a.BvId, pct = a.Percentage.ToString("0.###", Nl) + " %" }).ToList();
        try { await JS.InvokeVoidAsync("mdeOrganigram.teken", _org, randen); } catch { }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("mdeOrganigram.stop", _org); } catch { }
    }

    private void StandaardBvsZonderLaden()
    {
        _gekozen.Clear();
        foreach (var bv in _bvs.Where(b => b.MdeBv)) _gekozen.Add(bv.Id);
    }

    private async Task StandaardBvs() { StandaardBvsZonderLaden(); await Laad(); }

    private async Task WisselBv(int id)
    {
        if (!_gekozen.Remove(id)) _gekozen.Add(id);
        await Laad();
    }

    private async Task PeriodeGewijzigd(ChangeEventArgs e)
    {
        _dagen = int.TryParse((string?)e.Value, out var d) ? d : 60;
        await Laad();
    }

    private async Task Laad()
    {
        _bezig = true;
        try
        {
            var bvs = _gekozen.ToList();
            var rekeningen = await Repo.BanksaldiAsync(bvs);

            // Start = de laatste dag met banktransacties op een van deze rekeningen (zoals Access);
            // zonder bankgegevens vandaag.
            var start = rekeningen.Where(r => r.Datum is not null).Select(r => r.Datum!.Value).DefaultIfEmpty(DateOnly.FromDateTime(DateTime.Today)).Max();

            _vasteLasten = await VasteLasten.LijstAsync();
            // facturen tussen de gekozen BV's: geld binnen de groep, telt niet mee
            var open = (await Repo.OpenstaandAsync(bvs)).Where(f => f.RelatieId is not int r || !_gekozen.Contains(r)).ToList();
            // vaste lasten alleen van de gekozen BV's (zonder BV = kolom ontbreekt nog: altijd mee)
            var lasten = _vasteLasten.Where(v => v.BvId is not int b || _gekozen.Contains(b)).ToList();
            _p = Liquiditeitsrekenaar.Bereken(start, _dagen, rekeningen,
                open,
                lasten,
                await Repo.BtwPerKwartaalAsync(bvs, start.Year - 1));
            if (_dag is DateOnly d && (d <= start || d > start.AddDays(_dagen))) _dag = null;
            _melding = null;
        }
        catch (Exception ex) { _melding = "Rekenen mislukt: " + ex.Message; }
        finally { _bezig = false; }
    }

    private void KiesDag(DateOnly d) => _dag = _dag == d ? null : d;

    // ---- dubbelklik: de mutatie bekijken ----
    private List<VasteLast> _vasteLasten = new();
    private List<VasteLastCategorie> _categorieen = new();
    private int? _verkoopId;
    private int? _inkoopId;
    private VasteLast? _vasteLast;

    private static bool Openbaar(LiquiditeitPost p) => p.FactuurId is not null || p.VasteLastId is not null;

    private static string Uitleg(LiquiditeitPost p) => p.Soort switch
    {
        "Klant" => "Dubbelklik om de uitgaande factuur te openen",
        "Leverancier" => "Dubbelklik om de inkomende factuur te openen",
        "Vaste last" => "Dubbelklik om de vaste last te openen",
        _ => "Btw van het kwartaal: verkoop-btw min inkoop-btw van de gekozen BV's, te betalen voor het eind van de maand na het kwartaal",
    };

    /// <summary>Een factuur uit de lijsten "te laat" openen: verkoop = uitgaande factuur, inkoop = inkomende factuur.</summary>
    private void OpenFactuur(OpenstaandeFactuur f)
    {
        if (f.Verkoop) _verkoopId = f.Id; else _inkoopId = f.Id;
    }

    private async Task Open(LiquiditeitPost p)
    {
        if (p.FactuurId is int id) { if (p.Verkoop) _verkoopId = id; else _inkoopId = id; return; }
        if (p.VasteLastId is not int vlId || _vasteLasten.FirstOrDefault(v => v.Id == vlId) is not { } v) return;
        // een premie van een verzekering: daar aanpassen (de verzekering is de bron)
        if (v.VerzekeringId is int vz) { Nav.NavigateTo($"/financien/verzekeringen?verzekering={vz}"); return; }

        if (_categorieen.Count == 0)
            try { _categorieen = await VasteLasten.CategorieenAsync(); } catch { }
        if (_vlBvs.Count == 0)
            try { _vlBvs = await VasteLasten.BvsAsync(); } catch { }

        // Een kopie, zodat Annuleren niets verandert.
        _vasteLast = new VasteLast
        {
            Id = v.Id, Omschrijving = v.Omschrijving, Bedrag = v.Bedrag, Interval = v.Interval,
            CategorieId = v.CategorieId, Categorie = v.Categorie, Dag = v.Dag, Maand = v.Maand, BvId = v.BvId, Bv = v.Bv,
        };
    }

    private List<Keuze> _vlBvs = new();

    /// <summary>Venster dicht; is er iets opgeslagen, dan de prognose opnieuw rekenen.</summary>
    private async Task VensterDicht(bool opgeslagen)
    {
        _verkoopId = null;
        _inkoopId = null;
        _vasteLast = null;
        if (opgeslagen) await Laad();
    }

    // ---- bladeren met het toetsenbord, door de dagen met beweging ----
    private bool _pijltje;

    private async Task Toetsen(KeyboardEventArgs e)
    {
        var dagen = _p?.Dagen.Where(x => x.Erbij + x.Eraf > 0).Select(x => x.Datum).ToList() ?? new();
        _pijltje = e.Key is "ArrowDown" or "ArrowUp" or "PageDown" or "PageUp" or "Home" or "End";
        if (!_pijltje || dagen.Count == 0) return;

        var huidig = _dag is DateOnly gekozen ? dagen.IndexOf(gekozen) : -1;
        var nieuw = e.Key switch
        {
            "ArrowDown" => huidig + 1,
            "ArrowUp" => huidig < 0 ? 0 : huidig - 1,
            "PageDown" => huidig + 10,
            "PageUp" => huidig - 10,
            "Home" => 0,
            _ => dagen.Count - 1,
        };
        _dag = dagen[Math.Clamp(nieuw, 0, dagen.Count - 1)];
        StateHasChanged();
        try { await JS.InvokeVoidAsync("mdeLijst.naarActief", "lq-dagen"); } catch { }
    }

    private string RekeningenTekst()
        => string.Join("\n", _p!.Rekeningen.Select(r => $"{r.Omschrijving} ({r.Rekening}): {Geld(r.Saldo)}" +
                                                          (r.Datum is DateOnly d ? $" op {d:dd-MM-yyyy}" : " (geen transacties)")));

    /// <summary>Waarschuwing als een rekening al lang geen afschriften meer heeft: dan klopt het saldo misschien niet.</summary>
    private string OudeRekeningen()
    {
        var oud = _p!.Rekeningen.Count(r => r.Datum is null || r.Datum < _p.Start.AddDays(-14));
        return oud == 0 ? "" : $", waarvan {oud} zonder recente afschriften";
    }

    // ============================================================
    //  Grafiek (eigen SVG, geen bibliotheek nodig)
    // ============================================================
    private const double Breedte = 1000, Hoogte = 220, Rand = 10;

    private double Stap => _p!.Dagen.Count <= 1 ? Breedte : (Breedte - 2 * Rand) / (_p.Dagen.Count - 1);
    private double X(int i) => Rand + i * Stap;

    private decimal Min => Math.Min(0, _p!.Dagen.Select(d => Math.Min(d.SaldoNaTeLaatLeveranciers, d.SaldoInclTeLaatKlanten)).DefaultIfEmpty(0).Min());
    private decimal Max => _p!.Dagen.Select(d => Math.Max(d.SaldoNaTeLaatLeveranciers, d.SaldoInclTeLaatKlanten)).DefaultIfEmpty(0).Max();

    /// <summary>
    /// Een nette schaal: stappen van 1, 2 of 5 × een macht van tien, ongeveer vijf streepjes,
    /// en de as begint en eindigt op een streepje.
    /// </summary>
    private (decimal Onder, decimal Boven, decimal Stap) Schaal
    {
        get
        {
            var ruw = (Max - Min) / 5;
            if (ruw <= 0) ruw = 1000;
            var macht = (decimal)Math.Pow(10, Math.Floor(Math.Log10((double)ruw)));
            var stap = new[] { 1m, 2m, 5m, 10m }.Select(f => f * macht).First(s => s >= ruw);
            var onder = Math.Floor(Min / stap) * stap;
            var boven = Math.Ceiling(Max / stap) * stap;
            if (boven <= onder) boven = onder + stap;
            return (onder, boven, stap);
        }
    }

    private IEnumerable<decimal> Schaalstreepjes
    {
        get
        {
            var (onder, boven, stap) = Schaal;
            for (var w = onder; w <= boven; w += stap) yield return w;
        }
    }

    private double Y(decimal waarde)
    {
        var (onder, boven, _) = Schaal;
        return Rand + (Hoogte - 2 * Rand) * (1 - (double)(waarde - onder) / (double)(boven - onder));
    }

    private double? Nullijn => Min < 0 ? Y(0) : null;

    private string Lijn(Func<LiquiditeitDag, decimal> waarde)
        => string.Join(" ", _p!.Dagen.Select((d, i) => $"{Getal(X(i))},{Getal(Y(waarde(d)))}"));
}
