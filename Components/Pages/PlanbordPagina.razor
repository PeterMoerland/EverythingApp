                    <input value="@iv.Opmerking" maxlength="500" @oninput="e => iv.Opmerking = (string?)e.Value ?? string.Empty" /></label>
                <div class="cs-knoppen">
                    <button type="button" class="primair" disabled="@_bezig" @onclick="BewaarItem">Bewaren</button>
                    <button type="button" class="klein" disabled="@_bezig" @onclick="() => _itemVenster = null">Annuleren</button>
                    @if (iv.Id != 0)
                    {
                        <span style="flex:1"></span>
                        <button type="button" class="klein plb-wis" disabled="@_bezig" @onclick="WisItem">Verwijderen</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private static readonly CultureInfo Nl = new("nl-NL");

    private bool _geladen, _tabel, _fout, _bezig, _ookVoorbij, _importOpen;
    private string? _melding;
    private string _zoek = "";
    private List<PlanRij> _rijen = new(), _top = new();
    private Dictionary<int, List<PlanRij>> _kinderen = new();
    private Dictionary<int, PlanRij> _opId = new();
    private Dictionary<int, List<PlanItem>> _items = new();
    private Dictionary<int, DateTime> _laatste = new();      // per rij: het laatste einde van hemzelf en alles eronder
    private List<(string Naam, string Kleur)> _legenda = new();
    private List<string> _symbolen = new();
    private readonly HashSet<int> _open = new();
    private DateTime _van = Maandag(DateTime.Today.AddDays(-28));
    private int _weken = 26;
    private PlanImport? _import;
    private int _invoer;

    private DateTime Tot => _van.AddDays(_weken * 7);
    private bool Zoekt => _zoek.Trim().Length >= 2;

    // ---- overzicht per persoon (25-11-2026): "w:12" = een gekoppelde werknemer, "t:Werkplaats" = een naam uit de tekst ----
    private string _wieFilter = "";
    private List<(string Code, string Naam)> _wieKeuzes = new();
    private Dictionary<int, List<string>> _tekstNamen = new();
    private bool Filtert => Zoekt || _wieFilter.Length > 0;

    // ---- groepfilter (25-11-2026): alleen deze groep van het bovenste niveau ----
    private int? _groepFilter;

    /// <summary>De groep van het bovenste niveau waar een rij onder hangt (de rij zelf als hij bovenaan staat).</summary>
    private PlanRij Top(PlanRij r)
    {
        var stappen = 0;
        while (r.OuderId is int o && _opId.TryGetValue(o, out var ouder) && stappen++ < 50) r = ouder;
        return r;
    }

    /// <summary>Uit het rechtermuismenu: alleen de groep van deze rij, met alles eronder uitgevouwen.</summary>
    private void FilterGroep(PlanRij r)
    {
        var top = Top(r);
        _groepFilter = top.Id;
        Vouw(top, true);        // sluit ook het menu
    }

    /// <summary>De keuze in het filter per persoon die bij een naam uit de kolom Wie hoort; leeg = staat er niet in.</summary>
    private string? WieCode(string naam)
        => _wieKeuzes.Where(k => string.Equals(k.Naam, naam, StringComparison.OrdinalIgnoreCase)).Select(k => k.Code).FirstOrDefault();

    private void FilterWie(string naam)
    {
        _menu = null;
        if (WieCode(naam) is { } code) _wieFilter = code;
    }

    private void FilterUit() { _menu = null; _groepFilter = null; _wieFilter = ""; }

    private void KiesGroep(ChangeEventArgs e)
    {
        _groepFilter = int.TryParse((string?)e.Value, out var g) && _opId.ContainsKey(g) ? g : null;
        if (_groepFilter is int id) _open.Add(id);      // de gekozen groep meteen open
    }

    /// <summary>Staat deze rij op naam van de gekozen persoon? Een werknemer telt ook als zijn korte naam of voornaam nog als tekst bij Wie staat.</summary>
    private bool VanPersoon(PlanRij r)
    {
        if (_wieFilter.Length < 3) return true;
        var namen = _tekstNamen.GetValueOrDefault(r.Id);
        if (_wieFilter[0] == 't') return namen is not null && namen.Contains(_wieFilter[2..], StringComparer.OrdinalIgnoreCase);
        if (!int.TryParse(_wieFilter.AsSpan(2), out var w)) return true;
        if (r.Werknemers.Contains(w)) return true;
        return namen is not null && _persoon.TryGetValue(w, out var p)
            && namen.Any(n => string.Equals(n, p.Kort, StringComparison.OrdinalIgnoreCase) || string.Equals(n, p.Voornaam, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>Past de rij bij wat er gezocht en gefilterd wordt (zoektekst en persoon)?</summary>
    private bool Treft(PlanRij r) => (!Zoekt || Past(r, _zoek.Trim())) && VanPersoon(r);

    // ---- vanuit een project (of een andere link) naar een rij: /planning?rij=123 ----
    [SupplyParameterFromQuery(Name = "rij")] public int? RijQuery { get; set; }
    private int? _doel, _doelGedaan, _scrollNaar;

    /// <summary>Een rij in beeld brengen: de groepen erboven open, hijzelf ook, filters uit; oude groepen mee als hij daarin zit.</summary>
    private bool ToonRij(int id)
    {
        if (!_opId.TryGetValue(id, out var rij)) return false;
        _zoek = ""; _wieFilter = ""; _groepFilter = null;
        var top = rij;
        for (var x = rij; x is not null; x = x.OuderId is int o && _opId.TryGetValue(o, out var ouder) ? ouder : null)
        {
            if (x != rij || _kinderen.ContainsKey(x.Id)) _open.Add(x.Id);
            top = x;
        }
        var laatste = _laatste.GetValueOrDefault(top.Id);
        if (laatste != DateTime.MinValue && laatste < DateTime.Today.AddDays(-28)) _ookVoorbij = true;
        _doel = id;

        // de tijdbalk schuift mee: staat er van deze rij (en wat eronder hangt) niets in beeld, dan naar de eerste balk
        // die nog loopt of komt, en anders naar de laatste; twee weken ruimte ervoor
        var ids = new List<int> { id };
        for (var i = 0; i < ids.Count && ids.Count < 5000; i++)
            if (_kinderen.TryGetValue(ids[i], out var k)) ids.AddRange(k.Select(x => x.Id));
        var balken = ids.SelectMany(x => _items.TryGetValue(x, out var l) ? l : Enumerable.Empty<PlanItem>()).OrderBy(b => b.Start).ToList();
        if (balken.Count > 0 && !balken.Any(b => b.Start < Tot && (b.Einde ?? b.Start) >= _van))
        {
            var naar = balken.FirstOrDefault(b => (b.Einde ?? b.Start) >= DateTime.Today) ?? balken[^1];
            _van = Maandag(naar.Start.AddDays(-14));
        }
        return true;
    }
    /// <summary>De export overzetten: de Directie. In de testversie (alles in het geheugen, geen login) ook.</summary>
    private bool MagImporteren => Ik.Mag("Directie") || (!Ik.Ingelogd && !Ik.IsWerkplek);

    private static DateTime Maandag(DateTime d) => d.Date.AddDays(-(((int)d.DayOfWeek + 6) % 7));
    private static string Pct(double deel, double geheel) => (deel / geheel * 100).ToString("0.###", CultureInfo.InvariantCulture) + "%";
    private void Meld(string tekst, bool fout = false) { _melding = tekst; _fout = fout; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Ik.ZorgGeladenAsync();
            _tabel = Bord.Beschikbaar && await Bord.AanwezigAsync();
            if (_tabel) await Laad();
        }
        catch (Exception ex) { Meld("Laden is niet gelukt: " + ex.GetBaseException().Message, true); }
        _geladen = true;
    }

    private async Task Laad()
    {
        var (rijen, items) = await Bord.AllesAsync();
        _rijen = rijen;
        _opId = rijen.ToDictionary(r => r.Id);
        if (_groepFilter is int gf && !(_opId.TryGetValue(gf, out var gr) && gr.OuderId is null)) _groepFilter = null;     // de groep is weg of verhangen
        // een rij waarvan de ouder niet bestaat hoort bovenaan, anders is hij onvindbaar
        _top = rijen.Where(r => r.OuderId is not int o || !_opId.ContainsKey(o)).ToList();
        _kinderen = rijen.Where(r => r.OuderId is int o && _opId.ContainsKey(o)).GroupBy(r => r.OuderId!.Value).ToDictionary(g => g.Key, g => g.ToList());
        _items = items.GroupBy(i => i.RijId).ToDictionary(g => g.Key, g => g.OrderBy(i => i.Start).ToList());
        _laatste = new();
        foreach (var r in _top) Laatste(r.Id, 0);
        // het bereik van de schuifbalk: van de eerste tot de laatste balk, en in elk geval van vier weken terug tot een half jaar vooruit
        var eerste = Maandag(DateTime.Today.AddDays(-28)); var einde = DateTime.Today.AddDays(26 * 7);
        foreach (var i in items)
        {
            if (i.Start < eerste) eerste = Maandag(i.Start);
            if ((i.Einde ?? i.Start) > einde) einde = i.Einde ?? i.Start;
        }
        _bereikVan = eerste; _bereikTot = Maandag(einde).AddDays(7);
        _legenda = items.Where(i => !i.Symbool && i.Legenda.Length > 0).GroupBy(i => i.Legenda).OrderByDescending(g => g.Count())
                        .Select(g => (g.Key, Kleur(g.First().Kleur))).ToList();
        _symbolen = items.Where(i => i.Symbool && i.Legenda.Length > 0).GroupBy(i => i.Legenda).OrderByDescending(g => g.Count()).Select(g => g.Key).ToList();
        _metKleur = await Bord.KleurAanwezigAsync();
        _metWie = await Bord.WieAanwezigAsync();
        try { _personen = _metWie ? await Bord.PersonenAsync() : new(); } catch { _personen = new(); }
        _persoon = _personen.ToDictionary(p => p.Id);
        // het filter per persoon: de gekoppelde werknemers, en de namen die nog als tekst bij Wie staan
        _tekstNamen = rijen.Where(r => r.Resource.Length > 0).ToDictionary(r => r.Id, r => Planbord.Namen(r.Resource));
        // welke namen uit de tekst zijn geen werknemer in dienst (inleen telt mee)? Zonder werknemerslijst kleurt er niets.
        var inDienst = _personen.Where(p => p.InDienst).ToList();
        bool IsWerknemer(string naam)
        {
            var n = naam.Trim().TrimEnd('?').Trim();
            bool Is(string a) => a.Length > 0 && string.Equals(a, n, StringComparison.OrdinalIgnoreCase);
            return inDienst.Any(p => Is(p.Kort) || Is(p.Naam) || Is(p.Voornaam) || Is(p.Achternaam) || Is(p.Achternaam.Split(' ').Last()));
        }
        _geenWerknemer = inDienst.Count == 0 ? new(StringComparer.OrdinalIgnoreCase)
            : _tekstNamen.Values.SelectMany(n => n).Distinct(StringComparer.OrdinalIgnoreCase).Where(n => !IsWerknemer(n)).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var gekoppeld = rijen.SelectMany(r => r.Werknemers).Distinct().Where(_persoon.ContainsKey).Select(w => _persoon[w]).ToList();
        var bekend = new HashSet<string>(gekoppeld.SelectMany(p => new[] { p.Kort, p.Voornaam }), StringComparer.OrdinalIgnoreCase);
        _wieKeuzes = gekoppeld.Select(p => (Code: "w:" + p.Id, Naam: p.Kort))
            .Concat(_tekstNamen.Values.SelectMany(n => n).Distinct(StringComparer.OrdinalIgnoreCase).Where(n => !bekend.Contains(n)).Select(n => (Code: "t:" + n, Naam: n)))
            .OrderBy(k => k.Naam, StringComparer.CurrentCultureIgnoreCase).ToList();
        if (_wieFilter.Length > 0 && !_wieKeuzes.Any(k => k.Code == _wieFilter)) _wieFilter = "";
        _losseNamen = rijen.SelectMany(r => Planbord.Namen(r.Resource)).Distinct(StringComparer.OrdinalIgnoreCase).Count();
        _wie = rijen.Select(r => r.Resource).Where(w => w.Length > 0).GroupBy(w => w, StringComparer.OrdinalIgnoreCase)
                    .OrderByDescending(g => g.Count()).Take(80).Select(g => g.Key).OrderBy(w => w).ToList();
    }

    /// <summary>Het laatste moment waarop in deze rij of eronder nog iets staat (om oude groepen weg te laten).</summary>
    private DateTime Laatste(int id, int diepte)
    {
        var max = _items.TryGetValue(id, out var l) ? l.Max(i => i.Einde ?? i.Start) : DateTime.MinValue;
        if (diepte < 20 && _kinderen.TryGetValue(id, out var k))
            foreach (var kind in k) { var m = Laatste(kind.Id, diepte + 1); if (m > max) max = m; }
        return _laatste[id] = max;
    }

    // ------------------------------------------------------------------ welke rijen in beeld

    private bool Past(PlanRij r, string q) => r.Naam.Contains(q, StringComparison.OrdinalIgnoreCase) || WieVoluit(r).Contains(q, StringComparison.OrdinalIgnoreCase)
                                             || WieTekst(r).Contains(q, StringComparison.OrdinalIgnoreCase);

    // ---- wie: gekoppelde werknemers en de vrije tekst (stap 4, 25-11-2026) ----

    private bool _metWie, _metKleur;

    /// <summary>De tekstkleur op een volle rijkleur: wit, of donker op een lichte kleur (geel, oranje).</summary>
    private static string Leesbaar(string hex)
    {
        if (hex.Length != 7 || !int.TryParse(hex.AsSpan(1), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out var rgb)) return "inherit";
        var licht = 0.299 * (rgb >> 16 & 255) + 0.587 * (rgb >> 8 & 255) + 0.114 * (rgb & 255);
        return licht > 150 ? "#1f2933" : "#fff";
    }

    /// <summary>Een kleur uit het rechtermuismenu: meteen bewaren.</summary>
    private async Task KiesKleur(PlanRij r, string kleur)
    {
        _menu = null;
        var oud = r.Kleur;
        if (oud == kleur) return;
        if (await Doe(() => Bord.KleurAsync(r.Id, kleur))) Onthoud($"kleur van {r.Naam}", () => Bord.KleurAsync(r.Id, oud));
    }

    // ---- ongedaan maken (Ctrl+Z via mdeUndo in App.razor, of de knop ↶; wens gebruiker 25-11-2026) ----
    // Per open scherm een stapel van hooguit 30 wijzigingen, elk met wat hem terugdraait. Alleen je eigen wijzigingen
    // van dit scherm; herladen = de stapel leeg. Er is geen "opnieuw".

    private readonly List<(string Wat, Func<Task> Terug)> _terug = new();

    private void Onthoud(string wat, Func<Task> terug)
    {
        _terug.Add((wat, terug));
        if (_terug.Count > 30) _terug.RemoveAt(0);
    }

    [JSInvokable]
    public async Task OngedaanMaken()
    {
        if (_terug.Count == 0 || _bezig || !MagPlannen || _rijVenster is not null || _itemVenster is not null || _koppelVenster is not null) return;
        var (wat, terug) = _terug[^1];
        _terug.RemoveAt(_terug.Count - 1);
        await InvokeAsync(async () =>
        {
            if (await Doe(terug)) Meld("Ongedaan gemaakt: " + wat + ".");
            StateHasChanged();
        });
    }
    private int _losseNamen;
    private List<PlanPersoon> _personen = new();
    private Dictionary<int, PlanPersoon> _persoon = new();

    private string Kort(int werknemer) => _persoon.TryGetValue(werknemer, out var p) ? p.Kort : "?";

    /// <summary>De kolom Wie: de gekoppelde werknemers (korte naam) en daarachter de vrije tekst.</summary>
    private string WieTekst(PlanRij r) => r.Werknemers.Count == 0 ? r.Resource
        : string.Join(", ", r.Werknemers.Select(Kort).OrderBy(n => n, StringComparer.CurrentCultureIgnoreCase).Concat(r.Resource.Length > 0 ? new[] { r.Resource } : Array.Empty<string>()));

    /// <summary>De namen die als tekst bij Wie staan en bij geen enkele werknemer in dienst passen (korte naam, hele naam, voor- of achternaam).</summary>
    private HashSet<string> _geenWerknemer = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>De kolom Wie in stukjes: de gekoppelde werknemers, dan de namen uit de tekst; Los = geen werknemer (oranje).</summary>
    private IEnumerable<(string Tekst, bool Los)> WieDelen(PlanRij r)
    {
        foreach (var n in r.Werknemers.Select(Kort).OrderBy(n => n, StringComparer.CurrentCultureIgnoreCase)) yield return (n, false);
        if (_tekstNamen.TryGetValue(r.Id, out var namen))
            foreach (var n in namen) yield return (n, _geenWerknemer.Contains(n));
    }

    private string WieVoluit(PlanRij r) => r.Werknemers.Count == 0 ? r.Resource
