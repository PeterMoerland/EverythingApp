@page "/planbord"
@page "/planning"
@using System.Globalization
@implements IDisposable
@inject Planbord Bord
@inject IProjectRepository Projecten
@inject IRelatieRepository Relaties
@inject IUrenRepository Uren
@inject HuidigeGebruiker Ik
@inject IJSRuntime JS

@* Planning (menu Planning, wens gebruiker 25-11-2026): groepen met daaronder activiteiten, links de boom en rechts de
   tijdbalk met balken en symbolen, zoals Tom's Planner. Stap 1 is bekijken: in- en uitklappen, door de tijd bladeren,
   zoeken. De export van Tom's Planner zet de Directie eenmalig over (knop rechtsboven). Stap 2 is bewerken, voor wie
   mag plannen (recht Planner of Directie): rechtermuisknop op een rij voor het menu, dubbelklik op de tijdbalk voor een
   nieuwe balk, een balk verslepen of aan de rand langer en korter trekken (mdePlan in App.razor), een klik op een balk
   om hem te wijzigen, en een rij verslepen in de boom. Het koppelen van een groep aan klant, project of werkorder
   komt later. Opslag: Services/Planbord.cs, Planbord_MariaDB.sql.
   De plek van een balk is een percentage van het getoonde tijdvak, dus de tijdbalk past altijd in de breedte. *@

<PageTitle>Planning — MDE</PageTitle>

<div class="page plb-pagina">
    <header class="topbar">
        <h1>Planning</h1>
        <span class="weeklabel">@(_rijen.Count == 0 ? "projecten en activiteiten op een tijdbalk" : $"{_top.Count} groepen · {_rijen.Count} rijen")</span>
    </header>

    @if (_melding is not null)
    {
        <div class="melding @(_fout ? "fout" : "ok")" style="position:static;max-width:none" @onclick="() => _melding = null">@_melding</div>
    }

    @if (!_geladen)
    {
        <p class="uitleg">Laden…</p>
    }
    else if (!_tabel)
    {
        <section class="module-placeholder"><p>De tabellen voor de planning bestaan nog niet (Planbord_MariaDB.sql).</p></section>
    }
    else
    {
        <div class="plb-balk">
            <button type="button" class="klein" title="Vier weken terug" @onclick="() => Schuif(-4)">‹</button>
            <button type="button" class="klein" @onclick="Vandaag">Vandaag</button>
            <button type="button" class="klein" title="Vier weken verder" @onclick="() => Schuif(4)">›</button>
            <select value="@_weken" @onchange="e => _weken = int.TryParse((string?)e.Value, out var w) ? w : 26" aria-label="Hoeveel weken in beeld">
                <option value="13">13 weken</option>
                <option value="26">half jaar</option>
                <option value="52">jaar</option>
                <option value="104">2 jaar</option>
            </select>
            <span class="plb-tijdvak">@_van.ToString("d MMM yyyy", Nl) – @Tot.AddDays(-1).ToString("d MMM yyyy", Nl)</span>
            <span class="groei"></span>
            <input class="plb-zoek" type="search" placeholder="🔍 Zoek: activiteit of persoon…" value="@_zoek" @oninput="e => _zoek = (string?)e.Value ?? string.Empty" autocomplete="off" />
            <label class="vink" title="Ook groepen tonen waar de laatste vier weken en daarna niets meer in staat"><input type="checkbox" checked="@_ookVoorbij" @onchange="e => _ookVoorbij = e.Value is true" /> ook wat voorbij is</label>
            <button type="button" class="klein" @onclick="AllesDicht">Alles dicht</button>
            @if (MagPlannen)
            {
                <button type="button" class="primair klein" title="Een nieuwe groep, onderaan de planning" @onclick="() => BeginRij(null, null, null)">+ Groep</button>
                @* de knop "Namen koppelen…" (BeginNamen, het venster _namenVenster) is op verzoek van de gebruiker weg
                   (25-11-2026); het venster en KoppelNamenAsync staan er nog, NIET IN GEBRUIK *@
            }
            @* overzetten uit Tom's Planner: alleen nog zolang de planning leeg is (knop weg op verzoek, 25-11-2026) *@
            @if (MagImporteren && _rijen.Count == 0)
            {
                <button type="button" class="klein" @onclick="() => { _importOpen = !_importOpen; _import = null; }">Tom's Planner overzetten…</button>
            }
        </div>

        @if (_importOpen && MagImporteren)
        {
            <section class="plb-import">
                <b>De planning uit Tom's Planner overzetten</b>
                <p class="uitleg">Kies het exportbestand (CSV) uit Tom's Planner. Je ziet eerst wat erin staat; pas na "Overzetten" komt het in de app.
                    @(_rijen.Count > 0 ? "Let op: dit vervangt de hele planning die er nu staat." : "")</p>
                <label class="klein fotovak-knop">Exportbestand kiezen…
                    <InputFile @key="_invoer" OnChange="LeesBestand" accept=".csv" class="bon-verborgen" /></label>
                @if (_import is { } im)
                {
                    <div class="plb-voorvertoning">
                        <div><b>@im.Groepen</b> groepen · <b>@im.Rijen.Count</b> rijen · <b>@im.Balken</b> balken · <b>@im.Symbolen</b> symbolen
                            @if (im.Van is DateTime v && im.Tot is DateTime t) { <span> · van @v.ToString("d-M-yyyy") tot @t.ToString("d-M-yyyy")</span> }</div>
                        @foreach (var o in im.Opmerkingen) { <div class="plb-letop">@o</div> }
                        @if (im.Rijen.Count > 0)
                        {
                            <div class="uitleg">Eerste groepen: @string.Join(" · ", im.Rijen.Where(r => r.OuderId is null).Take(8).Select(r => r.Naam))…</div>
                            <div class="btngroup">
                                <button type="button" class="primair" disabled="@_bezig" @onclick="ZetOver">Overzetten@(_rijen.Count > 0 ? " (vervangt de planning)" : "")</button>
                                <button type="button" class="klein" disabled="@_bezig" @onclick="() => { _import = null; _importOpen = false; }">Annuleren</button>
                            </div>
                        }
                    </div>
                }
            </section>
        }

        @if (_rijen.Count == 0)
        {
            <p class="uitleg">De planning is nog leeg.@(MagImporteren ? " Zet de export van Tom's Planner over met de knop rechtsboven" : " De Directie zet de planning uit Tom's Planner over")@(MagPlannen ? ", of begin met \"+ Groep\"." : ".")</p>
        }
        else
        {
            var zichtbaar = Zichtbaar().ToList();
            var dagen = _weken * 7;
            <div class="plb-bord" style="@($"--plb-weken:{_weken}")" data-dagen="@dagen"
                 ondragstart="event.dataTransfer.setData('text/plain', 'rij'); event.dataTransfer.effectAllowed = 'move';">
                @* ----- de kop: maanden en weeknummers ----- *@
                <div class="plb-rij plb-kop">
                    <div class="plb-naam">Activiteit</div>
                    <div class="plb-wie">Wie</div>
                    <div class="plb-tijd">
                        <div class="plb-maanden">
                            @foreach (var (naam, breedte) in Maanden()) { <span style="@($"width:{Pct(breedte, dagen)}")" title="@naam">@naam</span> }
                        </div>
                        @if (_weken <= 60)
                        {
                            <div class="plb-weken">
                                @for (var w = 0; w < _weken; w++) { <span>@ISOWeek.GetWeekOfYear(_van.AddDays(w * 7))</span> }
                            </div>
                        }
                    </div>
                </div>

                @if (zichtbaar.Count == 0)
                {
                    <p class="uitleg plb-leeg">Niets gevonden@(_ookVoorbij ? "." : "; zet \"ook wat voorbij is\" aan om ook oude groepen te doorzoeken.")</p>
                }
                @foreach (var (r, diepte) in zichtbaar)
                {
                    var groep = _kinderen.ContainsKey(r.Id);
                    var open = groep && (Zoekt || _open.Contains(r.Id));
                    @* de smalle strook boven een rij: laat je een rij hier vallen, dan komt hij ervoor te staan *@
                    <div class="plb-tussen @(_sleeptRij is not null && _sleepVoor == r.Id ? "sleepdoel" : "")" @key="@("voor" + r.Id)"
                         ondragover="event.preventDefault()" @ondragenter="() => { if (_sleeptRij is not null) { _sleepVoor = r.Id; _sleepOp = null; } }"
                         @ondrop="() => LaatRijVallen(r, true)"></div>
                    <div class="plb-rij @(diepte == 1 ? "plb-top" : "") @(groep ? "plb-groep" : "") @(_sleeptRij?.Id == r.Id ? "plb-sleept" : "") @(_menu?.Rij.Id == r.Id ? "gekozen" : "") @(r.Kleur.Length > 0 ? "plb-gekleurd" : "")"
                         style="@(r.Kleur.Length > 0 ? $"--plb-rijkleur:{r.Kleur};--plb-rijtekst:{Leesbaar(r.Kleur)}" : null)"
                         @key="r.Id" data-groep="@r.Id" @oncontextmenu="e => OpenMenu(e, r)" @oncontextmenu:preventDefault="MagPlannen">
                        <div class="plb-naam @(_sleeptRij is not null && _sleepOp == r.Id ? "sleepdoel" : "")" style="@($"padding-left:{(diepte - 1) * 14 + 4}px")" title="@r.Naam"
                             draggable="@(MagPlannen ? "true" : "false")" @ondragstart="() => BeginSleepRij(r)" @ondragend="EindeSleepRij"
                             ondragover="event.preventDefault()" @ondragenter="() => { if (_sleeptRij is not null) { _sleepOp = r.Id; _sleepVoor = null; } }"
                             @ondrop="() => LaatRijVallen(r, false)">
                            @if (groep)
                            {
                                <button type="button" class="plb-pijl" aria-expanded="@open" title="@(open ? "Dichtklappen" : "Openklappen")" @onclick="() => Wissel(r.Id)">@(open ? "▾" : "▸")</button>
                                <span class="plb-tekst" @onclick="() => Wissel(r.Id)">@r.Naam</span>
                            }
                            else { <span class="plb-pijl"></span><span class="plb-tekst">@r.Naam</span> }
                            @if (r.Gekoppeld)
                            {
                                @* waar de rij aan gekoppeld is; een project of werkorder is een link naar het project *@
                                @if (r.KoppelProjectId is int kp) { <a class="plb-koppel" href="@($"projecten?project={kp}")" title="@(r.KoppelTekst + " — het project openen")" draggable="false" @onclick:stopPropagation="true">@r.KoppelKort</a> }
                                else { <span class="plb-koppel" title="@r.KoppelTekst">@r.KoppelKort</span> }
                            }
                        </div>
                        <div class="plb-wie" title="@WieVoluit(r)">@WieTekst(r)</div>
                        <div class="plb-tijd" @ondblclick="e => NieuwOpPlek(r, e)" title="@(MagPlannen ? "Dubbelklik voor een nieuwe balk; rechtermuisknop voor meer" : null)">
                            @if (VandaagPct() is { } vp) { <i class="plb-vandaag" style="@($"left:{vp}")"></i> }
                            @if (groep && !open)
                            {
                                @* dichtgeklapt: gearceerd waar er onder deze groep iets gepland staat *@
                                @foreach (var (a, b) in Samenvatting(r.Id))
                                {
                                    <i class="plb-samen" style="@($"left:{Pct(a, dagen)};width:{Pct(b - a, dagen)}")"></i>
                                }
                            }
                            @if (_items.TryGetValue(r.Id, out var lijst))
                            {
                                @foreach (var it in lijst)
                                {
                                    var a = Pos(it.Start);
                                    if (it.Symbool)
                                    {
                                        if (a >= 0 && a <= dagen)
                                        {
                                            <span class="plb-symbool" style="@($"left:{Pct(a, dagen)}")" title="@Uitleg(it)" data-plan="@(MagPlannen ? it.Id : null)"
                                                  @onclick="() => OpenItem(it)" @ondblclick:stopPropagation="true">@Teken(it.Legenda)</span>
                                        }
                                    }
                                    else
                                    {
                                        var b = Pos(it.Einde ?? it.Start, einde: true);
                                        if (b > 0 && a < dagen)
                                        {
                                            var links = Math.Max(0, a);
                                            var breed = Math.Max(0.15, Math.Min(dagen, b) - links);
                                            <span class="plb-balkje @(a < 0 ? "loopt-in" : "") @(b > dagen ? "loopt-uit" : "") @(MagPlannen ? "te-slepen" : "")" title="@Uitleg(it)"
                                                  data-plan="@(MagPlannen ? it.Id : null)" @onclick="() => OpenItem(it)" @ondblclick:stopPropagation="true"
                                                  style="@($"left:{Pct(links, dagen)};width:{Pct(breed, dagen)};background:{Kleur(it.Kleur)}")">@it.Label</span>
                                        }
                                    }
                                }
                            }
                        </div>
                    </div>
                }
            </div>

            @* door de tijd schuiven: staat onder het bord en dus altijd in beeld; een stap = een week *@
            <div class="plb-schuif">
                <span></span><span></span>
                <input type="range" min="0" max="@SchuifMax" step="1" value="@SchuifStand" disabled="@(SchuifMax == 0)"
                       aria-label="Door de tijd schuiven" title="@($"Door de tijd schuiven ({_bereikVan.ToString("MMM yyyy", Nl)} – {_bereikTot.AddDays(-1).ToString("MMM yyyy", Nl)})")"
                       @oninput="e => { if (int.TryParse((string?)e.Value, out var w)) _van = _bereikVan.AddDays(w * 7); }" />
            </div>

            <div class="plb-legenda">
                @foreach (var (naam, kleur) in _legenda) { <span><i style="@($"background:{kleur}")"></i>@naam</span> }
                <span><i class="plb-samen"></i>dichtgeklapte groep</span>
                @foreach (var naam in _symbolen) { <span>@Teken(naam) @naam</span> }
            </div>
        }
    }
</div>

@* ----- het menu van de rechtermuisknop op een rij ----- *@
@if (_menu is { } mn && MagPlannen)
{
    <div class="wk-menuscherm" @onclick="() => _menu = null" @oncontextmenu="() => _menu = null" @oncontextmenu:preventDefault="true"></div>
    <div class="wk-menu" role="menu" style="@($"left:min({mn.X}px, calc(100vw - 350px));top:min({mn.Y}px, calc(100vh - 400px))")">
        <div class="wk-menukop">@mn.Rij.Naam</div>
        <button type="button" role="menuitem" @onclick="() => { _menu = null; NieuwItem(mn.Rij, false, null); }">+ Balk…</button>
        <button type="button" role="menuitem" @onclick="() => { _menu = null; NieuwItem(mn.Rij, true, null); }">+ Symbool (mijlpaal, levering…)</button>
        <button type="button" role="menuitem" @onclick="() => { _menu = null; BeginRij(null, mn.Rij.Id, null); }">+ Rij eronder (in @mn.Rij.Naam)</button>
        <button type="button" role="menuitem" @onclick="() => { _menu = null; BeginRij(null, mn.Rij.OuderId, mn.Rij.Id); }">+ Rij erna</button>
        <button type="button" role="menuitem" @onclick="() => { _menu = null; BeginRij(mn.Rij, null, null); }">Wijzigen…</button>
        @if (_metKleur)
        {
            @* de kleuren staan er meteen (eerst achter een klik op Kleur; "scheelt een klik", 25-11-2026) *@
            <div class="plb-kleuren in-menu" role="group" aria-label="Kleur">
                @foreach (var (naam, hex) in Planbord.Rijkleuren)
                {
                    <button type="button" class="@(mn.Rij.Kleur == hex ? "gekozen" : "")" style="@("background:" + hex)" title="@naam" aria-label="@naam" @onclick="() => KiesKleur(mn.Rij, hex)"></button>
                }
                <button type="button" class="geen @(mn.Rij.Kleur.Length == 0 ? "gekozen" : "")" title="Geen kleur" aria-label="Geen kleur" @onclick="() => KiesKleur(mn.Rij, string.Empty)">✕</button>
            </div>
        }
        <button type="button" role="menuitem" @onclick="() => BeginKoppel(mn.Rij)">@(mn.Rij.Gekoppeld ? "Koppeling wijzigen…" : "Koppelen aan klant, project of werkorder…")</button>
        <button type="button" role="menuitem" class="gevaar" @onclick="() => WisRij(mn.Rij)">Verwijderen…</button>
    </div>
}

@* ----- een rij: naam en wie ----- *@
@if (_rijVenster is { } rv)
{
    <div class="cmdk-overlay midden">
        <div class="factuurvenster cs-venster">
            <header class="bijlagekop"><h2>@(rv.Id != 0 ? "Rij wijzigen" : rv.OuderId is int oid && _opId.TryGetValue(oid, out var ouder) ? "Nieuwe rij in " + ouder.Naam : "Nieuwe groep")</h2></header>
            <div class="factuurvenster-inhoud" @onkeydown='e => { if (e.Key == "Escape") _rijVenster = null; }'>
                <label class="cs-veld"><span>Naam</span>
                    <input @ref="_naamVeld" value="@rv.Naam" maxlength="200" @oninput="e => rv.Naam = (string?)e.Value ?? string.Empty" @onkeydown="RijToets" /></label>
                @if (_metWie)
                {
                    <div class="cs-veld"><span>Wie (werknemers)</span>
                        <div class="plb-wiekeuze">
                            @foreach (var w in rv.Werknemers)
                            {
                                <span class="plb-wielapje" title="@_persoon.GetValueOrDefault(w)?.Naam">@Kort(w)
                                    <button type="button" aria-label="@("Weghalen: " + Kort(w))" title="Weghalen" @onclick="() => rv.Werknemers.Remove(w)">×</button></span>
                            }
                            @* de sleutel maakt de lijst na elke keuze opnieuw, zodat hij weer op "+ werknemer…" staat *@
                            <select @key="@("wie" + rv.Werknemers.Count)" value="" @onchange="e => WieErbij(rv, e)" aria-label="Een werknemer toevoegen">
                                <option value="">+ werknemer…</option>
                                @foreach (var p in _personen.Where(p => p.InDienst && !rv.Werknemers.Contains(p.Id)))
                                {
                                    <option value="@p.Id" title="@p.Naam">@p.Kort</option>
                                }
                            </select>
                        </div>
                    </div>
                }
                <label class="cs-veld"><span>@(_metWie ? "Wie anders (geen werknemer: Werkplaats, vacature, leverancier…)" : "Wie (mag leeg)")</span>
                    <input value="@rv.Resource" maxlength="100" list="plb-wie" @oninput="e => rv.Resource = (string?)e.Value ?? string.Empty" @onkeydown="RijToets" />
                    <datalist id="plb-wie">@foreach (var w in _wie) { <option value="@w" /> }</datalist></label>
                @if (_metKleur)
                {
                    <div class="cs-veld"><span>Kleur</span>
                        <div class="plb-kleuren" role="group" aria-label="Kleur">
                            @foreach (var (naam, hex) in Planbord.Rijkleuren)
                            {
                                <button type="button" class="@(rv.Kleur == hex ? "gekozen" : "")" style="@("background:" + hex)" title="@naam" aria-label="@naam" @onclick="() => rv.Kleur = hex"></button>
                            }
                            <button type="button" class="geen @(rv.Kleur.Length == 0 ? "gekozen" : "")" title="Geen kleur" aria-label="Geen kleur" @onclick="() => rv.Kleur = string.Empty">✕</button>
                        </div>
                    </div>
                }
                <div class="cs-knoppen">
                    <button type="button" class="primair" disabled="@(_bezig || rv.Naam.Trim().Length == 0)" @onclick="BewaarRij">Bewaren</button>
                    <button type="button" class="klein" disabled="@_bezig" @onclick="() => _rijVenster = null">Annuleren</button>
                </div>
            </div>
        </div>
    </div>
}

@* ----- de namen uit de vrije tekst (Tom's Planner) aan werknemers koppelen (stap 4) ----- *@
@if (_namenVenster is { } nv)
{
    <div class="cmdk-overlay midden">
        <div class="factuurvenster cs-venster plb-namenvenster">
            <header class="bijlagekop"><h2>Namen koppelen aan werknemers</h2></header>
            <div class="factuurvenster-inhoud" @onkeydown='e => { if (e.Key == "Escape") _namenVenster = null; }'>
                <p class="uitleg">Dit zijn de namen die nog als tekst bij Wie staan. Kies per naam de werknemer; waar het duidelijk is, is dat al ingevuld.
                    Laat leeg wat geen werknemer is (Werkplaats, een vacature, een leverancier): dat blijft als tekst staan.</p>
                <div class="plb-namen">
                    @foreach (var n in nv)
                    {
                        <label @key="n.Naam">
                            <span class="plb-namennaam" title="@n.Naam">@n.Naam</span>
                            <span class="plb-namenaantal">@n.Aantal×</span>
                            <select value="@(n.Werknemer?.ToString() ?? string.Empty)" @onchange="e => n.Werknemer = int.TryParse((string?)e.Value, out var w) ? w : null">
                                <option value="">— niet koppelen —</option>
                                @foreach (var p in _personen.Where(p => p.InDienst || p.Id == n.Werknemer))
                                {
                                    <option value="@p.Id" title="@p.Naam">@p.Kort@(p.Kort == p.Naam ? "" : " (" + p.Naam + ")")</option>
                                }
                            </select>
                        </label>
                    }
                </div>
                <div class="cs-knoppen">
                    <button type="button" class="primair" disabled="@(_bezig || nv.All(n => n.Werknemer is null))" @onclick="KoppelNamen">Koppelen (@nv.Count(n => n.Werknemer is not null) van @nv.Count namen)</button>
                    <button type="button" class="klein" disabled="@_bezig" @onclick="() => _namenVenster = null">Annuleren</button>
                </div>
            </div>
        </div>
    </div>
}

@* ----- een rij koppelen aan een project, werkorder of klant (stap 3) ----- *@
@if (_koppelVenster is { } kv)
{
    <div class="cmdk-overlay midden">
        <div class="factuurvenster cs-venster">
            <header class="bijlagekop"><h2>Koppelen: @kv.Rij.Naam</h2></header>
            <div class="factuurvenster-inhoud" @onkeydown='e => { if (e.Key == "Escape") _koppelVenster = null; }'>
                @if (kv.Rij.Gekoppeld)
                {
                    <p class="plb-koppelnu">Nu gekoppeld aan <b>@kv.Rij.KoppelTekst</b>
                        <button type="button" class="klein" disabled="@_bezig" @onclick="Ontkoppel">Ontkoppelen</button></p>
                }
                <div class="plb-koppelsoort" role="radiogroup" aria-label="Waaraan koppelen">
                    @foreach (var (code, naam) in KoppelSoorten)
                    {
                        <label><input type="radio" name="plb-koppelsoort" checked="@(kv.Soort == code)" @onchange="() => KoppelSoort(code)" /> @naam</label>
                    }
                </div>
                <label class="cs-veld"><span>Zoek @(kv.Soort == "klant" ? "een klant (minstens twee tekens)" : kv.Soort == "werkorder" ? "een werkorder: nummer, omschrijving of klant" : "een project: nummer of omschrijving")</span>
                    <input @ref="_koppelVeld" value="@kv.Zoek" @oninput="KoppelZoek" autocomplete="off" /></label>
                <div class="plb-treffers">
                    @if (kv.Treffers.Count == 0)
                    {
                        <p class="uitleg">@(kv.Zoekt ? "Zoeken…" : kv.Soort == "klant" && kv.Zoek.Trim().Length < 2 ? "Typ een deel van de naam." : "Niets gevonden.")</p>
                    }
                    @foreach (var t in kv.Treffers)
                    {
                        <button type="button" @key="t.Id" disabled="@_bezig" @onclick="() => KiesKoppel(t)">
                            @if (t.Nummer.Length > 0) { <b>@t.Nummer</b> }
                            <span>@t.Naam</span>
                        </button>
                    }
                </div>
                <div class="cs-knoppen">
                    <button type="button" class="klein" disabled="@_bezig" @onclick="() => _koppelVenster = null">Sluiten</button>
                </div>
            </div>
        </div>
    </div>
}

@* ----- een balk of symbool ----- *@
@if (_itemVenster is { } iv)
{
    <div class="cmdk-overlay midden">
        <div class="factuurvenster cs-venster">
            <header class="bijlagekop"><h2>@(iv.Id == 0 ? "Nieuw" : "Wijzigen"): @(iv.Symbool ? "symbool" : "balk") op @(_opId.GetValueOrDefault(iv.RijId)?.Naam)</h2></header>
            <div class="factuurvenster-inhoud">
                <div class="cs-veld"><span>Soort</span>
                    <div class="plb-soorten">
                        @foreach (var s in iv.Symbool ? Planbord.Symboolsoorten : Planbord.Balksoorten)
                        {
                            var soort = s;
                            <button type="button" class="@(iv.Legenda == soort.Naam ? "gekozen" : "")" @onclick="() => { iv.Legenda = soort.Naam; iv.Kleur = soort.Kleur; }">
                                @if (iv.Symbool) { <span>@Teken(soort.Naam)</span> } else { <i style="@($"background:{soort.Kleur}")"></i> }
                                @soort.Naam
                            </button>
                        }
                    </div>
                </div>
                <div class="plb-datums">
                    <label class="cs-veld"><span>@(iv.Symbool ? "Datum" : "Van")</span>
                        <input type="date" value="@iv.Van.ToString("yyyy-MM-dd")" @onchange="e => { if (DateTime.TryParse((string?)e.Value, out var d)) iv.Van = d; }" /></label>
                    <label class="cs-veld"><span>Dagdeel</span>
                        <select value="@(iv.VanMiddag ? "m" : "o")" @onchange='e => iv.VanMiddag = (string?)e.Value == "m"'>
                            <option value="o">vanaf de ochtend</option><option value="m">vanaf de middag</option></select></label>
                    @if (!iv.Symbool)
                    {
                        <label class="cs-veld"><span>Tot en met</span>
                            <input type="date" value="@iv.Tot.ToString("yyyy-MM-dd")" @onchange="e => { if (DateTime.TryParse((string?)e.Value, out var d)) iv.Tot = d; }" /></label>
                        <label class="cs-veld"><span>Dagdeel</span>
                            <select value="@(iv.TotMiddag ? "m" : "e")" @onchange='e => iv.TotMiddag = (string?)e.Value == "m"'>
                                <option value="e">hele dag</option><option value="m">tot de middag</option></select></label>
                    }
                </div>
                <label class="cs-veld"><span>Tekst op de balk (mag leeg)</span>
                    <input value="@iv.Label" maxlength="100" @oninput="e => iv.Label = (string?)e.Value ?? string.Empty" /></label>
                <label class="cs-veld"><span>Opmerking (mag leeg; staat in het wolkje)</span>
                    <input value="@iv.Opmerking" maxlength="500" @oninput="e => iv.Opmerking = (string?)e.Value ?? string.Empty" /></label>
                <div class="cs-knoppen">
                    <button type="button" class="primair" disabled="@_bezig" @onclick="BewaarItem">Bewaren</button>
                    <button type="button" class="klein" disabled="@_bezig" @onclick="() => _itemVenster = null">Annuleren</button>
                    @if (iv.Id != 0)
                    {
                        <span style="flex:1"></span>
                        <button type="button" class="klein plb-wis" disabled="@_bezig" @onclick="WisItem">Verwijderen</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private static readonly CultureInfo Nl = new("nl-NL");

    private bool _geladen, _tabel, _fout, _bezig, _ookVoorbij, _importOpen;
    private string? _melding;
    private string _zoek = "";
    private List<PlanRij> _rijen = new(), _top = new();
    private Dictionary<int, List<PlanRij>> _kinderen = new();
    private Dictionary<int, PlanRij> _opId = new();
    private Dictionary<int, List<PlanItem>> _items = new();
    private Dictionary<int, DateTime> _laatste = new();      // per rij: het laatste einde van hemzelf en alles eronder
    private List<(string Naam, string Kleur)> _legenda = new();
    private List<string> _symbolen = new();
    private readonly HashSet<int> _open = new();
    private DateTime _van = Maandag(DateTime.Today.AddDays(-28));
    private int _weken = 26;
    private PlanImport? _import;
    private int _invoer;

    private DateTime Tot => _van.AddDays(_weken * 7);
    private bool Zoekt => _zoek.Trim().Length >= 2;
    /// <summary>De export overzetten: de Directie. In de testversie (alles in het geheugen, geen login) ook.</summary>
    private bool MagImporteren => Ik.Mag("Directie") || (!Ik.Ingelogd && !Ik.IsWerkplek);

    private static DateTime Maandag(DateTime d) => d.Date.AddDays(-(((int)d.DayOfWeek + 6) % 7));
    private static string Pct(double deel, double geheel) => (deel / geheel * 100).ToString("0.###", CultureInfo.InvariantCulture) + "%";
    private void Meld(string tekst, bool fout = false) { _melding = tekst; _fout = fout; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Ik.ZorgGeladenAsync();
            _tabel = Bord.Beschikbaar && await Bord.AanwezigAsync();
            if (_tabel) await Laad();
        }
        catch (Exception ex) { Meld("Laden is niet gelukt: " + ex.GetBaseException().Message, true); }
        _geladen = true;
    }

    private async Task Laad()
    {
        var (rijen, items) = await Bord.AllesAsync();
        _rijen = rijen;
        _opId = rijen.ToDictionary(r => r.Id);
        // een rij waarvan de ouder niet bestaat hoort bovenaan, anders is hij onvindbaar
        _top = rijen.Where(r => r.OuderId is not int o || !_opId.ContainsKey(o)).ToList();
        _kinderen = rijen.Where(r => r.OuderId is int o && _opId.ContainsKey(o)).GroupBy(r => r.OuderId!.Value).ToDictionary(g => g.Key, g => g.ToList());
        _items = items.GroupBy(i => i.RijId).ToDictionary(g => g.Key, g => g.OrderBy(i => i.Start).ToList());
        _laatste = new();
        foreach (var r in _top) Laatste(r.Id, 0);
        // het bereik van de schuifbalk: van de eerste tot de laatste balk, en in elk geval van vier weken terug tot een half jaar vooruit
        var eerste = Maandag(DateTime.Today.AddDays(-28)); var einde = DateTime.Today.AddDays(26 * 7);
        foreach (var i in items)
        {
            if (i.Start < eerste) eerste = Maandag(i.Start);
            if ((i.Einde ?? i.Start) > einde) einde = i.Einde ?? i.Start;
        }
        _bereikVan = eerste; _bereikTot = Maandag(einde).AddDays(7);
        _legenda = items.Where(i => !i.Symbool && i.Legenda.Length > 0).GroupBy(i => i.Legenda).OrderByDescending(g => g.Count())
                        .Select(g => (g.Key, Kleur(g.First().Kleur))).ToList();
        _symbolen = items.Where(i => i.Symbool && i.Legenda.Length > 0).GroupBy(i => i.Legenda).OrderByDescending(g => g.Count()).Select(g => g.Key).ToList();
        _metKleur = await Bord.KleurAanwezigAsync();
        _metWie = await Bord.WieAanwezigAsync();
        try { _personen = _metWie ? await Bord.PersonenAsync() : new(); } catch { _personen = new(); }
        _persoon = _personen.ToDictionary(p => p.Id);
        _losseNamen = rijen.SelectMany(r => Planbord.Namen(r.Resource)).Distinct(StringComparer.OrdinalIgnoreCase).Count();
        _wie = rijen.Select(r => r.Resource).Where(w => w.Length > 0).GroupBy(w => w, StringComparer.OrdinalIgnoreCase)
                    .OrderByDescending(g => g.Count()).Take(80).Select(g => g.Key).OrderBy(w => w).ToList();
    }

    /// <summary>Het laatste moment waarop in deze rij of eronder nog iets staat (om oude groepen weg te laten).</summary>
    private DateTime Laatste(int id, int diepte)
    {
        var max = _items.TryGetValue(id, out var l) ? l.Max(i => i.Einde ?? i.Start) : DateTime.MinValue;
        if (diepte < 20 && _kinderen.TryGetValue(id, out var k))
            foreach (var kind in k) { var m = Laatste(kind.Id, diepte + 1); if (m > max) max = m; }
        return _laatste[id] = max;
    }

    // ------------------------------------------------------------------ welke rijen in beeld

    private bool Past(PlanRij r, string q) => r.Naam.Contains(q, StringComparison.OrdinalIgnoreCase) || WieVoluit(r).Contains(q, StringComparison.OrdinalIgnoreCase)
                                             || WieTekst(r).Contains(q, StringComparison.OrdinalIgnoreCase);

    // ---- wie: gekoppelde werknemers en de vrije tekst (stap 4, 25-11-2026) ----

    private bool _metWie, _metKleur;

    /// <summary>De tekstkleur op een volle rijkleur: wit, of donker op een lichte kleur (geel, oranje).</summary>
    private static string Leesbaar(string hex)
    {
        if (hex.Length != 7 || !int.TryParse(hex.AsSpan(1), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out var rgb)) return "inherit";
        var licht = 0.299 * (rgb >> 16 & 255) + 0.587 * (rgb >> 8 & 255) + 0.114 * (rgb & 255);
        return licht > 150 ? "#1f2933" : "#fff";
    }

    /// <summary>Een kleur uit het rechtermuismenu: meteen bewaren.</summary>
    private async Task KiesKleur(PlanRij r, string kleur)
    {
        _menu = null;
        await Doe(() => Bord.KleurAsync(r.Id, kleur));
    }
    private int _losseNamen;
    private List<PlanPersoon> _personen = new();
    private Dictionary<int, PlanPersoon> _persoon = new();

    private string Kort(int werknemer) => _persoon.TryGetValue(werknemer, out var p) ? p.Kort : "?";

    /// <summary>De kolom Wie: de gekoppelde werknemers (korte naam) en daarachter de vrije tekst.</summary>
    private string WieTekst(PlanRij r) => r.Werknemers.Count == 0 ? r.Resource
        : string.Join(", ", r.Werknemers.Select(Kort).OrderBy(n => n, StringComparer.CurrentCultureIgnoreCase).Concat(r.Resource.Length > 0 ? new[] { r.Resource } : Array.Empty<string>()));

    private string WieVoluit(PlanRij r) => r.Werknemers.Count == 0 ? r.Resource
        : string.Join(", ", r.Werknemers.Select(w => _persoon.TryGetValue(w, out var p) ? p.Naam : "?").OrderBy(n => n, StringComparer.CurrentCultureIgnoreCase)
                                        .Concat(r.Resource.Length > 0 ? new[] { r.Resource } : Array.Empty<string>()));

    private void WieErbij(RijInvoer rv, ChangeEventArgs e)
    {
        if (int.TryParse((string?)e.Value, out var w) && !rv.Werknemers.Contains(w)) rv.Werknemers.Add(w);
    }

    private class NaamKeuze { public string Naam = ""; public int Aantal; public int? Werknemer; }
    private List<NaamKeuze>? _namenVenster;

    /// <summary>Het venster met alle namen die nog als tekst bij Wie staan, vaakst gebruikte bovenaan, met een voorstel waar dat duidelijk is.</summary>
    private void BeginNamen()
    {
        if (!MagPlannen) return;
        _namenVenster = _rijen.SelectMany(r => Planbord.Namen(r.Resource)).GroupBy(n => n, StringComparer.OrdinalIgnoreCase)
            .Select(g => new NaamKeuze { Naam = g.Key, Aantal = g.Count(), Werknemer = Planbord.Voorstel(g.Key, _personen) })
            .OrderByDescending(n => n.Aantal).ThenBy(n => n.Naam).ToList();
    }

    private async Task KoppelNamen()
    {
        if (_namenVenster is not { } nv || _bezig) return;
        var keuze = nv.Where(n => n.Werknemer is not null).ToDictionary(n => n.Naam, n => n.Werknemer!.Value, StringComparer.OrdinalIgnoreCase);
        if (keuze.Count == 0) return;
        if (!await JS.InvokeAsync<bool>("mdeBevestig", $"{keuze.Count} namen worden op alle rijen een gekoppelde werknemer en verdwijnen daar uit de tekst. Dat is niet in één keer terug te draaien.",
                                        new { kop = "Namen koppelen?", ja = "Koppelen" })) return;
        var aantal = 0;
        if (await Doe(async () => aantal = await Bord.KoppelNamenAsync(keuze))) { _namenVenster = null; Meld($"Op {aantal} rijen zijn werknemers gekoppeld."); }
    }

    /// <summary>De rijen die in beeld staan, in de volgorde van de boom. Bij zoeken: wat past, met de groepen erboven en alles eronder.</summary>
    private IEnumerable<(PlanRij R, int Diepte)> Zichtbaar()
    {
        var grens = DateTime.Today.AddDays(-28);
        HashSet<int>? raak = null;
        if (Zoekt)
        {
            var q = _zoek.Trim();
            raak = new HashSet<int>();
            foreach (var r in _rijen.Where(r => Past(r, q)))
                for (var x = r; x is not null && raak.Add(x.Id); x = x.OuderId is int o && _opId.TryGetValue(o, out var ouder) ? ouder : null) { }
        }
        foreach (var r in _top)
        {
            // voorbij = er staat wel iets in, maar niets meer in de laatste vier weken of later; een lege groep blijft staan
            var laatste = _laatste.GetValueOrDefault(r.Id);
            if (!_ookVoorbij && raak is null && laatste != DateTime.MinValue && laatste < grens) continue;
            foreach (var x in Tak(r, 1, raak, onderTreffer: false)) yield return x;
        }
    }

    private IEnumerable<(PlanRij R, int Diepte)> Tak(PlanRij r, int diepte, HashSet<int>? raak, bool onderTreffer)
    {
        if (raak is not null && !onderTreffer && !raak.Contains(r.Id)) yield break;
        yield return (r, diepte);
        if (diepte > 20 || !_kinderen.TryGetValue(r.Id, out var kinderen)) yield break;
        if (raak is null && !_open.Contains(r.Id)) yield break;
        // onder een rij die zelf past staat alles; anders alleen de takken waar een treffer in zit
        var zelf = raak is not null && (onderTreffer || Past(r, _zoek.Trim()));
        foreach (var k in kinderen)
            foreach (var x in Tak(k, diepte + 1, raak, zelf)) yield return x;
    }

    private void Wissel(int id) { if (!_open.Remove(id)) _open.Add(id); }
    private void AllesDicht() { _open.Clear(); _zoek = ""; }
    private DateTime _bereikVan = Maandag(DateTime.Today.AddDays(-28)), _bereikTot = Maandag(DateTime.Today.AddDays(27 * 7));
    /// <summary>De schuifbalk onder het bord, in weken: 0 = de eerste balk van de planning links in beeld, het einde = de laatste rechts.</summary>
    private int SchuifMax => Math.Max(0, (int)(_bereikTot - _bereikVan).TotalDays / 7 - _weken);
    private int SchuifStand => Math.Clamp((int)(_van - _bereikVan).TotalDays / 7, 0, SchuifMax);

    private void Schuif(int weken) => _van = _van.AddDays(weken * 7);
    private void Vandaag() => _van = Maandag(DateTime.Today.AddDays(-28));

    // ------------------------------------------------------------------ plek op de tijdbalk

    /// <summary>
    /// Een tijdstip als dagen vanaf het begin van het tijdvak. Tom's Planner rekent in werkdagen van 8:00 tot 17:00:
    /// 's ochtends = begin van de dag, 12:30 = halverwege, 17:00 = het eind van de dag.
    /// </summary>
    private double Pos(DateTime t, bool einde = false)
    {
        var deel = t.Hour < 10 ? 0.0 : t.Hour < 15 ? 0.5 : 1.0;
        if (einde && deel == 0) deel = t.TimeOfDay == TimeSpan.Zero ? 1.0 : 0.0;      // een einde zonder tijd telt de hele dag mee
        return (t.Date - _van).TotalDays + deel;
    }

    private string? VandaagPct()
    {
        var p = (DateTime.Today - _van).TotalDays + 0.5;
        return p < 0 || p > _weken * 7 ? null : Pct(p, _weken * 7);
    }

    /// <summary>De maanden in het tijdvak, elk met het aantal dagen dat ervan in beeld is.</summary>
    private IEnumerable<(string Naam, double Dagen)> Maanden()
    {
        for (var d = _van; d < Tot;)
        {
            var volgende = new DateTime(d.Year, d.Month, 1).AddMonths(1);
            var eind = volgende < Tot ? volgende : Tot;
            var dagen = (eind - d).TotalDays;
            yield return (dagen >= 12 || _weken > 60 ? d.ToString(_weken > 60 ? "MMM yy" : "MMMM yyyy", Nl) : "", dagen);
            d = eind;
        }
    }

    /// <summary>Voor een dichtgeklapte groep: de stukken van het tijdvak waarin eronder iets gepland staat, aan elkaar geregen.</summary>
    private List<(double Van, double Tot)> Samenvatting(int id)
    {
        var stukken = new List<(double, double)>();
        void Verzamel(int rij, int diepte)
        {
            if (diepte > 20 || !_kinderen.TryGetValue(rij, out var kinderen)) return;
            foreach (var k in kinderen)
            {
                if (_items.TryGetValue(k.Id, out var lijst))
                    foreach (var it in lijst.Where(i => !i.Symbool))
                    {
                        double a = Math.Max(0, Pos(it.Start)), b = Math.Min(_weken * 7, Pos(it.Einde ?? it.Start, einde: true));
                        if (b > a) stukken.Add((a, b));
                    }
                Verzamel(k.Id, diepte + 1);
            }
        }
        Verzamel(id, 0);
        var uit = new List<(double Van, double Tot)>();
        foreach (var (a, b) in stukken.OrderBy(s => s.Item1))
        {
            if (uit.Count > 0 && a <= uit[^1].Tot + 0.01) uit[^1] = (uit[^1].Van, Math.Max(uit[^1].Tot, b));
            else uit.Add((a, b));
        }
        return uit;
    }

    // ------------------------------------------------------------------ opmaak van een balk of symbool

    /// <summary>De kleur uit de export, alleen als het echt een kleur is (hij gaat de opmaak in); anders grijs.</summary>
    private static string Kleur(string kleur)
        => kleur.Length == 7 && kleur[0] == '#' && kleur.Skip(1).All(Uri.IsHexDigit) ? kleur : "#9a9a99";

    private static string Teken(string legenda) => legenda.ToLowerInvariant() switch
    {
        "milestone" => "🚩",
        "delivery" => "⚠️",
        "customer dependency" => "🕒",
        "m-pede robotics bestellen" => "📣",
        "m-pede robot benodigd" => "🟢",
        _ => "◆",
    };

    private static string Moment(DateTime t) => t.ToString(t.Hour is >= 10 and < 15 ? "ddd d-M-yyyy '(middag)'" : "ddd d-M-yyyy", Nl);

    private static string Uitleg(PlanItem it)
        => (it.Legenda.Length > 0 ? it.Legenda + ": " : "") + Moment(it.Start) + (it.Einde is DateTime e && e.Date != it.Start.Date ? " t/m " + Moment(e) : "")
           + (it.Label.Length > 0 ? " · " + it.Label : "") + (it.Opmerking.Length > 0 ? " · " + it.Opmerking : "");

    // ------------------------------------------------------------------ de export van Tom's Planner

    private async Task LeesBestand(InputFileChangeEventArgs e)
    {
        _import = null;
        try
        {
            if (e.File.Size > 20_000_000) { Meld("Dit bestand is te groot voor een export van de planning.", true); return; }
            using var m = new MemoryStream();
            await using (var s = e.File.OpenReadStream(20_000_000)) await s.CopyToAsync(m);
            _import = Planbord.LeesExport(System.Text.Encoding.UTF8.GetString(m.ToArray()));
            _melding = null;
        }
        catch (Exception ex) { Meld("Het bestand lezen is niet gelukt: " + ex.GetBaseException().Message, true); }
        _invoer++;
    }

    private async Task ZetOver()
    {
        if (_import is not { } im || _bezig || !MagImporteren) return;
        try
        {
            if (_rijen.Count > 0 && !await JS.InvokeAsync<bool>("mdeBevestig",
                    $"De planning in de app ({_rijen.Count} rijen) wordt vervangen door dit bestand ({im.Rijen.Count} rijen). Doorgaan?",
                    new { kop = "⚠ Planning vervangen", ja = "Vervangen" })) return;
        }
        catch { return; }
        _bezig = true;
        try
        {
            await Bord.ZetOverAsync(im);
            _import = null; _importOpen = false; _open.Clear();
            await Laad();
            Meld($"De planning is overgezet: {_top.Count} groepen en {_rijen.Count} rijen.");
        }
        catch (Exception ex) { Meld("Overzetten is niet gelukt: " + ex.GetBaseException().Message, true); }
        _bezig = false;
    }

    // ================================================================== bewerken (stap 2, 25-11-2026)

    /// <summary>De planning wijzigen: het recht Planner of Directie. In de testversie (alles in het geheugen, geen login) ook.</summary>
    private bool MagPlannen => Ik.MagPlannen || (!Ik.Ingelogd && !Ik.IsWerkplek);

    private record MenuPlek(PlanRij Rij, int X, int Y);
    private MenuPlek? _menu;
    private class RijInvoer { public int Id; public int? OuderId, NaId; public string Naam = "", Resource = "", Kleur = ""; public List<int> Werknemers = new(); }
    private RijInvoer? _rijVenster;
    private class ItemInvoer
    {
        public int Id, RijId; public bool Symbool, VanMiddag, TotMiddag;
        public DateTime Van, Tot; public string Legenda = "", Kleur = "", Label = "", Opmerking = "";
    }
    private ItemInvoer? _itemVenster;
    private List<string> _wie = new();
    private ElementReference _naamVeld;
    private bool _focusNaam, _eigen;
    private DotNetObjectReference<PlanbordPagina>? _ref;
    private PlanRij? _sleeptRij;
    private int? _sleepOp, _sleepVoor;

    protected override async Task OnAfterRenderAsync(bool eerste)
    {
        if (eerste)
        {
            Bord.Gewijzigd += BijWijziging;
            // het slepen van balken doet de browser (mdePlan in App.razor); hij meldt hier alleen de uitkomst
            try { _ref = DotNetObjectReference.Create(this); await JS.InvokeVoidAsync("mdePlan.koppel", _ref); } catch { }
        }
        if (_focusNaam && _rijVenster is not null)
        {
            _focusNaam = false;
            try { await _naamVeld.FocusAsync(); } catch { }
        }
        if (_focusKoppel && _koppelVenster is not null)
        {
            _focusKoppel = false;
            try { await _koppelVeld.FocusAsync(); } catch { }
        }
    }

    /// <summary>Een ander scherm (of een collega) heeft de planning gewijzigd: opnieuw lezen.</summary>
    private void BijWijziging()
    {
        if (_eigen) return;
        _ = InvokeAsync(async () => { try { await Laad(); StateHasChanged(); } catch { } });
    }

    /// <summary>Een wijziging uitvoeren en daarna de planning opnieuw lezen; een fout komt als melding in beeld.</summary>
    private async Task<bool> Doe(Func<Task> actie)
    {
        if (!MagPlannen) return false;
        _eigen = true; _bezig = true;
        try { await actie(); await Laad(); return true; }
        catch (Exception ex) { Meld(ex.GetBaseException().Message, true); try { await Laad(); } catch { } return false; }
        finally { _eigen = false; _bezig = false; }
    }

    private void OpenMenu(MouseEventArgs e, PlanRij r) { if (MagPlannen) _menu = new MenuPlek(r, (int)e.ClientX, (int)e.ClientY); }

    // ---- rijen ----

    /// <summary>Het venster voor een nieuwe rij (onder ouderId, na de buur naId) of voor het wijzigen van een bestaande.</summary>
    private void BeginRij(PlanRij? bestaand, int? ouderId, int? naId)
    {
        if (!MagPlannen) return;
        _rijVenster = bestaand is null ? new RijInvoer { OuderId = ouderId, NaId = naId }
            : new RijInvoer { Id = bestaand.Id, OuderId = bestaand.OuderId, Naam = bestaand.Naam, Resource = bestaand.Resource, Kleur = bestaand.Kleur, Werknemers = bestaand.Werknemers.ToList() };
        _focusNaam = true;
    }

    private async Task RijToets(KeyboardEventArgs e) { if (e.Key == "Enter") await BewaarRij(); }

    private async Task BewaarRij()
    {
        if (_rijVenster is not { } rv || _bezig || rv.Naam.Trim().Length == 0) return;
        var gelukt = await Doe(async () =>
        {
            if (rv.Id != 0) await Bord.WijzigRijAsync(rv.Id, rv.Naam, rv.Resource, _metWie ? rv.Werknemers : null, _metKleur ? rv.Kleur : null);
            else
            {
                await Bord.NieuweRijAsync(rv.OuderId, rv.NaId, rv.Naam, rv.Resource, _metWie ? rv.Werknemers : null, _metKleur ? rv.Kleur : null);
                if (rv.OuderId is int o) _open.Add(o);
            }
        });
        if (gelukt) _rijVenster = null;
    }

    // ---- koppelen aan een project, werkorder of klant (stap 3, 25-11-2026; zoals het Activity board) ----

    private sealed record Treffer(int Id, string Nummer, string Naam, int? ProjectId);
    private class KoppelInvoer { public PlanRij Rij = null!; public string Soort = "project", Zoek = ""; public List<Treffer> Treffers = new(); public bool Zoekt; }
    private static readonly (string Code, string Naam)[] KoppelSoorten = { ("project", "Project"), ("werkorder", "Werkorder"), ("klant", "Klant") };
    private const int KoppelAantal = 40;
    private KoppelInvoer? _koppelVenster;
    private ElementReference _koppelVeld;
    private bool _focusKoppel;
    private CancellationTokenSource? _koppelStop;

    private async Task BeginKoppel(PlanRij r)
    {
        _menu = null;
        if (!MagPlannen) return;
        _koppelVenster = new KoppelInvoer { Rij = r, Soort = r.WerkorderId is not null ? "werkorder" : r.RelatieId is not null ? "klant" : "project" };
        _focusKoppel = true;
        await KoppelLijst("");
    }

    private async Task KoppelSoort(string soort)
    {
        if (_koppelVenster is not { } kv) return;
        kv.Soort = soort; kv.Treffers = new(); _focusKoppel = true;
        await KoppelLijst(kv.Zoek.Trim());
    }

    /// <summary>Zonder zoektekst: de nieuwste projecten of de open werkorders; een klant pas vanaf twee tekens.</summary>
    private async Task<List<Treffer>> HaalTreffers(string soort, string q)
    {
        var lijst = q.Length < 2;
        if (soort == "klant")
            return lijst ? new() : (await Relaties.ZoekAsync(q, alleenKlanten: true, alleenLeveranciers: false, 0, KoppelAantal)).Select(k => new Treffer(k.Id, "", k.Naam, null)).ToList();
        if (soort == "werkorder")
            return (await Uren.ZoekWerkordersAsync(lijst ? "" : q, alleenOpen: lijst, KoppelAantal))
                .Select(w => new Treffer(w.WerkbonId, w.Nummer, w.Omschrijving + (w.Klant.Length > 0 ? " · " + w.Klant : ""), null)).ToList();
        return (await Projecten.ZoekProjectenAsync(null, lijst ? null : q, null, 0, KoppelAantal))
            .Select(p => new Treffer(p.Id, p.Nummer?.ToString() ?? "", p.Omschrijving, p.Id)).ToList();
    }

    private async Task KoppelLijst(string q)
    {
        if (_koppelVenster is not { } kv) return;
        var soort = kv.Soort;
        kv.Zoekt = true;
        try
        {
            var gevonden = await HaalTreffers(soort, q);
            if (_koppelVenster == kv && kv.Soort == soort) kv.Treffers = gevonden;
        }
        catch (Exception ex) { kv.Treffers = new(); Meld("Zoeken is niet gelukt: " + ex.GetBaseException().Message, true); }
        kv.Zoekt = false;
    }

    private async Task KoppelZoek(ChangeEventArgs e)
    {
        if (_koppelVenster is not { } kv) return;
        kv.Zoek = (string?)e.Value ?? "";
        _koppelStop?.Cancel();
        var stop = _koppelStop = new CancellationTokenSource();
        try { await Task.Delay(250, stop.Token); } catch (TaskCanceledException) { return; }
        await KoppelLijst(kv.Zoek.Trim());
    }

    private async Task KiesKoppel(Treffer t)
    {
        if (_koppelVenster is not { } kv || _bezig) return;
        var s = kv.Soort;
        var gelukt = await Doe(() => Bord.KoppelAsync(kv.Rij.Id, s == "project" ? t.Id : null, s == "klant" ? t.Id : null, s == "werkorder" ? t.Id : null,
                                                      t.Nummer, t.Naam, t.ProjectId));
        if (gelukt) { _koppelVenster = null; Meld($"{kv.Rij.Naam} is gekoppeld aan {(s == "project" ? "project" : s == "werkorder" ? "werkorder" : "klant")} {(t.Nummer.Length > 0 ? t.Nummer : t.Naam)}."); }
    }

    private async Task Ontkoppel()
    {
        if (_koppelVenster is not { } kv || _bezig) return;
        if (await Doe(() => Bord.KoppelAsync(kv.Rij.Id, null, null, null))) { _koppelVenster = null; Meld($"{kv.Rij.Naam} is niet meer gekoppeld."); }
    }

    private async Task WisRij(PlanRij r)
    {
        _menu = null;
        if (!MagPlannen) return;
        var eronder = Onder(r.Id).Count();
        var balken = (_items.GetValueOrDefault(r.Id)?.Count ?? 0) + Onder(r.Id).Sum(x => _items.GetValueOrDefault(x.Id)?.Count ?? 0);
        try
        {
            if (!await JS.InvokeAsync<bool>("mdeBevestig",
                    $"{r.Naam} verwijderen" + (eronder > 0 ? $", met de {eronder} rij{(eronder == 1 ? "" : "en")} eronder" : "") +
                    (balken > 0 ? $" en {balken} balk{(balken == 1 ? "" : "en")} of symbolen" : "") + "? Dit is niet terug te draaien.",
                    new { kop = "⚠ Rij verwijderen", ja = "Verwijderen" })) return;
        }
        catch { return; }
        if (await Doe(() => Bord.VerwijderRijAsync(r.Id))) Meld($"{r.Naam} is verwijderd.");
    }

    /// <summary>Alle rijen onder deze rij.</summary>
    private IEnumerable<PlanRij> Onder(int id, int diepte = 0)
    {
        if (diepte > 20 || !_kinderen.TryGetValue(id, out var k)) yield break;
        foreach (var kind in k)
        {
            yield return kind;
            foreach (var x in Onder(kind.Id, diepte + 1)) yield return x;
        }
    }

    // ---- een rij verslepen: op een andere rij = eronder hangen, op de strook erboven = ervoor zetten ----

    private void BeginSleepRij(PlanRij r) { if (MagPlannen) { _sleeptRij = r; _sleepOp = null; _sleepVoor = null; } }
    private void EindeSleepRij() { _sleeptRij = null; _sleepOp = null; _sleepVoor = null; }

    private async Task LaatRijVallen(PlanRij doel, bool ervoor)
    {
        var rij = _sleeptRij;
        EindeSleepRij();
        if (rij is null || rij.Id == doel.Id) return;
        if (await Doe(() => ervoor ? Bord.VerplaatsRijAsync(rij.Id, doel.OuderId, doel.Id) : Bord.VerplaatsRijAsync(rij.Id, doel.Id, null)))
        {
            if (!ervoor) _open.Add(doel.Id);
            Meld(ervoor ? $"{rij.Naam} staat nu vóór {doel.Naam}." : $"{rij.Naam} hangt nu onder {doel.Naam}.");
        }
    }

    // ---- balken en symbolen ----

    private static bool IsMiddag(DateTime t) => t.Hour is >= 10 and < 15;

    private void OpenItem(PlanItem it)
    {
        if (!MagPlannen) return;
        var einde = it.Einde ?? it.Start;
        _itemVenster = new ItemInvoer
        {
            Id = it.Id, RijId = it.RijId, Symbool = it.Symbool, Van = it.Start.Date, VanMiddag = IsMiddag(it.Start),
            Tot = einde.Date, TotMiddag = IsMiddag(einde), Legenda = it.Legenda, Kleur = it.Kleur, Label = it.Label, Opmerking = it.Opmerking,
        };
    }

    /// <summary>Een nieuwe balk (een werkweek) of een nieuw symbool op deze rij; zonder dag: vandaag, of het begin van het tijdvak.</summary>
    private void NieuwItem(PlanRij r, bool symbool, DateTime? dag)
    {
        if (!MagPlannen) return;
        var van = dag ?? (DateTime.Today >= _van && DateTime.Today < Tot ? DateTime.Today : _van);
        var soort = symbool ? Planbord.Symboolsoorten[0] : Planbord.Balksoorten[0];
        // een werkweek lang, maar niet tot in het weekend: dan tot en met de vrijdag
        var tot = van.AddDays(4);
        while (tot > van && tot.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday) tot = tot.AddDays(-1);
        _itemVenster = new ItemInvoer { RijId = r.Id, Symbool = symbool, Van = van, Tot = tot, Legenda = soort.Naam, Kleur = soort.Kleur };
    }

    /// <summary>Dubbelklik op een lege plek van de tijdbalk: een nieuwe balk die op die dag begint.</summary>
    private async Task NieuwOpPlek(PlanRij r, MouseEventArgs e)
    {
        if (!MagPlannen) return;
        DateTime? dag = null;
        try
        {
            var breedte = await JS.InvokeAsync<double>("mdeBreedte", ".plb-kop .plb-tijd");
            if (breedte > 0) dag = _van.AddDays(Math.Clamp((int)(e.OffsetX / breedte * _weken * 7), 0, _weken * 7 - 1));
        }
        catch { }
        NieuwItem(r, false, dag);
    }

    private static DateTime Begin(DateTime dag, bool middag) => dag.Date.AddHours(middag ? 12.5 : 8);
    private static DateTime Eind(DateTime dag, bool middag) => dag.Date.AddHours(middag ? 12.5 : 17);

    private async Task BewaarItem()
    {
        if (_itemVenster is not { } iv || _bezig) return;
        var item = new PlanItem(iv.Id, iv.RijId, iv.Symbool, Begin(iv.Van, iv.VanMiddag), iv.Symbool ? null : Eind(iv.Tot, iv.TotMiddag),
                                iv.Legenda, iv.Kleur, iv.Label, iv.Opmerking);
        if (await Doe(() => Bord.BewaarItemAsync(item))) _itemVenster = null;
    }

    private async Task WisItem()
    {
        if (_itemVenster is not { } iv || iv.Id == 0) return;
        if (await Doe(() => Bord.VerwijderItemAsync(iv.Id))) _itemVenster = null;
    }

    private PlanItem? Item(int id) => _items.Values.SelectMany(l => l).FirstOrDefault(i => i.Id == id);

    /// <summary>Een balk of symbool is versleept (mdePlan): zoveel dagen opgeschoven, en misschien naar een andere rij.</summary>
    [JSInvokable]
    public async Task Versleep(int id, int dagen, int? rij)
    {
        if (Item(id) is not { } it) return;
        var naar = rij is int r && _opId.ContainsKey(r) ? r : it.RijId;
        if (dagen == 0 && naar == it.RijId) return;
        await InvokeAsync(async () =>
        {
            await Doe(() => Bord.BewaarItemAsync(it with { RijId = naar, Start = it.Start.AddDays(dagen), Einde = it.Einde?.AddDays(dagen) }));
            StateHasChanged();
        });
    }

    /// <summary>De linker- of rechterrand van een balk is versleept: hij wordt korter of langer (minstens een halve dag).</summary>
    [JSInvokable]
    public async Task VeranderRand(int id, bool links, int dagen)
    {
        if (Item(id) is not { } it || dagen == 0) return;
        if (it.Symbool || it.Einde is not DateTime einde) { await Versleep(id, dagen, null); return; }
        var nieuw = links ? it with { Start = it.Start.AddDays(dagen) } : it with { Einde = einde.AddDays(dagen) };
        if (nieuw.Einde <= nieuw.Start) nieuw = links ? nieuw with { Start = Begin(einde, IsMiddag(einde) ? false : true) } : nieuw with { Einde = Eind(it.Start, false) };
        await InvokeAsync(async () => { await Doe(() => Bord.BewaarItemAsync(nieuw)); StateHasChanged(); });
    }

    public void Dispose()
    {
        Bord.Gewijzigd -= BijWijziging;
        try { _ = JS.InvokeVoidAsync("mdePlan.los"); } catch { }
        _ref?.Dispose();
    }
