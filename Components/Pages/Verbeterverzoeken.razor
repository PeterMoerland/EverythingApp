@page "/verbeterverzoeken"
@inject IVerbeterRepository Repo
@inject HuidigeGebruiker Ik
@inject IMeldingRepository Meldingen
@inject MeldingSignaal Signaal

@* Beheer ▸ Verbeterverzoeken: ideeën en wensen van collega's (ingediend met het lampje 💡 in de bovenbalk, of hier
   met + Nieuw verzoek: wens gebruiker 22-10-2026; dan zonder pagina en zonder schermafdruk).
   Iedereen ziet de lijst; Directie past tekst, status en reactie aan (besluit gebruiker 22-10-2026).
   Onder elk verzoek kan een gesprek (wens collega 6-11-2026; VerbeterverzoekBerichten_MariaDB.sql), met een melding in de bel. *@

<PageTitle>Verbeterverzoeken — MDE</PageTitle>

<div class="page">
    <header class="topbar">
        <h1>Verbeterverzoeken</h1>
        <span class="weeklabel">@_lijst.Count(v => VerzoekStatus.IsOpen(v.Status)) open · @_lijst.Count(v => v.Status == VerzoekStatus.Gedaan) gedaan</span>
    </header>

    @if (!Repo.Beschikbaar)
    {
        <section class="module-placeholder"><p>Dit scherm werkt alleen met de live database.</p></section>
    }
    else if (!_tabel)
    {
        <section class="module-placeholder"><p>De tabel Verbeterverzoeken ontbreekt nog (Verbeterverzoeken_MariaDB.sql).</p></section>
    }
    else
    {
        @if (_melding is not null)
        {
            <div class="melding @(_fout ? "fout" : "ok")" @onclick="() => _melding = null">@_melding</div>
        }
        @if (MagIndienen)
        {
            <div class="verbeter-nieuw">
                @if (!_nieuwOpen)
                {
                    <button class="primair klein" @onclick="OpenNieuw">+ Nieuw verzoek</button>
                }
                else
                {
                    <textarea @ref="_nieuwVeld" class="verbeter-tekst" rows="4" maxlength="2000"
                              placeholder="Wat kan er beter? Welk scherm, wat gebeurt er nu, en wat zou je willen?"
                              value="@_nieuweTekst" @oninput="e => _nieuweTekst = (string?)e.Value ?? string.Empty"></textarea>
                    <div class="btngroup">
                        <small class="uitleg">Een schermafdruk meesturen kan met het lampje 💡 rechtsboven.</small>
                        <span style="flex:1"></span>
                        <button class="klein" @onclick="() => { _nieuwOpen = false; _nieuweTekst = string.Empty; }">Annuleren</button>
                        <button class="primair" disabled="@(_bezig || _nieuweTekst.Trim().Length < 3)" @onclick="Indienen">Toevoegen</button>
                    </div>
                }
            </div>
        }
        <p class="uitleg">
            Een idee of wens voor de app? Voeg het hierboven toe, of klik op het lampje 💡 rechtsboven (dat neemt de pagina en schermafdrukken mee). @(MagBeheren ? "Als Directie zet je hier de status en schrijf je een reactie; wijzigingen worden meteen opgeslagen." : "Directie bekijkt de verzoeken en zet hier de status.")
        </p>
        <div class="bankfilters">
            <label class="bankveld"><span>Tonen</span>
                <select value="@_filter" @onchange='e => _filter = (string?)e.Value ?? "open"'>
                    <option value="open">Open (nieuw, gepland, bezig)</option>
                    <option value="gedaan">Gedaan</option>
                    <option value="afgewezen">Afgewezen</option>
                    <option value="mijn">Mijn verzoeken</option>
                    <option value="alles">Alles</option>
                </select></label>
            <label class="bankveld prod-keuze"><span>Zoeken</span>
                <input value="@_zoek" placeholder="tekst, naam of pagina" @oninput="e => _zoek = (string?)e.Value ?? string.Empty" /></label>
        </div>

        <table class="kiezer-tabel verbeter-tabel">
            <thead>
                <tr>
                    <th style="width:7.5rem">Ingediend</th>
                    <th style="width:10rem">Door</th>
                    <th>Verzoek</th>
                    <th style="width:9rem">Status</th>
                    <th style="width:24%">Reactie</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Zichtbaar)
                {
                    <tr @key="v.Id" class="@(v.Status == VerzoekStatus.Gedaan ? "verbeter-gedaan" : "") @(v.Id == VerzoekUitUrl ? "verbeter-uitgelicht" : "")">
                        <td>@v.IngediendOp.ToString("dd-MM-yyyy")<br /><small class="uitleg">@v.IngediendOp.ToString("HH:mm")</small></td>
                        <td>@(v.IngediendDoor.Length > 0 ? v.IngediendDoor : "—")
                            @if (v.Werkplek.Length > 0) { <br /><small class="uitleg">👥 @v.Werkplek</small> }</td>
                        <td>
                            @if (MagBeheren)
                            {
                                <textarea class="verbeter-tekst" rows="2" value="@v.Tekst" @onchange="e => Wijzig(v, () => v.Tekst = (string?)e.Value ?? v.Tekst)"></textarea>
                            }
                            else
                            {
                                <span class="verbeter-tekst-lees">@v.Tekst</span>
                            }
                            @if (v.Pagina.Length > 1) { <br /><a class="uitleg" href="@v.Pagina.TrimStart('/')">@v.Pagina</a> }
                            @if (v.Schermafdrukken.Count > 0)
                            {
                                <div class="verbeter-shots">
                                    @foreach (var s in v.Schermafdrukken)
                                    {
                                        <a href="@($"bestand/{s}")" target="_blank" rel="noopener" title="Schermafdruk groot openen">
                                            <img src="@($"bestand/{s}")" alt="schermafdruk" loading="lazy" />
                                        </a>
                                    }
                                </div>
                            }
                            @if (_gesprekMogelijk)
                            {
                                var aantal = _aantal.GetValueOrDefault(v.Id);
                                <div>
                                    <button class="klein verbeter-gesprek-knop @(aantal > 0 ? "heeft" : "")"
                                            title="Verder praten over dit verzoek met collega's"
                                            @onclick="() => WisselGesprek(v.Id)">
                                        💬 @(_gesprekOpen.Contains(v.Id) ? "Gesprek sluiten" : aantal > 0 ? $"Gesprek ({aantal})" : "Bespreken")
                                    </button>
                                </div>
                            }
                        </td>
                        <td>
                            @if (MagBeheren)
                            {
                                <select value="@v.Status" class="verbeter-status" @onchange="e => Wijzig(v, () => v.Status = (string?)e.Value ?? v.Status)">
                                    @foreach (var s in VerzoekStatus.Alle) { <option value="@s">@s</option> }
                                </select>
                            }
                            else
                            {
                                <span class="stand-chip @VerzoekStatus.Kleur(v.Status)">@v.Status</span>
                            }
                            @if (v.GewijzigdOp is DateTime g) { <br /><small class="uitleg">@g.ToString("dd-MM") @(v.GewijzigdDoor.Length > 0 ? "· " + v.GewijzigdDoor : "")</small> }
                        </td>
                        <td>
                            @if (MagBeheren)
                            {
                                <textarea class="verbeter-tekst" rows="2" placeholder="reactie (zien alle collega's)" value="@v.Reactie"
                                          @onchange="e => Wijzig(v, () => v.Reactie = (string?)e.Value ?? string.Empty)"></textarea>
                            }
                            else
                            {
                                <span class="verbeter-tekst-lees">@v.Reactie</span>
                            }
                        </td>
                    </tr>
                    @if (_gesprekOpen.Contains(v.Id))
                    {
                        <tr @key="-v.Id" class="verbeter-gesprek-rij @(v.Id == VerzoekUitUrl ? "verbeter-uitgelicht" : "")">
                            <td></td>
                            <td colspan="4">
                                <div class="verbeter-gesprek">
                                    @if (!_berichten.TryGetValue(v.Id, out var berichten))
                                    {
                                        <small class="uitleg">Gesprek laden…</small>
                                    }
                                    else
                                    {
                                        @if (berichten.Count == 0)
                                        {
                                            <small class="uitleg">Nog geen berichten. Schrijf als eerste wat je van dit voorstel vindt.</small>
                                        }
                                        @foreach (var b in berichten)
                                        {
                                            <div class="verbeter-bericht @(b.DoorId is int d && d == Ik.WerknemerId ? "eigen" : "")" @key="b.Id">
                                                <div class="verbeter-bericht-kop"><b>@Afzender(b)</b> <small class="uitleg">@b.Op.ToString("dd-MM-yyyy HH:mm")</small></div>
                                                <div class="verbeter-tekst-lees">@b.Tekst</div>
                                            </div>
                                        }
                                    }
                                    @if (MagIndienen)
                                    {
                                        var id = v.Id;
                                        <div class="verbeter-gesprek-invoer">
                                            <textarea class="verbeter-tekst" rows="2" maxlength="2000"
                                                      placeholder="Schrijf een bericht… (Ctrl+Enter = versturen)"
                                                      value="@_concept.GetValueOrDefault(id, "")"
                                                      @oninput="e => _concept[id] = (string?)e.Value ?? string.Empty"
                                                      @onkeydown="e => Toets(e, v)"></textarea>
                                            <button class="primair" disabled="@(_bezig || _concept.GetValueOrDefault(id, "").Trim().Length == 0)"
                                                    @onclick="() => Versturen(v)">Versturen</button>
                                        </div>
                                        <small class="uitleg">De indiener, wie gereageerd heeft en wie al meepraat krijgen een bericht in de bel.</small>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                @if (!Zichtbaar.Any())
                {
                    <tr><td colspan="5" class="kiezer-info">Geen verzoeken@(_filter == "open" ? " open" : "") — klik op 💡 rechtsboven voor een idee.</td></tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<Verbeterverzoek> _lijst = new();
    private bool _tabel;
    private string _filter = "open";
    private string _zoek = "";
    private string? _melding;
    private bool _fout;

    private bool MagBeheren => Ik.Mag("Directie");
    /// <summary>Zelf een verzoek toevoegen: wie het lampje ook mag gebruiken (aangemeld of op een werkplek).</summary>
    private bool MagIndienen => Ik.Ingelogd || Ik.IsWerkplek;

    private bool _nieuwOpen, _bezig, _focusNieuw;
    private string _nieuweTekst = "";
    private ElementReference _nieuwVeld;

    private void OpenNieuw() { _nieuwOpen = true; _focusNieuw = true; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusNieuw) return;
        _focusNieuw = false;
        try { await _nieuwVeld.FocusAsync(); } catch { }
    }

    private async Task Indienen()
    {
        var tekst = _nieuweTekst.Trim();
        if (tekst.Length < 3 || _bezig) return;
        _bezig = true;
        try
        {
            var id = await Repo.IndienenAsync(tekst, "", Ik.WerknemerId, Ik.Werkplek?.Naam ?? "");
            _lijst = await Repo.LijstAsync();
            _nieuwOpen = false; _nieuweTekst = "";
            if (_filter is "gedaan" or "afgewezen") _filter = "open";      // anders zie je het nieuwe verzoek niet
            Toon($"Verzoek {id} toegevoegd.", false);
        }
        catch (Exception ex) { Toon("Toevoegen mislukt: " + ex.Message, true); }
        finally { _bezig = false; }
    }

    private IEnumerable<Verbeterverzoek> Zichtbaar => _lijst
        .Where(v => _filter switch
        {
            "open" => VerzoekStatus.IsOpen(v.Status),
            "gedaan" => v.Status == VerzoekStatus.Gedaan,
            "afgewezen" => v.Status == VerzoekStatus.Afgewezen,
            "mijn" => v.IngediendDoorId is int d && d == Ik.WerknemerId,
            _ => true,
        })
        .Where(v => _zoek.Trim().Length == 0
                    || v.Tekst.Contains(_zoek.Trim(), StringComparison.OrdinalIgnoreCase)
                    || v.IngediendDoor.Contains(_zoek.Trim(), StringComparison.OrdinalIgnoreCase)
                    || v.Pagina.Contains(_zoek.Trim(), StringComparison.OrdinalIgnoreCase)
                    || v.Reactie.Contains(_zoek.Trim(), StringComparison.OrdinalIgnoreCase));

    /// <summary>Link uit de bel (bericht over je verzoek): dat verzoek uitlichten en alles tonen.</summary>
    [SupplyParameterFromQuery(Name = "verzoek")] public int? VerzoekUitUrl { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (VerzoekUitUrl is not int id) return;
        _filter = "alles"; _zoek = "";
        // Link uit de bel: het gesprek van dat verzoek meteen open, met de nieuwste berichten.
        if (_gesprekMogelijk && _lijst.Any(v => v.Id == id)) await OpenGesprek(id);
    }

    protected override async Task OnInitializedAsync()
    {
        await Ik.ZorgGeladenAsync();
        if (!Repo.Beschikbaar) return;
        try
        {
            _tabel = await Repo.TabelAanwezigAsync();
            if (_tabel) _lijst = await Repo.LijstAsync();
            if (_tabel) _gesprekMogelijk = await Repo.GesprekMogelijkAsync();
            if (_gesprekMogelijk) _aantal = await Repo.AantalBerichtenAsync();
        }
        catch (Exception ex) { Toon("Laden mislukt: " + ex.Message, true); }
    }

    // ---- Gesprek per verzoek (wens collega 6-11-2026): verder praten over een voorstel, met een melding in de bel ----
    private bool _gesprekMogelijk;
    private Dictionary<int, int> _aantal = new();
    private readonly HashSet<int> _gesprekOpen = new();
    private readonly Dictionary<int, List<VerzoekBericht>> _berichten = new();
    private readonly Dictionary<int, string> _concept = new();

    private async Task WisselGesprek(int id)
    {
        if (_gesprekOpen.Remove(id)) return;
        await OpenGesprek(id);
    }

    /// <summary>Gesprek openen en altijd opnieuw laden (er kan intussen iets bij gekomen zijn).</summary>
    private async Task OpenGesprek(int id)
    {
        _gesprekOpen.Add(id);
        try
        {
            var lijst = await Repo.BerichtenAsync(id);
            _berichten[id] = lijst;
            _aantal[id] = lijst.Count;
        }
        catch (Exception ex) { _gesprekOpen.Remove(id); Toon("Gesprek laden mislukt: " + ex.Message, true); }
    }

    private string Afzender(VerzoekBericht b)
    {
        var naam = b.Door.Length > 0 ? b.Door : b.Werkplek.Length > 0 ? "" : "onbekend";
        return b.Werkplek.Length == 0 ? naam : (naam.Length > 0 ? naam + " · " : "") + "👥 " + b.Werkplek;
    }

    private async Task Toets(KeyboardEventArgs e, Verbeterverzoek v)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey)) await Versturen(v);
    }

    private async Task Versturen(Verbeterverzoek v)
    {
        var tekst = _concept.GetValueOrDefault(v.Id, "").Trim();
        if (tekst.Length == 0 || _bezig || !MagIndienen) return;
        _bezig = true;
        try
        {
            await Repo.BerichtToevoegenAsync(v.Id, tekst, Ik.WerknemerId, Ik.Werkplek?.Naam ?? "");
            _concept.Remove(v.Id);
            var lijst = await Repo.BerichtenAsync(v.Id);
            _berichten[v.Id] = lijst;
            _aantal[v.Id] = lijst.Count;
            var aantal = await BerichtAanBetrokkenen(v, lijst, tekst);
            var wie = aantal == 1 ? "1 collega krijgt" : aantal + " collega’s krijgen";
            Toon("Bericht geplaatst." + (aantal > 0 ? " " + wie + " een melding." : ""), false);
        }
        catch (Exception ex) { Toon("Versturen mislukt: " + ex.Message, true); }
        finally { _bezig = false; }
    }

    /// <summary>
    /// Melding in de bel (soort 'verbeter', OrderID = het verzoek, dus de link opent dit gesprek) voor de indiener, wie
    /// de status of reactie het laatst wijzigde en iedereen die al in het gesprek schreef; niet voor jezelf.
    /// </summary>
    private async Task<int> BerichtAanBetrokkenen(Verbeterverzoek v, List<VerzoekBericht> lijst, string tekst)
    {
        if (!Meldingen.Beschikbaar) return 0;
        var wie = new HashSet<int>();
        if (v.IngediendDoorId is int i) wie.Add(i);
        if (v.GewijzigdDoorId is int g) wie.Add(g);
        foreach (var b in lijst) if (b.DoorId is int d) wie.Add(d);
        if (Ik.WerknemerId is int ik) wie.Remove(ik);
        if (wie.Count == 0) return 0;

        var onderwerp = v.Tekst.Trim().ReplaceLineEndings(" ");
        if (onderwerp.Length > 50) onderwerp = onderwerp[..47] + "…";
        var van = Ik.Naam.Length > 0 ? Ik.Naam : Ik.Werkplek?.Naam ?? "Een collega";
        var kort = tekst.ReplaceLineEndings(" ");
        var bericht = $"💬 {van} over verbeterverzoek ‘{onderwerp}’: {kort}";
        if (bericht.Length > 250) bericht = bericht[..249] + "…";      // Meldingen.Tekst is minstens VARCHAR(250)

        var gelukt = 0;
        foreach (var w in wie)
        {
            try { await Meldingen.MaakAsync(w, "verbeter", v.Id, bericht); gelukt++; }
            catch { }
        }
        if (gelukt > 0) Signaal.Geef();
        return gelukt;
    }

    private async Task Wijzig(Verbeterverzoek v, Action wijzig)
    {
        if (!MagBeheren) { Toon("Alleen Directie kan verzoeken wijzigen.", true); return; }
        var (oudeStatus, oudeReactie) = (v.Status, v.Reactie);
        wijzig();
        try
        {
            await Repo.BewaarAsync(v, Ik.WerknemerId);
            v.GewijzigdDoor = Ik.Naam;
            var bericht = await BerichtAanIndiener(v, oudeStatus, oudeReactie);
            Toon("Opgeslagen." + (bericht ? $" {v.IngediendDoor} krijgt een bericht." : ""), false);
        }
        catch (Exception ex) { Toon("Opslaan mislukt: " + ex.Message, true); }
    }

    /// <summary>
    /// Nieuwe status of reactie: de indiener krijgt een bericht in de bel (Meldingen, soort 'verbeter', OrderID = het
    /// verzoek). Niet bij een tekstcorrectie, niet aan jezelf, niet als de indiener onbekend is.
    /// </summary>
    private async Task<bool> BerichtAanIndiener(Verbeterverzoek v, string oudeStatus, string oudeReactie)
    {
        if (v.IngediendDoorId is not int wie || wie == Ik.WerknemerId || !Meldingen.Beschikbaar) return false;
        var nieuweReactie = v.Reactie.Trim().Length > 0 && v.Reactie.Trim() != oudeReactie.Trim();
        if (v.Status == oudeStatus && !nieuweReactie) return false;
        var onderwerp = v.Tekst.Trim().ReplaceLineEndings(" ");
        if (onderwerp.Length > 60) onderwerp = onderwerp[..57] + "…";
        var tekst = v.Status != oudeStatus
            ? $"Je verbeterverzoek ‘{onderwerp}’ staat nu op {v.Status}."
            : $"Reactie op je verbeterverzoek ‘{onderwerp}’.";
        if (v.Reactie.Trim().Length > 0)
        {
            var reactie = v.Reactie.Trim().ReplaceLineEndings(" ");
            tekst += " " + (reactie.Length > 160 ? reactie[..157] + "…" : reactie);
        }
        if (tekst.Length > 250) tekst = tekst[..249] + "…";      // Meldingen.Tekst is VARCHAR(250)
        try
        {
            await Meldingen.MaakAsync(wie, "verbeter", v.Id, tekst);
            Signaal.Geef();          // de bel van de indiener ververst meteen (zelfde server)
            return true;
        }
        catch { return false; }
    }

    private void Toon(string tekst, bool fout) { _melding = tekst; _fout = fout; }
}
