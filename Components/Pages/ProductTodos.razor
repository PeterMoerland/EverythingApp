@page "/producten/todo"
@inject IProductTodoRepository Todos
@inject IProductRepository Repo
@inject HuidigeGebruiker Ik
@inject IJSRuntime JS
@inject IProjectRepository Projecten

@* Producten ▸ Todo-overzicht: alle open punten van exemplaren (tabel ProductTodo), met het product waar ze in zitten
   (de robot boven de print), bv. "welke robots moeten nog worden doorgesoldeerd". Invoeren gaat per exemplaar in
   Producten ▸ tab Todo; hier kun je filteren, afvinken en afdrukken.
   Een punt (Wat) overal hernoemen (wens collega 24-10-2026): kies het punt, ✎ Hernoemen; eerst de waarschuwing voor hoeveel
   exemplaren het geldt. Alleen projectleiders van een open project en Directie (besluit gebruiker). *@

<div class="page">
    <header class="topbar">
        <h1>Todo-overzicht</h1>
        <span class="weeklabel">@Getoond.Count punt@(Getoond.Count == 1 ? "" : "en")@(_wat is null ? "" : " · " + _wat)</span>
    </header>

    @if (!Todos.Beschikbaar)
    {
        <section class="module-placeholder"><p>Dit scherm werkt alleen met de live database.</p></section>
    }
    else if (_geladen && !_tabel)
    {
        <section class="module-placeholder"><p>De tabel ProductTodo bestaat nog niet. Voer eerst ProductTodo_MariaDB.sql uit op de database.</p></section>
    }
    else
    {
        @if (_melding is not null)
        {
            <div class="melding @(_meldingOk ? "ok" : "fout")" @onclick="() => _melding = null">@_melding</div>
        }

        <div class="todo-chips niet-afdrukken">
            <button class="klein @(_wat is null ? "actief" : "")" @onclick="() => KiesWat(null)">Alle punten (@_watLijst.Sum(w => w.Open))</button>
            @foreach (var w in _watLijst.Where(w => w.Open > 0 || w.Wat == _wat || _ookGereed))
            {
                <button class="klein @(w.Wat == _wat ? "actief" : "")" @key="w.Wat" @onclick="() => KiesWat(w.Wat)">
                    @w.Wat (@(_ookGereed ? $"{w.Open}/{w.Totaal}" : w.Open.ToString()))
                </button>
            }
        </div>

        @* de knop staat er altijd; klikbaar alleen als je het mag en een punt gekozen hebt (wens gebruiker 24-10-2026) *@
        <div class="todo-hernoem niet-afdrukken">
                @if (!_hernoemen || _wat is null || !_magHernoemen)
                {
                    <button class="klein" disabled="@(_wat is null || !_magHernoemen)" title="@HernoemUitleg" @onclick="StartHernoemen">
                        ✎ @(_wat is null ? "Punt hernoemen" : $"‘{_wat}’ hernoemen")</button>
                }
                else
                {
                    <label class="bankveld"><span>Nieuwe naam voor ‘@_wat’</span>
                        <input @ref="_hernoemVeld" maxlength="60" value="@_nieuweNaam" @oninput="e => _nieuweNaam = (string?)e.Value ?? string.Empty"
                               @onkeydown="HernoemToets" /></label>
                    <button class="primair" disabled="@(_bezig || _nieuweNaam.Trim().Length == 0 || _nieuweNaam.Trim() == _wat)" @onclick="Hernoem">Hernoemen…</button>
                    <button class="klein" @onclick="() => _hernoemen = false">Annuleren</button>
                }
        </div>

        <div class="bankfilters niet-afdrukken">
            <label class="bankveld">
                <span>Zoeken</span>
                <input placeholder="Product, serienummer, klant, project, toelichting…" value="@_zoek"
                       @oninput="e => _zoek = (string?)e.Value ?? string.Empty" />
            </label>
            <label class="vink"><input type="checkbox" checked="@_ookGereed" @onchange="OokGereedGewijzigd" /> Ook gereed</label>
            <button class="klein" @onclick="Laad">↻ Vernieuwen</button>
            <button class="klein" @onclick="Afdrukken">🖨 Afdrukken</button>
        </div>

        @if (!_geladen)
        {
            <p class="kiezer-info">Laden…</p>
        }
        else
        {
            <table class="kiezer-tabel todo-overzicht">
                <thead>
                    <tr>
                        <th class="niet-afdrukken" style="width:2.2rem" title="Gereed">✓</th>
                        <th style="width:10rem">Product</th>
                        <th style="width:10rem">Onderdeel</th>
                        <th style="width:10rem">Wat</th>
                        <th>Toelichting</th>
                        <th style="width:11rem">Klant</th>
                        <th style="width:8rem">Project</th>
                        <th style="width:5rem">Status</th>
                        <th style="width:8.5rem">Ingevoerd</th>
                        @if (_ookGereed)
                        {
                            <th style="width:8.5rem">Gereed</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Getoond)
                    {
                        <tr @key="t.Id" class="@(t.Open ? "" : "todo-gereed")">
                            <td class="niet-afdrukken">
                                <input @key="(t.Id, _herteken)" type="checkbox" checked="@(!t.Open)" disabled="@_bezig"
                                       title="@(t.Open ? "Afvinken: gereed" : "Weer open zetten")" @onchange="e => ZetGereed(t, e.Value is true)" />
                            </td>
                            <td><a href="producten?product=@(t.WortelId ?? t.ProductId)" title="Exemplaar openen">@(t.WortelId is null ? t.Exemplaar : t.Wortel)</a></td>
                            <td>
                                @if (t.InOnderdeel)
                                {
                                    <a href="producten?product=@t.ProductId" title="Onderdeel openen">@t.Exemplaar</a>
                                }
                            </td>
                            <td><b>@t.Wat</b></td>
                            <td>@t.Toelichting</td>
                            <td class="omschrijving" title="@t.Klant">@t.Klant</td>
                            <td class="omschrijving" title="@t.Project">@t.Project</td>
                            <td>@t.Status</td>
                            <td class="klein-grijs">@t.Aangemaakt.ToString("dd-MM-yyyy") @t.Door</td>
                            @if (_ookGereed)
                            {
                                <td class="klein-grijs">@(t.Gereed?.ToString("dd-MM-yyyy")) @t.GereedDoor</td>
                            }
                        </tr>
                    }
                    @if (Getoond.Count == 0)
                    {
                        <tr><td colspan="10" class="kiezer-info">@(_lijst.Count == 0 ? "Geen open punten." : "Niets gevonden voor dit filter.")</td></tr>
                    }
                </tbody>
            </table>
            @if (_lijst.Count >= Max)
            {
                <p class="uitleg">Alleen de eerste @Max punten; kies een soort om de lijst kleiner te maken.</p>
            }
        }
    }
</div>

@code {
    private const int Max = 2000;
    private bool _geladen, _tabel, _ookGereed, _bezig;
    private string? _wat;
    private string _zoek = "";
    private string? _melding;
    private bool _meldingOk;
    private int _herteken;        // @key van de vinkjes: na "nee" bij gereed melden het vinkje terugzetten
    private List<ProductTodo> _lijst = new();

    // ---- een punt overal hernoemen (projectleider van een open project, of Directie) ----
    private bool _magHernoemen, _hernoemen, _focusHernoem;
    private string _nieuweNaam = "";
    private ElementReference _hernoemVeld;
    private List<TodoWat> _watLijst = new();

    private List<ProductTodo> Getoond
    {
        get
        {
            var woorden = _zoek.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (woorden.Length == 0) return _lijst;
            return _lijst.Where(t =>
            {
                var tekst = $"{t.Wortel} {t.Exemplaar} {t.Wat} {t.Toelichting} {t.Klant} {t.Project} {t.Status} {t.Door}";
                return woorden.All(w => tekst.Contains(w, StringComparison.OrdinalIgnoreCase));
            }).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Todos.Beschikbaar) return;
        await Ik.ZorgGeladenAsync();
        try { _magHernoemen = Ik.Mag("Directie") || (Ik.WerknemerId is int wn && await Projecten.IsProjectleiderAsync(wn)); }
        catch { _magHernoemen = Ik.Mag("Directie"); }
        await Laad();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusHernoem) return;
        _focusHernoem = false;
        try { await _hernoemVeld.FocusAsync(); } catch { }
    }

    private string HernoemUitleg => !_magHernoemen
        ? "Alleen voor projectleiders van een open project en Directie."
        : _wat is null ? "Kies eerst hierboven een punt." : "Dit punt overal een andere naam geven";

    private void StartHernoemen() { _hernoemen = true; _nieuweNaam = _wat ?? ""; _focusHernoem = true; }

    private async Task HernoemToets(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Hernoem();
        else if (e.Key == "Escape") _hernoemen = false;
    }

    /// <summary>Eerst laten zien voor hoeveel exemplaren het geldt (en of de nieuwe naam al bestaat), dan overal hernoemen.</summary>
    private async Task Hernoem()
    {
        var oud = _wat;
        var nieuw = _nieuweNaam.Trim();
        if (oud is null || nieuw.Length == 0 || nieuw == oud || _bezig || !_magHernoemen) return;
        _bezig = true;
        try
        {
            var (exemplaren, open, gereed) = await Todos.WatTellingAsync(oud);
            var bestaand = _watLijst.FirstOrDefault(w => string.Equals(w.Wat, nieuw, StringComparison.OrdinalIgnoreCase) && w.Wat != oud);
            var tekst = $"‘{oud}’ wordt ‘{nieuw}’.\n\nDit geldt voor {exemplaren} exempla{(exemplaren == 1 ? "ar" : "ren")}: " +
                        $"{open} open en {gereed} gereed punt{(open + gereed == 1 ? "" : "en")}.";
            if (bestaand is not null)
                tekst += $"\n\n‘{bestaand.Wat}’ bestaat al ({bestaand.Totaal} punt{(bestaand.Totaal == 1 ? "" : "en")}): beide komen onder één naam.";
            if (!await JS.InvokeAsync<bool>("mdeBevestig", tekst + "\n\nDoorgaan?")) return;
            var n = await Todos.HernoemWatAsync(oud, nieuw);
            _hernoemen = false;
            _wat = bestaand?.Wat ?? nieuw;
            await Laad();
            _melding = $"‘{oud}’ hernoemd naar ‘{_wat}’: {n} punt{(n == 1 ? "" : "en")} aangepast.";
            _meldingOk = true;
        }
        catch (Exception ex) { _melding = "Hernoemen mislukt: " + ex.Message; _meldingOk = false; }
        finally { _bezig = false; }
    }

    private async Task Laad()
    {
        try
        {
            _tabel = await Todos.TabelAanwezigAsync();
            if (_tabel)
            {
                _watLijst = await Todos.WatLijstAsync();
                _lijst = await Todos.OverzichtAsync(_wat, _ookGereed, Max);
            }
        }
        catch (Exception ex) { _melding = "Ophalen mislukt: " + ex.Message; _meldingOk = false; }
        _geladen = true;
    }

    private async Task KiesWat(string? wat) { _wat = wat; _hernoemen = false; await Laad(); }

    private async Task OokGereedGewijzigd(ChangeEventArgs e) { _ookGereed = e.Value is true; await Laad(); }

    private async Task ZetGereed(ProductTodo t, bool gereed)
    {
        // gereed melden: eerst bevestigen (wens gebruiker 24-10-2026); bij nee springt het vinkje terug (_herteken)
        if (gereed && !await JS.InvokeAsync<bool>("mdeBevestig", $"‘{t.Wat}’ bij {(t.InOnderdeel ? t.Exemplaar + " (" + t.Wortel + ")" : t.Wortel.Length > 0 ? t.Wortel : t.Exemplaar)} gereed melden?"))
        { _herteken++; return; }
        _bezig = true;
        try
        {
            await Todos.ZetGereedAsync(t.Id, gereed, Ik.WerknemerId);
            try { await Repo.VoegHistorieToeAsync(t.ProductId, (gereed ? "Todo gereed: " : "Todo weer open: ") + t.Wat, null, Ik.WerknemerId); }
            catch { /* de todo zelf staat er wel */ }
            await Laad();
        }
        catch (Exception ex) { _melding = "Opslaan mislukt: " + ex.Message; _meldingOk = false; }
        finally { _bezig = false; }
    }

    private async Task Afdrukken()
    {
        try { await JS.InvokeVoidAsync("print"); } catch { }
    }
}
