    private async Task ZetContactVlag(Contactpersoon c, Action<bool> zet, ChangeEventArgs e)
    {
        zet(Vink(e));
        await BewaarContact(c);
        if (c.UitDienst && !_toonUitDienst) await LaadContacten();   // verdwijnt uit de lijst
