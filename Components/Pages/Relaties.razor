        catch (Exception ex)
        {
            Toon("Verwijderen mislukt: " + ex.Message +
                 " — is deze persoon nog ergens in gebruik? Zet dan 'niet meer werkzaam' aan.", true);
        }
    }

    private async Task Nieuw()
    {
        var naam = string.IsNullOrWhiteSpace(_zoek) ? "Nieuwe relatie" : _zoek.Trim();
        try
        {
            var id = await Repo.NieuweRelatieAsync(naam);
            await Laad();
            await Kies(new Keuze(id, naam));
            Toon($"'{naam}' aangemaakt. Vul de gegevens aan.", false);
        }
        catch (Exception ex) { Toon("Aanmaken mislukt: " + ex.Message, true); }
    }

    private string? Kolom(Veld veld) => veld.Kolommen.FirstOrDefault(k => _kolommen.Contains(k));

    private string Tekst(string kolom)
    {
        if (!_velden.TryGetValue(kolom, out var v) || v is null) return "";
        if (v is DateTime dt) return dt.ToString("dd-MM-yyyy");
        if (v is byte[]) return "(bestand)";
        return v.ToString() ?? "";
    }

    private bool Waar(string kolom)
    {
        if (!_velden.TryGetValue(kolom, out var v) || v is null) return false;
        if (v is bool b) return b;
        try { return Convert.ToInt64(v) != 0; } catch { return false; }
    }

    private Task? _opslaanBezig;

    /// <summary>
    /// Een lopende veldwijziging eerst laten afronden. Het onchange van een veld vuurt bij het verlaten ervan, vlak
    /// vóór de klik op een ander record; zonder wachten laadt dat record al terwijl de UPDATE nog loopt en komt de
    /// oude waarde in de velden van het nieuwe record terecht (opmerking leek dan niet opgeslagen).
    /// </summary>
    private async Task WachtOpOpslaan()
    {
        if (_opslaanBezig is { IsCompleted: false } t) { try { await t; } catch { } }
    }

    private Task Bewaar(string kolom, object? waarde) => _opslaanBezig = BewaarKern(kolom, waarde);

    private async Task BewaarKern(string kolom, object? waarde)
    {
        if (_gekozenId is null) return;
        var vanId = _gekozenId.Value;
        try
        {
            var opslaan = waarde is string s && string.IsNullOrWhiteSpace(s) ? null : waarde;
            await Repo.UpdateVeldAsync(vanId, kolom, opslaan);
            if (_gekozenId == vanId) _velden[kolom] = opslaan;
            Toon("Opgeslagen.", false);
        }
        catch (Exception ex) { Toon("Opslaan mislukt: " + ex.Message, true); }
    }

    private void Toon(string tekst, bool fout) { _melding = tekst; _fout = fout; }
}
