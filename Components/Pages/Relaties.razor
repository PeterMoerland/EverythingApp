    private async Task BewaarContact(Contactpersoon c)
    {
        try
        {
            await Repo.BewaarContactpersoonAsync(c);
            Toon("Opgeslagen.", false);
        }
        catch (Exception ex) { Toon("Opslaan mislukt: " + ex.Message, true); }
    }

    private async Task VerwijderContact(Contactpersoon c)
    {
        try
        {
            await Repo.VerwijderContactpersoonAsync(c.Id);
