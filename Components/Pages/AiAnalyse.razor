@page "/ai"
@page "/financien/analyse"
@using Markdig
@implements IDisposable
@inject AiAnalyseService Ai
@inject IAiVraagRepository Vragen
@inject HuidigeGebruiker Ik
@inject AiSignaal Signaal
@inject IJSRuntime JS

@* Financiën ▸ Analyse ▸ Vragen aan AI: vragen stellen aan het taalmodel (Amazon Bedrock), met de wachtrij en de eerdere
   vragen. Bij elk antwoord staan de gegevens die het model opvroeg, om na te rekenen. Services/AiAnalyseService.cs.
   Privé (besluit gebruiker 22-10-2026): je ziet alleen je eigen gesprekken; met "Delen met de directie" maak je een
   gesprek zichtbaar voor de directieleden. Eigen gesprekken kun je wissen. *@

<div class="page">
    <header class="topbar">
        <h1>Vragen aan AI</h1>
        @if (Ai.Ingesteld)
        {
            <span class="weeklabel">@Ai.Model · Mag wachten wordt uitgevoerd @Ai.DalurenTekst</span>
        }
    </header>

    @if (!Mag)
    {
        <section class="module-placeholder"><p>Meld je aan (of kies wie je bent op deze werkplek) om vragen te stellen.</p></section>
    }
    else if (!Vragen.Beschikbaar)
    {
        <section class="module-placeholder"><p>Dit scherm werkt alleen met de live database.</p></section>
    }
    else
    {
        <AiVraagInvoer @ref="_invoer" Compact="true" OpGesteld="Gesteld" />

        <div class="wn-scherm">
            <aside class="wn-lijst ai-lijst">
                @if (Ik.Mag("Directie"))
                {
                    <div class="wn-filters">
                        <label class="vink" title="Gesprekken die andere collega's met de directie gedeeld hebben">
                            <input type="checkbox" checked="@_gedeeld" @onchange="GedeeldGewijzigd" /> Ook gedeelde gesprekken</label>
                    </div>
                }
                <div class="wn-namen">
                    @if (_lijst.Count == 0)
                    {
                        <div class="kiezer-info">Nog geen vragen.</div>
                    }
                    @foreach (var v in _lijst)
                    {
                        <button class="wn-naam ai-regel @(v.Id == _gekozen?.Id ? "actief" : "")" @key="v.Id" @onclick="() => Kies(v.Id)">
                            <span class="ai-status @StatusKlasse(v)" title="@StatusTekst(v)">@StatusTeken(v)</span>
                            <span class="ai-regel-tekst">
                                <span class="ai-regel-vraag">@v.Vraag</span>
                                <small>
                                    @v.Aangemaakt.ToString("dd-MM HH:mm") · @(v.Prioriteit == AiVraag.Wachten ? "mag wachten" : "direct")
                                    @if (v.Vervolgen > 0) { <text> · +@v.Vervolgen vervolgvra@(v.Vervolgen == 1 ? "ag" : "gen")</text> }
                                    @if (v.WerknemerId != Ik.WerknemerId) { <text> · 👥 @v.Wie</text> }
                                    else if (v.Openbaar) { <text> · 👥 gedeeld</text> }
                                    @if (v.Kosten is decimal k) { <text> · € @k.ToString("0.000", Nl)</text> }
                                </small>
                            </span>
                        </button>
                    }
                </div>
            </aside>

            <section class="wn-detail ai-detail">
                @if (_gekozen is null)
                {
                    <p class="uitleg">Stel hierboven een vraag, of kies links een eerder gesprek. Onder elk antwoord kun je doorvragen.</p>
                    <p class="uitleg">
                        Het model kan opvragen: projecten en werkorders, uren per project of medewerker, bestellingen, voorraad,
                        producten en hun todo's.
                        @if (Ik.Mag("Financial") || Ik.Mag("Directie"))
                        {
                            <text>Met jouw rechten ook: de nacalculatie per project, omzet en inkoopkosten per maand, verkoop- en
                            inkoopfacturen, banktransacties (van de rekeningen waar jij bij mag), vaste lasten en de liquiditeitsprognose.</text>
                        }
                        else
                        {
                            <text>Uren van anderen per medewerker en financiële gegevens zijn alleen voor Financial/Directie.</text>
                        }
                        Het kan niets wijzigen. Bij elk antwoord staan de opgevraagde gegevens, zodat je kunt narekenen.
                    </p>
                }
                else
                {
                    var eigen = _gesprek.Count > 0 && _gesprek[0].WerknemerId == Ik.WerknemerId;
                    <div class="ai-gesprek-kop">
                        @if (eigen)
                        {
                            <label class="vink" title="Standaard ziet alleen jij dit gesprek. Aangevinkt zien de directieleden het ook (alleen lezen).">
                                <input type="checkbox" checked="@_gekozen.Openbaar" disabled="@_deelBezig" @onchange="DeelGewijzigd" /> Delen met de directie</label>
                            <span style="flex:1"></span>
                            <button class="klein rood" disabled="@(_gesprek.Any(x => x.Loopt))"
                                    title="@(_gesprek.Any(x => x.Loopt) ? "Kan pas als er niets meer loopt in dit gesprek" : "Dit gesprek met alle vervolgvragen wissen")"
                                    @onclick="WisGesprek">🗑 Gesprek wissen</button>
                        }
                        else
                        {
                            <span class="uitleg">👥 Gedeeld door @_gekozen.Wie (alleen lezen)</span>
                        }
                    </div>
                    @if (_kopFout is not null) { <p class="ai-fout">@_kopFout</p> }
                    @foreach (var g in _gesprek)
                    {
                    var gegevens = g.Gegevens;
                    <div class="ai-beurt @(g.Id == _gesprek[0].Id ? "" : "vervolg")" @key="g.Id">
                    <div class="ai-vraag">@g.Vraag</div>
                    <div class="ai-statusregel">
                        <span class="ai-status @StatusKlasse(g)">@StatusTeken(g)</span> @StatusTekst(g)
                        <span class="uitleg">· gesteld @g.Aangemaakt.ToString("dd-MM-yyyy HH:mm") door @(g.Wie.Length > 0 ? g.Wie : "jou")</span>
                    </div>

                    @if (g.Status == AiVraag.Wacht && g.Prioriteit == AiVraag.Wachten)
                    {
                        <div class="ai-wacht">
                            Staat in de wachtrij en wordt uitgevoerd @Ai.DalurenTekst, tegen het lagere tarief. Je krijgt een melding bij de bel.
                            @if (g.WerknemerId == Ik.WerknemerId)
                            {
                                <div class="btngroup">
                                    <button class="klein" title="Toch meteen, tegen het gewone tarief" @onclick="() => NuUitvoeren(g)">Nu uitvoeren</button>
                                    <button class="klein rood" @onclick="() => Annuleer(g)">Annuleren</button>
                                </div>
                            }
                        </div>
                    }
                    else if (g.Loopt)
                    {
                        <div class="ai-bezig"><span class="draaier"></span> Bezig… het model vraagt gegevens op en rekent. Dit kan een halve minuut duren.</div>
                    }
                    else if (g.Status == AiVraag.FoutStatus)
                    {
                        <div class="ai-fout">@g.Fout</div>
                    }

                    @if (g.Antwoord.Length > 0)
                    {
                        @foreach (var deel in Delen(g.Antwoord))
                        {
                            @if (deel.Grafiek)
                            {
                                <AiGrafiek Json="@deel.Tekst" Gegevens="gegevens" />
                            }
                            else
                            {
                                <div class="ai-antwoord">@((MarkupString)Html(deel.Tekst))</div>
                            }
                        }
                    }

                    @if (gegevens.Count > 0)
                    {
                        <h3 class="wn-kop">Gebruikte gegevens <span class="klein uitleg">(@gegevens.Count opvraging@(gegevens.Count == 1 ? "" : "en"))</span></h3>
                        @foreach (var d in gegevens)
                        {
                            <details class="ai-gegevens">
                                <summary>@d.Titel <span class="uitleg">· @d.Rijen.Count regel@(d.Rijen.Count == 1 ? "" : "s")</span></summary>
                                @if (d.Opmerking.Length > 0)
                                {
                                    <p class="uitleg">@d.Opmerking</p>
                                }
                                @if (d.Rijen.Count > 0)
                                {
                                    <div class="ai-tabel-rol">
                                        <table class="kiezer-tabel smal-tabel">
                                            <thead><tr>@foreach (var k in d.Kolommen) { <th>@k</th> }</tr></thead>
                                            <tbody>
                                                @foreach (var r in d.Rijen)
                                                {
                                                    <tr>@foreach (var c in r) { <td class="@(IsGetal(c) ? "r" : "")">@Cel(c)</td> }</tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </details>
                        }
                    }

                    @if (!g.Loopt)
                    {
                        <div class="ai-voet">
                            @if (g.Model.Length > 0) { <span>@g.Model</span> }
                            @if (g.Laag.Length > 0) { <span>laag @g.Laag</span> }
                            @if (g.TokensIn is int ti) { <span>@ti.ToString("N0", Nl) tokens in, @((g.TokensUit ?? 0).ToString("N0", Nl)) uit</span> }
                            @if (g.Kosten is decimal k2) { <span>± € @k2.ToString("0.000", Nl)</span> }
                            @if (g.Gestart is DateTime s && g.Klaar is DateTime e) { <span>@((int)(e - s).TotalSeconds) s</span> }
                            <button class="klein" @onclick="() => _invoer?.Vul(g.Vraag)">Opnieuw stellen</button>
                        </div>
                    }
                    </div>
                    }

                    @* doorvragen: alleen in je eigen gesprek, en als er niets meer loopt *@
                    @if (_gesprek.Count > 0 && _gesprek[0].WerknemerId == Ik.WerknemerId && !_gesprek.Any(x => x.Loopt))
                    {
                        <div class="ai-vervolg">
                            <textarea rows="2" maxlength="2000" placeholder="Vraag door, bv. 'Splits dat uit per klant' of 'En vorig jaar?' (Ctrl+Enter)"
                                      value="@_vervolg" @oninput="e => _vervolg = (string?)e.Value ?? string.Empty" @onkeydown="VervolgToets"></textarea>
                            <button class="primair" disabled="@(_vervolgBezig || _vervolg.Trim().Length < 2)" @onclick="Doorvragen">Doorvragen</button>
                        </div>
                        @if (_vervolgFout is not null) { <p class="ai-fout">@_vervolgFout</p> }
                    }
                }
            </section>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "vraag")] public int? VraagParam { get; set; }

    private static readonly System.Globalization.CultureInfo Nl = new("nl-NL");
    private static readonly Markdig.MarkdownPipeline Pijplijn =
        new Markdig.MarkdownPipelineBuilder().UseAdvancedExtensions().DisableHtml().Build();

    private AiVraagInvoer? _invoer;
    private List<AiVraag> _lijst = new();
    private AiVraag? _gekozen;                      // de eerste vraag van het gekozen gesprek
    private List<AiVraag> _gesprek = new();         // het hele gesprek, oudste eerst
    private bool _gedeeld = true, _vervolgBezig, _deelBezig;
    private string? _kopFout;
    private string _vervolg = "";
    private string? _vervolgFout;

    /// <summary>Iedereen met een gekoppeld account; wat het model mag opvragen hangt van de rechten af (AiAnalyseService).</summary>
    private bool Mag => Ik.Gekoppeld;

    protected override async Task OnInitializedAsync()
    {
        await Ik.ZorgGeladenAsync();
        Signaal.Gewijzigd += OpSignaal;
        if (!Mag || !Vragen.Beschikbaar) return;
        await LaadLijst();
        if (VraagParam is int id) await Kies(id);
    }

    private async Task LaadLijst()
    {
        try { _lijst = await Vragen.LijstAsync(Ik.WerknemerId ?? -1, _gedeeld && Ik.Mag("Directie"), 100); }
        catch { _lijst = new(); }
    }

    private async Task Kies(int id)
    {
        try
        {
            _kopFout = null;
            var v = await Vragen.GetAsync(id);
            if (v is null) { _gekozen = null; _gesprek = new(); return; }
            var begin = v.GesprekId ?? v.Id;
            var gesprek = await Vragen.GesprekAsync(begin);
            if (gesprek.Count == 0) gesprek = new() { v };
            // privé: alleen je eigen gesprek, of een gesprek dat iemand met de directie deelde (en jij bent directie)
            var eerste = gesprek[0];
            if (eerste.WerknemerId != Ik.WerknemerId && !(eerste.Openbaar && Ik.Mag("Directie"))) { _gekozen = null; _gesprek = new(); return; }
            _gesprek = gesprek;
            _gekozen = eerste;
        }
        catch { _gekozen = null; _gesprek = new(); }
    }

    private async Task Gesteld(int id)
    {
        await LaadLijst();
        await Kies(id);
    }

    private async Task GedeeldGewijzigd(ChangeEventArgs e) { _gedeeld = e.Value is true; await LaadLijst(); }

    private async Task DeelGewijzigd(ChangeEventArgs e)
    {
        if (_gekozen is null || Ik.WerknemerId is not int wn) return;
        var aan = e.Value is true;
        _deelBezig = true; _kopFout = null;
        try
        {
            if (await Vragen.ZetOpenbaarAsync(_gekozen.Id, wn, aan)) _gekozen.Openbaar = aan;
            else _kopFout = "Alleen je eigen gesprekken kun je delen.";
        }
        catch (Exception ex) { _kopFout = ex.Message; }
        finally { _deelBezig = false; }
        await LaadLijst();
    }

    private async Task WisGesprek()
    {
        if (_gekozen is null || Ik.WerknemerId is not int wn) return;
        var titel = _gekozen.Vraag.Length > 80 ? _gekozen.Vraag[..77] + "…" : _gekozen.Vraag;
        var vervolg = _gesprek.Count > 1 ? $" en {_gesprek.Count - 1} vervolgvra{(_gesprek.Count == 2 ? "ag" : "gen")}" : "";
        if (!await JS.InvokeAsync<bool>("mdeBevestig", $"Dit gesprek wissen?\n\n‘{titel}’{vervolg}\n\nHet is daarna weg, ook voor wie het gedeeld zag.")) return;
        try
        {
            var n = await Vragen.WisGesprekAsync(_gekozen.Id, wn);
            if (n == 0) { _kopFout = "Wissen lukte niet (loopt er nog iets?)."; return; }
            _gekozen = null; _gesprek = new();
            await LaadLijst();
        }
        catch (Exception ex) { _kopFout = "Wissen mislukt: " + ex.Message; }
    }

    /// <summary>Een vraag is veranderd (wachtrij, bezig, klaar): lijst en detail bijwerken.</summary>
    private void OpSignaal(int id)
    {
        _ = InvokeAsync(async () =>
        {
            await LaadLijst();
            if (_gekozen is not null) await Kies(_gekozen.Id);      // het hele gesprek opnieuw (ook een nieuwe vervolgvraag)
            StateHasChanged();
        });
    }

    private async Task VervolgToets(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && e.CtrlKey) await Doorvragen();
    }

    /// <summary>Doorvragen in het gekozen gesprek; het model krijgt het hele gesprek mee (AiAnalyseService.Voorgeschiedenis).</summary>
    private async Task Doorvragen()
    {
        var tekst = _vervolg.Trim();
        if (_gekozen is null || _vervolgBezig || tekst.Length < 2 || Ik.WerknemerId is not int wn) return;
        _vervolgBezig = true; _vervolgFout = null;
        try
        {
            await Ai.StelAsync(wn, tekst, AiVraag.Direct, Ik.Mag("Financial") || Ik.Mag("Directie"), _gekozen.Id);
            _vervolg = "";
            await Kies(_gekozen.Id);
        }
        catch (Exception ex) { _vervolgFout = "Doorvragen mislukt: " + ex.Message; }
        finally { _vervolgBezig = false; }
    }

    private async Task NuUitvoeren(AiVraag v) { await Ai.NuUitvoerenAsync(v); await Kies(v.Id); }

    private async Task Annuleer(AiVraag v)
    {
        if (Ik.WerknemerId is int wn) await Ai.AnnuleerAsync(v.Id, wn);
        await LaadLijst();
        await Kies(v.Id);
    }

    private static string Html(string markdown) => Markdig.Markdown.ToHtml(markdown, Pijplijn);

    /// <summary>Het antwoord in stukken: tekst (markdown) en grafieken (blok ```grafiek met JSON, zie AiAnalyseService).</summary>
    private static List<(bool Grafiek, string Tekst)> Delen(string antwoord)
    {
        var delen = new List<(bool, string)>();
        var vanaf = 0;
        foreach (System.Text.RegularExpressions.Match m in System.Text.RegularExpressions.Regex.Matches(
                     antwoord, @"```grafiek\s*\n(.*?)```", System.Text.RegularExpressions.RegexOptions.Singleline))
        {
            if (m.Index > vanaf) delen.Add((false, antwoord[vanaf..m.Index]));
            delen.Add((true, m.Groups[1].Value.Trim()));
            vanaf = m.Index + m.Length;
        }
        if (vanaf < antwoord.Length) delen.Add((false, antwoord[vanaf..]));
        return delen.Where(d => d.Item2.Trim().Length > 0).ToList();
    }

    private static string StatusTeken(AiVraag v) => v.Status switch
    {
        AiVraag.Wacht => "⏳", AiVraag.Bezig => "⚙", AiVraag.KlaarStatus => "✓", AiVraag.FoutStatus => "!", _ => "–",
    };

    private static string StatusKlasse(AiVraag v) => "st-" + v.Status;

    private string StatusTekst(AiVraag v) => v.Status switch
    {
        AiVraag.Wacht => v.Prioriteit == AiVraag.Wachten ? "In de wachtrij (daluren)" : "Wordt zo uitgevoerd",
        AiVraag.Bezig => "Bezig",
        AiVraag.KlaarStatus => "Klaar" + (v.Klaar is DateTime k ? " " + k.ToString("dd-MM HH:mm") : ""),
        AiVraag.FoutStatus => "Mislukt",
        AiVraag.Geannuleerd => "Geannuleerd",
        _ => v.Status,
    };

    // getallen uit de tabellen staan met een punt; op het scherm Nederlands
    private static bool IsGetal(string c)
        => decimal.TryParse(c, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out _) && c.Contains('.');

    private static string Cel(string c)
        => IsGetal(c) ? decimal.Parse(c, System.Globalization.CultureInfo.InvariantCulture).ToString("N2", Nl) : c;

    public void Dispose() => Signaal.Gewijzigd -= OpSignaal;
}
