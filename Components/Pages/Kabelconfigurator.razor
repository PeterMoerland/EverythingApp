@page "/tools/kabelconfigurator"
@using System.Globalization
@using EverythingApp.Models
@inject IKabelRepository Repo
@inject HuidigeGebruiker Ik
@inject IJSRuntime JS
@inject IWebHostEnvironment Omgeving
@inject IArtikelRepository Artikelen
@inject FactuurPdfService PdfMaker

@* Tools ▸ Kabelconfigurator (wens gebruiker 13-11-2026): een kabel op maat samenstellen en aanvragen bij een kabelmaker.
   Links het formulier, rechts de aanvraagtekening van MDE (Services/KabelTekening.cs): zonder gegevens van een
   leverancier, zodat hetzelfde formulier overal aangevraagd kan worden. Het nummer volgens het schema van LDZY
   (W2464-08-G020007, Models/Kabel.cs, KabelNummer) staat alleen nog ter info in het scherm.
   Opslaan in de tabel Kabelconfiguraties (Kabelconfiguraties_MariaDB.sql) als JSON; zonder tabel werkt het scherm als
   rekenblad. De tekening gaat als PDF-bestand naar de gebruiker (knop PDF: de server maakt hem met Edge, zoals de
   factuur; wwwroot/kabel.js doet het downloaden en het kopiëren van de spec als tekst).
   Eerste proefopzet: nog geen koppeling met Artikelen of een bestelling. *@

<PageTitle>Kabelconfigurator — MDE</PageTitle>

<div class="page kabel-pagina">
    <header class="topbar">
        <h1>🔌 Kabelconfigurator</h1>
        @if (K.EigenNummer.Trim().Length > 0)
        {
            <span class="weeklabel">MDE-nummer <b>@K.EigenNummer.Trim()</b></span>
        }
    </header>

    <p class="uitleg">
        Stel een kabel op maat samen. Rechts groeit de aanvraagtekening van MDE mee; die stuur je als PDF naar de
        kabelmaker waar je aanvraagt. Er staan geen gegevens van een leverancier op, dus hetzelfde formulier kan naar meerdere.
    </p>

    @if (_melding is not null)
    {
        <div class="melding @(_meldingFout ? "fout" : "ok")" style="position:static;max-width:none" @onclick="() => _melding = null">@_melding</div>
    }

    <datalist id="kabel-kleuren">
        @foreach (var n in KabelKleuren.Namen) { <option value="@n"></option> }
    </datalist>

    <div class="kabel-opmaak">
        <div class="kabel-formulier">

            <section class="kabel-kaart">
                <h3 class="wn-kop">Opgeslagen kabels</h3>
                @if (!Repo.Beschikbaar)
                {
                    <p class="uitleg">Opslaan werkt alleen met de live database; samenstellen en tekenen kan wel.</p>
                }
                else if (!_tabel)
                {
                    <p class="uitleg">De tabel Kabelconfiguraties bestaat nog niet (Kabelconfiguraties_MariaDB.sql); samenstellen en tekenen kan wel.</p>
                }
                else
                {
                    <select class="kabel-keuze" value="@K.Id" @onchange="LaadGekozen" title="Een opgeslagen kabel openen">
                        <option value="0">— nieuw, nog niet opgeslagen —</option>
                        @foreach (var o in _lijst)
                        {
                            <option value="@o.Id">@o.Naam</option>
                        }
                    </select>
                }
                @if (_tabel && Repo.Beschikbaar)
                {
                    <p class="uitleg">
                        @(_lijst.Count == 0 ? "Nog geen opgeslagen kabels." : _lijst.Count == 1 ? "1 opgeslagen kabel." : _lijst.Count + " opgeslagen kabels.")
                        Een kabel die je opent en aanpast, bewaar je met <b>Wijzigingen opslaan</b>; wil je er een tweede naast, kies dan <b>Opslaan als nieuwe kabel</b>.
                    </p>
                }
                <div class="kabel-knoppen">
                    <button class="klein" title="Begin met een ingevuld voorbeeld: UL2464 4 paar afgeschermd, 2x Molex Pico-Lock 8P, 200 mm" @onclick="NieuwVoorbeeld">+ Nieuw (voorbeeld)</button>
                    <button class="klein" @onclick="NieuwLeeg">+ Nieuw (leeg)</button>
                    <button class="klein" disabled="@(K.Id == 0)" title="Een losse kopie van deze kabel om verder aan te passen" @onclick="Kopie">Kopie</button>
                    <button class="klein rood" disabled="@(K.Id == 0 || _bezig)" @onclick="Verwijder">Verwijderen</button>
                </div>
            </section>

            <section class="kabel-kaart">
                <h3 class="wn-kop">Kabel</h3>
                <div class="kabel-velden">
                    <label class="breed">Naam (voor onszelf) <input @bind="K.Naam" placeholder="bv. Encoderkabel servo, 300 mm" /></label>
                    <label>Aantal te bestellen <input type="number" min="1" @bind="K.Aantal" /></label>
                    <label>Eigen artikelnummer <input @bind="K.EigenNummer" placeholder="nog geen" /></label>
                    <label>Lengte (mm) <input type="number" min="10" max="9999" @bind="K.Lengte" /></label>
                    <label>Tolerantie lengte (± mm) <input type="number" min="0" @bind="K.LengteTolerantie" /></label>
                    <label class="vink" title="Trekontlasting: de aders worden bij de ingang van elke connector vastgelijmd. Komt als eis en als gele markering op de tekening.">
                        <input type="checkbox" @bind="K.AdersLijmen" /> Aders vastlijmen aan de connector (geldt voor elke kant met een connector)
                    </label>
                </div>
                @* een eigen artikel voor deze kabel (wens gebruiker 13-11-2026): tussenvenster, daarna staat het nummer op de tekening *@
                <div class="kabel-knoppen">
                    <button class="klein" disabled="@(!Artikelen.Beschikbaar || K.EigenNummer.Trim().Length > 0)" @onclick="OpenArtikel"
                            title="@(!Artikelen.Beschikbaar ? "Werkt alleen met de live database" : K.EigenNummer.Trim().Length > 0 ? "Deze kabel heeft al een artikelnummer" : "Een nieuw artikel in Artikelen aanmaken voor deze kabel; het nummer komt op de aanvraagtekening")">＋ Artikelnummer aanmaken…</button>
                    @if (ArtikelNummer is int artNr)
                    {
                        <a class="knopje" href="@("artikelen?nr=" + artNr)" target="_blank" rel="noopener" title="Dit artikel openen bij Artikelen, in een nieuw venster">Artikel #@artNr openen ↗</a>
                    }
                </div>
                @* alleen ter info voor wie bij LDZY bestelt; staat niet op de tekening *@
                <details class="kabel-ldzy">
                    <summary>Nummer volgens het schema van LDZY: @K.LeveranciersNummer</summary>
                    <p class="uitleg">
                        Alleen ter info als je bij LDZY bestelt; het staat niet op de aanvraagtekening. De laatste twee cijfers geeft
                        LDZY zelf uit bij hun tekening ter goedkeuring.
                        <label>Volgnummer van LDZY <input type="number" min="0" max="99" @bind="K.Volgnummer" title="0 = nog niet bekend (xx)" /></label>
                    </p>
                </details>
            </section>

            <section class="kabel-kaart">
                <h3 class="wn-kop">Draad</h3>
                <div class="kabel-velden">
                    @* kabel of losse aders tussen de uiteinden (wens gebruiker 13-11-2026) *@
                    <label class="breed">Uitvoering
                        <select @bind="K.Uitvoering">
                            <option value="@KabelUitvoering.Kabel">kabel (alle aders in één mantel)</option>
                            <option value="@KabelUitvoering.LosseAders">losse aders (geen mantel)</option>
                        </select>
                    </label>
                    <label>Type <input @bind="K.DraadType" placeholder="@(K.IsLosseAders ? "UL1007" : "UL2464")" /></label>
                    <label>AWG <input type="number" min="10" max="40" @bind="K.Awg" />
                        @* richtwaarde voor de stroom per ader bij deze draaddikte (Models/Kabel.cs, KabelStroom) *@
                        <span class="kabel-hint" title="Richtwaarde voor een losse koperen ader in vrije lucht (tabel chassis wiring). Meer aders bij elkaar worden warmer; daarvoor geldt de waarde erachter. De isolatie, de omgevingstemperatuur en vooral de connector (vaak 1 tot 3 A per contact) kunnen lager begrenzen.">@StroomHint</span>
                    </label>
                    <label>Opbouw ader <input @bind="K.Draadopbouw" placeholder="7/0.12" title="aantal draadjes / diameter in mm" /></label>
                    @if (!K.IsLosseAders)
                    {
                        <label>Afscherming
                            <select @bind="K.Afscherming">
                                <option value="@KabelAfscherming.Geen">geen</option>
                                <option value="@KabelAfscherming.Folie">folie</option>
                                <option value="@KabelAfscherming.Vlecht">vlecht</option>
                                <option value="@KabelAfscherming.FolieEnVlecht">folie + vlecht</option>
                            </select>
                        </label>
                        <label>Buitendiameter (mm) <input type="number" step="0.1" min="1" @bind="K.Buitendiameter" @bind:culture="Inv" /></label>
                        <label>Kleur mantel <input @bind="K.Mantelkleur" list="kabel-kleuren" /></label>
                    }
                </div>
                @if (K.IsLosseAders)
                {
                    <p class="uitleg">Losse aders: type, AWG en opbouw gelden per ader; de kleuren staan bij Bedrading. Mantel, afscherming en krimpkous vervallen.</p>
                }
            </section>

            @foreach (var (naam, e) in Einden)
            {
                <section class="kabel-kaart">
                    <h3 class="wn-kop">@naam
                        @if (naam == "P1")
                        {
                            <a class="kabel-beheerlink" href="beheer/tabel/kabel-connectoren" target="_blank" rel="noopener"
                               title="De lijst van connectortypes die we gebruiken, in een nieuw venster. Ververs daarna dit scherm.">Connectortypes beheren ↗</a>
                        }
                    </h3>
                    <div class="kabel-velden">
                        <label>Soort
                            <select @bind="e.Soort">
                                <option value="@KabelEindSoort.Connector">connector</option>
                                <option value="@KabelEindSoort.OpenEind">open eind</option>
                            </select>
                        </label>
                        @if (e.IsConnector)
                        {
                            @* de eigen lijst van connectortypes (tabel KabelConnectoren): kiezen vult de velden hieronder in *@
                            @if (_connectoren.Count > 0)
                            {
                                <label class="breed">Type uit onze lijst
                                    <select value="@GekozenType(e)" @onchange="ev => KiesType(e, ev)">
                                        <option value="0">— zelf invullen —</option>
                                        @foreach (var c in _connectoren)
                                        {
                                            <option value="@c.Id" title="@c.Opmerking">@c.Weergave</option>
                                        }
                                    </select>
                                </label>
                            }
                            <label>Familie <input @bind="e.Familie" placeholder="bv. Molex Pico-Lock" /></label>
                            <label>Steek
                                <select value="@SteekLetter(e)" @onchange="ev => ZetSteek(e, ev)">
                                    @if (SteekLetter(e) == "?")
                                    {
                                        <option value="?">@e.Steek.ToString("0.##", Nl) mm</option>
                                    }
                                    @foreach (var st in KabelNummer.Steken)
                                    {
                                        <option value="@st.Letter">@st.Steek.ToString("0.##", Nl) mm</option>
                                    }
                                </select>
                            </label>
                            <label>Pinnen <input type="number" min="1" max="60" @bind="e.Pinnen" /></label>
                            <label>Housing (fabrikantnummer) <input @bind="e.Housing" placeholder="bv. 5040510801" /></label>
                            <label>Terminal (fabrikantnummer) <input @bind="e.Terminal" placeholder="bv. 5040520098" /></label>
                        }
                        else
                        {
                            <label>@(K.IsLosseAders ? "Aders strippen (mm)" : "Mantel strippen (mm)") <input type="number" min="0" @bind="e.StripLengte" /></label>
                            <label>Afwerking aders
                                <select @bind="e.Afwerking">
                                    <option value="vertind">vertind</option>
                                    <option value="adereindhuls">adereindhuls</option>
                                    <option value="blank">blank (alleen gestript)</option>
                                </select>
                            </label>
                        }
                        @if (!K.IsLosseAders)
                        {
                            <label class="vink"><input type="checkbox" @bind="e.Krimpkous" /> Krimpkous aan deze kant</label>
                        }
                        @if (K.HeeftKous(e))
                        {
                            <label>Kleur krimpkous <input @bind="e.KrimpkousKleur" list="kabel-kleuren" /></label>
                            <label>Lengte krimpkous (mm) <input type="number" min="1" @bind="e.KrimpkousLengte" /></label>
                            <label>Afstand tot het eind (mm) <input type="number" min="0" @bind="e.KrimpkousAfstand" /></label>
                        }
                    </div>
                </section>
            }

            <section class="kabel-kaart">
                <h3 class="wn-kop">Bedrading</h3>
                <div class="kabel-knoppen">
                    <label class="kabel-aantal">Aders <input type="number" min="1" max="60" value="@K.Aders.Count" @onchange="ZetAders" /></label>
                    <button class="klein" title="P1 pin n naar P2 pin n" @onclick="K.PinnenEenOpEen">1 : 1</button>
                    <button class="klein" title="P1 pin 1 naar de laatste pin van P2 (gespiegeld)" @onclick="K.PinnenOmgekeerd">Omgekeerd</button>
                    <button class="klein" title="Getwiste paren 1-2, 3-4, …" @onclick="K.ParenAutomatisch">Paren</button>
                    <button class="klein" @onclick="K.ParenWissen">Geen paren</button>
                </div>
                <table class="kiezer-tabel kabel-aders">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Kleur</th>
                            <th>Pin P1</th>
                            <th>Pin P2</th>
                            <th title="Aders met hetzelfde paarnummer zijn getwist">Paar</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in K.Aders)
                        {
                            <tr @key="a">
                                <td class="c">@a.Nummer</td>
                                <td class="kleur"><span class="kabel-staal" style="background:@KabelKleuren.Hex(a.Kleur)"></span><input @bind="a.Kleur" list="kabel-kleuren" placeholder="kleur" /></td>
                                <td><input type="number" min="1" @bind="a.PinP1" disabled="@(!K.P1.IsConnector)" placeholder="NC" /></td>
                                <td><input type="number" min="1" @bind="a.PinP2" disabled="@(!K.P2.IsConnector)" placeholder="NC" /></td>
                                <td><input type="number" min="1" @bind="a.Paar" placeholder="los" /></td>
                                <td><button class="klein" title="Deze ader weghalen" @onclick="() => K.VerwijderAder(a)">✕</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="uitleg">Leeg bij Pin = niet aangesloten (NC). Paar: aders met hetzelfde nummer zijn getwist en komen zo in de Wiring Table.</p>
            </section>

            <section class="kabel-kaart">
                <h3 class="wn-kop">Eisen en opmerkingen</h3>
                <div class="kabel-velden">
                    <label class="breed">Eisen voor de leverancier (Engels, een per regel; komen zo op de tekening)
                        <textarea rows="5" @bind="EisenTekst"></textarea>
                    </label>
                    <label class="breed">Opmerkingen bij de bestelling (Engels)
                        <textarea rows="2" @bind="K.Opmerkingen" placeholder="bv. please send your drawing for approval before production"></textarea>
                    </label>
                </div>
            </section>
        </div>

        <div class="kabel-rechts">
            <div class="kabel-knoppen">
                @* Opslaan werkte de geopende kabel bij, ook als je er een andere van had gemaakt (zo raakte de gebruiker
                   op 13-11-2026 configuraties kwijt). Daarom twee knoppen die zeggen wat ze doen. *@
                @if (K.Id == 0)
                {
                    <button class="primair" disabled="@(!KanOpslaan)" title="@OpslaanTip" @onclick="() => Bewaar(true)">💾 Opslaan als nieuwe kabel</button>
                }
                else
                {
                    <button class="primair" disabled="@(!KanOpslaan)" @onclick="() => Bewaar(false)"
                            title="@(KanOpslaan ? "De opgeslagen kabel bijwerken met wat er nu op het scherm staat" : OpslaanTip)">💾 Wijzigingen opslaan</button>
                    <button disabled="@(!KanOpslaan)" @onclick="() => Bewaar(true)"
                            title="@(KanOpslaan ? "Een nieuwe kabel bewaren naast de bestaande; geef hem eerst een eigen naam" : OpslaanTip)">＋ Opslaan als nieuwe kabel</button>
                }
                <button disabled="@_pdfBezig" title="De aanvraagtekening als PDF-bestand downloaden (A4 liggend), om mee te sturen met de aanvraag" @onclick="DownloadPdf">@(_pdfBezig ? "PDF maken…" : "⬇ PDF")</button>
                <button title="De specificatie als tekst op het klembord, voor in een e-mail aan LDZY" @onclick="KopieerSpec">📋 Spec kopiëren</button>
                @if (K.GewijzigdOp is { } gw)
                {
                    <span class="uitleg kabel-stand">opgeslagen @gw.ToString("d-M-yyyy HH:mm")@(K.GewijzigdDoor.Length > 0 ? " door " + K.GewijzigdDoor : "")</span>
                }
            </div>
            @if (_specTekst is not null)
            {
                <div class="kabel-spectekst">
                    <textarea readonly rows="12" @onclick="SelecteerSpec">@_specTekst</textarea>
                    <button class="klein" @onclick="() => _specTekst = null">Sluiten</button>
                </div>
            }
            <div class="kabel-tekening">@((MarkupString)Svg)</div>
        </div>
    </div>
</div>

@* ---------- artikelnummer aanmaken (tussenvenster, zoals Artikel toevoegen bij Artikelen) ---------- *@
@if (_artOpen)
{
    <div class="cmdk-overlay midden">
        <div class="fusion-kijker ec-venster verplaatsbaar art-nieuw">
            <div class="sleepkop fusion-kijker-kop">
                <b>Artikelnummer aanmaken voor deze kabel</b>
                <span style="flex:1"></span>
                <button class="klein" @onclick="() => _artOpen = false">✕ Sluiten</button>
            </div>
            <div class="fusion-kijker-inhoud">
                <p class="uitleg">
                    Er komt een nieuw artikel in Artikelen. Het nummer wordt het eigen artikelnummer van deze kabel en staat daarna op de
                    aanvraagtekening (MDE PART NO). Pas de gegevens hieronder aan waar nodig.
                </p>
                <div class="wn-velden een-kolom">
                    <div class="wn-veld">
                        <label>Artikelcode MDE *</label>
                        <input value="@_artCode" maxlength="100" @oninput="e => _artCode = (string?)e.Value ?? string.Empty" />
                    </div>
                    <div class="wn-veld">
                        <label>Omschrijving NL</label>
                        <textarea rows="3" value="@_artOms" @oninput="e => _artOms = (string?)e.Value ?? string.Empty"></textarea>
                    </div>
                    <div class="wn-veld">
                        <label>Merk</label>
                        <MerkKiezer @bind-Waarde="_artMerk" />
                    </div>
                    <div class="wn-veld">
                        <label>Fabrikantcode</label>
                        <input value="@_artFab" maxlength="100" placeholder="bv. het nummer van de kabelmaker, als dat er al is"
                               @oninput="e => _artFab = (string?)e.Value ?? string.Empty" />
                    </div>
                    <div class="wn-veld">
                        <label>Artikelgroep</label>
                        <div class="prod-artikel">
                            <span class="stand-chip s-blauw">@(_artGroep?.Pad ?? "— geen —")</span>
                            <button class="klein" @onclick="() => _artGroepOpen = true" title="Door de groepen bladeren">🗂 Kiezen</button>
                            @if (_artGroep is not null)
                            {
                                <button class="klein" @onclick="() => _artGroep = null">✕</button>
                            }
                        </div>
                    </div>
                </div>
                @if (_artFout is not null)
                {
                    <p class="uitleg fout-tekst">@_artFout</p>
                }
                <div class="btngroup">
                    <button class="primair" disabled="@(_artBezig || _artCode.Trim().Length == 0)" @onclick="MaakArtikel">@(_artBezig ? "Bezig…" : "Artikel aanmaken")</button>
                    <button class="klein" disabled="@_artBezig" @onclick="() => _artOpen = false">Annuleren</button>
                </div>
            </div>
        </div>
    </div>
}

<GroepenKiezer Open="_artGroepOpen" Titel="In welke groep hoort deze kabel?" Filteren="false" ToonWissen="false" Gekozen="@null"
               OpKeuze="ArtGroepGekozen" OpSluiten="() => _artGroepOpen = false" />

@code {
    private KabelSpec K = KabelSpec.Voorbeeld();
    private List<KabelOverzicht> _lijst = new();
    /// <summary>De eigen connectortypes (tabel KabelConnectoren); leeg als de tabel er nog niet is.</summary>
    private List<KabelConnector> _connectoren = new();
    private bool _tabel, _bezig, _meldingFout;
    private string? _melding;
    private static readonly CultureInfo Nl = CultureInfo.GetCultureInfo("nl-NL");
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    /// <summary>De tekening voor het scherm: het logo als adres (klein, de browser haalt het zelf op).</summary>
    private string Svg => KabelTekening.Maak(K, Door, logo: "logo-mde.png");

    /// <summary>De tekening voor de PDF: het logo zit erin (data-URI), zodat de pagina op zichzelf staat.</summary>
    private string SvgLos => KabelTekening.Maak(K, Door, logo: LogoData());

    private static string? _logoData;
    private string? LogoData()
    {
        if (_logoData is not null) return _logoData.Length > 0 ? _logoData : null;
        try { _logoData = "data:image/png;base64," + Convert.ToBase64String(File.ReadAllBytes(Path.Combine(Omgeving.WebRootPath, "logo-mde.png"))); }
        catch { _logoData = ""; }
        return _logoData.Length > 0 ? _logoData : null;
    }

    /// <summary>Hint onder het veld AWG: doorsnede en de richtwaarde voor de stroom per ader, ook met dit aantal aders bij elkaar.</summary>
    private string StroomHint
    {
        get
        {
            if (KabelStroom.MaxPerAder(K.Awg) is not double amp || KabelStroom.Doorsnede(K.Awg) is not double mm2)
                return "geen richtwaarde voor deze AWG (tabel loopt van 10 t/m 32)";
            static string A(double a) => a.ToString(a < 10 ? "0.##" : "0", Nl);
            var n = K.Aders.Count;
            var factor = KabelStroom.Bundelfactor(n);
            return $"{mm2.ToString(mm2 < 1 ? "0.###" : "0.##", Nl)} mm² · max. ca. {A(amp)} A per ader"
                 + (factor < 1 ? $"; met {n} aders bij elkaar ca. {A(Math.Round(amp * factor, 2))} A" : "");
        }
    }
    private string Door => Ik.Naam is { Length: > 0 } n ? n : "MDE";
    private bool KanOpslaan => Repo.Beschikbaar && _tabel && !_bezig && K.Naam.Trim().Length > 0;
    private string OpslaanTip => !Repo.Beschikbaar ? "Opslaan werkt alleen met de live database"
                               : !_tabel ? "Opslaan kan pas als de tabel Kabelconfiguraties bestaat"
                               : K.Naam.Trim().Length == 0 ? "Geef de kabel eerst een naam" : "Bewaren in de database";
    private IEnumerable<(string Naam, KabelEind Eind)> Einden => new[] { ("P1", K.P1), ("P2", K.P2) };

    /// <summary>De eisen als tekstvak: een regel per eis.</summary>
    private string EisenTekst
    {
        get => string.Join(Environment.NewLine, K.Eisen);
        set => K.Eisen = (value ?? "").Split('\n').Select(r => r.TrimEnd('\r').Trim()).Where(r => r.Length > 0).ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        await Ik.ZorgGeladenAsync();
        if (!Repo.Beschikbaar) return;
        try
        {
            _tabel = await Repo.TabelAanwezigAsync();
            if (_tabel) _lijst = await Repo.LijstAsync();
        }
        catch (Exception ex) { Toon("Opgeslagen kabels ophalen mislukt: " + ex.Message, true); }
        try { _connectoren = await Repo.ConnectorenAsync(); }
        catch { _connectoren = new(); }        // zonder lijst werkt het scherm met vrije tekst
    }

    /// <summary>Het type uit de lijst dat bij dit kabeleind hoort (zelfde housing), of 0 = zelf ingevuld.</summary>
    private int GekozenType(KabelEind e) => _connectoren.FirstOrDefault(c => c.PastOp(e))?.Id ?? 0;

    private void KiesType(KabelEind e, ChangeEventArgs ev)
    {
        if (int.TryParse(ev.Value?.ToString(), out var id) && _connectoren.FirstOrDefault(c => c.Id == id) is { } c) c.ZetOp(e);
    }

    private void NieuwVoorbeeld() { K = KabelSpec.Voorbeeld(); _melding = null; }
    private void NieuwLeeg() { K = KabelSpec.Leeg(); _melding = null; }
    private void Kopie() { K = K.Kopie(); Toon("Kopie gemaakt; sla hem op onder een eigen naam.", false); }

    private async Task LaadGekozen(ChangeEventArgs e)
    {
        if (!int.TryParse((string?)e.Value, out var id) || id == 0) { NieuwVoorbeeld(); return; }
        try
        {
            var k = await Repo.GetAsync(id);
            if (k is null) { Toon("Deze kabel is niet (meer) te lezen.", true); return; }
            K = k;
            _melding = null;
        }
        catch (Exception ex) { Toon("Kabel ophalen mislukt: " + ex.Message, true); }
    }

    /// <summary>
    /// Bewaart de kabel. <paramref name="nieuw"/> = als nieuwe kabel naast de bestaande (ook als er een geopend is);
    /// anders wordt de geopende kabel bijgewerkt. Een nieuwe kabel moet een naam hebben die nog niet bestaat, anders
    /// staan er twee met dezelfde naam in de keuzelijst.
    /// </summary>
    private async Task Bewaar(bool nieuw)
    {
        if (!KanOpslaan) return;
        nieuw |= K.Id == 0;
        var naam = K.Naam.Trim();
        if (nieuw && _lijst.Any(o => string.Equals(o.Naam.Trim(), naam, StringComparison.OrdinalIgnoreCase)))
        {
            Toon($"Er staat al een kabel met de naam \"{naam}\". Geef deze kabel een eigen naam (kaart Kabel) en sla hem dan op.", true);
            return;
        }
        _bezig = true;
        var wasId = K.Id;
        try
        {
            if (nieuw) { K.Id = 0; K.GemaaktOp = null; K.GemaaktDoor = ""; }
            await Repo.BewaarAsync(K, Ik.WerknemerId, Door);
            _lijst = await Repo.LijstAsync();
            Toon(nieuw ? $"Opgeslagen als nieuwe kabel: {naam}. Er staan nu {_lijst.Count} kabels."
                       : $"Wijzigingen opgeslagen in {naam}.", false);
        }
        catch (Exception ex)
        {
            if (K.Id == 0) K.Id = wasId;         // mislukt: de geopende kabel blijft de geopende
            Toon("Opslaan mislukt: " + ex.Message, true);
        }
        finally { _bezig = false; }
    }

    private async Task Verwijder()
    {
        if (K.Id == 0) return;
        bool ja;
        try { ja = await JS.InvokeAsync<bool>("mdeBevestig", $"Kabel \"{K.Naam}\" verwijderen? Dat kan niet ongedaan gemaakt worden."); }
        catch { ja = false; }
        if (!ja) return;
        _bezig = true;
        try
        {
            await Repo.VerwijderAsync(K.Id);
            _lijst = await Repo.LijstAsync();
            NieuwVoorbeeld();
            Toon("Verwijderd.", false);
        }
        catch (Exception ex) { Toon("Verwijderen mislukt: " + ex.Message, true); }
        finally { _bezig = false; }
    }

    private bool _pdfBezig;

    /// <summary>
    /// De aanvraagtekening als PDF-bestand (wens gebruiker 13-11-2026; verving de knoppen Afdrukken en SVG). De server
    /// zet de tekening op een A4 liggend en laat Edge er een PDF van maken (FactuurPdfService.NaarPdfAsync, dezelfde
    /// route als de factuur); de browser krijgt het bestand als download.
    /// </summary>
    private async Task DownloadPdf()
    {
        if (_pdfBezig) return;
        _pdfBezig = true; _melding = null;
        try
        {
            var html = "<!doctype html><html><head><meta charset=\"utf-8\"><title>" + System.Net.WebUtility.HtmlEncode(Bestandsnaam()) + "</title>" +
                       "<style>@page { size: A4 landscape; margin: 8mm; } html, body { margin: 0; background: #fff; } " +
                       "svg { width: 100%; height: auto; display: block; }</style></head><body>" + SvgLos + "</body></html>";
            var pdf = await PdfMaker.NaarPdfAsync(html);
            var gelukt = await JS.InvokeAsync<bool>("mdeKabel.downloadBestand", Bestandsnaam() + ".pdf", pdf, "application/pdf");
            if (!gelukt) Toon("De PDF is gemaakt, maar de browser wilde hem niet downloaden.", true);
        }
        catch (Exception ex) { Toon("PDF maken mislukt: " + ex.Message, true); }
        finally { _pdfBezig = false; }
    }

    private string? _specTekst;

    /// <summary>Spec naar het klembord; lukt dat niet (browser zonder klembordtoegang), dan komt de tekst in beeld om zelf te kopiëren.</summary>
    private async Task KopieerSpec()
    {
        var tekst = KabelTekening.SpecTekst(K);
        var gelukt = await JS.InvokeAsync<bool>("mdeKabel.kopieer", tekst);
        _specTekst = gelukt ? null : tekst;
        Toon(gelukt ? "De spec staat als tekst op het klembord." : "Kopiëren naar het klembord lukte niet; de tekst staat hieronder om zelf te kopiëren.", !gelukt);
    }

    private async Task SelecteerSpec() => await JS.InvokeVoidAsync("mdeKabel.selecteer", "kabel-spectekst");

    private string Bestandsnaam()
    {
        // ons eigen nummer en onze naam; geen nummer van een leverancier
        var naam = string.Join(" ", new[] { K.EigenNummer.Trim(), K.Naam.Trim() }.Where(t => t.Length > 0));
        if (naam.Length == 0) naam = "Kabel";
        foreach (var c in Path.GetInvalidFileNameChars()) naam = naam.Replace(c, '-');
        return naam;
    }

    private void ZetAders(ChangeEventArgs e)
    {
        if (int.TryParse((string?)e.Value, out var n)) K.ZetAantalAders(n);
    }

    /// <summary>De steekletter van LDZY, of "?" als de steek niet in hun schema staat (kan uit de connectorlijst komen).</summary>
    private static string SteekLetter(KabelEind e) => KabelNummer.Steekletter(e.Steek)?.ToString() ?? "?";

    private static void ZetSteek(KabelEind e, ChangeEventArgs ev)
    {
        var letter = ((string?)ev.Value ?? "").Trim();
        foreach (var (l, st) in KabelNummer.Steken)
            if (l.ToString() == letter) { e.Steek = st; return; }
    }

    private void Toon(string tekst, bool fout) { _melding = tekst; _meldingFout = fout; }

    // ---- artikelnummer aanmaken ----
    private bool _artOpen, _artBezig, _artGroepOpen;
    private string _artCode = "", _artOms = "", _artFab = "";
    private int? _artMerk;
    private Groepknoop? _artGroep;
    private string? _artFout;

    /// <summary>Het artikel van deze kabel: het aangemaakte, of een met de hand ingevuld nummer dat alleen uit cijfers bestaat.</summary>
    private int? ArtikelNummer => K.ArtikelId ?? (int.TryParse(K.EigenNummer.Trim(), out var n) && n > 0 ? n : null);

    private void OpenArtikel()
    {
        if (K.EigenNummer.Trim().Length > 0) return;
        var naam = K.Naam.Trim();
        _artCode = naam.Length > 100 ? naam[..100] : naam;
        _artOms = OmschrijvingNl();
        _artFab = ""; _artFout = null;          // merk en groep blijven staan voor de volgende kabel
        _artOpen = true;
    }

    private void ArtGroepGekozen(Groepknoop? knoop)
    {
        if (knoop is not null) _artGroep = knoop;
        _artGroepOpen = false;
    }

    /// <summary>Voorstel voor de omschrijving van het artikel, in het Nederlands, uit de gegevens van de kabel.</summary>
    private string OmschrijvingNl()
    {
        static string Eind(KabelEind e) => !e.IsConnector ? "open eind"
            : string.Join(" ", new[] { e.Familie.Trim(), e.Pinnen + "P", e.Housing.Trim().Length > 0 ? "(" + e.Housing.Trim() + ")" : "" }.Where(t => t.Length > 0));
        var aders = K.Aders.Count + (K.Aders.Count == 1 ? " ader" : " aders") + (K.Paren > 0 ? $" ({K.Paren} paar getwist)" : "");
        var soort = K.IsLosseAders ? "Losse aders" : "Kabel";
        var scherm = K.IsLosseAders ? "" : K.Afscherming == KabelAfscherming.Geen ? ", niet afgeschermd" : ", afgeschermd";
        return $"{soort} {K.DraadType} {K.Awg}AWG, {aders}{scherm}, {K.Lengte} mm. P1: {Eind(K.P1)}. P2: {Eind(K.P2)}.".Replace("  ", " ");
    }

    /// <summary>
    /// Maakt het artikel (zelfde functie als Artikel toevoegen bij Artikelen) en zet het nummer bij de kabel. Is de kabel
    /// al opgeslagen, dan wordt hij meteen bijgewerkt, zodat nummer en kabel bij elkaar blijven.
    /// </summary>
    private async Task MaakArtikel()
    {
        if (_artBezig || _artCode.Trim().Length == 0) return;
        _artBezig = true; _artFout = null;
        try
        {
            var id = await Artikelen.NieuwArtikelAsync(_artCode, _artOms, _artMerk, _artFab, _artGroep?.Id, Ik.WerknemerId);
            K.ArtikelId = id;
            K.EigenNummer = id.ToString();
            _artOpen = false;
            if (K.Id != 0 && KanOpslaan)
            {
                try
                {
                    await Repo.BewaarAsync(K, Ik.WerknemerId, Door);
                    _lijst = await Repo.LijstAsync();
                    Toon($"Artikel #{id} aangemaakt en bij de kabel bewaard.", false);
                }
                catch (Exception ex) { Toon($"Artikel #{id} is aangemaakt, maar de kabel bijwerken mislukte: {ex.Message} Sla de kabel zelf nog op.", true); }
            }
            else Toon($"Artikel #{id} aangemaakt. Sla de kabel op, dan blijft het nummer erbij bewaard.", false);
        }
        catch (Exception ex) { _artFout = ex.Message; }
        finally { _artBezig = false; }
    }
}
