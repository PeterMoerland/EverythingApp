    private async Task LabelsoortGewijzigd(ChangeEventArgs e)
    {
        _labelsoort = (string?)e.Value ?? "klein";
        try { await JS.InvokeVoidAsync("mdeOpslag.schrijf", "dymoLabel", _labelsoort); } catch { }
    }

    // Niet meteen bijsturen tijdens het typen: als we hier de waarde veranderen ziet
    // Blazor geen verschil met de vorige tekening en blijft het vakje staan op wat de
    // gebruiker typte. Het begrenzen gebeurt daarom pas bij het printen.
    private void LabelAantalGewijzigd(ChangeEventArgs e)
        => _labelAantal = int.TryParse((string?)e.Value, out var v) ? v : 1;

    private async Task PrintLabel()
    {
        if (_artikelId is null || string.IsNullOrWhiteSpace(_printer)) return;

        var aantal = Math.Clamp(_labelAantal, 1, 20);

        _printBezig = true;
        try
        {
            // de tekening wordt hier gemaakt en gaat als tekst naar DYMO Connect
            var xml = await Labels.ArtikelLabelAsync(_artikelId.Value, _artikel?.Code ?? "",
                                                     _artikel?.OmschrijvingNl ?? "",
                                                     _labelsoort == "groot");
            // de rol volgt uit het gekozen label (Beheer ▸ Labelprinter)
            var rol = IsTwinTurbo ? _dymo.RolVoor(_labelsoort) : "Auto";
            await JS.InvokeVoidAsync("mdeDymo.print", _printer, xml, aantal, rol);
            Toon($"{aantal} label(s) naar {_printer}" + (IsTwinTurbo ? $" (rol {DymoLabel.RolTekst(rol)})" : "") + ".", false);
        }
        catch (Exception ex) { Toon("Printen mislukt: " + ex.Message, true); }
        finally { _printBezig = false; }
    }

    // ---- inkoopprijs van een onderdeel ----
    private Samenstellingregel? _prijsRegel;
    private string _prijsInvoer = "";
    private decimal _toeslag;

    private async Task VraagPrijs(Samenstellingregel regel)
    {
        _prijsRegel = regel;
        _prijsInvoer = regel.Kostprijs is null or 0 ? "" : regel.Kostprijs.Value.ToString("0.00");

        try { _toeslag = await Instellingen.ToeslagAsync(); }
        catch { _toeslag = 0; }
    }

    private void SluitPrijs() => _prijsRegel = null;

    private void PrijsInvoerGewijzigd(ChangeEventArgs e) => _prijsInvoer = (string?)e.Value ?? "";

    private decimal Ingevoerd()
    {
        var tekst = _prijsInvoer.Replace(".", "").Replace(',', '.').Trim();
        return decimal.TryParse(tekst, System.Globalization.NumberStyles.Any,
                                System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 0;
    }

    private decimal Verkoop() => Math.Round(Ingevoerd() * (1 + _toeslag / 100m), 2);

    private async Task BewaarPrijs()
    {
        if (_prijsRegel is null) return;

        try
        {
            await Repo.ZetKostprijsAsync(_prijsRegel.ArtikelId, Ingevoerd(), _toeslag);
            var code = _prijsRegel.Code;
            _prijsRegel = null;

            await HerlaadStuklijst();
            if (_artikelId is not null) _artikel = await Repo.GetAsync(_artikelId.Value);

            Toon($"Prijs van {code} vastgelegd; verkoopprijs berekend met {_toeslag:0.##} %.", false);
        }
        catch (Exception ex) { Toon("Opslaan mislukt: " + ex.Message, true); }
    }

    // ---- onderdeel toevoegen ----
    private string _onderdeelZoek = "";
    private List<ArtikelRegel> _kandidaten = new();

    private async Task OnderdeelZoekGewijzigd(ChangeEventArgs e)
    {
        _onderdeelZoek = (string?)e.Value ?? "";
        if (_onderdeelZoek.Trim().Length < 2) { _kandidaten = new(); return; }

        try { _kandidaten = await Repo.ZoekAsync(_onderdeelZoek, null, maakdelen: false, 15); }
        catch { _kandidaten = new(); }
    }

    private async Task VoegOnderdeelToe(ArtikelRegel k)
    {
        if (_artikel is null) return;
        if (k.Id == _artikel.Id) { Toon("Een artikel kan niet in zichzelf zitten.", true); return; }

        try
        {
            await Repo.BewaarSamenstellingregelAsync(_artikel.Id,
                new Samenstellingregel { ArtikelId = k.Id, Aantal = 1 });

            _onderdeelZoek = "";
            _kandidaten = new();
            await HerlaadStuklijst();
            Toon($"{k.Code} toegevoegd.", false);
        }
        catch (Exception ex) { Toon("Toevoegen mislukt: " + ex.Message, true); }
    }

    private string Kenmerken()
    {
        if (_artikel is null) return "";
        var uit = new List<string>();
        if (_artikel.Samenstelling) uit.Add("samenstelling");
        if (_artikel.Voorraadartikel) uit.Add("voorraadartikel");
        if (_artikel.Standaard) uit.Add("standaard");
        if (_artikel.InventorPart) uit.Add("Inventor-onderdeel");
        if (_artikel.IsProduct) uit.Add("product");
        if (_artikel.Webshop) uit.Add("webshop");
        if (_artikel.Uitleenbaar) uit.Add("uitleenbaar");
        if (_artikel.CheckNodig) uit.Add("check nodig");
        return uit.Count == 0 ? "—" : string.Join(", ", uit);
    }

