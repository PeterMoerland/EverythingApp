@page "/artikelen"
@inject IArtikelRepository Repo
@inject IWerknemerRepository WnRepo
@inject IInstellingRepository Instellingen
@inject LabelService Labels
@inject IJSRuntime JS
@inject HuidigeGebruiker Ik
@inject ArtikelFotoService Fotos
@implements IAsyncDisposable

<div class="page">
    <header class="topbar">
        <h1>@(_artikel is null ? "Artikelen" : _artikel.Code)</h1>
        <span class="weeklabel">@_lijst.Count gevonden</span>
    </header>

    @if (!Repo.Beschikbaar)
    {
        <section class="module-placeholder"><p>Dit scherm werkt alleen met de live database.</p></section>
    }
    else
    {
        @if (_melding is not null)
        {
            <div class="melding @(_fout ? "fout" : "ok")" @onclick="SluitMelding">@_melding</div>
        }

        <div class="wn-scherm">
            @* ---------- links: zoeken ---------- *@
            <aside class="wn-lijst artikel-lijst">
                <div class="wn-filters">
                    <div class="zoekregel">
                        <input placeholder="Steekwoorden, bijv. PLC NX 1100" value="@_zoek"
                               @onchange="ZoekGewijzigd" />
                        <button class="klein" disabled="@(_zoek.Length == 0)" @onclick="WisZoek">✕</button>
                    </div>
                    <div class="zoekregel">
                        <input placeholder="Groep, bijv. Elektro/PLC" value="@_groep" @onchange="GroepGewijzigd" />
                        <button class="klein" title="Door de groepen bladeren"
                                @onclick="OpenGroepFilter">🗂</button>
                        <button class="klein" disabled="@(_groep.Length == 0 && _groepIds.Count == 0)"
                                @onclick="WisGroep">✕</button>
                    </div>
                    <p class="toetsuitleg">
                        Elk woord moet ergens voorkomen: in de code, de omschrijving,
                        het merk of de groep.
                    </p>
                </div>

                <div class="wn-namen artikel-namen">
                    @if (_lijst.Count == 0)
                    {
                        <div class="kiezer-info">
                            @(_gezocht ? "Niets gevonden." : "Typ een paar steekwoorden.")
                        </div>
                    }
                    else
                    {
                        @foreach (var a in _lijst)
                        {
                            <button class="wn-naam @(a.Id == _artikelId ? "actief" : "")"
                                    @key="a.Id" @onclick="() => Kies(a)">
                                <span class="nda-regel">
                                    <span class="nda-naam">
                                        <span class="artikel-id">@a.Id</span>@a.Code
                                    </span>
                                    <span class="nda-onder">@a.Omschrijving</span>
                                </span>
                            </button>
                        }
                    }
                </div>
                <div class="btngroep-rand">
                    <button class="klein" @onclick="OpenNieuw" title="Nieuw artikel aanmaken (zoals ArtikelNieuw in Access)">+ Artikel</button>
                </div>
            </aside>

            @* ---------- rechts: het artikel ---------- *@
            <section class="wn-detail">
                @if (_artikel is null)
                {
                    <div class="kiezer-info">Kies links een artikel.</div>
                }
                else
                {
                    <div class="wn-tabs">
                        @foreach (var tab in Tabs)
                        {
                            <button class="@(tab == _tab ? "actief" : "")" @onclick="() => _tab = tab">@tab</button>
                        }
                        @* Alleen bij een samenstelling: de stuklijst eronder *@
                        @if (_artikel.Samenstelling || _stuklijst.Count > 0)
                        {
                            <button class="@("Samenstelling" == _tab ? "actief" : "")"
                                    @onclick="KiesSamenstelling">Samenstelling (@_stuklijst.Count)</button>
                        }
                    </div>

                    @if (_tab == "Samenstelling")
                    {
                        <p class="uitleg">
                            Een onderdeel met een pijltje is zelf een samenstelling; klik erop om
                            de stuklijst daaronder te zien.
                        </p>

                        <div class="stuklijst">
                            <div class="stuk-regel kop">
                                <span class="stuk-pijl leeg"></span>
                                <span class="stuk-aantal">Aantal</span>
                                <span class="stuk-nummer">MDE#</span>
                                <span class="stuk-code">Partnumber</span>
                                <span class="stuk-oms">Omschrijving</span>
                                <span class="stuk-opm">Opmerking</span>
                                <span class="stuk-prijs">Kostprijs</span>
                                <span class="stuk-totaal">Totaal</span>
                            </div>

                            @foreach (var regel in _stuklijst)
                            {
                                <SamenstellingTak Regel="regel" Niveau="0" Ophalen="Onderdelen"
                                                  Ouder="_artikel.Id" OpSlaan="BewaarRegel"
                                                  OpVerwijderen="VerwijderRegel" OpPrijs="VraagPrijs"
                                                  @key="regel.Id" />
                            }

                            @if (_stuklijst.Count == 0)
                            {
                                <div class="kiezer-info">Geen onderdelen vastgelegd.</div>
                            }
                            else
                            {
                                <div class="stuk-regel som">
                                    <span class="stuk-pijl leeg"></span>
                                    <span class="stuk-aantal"></span>
                                    <span class="stuk-nummer"></span>
                                    <span class="stuk-code"></span>
                                    <span class="stuk-oms"></span>
                                    <span class="stuk-opm">Kostprijs totaal</span>
                                    <span class="stuk-prijs"></span>
                                    <span class="stuk-totaal">@BedragOf(_stuklijst.Sum(r => r.Totaal))</span>
                                    <span class="stuk-weg"></span>
                                </div>
                            }
                        </div>

                        @* onderdeel toevoegen: eerst het artikel zoeken *@
                        <div class="tl-balk">
                            <input class="mail-zoek" placeholder="Onderdeel zoeken om toe te voegen…"
                                   value="@_onderdeelZoek" @onchange="OnderdeelZoekGewijzigd" />
                        </div>
                        @if (_kandidaten.Count > 0)
                        {
                            <div class="wn-namen kort">
                                @foreach (var k in _kandidaten)
                                {
                                    <button class="wn-naam" @key="k.Id" @onclick="() => VoegOnderdeelToe(k)">
                                        <span class="artikel-id">@k.Id</span>@k.Code — @k.Omschrijving
                                    </button>
                                }
                            </div>
                        }
                        <p class="uitleg">
                            Onderdelen voeg je toe aan het artikel dat je nu bekijkt. Hoort er iets
                            in een onderliggende samenstelling, open dan dát artikel — zo blijft de
                            stuklijst van elk artikel op één plek staan.
                        </p>
                    }

                    @if (_tab == "Info")
                    {
                        <DetailMetZij>
                            <Hoofd>
                                @* Bewerken staat standaard uit: de meeste mensen komen kijken,
                                   niet wijzigen. Wie mag wijzigen zet het met de knop aan. *@
                                <div class="bewerkbalk">
                                    @if (!_bewerken)
                                    {
                                        <button class="klein" disabled="@(!MagBewerken)"
                                                @onclick="StartBewerken">✎ Bewerken</button>
                                        @if (!MagBewerken)
                                        {
                                            <span class="uitleg">Je hebt geen recht om artikelen te wijzigen.</span>
                                        }
                                    }
                                    else
                                    {
                                        <button class="primair" disabled="@_bewaren" @onclick="BewaarArtikel">
                                            @(_bewaren ? "Bezig…" : "Opslaan")
                                        </button>
                                        <button class="klein" @onclick="StopBewerken">Annuleren</button>
                                        <span class="uitleg">Wijzigingen gaan pas naar de database als je opslaat.</span>
                                    }
                                </div>

                                <div class="wn-velden een-kolom">
                                    <div class="wn-veld">
                                        <label>Artikelcode</label>
                                        @if (_bewerken)
                                        {
                                            <input value="@_artikel.Code" @onchange="e => _artikel.Code = Tekst(e)" />
                                        }
                                        else
                                        {
                                            <span class="alleen-lezen">@_artikel.Code</span>
                                        }
                                    </div>

                                    <div class="wn-veld breed">
                                        <label>Omschrijving</label>
                                        @if (_bewerken)
                                        {
                                            <input value="@_artikel.OmschrijvingNl"
                                                   @onchange="e => _artikel.OmschrijvingNl = Tekst(e)" />
                                        }
                                        else
                                        {
                                            <span class="alleen-lezen">@_artikel.OmschrijvingNl</span>
                                        }
                                    </div>

                                    <div class="wn-veld"><label>MDE artikel-ID</label><span class="alleen-lezen">@_artikel.Id</span></div>

                                    <div class="wn-veld">
                                        <label>Merk</label>
                                        @if (_bewerken)
                                        {
                                            <MerkKiezer Waarde="_artikel.MerkId" WaardeChanged="MerkGekozen" OpNieuwMerk="MerkToegevoegd" />
                                        }
                                        else
                                        {
                                            <span class="alleen-lezen">@_artikel.Merk</span>
                                        }
                                    </div>

                                    <div class="wn-veld">
                                        <label>Code fabrikant</label>
                                        @if (_bewerken)
                                        {
                                            <input value="@_artikel.CodeFabrikant"
                                                   @onchange="e => _artikel.CodeFabrikant = Tekst(e)" />
                                        }
                                        else
                                        {
                                            <span class="alleen-lezen">@_artikel.CodeFabrikant</span>
                                        }
                                    </div>

                                    <div class="wn-veld breed">
                                        <label>Opmerking</label>
                                        @if (_bewerken)
                                        {
                                            <textarea rows="3" value="@_artikel.Opmerking"
                                                      @onchange="e => _artikel.Opmerking = Tekst(e)"></textarea>
                                        }
                                        else
                                        {
                                            <span class="alleen-lezen">@_artikel.Opmerking</span>
                                        }
                                    </div>

                                    <div class="wn-veld"><label>Eenheid</label><span class="alleen-lezen">@_artikel.Eenheid</span></div>

                                    <div class="wn-veld">
                                        <label>EAN-code</label>
                                        @if (_bewerken)
                                        {
                                            <input value="@_artikel.Ean" @onchange="e => _artikel.Ean = Tekst(e)" />
                                        }
                                        else
                                        {
                                            <span class="alleen-lezen">@_artikel.Ean</span>
                                        }
                                    </div>

                                    <div class="wn-veld">
                                        <label>OC-code Omron</label>
                                        @if (_bewerken)
                                        {
                                            <input value="@_artikel.OcCodeOmron"
                                                   @onchange="e => _artikel.OcCodeOmron = Tekst(e)" />
                                        }
                                        else
                                        {
                                            <span class="alleen-lezen">@_artikel.OcCodeOmron</span>
                                        }
                                    </div>

                                    <div class="wn-veld">
                                        <label>Materiaal</label>
                                        @if (_bewerken)
                                        {
                                            <input value="@_artikel.Materiaal"
                                                   @onchange="e => _artikel.Materiaal = Tekst(e)" />
                                        }
                                        else
                                        {
                                            <span class="alleen-lezen">@_artikel.Materiaal</span>
                                        }
                                    </div>

                                    <div class="wn-veld">
                                        <label>Gewicht (kg)</label>
                                        @if (_bewerken)
                                        {
                                            <input class="r smal" value="@Invoergetal(_artikel.Gewicht)"
                                                   @onchange="e => _artikel.Gewicht = Komma(e)" />
                                        }
                                        else
                                        {
                                            <span class="alleen-lezen">@Getal(_artikel.Gewicht)</span>
                                        }
                                    </div>

                                    <div class="wn-veld">
                                        <label>Plaatdikte (mm)</label>
                                        @if (_bewerken)
                                        {
                                            <input class="r smal" value="@Invoergetal(_artikel.PlaatdikteMm)"
                                                   @onchange="e => _artikel.PlaatdikteMm = Komma(e)" />
                                        }
                                        else
                                        {
                                            <span class="alleen-lezen">@Getal(_artikel.PlaatdikteMm)</span>
                                        }
                                    </div>

                                    <div class="wn-veld">
                                        <label>Minimum voorraad</label>
                                        @if (_bewerken)
                                        {
                                            <input class="r smal" value="@Invoergetal(_artikel.MinimumVoorraad)"
                                                   @onchange="e => _artikel.MinimumVoorraad = Komma(e)" />
                                        }
                                        else
                                        {
                                            <span class="alleen-lezen">@Getal(_artikel.MinimumVoorraad)</span>
                                        }
                                    </div>

                                    <div class="wn-veld">
                                        <label>Bestellen per</label>
                                        @if (_bewerken)
                                        {
                                            <input class="r smal" value="@Invoergetal(_artikel.Bestelhoeveelheid)"
                                                   @onchange="e => _artikel.Bestelhoeveelheid = Komma(e)" />
                                        }
                                        else
                                        {
                                            <span class="alleen-lezen">@Getal(_artikel.Bestelhoeveelheid)</span>
                                        }
                                    </div>

                                    <div class="wn-veld">
                                        <label>Schattingsprijs</label>
                                        @if (_bewerken)
                                        {
                                            <input class="r smal" value="@Invoerbedrag(_artikel.Schattingsprijs)"
                                                   @onchange="e => _artikel.Schattingsprijs = Bedragvan(e)" />
                                        }
                                        else
                                        {
                                            <span class="alleen-lezen">@Bedrag(_artikel.Schattingsprijs)</span>
                                        }
                                    </div>

                                    <div class="wn-veld">
                                        <label>Verkoopprijs webshop</label>
                                        @if (_bewerken)
                                        {
                                            <input class="r smal" value="@Invoerbedrag(_artikel.VerkoopprijsWebshop)"
                                                   @onchange="e => _artikel.VerkoopprijsWebshop = Bedragvan(e)" />
                                        }
                                        else
                                        {
                                            <span class="alleen-lezen">@Bedrag(_artikel.VerkoopprijsWebshop)</span>
                                        }
                                    </div>

                                    @if (!_bewerken)
                                    {
                                        <div class="wn-veld"><label>Kenmerken</label><span class="alleen-lezen">@Kenmerken()</span></div>
                                    }

                                    <div class="wn-veld">
                                        <label>Samenstelling</label>
                                        @* Dit vinkje slaat meteen op: er hangt een heel tabblad
                                           aan vast, dus wachten op 'Opslaan' zou verwarren. Wel
                                           alleen als er verder niets openstaat te bewerken. *@
                                        <input type="checkbox" checked="@_artikel.Samenstelling"
                                               disabled="@(!MagBewerken || _bewerken)"
                                               @onchange="SamenstellingGewijzigd" />
                                    </div>
                                </div>

                                @if (_bewerken)
                                {
                                    @* De losse ja/nee-velden bij elkaar; los van elkaar in het
                                       raster kosten ze veel ruimte voor één vinkje. *@
                                    <div class="vinkrij">
                                        @foreach (var v in Vinkjes())
                                        {
                                            <label class="vinkje" @key="v.Label">
                                                <input type="checkbox" checked="@v.Aan()"
                                                       @onchange="e => v.Zet(Vink(e))" />
                                                @v.Label
                                            </label>
                                        }
                                    </div>
                                }

                                <h3 class="wn-kop">Label printen</h3>
                                <div class="labelbalk">
                                    <select value="@_labelsoort" @onchange="LabelsoortGewijzigd">
                                        <option value="klein">Klein — 12 × 50 mm (99017)</option>
                                        <option value="groot">Groot — 41 × 89 mm (11356)</option>
                                    </select>

                                    @if (_printers.Count > 0)
                                    {
                                        <input class="aantal" type="number" min="1" max="20"
                                               value="@_labelAantal" @onchange="LabelAantalGewijzigd" />
                                        <button class="primair" disabled="@_printBezig" @onclick="PrintLabel">
                                            @(_printBezig ? "Bezig…" : "🖨 Printen")
                                        </button>
                                        @* Printer en rol per label staan bij Beheer ▸ Labelprinter (deze pc). *@
                                    }
                                    else
                                    {
                                        <button class="klein" @onclick="ZoekPrinters">Printers zoeken</button>
                                        <a class="knopje" href="beheer/labelprinter">⚙ Labelprinter instellen</a>
                                        <span class="uitleg">@_dymoMelding</span>
                                    }
                                </div>

                                @if (_printers.Count > 0 && _dymoMelding.Length > 0)
                                {
                                    <p class="uitleg">@_dymoMelding</p>
                                }

                                <p class="uitleg">
                                    De opmaak komt uit een labelbestand dat in DYMO Connect is gemaakt.
                                    Wil je iets verschuiven, open dan Templates\DymoKlein.dymo of
                                    DymoGroot.dymo in DYMO Connect en bewaar het opnieuw.
                                </p>

                                @if (_dymoDiagnose is not null)
                                {
                                    <pre class="dymodiagnose">@_dymoDiagnose</pre>
                                }

                                <div class="btngroup">
                                    <a class="knopje" href="@GoogleUrl()" target="_blank">Zoek op Google</a>
                                    @if (!string.IsNullOrWhiteSpace(_artikel.Ean))
                                    {
                                        <a class="knopje" href="@EanUrl()" target="_blank">EAN opzoeken</a>
                                    }
                                </div>
                            </Hoofd>
                            <Zij>
                                <ZijBlok Titel="Foto">
                                    @* Uit de aparte fotomap van de artikelen. Is er geen foto,
                                       dan verbergt de browser het plaatje en blijft de tekst staan.
                                       De @key dwingt een vers element af per artikel: anders blijft
                                       het 'display:none' van een artikel zonder foto plakken en
                                       lijkt de foto daarna bij élk artikel te ontbreken. *@
                                    <div class="artikelfoto-vak" @key="@($"{_artikelId}-{_fotoVersie}")" data-plak-url="@FotoUploadUrl">
                                        <img class="artikelfoto-groot" src="@ArtikelFoto()" alt=""
                                             title="@_artikel.Code"
                                             onload="this.style.display='';
                                                     this.nextElementSibling.style.display='none'"
                                             onerror="this.style.display='none';
                                                      this.nextElementSibling.style.display='block'" />
                                        <span class="geen-foto">Geen foto bij dit artikel.</span>
                                    </div>
                                    <div class="btngroup foto-knoppen">
                                        <button class="klein" disabled="@_fotoBezig" @onclick="PlakFoto"
                                                title="Afbeelding van het klembord als foto van dit artikel opslaan (of druk Ctrl+V op dit scherm)">
                                            @(_fotoBezig ? "Bezig…" : "📋 Plakken uit klembord")
                                        </button>
                                        <label class="klein knopje" title="Een afbeeldingsbestand kiezen">
                                            📁 Bestand…
                                            <InputFile OnChange="FotoBestandGekozen" accept="image/*" style="display:none" />
                                        </label>
                                    </div>
                                    @if (_fotoMelding is not null)
                                    {
                                        <p class="uitleg @(_fotoFout ? "fout-tekst" : "")">@_fotoMelding</p>
                                    }
                                </ZijBlok>

                                <ZijBlok Titel="Prijzen">
                                    <div class="zij-regel">
                                        <span class="zij-naam">@Bedrag(_artikel.Kostprijs)</span>
                                        <span class="zij-extra">vastgestelde kostprijs</span>
                                    </div>
                                    <div class="zij-regel">
                                        <span class="zij-naam">@Bedrag(_artikel.VerkoopprijsProject)</span>
                                        <span class="zij-extra">verkoopprijs project</span>
                                    </div>
                                </ZijBlok>

                                <ZijBlok Titel="Voorraad">
                                    <div class="zij-regel">
                                        <span class="zij-naam">@Getal(_artikel.AantalInVoorraad) @_artikel.Eenheid</span>
                                        <span class="zij-extra">
                                            minimum @Getal(_artikel.MinimumVoorraad) ·
                                            bestellen per @Getal(_artikel.Bestelhoeveelheid)
                                        </span>
                                    </div>
                                </ZijBlok>

                                <ZijBlok Titel="Groepen" Aantal="_groepen.Count"
                                         Leeg="@(_groepen.Count == 0 && !MagBewerken)"
                                         LeegTekst="Nog in geen enkele groep.">
                                    @foreach (var g in _groepen)
                                    {
                                        <div class="zij-regel" @key="g.Id">
                                            <span class="zij-naam">@g.Volledig</span>
                                            @if (MagBewerken)
                                            {
                                                <button class="zij-weg" title="Uit deze groep halen"
                                                        @onclick="() => HaalUitGroep(g)">✕</button>
                                            }
                                        </div>
                                    }
                                    @if (MagBewerken)
                                    {
                                        <button class="klein" @onclick="OpenGroepToevoegen">＋ In een groep zetten</button>
                                    }
                                </ZijBlok>
                            </Zij>
                        </DetailMetZij>
                    }

                    @if (_tab == "Documenten")
                    {
                        <table class="kiezer-tabel">
                            <thead>
                                <tr>
                                    <th>Bestand</th>
                                    <th style="width:10rem">Toegevoegd</th>
                                    <th style="width:5rem" class="r">Dagen</th>
                                    <th style="width:11rem">Door</th>
                                    <th style="width:4rem"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Nieuwste())
                                {
                                    <tr @key="d.FileStoreId">
                                        <td>
                                            <button class="bestandnaam" title="Bekijken"
                                                    @onclick="() => ToonVoorbeeld(d.FileStoreId, d.Bestandsnaam)">
                                                @d.Bestandsnaam
                                            </button>
                                        </td>
                                        <td>@(d.Toegevoegd?.ToString("dd-MM-yyyy HH:mm") ?? "")</td>
                                        <td class="r">@DagenOud(d)</td>
                                        <td>@d.ToegevoegdDoor</td>
                                        <td class="c">
                                            <a class="knopje" href="@("bestand/" + d.FileStoreId + "/download")"
                                               title="Downloaden">⭳</a>
                                        </td>
                                    </tr>
                                }
                                @if (Nieuwste().Count == 0)
                                {
                                    <tr><td colspan="5" class="kiezer-info">Geen documentatie bij dit artikel.</td></tr>
                                }
                            </tbody>
                        </table>
                        <label class="vink">
                            <input type="checkbox" checked="@_alleenNieuwste" @onchange="NieuwsteGewijzigd" />
                            Alleen nieuwste versies weergeven
                        </label>
                    }

                    @if (_tab == "Groepen")
                    {
                        @if (_groepen.Count == 0)
                        {
                            <p class="uitleg">Dit artikel zit nog in geen enkele groep.</p>
                        }
                        else
                        {
                            <ul class="groeplijst">
                                @foreach (var g in _groepen)
                                {
                                    <li @key="g.Id">@g.Volledig</li>
                                }
                            </ul>
                        }
                    }

                    @if (_tab == "Alias")
                    {
                        <p class="uitleg">
                            Deze lijst wordt gebruikt bij het importeren uit SEE Electrical en Inventor.
                            Aliassen ontstaan tijdens dat importeren.
                        </p>
                        <table class="kiezer-tabel smal-tabel">
                            <thead><tr><th>Alias</th><th style="width:8rem">Bron</th></tr></thead>
                            <tbody>
                                @foreach (var a in _aliassen)
                                {
                                    <tr><td>@a.Alias</td><td>@a.Bron</td></tr>
                                }
                                @if (_aliassen.Count == 0)
                                {
                                    <tr><td colspan="2" class="kiezer-info">Geen aliassen.</td></tr>
                                }
                            </tbody>
                        </table>
                    }

                    @if (_tab == "Overigen")
                    {
                        <div class="wn-velden een-kolom">
                            <div class="wn-veld"><label>Toegevoegd</label>
                                <span class="alleen-lezen">
                                    @(_artikel.Toegevoegd?.ToString("dd-MM-yyyy") ?? "") @_artikel.ToegevoegdDoor
                                </span>
                            </div>
                            <div class="wn-veld"><label>Laatst gewijzigd</label>
                                <span class="alleen-lezen">
                                    @(_artikel.Gewijzigd?.ToString("dd-MM-yyyy HH:mm") ?? "") @_artikel.GewijzigdDoor
                                </span>
                            </div>
                            <div class="wn-veld"><label>Gewicht</label><span class="alleen-lezen">@Getal(_artikel.Gewicht)</span></div>
                            <div class="wn-veld"><label>Uitgeleend</label><span class="alleen-lezen">@_artikel.AantalUitgeleend</span></div>
                        </div>
                    }
                }
            </section>
        </div>
    }

    <footer class="voet">
        Wijzigen, leveranciers, prijshistorie en voorraadmutaties volgen later;
        daarvoor gebruik je voorlopig Access.
    </footer>
</div>

<BestandVoorbeeld Id="_voorbeeldId" Naam="_voorbeeldNaam" Sluiten="SluitVoorbeeld" />

@* ===== boom met artikelgroepen =====
   Dezelfde popup voor twee dingen: de zoeklijst filteren, en het artikel dat
   je bekijkt in een groep zetten. *@
@* ---------- nieuw artikel (popup, naar het voorbeeld van ArtikelNieuw in Access) ---------- *@
@if (_nieuwOpen)
{
    <div class="cmdk-overlay midden">
        <div class="fusion-kijker ec-venster verplaatsbaar art-nieuw">
            <div class="sleepkop fusion-kijker-kop">
                <b>Artikel toevoegen</b>
                <span style="flex:1"></span>
                <button class="klein" @onclick="() => _nieuwOpen = false">✕ Sluiten</button>
            </div>
            <div class="fusion-kijker-inhoud">
                <div class="wn-velden een-kolom">
                    <div class="wn-veld">
                        <label>Artikelcode MDE *</label>
                        <input value="@_nieuwCode" maxlength="100" autofocus @oninput="e => _nieuwCode = (string?)e.Value ?? string.Empty" />
                    </div>
                    <div class="wn-veld">
                        <label>Omschrijving NL</label>
                        <textarea rows="3" value="@_nieuwOms" @oninput="e => _nieuwOms = (string?)e.Value ?? string.Empty"></textarea>
                    </div>
                    <div class="wn-veld">
                        <label>Merk</label>
                        @* Typen met suggesties; een onbekend merk wordt na bevestiging toegevoegd (NotInList). *@
                        <MerkKiezer @bind-Waarde="_nieuwMerk" OpNieuwMerk="MerkToegevoegd" />
                    </div>
                    <div class="wn-veld">
                        <label>Fabrikantcode</label>
                        <input value="@_nieuwFab" maxlength="100" @oninput="e => _nieuwFab = (string?)e.Value ?? string.Empty" />
                    </div>
                    <div class="wn-veld">
                        <label>Artikelgroep</label>
                        <div class="prod-artikel">
                            <span class="stand-chip s-blauw">@(_nieuwGroep?.Pad ?? "— geen —")</span>
                            <button class="klein" @onclick="OpenGroepNieuw" title="Door de groepen bladeren">🗂 Kiezen</button>
                            @if (_nieuwGroep is not null)
                            {
                                <button class="klein" @onclick="() => _nieuwGroep = null">✕</button>
                            }
                        </div>
                    </div>
                </div>
                @if (_nieuwFout is not null)
                {
                    <p class="uitleg fout-tekst">@_nieuwFout</p>
                }
                <div class="btngroup">
                    <button class="primair" disabled="@(_nieuwBezig || _nieuwCode.Trim().Length == 0)" @onclick="() => MaakNieuw(true)">OK</button>
                    <button class="klein" disabled="@(_nieuwBezig || _nieuwCode.Trim().Length == 0)" @onclick="() => MaakNieuw(false)"
                            title="Aanmaken en het formulier open laten voor het volgende artikel">Toepassen</button>
                    <button class="klein" @onclick="() => _nieuwOpen = false">Annuleren</button>
                </div>
            </div>
        </div>
    </div>
}

<GroepenKiezer Open="@(_groepKiezer is not null)" Titel="@GroepTitel"
               Filteren="@(_groepKiezer == "filter")" ToonWissen="@(_groepKiezer == "filter")"
               Gekozen="@(_groepKiezer == "filter" ? _groep : null)"
               OpKeuze="GroepGekozen" OpSluiten="SluitGroepKiezer" />

@* ===== inkoopprijs van een onderdeel ===== *@
@if (_prijsRegel is not null)
{
    <div class="cmdk-overlay" @onclick="SluitPrijs">
        <div class="prijsvenster" @onclick:stopPropagation>
            <header class="bijlagekop">
                <h2>Inkoopprijs — @_prijsRegel.Code</h2>
                <button class="klein" @onclick="SluitPrijs">✕</button>
