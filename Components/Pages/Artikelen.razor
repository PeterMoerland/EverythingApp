@code {
    private static readonly string[] Tabs = { "Info", "Documenten", "Groepen", "Alias", "Overigen" };
    private const int StoreTypeArtikel = 2;

    private string _zoek = "";
    private string _groep = "";
    private bool _gezocht;

    private List<ArtikelRegel> _lijst = new();
    private int? _artikelId;
    private Artikel? _artikel;
    private List<ArtikelGroep> _groepen = new();
    private List<(string Alias, string Bron)> _aliassen = new();
    private List<Bestand> _documenten = new();
    private List<Samenstellingregel> _stuklijst = new();
    private bool _alleenNieuwste = true;

    private string _tab = "Info";
    private string? _melding;
    private bool _fout;

    /// <summary>
    /// Met ?nr=12345 opent dit scherm meteen dat artikel. Zo kan er vanuit
    /// andere schermen (bestellingen, orderbatch) naartoe worden gelinkt.
    /// </summary>
    [SupplyParameterFromQuery(Name = "nr")]
    public int? Nummer { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Ik.ZorgGeladenAsync();

        if (Nummer is int nr && nr > 0)
        {
            _zoek = "#" + nr;
            await Laad();
        }
    }

    /// <summary>Na het eerste tekenen kijken of er een Dymo aan deze pc hangt.</summary>
    protected override async Task OnAfterRenderAsync(bool eerste)
    {
        if (!eerste) return;
        // Ctrl+V op dit scherm: afbeelding van het klembord als artikelfoto (mdeFoto in App.razor)
        _fotoRef = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("mdeFoto.koppel", _fotoRef); } catch { }
        await ZoekPrintersStil();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("mdeFoto.los"); } catch { }
        _fotoRef?.Dispose();
    }

    // ---- artikelfoto uit het klembord of een bestand ----
    private DotNetObjectReference<Artikelen>? _fotoRef;
    private int _fotoVersie;          // telt op na een nieuwe foto, zodat de browser hem opnieuw ophaalt
    private bool _fotoBezig;
    private string? _fotoMelding;
    private bool _fotoFout;

    private string FotoUploadUrl => _artikelId is int id ? $"api/artikelfoto/{id}" : "";

    /// <summary>Knop: het klembord uitlezen via de browser en de afbeelding opsturen.</summary>
    private async Task PlakFoto()
    {
        if (_artikelId is null || _fotoBezig) return;
        _fotoBezig = true; _fotoMelding = null;
        try
        {
            var uitkomst = await JS.InvokeAsync<string>("mdeFoto.plak", FotoUploadUrl);
            VerwerkFotoUitkomst(uitkomst);
        }
        catch (Exception ex) { _fotoMelding = "Plakken mislukt: " + ex.Message; _fotoFout = true; }
        finally { _fotoBezig = false; }
    }

    /// <summary>Ctrl+V (vanuit App.razor): de browser heeft de afbeelding al opgestuurd.</summary>
    [JSInvokable]
    public Task FotoGeplakt(string uitkomst)
    {
        VerwerkFotoUitkomst(uitkomst);
        return InvokeAsync(StateHasChanged);
    }

    private void VerwerkFotoUitkomst(string uitkomst)
    {
        _fotoFout = !uitkomst.StartsWith("OK");
        _fotoMelding = uitkomst.Length > 4 ? uitkomst[(uitkomst.IndexOf(' ') + 1)..] : uitkomst;
        if (!_fotoFout) _fotoVersie++;
    }

    /// <summary>Bestand gekozen: via de server rechtstreeks in de fotomap zetten.</summary>
    private async Task FotoBestandGekozen(InputFileChangeEventArgs e)
    {
        if (_artikelId is null) return;
        _fotoBezig = true; _fotoMelding = null;
        try
        {
            using var ms = new MemoryStream();
            await e.File.OpenReadStream(20 * 1024 * 1024).CopyToAsync(ms);
            _fotoMelding = await Fotos.BewaarAsync(_artikelId.Value, e.File.ContentType, ms.ToArray(), Ik.Email);
            _fotoFout = false; _fotoVersie++;
        }
        catch (Exception ex) { _fotoMelding = "Opslaan mislukt: " + ex.Message; _fotoFout = true; }
        finally { _fotoBezig = false; }
    }

    private async Task Laad()
    {
        _gezocht = _zoek.Trim().Length > 0 || _groep.Trim().Length > 0 || _groepIds.Count > 0;
        if (!_gezocht) { _lijst = new(); return; }

        try { _lijst = await Repo.ZoekAsync(_zoek, ZoekPad(), maakdelen: false, 200, _groepIds); }
        catch (Exception ex) { _lijst = new(); Toon("Zoeken mislukt: " + ex.Message, true); return; }

        if (_lijst.Count == 1) await Kies(_lijst[0]);
    }

    private async Task ZoekGewijzigd(ChangeEventArgs e)
    {
        _zoek = (string?)e.Value ?? "";
        await Laad();
    }

    private async Task GroepGewijzigd(ChangeEventArgs e)
    {
        // zelf getypt: dan geldt de tekst, niet meer de keuze uit de boom
        _groep = (string?)e.Value ?? "";
        _groepIds = new();
        await Laad();
    }

    private async Task WisZoek() { _zoek = ""; await Laad(); }
    private async Task WisGroep() { _groep = ""; _groepIds = new(); await Laad(); }

    /// <summary>
    /// Komt de groep uit de boom, dan zoeken we op de id's en niet op de tekst —
    /// het pad dat wij tonen hoeft niet letterlijk zo in de tabel te staan.
    /// </summary>
    private string? ZoekPad() => _groepIds.Count > 0 ? null : _groep;

    private async Task Kies(ArtikelRegel a)
    {
        if (_bewerken)
        {
            // hetzelfde artikel nog eens aanklikken mag het typewerk niet wissen
            if (a.Id == _artikelId) return;

            var door = await Vraag("Je wijzigingen zijn nog niet opgeslagen. "
                                 + "Toch een ander artikel openen?");
            if (!door) return;
        }

        _bewerken = false;
        _origineel = null;

        Artikel? gevonden;
        try { gevonden = await Repo.GetAsync(a.Id); }
        catch (Exception ex) { Leeg(); Toon("Ophalen mislukt: " + ex.Message, true); return; }

        if (gevonden is null) { Leeg(); Toon("Artikel niet gevonden.", true); return; }

        // pas nu omschakelen: anders wijst het scherm naar A terwijl het B toont
        _artikel = gevonden;
        _artikelId = a.Id;

        try { _groepen = await Repo.GetGroepenAsync(a.Id); } catch { _groepen = new(); }
        try { _aliassen = await Repo.GetAliassenAsync(a.Id); } catch { _aliassen = new(); }
        try { _stuklijst = await Repo.GetSamenstellingAsync(a.Id); } catch { _stuklijst = new(); }

        if (_tab == "Samenstelling" && _stuklijst.Count == 0) _tab = "Info";

        if (WnRepo.Beschikbaar)
        {
            try { _documenten = await WnRepo.GetBestandenAsync(StoreTypeArtikel, a.Id); }
            catch { _documenten = new(); }
        }
    }

    /// <summary>Alles leegmaken als er geen artikel (meer) is.</summary>
    private void Leeg()
    {
        _artikel = null;
        _artikelId = null;
        _groepen = new();
        _aliassen = new();
        _stuklijst = new();
        _documenten = new();
    }

    /// <summary>Een ja/nee-vraag aan de gebruiker; bij twijfel: niet doorgaan.</summary>
    private async Task<bool> Vraag(string tekst)
    {
        try { return await JS.InvokeAsync<bool>("mdeBevestig", tekst); }
        catch { return true; }   // lukt de vraag niet, dan de gebruiker niet blokkeren
    }

    // ---- hulpjes ----
    private static readonly System.Globalization.CultureInfo Nl = new("nl-NL");

    private static string Bedrag(decimal? waarde)
        => waarde is null ? "—" : waarde.Value.ToString("C2", Nl);

    private static string Getal(double? waarde) => waarde is null ? "0" : waarde.Value.ToString("0.##");

    /// <summary>Een bedrag zoals het in een invoervak hoort: zonder euroteken.</summary>
    private static string Invoerbedrag(decimal? waarde) => waarde?.ToString("0.00", Nl) ?? "";

    /// <summary>
    /// Een getal in een invoervak. Anders dan bij het tonen blijft leeg hier écht
    /// leeg; een "0" zou suggereren dat er iets staat.
    /// </summary>
    private static string Invoergetal(double? waarde) => waarde?.ToString("0.##", Nl) ?? "";

    private static string Tekst(ChangeEventArgs e) => ((string?)e.Value ?? "").Trim();
    private static bool Vink(ChangeEventArgs e) => e.Value is bool b && b;

    /// <summary>
    /// Een getal uit een invoervak. Nederlandse invoer met een komma hoort er
    /// gewoon in te kunnen; leeg betekent 'niet ingevuld', niet nul.
    /// </summary>
    private static double? Komma(ChangeEventArgs e)
    {
        var tekst = ((string?)e.Value ?? "").Trim();
        if (tekst.Length == 0) return null;
        return double.TryParse(tekst.Replace('.', ','), System.Globalization.NumberStyles.Any, Nl, out var v)
            ? v : null;
    }

    private static decimal? Bedragvan(ChangeEventArgs e)
    {
        var tekst = ((string?)e.Value ?? "").Trim().Replace("€", "").Trim();
        if (tekst.Length == 0) return null;
        return decimal.TryParse(tekst.Replace('.', ','), System.Globalization.NumberStyles.Any, Nl, out var v)
            ? v : null;
    }

    // ================================================================
    //  Artikel bewerken
    // ================================================================
    private bool MagBewerken => !Ik.Gekoppeld || Ik.Mag("Inkoop") || Ik.Mag("Beheer") || Ik.Mag("Directie");

    private bool _bewerken;
    private bool _bewaren;
    private Artikel? _origineel;
    private List<(int Id, string Naam)> _merken = new();

    private async Task StartBewerken()
    {
        if (_artikel is null || !MagBewerken) return;

        // een kopie bewaren, zodat 'Annuleren' echt terug kan
        _origineel = Kopie(_artikel);
        _bewerken = true;

        if (_merken.Count == 0)
        {
            try { _merken = await Repo.GetMerkenAsync(); } catch { _merken = new(); }
        }
    }

    private void StopBewerken()
    {
        if (_origineel is not null) _artikel = _origineel;
        _origineel = null;
        _bewerken = false;
    }

    private async Task BewaarArtikel()
    {
        if (_artikel is null) return;

        _bewaren = true;
        try
        {
            await Repo.BewaarArtikelAsync(_artikel, Ik.WerknemerId);
            _bewerken = false;
            _origineel = null;

            // opnieuw ophalen: de merknaam en de datum komen van de database
            _artikel = await Repo.GetAsync(_artikel.Id) ?? _artikel;
            await HerlaadLijst();
            Toon("Artikel opgeslagen.", false);
        }
        catch (Exception ex) { Toon("Opslaan mislukt: " + ex.Message, true); }
        finally { _bewaren = false; }
    }

    /// <summary>Merk gekozen in de MerkKiezer (bewerken): id en naam op het artikel zetten.</summary>
    private void MerkGekozen(int? merkId)
    {
        var artikel = _artikel;
        if (artikel is null) return;
        artikel.MerkId = merkId;
        var gevonden = _merken.FirstOrDefault(m => m.Id == merkId);
        artikel.Merk = gevonden.Id == 0 ? "" : gevonden.Naam;
    }

    /// <summary>Nieuw merk toegevoegd via de MerkKiezer: eigen lijst bijwerken (voor naam bij het artikel en het filter).</summary>
    private async Task MerkToegevoegd((int Id, string Naam) merk)
    {
        try { _merken = await Repo.GetMerkenAsync(); } catch { }
        if (_artikel is not null && _artikel.MerkId == merk.Id) _artikel.Merk = merk.Naam;
        Toon($"Merk '{merk.Naam}' toegevoegd aan de merkentabel.", false);
    }

    /// <summary>De ja/nee-velden als één rij, zodat de opsomming maar op één plek staat.</summary>
    private List<(string Label, Func<bool> Aan, Action<bool> Zet)> Vinkjes()
    {
        var a = _artikel!;
        return new List<(string, Func<bool>, Action<bool>)>
        {
            ("Voorraadartikel", () => a.Voorraadartikel, v => a.Voorraadartikel = v),
            ("Standaard",       () => a.Standaard,       v => a.Standaard = v),
            ("Product",         () => a.IsProduct,       v => a.IsProduct = v),
            ("Webshop",         () => a.Webshop,         v => a.Webshop = v),
            ("Uitleenbaar",     () => a.Uitleenbaar,     v => a.Uitleenbaar = v),
            ("Check nodig",     () => a.CheckNodig,      v => a.CheckNodig = v),
            ("Inventor-inkoopdeel", () => a.InventorInkoopdeel, v =>
                {
                    // Kenmerken() leest dezelfde kolom onder een andere naam;
                    // die moet dus mee, anders lopen de twee uit elkaar.
                    a.InventorInkoopdeel = v;
                    a.InventorPart = v;
                }),
        };
    }

    private static Artikel Kopie(Artikel a) => new()
    {
        Id = a.Id, Code = a.Code, CodeFabrikant = a.CodeFabrikant, Merk = a.Merk, MerkId = a.MerkId,
        OmschrijvingNl = a.OmschrijvingNl, OmschrijvingEn = a.OmschrijvingEn,
        OmschrijvingFr = a.OmschrijvingFr, Opmerking = a.Opmerking,
        Eenheid = a.Eenheid, Ean = a.Ean, OcCodeOmron = a.OcCodeOmron,
        Samenstelling = a.Samenstelling, Voorraadartikel = a.Voorraadartikel, Standaard = a.Standaard,
        InventorPart = a.InventorPart, IsProduct = a.IsProduct, Webshop = a.Webshop,
        Uitleenbaar = a.Uitleenbaar, CheckNodig = a.CheckNodig,
        Kostprijs = a.Kostprijs, VerkoopprijsProject = a.VerkoopprijsProject,
        VerkoopprijsWebshop = a.VerkoopprijsWebshop, Schattingsprijs = a.Schattingsprijs,
        MinimumVoorraad = a.MinimumVoorraad, Bestelhoeveelheid = a.Bestelhoeveelheid,
        AantalInVoorraad = a.AantalInVoorraad, Gewicht = a.Gewicht, AantalUitgeleend = a.AantalUitgeleend,
        Maakdeel = a.Maakdeel, Bewerking1 = a.Bewerking1, Bewerking2 = a.Bewerking2,
        Bewerking3 = a.Bewerking3, PlaatdikteMm = a.PlaatdikteMm, Materiaal = a.Materiaal,
        InventorReferentie = a.InventorReferentie, InventorBestand = a.InventorBestand,
        InventorInkoopdeel = a.InventorInkoopdeel,
        Toegevoegd = a.Toegevoegd, ToegevoegdDoor = a.ToegevoegdDoor,
        Gewijzigd = a.Gewijzigd, GewijzigdDoor = a.GewijzigdDoor,
    };

    /// <summary>De lijst links bijwerken zonder de keuze kwijt te raken.</summary>
    private async Task HerlaadLijst()
    {
        if (!_gezocht) return;
        try { _lijst = await Repo.ZoekAsync(_zoek, ZoekPad(), maakdelen: false, 200, _groepIds); } catch { }
    }

    // ================================================================
    //  Groepenboom
    //  '_groepKiezer' zegt waarvoor de popup openstaat: "filter" om de zoeklijst
    //  te beperken, "artikel" om dit artikel in een groep te zetten.
    // ================================================================
    private string? _groepKiezer;

    /// <summary>De gekozen groep plus alles eronder; leeg = niet op groep filteren.</summary>
    private List<int> _groepIds = new();

    private string GroepTitel => _groepKiezer == "filter"
        ? "Zoeken binnen een groep"
        : "In welke groep hoort dit artikel?";

    private void OpenGroepFilter() => _groepKiezer = "filter";
    private void OpenGroepToevoegen() => _groepKiezer = "artikel";
    private void OpenGroepNieuw() => _groepKiezer = "nieuw";
    private void SluitGroepKiezer() => _groepKiezer = null;

    // ---- nieuw artikel ----
    private bool _nieuwOpen, _nieuwBezig;
    private string _nieuwCode = "", _nieuwOms = "", _nieuwFab = "";
    private int? _nieuwMerk;
    private Groepknoop? _nieuwGroep;
    private string? _nieuwFout;

    private async Task OpenNieuw()
    {
        if (_merken.Count == 0) { try { _merken = await Repo.GetMerkenAsync(); } catch { } }
        _nieuwCode = ""; _nieuwOms = ""; _nieuwFab = ""; _nieuwMerk = null; _nieuwFout = null;
        // Zoek je binnen een groep, dan is dat waarschijnlijk ook de groep van het nieuwe artikel.
        _nieuwGroep = null;
        _nieuwOpen = true;
    }

    /// <summary>OK = aanmaken en openen; Toepassen = aanmaken en het formulier leeg laten staan.</summary>
    private async Task MaakNieuw(bool sluiten)
    {
        _nieuwBezig = true; _nieuwFout = null;
        try
        {
            var id = await Repo.NieuwArtikelAsync(_nieuwCode, _nieuwOms, _nieuwMerk, _nieuwFab, _nieuwGroep?.Id, Ik.WerknemerId);
            Toon($"Artikel #{id} '{_nieuwCode.Trim()}' aangemaakt.", false);
            if (sluiten)
            {
                _nieuwOpen = false;
                _zoek = _nieuwCode.Trim();
                await Laad();
                await Kies(new ArtikelRegel(id, _nieuwCode.Trim(), _nieuwOms, ""));
            }
            else
            {
                _nieuwCode = ""; _nieuwOms = ""; _nieuwFab = "";   // merk en groep blijven staan voor het volgende
            }
        }
        catch (Exception ex) { _nieuwFout = ex.Message; }
        finally { _nieuwBezig = false; }
    }

    private async Task GroepGekozen(Groepknoop? knoop)
    {
        var waarvoor = _groepKiezer;
        _groepKiezer = null;

        if (waarvoor == "nieuw")
        {
            if (knoop is not null) _nieuwGroep = knoop;
            return;
        }

        if (waarvoor == "filter")
        {
            _groep = knoop?.Pad ?? "";
            _groepIds = new();
            if (knoop is not null) VerzamelIds(knoop, _groepIds);
            await Laad();
            return;
        }

        if (knoop is null || _artikel is null) return;

        try
        {
            await Repo.ZetGroepAsync(_artikel.Id, knoop.Id, true);
            _groepen = await Repo.GetGroepenAsync(_artikel.Id);
            Toon($"Toegevoegd aan {knoop.Pad}.", false);
        }
        catch (Exception ex) { Toon("Koppelen mislukt: " + ex.Message, true); }
    }

    /// <summary>
    /// Kies je 'Elektro', dan horen de artikelen uit 'Elektro \ 24VDC' er ook bij.
    /// Daarom nemen we de hele tak mee.
    /// </summary>
    private static void VerzamelIds(Groepknoop knoop, List<int> ids)
    {
        if (knoop.Id > 0) ids.Add(knoop.Id);
        foreach (var kind in knoop.Kinderen) VerzamelIds(kind, ids);
    }

