    // ================================================================
    //  Labels printen op de Dymo
    //  Welke printer en welk label je gebruikt hoort bij de werkplek, niet bij
    //  de opdracht — dus dat onthoudt de browser per pc.
    // ================================================================
    private List<string> _printers = new();
    private string _printer = "";
    private string _labelsoort = "klein";
    private int _labelAantal = 1;
    private DymoLabel.Instellingen _dymo = new("", "Auto", "Auto");   // Beheer ▸ Labelprinter (deze pc)
    private bool _printBezig;
    private string _dymoMelding = "Nog niet gezocht.";

    private bool IsTwinTurbo => _printer.Contains("Twin Turbo", StringComparison.OrdinalIgnoreCase);

    private async Task ZoekPrintersStil()
    {
        try
        {
            var aan = await JS.InvokeAsync<bool>("mdeDymo.beschikbaar");
            if (!aan)
            {
                var waarom = await JS.InvokeAsync<string>("mdeDymo.uitleg");
                _dymoMelding = "DYMO Connect is niet gevonden op deze pc. "
                             + "Draait het wel, gebruik dan Chrome of Edge — Firefox vertrouwt "
                             + "het certificaat van DYMO niet. " + waarom;
                return;
            }

            _printers = (await JS.InvokeAsync<string[]>("mdeDymo.printers")).ToList();
            if (_printers.Count == 0)
            {
                _dymoMelding = await JS.InvokeAsync<string>("mdeDymo.uitleg");
                return;
            }

            // instellingen van deze pc (Beheer ▸ Labelprinter): printer en rol per label
            _dymo = await DymoLabel.LeesAsync(JS);
            _printer = _printers.Contains(_dymo.Printer) ? _dymo.Printer : _printers[0];

            var soort = await JS.InvokeAsync<string?>("mdeOpslag.lees", "dymoLabel");
            if (soort is "klein" or "groot") _labelsoort = soort;
        }
        catch (Exception ex) { _dymoMelding = "DYMO Connect niet bereikbaar: " + ex.Message; }
    }

    private async Task ZoekPrinters()
    {
        await ZoekPrintersStil();
        if (_printers.Count == 0) Toon(_dymoMelding, true);
    }

    private string? _dymoDiagnose;

    /// <summary>
    /// Laat zien wat de webservice van DYMO op elk adres antwoordt. Handig om te
    /// kunnen zien waar het misgaat zonder in de browserconsole te hoeven kijken.
    /// </summary>
    private async Task DymoDiagnose()
    {
        _dymoDiagnose = "Bezig…";
        try { _dymoDiagnose = await JS.InvokeAsync<string>("mdeDymo.diagnose"); }
