@page "/tools/jlc-componenten"
@inject IJlcComponentRepository Repo
@inject JlcOnderdelen JlcParts

@* De onderdelen van JLCPCB die wíj gebruiken: C-nummer, MPN, behuizing,
   fabrikant en of het een 'basic' onderdeel is (dat scheelt opstartkosten
   bij assemblage). Deze lijst groeit vanzelf — elke MPN die de check in de
   BOM-kijker opzoekt komt hier terecht — en je kunt er zelf koppelingen aan
   toevoegen. Hiermee vult de JLCPCB-export de kolom 'JLCPCB Part #'. *@

<PageTitle>JLCPCB-componenten — MDE</PageTitle>

<div class="page">
    <header class="topbar">
        <h1>JLCPCB-componenten</h1>
        <span class="weeklabel">@_aantal.ToString("N0") onderdelen bekend</span>
    </header>

    @if (!Repo.Beschikbaar)
    {
        <section class="module-placeholder"><p>Dit scherm werkt alleen met de live database.</p></section>
    }
    else
    {
        @if (_melding is not null)
        {
            <div class="melding @(_fout ? "fout" : "ok")" @onclick="() => _melding = null">@_melding</div>
        }

        @* Zelf een koppeling toevoegen: het C-nummer opzoeken op jlcpcb.com
           en hier samen met de MPN vastleggen. Bestaat het C-nummer al, dan
           wordt de regel bijgewerkt. *@
        <div class="bankfilters">
            <label class="bankveld">
                <span>MPN</span>
                <input value="@_nieuwMpn" placeholder="bv. CL05B222KB5NNNC"
                       @onchange="e => _nieuwMpn = ((string?)e.Value ?? string.Empty).Trim()" />
            </label>
            <label class="bankveld">
                <span>C-nummer</span>
                <input value="@_nieuwCode" placeholder="bv. C14663" style="width:9rem"
                       @onchange="e => _nieuwCode = ((string?)e.Value ?? string.Empty).Trim()" />
            </label>
            <label class="bankveld">
                <span>Behuizing</span>
                <input value="@_nieuweSpec" placeholder="bv. 0402" style="width:8rem"
                       @onchange="e => _nieuweSpec = ((string?)e.Value ?? string.Empty).Trim()" />
            </label>
            <button class="primair" disabled="@_bezig" @onclick="Koppel">+ Koppeling opslaan</button>
            @if (JlcParts.Beschikbaar)
            {
                <button class="klein" disabled="@_bezig" @onclick="HaalOp"
                        title="MPN en behuizing ophalen bij JLCPCB aan de hand van het C-nummer">
                    ⟳ Gegevens bij C-nummer ophalen
                </button>
            }
        </div>


        <div class="bankfilters">
            <label class="bankveld">
                <span>Zoeken</span>
                <input value="@_zoek" placeholder="MPN of C-nummer…" @onchange="ZoekGewijzigd" />
            </label>
        </div>

        <div class="regels-omhulsel">
            <table class="kiezer-tabel banktabel">
                <thead>
                    <tr>
                        <th style="width:8rem">C-nummer</th>
                        <th style="width:18rem">MPN</th>
                        <th style="width:7rem">Behuizing</th>
                        <th style="width:12rem">Fabrikant</th>
                        <th style="width:6rem">Soort</th>
                        <th style="width:7rem" class="r">Voorraad</th>
                        <th style="width:3rem"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in _lijst)
                    {
                        <tr @key="c.Code">
                            <td>
                                <button class="mpn-link" title="Voorraad en prijs opvragen bij JLCPCB"
                                        @onclick="() => ToonDetail(c.Code)">@c.Code</button>
                            </td>
                            <td class="nummer">@c.Model</td>
                            <td>@c.Specification</td>
                            <td class="omschrijving" title="@c.Categorie">@c.Fabrikant</td>
                            <td>
                                @if (c.Soort is not null)
                                {
                                    <span class="stand-chip @(c.IsBasic ? "s-groen" : "s-oranje")">
                                        @(c.IsBasic ? "basic" : "extended")
                                    </span>
                                }
                            </td>
                            <td class="r">@(c.Voorraad?.ToString("N0"))</td>
                            <td class="c">
                                <button class="klein rood" title="Uit de lijst verwijderen"
                                        @onclick="() => Verwijder(c)">✕</button>
                            </td>
                        </tr>
                    }
                    @if (_lijst.Count == 0)
                    {
                        <tr><td colspan="7" class="kiezer-info">
                            @(_aantal == 0 ? "Nog leeg — haal de onderdelenlijst op met de knop hierboven."
                                           : "Niets gevonden.")
                        </td></tr>
                    }
                    @if (_lijst.Count >= 500)
                    {
                        <tr><td colspan="7" class="kiezer-info">
                            De eerste 500 worden getoond; verfijn de zoekopdracht voor de rest.
                        </td></tr>
                    }
                </tbody>
            </table>
        </div>

        <footer class="voet">
            Deze lijst vertaalt een MPN naar het JLCPCB-nummer (Cxxxxx) en vult daarmee
            de kolom 'JLCPCB Part #' bij de export. 'Basic' onderdelen kosten bij
            assemblage geen extra opstartkosten, 'extended' wel. Klik op een C-nummer
            voor de actuele voorraad en prijs bij JLCPCB.
        </footer>
    }
</div>

@* Detailpopup: voorraad en prijsstaffels, live opgehaald bij JLCPCB. *@
@if (_detailCode is not null)
{
    <div class="cmdk-overlay midden laag2">
        <div class="fusion-kijker ec-venster verplaatsbaar">
            <div class="sleepkop fusion-kijker-kop">
                <b>@_detailCode</b>
                <span class="zij-extra">JLCPCB-onderdeel</span>
                <span style="flex:1"></span>
                <button class="klein" @onclick="() => _detailCode = null">✕ Sluiten</button>
            </div>
            <div class="fusion-kijker-inhoud">
                @if (_detailBezig)
                {
                    <p class="uitleg">Opvragen bij JLCPCB…</p>
                }
                else if (_detailFout is not null)
                {
                    <p class="uitleg">@_detailFout</p>
                }
                else if (_detail is not null)
                {
                    <table class="kiezer-tabel smal-tabel ec-detail">
                        <tbody>
                            <tr><td>MPN</td><td>@_detail.Mpn</td></tr>
                            <tr><td>Fabrikant</td><td>@_detail.Merk</td></tr>
                            <tr><td>Behuizing</td><td>@_detail.Specificatie</td></tr>
                            <tr><td>Categorie</td><td>@_detail.Categorie</td></tr>
                            <tr><td>Voorraad</td><td>@_detail.Voorraad</td></tr>
                            <tr><td>Bibliotheek</td><td>@_detail.Bibliotheek</td></tr>
                            @if (_detail.Prijzen.Count > 0)
                            {
                                <tr>
                                    <td>Prijs</td>
                                    <td>@string.Join(" · ", _detail.Prijzen.Select(p => $"vanaf {p.Vanaf}: {p.Stukprijs:0.####}"))</td>
                                </tr>
                            }
                            @if (_detail.Omschrijving.Length > 0)
                            {
                                <tr><td>Omschrijving</td><td class="ec-detail-oms">@_detail.Omschrijving</td></tr>
                            }
                            @if (_detail.Datasheet.Length > 0)
                            {
                                <tr><td>Datasheet</td>
                                    <td><a href="@_detail.Datasheet" target="_blank" rel="noopener">openen</a></td></tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
}

@code {
    private int _aantal;
    private string _zoek = "";
    private List<JlcComponent> _lijst = new();
    private bool _bezig;
    private string _nieuwMpn = "";
    private string _nieuwCode = "";
    private string _nieuweSpec = "";
    private string? _melding;
    private bool _fout;

    protected override async Task OnInitializedAsync()
    {
        if (Repo.Beschikbaar) await Laad();
    }

    private async Task Laad()
    {
        try
        {
            _aantal = await Repo.AantalAsync();
            _lijst = await Repo.ZoekAsync(_zoek, 500);
        }
        catch (Exception ex)
        {
            _lijst = new();
            Toon("Ophalen mislukt — bestaat de tabel al? Draai anders eerst " +
                 "JlcComponenten_MariaDB.sql. (" + ex.Message + ")", true);
        }
    }

    private async Task ZoekGewijzigd(ChangeEventArgs e)
    {
        _zoek = ((string?)e.Value ?? "").Trim();
        await Laad();
    }

    /// <summary>Een koppeling MPN → C-nummer vastleggen (of bijwerken).</summary>
    private async Task Koppel()
    {
        if (_bezig) return;
        if (_nieuwCode.Length == 0 || _nieuwMpn.Length == 0)
        {
            Toon("Vul zowel de MPN als het C-nummer in.", true);
            return;
        }

        _bezig = true;
        try
        {
            await Repo.BewaarBatchAsync(new[]
            {
                new JlcComponent(_nieuwCode, _nieuwMpn, _nieuweSpec.Length == 0 ? null : _nieuweSpec)
            });
            Toon($"{_nieuwMpn} → {_nieuwCode} opgeslagen.", false);
            _nieuwMpn = _nieuwCode = _nieuweSpec = "";
            await Laad();
        }
        catch (Exception ex) { Toon("Opslaan mislukt: " + ex.Message, true); }
        finally { _bezig = false; }
    }

    /// <summary>MPN en behuizing bij het ingevulde C-nummer ophalen bij JLCPCB,
    /// zodat je ze niet zelf hoeft over te typen.</summary>
    private async Task HaalOp()
    {
        if (_bezig) return;
        if (_nieuwCode.Length == 0) { Toon("Vul eerst een C-nummer in.", true); return; }

        _bezig = true;
        try
        {
            var (detail, fout) = await JlcParts.DetailAsync(_nieuwCode);
            if (detail is null) { Toon(fout ?? "Niets gevonden.", true); return; }
            _nieuwMpn = detail.Mpn;
            _nieuweSpec = detail.Specificatie;
            Toon($"Gevonden: {detail.Mpn} ({detail.Merk}) — controleer en sla op.", false);
        }
        catch (Exception ex) { Toon("Ophalen mislukt: " + ex.Message, true); }
        finally { _bezig = false; }
    }


    private async Task Verwijder(JlcComponent c)
    {
        try
        {
            await Repo.VerwijderAsync(c.Code);
            await Laad();
            Toon($"{c.Model} → {c.Code} verwijderd.", false);
        }
        catch (Exception ex) { Toon("Verwijderen mislukt: " + ex.Message, true); }
    }

    // ---- detailpopup ----

    private string? _detailCode;
    private bool _detailBezig;
    private string? _detailFout;
    private JlcDetail? _detail;
    private readonly Dictionary<string, JlcDetail> _detailCache = new(StringComparer.OrdinalIgnoreCase);

    private async Task ToonDetail(string code)
    {
        _detailCode = code;
        _detailFout = null;
        _detail = _detailCache.GetValueOrDefault(code);
        if (_detail is not null) return;

        _detailBezig = true;
        StateHasChanged();
        var (detail, fout) = await JlcParts.DetailAsync(code);
        if (_detailCode != code) return;
        _detail = detail;
        _detailFout = fout;
        if (detail is not null) _detailCache[code] = detail;
        _detailBezig = false;
    }

    private void Toon(string tekst, bool fout) { _melding = tekst; _fout = fout; }
}
