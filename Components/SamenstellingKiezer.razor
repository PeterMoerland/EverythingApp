@inject IProductRepository Repo
@inject IOpbouwRepository Opbouw
@inject HuidigeGebruiker Ik

@* Samenstelling van een exemplaar, gestuurd door de stuklijst van het producttype
   (Producten ▸ producttype ▸ tab Samenstelling): per halffabricaat hoeveel er in moeten,
   hoeveel er al gekoppeld zijn, en een kiezer die uitsluitend vrije exemplaren van
   precies dát halffabricaat aanbiedt (SN typen/scannen of klikken). Halffabricaten
   buiten de stuklijst staan onder 'Overig' en kunnen via de vrije zoekregel erbij.
   De koppeling zelf is Producten.ParentProductenID, zoals in Access.

   Invullen in de fase (voorstel Sjoerd deel 5, 12-11-2026): een regel van de stuklijst kan bij een hoofdfase van de
   opbouw horen (StuklijstRegel.FaseStapId). Die regel koppel je in die fase: OpbouwLijst toont de kiezer met
   AlleenFase (alleen de regels van die fase, zonder Overig en vrij zoeken). Overal elders staat zo'n regel op slot
   (🔒 met de fase erbij), tenzij Corrigeren aan staat (recht Productcorrectie; de historieregel begint dan met
   "Correctie:"). Een regel zonder fase werkt zoals voorheen. De kiezer zoekt de fases van het type zelf op, zodat het
   slot op elke plek geldt (tabblad Info, Productie ▸ Producten). *@

@if (AlleenFase is null && _stuklijst.Count == 0 && _onderdelen.Count == 0 && !_vrijZoeken)
{
    <p class="uitleg">
        Dit producttype heeft nog geen stuklijst (Producten ▸ producttype ▸ tab Samenstelling).
        <button class="klein" @onclick="() => _vrijZoeken = true">Toch een halffabricaat koppelen…</button>
    </p>
}

@if (Regels.Count > 0)
{
    <table class="kiezer-tabel sam-tabel">
        <tbody>
            @foreach (var s in Regels)
            {
                var gekoppeld = Gekoppeld(s).ToList();
                var klaar = gekoppeld.Count >= s.Aantal;
                var slot = OpSlot(s);
                <tr @key="s.Id" class="@RijKleur(gekoppeld.Count, s.Aantal)">
                    <td style="width:3rem" class="c">
                        <span class="stand-chip @ChipKleur(gekoppeld.Count, s.Aantal)" title="gekoppeld van verwacht">@gekoppeld.Count / @s.Aantal</span>
                    </td>
                    <td style="width:16rem">
                        <b>@s.OnderdeelNaam</b>
                        @if (s.OnderdeelGroep.Length > 0) { <small class="uitleg"> · @s.OnderdeelGroep</small> }
                        @if (s.OnderdeelOmschrijving.Length > 0) { <br /><small class="uitleg">@s.OnderdeelOmschrijving</small> }
                        @if (s.Opmerking.Length > 0) { <br /><small class="uitleg">@s.Opmerking</small> }
                        @if (AlleenFase is null && FaseVan(s) is { Length: > 0 } fase)
                        {
                            <br /><span class="opb-chip" title="@(slot ? "Dit halffabricaat koppel je in deze fase (tab Opbouw); hier is het alleen te lezen." : "Hoort bij deze fase van de opbouw")">@(slot ? "🔒 " : "")@fase</span>
                        }
                    </td>
                    <td>
                        @foreach (var o in gekoppeld)
                        {
                            <span class="sam-exemplaar @(o.Afgekeurd ? "sam-afgekeurd" : "")" @key="o.ProductId"
                                  title="@(o.Afgekeurd ? "Dit exemplaar is afgekeurd en hoort niet in dit product: haal het eruit." : null)">
                                <span class="nummer">@o.Serienummer</span>
                                @if (o.Afgekeurd) { <span class="stand-chip s-rood">afgekeurd</span> }
                                @if (!slot)
                                {
                                    <button class="knopje rood" title="Uit de samenstelling halen" disabled="@_bezig" @onclick="() => Ontkoppel(o)">✕</button>
                                }
                            </span>
                            @if (OpGaNaar.HasDelegate)
                            {
                                <button class="klein sam-ganaar" title="Naar dit exemplaar" @onclick="() => OpGaNaar.InvokeAsync(o)">↗ @o.Code @o.Serienummer</button>
                            }
                        }
                        @if (!klaar && slot)
                        {
                            <span class="uitleg">nog niet gekoppeld</span>
                        }
                        else if (!klaar)
                        {
                            <span class="sam-kies">
                                <input class="sam-sn" placeholder="SN typen/scannen ↵" value="@SnVoor(s.Id)" disabled="@_bezig"
                                       @oninput="e => _sn[s.Id] = (string?)e.Value ?? string.Empty"
                                       @onkeydown="e => SnToets(s, e)" />
                                <button class="klein" disabled="@_bezig" @onclick="() => ToonVrije(s)"
                                        title="Vrije exemplaren van dit halffabricaat">@(_open == s.Id ? "▴" : "▾") kiezen</button>
                            </span>
                        }
                    </td>
                </tr>
                @if (_open == s.Id && !klaar && !slot)
                {
                    <tr @key="@($"{s.Id}-vrij")" class="opb-docs">
                        <td></td>
                        <td colspan="2">
                            @if (_vrijeVoor.Count == 0)
                            {
                                <span class="uitleg">Geen vrije exemplaren van @s.OnderdeelNaam (alle exemplaren zitten al in een product, of er zijn er nog geen aangemaakt).</span>
                            }
                            else
                            {
                                <div class="wn-namen kort sam-vrij">
                                    @foreach (var v in _vrijeVoor)
                                    {
                                        <button class="wn-naam" @key="v.ProductId" disabled="@_bezig" @onclick="() => Koppel(v, s)">
                                            <span class="nummer">@v.Serienummer</span> @v.Code
                                        </button>
                                    }
                                </div>
                                @if (_vrijeVoor.Count >= 30) { <small class="uitleg">Alleen de 30 nieuwste; typ het serienummer voor een ander.</small> }
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    @if (AlleenFase is null)
    {
        <p class="uitleg sam-stand">
            @if (AllesCompleet) { <span class="stand-chip s-groen">✔ Samenstelling compleet</span> }
            else { <text>nog @Ontbrekend halffabrica(a)t(en) te koppelen</text> }
        </p>
    }
}

@{ var overig = AlleenFase is null ? Overig().ToList() : new List<SamenstellingRegel>(); }
@if (overig.Count > 0)
{
    <h4 class="prod-subkop">Overig (niet in de stuklijst)</h4>
    <table class="kiezer-tabel">
        <tbody>
            @foreach (var o in overig)
            {
                <tr @key="o.ProductId">
                    <td style="width:16rem">@o.Code</td>
                    <td style="width:7rem"><span class="nummer">@o.Serienummer</span></td>
                    <td>@o.Omschrijving</td>
                    <td class="c" style="width:@(OpGaNaar.HasDelegate ? "8rem" : "4rem")">
                        @if (OpGaNaar.HasDelegate) { <button class="klein" title="Naar dit exemplaar" @onclick="() => OpGaNaar.InvokeAsync(o)">↗</button> }
                        <button class="klein rood" disabled="@_bezig" @onclick="() => Ontkoppel(o)">✕</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (AlleenFase is null && !AllesOpSlot && (_vrijZoeken || _stuklijst.Count > 0))
{
    <div class="tl-balk">
        <input data-zoeklijst class="mail-zoek" placeholder="@ZoekTekst"
               value="@_vrijZoek" @onchange="VrijZoekGewijzigd" />
    </div>
    @if (_vrije.Count > 0)
    {
        <div class="wn-namen kort">
            @foreach (var v in _vrije)
            {
                <button class="wn-naam" @key="v.ProductId" disabled="@_bezig" @onclick="() => Koppel(v, null)">
                    <span class="nummer">@v.Serienummer</span>
                    <span class="stat">@v.Code</span>
                    @v.Omschrijving
                </button>
            }
        </div>
    }
}
@if (_fout is not null) { <p class="uitleg fout-tekst">@_fout</p> }

@code {
    [Parameter] public int ProductNameId { get; set; }
    [Parameter] public int ProductId { get; set; }
    /// <summary>Na elke koppeling/ontkoppeling, zodat de aanroeper historie/kaart kan verversen.</summary>
    [Parameter] public EventCallback OpGewijzigd { get; set; }
    /// <summary>Optioneel: knop ↗ achter elk gekoppeld exemplaar om ernaartoe te gaan.</summary>
    [Parameter] public EventCallback<SamenstellingRegel> OpGaNaar { get; set; }
    /// <summary>Alleen de regels van deze hoofdfase tonen (de kiezer in een fase van de opbouw), zonder Overig en vrij zoeken.</summary>
    [Parameter] public int? AlleenFase { get; set; }
    /// <summary>Corrigeren buiten de fase om (recht Productcorrectie): niets op slot; de historie begint met "Correctie:".</summary>
    [Parameter] public bool Corrigeren { get; set; }
    /// <summary>Alles alleen lezen (bv. de regels van een fase die niet actief is).</summary>
    [Parameter] public bool AlleenLezen { get; set; }

    private List<StuklijstRegel> _stuklijst = new();
    /// <summary>De hoofdfases van de opbouwboom van dit type (id → "2 · Mechanisch opbouwen"). Een regel met zo'n fase staat buiten die fase op slot.</summary>
    private Dictionary<int, string> _fases = new();
    private List<SamenstellingRegel> _onderdelen = new();
    private List<SamenstellingRegel> _vrijeVoor = new();
    private List<SamenstellingRegel> _vrije = new();
    private readonly Dictionary<int, string> _sn = new();
    private int? _open;
    private string _vrijZoek = "";
    private bool _vrijZoeken;
    private bool _bezig;
    private string? _fout;
    private int _geladenVoor = -1;

    /// <summary>De regels die deze kiezer toont: alles, of alleen die van één fase.</summary>
    private List<StuklijstRegel> Regels => AlleenFase is int f ? _stuklijst.Where(s => s.FaseStapId == f).ToList() : _stuklijst;
    /// <summary>De fase van een regel, als die (nog) bestaat in de boom.</summary>
    private string FaseVan(StuklijstRegel s) => s.FaseStapId is int f && _fases.TryGetValue(f, out var naam) ? naam : "";
    /// <summary>Mag deze regel hier niet gewijzigd worden? In zijn eigen fase en bij corrigeren wel.</summary>
    private bool OpSlot(StuklijstRegel s)
        => AlleenLezen || (!Corrigeren && s.FaseStapId is int f && f != AlleenFase && _fases.ContainsKey(f));
    /// <summary>Het hele scherm alleen lezen: dan ook geen vrije zoekregel.</summary>
    private bool AllesOpSlot => AlleenLezen;
    private string Voorvoegsel => Corrigeren ? "Correctie: " : "";

    private IEnumerable<SamenstellingRegel> Gekoppeld(StuklijstRegel s) => _onderdelen.Where(o => o.ProductNameId == s.OnderdeelNameId);
    private IEnumerable<SamenstellingRegel> Overig() => _onderdelen.Where(o => _stuklijst.All(s => s.OnderdeelNameId != o.ProductNameId));
    private int Ontbrekend => _stuklijst.Sum(s => Math.Max(0, s.Aantal - Gekoppeld(s).Count()));
    /// <summary>Alle regels van de stuklijst zijn gevuld (voor 'Product gereed' e.d.).</summary>
    public bool AllesCompleet => _stuklijst.Count > 0 && Ontbrekend == 0;
    private string SnVoor(int id) => _sn.TryGetValue(id, out var v) ? v : "";
    private static string ChipKleur(int n, int verwacht) => n > verwacht ? "s-rood" : n >= verwacht ? "s-groen" : "s-geel";
    private static string RijKleur(int n, int verwacht) => n > verwacht ? "hist-fout" : n >= verwacht ? "hist-ok" : "";
    private string ZoekTekst => _stuklijst.Count > 0
        ? "Iets anders toevoegen: zoek een vrij exemplaar (SN of type)…"
        : "Zoek een vrij exemplaar om toe te voegen…";

    protected override async Task OnParametersSetAsync()
    {
        if (_geladenVoor == ProductId) return;
        _geladenVoor = ProductId;
        await Laad();
    }

    public async Task Laad()
    {
        _fout = null; _open = null; _vrijeVoor = new(); _vrije = new(); _vrijZoek = "";
        try
        {
            _stuklijst = await Repo.GetStuklijstAsync(ProductNameId);
            _onderdelen = await Repo.GetOnderdelenAsync(ProductId);
        }
        catch (Exception ex) { _fout = "Samenstelling laden mislukt: " + ex.Message; }
        // hoort er een regel bij een fase van de opbouw, dan de fases van dit type erbij (alleen een type met fases telt)
        _fases = new();
        try
        {
            if (_stuklijst.Any(s => s.FaseStapId is not null) && Opbouw.Beschikbaar)
            {
                var boom = new OpbouwBoom(await Opbouw.GetStappenAsync(ProductNameId));
                _fases = boom.Hoofdfases.ToDictionary(f => f.Id, f => $"{boom.FaseNummer(f)} · {f.Naam}");
            }
        }
        catch { /* zonder de boom is er geen slot: de kiezer werkt zoals voorheen */ }
        StateHasChanged();
    }

    private async Task ToonVrije(StuklijstRegel s)
    {
        if (_open == s.Id) { _open = null; return; }
        _open = s.Id;
        try { _vrijeVoor = await Repo.ZoekVrijeExemplarenAsync("", 30, s.OnderdeelNameId); }
        catch (Exception ex) { _fout = ex.Message; _vrijeVoor = new(); }
    }

    /// <summary>Serienummer getypt/gescand bij een regel: het vrije exemplaar van dát halffabricaat koppelen.</summary>
    private async Task SnToets(StuklijstRegel s, KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        var sn = SnVoor(s.Id).Trim();
        if (sn.Length == 0) return;
        try
        {
            var kandidaten = await Repo.ZoekVrijeExemplarenAsync(sn, 50, s.OnderdeelNameId);
            var tref = kandidaten.FirstOrDefault(k => SerieGelijk(k.Serienummer, sn))
                       ?? (kandidaten.Count == 1 ? kandidaten[0] : null);
            if (tref is null && kandidaten.Count == 0)
            {
                // niet vrij: misschien afgekeurd (die biedt de kiezer niet aan); dat dan ook zeggen
                var ook = await Repo.ZoekVrijeExemplarenAsync(sn, 50, s.OnderdeelNameId, ookAfgekeurd: true);
                if (ook.FirstOrDefault(k => SerieGelijk(k.Serienummer, sn)) is { Afgekeurd: true } af)
                {
                    _fout = $"{af.Code} {af.Serienummer} is afgekeurd en kan niet worden ingebouwd.";
                    return;
                }
            }
            if (tref is null)
            {
                _fout = kandidaten.Count > 1
                    ? $"'{sn}' past op meerdere vrije exemplaren van {s.OnderdeelNaam}; typ het volledige nummer."
                    : $"Geen vrij exemplaar van {s.OnderdeelNaam} met serienummer '{sn}' (bestaat het, en zit het niet al in een ander product?).";
                return;
            }
            await Koppel(tref, s);
            _sn[s.Id] = "";
        }
        catch (Exception ex) { _fout = ex.Message; }
    }

    private static bool SerieGelijk(string a, string b)
    {
        static string Kaal(string s) => s.Trim().TrimStart('0');
        return string.Equals(a.Trim(), b.Trim(), StringComparison.OrdinalIgnoreCase) || Kaal(a) == Kaal(b);
    }

    private async Task Koppel(SamenstellingRegel v, StuklijstRegel? s)
    {
        if (v.ProductId == ProductId) { _fout = "Een product kan niet zichzelf bevatten."; return; }
        if (v.Afgekeurd) { _fout = $"{v.Code} {v.Serienummer} is afgekeurd en kan niet worden ingebouwd."; return; }
        // het slot geldt ook hier, niet alleen via de knoppen (vrij zoeken kan een halffabricaat van een regel op slot vinden)
        if (_stuklijst.FirstOrDefault(x => x.OnderdeelNameId == v.ProductNameId) is { } eigen && OpSlot(eigen))
        {
            _fout = $"{eigen.OnderdeelNaam} koppel je in {(FaseVan(eigen) is { Length: > 0 } fn ? "fase " + fn : "zijn fase")} (tab Opbouw).";
            return;
        }
        // Buiten de stuklijst, of al vol? Dan wel koppelen maar het zeggen — de stuklijst is een hulpmiddel, geen slot.
        var regel = s ?? _stuklijst.FirstOrDefault(x => x.OnderdeelNameId == v.ProductNameId);
        var melding = regel is null && _stuklijst.Count > 0 ? $" (let op: {v.Code} staat niet in de stuklijst)"
                    : regel is not null && Gekoppeld(regel).Count() >= regel.Aantal ? $" (let op: meer dan de {regel.Aantal} verwachte {regel.OnderdeelNaam})"
                    : "";
        _bezig = true; _fout = null;
        try
        {
            await Repo.KoppelAsync(v.ProductId, ProductId);
            await Repo.VoegHistorieToeAsync(ProductId, $"{Voorvoegsel}Samenstelling: {v.Code} {v.Serienummer} toegevoegd{melding}",
                ProductVelden.HistorieLevensloop, Ik.WerknemerId, uitkomst: melding.Length == 0 ? true : null);
            await Repo.VoegHistorieToeAsync(v.ProductId, $"Ingebouwd in product #{ProductId}", ProductVelden.HistorieLevensloop, Ik.WerknemerId);
            var open = _open;
            await Laad();
            if (open is int id && _stuklijst.FirstOrDefault(x => x.Id == id) is { } nog && Gekoppeld(nog).Count() < nog.Aantal)
            {
                _open = id;
                _vrijeVoor = await Repo.ZoekVrijeExemplarenAsync("", 30, nog.OnderdeelNameId);
            }
            if (melding.Length > 0) _fout = melding.Trim(' ', '(', ')');
            await OpGewijzigd.InvokeAsync();
        }
        catch (Exception ex) { _fout = "Koppelen mislukt: " + ex.Message; }
        finally { _bezig = false; }
    }

    private async Task Ontkoppel(SamenstellingRegel o)
    {
        if (_stuklijst.FirstOrDefault(x => x.OnderdeelNameId == o.ProductNameId) is { } eigen && OpSlot(eigen)) return;
        _bezig = true; _fout = null;
        try
        {
            await Repo.KoppelAsync(o.ProductId, null);
            await Repo.VoegHistorieToeAsync(ProductId, $"{Voorvoegsel}Samenstelling: {o.Code} {o.Serienummer} verwijderd",
                ProductVelden.HistorieLevensloop, Ik.WerknemerId);
            await Repo.VoegHistorieToeAsync(o.ProductId, $"Uit product #{ProductId} gehaald", ProductVelden.HistorieLevensloop, Ik.WerknemerId);
            await Laad();
            await OpGewijzigd.InvokeAsync();
        }
        catch (Exception ex) { _fout = "Ontkoppelen mislukt: " + ex.Message; }
        finally { _bezig = false; }
    }

    private async Task VrijZoekGewijzigd(ChangeEventArgs e)
    {
        _vrijZoek = ((string?)e.Value ?? "").Trim();
        _vrije = new();
        if (_vrijZoek.Length < 2) return;
        try { _vrije = await Repo.ZoekVrijeExemplarenAsync(_vrijZoek, 25); }
        catch (Exception ex) { _fout = ex.Message; }
    }
}
