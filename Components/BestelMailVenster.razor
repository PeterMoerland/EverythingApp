@* Mail aan de leverancier: offerteaanvraag (Aanmaken, PI-) of bestelling (In bestelling, PO-). Vervangt Mail_Click met
   Create_order_request_Mail / Create_order_Mail uit Access (dat stelde een Outlook-mail samen). Links Aan/CC/onderwerp/
   aanhef en de bijlagen, rechts het voorbeeld; Versturen gaat via je eigen Gmail (op een werkplek via de alias).
   Opbouw van de mail: Services/BestelMail.cs. Na versturen: Orders.MailAangemaakt en een regel in Log_Orderchanges.
   OrderId: een getal = open, null = dicht. *@
@inject IBestelRepository Repo
@inject FilestoreService Store
@inject MailService Post
@inject MailPostbussen Postbussen
@inject HuidigeGebruiker Ik
@inject IConfiguration Config
@inject IWebHostEnvironment Omgeving
@inject IJSRuntime JS

@if (OrderId is not null)
{
    <div class="cmdk-overlay midden">
        <div class="factuurvenster bm-venster" @onclick:stopPropagation>
            <header class="bijlagekop">
                <h2>@Titel</h2>
                <button class="klein" disabled="@_bezig" @onclick="() => Sluit(false)">✕</button>
            </header>
            <div class="factuurvenster-inhoud">
                @if (_melding is not null)
                {
                    <div class="bm-melding @(_fout ? "fout" : "ok")">@_melding</div>
                }
                @if (_g is null)
                {
                    <p class="uitleg">@(_laden ? "Gegevens ophalen…" : "")</p>
                }
                else if (_verstuurd)
                {
                    <div class="bm-klaar">
                        <p>✔ Verstuurd aan <b>@_aan</b>@(_cc.Length > 0 ? $" (cc {_cc})" : "").</p>
                        <button class="primair" @onclick="() => Sluit(true)">Sluiten</button>
                    </div>
                }
                else
                {
                    @foreach (var (tekst, blok) in _controles)
                    {
                        <div class="bm-melding @(blok ? "fout" : "let-op")">@(blok ? "⛔" : "⚠") @tekst</div>
                    }
                    <div class="bm-tweeluik">
                        <div class="bm-links">
                            <div class="wn-velden een-kolom">
                                <div class="wn-veld"><label>Van</label><span class="wn-vast">@Van</span></div>
                                <div class="wn-veld"><label>Aan</label><input value="@_aan" @onchange="e => _aan = Tekst(e)" placeholder="mailadres contactpersoon" /></div>
                                <div class="wn-veld"><label>CC</label><input value="@_cc" @onchange="e => _cc = Tekst(e)" /></div>
                                @if (_g.Cc && !BestelMail.IsAanvraag(_g))
                                {
                                    <div class="wn-veld"><label></label>
                                        <label class="vink"><input type="checkbox" checked="@CcLeverancier" @onchange="CcLeverancierGewijzigd" />
                                            @_g.CcAdres in CC (Relaties: CC bij bestelling)</label></div>
                                }
                                <div class="wn-veld"><label>Onderwerp</label><input value="@_onderwerp" @onchange="e => _onderwerp = Tekst(e)" /></div>
                                <div class="wn-veld"><label>Aanhef</label><input value="@_aanhef" @oninput="AanhefGewijzigd" /></div>
                                <div class="wn-veld"><label title="Orders.Purchasenote: het gele blok onder de tabel">Melding</label>
                                    <textarea rows="4" placeholder="Melding op orderformulier (het gele blok onder de tabel; mag leeg)" value="@_melding2"
                                              @oninput="e => _melding2 = (string?)e.Value ?? string.Empty"></textarea></div>
                                @if (_g.Aanhef.Length == 0 && _g.ContactId is not null)
                                {
                                    <div class="wn-veld"><label></label>
                                        <label class="vink"><input type="checkbox" checked="@_aanhefOpslaan" @onchange="e => _aanhefOpslaan = e.Value is true" />
                                            Aanhef opslaan bij @_g.ContactNaam</label></div>
                                }
                            </div>

                            <h4 class="bm-kop">Bijlagen <small>(@Mb(GekozenGrootte))</small></h4>
                            @if (_g.Bijlagen.Count == 0)
                            {
                                <p class="uitleg">Geen bijlagen bij de regels.</p>
                            }
                            else
                            {
                                <div class="bm-bijlagen">
                                    @foreach (var b in _g.Bijlagen)
                                    {
                                        var bl = b;
                                        <label class="vink @(bl.Verouderd ? "bm-oud" : "")" title="@(bl.Verouderd ? "Er is een nieuwere versie bij het artikel" : bl.Regel)">
                                            <input type="checkbox" checked="@_gekozen.Contains(bl.FileStoreId)" @onchange="e => Kies(bl.FileStoreId, e.Value is true)" />
                                            📄 @bl.Naam <small>@bl.Regel · @Mb(bl.Grootte)@(bl.Verouderd ? " · oud" : "")</small>
                                        </label>
                                    }
                                </div>
                                <label class="vink"><input type="checkbox" checked="@_zip" @onchange="e => _zip = e.Value is true" />
                                    Als één ZIP-bestand (@ZipNaam)</label>
                            }
                            <div class="btngroep-rand">
                                <span style="flex:1"></span>
                                <button class="klein" disabled="@_bezig" @onclick="() => Sluit(false)">Annuleren</button>
                                <button class="primair" disabled="@(_bezig || Blokkeert)" @onclick="Versturen">@(_bezig ? "Versturen…" : "✉ Versturen")</button>
                            </div>
                        </div>
                        <div class="bm-voorbeeld">
                            <div class="bm-voorbeeld-kop"><b>@_onderwerp</b><small>Zo ziet de leverancier de mail</small></div>
                            <iframe srcdoc="@Voorbeeld" title="Voorbeeld van de mail"></iframe>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int? OrderId { get; set; }
    /// <summary>Gesloten; true = de mail is verstuurd.</summary>
    [Parameter] public EventCallback<bool> OpGesloten { get; set; }

    private const long MaxBytes = 24L * 1024 * 1024;     // Gmail: 25 MB per bericht, met wat marge voor de codering
    private const long ZipVanaf = 20_000_000;            // zoals Access: boven 20 MB voorstellen te zippen

    private int? _geladenVoor;
    private bool _laden, _bezig, _fout, _verstuurd, _aanhefOpslaan = true, _zip;
    private string? _melding;
    private BestelMailGegevens? _g;
    private List<(string Tekst, bool Blokkerend)> _controles = new();
    private string _aan = "", _cc = "", _onderwerp = "", _aanhef = "";
    /// <summary>Melding op orderformulier (Orders.Purchasenote), hier aan te passen; bij versturen ook opgeslagen.</summary>
    private string _melding2 = "";
    private BestelMailGegevens? MetMelding => _g is null ? null : _g with { Opmerking = _melding2 };
    private HashSet<int> _gekozen = new();

    private string Titel => _g is null ? "Mail aan de leverancier"
        : BestelMail.IsAanvraag(_g) ? $"Offerte aanvragen · PI-{_g.OrderId} · {_g.Leverancier}" : $"Bestelling versturen · PO-{_g.OrderId} · {_g.Leverancier}";
    private bool Blokkeert => _controles.Any(c => c.Blokkerend) || _aan.Trim().Length == 0;
    private string Voorbeeld => _g is null ? "" : "<html><body style=\"margin:14px;background:#fff;\">" + BestelMail.Html(MetMelding!, _aanhef, "logo-mde.png") + "</body></html>";
    private long GekozenGrootte => _g?.Bijlagen.Where(b => _gekozen.Contains(b.FileStoreId)).Sum(b => b.Grootte) ?? 0;
    private string ZipNaam => _g is null ? "" : $"{(BestelMail.IsAanvraag(_g) ? "PI" : "PO")}-{_g.OrderId}.zip";
    private bool CcLeverancier => _g is not null && _cc.Contains(_g.CcAdres, StringComparison.OrdinalIgnoreCase);

    private MailPostbus? Postbus => Ik.IsWerkplek ? Postbussen.Werkplek(Ik) : Ik.Email.Length > 0 ? MailService.Eigen(Ik.Email) : null;
    private string Van => Postbus is { } p ? (p.Afzender ?? p.Adres) : Ik.IsWerkplek ? (Postbussen.WerkplekReden(Ik) ?? "—") : "niet ingelogd";

    protected override async Task OnParametersSetAsync()
    {
        if (OrderId == _geladenVoor) return;
        _geladenVoor = OrderId;
        _g = null; _melding = null; _verstuurd = false; _bezig = false;
        if (OrderId is not int id) return;
        _laden = true;
        try
        {
            await Ik.ZorgGeladenAsync();
            var eigen = Config.GetValue<int?>("Bestellingen:EigenRelatieId") ?? 5254;     // MDE Automation B.V. in Relations
            _g = await Repo.BestelMailAsync(id, Ik.WerknemerId, eigen);
            if (_g is null) { Toon("Bestelling niet gevonden.", true); return; }
            _controles = BestelMail.Controles(_g);
            _aan = _g.ContactMail;
            if (_g.ContactId is not null && _aan.Length == 0)
                _controles.Add(($"{_g.ContactNaam} heeft geen mailadres; vul het in bij Relaties of typ het hierboven.", false));
            _cc = BestelMail.StandaardCc;
            _onderwerp = BestelMail.Onderwerp(_g);
            _aanhef = BestelMail.StandaardAanhef(_g);
            _aanhefOpslaan = true;
            _melding2 = _g.Opmerking;
            _gekozen = _g.Bijlagen.Select(b => b.FileStoreId).ToHashSet();
            // FileStore.FileSize is vaak leeg: de echte grootte van schijf (voor het totaal en de ZIP-keuze)
            var metGrootte = new List<BestelMailBijlage>();
            foreach (var b in _g.Bijlagen)
            {
                long grootte = b.Grootte;
                try { if (await Store.ZoekAsync(b.FileStoreId) is { } f && File.Exists(f.Pad)) grootte = new FileInfo(f.Pad).Length; } catch { }
                metGrootte.Add(b with { Grootte = grootte });
            }
            _g = _g with { Bijlagen = metGrootte };
            _zip = GekozenGrootte > ZipVanaf;
            if (Postbus is null) Toon("Versturen kan niet: " + Van, true);
        }
        catch (Exception ex) { Toon("Ophalen mislukt: " + ex.Message, true); }
        finally { _laden = false; }
    }

    private void Kies(int id, bool aan)
    {
        if (aan) _gekozen.Add(id); else _gekozen.Remove(id);
        if (GekozenGrootte > ZipVanaf) _zip = true;
    }

    private void AanhefGewijzigd(ChangeEventArgs e) => _aanhef = ((string?)e.Value ?? "").TrimEnd(',', ' ');

    private void CcLeverancierGewijzigd(ChangeEventArgs e)
    {
        if (_g is null) return;
        var delen = _cc.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        delen.RemoveAll(d => d.Equals(_g.CcAdres, StringComparison.OrdinalIgnoreCase));
        if (e.Value is true) delen.Add(_g.CcAdres);
        _cc = string.Join(", ", delen);
    }

    private async Task Versturen()
    {
        if (_g is null || _bezig || Blokkeert) return;
        if (Postbus is not { } postbus) { Toon("Versturen kan niet: " + Van, true); return; }
        _bezig = true;
        _melding = null;
        try
        {
            // bijlagen uit de filestore; dubbele namen krijgen een volgnummer
            var bijlagen = new List<(string Naam, byte[] Inhoud)>();
            var namen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var b in _g.Bijlagen.Where(b => _gekozen.Contains(b.FileStoreId)))
            {
                var gevonden = await Store.ZoekAsync(b.FileStoreId);
                if (gevonden is null) { Toon($"'{b.Naam}' staat niet in de filestore.", true); return; }
                var naam = b.Naam.Length > 0 ? b.Naam : gevonden.Value.Naam;
                for (var n = 2; !namen.Add(naam); n++)
                    naam = $"{Path.GetFileNameWithoutExtension(b.Naam)} ({n}){Path.GetExtension(b.Naam)}";
                bijlagen.Add((naam, await File.ReadAllBytesAsync(gevonden.Value.Pad)));
            }
            if (_zip && bijlagen.Count > 0)
            {
                using var ms = new MemoryStream();
                using (var zip = new System.IO.Compression.ZipArchive(ms, System.IO.Compression.ZipArchiveMode.Create, true))
                    foreach (var (naam, inhoud) in bijlagen)
                    {
                        var e = zip.CreateEntry(naam, System.IO.Compression.CompressionLevel.Optimal);
                        await using var s = e.Open();
                        await s.WriteAsync(inhoud);
                    }
                bijlagen = new() { (ZipNaam, ms.ToArray()) };
            }
            var totaal = bijlagen.Sum(b => (long)b.Inhoud.Length);
            if (totaal > MaxBytes)
            {
                Toon($"De bijlagen zijn samen {Mb(totaal)}; Gmail neemt maximaal 25 MB. Laat er een paar weg{(_zip ? "" : " of verstuur ze als ZIP")}.", true);
                return;
            }

            var logo = await File.ReadAllBytesAsync(Path.Combine(Omgeving.WebRootPath, "logo-mde.png"));
            var html = "<html><body>" + BestelMail.Html(MetMelding!, _aanhef, "cid:" + BestelMail.LogoCid) + "</body></html>";
            await Post.VerstuurAsync(postbus, _aan, _onderwerp, html, bijlagen, _cc.Length > 0 ? _cc : null, html: true,
                                     ingebed: new[] { (BestelMail.LogoCid, "logo-mde.png", logo) });

            // na het versturen: aangepaste melding en aanhef bewaren (aanhef zoals Access vroeg), en vastleggen dat er gemaild is
            if (_melding2.Trim() != _g.Opmerking.Trim())
            {
                try { await Repo.UpdateVeldAsync(_g.OrderId, "Purchasenote", _melding2.Trim().Length > 0 ? _melding2.Trim() : null); } catch { }
            }
            if (_aanhefOpslaan && _g.Aanhef.Length == 0 && _g.ContactId is int cid && _aanhef.Trim().Length > 0)
            {
                try { await Repo.ZetAanhefAsync(cid, _aanhef.Trim()); } catch { }
            }
            try
            {
                await Repo.MailVerstuurdAsync(_g.OrderId, Ik.WerknemerId,
                    $"{(BestelMail.IsAanvraag(_g) ? "Offerteaanvraag" : "Bestelling")} gemaild aan {_aan}{(_cc.Length > 0 ? " (cc " + _cc + ")" : "")}, {bijlagen.Count} bijlage(n)");
            }
            catch { }
            _verstuurd = true;
        }
        catch (Exception ex) { Toon("Versturen mislukt: " + ex.Message, true); }
        finally { _bezig = false; }
    }

    private async Task Sluit(bool verstuurd)
    {
        _geladenVoor = null;
        _g = null;
        await OpGesloten.InvokeAsync(verstuurd);
    }

    private static string Mb(long bytes) => bytes < 1024 * 1024 ? $"{Math.Max(1, bytes / 1024)} kB" : $"{bytes / 1024d / 1024:0.0} MB";
    private void Toon(string tekst, bool fout) { _melding = tekst; _fout = fout; }
    private static string Tekst(ChangeEventArgs e) => ((string?)e.Value ?? "").Trim();
}
