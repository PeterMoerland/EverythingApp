@implements IDisposable
@inject FilestoreService Store
@inject HuidigeGebruiker Ik
@inject IBestelRepository Bestel
@inject IMeldingRepository Meldingen
@inject IUrenRepository Uren
@inject MeldingSignaal Signaal
@inject IJSRuntime JS

@* Bel in de bovenbalk = de berichtenbox, altijd te openen (wens gebruiker 22-10-2026). Het getal = goed te keuren plus
   ongelezen berichten.
   - Goed te keuren: bestellingen in Goedkeuring PM waarvan jij projectverantwoordelijke bent, en als Directie ook
     Goedkeuring Directie (IBestelRepository.TeKeurenAsync; volgt uit de status, geen eigen tabel).
   - Berichten (IMeldingRepository): meldingen van de app (goedgekeurd, geleverd, verbeterverzoek …) en berichten van
     collega's. Gelezen blijft bewaard tot jij het wist; terugzetten op ongelezen kan. Zelf een bericht sturen of
     beantwoorden (Soort 'bericht', VanWerknemerID; Meldingen_Berichten_MariaDB.sql).
   Een order opent in een nieuw tabblad (bestellingen?order=…), daar druk je op Volgende. Ververst elke minuut en meteen
   na een seintje (MeldingSignaal) als iemand op deze server een bestelling doorzet of een bericht stuurt.
   Geluidje bij een nieuw bericht (wens gebruiker 22-10-2026): aan/uit met 🔊/🔇 in de kop, per werknemer onthouden in de
   browser (mdeOpslag, sleutel mde-geluid-<id>; standaard aan). Afspelen: mdeBerichtGeluid in App.razor.
   Plaatjes bij een bericht (wens gebruiker 22-10-2026): plakken (Ctrl+V in het schrijfvak) of kiezen, hoogstens 3; na
   versturen in de filestore (StoreType 341, MasterID = het bericht). Alleen ontvanger en afzender kunnen ze openen. *@

@if (Ik.WerknemerId is not null)
{
    <button type="button" class="bel-knop @(Aantal > 0 ? "met-aantal" : "leeg")" @onclick="Wissel"
            title="@($"Berichten — {_teKeuren.Count} goed te keuren, {Ongelezen} ongelezen")">
        <span class="bel-icoon">🔔</span>
        @if (Aantal > 0) { <span class="bel-teken">!</span><span class="bel-aantal">@Aantal</span> }
    </button>
}

@if (_open)
{
    <div class="cmdk-overlay midden" @onclick="() => _open = false">
        <div class="kiezer bel-venster" @onclick:stopPropagation role="dialog" aria-label="Berichten">
            <div class="kiezer-kop">
                <b>🔔 Berichten</b>
                <span style="flex:1"></span>
                <button class="klein" title="@(_geluid ? "Geluid bij een nieuw bericht staat aan; klik om uit te zetten" : "Geluid bij een nieuw bericht staat uit; klik om aan te zetten")"
                        @onclick="WisselGeluid">@(_geluid ? "🔊 Geluid aan" : "🔇 Geluid uit")</button>
                @if (_berichtenMogelijk && !_schrijven)
                {
                    <button class="klein" @onclick="() => NieuwBericht(null)">✉ Nieuw bericht</button>
                }
                <button class="klein" title="Sluiten" @onclick="() => _open = false">✕</button>
            </div>
            <div class="bel-inhoud">
                @if (_schrijven)
                {
                    <div class="bel-schrijf" @ref="_schrijfVak">
                        <h4>@(_antwoordOp is not null ? "Antwoord" : "Nieuw bericht")</h4>
                        <label class="bankveld"><span>Aan</span>
                            <select value="@(_aan?.ToString() ?? "")" @onchange="e => _aan = int.TryParse((string?)e.Value, out var id) ? id : null">
                                <option value="">— kies een collega —</option>
                                @foreach (var w in _collegas)
                                {
                                    <option value="@w.WerknemerId">@w.Naam</option>
                                }
                            </select></label>
                        <textarea rows="5" maxlength="1000" placeholder="Je bericht…" value="@_tekst"
                                  @oninput="e => _tekst = (string?)e.Value ?? string.Empty"></textarea>
                        @if (Store.Beschikbaar)
                        {
                            <div class="idee-shots">
                                @foreach (var (shot, i) in _plaatjes.Select((s, i) => (s, i)))
                                {
                                    var nr = i;
                                    <span class="idee-shot">
                                        <img src="@shot.Voorbeeld" alt="plaatje @(nr + 1)" />
                                        <button class="klein rood" title="Weghalen" @onclick="() => _plaatjes.RemoveAt(nr)">✕</button>
                                    </span>
                                }
                                @if (_plaatjes.Count < BerichtBijlage.Max)
                                {
                                    <span class="idee-plakvak">
                                        🖼 Plaatje: <b>Ctrl+V</b> hier (schermafdruk: Win+Shift+S)
                                        <label class="klein knop-label">of kies een bestand…
                                            <InputFile OnChange="PlaatjeGekozen" accept="image/*" multiple /></label>
                                    </span>
                                }
                            </div>
                        }
                        @if (_schrijfFout is not null) { <div class="melding fout">@_schrijfFout</div> }
                        <div class="btngroup">
                            <span style="flex:1"></span>
                            <button class="klein" @onclick="() => _schrijven = false">Annuleren</button>
                            <button class="primair" disabled="@(_bezig || _aan is null || _tekst.Trim().Length == 0)" @onclick="Verstuur">Versturen</button>
                        </div>
                    </div>
                }
                @if (_verstuurd is not null) { <div class="melding ok" @onclick="() => _verstuurd = null">@_verstuurd</div> }

                @if (_teKeuren.Count > 0)
                {
                    <h4>Goed te keuren (@_teKeuren.Count)</h4>
                    <div class="bel-lijst">
                        @foreach (var o in _teKeuren)
                        {
                            <a class="bel-regel" href="@($"bestellingen?order={o.OrderId}")" target="_blank" rel="noopener"
                               title="Opent de bestelling in een nieuw tabblad; daar druk je op Volgende">
                                <span class="bel-po">PO-@o.OrderId</span>
                                <span class="bel-tekst">
                                    <b>@o.Leverancier</b> @(o.Omschrijving.Length > 0 ? "· " + o.Omschrijving : "")
                                    <small>@o.Besteller · @o.Werkorder @o.Project · @(o.Status == BestelFlow.GoedkeuringPm ? "goedkeuring PM" : "goedkeuring Directie")@Sinds(o.Sinds)</small>
                                </span>
                                <span class="bel-bedrag">@Bedrag(o.Totaal)</span>
                            </a>
                        }
                    </div>
                }

                <h4>
                    Berichten (@Ongelezen ongelezen)
                    <span style="flex:1"></span>
                    <select class="bel-filter" value="@(_alleenOngelezen ? "ongelezen" : "alles")" @onchange='e => _alleenOngelezen = (string?)e.Value == "ongelezen"'>
                        <option value="alles">Alles</option>
                        <option value="ongelezen">Ongelezen</option>
                    </select>
                    @if (Ongelezen > 0) { <button class="klein" @onclick="AllesGelezen">Alles gelezen</button> }
                </h4>
                <div class="bel-lijst">
                    @foreach (var m in Zichtbaar)
                    {
                        var mid = m.Id;
                        var ongelezen = m.Gelezen is null;
                        <div class="bel-bericht @(ongelezen ? "ongelezen" : "")" @key="m.Id">
                            @if (Link(m) is { } link)
                            {
                                <a class="bel-regel" href="@link" target='@(m.Soort == "verbeter" ? null : "_blank")' rel="noopener"
                                   @onclick='async () => { await ZetGelezen(m, true); if (m.Soort == "verbeter") _open = false; }'>
                                    <span class="bel-po">@Icoon(m)</span>
                                    <span class="bel-tekst">@m.Tekst<small>@Onder(m)</small></span>
                                </a>
                            }
                            else
                            {
                                <div class="bel-regel" @onclick="() => ZetGelezen(m, true)">
                                    <span class="bel-po">@Icoon(m)</span>
                                    <span class="bel-tekst bel-brief">@m.Tekst
                                        @if (m.Bijlagen.Count > 0)
                                        {
                                            <span class="bel-plaatjes">
                                                @foreach (var b in m.Bijlagen)
                                                {
                                                    <a href="@($"bestand/{b}")" target="_blank" rel="noopener" title="Plaatje groot openen" @onclick:stopPropagation>
                                                        <img src="@($"bestand/{b}")" alt="plaatje" loading="lazy" />
                                                    </a>
                                                }
                                            </span>
                                        }
                                        <small>@Onder(m)</small></span>
                                </div>
                            }
                            <span class="bel-acties">
                                @if (m.VanId is int van && _berichtenMogelijk)
                                {
                                    <button class="klein" title="Beantwoorden" @onclick="() => NieuwBericht(m)">↩</button>
                                }
                                <button class="klein" title="@(ongelezen ? "Markeer als gelezen" : "Markeer als ongelezen")"
                                        @onclick="() => ZetGelezen(m, ongelezen)">@(ongelezen ? "✓" : "○")</button>
                                <button class="klein rood" title="Bericht wissen" @onclick="() => Wis(m)">✕</button>
                            </span>
                        </div>
                    }
                    @if (!Zichtbaar.Any())
                    {
                        <p class="uitleg">@(_alleenOngelezen ? "Geen ongelezen berichten." : "Nog geen berichten.")</p>
                    }
                </div>
                @if (!_berichtenMogelijk && Meldingen.Beschikbaar)
                {
                    <p class="uitleg">Berichten aan collega's sturen kan nadat Meldingen_Berichten_MariaDB.sql is uitgevoerd.</p>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<TeKeurenOrder> _teKeuren = new();
    private List<Melding> _meldingen = new();       // de box: gelezen en ongelezen
    private bool _open, _alleenOngelezen, _berichtenMogelijk;
    private bool _geluid = true;
    private int? _hoogsteId;                        // hoogste bericht-id bij het vorige laden; daarboven = nieuw
    private Timer? _klok;

    // nieuw bericht / antwoord
    private bool _schrijven, _bezig;
    private int? _aan, _antwoordOp;
    private string _tekst = "";
    private string? _schrijfFout, _verstuurd;
    private List<Werknemer> _collegas = new();

    private int Ongelezen => _meldingen.Count(m => m.Gelezen is null);
    private int Aantal => _teKeuren.Count + Ongelezen;
    private IEnumerable<Melding> Zichtbaar => _alleenOngelezen ? _meldingen.Where(m => m.Gelezen is null) : _meldingen;

    protected override async Task OnInitializedAsync()
    {
        await Ik.ZorgGeladenAsync();
        Signaal.Gewijzigd += OpSignaal;
        await Laad();
        _klok = new Timer(_ => OpSignaal(), null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
    }

    private void OpSignaal() => _ = InvokeAsync(async () => { await Laad(); StateHasChanged(); });

    private async Task Laad()
    {
        if (Ik.WerknemerId is not int wn) { _teKeuren = new(); _meldingen = new(); return; }
        try { _teKeuren = Bestel.Beschikbaar ? await Bestel.TeKeurenAsync(wn, Ik.Mag("Directie")) : new(); } catch { }
        try { _meldingen = Meldingen.Beschikbaar ? await Meldingen.AlleAsync(wn) : new(); } catch { }
        await SpeelBijNieuw(wn);
        try { _berichtenMogelijk = Meldingen.Beschikbaar && await Meldingen.BerichtenMogelijkAsync(); } catch { _berichtenMogelijk = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_koppelPlakken && _schrijven)
        {
            // Ctrl+V met een plaatje in het schrijfvak (zelfde opzet als het lampje: mdeKlembord in klembord.js)
            _koppelPlakken = false;
            try
            {
                _zelf ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("mdeKlembord.koppelPlakken", _schrijfVak, _zelf);
            }
            catch { }
        }
        if (!firstRender || Ik.WerknemerId is not int wn) return;
        try { _geluid = await JS.InvokeAsync<string?>("mdeOpslag.lees", $"mde-geluid-{wn}") != "uit"; } catch { }
    }

    // ---- plaatjes bij een nieuw bericht: pas na versturen naar de filestore ----
    private sealed record Plaatje(byte[] Inhoud, string Soort, string Voorbeeld);
    private readonly List<Plaatje> _plaatjes = new();
    private ElementReference _schrijfVak;
    private DotNetObjectReference<MeldingBel>? _zelf;
    private bool _koppelPlakken;

    [JSInvokable]
    public async Task AfbeeldingGeplakt(string soort, int grootte)
    {
        try
        {
            var stroom = await JS.InvokeAsync<IJSStreamReference?>("mdeKlembord.afbeelding");
            if (stroom is null) return;
            await using var s = await stroom.OpenReadStreamAsync(maxAllowedSize: BerichtBijlage.MaxGrootte);
            using var m = new MemoryStream();
            await s.CopyToAsync(m);
            await InvokeAsync(() => { VoegPlaatjeToe(m.ToArray(), soort); StateHasChanged(); });
        }
        catch (Exception ex) { _schrijfFout = "Plakken mislukt: " + ex.Message; await InvokeAsync(StateHasChanged); }
    }

    /// <summary>Gewone tekst geplakt (in het tekstvak): niets aan de hand.</summary>
    [JSInvokable]
    public Task GeenAfbeelding() => Task.CompletedTask;

    private async Task PlaatjeGekozen(InputFileChangeEventArgs e)
    {
        foreach (var f in e.GetMultipleFiles(BerichtBijlage.Max))
        {
            if (_plaatjes.Count >= BerichtBijlage.Max) break;
            try
            {
                await using var s = f.OpenReadStream(maxAllowedSize: BerichtBijlage.MaxGrootte);
                using var m = new MemoryStream();
                await s.CopyToAsync(m);
                VoegPlaatjeToe(m.ToArray(), f.ContentType is { Length: > 0 } ct ? ct : "image/png");
            }
            catch (Exception ex) { _schrijfFout = $"{f.Name} lezen mislukt: " + ex.Message; }
        }
    }

    private void VoegPlaatjeToe(byte[] inhoud, string soort)
    {
        if (!soort.StartsWith("image/", StringComparison.OrdinalIgnoreCase)) { _schrijfFout = "Alleen plaatjes."; return; }
        if (_plaatjes.Count >= BerichtBijlage.Max) { _schrijfFout = $"Hoogstens {BerichtBijlage.Max} plaatjes."; return; }
        _schrijfFout = null;
        _plaatjes.Add(new Plaatje(inhoud, soort, $"data:{soort};base64,{Convert.ToBase64String(inhoud)}"));
    }

    private static string Extensie(string soort) => soort.ToLowerInvariant() switch
    {
        "image/jpeg" or "image/jpg" => ".jpg", "image/gif" => ".gif", "image/webp" => ".webp", "image/bmp" => ".bmp", _ => ".png",
    };

    /// <summary>Geluidje als er sinds het vorige laden een ongelezen bericht bij is gekomen (niet bij het eerste laden).</summary>
    private async Task SpeelBijNieuw(int wn)
    {
        var hoogste = _meldingen.Select(m => m.Id).DefaultIfEmpty(0).Max();
        var nieuw = _hoogsteId is int vorig
            ? _meldingen.Where(m => m.Id > vorig && m.Gelezen is null).Select(m => m.Id).DefaultIfEmpty(0).Max()
            : 0;
        _hoogsteId = Math.Max(_hoogsteId ?? 0, hoogste);
        if (nieuw > 0 && _geluid)
            try { await JS.InvokeVoidAsync("mdeBerichtGeluid", wn, nieuw); } catch { }
    }

    private async Task WisselGeluid()
    {
        if (Ik.WerknemerId is not int wn) return;
        _geluid = !_geluid;
        try
        {
            await JS.InvokeVoidAsync("mdeOpslag.schrijf", $"mde-geluid-{wn}", _geluid ? "aan" : "uit");
            if (_geluid) await JS.InvokeVoidAsync("mdeBerichtGeluid", wn, 0);   // proefje
        }
        catch { }
    }

    private async Task Wissel()
    {
        _open = !_open;
        _verstuurd = null;
        if (_open) await Laad();
    }

    private static string? Link(Melding m) => m.OrderId is not int oid || m.Soort == "bericht" ? null : m.Soort switch
    {
        "analyse" => $"ai?vraag={oid}",           // OrderId = de vraag (Vragen aan AI)
        "verbeter" => $"verbeterverzoeken?verzoek={oid}",
        _ => $"bestellingen?order={oid}",
    };

    private static string Icoon(Melding m) => m.Soort switch
    {
        "bericht" => "💬", "analyse" => "✨", "afgekeurd" => "❌", "geleverd" => "📦", "verbeter" => "💡", "goedgekeurd" => "✅", _ => "•",
    };

    private static string Onder(Melding m)
        => (m.Van.Length > 0 ? "van " + m.Van + " · " : "") + m.Aangemaakt.ToString("dd-MM HH:mm");

    private async Task ZetGelezen(Melding m, bool gelezen)
    {
        if (Ik.WerknemerId is not int wn || (m.Gelezen is not null) == gelezen) return;
        try { await Meldingen.ZetGelezenAsync(m.Id, wn, gelezen); } catch { }
        var i = _meldingen.FindIndex(x => x.Id == m.Id);
        if (i >= 0) _meldingen[i] = m with { Gelezen = gelezen ? DateTime.Now : null };
    }

    private async Task AllesGelezen()
    {
        if (Ik.WerknemerId is not int wn) return;
        try { await Meldingen.AllesGelezenAsync(wn); } catch { }
        _meldingen = _meldingen.Select(m => m.Gelezen is null ? m with { Gelezen = DateTime.Now } : m).ToList();
    }

    private async Task Wis(Melding m)
    {
        if (Ik.WerknemerId is not int wn) return;
        if (!await JS.InvokeAsync<bool>("mdeBevestig", "Dit bericht wissen? Het is daarna weg.")) return;
        try { await Meldingen.WisAsync(m.Id, wn); _meldingen.RemoveAll(x => x.Id == m.Id); } catch { }
    }

    private async Task NieuwBericht(Melding? antwoordOp)
    {
        _schrijven = true; _schrijfFout = null; _verstuurd = null; _tekst = "";
        _plaatjes.Clear(); _koppelPlakken = true;
        _aan = antwoordOp?.VanId; _antwoordOp = antwoordOp?.Id;
        if (antwoordOp is not null) await ZetGelezen(antwoordOp, true);
        if (_collegas.Count == 0)
        {
            try
            {
                _collegas = (await Uren.GetWerknemersAsync())
                    .Where(w => w.Actief && w.WerknemerId != Ik.WerknemerId)
                    .OrderBy(w => w.Naam).ToList();
            }
            catch (Exception ex) { _schrijfFout = "Collega's ophalen mislukt: " + ex.Message; }
        }
    }

    private async Task Verstuur()
    {
        if (Ik.WerknemerId is not int van || _aan is not int naar || _tekst.Trim().Length == 0) return;
        _bezig = true; _schrijfFout = null;
        try
        {
            var id = await Meldingen.StuurBerichtAsync(naar, van, _tekst, _antwoordOp);
            var mislukt = 0;
            string? reden = null;
            for (var i = 0; i < _plaatjes.Count; i++)
            {
                try
                {
                    using var m = new MemoryStream(_plaatjes[i].Inhoud);
                    await Store.ToevoegenAsync(m, $"bericht {id}-{i + 1}{Extensie(_plaatjes[i].Soort)}", BerichtBijlage.StoreType, id, van);
                }
                catch (Exception ex) { mislukt++; reden ??= ex.GetBaseException().Message; }
            }
            _verstuurd = $"Verstuurd aan {_collegas.FirstOrDefault(w => w.WerknemerId == naar)?.Naam ?? "je collega"}."
                         + (mislukt > 0 ? $" Let op: {mislukt} plaatje(s) konden niet mee: {reden}" : "");
            _schrijven = false; _tekst = ""; _plaatjes.Clear();
            Signaal.Geef();          // de bel van de ontvanger ververst meteen (zelfde server)
        }
        catch (Exception ex) { _schrijfFout = "Versturen mislukt: " + ex.Message; }
        finally { _bezig = false; }
    }

    private static string Sinds(DateTime? d) => d is { } x ? " · sinds " + x.ToString("dd-MM HH:mm") : "";
    private static string Bedrag(decimal w) => w.ToString("C2", new System.Globalization.CultureInfo("nl-NL"));

    public void Dispose()
    {
        Signaal.Gewijzigd -= OpSignaal;
        _klok?.Dispose();
        _zelf?.Dispose();
    }
}
