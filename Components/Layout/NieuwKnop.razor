@implements IDisposable
@inject Changelog Log
@inject IJSRuntime JS
@inject NavigationManager Nav

@* Knopje "Nieuw" in de bovenbalk (wens gebruiker 11-11-2026): alleen zichtbaar als CHANGELOG.md regels heeft die je nog
   niet zag (of als je de pagina Wat is er nieuw nog nooit opende). Per regel bijgehouden, dus het komt terug bij elke
   publicatie met iets nieuws, ook meerdere keren op een dag (12-11-2026). De browser onthoudt het (Changelog.OpslagGezien). *@

@if (_toon)
{
    <a class="nieuw-knop" href="nieuw" title="Bekijk wat er veranderd is in de app">🆕 Nieuw</a>
}

@code {
    private bool _toon;

    protected override void OnInitialized() => Nav.LocationChanged += Verplaatst;

    protected override async Task OnAfterRenderAsync(bool eerste)
    {
        if (eerste) await Kijk();
    }

    private async void Verplaatst(object? _, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        try { await InvokeAsync(Kijk); } catch { }
    }

    private async Task Kijk()
    {
        var toon = false;
        try
        {
            var hier = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
            if (Log.Nieuwste is not null && !hier.Equals("nieuw", StringComparison.OrdinalIgnoreCase))
            {
                var gezien = await JS.InvokeAsync<string?>("mdeOpslag.lees", Changelog.OpslagGezien);
                var oud = string.IsNullOrWhiteSpace(gezien) ? await JS.InvokeAsync<string?>("mdeOpslag.lees", Changelog.OpslagGezienOud) : null;
                var (nieuw, eersteKeer) = Log.NieuwVoor(gezien, oud);
                toon = eersteKeer || nieuw.Count > 0;
            }
        }
        catch { toon = false; }
        if (toon != _toon) { _toon = toon; StateHasChanged(); }
    }

    public void Dispose() => Nav.LocationChanged -= Verplaatst;
}
