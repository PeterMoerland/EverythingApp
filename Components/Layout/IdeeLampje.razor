@implements IDisposable
@inject HuidigeGebruiker Ik
@inject IVerbeterRepository Repo
@inject NavigationManager Nav
@inject FilestoreService Store
@inject IJSRuntime JS
@inject ILogger<IdeeLampje> Log

@* Lampje in de bovenbalk: een idee of verbeterverzoek voor de app intypen. De pagina waar je was gaat vanzelf mee.
   Alles komt in Beheer ▸ Verbeterverzoeken (iedereen ziet de lijst; Directie zet de status). Directie ziet op het
   lampje hoeveel verzoeken er nog nieuw zijn. *@

@if (Repo.Beschikbaar && (Ik.Ingelogd || Ik.IsWerkplek))
{
    <button type="button" class="idee-knop @(_aantalNieuw > 0 ? "met-aantal" : "")" @onclick="Open"
            title="@(_aantalNieuw > 0 ? $"Idee of verbeterverzoek — {_aantalNieuw} nieuw" : "Idee of verbeterverzoek voor de app")">
        <span class="idee-icoon">💡</span>
        @if (_aantalNieuw > 0) { <span class="idee-aantal">@_aantalNieuw</span> }
    </button>
}

@if (_open)
{
    <div class="cmdk-overlay midden" @onclick="Sluit">
        <div class="kiezer idee-venster" @ref="_venster" @onclick:stopPropagation role="dialog" aria-label="Idee of verbeterverzoek">
            <div class="kiezer-kop">
                <b>💡 Idee of verbeterverzoek</b>
                <span style="flex:1"></span>
                <button class="klein" title="Sluiten" @onclick="Sluit">✕</button>
            </div>
            <div class="idee-inhoud">
                @if (!_tabel)
                {
                    <p class="melding fout">De tabel Verbeterverzoeken ontbreekt nog (Verbeterverzoeken_MariaDB.sql).</p>
                }
                else if (_verstuurd)
                {
                    <p class="idee-bedankt">Bedankt! Je verzoek staat in de lijst.</p>
                    @if (_fout is not null) { <div class="melding fout">@_fout</div> }
                    <div class="btngroup">
                        <a class="knopje" href="verbeterverzoeken" @onclick="Sluit">Alle verzoeken bekijken</a>
                        <button class="klein" @onclick="Nogeen">Nog een idee</button>
                        <button class="primair" @onclick="Sluit">Sluiten</button>
                    </div>
                }
                else
                {
                    <p class="uitleg">Wat kan er beter of handiger in de app? Beschrijf het kort; de pagina waar je nu bent
                       (<code>@Pagina</code>) gaat mee.</p>
                    <textarea @ref="_tekstvak" class="idee-tekst" rows="6" maxlength="2000" placeholder="bv. Op het bestelscherm wil ik ook op leverancier kunnen zoeken"
                              value="@_tekst" @oninput="e => _tekst = (string?)e.Value ?? string.Empty"></textarea>
                    @if (Store.Beschikbaar)
                    {
                        @* schermafdruk: Win+Shift+S en dan Ctrl+V ergens in dit venster (koppelPlakken op het hele venster) *@
                        <div class="idee-shots">
                            @foreach (var (shot, i) in _shots.Select((s, i) => (s, i)))
                            {
                                var nr = i;
                                <span class="idee-shot">
                                    <img src="@shot.Voorbeeld" alt="schermafdruk @(nr + 1)" />
                                    <button class="klein rood" title="Weghalen" @onclick="() => _shots.RemoveAt(nr)">✕</button>
                                </span>
                            }
                            @if (_shots.Count < MaxShots)
                            {
                                <span class="idee-plakvak">
                                    📷 Schermafdruk: <b>Win+Shift+S</b>, dan <b>Ctrl+V</b> hier
                                    <label class="klein knop-label">of kies een bestand…
                                        <InputFile OnChange="BestandGekozen" accept="image/*" multiple /></label>
                                </span>
                            }
                        </div>
                    }
                    @if (_fout is not null) { <div class="melding fout">@_fout</div> }
                    <div class="btngroup">
                        <a class="knopje" href="verbeterverzoeken" @onclick="Sluit">Lijst bekijken</a>
                        <span style="flex:1"></span>
                        <button class="klein" @onclick="Sluit">Annuleren</button>
                        <button class="primair" disabled="@(_bezig || _tekst.Trim().Length < 3)" @onclick="Verstuur">Versturen</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private bool _open, _tabel, _verstuurd, _bezig;
    private string _tekst = "";
    private string? _fout;
    private int _aantalNieuw;
    private DateTime _geteld;

    private string Pagina => "/" + Nav.ToBaseRelativePath(Nav.Uri);

    // ---- schermafdrukken: plakken (Ctrl+V in het venster) of kiezen; pas na indienen naar de filestore ----
    private const int MaxShots = 3;
    private const long MaxGrootte = 10_000_000;
    private sealed record Shot(byte[] Inhoud, string Soort, string Voorbeeld);
    private readonly List<Shot> _shots = new();
    private ElementReference _venster;
    private DotNetObjectReference<IdeeLampje>? _ref;
    private bool _koppelen;

    protected override async Task OnAfterRenderAsync(bool eerste)
    {
        if (!_koppelen || !_open || _verstuurd || !_tabel) return;
        _koppelen = false;
        try
        {
            _ref ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("mdeKlembord.koppelPlakken", _venster, _ref);
        }
        catch { }
        // meteen kunnen typen: de cursor in het tekstvak (ook na "Nog een idee")
        try { await _tekstvak.FocusAsync(); } catch { }
    }

    private ElementReference _tekstvak;

    [JSInvokable]
    public async Task AfbeeldingGeplakt(string soort, int grootte)
    {
        try
        {
            var stroom = await JS.InvokeAsync<IJSStreamReference?>("mdeKlembord.afbeelding");
            if (stroom is null) return;
            await using var s = await stroom.OpenReadStreamAsync(maxAllowedSize: MaxGrootte);
            using var m = new MemoryStream();
            await s.CopyToAsync(m);
            await InvokeAsync(() => { VoegToe(m.ToArray(), soort); StateHasChanged(); });
        }
        catch (Exception ex) { _fout = "Plakken mislukt: " + ex.Message; await InvokeAsync(StateHasChanged); }
    }

    /// <summary>Gewone tekst geplakt (in het tekstvak): niets aan de hand.</summary>
    [JSInvokable]
    public Task GeenAfbeelding() => Task.CompletedTask;

    private async Task BestandGekozen(InputFileChangeEventArgs e)
    {
        foreach (var f in e.GetMultipleFiles(MaxShots))
        {
            if (_shots.Count >= MaxShots) break;
            try
            {
                await using var s = f.OpenReadStream(maxAllowedSize: MaxGrootte);
                using var m = new MemoryStream();
                await s.CopyToAsync(m);
                VoegToe(m.ToArray(), f.ContentType is { Length: > 0 } ct ? ct : "image/png");
            }
            catch (Exception ex) { _fout = $"{f.Name} lezen mislukt: " + ex.Message; }
        }
    }

    private void VoegToe(byte[] inhoud, string soort)
    {
        if (!soort.StartsWith("image/", StringComparison.OrdinalIgnoreCase)) { _fout = "Alleen afbeeldingen."; return; }
        if (_shots.Count >= MaxShots) { _fout = $"Hoogstens {MaxShots} schermafdrukken."; return; }
        _fout = null;
        _shots.Add(new Shot(inhoud, soort, $"data:{soort};base64,{Convert.ToBase64String(inhoud)}"));
    }

    private static string Extensie(string soort) => soort.ToLowerInvariant() switch
    {
        "image/jpeg" or "image/jpg" => ".jpg", "image/gif" => ".gif", "image/webp" => ".webp", "image/bmp" => ".bmp", _ => ".png",
    };

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += BijNavigatie;
        await TelNieuw();
    }

    private void BijNavigatie(object? s, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => _ = InvokeAsync(async () => { await TelNieuw(); StateHasChanged(); });

    /// <summary>Alleen voor Directie: hoeveel verzoeken nog nieuw zijn (hoogstens elke halve minuut opgevraagd).</summary>
    private async Task TelNieuw(bool altijd = false)
    {
        if (!Repo.Beschikbaar || !Ik.Mag("Directie")) { _aantalNieuw = 0; return; }
        if (!altijd && DateTime.Now - _geteld < TimeSpan.FromSeconds(30)) return;
        _geteld = DateTime.Now;
        try { _aantalNieuw = await Repo.TabelAanwezigAsync() ? await Repo.AantalNieuwAsync() : 0; } catch { _aantalNieuw = 0; }
    }

    private async Task Open()
    {
        _open = true; _verstuurd = false; _fout = null; _shots.Clear(); _koppelen = true;
        try { _tabel = await Repo.TabelAanwezigAsync(); } catch { _tabel = false; }
    }

    private void Sluit() => _open = false;

    private void Nogeen() { _verstuurd = false; _tekst = ""; _shots.Clear(); _koppelen = true; }

    private async Task Verstuur()
    {
        var tekst = _tekst.Trim();
        if (tekst.Length < 3) return;
        _bezig = true; _fout = null;
        try
        {
            var id = await Repo.IndienenAsync(tekst, Pagina, Ik.WerknemerId, Ik.Werkplek?.Naam ?? "");
            var mislukt = 0;
            string? reden = null;
            for (var i = 0; i < _shots.Count; i++)
            {
                try
                {
                    using var m = new MemoryStream(_shots[i].Inhoud);
                    await Store.ToevoegenAsync(m, $"schermafdruk {id}-{i + 1}{Extensie(_shots[i].Soort)}",
                                               VerzoekStatus.StoreTypeSchermafdruk, id, Ik.WerknemerId ?? 0);
                }
                catch (Exception ex)
                {
                    // de echte reden tonen en loggen (eerder: alleen "niet opgeslagen", oorzaak was een ontbrekende
                    // FileStoreType 340)
                    mislukt++;
                    reden ??= ex.GetBaseException().Message;
                    Log.LogError(ex, "Schermafdruk bij verbeterverzoek {Id} opslaan mislukt", id);
                }
            }
            _shots.Clear();
            _verstuurd = true; _tekst = "";
            if (mislukt > 0) _fout = $"Het verzoek staat erin, maar {mislukt} schermafdruk(ken) konden niet worden opgeslagen: {reden}";
            await TelNieuw(altijd: true);
        }
        catch (Exception ex) { _fout = "Versturen mislukt: " + ex.Message; }
        finally { _bezig = false; }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= BijNavigatie;
        _ref?.Dispose();
    }
}
