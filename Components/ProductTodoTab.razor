@inject IProductTodoRepository Todos
@inject IProductRepository Repo
@inject HuidigeGebruiker Ik
@inject IJSRuntime JS

@* Producten ▸ exemplaar ▸ tab Todo: punten die nog gedaan moeten worden, bij dit exemplaar én bij wat erin zit
   (de print in een robot). 'Wat' is kort en herbruikbaar (bv. Doorsolderen): het Todo-overzicht groepeert erop.
   Toevoegen, gereed en weer open komen ook in de historie van het exemplaar. Open punten zijn te kopiëren naar andere
   exemplaren van hetzelfde type (links aangevinkt, of serienummer van t/m). *@

@if (!_geladen)
{
    <p class="kiezer-info">Laden…</p>
}
else if (!_tabel)
{
    <p class="kiezer-info">De tabel ProductTodo bestaat nog niet. Voer eerst ProductTodo_MariaDB.sql uit op de database.</p>
}
else
{
    <div class="tl-balk todo-invoer">
        <input class="todo-wat" list="todo-wat-lijst" maxlength="60" placeholder="Wat moet er nog gebeuren? bv. Doorsolderen"
               value="@_wat" @oninput="e => _wat = (string?)e.Value ?? string.Empty" @onkeydown="Toets" />
        <datalist id="todo-wat-lijst">
            @foreach (var w in _watLijst)
            {
                <option value="@w.Wat"></option>
            }
        </datalist>
        <input class="mail-zoek" maxlength="250" placeholder="Toelichting (optioneel), bv. R12 en R13 onderkant"
               value="@_toelichting" @oninput="e => _toelichting = (string?)e.Value ?? string.Empty" @onkeydown="Toets" />
        <button class="primair" disabled="@(_bezig || _wat.Trim().Length == 0)" @onclick="Toevoegen">+ Toevoegen</button>
    </div>

    @if (_fout is not null)
    {
        <p class="todo-fout">@_fout</p>
    }

    <table class="kiezer-tabel todo-tabel">
        <thead>
            <tr>
                <th style="width:2rem" title="Gereed">✓</th>
                <th>Wat</th>
                <th>Onderdeel</th>
                <th>Ingevoerd</th>
                <th style="width:4rem"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Zichtbaar)
            {
                <tr @key="t.Id" class="@(t.Open ? "" : "todo-gereed")">
                    <td><input @key="(t.Id, _herteken)" type="checkbox" checked="@(!t.Open)" disabled="@_bezig" title="@(t.Open ? "Afvinken: gereed" : "Weer open zetten")"
                               @onchange="e => ZetGereed(t, e.Value is true)" /></td>
                    <td>
                        <b>@t.Wat</b>
                        @if (t.Toelichting.Length > 0)
                        {
                            <div class="todo-toel">@t.Toelichting</div>
                        }
                    </td>
                    <td>
                        @if (t.ProductId != ProductId)
                        {
                            <button class="todo-link" title="Naar dit onderdeel" @onclick="() => OpGaNaar.InvokeAsync(t)">@t.Exemplaar</button>
                        }
                    </td>
                    <td class="klein-grijs">
                        @t.Aangemaakt.ToString("dd-MM-yyyy") @t.Door
                        @if (t.Gereed is { } g)
                        {
                            <div>gereed @g.ToString("dd-MM-yyyy") @t.GereedDoor</div>
                        }
                    </td>
                    <td>
                        @if (_wisVraag == t.Id)
                        {
                            <button class="klein rood" @onclick="() => Verwijder(t)">Zeker?</button>
                        }
                        else
                        {
                            <button class="klein" title="Per ongeluk ingevoerd? Weghalen (komt niet in de historie)" @onclick="() => _wisVraag = t.Id">✕</button>
                        }
                    </td>
                </tr>
            }
            @if (Zichtbaar.Count == 0)
            {
                <tr><td colspan="5" class="kiezer-info">@(_lijst.Count == 0 ? "Geen punten. Alles is gedaan, of er is nog niets ingevoerd." : "Geen open punten.")</td></tr>
            }
        </tbody>
    </table>

    @if (_lijst.Any(t => t.Open) && !_kopieOpen)
    {
        <button class="klein todo-kopieknop" @onclick="OpenKopie">⧉ Kopiëren naar andere exemplaren…</button>
    }
    @if (_kopieOpen)
    {
        <div class="todo-kopie">
            <div class="todo-kopie-kop"><b>Open punten kopiëren naar andere @Type</b>
                <button class="klein" @onclick="() => _kopieOpen = false">Sluiten</button></div>

            <div class="todo-kopie-blok">
                <span class="uitleg">Welke punten</span>
                @foreach (var t in _lijst.Where(t => t.Open))
                {
                    <label class="vink" @key="t.Id">
                        <input type="checkbox" checked="@_kopiePunten.Contains(t.Id)" @onchange="e => WisselPunt(t.Id, e.Value is true)" />
                        <b>@t.Wat</b>@(t.Toelichting.Length > 0 ? " — " + t.Toelichting : "")
                        @if (t.ProductId != ProductId) { <span class="uitleg"> (bij @t.Exemplaar)</span> }
                    </label>
                }
            </div>

            <div class="todo-kopie-blok">
                <span class="uitleg">Naar</span>
                <label class="vink">
                    <input type="radio" name="todo-kopie-doel" checked="@(!_viaReeks)" disabled="@(GeselecteerdeDoelen.Count == 0)"
                           @onchange="() => _viaReeks = false" />
                    De exemplaren die links zijn aangevinkt (@GeselecteerdeDoelen.Count)
                </label>
                <label class="vink todo-reeks">
                    <input type="radio" name="todo-kopie-doel" checked="@_viaReeks" @onchange="() => _viaReeks = true" />
                    Serienummer
                    <input class="smal" value="@_van" placeholder="van" @oninput="e => { _van = (string?)e.Value ?? string.Empty; _viaReeks = true; }" />
                    t/m
                    <input class="smal" value="@_tot" placeholder="t/m" @oninput="e => { _tot = (string?)e.Value ?? string.Empty; _viaReeks = true; }" />
                </label>
                <div class="uitleg todo-doelen">
                    @if (Doelen.Count == 0)
                    {
                        <text>Nog geen exemplaren gekozen.</text>
                    }
                    else
                    {
                        <text>→ @Doelen.Count @Ex(Doelen.Count): @string.Join(", ", Doelen.Take(30).Select(d => d.Serienummer))@(Doelen.Count > 30 ? " …" : "")</text>
                    }
                </div>
            </div>

            <div class="btngroup">
                <button class="primair" disabled="@(_bezig || Doelen.Count == 0 || _kopiePunten.Count == 0)" @onclick="Kopieer">
                    Kopiëren (@_kopiePunten.Count punt@(_kopiePunten.Count == 1 ? "" : "en") naar @Doelen.Count @Ex(Doelen.Count))
                </button>
                <span class="uitleg">Een punt dat er al open staat, wordt niet nog eens toegevoegd.</span>
            </div>
        </div>
    }
    @if (_kopieUitkomst is not null)
    {
        <p class="todo-kopie-uitkomst">@_kopieUitkomst</p>
    }

    @if (_lijst.Any(t => !t.Open))
    {
        <label class="vink todo-toon-gereed">
            <input type="checkbox" checked="@_toonGereed" @onchange="e => _toonGereed = e.Value is true" />
            Ook gereed tonen (@_lijst.Count(t => !t.Open))
        </label>
    }
}

@code {
    [Parameter, EditorRequired] public int ProductId { get; set; }
    /// <summary>Naar het onderdeel van een punt (Producten opent dat exemplaar).</summary>
    [Parameter] public EventCallback<ProductTodo> OpGaNaar { get; set; }
    /// <summary>Er is iets toegevoegd of afgevinkt: tellers en historie bijwerken.</summary>
    [Parameter] public EventCallback OpGewijzigd { get; set; }
    /// <summary>Exemplaren van hetzelfde type (doelen voor het kopiëren).</summary>
    [Parameter] public IReadOnlyList<ProductRegel> Exemplaren { get; set; } = Array.Empty<ProductRegel>();
    /// <summary>De exemplaren die links zijn aangevinkt.</summary>
    [Parameter] public IReadOnlyCollection<int> Geselecteerd { get; set; } = Array.Empty<int>();
    /// <summary>Typenaam voor de tekst, bv. MPR-1.</summary>
    [Parameter] public string Type { get; set; } = "exemplaren";

    private int? _geladenVoor;
    private bool _geladen, _tabel, _bezig, _toonGereed;
    private string _wat = "", _toelichting = "";
    private string? _fout;
    private int? _wisVraag;
    private List<ProductTodo> _lijst = new();
    private List<TodoWat> _watLijst = new();

    private List<ProductTodo> Zichtbaar => _toonGereed ? _lijst : _lijst.Where(t => t.Open).ToList();

    // ---- kopiëren ----
    private bool _kopieOpen, _viaReeks;
    private string _van = "", _tot = "";
    private string? _kopieUitkomst;
    private readonly HashSet<int> _kopiePunten = new();

    private List<ProductRegel> GeselecteerdeDoelen
        => Exemplaren.Where(p => p.Id != ProductId && !p.Gewist && Geselecteerd.Contains(p.Id)).ToList();

    private static long? Nummer(string s) => long.TryParse(s.Trim(), out var n) ? n : null;

    private List<ProductRegel> Doelen
    {
        get
        {
            if (!_viaReeks) return GeselecteerdeDoelen;
            if (Nummer(_van) is not long a) return new();
            var b = Nummer(_tot) ?? a;
            if (b < a) (a, b) = (b, a);
            return Exemplaren.Where(p => p.Id != ProductId && !p.Gewist && Nummer(p.Serienummer) is long n && n >= a && n <= b)
                             .OrderBy(p => Nummer(p.Serienummer)).ToList();
        }
    }

    private void OpenKopie()
    {
        _kopieOpen = true; _kopieUitkomst = null;
        _kopiePunten.Clear();
        foreach (var t in _lijst.Where(t => t.Open)) _kopiePunten.Add(t.Id);
        _viaReeks = GeselecteerdeDoelen.Count == 0;
    }

    private static string Ex(int n) => n == 1 ? "exemplaar" : "exemplaren";

    private void WisselPunt(int id, bool aan) { if (aan) _kopiePunten.Add(id); else _kopiePunten.Remove(id); }

    private async Task Kopieer()
    {
        var doelen = Doelen;
        // een punt van een onderdeel (de print in de robot) komt bij het doel-exemplaar zelf, met het onderdeel erbij
        var punten = _lijst.Where(t => t.Open && _kopiePunten.Contains(t.Id))
                           .Select(t => (t.Wat, t.ProductId == ProductId ? t.Toelichting
                                                 : ("bij " + t.Type + (t.Toelichting.Length > 0 ? ": " + t.Toelichting : ""))))
                           .Distinct().ToList();
        if (doelen.Count == 0 || punten.Count == 0) return;
        var bron = Exemplaren.FirstOrDefault(p => p.Id == ProductId)?.Serienummer ?? "";
        Dictionary<int, List<string>> uit = new();
        await Doe(async () =>
        {
            uit = await Todos.KopieerAsync(punten, doelen.Select(d => d.Id).ToList(), Ik.WerknemerId);
            foreach (var (doel, wat) in uit)
                await Historie(doel, $"Todo gekopieerd van {Type} {bron}: " + string.Join(", ", wat));
        });
        if (_fout is not null) return;
        var toegevoegd = uit.Values.Sum(l => l.Count);
        var overgeslagen = punten.Count * doelen.Count - toegevoegd;
        _kopieUitkomst = toegevoegd == 0
            ? "Niets toegevoegd: deze punten stonden er al open."
            : $"{toegevoegd} punt{(toegevoegd == 1 ? "" : "en")} toegevoegd bij {uit.Count} {Ex(uit.Count)}" +
              (overgeslagen > 0 ? $"; {overgeslagen} overgeslagen (stond er al open)." : ".");
        _kopieOpen = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_geladenVoor == ProductId) return;
        _geladenVoor = ProductId;
        _wat = ""; _toelichting = ""; _fout = null; _wisVraag = null;
        _kopieOpen = false; _kopieUitkomst = null;
        await Laad();
    }

    private async Task Laad()
    {
        try
        {
            _tabel = await Todos.TabelAanwezigAsync();
            if (_tabel)
            {
                _lijst = await Todos.VanExemplaarAsync(ProductId);
                _watLijst = await Todos.WatLijstAsync();
            }
        }
        catch (Exception ex) { _fout = "Laden mislukt: " + ex.Message; }
        _geladen = true;
    }

    private async Task Toets(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Toevoegen();
    }

    private async Task Toevoegen()
    {
        var wat = _wat.Trim();
        if (wat.Length == 0 || _bezig) return;
        // zelfde schrijfwijze als een bestaand punt, zodat het overzicht ze samen telt
        wat = _watLijst.FirstOrDefault(w => w.Wat.Equals(wat, StringComparison.OrdinalIgnoreCase))?.Wat ?? wat;
        var toel = _toelichting.Trim();
        await Doe(async () =>
        {
            await Todos.MaakAsync(ProductId, wat, toel, Ik.WerknemerId);
            await Historie(ProductId, "Todo: " + wat + (toel.Length > 0 ? " — " + toel : ""));
            _wat = ""; _toelichting = "";
        });
    }

    private int _herteken;        // @key van de vinkjes: na "nee" bij gereed melden het vinkje terugzetten

    private async Task ZetGereed(ProductTodo t, bool gereed)
    {
        // gereed melden: eerst bevestigen (wens gebruiker 24-10-2026); bij nee springt het vinkje terug
        if (gereed && !await JS.InvokeAsync<bool>("mdeBevestig", $"‘{t.Wat}’ bij {t.Exemplaar} gereed melden?"))
        { _herteken++; return; }
        await Doe(async () =>
        {
            await Todos.ZetGereedAsync(t.Id, gereed, Ik.WerknemerId);
            await Historie(t.ProductId, (gereed ? "Todo gereed: " : "Todo weer open: ") + t.Wat);
        });
    }

    private Task Verwijder(ProductTodo t) => Doe(() => Todos.VerwijderAsync(t.Id));

    private async Task Historie(int productId, string tekst)
    {
        try { await Repo.VoegHistorieToeAsync(productId, tekst, null, Ik.WerknemerId); } catch { /* de todo zelf staat er wel */ }
    }

    private async Task Doe(Func<Task> werk)
    {
        _bezig = true; _fout = null; _wisVraag = null;
        try
        {
            await werk();
            _lijst = await Todos.VanExemplaarAsync(ProductId);
            _watLijst = await Todos.WatLijstAsync();
            await OpGewijzigd.InvokeAsync();
        }
        catch (Exception ex) { _fout = "Opslaan mislukt: " + ex.Message; }
        finally { _bezig = false; }
    }
}
