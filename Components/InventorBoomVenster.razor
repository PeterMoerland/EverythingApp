@inject InventorBoom Boom
@inject HuidigeGebruiker Ik
@inject IJSRuntime JS

@* ============================================================================
   Artikelen ▸ Inventor-boom (wens gebruiker 25-11-2026): de samenstelling die uit Inventor is geëxporteerd
   als boom. Alleen kijken; artikelsamenstellingen hiervan maken komt later.
   Bovenin kies je de export uit de hoofdtabel InventorAssemblyExport (elke export blijft bewaard, sinds 26-11-2026);
   de boom eronder komt uit InventorAssemblyTree met dat exportnummer.
   ============================================================================ *@

@if (Open)
{
    @* Ingebed = op de pagina Artikelen ▸ Inventor-boom: geen venster eromheen, geen kop en geen sluitknop *@
    <div class="@(Ingebed ? "ib-pagina" : "cmdk-overlay midden")" @onclick="Sluit">
        <div class="@(Ingebed ? "ib-los" : "factuurvenster ib-venster")" @onclick:stopPropagation role="@(Ingebed ? null : "dialog")" aria-label="Inventor-boom"
             tabindex="-1" @onkeydown='e => { if (e.Key == "Escape") _ = Sluit(); }'>
            @if (!Ingebed)
            {
                <header class="bijlagekop">
                    <h2>Inventor-boom</h2>
                    <button type="button" class="klein" title="Sluiten (Esc)" @onclick="Sluit">✕</button>
                </header>
            }
            <div class="@(Ingebed ? null : "factuurvenster-inhoud")">
                @if (_fout is not null) { <p class="uitleg">Lezen is niet gelukt: @_fout</p> }
                else if (!_geladen) { <p class="uitleg">Laden…</p> }
                else if (!_hoofdtabel) { <p class="uitleg">De hoofdtabel InventorAssemblyExport ontbreekt nog: draai eerst het script van de Inventor-add-in (<code>2026-11-26-stuklijst-exports.sql</code>).</p> }
                else if (_exports.Count == 0) { <p class="uitleg">Er staat nog geen export uit Inventor. Exporteer een samenstelling met de knop Stuklijst in Inventor.</p> }
                else
                {
                    @if (_melding is not null)
                    {
                        <div class="melding @(_meldingFout ? "fout" : "ok")" style="position:static;max-width:none;margin:0 0 8px" @onclick="() => _melding = null">@_melding</div>
                    }
                    <div class="ib-balk">
                        <select value="@_gekozen" @onchange="Kies" aria-label="Welke export">
                            @foreach (var e in _exports)
                            {
                                <option value="@e.Id">#@e.Id · @Titel(e) — @(e.Door.Length > 0 ? e.Door : "onbekend"), @(e.Op?.ToString("d-M-yyyy HH:mm") ?? "zonder datum") (@e.Regels regels)</option>
                            }
                        </select>
                        <button type="button" class="klein" @onclick="AllesOpen">Alles uitvouwen</button>
                        <button type="button" class="klein" @onclick="() => _open.Clear()">Alles inklappen</button>
                        <span class="ib-tel">@_regels.Count regels@(_zonder > 0 ? $", {_zonder} zonder artikel" : "")</span>
                    </div>
                    @if (_exports.FirstOrDefault(e => e.Id == _gekozen) is { } kop)
                    {
                        @* de gegevens van de gekozen export uit de hoofdtabel *@
                        <div class="ib-kop">
                            @if (kop.Commentaar.Length > 0) { <p class="ib-commentaar">@kop.Commentaar</p> }
                            <p class="ib-kopregel">
                                @if (kop.Samenstelling.Length > 0) { <span><b>Bestand</b> @kop.Samenstelling</span> }
                                @if (kop.ArtikelId is int ka) { <span><b>ArtikelID</b> @ka</span> }
                                @if (kop.Computer.Length > 0) { <span><b>Computer</b> @kop.Computer</span> }
                                @if (kop.Uitgave.Length > 0) { <span><b>Add-in</b> @kop.Uitgave</span> }
                            </p>
                        </div>
                    }
                    <div class="ib-schuif">
                        <table class="kiezer-tabel ib-tabel">
                            @* alle velden van InventorAssemblyTree (wens gebruiker 25-11-2026), de boom vooraan; de tabel schuift opzij *@
                            <thead><tr>
                                <th>Onderdeel</th><th class="ib-getal">Aantal</th><th>Artikel</th>
                                <th>Partnumber</th><th>Description</th><th>Material</th>
                                <th class="ib-getal">ArtikelID</th><th>isAssy</th><th>inInVault</th><th class="ib-getal">VaultVersion</th>
                                <th class="ib-getal">Volgnr</th><th class="ib-getal">Parent</th><th class="ib-getal">Level</th>
                                <th>CreatedAt</th><th>last_updated</th><th class="ib-getal">ID</th>
                            </tr></thead>
                            <tbody>
                                @foreach (var (r, diepte) in Zichtbaar())
                                {
                                    var groep = _kinderen.ContainsKey(r.Volgnummer);
                                    var open = groep && _open.Contains(r.Volgnummer);
                                    <tr @key="r.Volgnummer" class="@(r.Samenstelling ? "ib-assy" : "") @(r.ArtikelId is null ? "ib-zonder" : "")">
                                        <td style="@($"padding-left:{diepte * 16 + 6}px")">
                                            @if (groep) { <button type="button" class="ib-pijl" aria-expanded="@open" title="@(open ? "Dichtklappen" : "Openklappen")" @onclick="() => Wissel(r.Volgnummer)">@(open ? "▾" : "▸")</button> }
                                            else { <span class="ib-pijl"></span> }
                                            <span>@Naam(r)</span>
                                            @if (Extra(r) is { Length: > 0 } extra) { <small> @extra</small> }
                                        </td>
                                        <td class="ib-getal">@r.Aantal</td>
                                        <td>
                                            @if (r.ArtikelId is int a)
                                            {
                                                @(r.ArtikelCode.Length > 0 ? r.ArtikelCode : "#" + a)
                                                @if (r.ViaAlias) { <small class="ib-alias" title="Gekoppeld via de aliaslijst: de naam van dit part is een alias van dit artikel">alias</small> }
                                            }
                                            else if (MagKoppelen && r.Partnummer.Length > 0)
                                            {
                                                @* het artikel opzoeken; de naam van het part komt dan als alias bij dat artikel *@
                                                <button type="button" class="klein ib-zoek" disabled="@_bezig" title="Het artikel opzoeken en deze naam als alias aan dat artikel toevoegen"
                                                        @onclick="() => _zoekVoor = r">🔍 Zoek artikel</button>
                                            }
                                            else { <text>geen artikel</text> }
                                        </td>
                                        <td>@r.Partnummer</td>
                                        <td>@r.Omschrijving</td>
                                        <td>@r.Materiaal</td>
                                        <td class="ib-getal">@r.ArtikelId</td>
                                        <td>@(r.Samenstelling ? "ja" : "nee")</td>
                                        <td>@(r.InVault is null ? "" : r.InVault == true ? "ja" : "nee")</td>
                                        <td class="ib-getal">@r.VaultVersie</td>
                                        <td class="ib-getal">@r.Volgnummer</td>
                                        <td class="ib-getal">@r.Ouder</td>
                                        <td class="ib-getal">@r.Niveau</td>
                                        <td>@r.Gemaakt?.ToString("d-M-yyyy HH:mm:ss")</td>
                                        <td>@r.Bijgewerkt?.ToString("d-M-yyyy HH:mm:ss")</td>
                                        <td class="ib-getal">@r.Id</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* het bestaande artikelzoekvenster (ook bij bestelregels); begint met de naam van het part *@
<ArtikelZoekVenster Open="_zoekVoor is not null" Zoek="@(_zoekVoor?.Partnummer ?? string.Empty)" Maakdelen="false"
                    OpGekozen="KoppelAlias" OpGesloten="() => _zoekVoor = null" />

@code {
    // ---- een regel zonder artikel koppelen via de aliaslijst (wens gebruiker 26-11-2026) ----
    private InventorRegel? _zoekVoor;
    private string? _melding;
    private bool _meldingFout, _bezig;

    /// <summary>Aliassen toevoegen mag wie artikelen mag bewerken (Artikelbeheer of Directie), zoals in Artikelen.</summary>
    private bool MagKoppelen => Ik.Mag("Artikelbeheer") || Ik.Mag("Directie");

    /// <summary>Een artikel gekozen in het zoekvenster: na een vraag de naam van het part als alias bij dat artikel zetten.</summary>
    private async Task KoppelAlias(int artikelId)
    {
        var regel = _zoekVoor;
        _zoekVoor = null;
        if (regel is null || !MagKoppelen || _bezig) return;
        try
        {
            if (!await JS.InvokeAsync<bool>("mdeBevestig",
                    $"\"{regel.Partnummer}\" als alias toevoegen aan artikel {artikelId}? Alle regels met deze naam tellen daarna als dat artikel, ook in volgende exports.",
                    new { kop = "Alias toevoegen", ja = "Toevoegen" })) return;
        }
        catch { return; }
        _bezig = true;
        try
        {
            _melding = await Boom.AliasToevoegenAsync(artikelId, regel.Partnummer, Ik.WerknemerId);
            _meldingFout = false;
            var open = _open.ToList();
            await Laad();
            _open.Clear();
            foreach (var o in open) _open.Add(o);      // de boom blijft staan zoals hij stond
        }
        catch (Exception ex) { _melding = ex.GetBaseException().Message; _meldingFout = true; }
        _bezig = false;
    }

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OpGesloten { get; set; }
    /// <summary>Op een eigen pagina tonen in plaats van als venster.</summary>
    [Parameter] public bool Ingebed { get; set; }

    private List<InventorExport> _exports = new();
    private List<InventorRegel> _regels = new();
    private Dictionary<int, List<InventorRegel>> _kinderen = new();
    private List<InventorRegel> _top = new();
    private readonly HashSet<int> _open = new();
    private bool _geladen, _was, _hoofdtabel;
    private int _gekozen, _zonder;
    private string? _fout;

    protected override async Task OnParametersSetAsync()
    {
        if (!Open) { _was = false; return; }
        if (_was) return;
        _was = true; _geladen = false; _fout = null;
        try
        {
            _hoofdtabel = await Boom.HoofdtabelAanwezigAsync();
            _exports = await Boom.ExportsAsync();
            if (_exports.Count > 0)
            {
                if (!_exports.Any(e => e.Id == _gekozen)) _gekozen = _exports[0].Id;
                await Laad();
            }
        }
        catch (Exception ex) { _fout = ex.GetBaseException().Message; }
        _geladen = true;
    }

    private async Task Kies(ChangeEventArgs e)
    {
        if (!int.TryParse((string?)e.Value, out var w)) return;
        _gekozen = w;
        try { await Laad(); } catch (Exception ex) { _fout = ex.GetBaseException().Message; }
    }

    private async Task Laad()
    {
        _regels = await Boom.RegelsAsync(_gekozen);
        var nummers = _regels.Select(r => r.Volgnummer).ToHashSet();
        // een regel waarvan de ouder niet bestaat hoort bovenaan, anders is hij onvindbaar
        _top = _regels.Where(r => r.Ouder is not int o || !nummers.Contains(o) || o == r.Volgnummer).ToList();
        _kinderen = _regels.Where(r => r.Ouder is int o && nummers.Contains(o) && o != r.Volgnummer).GroupBy(r => r.Ouder!.Value).ToDictionary(g => g.Key, g => g.ToList());
        _zonder = _regels.Count(r => r.ArtikelId is null);
        _open.Clear();
        // de samenstelling zelf en het eerste niveau eronder staan open
        foreach (var t in _top) { _open.Add(t.Volgnummer); if (_kinderen.TryGetValue(t.Volgnummer, out var k)) foreach (var x in k) _open.Add(x.Volgnummer); }
    }

    private IEnumerable<(InventorRegel R, int Diepte)> Zichtbaar() => _top.SelectMany(t => Tak(t, 0));

    private IEnumerable<(InventorRegel R, int Diepte)> Tak(InventorRegel r, int diepte)
    {
        yield return (r, diepte);
        if (diepte > 40 || !_open.Contains(r.Volgnummer) || !_kinderen.TryGetValue(r.Volgnummer, out var kinderen)) yield break;
        foreach (var k in kinderen)
            foreach (var x in Tak(k, diepte + 1)) yield return x;
    }

    /// <summary>De naam van een export in de keuzelijst: het artikel van de hoofdsamenstelling, anders de bestandsnaam.</summary>
    private static string Titel(InventorExport e)
        => e.Artikel.Length > 0 ? e.Artikel : e.Samenstelling.Length > 0 ? e.Samenstelling : e.ArtikelId is int a ? "artikel " + a : "(zonder naam)";

    private void Wissel(int nr) { if (!_open.Remove(nr)) _open.Add(nr); }
    private void AllesOpen() { foreach (var k in _kinderen.Keys) _open.Add(k); }

    /// <summary>Een MDE-artikel staat er met alleen zijn ArtikelID in (de tekstkolommen zijn dan leeg): dan de naam uit Artikelen.</summary>
    private static string Naam(InventorRegel r)
        => r.Partnummer.Length > 0 ? r.Partnummer : r.ArtikelOmschrijving.Length > 0 ? r.ArtikelOmschrijving : r.ArtikelCode.Length > 0 ? r.ArtikelCode
         : r.ArtikelId is int a ? "artikel " + a : "(zonder naam)";

    private static string Extra(InventorRegel r)
        => r.Partnummer.Length > 0 ? (r.Omschrijving.Length > 0 ? r.Omschrijving : r.ArtikelOmschrijving) : "";

    private async Task Sluit() { if (!Ingebed) await OpGesloten.InvokeAsync(); }
}
