@* Eén tak in de boom met artikelgroepen. Roept zichzelf aan voor de takken eronder. *@

<li class="grtak">
    <div class="grrij @(Gekozen == Knoop.Pad ? "gekozen" : "")">
        @if (Knoop.Kinderen.Count > 0)
        {
            <button class="grpijl" @onclick="Klap" title="@(Open ? "Dichtklappen" : "Openklappen")">
                @(Open ? "▾" : "▸")
            </button>
        }
        else
        {
            <span class="grpijl leeg"></span>
        }

        @* Enkele klik = open-/dichtklappen, dubbelklik = kiezen (zoals in Access). *@
        <button class="grnaam" @onclick="KlapOfNiets" @ondblclick="Kies"
                title="@Tip">@Knoop.Naam</button>

        @if (Knoop.Aantal > 0)
        {
            <span class="graantal">@Knoop.Aantal</span>
        }
        @if (Knoop.Id != 0 && OpNieuw.HasDelegate)
        {
            <button class="grplus" title="Nieuwe subgroep onder @Knoop.Naam" @onclick="Nieuw">+</button>
        }
    </div>

    @if (Open && Knoop.Kinderen.Count > 0)
    {
        <ul class="grlijst">
            @foreach (var kind in Knoop.Kinderen)
            {
                <GroepTak @key="kind.Pad" Knoop="kind" Gekozen="@Gekozen"
                          OpenPaden="OpenPaden" OpKeuze="OpKeuze" OpKlap="OpKlap" OpNieuw="OpNieuw" />
            }
        </ul>
    }
</li>

@code {
    [Parameter, EditorRequired] public Groepknoop Knoop { get; set; } = new();

    /// <summary>Het pad dat nu geselecteerd is; die tak lichten we op.</summary>
    [Parameter] public string? Gekozen { get; set; }

    /// <summary>
    /// Welke takken openstaan. Dit houdt het scherm bij, niet de tak zelf — dan
    /// blijft de boom open zoals hij was, ook na een zoekopdracht.
    /// </summary>
    [Parameter, EditorRequired] public HashSet<string> OpenPaden { get; set; } = new();

    [Parameter] public EventCallback<Groepknoop> OpKeuze { get; set; }
    [Parameter] public EventCallback<string> OpKlap { get; set; }
    /// <summary>'+' achter de groep: een nieuwe subgroep eronder maken.</summary>
    [Parameter] public EventCallback<Groepknoop> OpNieuw { get; set; }

    private bool Open => OpenPaden.Contains(Knoop.Pad);

    private Task Klap() => OpKlap.InvokeAsync(Knoop.Pad);
    private string Tip => Knoop.Kinderen.Count > 0 ? "Klik: openklappen · dubbelklik: kiezen" : "Dubbelklik: kiezen";
    private Task KlapOfNiets() => Knoop.Kinderen.Count > 0 ? Klap() : Task.CompletedTask;
    private Task Kies() => OpKeuze.InvokeAsync(Knoop);
    private Task Nieuw() => OpNieuw.InvokeAsync(Knoop);
}
