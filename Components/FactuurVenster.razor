    private string _losUrl = "";

    private async Task KiesDoc(Bestand doc)
    {
        _keuzeLos = null;
        await WisLosUrl();
        _keuzeDoc = doc.FileStoreId;
    }

    private async Task KiesLos(GekozenBestand best)
    {
        if (_keuzeLos == best && _losUrl.Length > 0) return;
        _keuzeDoc = null;
        await WisLosUrl();
        _keuzeLos = best;

        if (MimeVan(best.Naam) is { Length: > 0 } soort)
        {
            try { _losUrl = await JS.InvokeAsync<string>("mdeBlob.maak", best.Inhoud, soort); }
            catch { _losUrl = ""; }
        }
    }

    /// <summary>Het tijdelijke adres opruimen; anders blijft het geheugen in
    /// de browser bezet tot de pagina dichtgaat.</summary>
    private async Task WisLosUrl()
    {
        if (_losUrl.Length == 0) return;
        var url = _losUrl;
        _losUrl = "";
        try { await JS.InvokeVoidAsync("mdeBlob.weg", url); } catch { /* al weg */ }
    }

    private static string MimeVan(string naam) => Path.GetExtension(naam).ToLowerInvariant() switch
    {
        ".pdf" => "application/pdf",
        ".jpg" or ".jpeg" => "image/jpeg",
        ".png" => "image/png",
        ".webp" => "image/webp",
        ".gif" => "image/gif",
        _ => ""
    };

    private static string SoortVan(string naam)
    {
        var ext = Path.GetExtension(naam).ToLowerInvariant();
        if (ext == ".pdf") return "pdf";
        if (ext is ".jpg" or ".jpeg" or ".png" or ".webp" or ".gif") return "afbeelding";
        if (VoorbeeldService.MoetOmgezet(naam)) return "office";
        return "";
    }

    public async ValueTask DisposeAsync()
    {
        try { await WisLosUrl(); } catch { /* verbinding kan al weg zijn */ }
    }

