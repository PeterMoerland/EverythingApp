@* Een inkomende factuur toevoegen of aanpassen.
   FactuurId: 0 = nieuw, een getal = die factuur, null = venster dicht. *@
@inject IFactuurRepository Repo
@inject IRelatieRepository Relaties
@inject IWerknemerRepository WnRepo
@inject FilestoreService Filestore
@inject FactuurLezer Lezer
@inject IJSRuntime JS
@inject HuidigeGebruiker Ik
@implements IAsyncDisposable

@if (FactuurId is not null)
{
    @* Sluiten alleen als de klik ook óp de achtergrond begón: wie het venster
       versleept en buiten loslaat, 'klikt' voor de browser op de achtergrond
       en zou anders zomaar zijn venster kwijt zijn. *@
    <div class="cmdk-overlay midden" @onmousedown="() => _overlayDruk = true"
         @onclick="OverlayGeklikt">
        <div class="factuurvenster verplaatsbaar" @onclick:stopPropagation
             @onmousedown:stopPropagation>
            <header class="bijlagekop sleepkop">
                <h2>
                    @(_nieuw ? "Factuur toevoegen" : $"Factuur {_factuur.Factuurnummer}")
                    @if (!_nieuw)
                    {
                        <span class="artikel-id">#@_factuur.Id</span>
                    }
                </h2>
                <button class="klein" @onclick="Afbreken">✕</button>
            </header>

            <div class="factuurvenster-inhoud">
                @if (_bezig)
                {
                    <p class="uitleg">Bezig met ophalen…</p>
                }
                else
                {
                    @if (_melding is not null)
                    {
                        <div class="melding @(_meldingFout ? "fout" : "ok")"
                             @onclick="() => _melding = null">@_melding</div>
                    }

                    @* Twee kolommen: links de velden, rechts het document in beeld.
                       Zo controleer je de ingevulde velden met het origineel ernaast. *@
                    <div class="factuur-tweeluik">
                    <div class="factuur-linkerkant">

                    @* De AI is (nog) traag; deze balk laat zien dat er echt
                       gewerkt wordt: de fase komt uit de lezer zelf, de teller
                       tikt elke seconde door. *@
                    @if (_lezen)
                    {
                        <div class="factuur-lezen">
                            <span class="draaier"></span>
                            <span class="factuur-lezen-tekst">
                                <b>@_leesBestand</b> — @_leesStand
                            </span>
                            <span class="zij-extra">@((int)(DateTime.Now - _leesStart).TotalSeconds) s</span>
                        </div>
                    }

                    @if (_aiOpmerkingen.Count > 0)
                    {
                        <div class="factuur-ai">
                            <strong>Let op bij het controleren:</strong>
                            <ul>
                                @foreach (var o in _aiOpmerkingen)
                                {
                                    <li @key="o">@o</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="wn-velden een-kolom">
                        <div class="wn-veld">
                            <label>Administratie</label>
                            <select value="@(_factuur.AdministratieId?.ToString() ?? "")"
                                    @onchange="AdminGewijzigd">
                                <option value="">— kies een BV —</option>
                                @foreach (var a in _administraties)
                                {
                                    <option value="@a.Id">@a.Afkorting — @a.Naam</option>
                                }
                            </select>
                        </div>

                        <div class="wn-veld">
                            <label>Leverancier</label>
                            <div class="factuur-leverancier">
                                @if (_factuur.Bedrijf.Length > 0)
                                {
                                    <span class="factuur-gekozen @Auto("Leverancier")">@_factuur.Bedrijf</span>
                                }
                                else
                                {
                                    <span class="zij-extra">nog niet gekozen</span>
                                }
                                <button class="klein" title="Zoeken in de relaties"
                                        @onclick="() => _zoekOpen = !_zoekOpen">🔍 zoeken</button>
                            </div>
                        </div>

                        @if (_zoekOpen)
                        {
                            <div class="wn-veld breed">
                                <label></label>
                                <div class="factuur-zoekvak">
                                    <input data-zoeklijst placeholder="Naam, plaats of IBAN…" value="@_leverancierZoek"
                                           @oninput="LeverancierZoekGewijzigd" autofocus />

                                    @if (_leverancierZoek.Trim().Length is > 0 and < 2)
                                    {
                                        <p class="zij-extra">Typ nog een letter…</p>
                                    }
                                    else if (_leveranciers.Count == 0 && _leverancierZoek.Trim().Length >= 2)
                                    {
                                        <p class="zij-extra">Niets gevonden. Staat hij al bij Relaties?</p>
                                    }

                                    <div class="wn-namen kort">
                                        @foreach (var l in _leveranciers)
                                        {
                                            <button class="wn-naam" @key="l.Id"
                                                    @onclick="() => KiesLeverancier(l)">@l.Naam</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }

                        @* Vraag om te onthouden dat de naam op de factuur bij deze
                           leverancier hoort. De volgende keer weet hij het zelf. *@
                        @if (_aliasVraag.Length > 0)
                        {
                            <div class="wn-veld breed">
                                <label></label>
                                <div class="factuur-alias">
                                    <span>
                                        Op de factuur staat <b>@_aliasVraag</b>, jij koos
                                        <b>@_factuur.Bedrijf</b>. Onthouden, zodat dit voortaan
                                        vanzelf goed gaat?
                                    </span>
                                    <span class="btngroup">
                                        <button class="primair" @onclick="OnthoudAlias">Onthouden</button>
                                        <button class="klein" @onclick="() => _aliasVraag = string.Empty">
                                            Nee, eenmalig
                                        </button>
                                    </span>
                                </div>
                            </div>
                        }

                        @if (_bankWaarschuwing.Length > 0)
                        {
                            <div class="wn-veld breed">
                                <label></label>
                                <span class="factuur-waarschuwing">@_bankWaarschuwing</span>
                            </div>
                        }

                        <div class="wn-veld">
                            <label>Factuurdatum</label>
                            <NlDatum Waarde="_factuur.Factuurdatum" WaardeChanged="DatumGewijzigd"
                                     Klasse="@Auto("Factuurdatum")" />
                        </div>

                        <div class="wn-veld">
                            <label>Factuurnummer</label>
                            <input class="@Auto("Factuurnummer")" value="@_factuur.Factuurnummer" maxlength="45"
                                   @onchange="FactuurnummerGewijzigd" />
                        </div>

                        <div class="wn-veld breed">
                            <label>Omschrijving</label>
                            <input class="@Auto("Omschrijving")" value="@_factuur.Omschrijving" maxlength="100"
                                   @onchange="OmschrijvingGewijzigd" />
                        </div>

                        <div class="wn-veld">
                            <label>Betalingstermijn</label>
                            <span class="factuur-termijn">
                                <input class="r smal @Auto("Betalingstermijn")"
                                       value="@_factuur.Betalingstermijn" @onchange="TermijnGewijzigd" />
                                @foreach (var dagen in new[] { 0, 14, 30, 60 })
                                {
                                    <button class="klein @(_factuur.Betalingstermijn == dagen ? "actief" : "")"
                                            @key="dagen" @onclick="() => ZetTermijn(dagen)">@dagen</button>
                                }
                                <span class="zij-extra">
                                    @if (_factuur.Factuurdatum is DateOnly d)
                                    {
                                        <text>vervalt @d.AddDays(_factuur.Betalingstermijn).ToString("dd-MM-yyyy")</text>
                                    }
                                </span>
                            </span>
                        </div>

                        <div class="wn-veld">
                            <label>Referentie MDE</label>
                            <input value="@_factuur.ReferentieMde" maxlength="45"
                                   @onchange="e => _factuur.ReferentieMde = Tekst(e)" />
                        </div>
                    </div>

                    @* ---------- de bedragen ---------- *@
                    <h3 class="wn-kop">Bedragen</h3>
                    <div class="wn-velden een-kolom">
                        <div class="wn-veld">
                            <label>Bedrag excl. btw</label>
                            <input class="r smal @Auto("BedragExBtw")" value="@_exInvoer" @onchange="ExGewijzigd" />
                        </div>
                        <div class="wn-veld">
                            <label>Btw</label>
                            <span class="factuur-termijn">
                                <input class="r smal @Auto("Btw")" value="@_btwInvoer" @onchange="BtwGewijzigd" />
                                @foreach (var tarief in new[] { 21, 9, 0 })
                                {
                                    <button class="klein" @key="tarief"
                                            title="@($"Btw uitrekenen met {tarief}%")"
                                            @onclick="() => ZetTarief(tarief)">@tarief%</button>
                                }
                            </span>
                        </div>
                        <div class="wn-veld">
                            <label>Totaal incl. btw</label>
                            <input class="r smal" value="@_totaalInvoer" @onchange="TotaalGewijzigd" />
                        </div>
                        <div class="wn-veld">
                            <label>Doorbelasten</label>
                            <span class="factuur-termijn">
                                <input class="r smal" value="@_factuur.Doorbelasten.ToString("0.##", Nl)"
                                       @onchange="DoorbelastenGewijzigd" />
                                <span class="zij-extra">%</span>
                            </span>
                        </div>
                    </div>

                    @if (_optellingFout.Length > 0)
                    {
                        <p class="factuur-waarschuwing">@_optellingFout</p>
                    }

                    @* ---------- stand van zaken ---------- *@
                    <h3 class="wn-kop">Stand van zaken</h3>

                    @* De keten van boven naar beneden. 'Ingevoerd' staat er als
                       eerste stap bij, maar die zet het toevoegen zelf. Bij een
                       bestaande factuur werken de vinkjes direct (zoals in de
                       lijst); bij een nieuwe gaan Goedgekeurd en Betaald mee met
                       het toevoegen — er zijn nu eenmaal facturen die al betaald
                       binnenkomen. *@
                    <div class="factuur-stand">
                        <label class="factuur-standregel @(_nieuw ? "" : "ja")">
                            <input type="checkbox" checked="@(!_nieuw)" disabled />
                            <span>Ingevoerd</span>
                            <span class="zij-extra">
                                @if (_nieuw)
                                {
                                    <text>gebeurt bij het toevoegen</text>
                                }
                                else
                                {
                                    @Stempel(_factuur.Invoerdatum, _factuur.IngevoerdDoor)
                                }
                            </span>
                        </label>

                        <label class="factuur-standregel @(_factuur.Goedgekeurd ? "ja" : "")">
                            <input type="checkbox" checked="@_factuur.Goedgekeurd" disabled="@(!MagGoedkeuren)"
                                   @key="(1, _vlagRonde)"
                                   @onchange="e => ZetVlagHier(FactuurVlag.Goedgekeurd, e)" />
                            <span>Goedgekeurd</span>
                            <span class="zij-extra">@Stempel(_factuur.GoedgekeurdOp, _factuur.GoedgekeurdDoor)</span>
                        </label>

                        <label class="factuur-standregel @(_factuur.Betaald ? "ja" : "")">
                            <input type="checkbox" checked="@_factuur.Betaald" disabled="@(!MagInvoeren)"
                                   @key="(2, _vlagRonde)"
                                   @onchange="e => ZetVlagHier(FactuurVlag.Betaald, e)" />
                            <span>Betaald</span>
                            <span class="zij-extra">
                                @Stempel(_factuur.BetaaldOp?.ToDateTime(TimeOnly.MinValue), _factuur.BetaaldDoor)
                            </span>
                        </label>

                        @if (!_nieuw)
                        {
                            <label class="factuur-standregel @(_factuur.SepaVerzonden ? "ja" : "")">
                                <input type="checkbox" checked="@_factuur.SepaVerzonden" disabled="@(!MagInvoeren)"
                                       @key="(3, _vlagRonde)"
                                       @onchange="e => ZetVlagHier(FactuurVlag.Sepa, e)" />
                                <span>SEPA verzonden</span>
                                <span class="zij-extra">@Stempel(_factuur.SepaOp, _factuur.SepaDoor)</span>
                            </label>

                            <label class="factuur-standregel @(_factuur.NaarBasecone ? "ja" : "")">
                                <input type="checkbox" checked="@_factuur.NaarBasecone" disabled="@(!MagInvoeren)"
                                       @key="(4, _vlagRonde)"
                                       @onchange="e => ZetVlagHier(FactuurVlag.Basecone, e)" />
                                <span>Naar Basecone</span>
                                <span class="zij-extra">@Stempel(_factuur.BaseconeOp, "")</span>
                            </label>
                        }
                    </div>

                    <div class="vinkrij">
                        <label class="vinkje">
                            <input type="checkbox" checked="@_factuur.OpHold"
                                   @onchange="e => _factuur.OpHold = Vink(e)" />
                            Betaling op hold
                        </label>
                    </div>

                    @if (!_nieuw)
                    {
                        <p class="uitleg">
                            De vinkjes worden hier direct opgeslagen, net als in de lijst;
                            wie het deed en wanneer wordt meegeschreven.
                        </p>

                        @if (_factuur.Opmerking.Length > 0)
                        {
                            <div class="wn-veld breed">
                                <label>Notities van de app</label>
                                <span class="alleen-lezen">@_factuur.Opmerking</span>
                            </div>
                        }

                    }

                    @* ---------- gekoppelde inkooporders ---------- *@
                    <h3 class="wn-kop">Inkooporders</h3>

                    @if (AlleKoppelingen == 0)
                    {
                        <p class="uitleg">Nog geen inkooporder gekoppeld.</p>
                    }
                    else
                    {
                        <table class="kiezer-tabel">
                            <thead>
                                <tr>
                                    <th style="width:7rem" class="r">Factuurdeel</th>
                                    <th style="width:10rem">PO</th>
                                    <th style="width:7.5rem" class="r">PO-bedrag</th>
                                    <th>Werkorder</th>
                                    <th style="width:2.4rem"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var po in _pos)
                                {
                                    <tr @key="(po.LinkId, _koppelRonde)">
                                        <td class="r">
                                            <input class="r koppelbedrag" value="@po.Bedrag.ToString("0.00", Nl)"
                                                   disabled="@(!MagInvoeren)"
                                                   @onchange="e => KoppelBedragGewijzigd(po, e)" />
                                        </td>
                                        <td>
                                            @* Groen en klikbaar, zoals overal in Access. *@
                                            <button class="po-knop" title="PO bekijken"
                                                    @onclick="() => _bekijkPo = po.OrderId">@po.Nummer</button>
                                        </td>
                                        <td class="r">@Geld(po.PoBedrag)</td>
                                        <td class="omschrijving" title="@(po.Project + " " + po.Werkorder)">
                                            @po.Project @(po.Werkorder.Length > 0 ? "· " + po.Werkorder : "")
                                        </td>
                                        <td class="c">
                                            @if (MagInvoeren)
                                            {
                                                <button class="klein rood" title="Koppeling weghalen"
                                                        @onclick="() => Ontkoppel(po)">✕</button>
                                            }
                                        </td>
                                    </tr>
                                }
                                @foreach (var wacht in _wachtKoppelingen)
                                {
                                    <tr @key="wacht">
                                        <td class="r">@Geld(wacht.Bedrag)</td>
                                        <td>@wacht.Naam</td>
                                        <td class="r"></td>
                                        <td class="zij-extra">
                                            @(wacht.WerkbonId is null
                                                ? "wordt gekoppeld bij het toevoegen"
                                                : "nieuwe PO; wordt aangemaakt bij het toevoegen")
                                        </td>
                                        <td class="c">
                                            <button class="klein rood" title="Weghalen"
                                                    @onclick="() => _wachtKoppelingen.Remove(wacht)">✕</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td class="r"><b>@Geld(GekoppeldTotaal)</b></td>
                                    <td><b>Totaal</b></td>
                                    <td class="r"><b>@Geld(_pos.Sum(p => p.PoBedrag))</b></td>
                                    <td class="zij-extra">
                                        verschil met PO's @Geld(GekoppeldTotaal - _pos.Sum(p => p.PoBedrag))
                                        · nog te verdelen @Geld(KoppelRestant)
                                    </td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    }

                    @if (MagInvoeren)
                    {
                        <div class="btngroup">
                            <button class="klein" disabled="@(!KanKoppelen)" @onclick="() => _koppelOpen = true">
                                ＋ Koppelen aan PO of werkorder
                            </button>
                            @if (_factuur.BedrijfId is null)
                            {
                                <span class="zij-extra">kies eerst een leverancier</span>
                            }
                            else if (!KanKoppelen)
                            {
                                <span class="zij-extra">het bedrag is volledig verdeeld</span>
                            }
                        </div>
                    }

                    </div>

                    @* ---------- rechts: de documenten en het voorbeeld ---------- *@
                    <div class="factuur-rechterkant">
                        @* Slepen werkt doordat het invoerveld doorzichtig over de hele
                           zone ligt; de browser handelt het neerzetten dan zelf af. *@
                        <div class="sleepzone factuur-sleep @(_sleep ? "actief" : "")"
                             @ondragenter="() => _sleep = true"
                             @ondragleave="() => _sleep = false"
                             @ondrop="() => _sleep = false">
                            @if (_uploadBezig)
                            {
                                <text>Bezig met opslaan…</text>
                            }
                            else
                            {
                                <text>
                                    Sleep de factuur hierheen — of klik om te kiezen.
                                    Bijlagen uit de mail mogen er in één keer bij.
                                </text>
                            }
                            <InputFile OnChange="BestandenGekozen" multiple
                                       accept=".pdf,.jpg,.jpeg,.png,.webp,.xlsx,.xls,.docx,.doc,.csv,.xml,.zip"
                                       disabled="@(_lezen || _uploadBezig)" @key="_uploadRonde" />
                        </div>

                        @* Eén lijst: wat al bewaard is én wat net gekozen is. Klikken
                           op een regel zet dat bestand groot in het voorbeeld eronder. *@
                        <div class="factuur-bestanden">
                            @foreach (var doc in _documenten)
                            {
                                <div class="factuur-bestand @(_keuzeDoc == doc.FileStoreId ? "gekozen" : "")"
                                     @key="doc.FileStoreId" @onclick="() => KiesDoc(doc)">
                                    <span class="factuur-bestandnaam" title="@doc.Bestandsnaam">📄 @doc.Bestandsnaam</span>
                                    <span class="zij-extra">@(doc.Toegevoegd?.ToString("dd-MM-yyyy") ?? "")</span>
                                    <a class="knopje" href="@("bestand/" + doc.FileStoreId + "/download")"
                                       title="Downloaden" @onclick:stopPropagation>⭳</a>
                                </div>
                            }
                            @foreach (var best in _gekozen.Where(b => !b.Bewaard))
                            {
                                <div class="factuur-bestand @(_keuzeLos == best ? "gekozen" : "")"
                                     @key="best" @onclick="() => KiesLos(best)">
                                    <span class="factuur-bestandnaam" title="@best.Naam">📄 @best.Naam</span>
                                    <span class="zij-extra">@(best.Inhoud.Length / 1024) kB · nieuw</span>

                                    @if (Lezer.Beschikbaar && best.IsLeesbaar)
                                    {
                                        <button class="klein" disabled="@_lezen" @onclick:stopPropagation
                                                title="@($"De velden vullen met wat er in {best.Naam} staat")"
                                                @onclick="() => Lees(best)">
                                            @(_lezen ? "…" : "✨ uitlezen")
                                        </button>
                                    }
                                    <button class="klein rood" title="Van de lijst halen" @onclick:stopPropagation
                                            @onclick="() => Verwijder(best)">✕</button>
                                </div>
                            }

                            @if (_documenten.Count == 0 && !_gekozen.Any(b => !b.Bewaard))
                            {
                                <span class="zij-extra">Nog geen document.</span>
                            }
                            @if (_gekozen.Any(b => !b.Bewaard))
                            {
                                <span class="zij-extra">
                                    Nog niet opgeslagen; dat gebeurt zodra je de factuur bewaart.
                                </span>
                            }
                        </div>

                        @* ---------- het voorbeeld ---------- *@
                        <div class="factuur-kijker">
                            @if (_keuzeDoc is int kiesId)
                            {
                                var kiesDoc = _documenten.FirstOrDefault(d => d.FileStoreId == kiesId);
                                var soort = SoortVan(kiesDoc?.Bestandsnaam ?? "");
                                if (soort is "pdf" or "office")
                                {
                                    <iframe src="@("voorbeeld/" + kiesId)" title="@(kiesDoc?.Bestandsnaam ?? "")"></iframe>
                                }
                                else if (soort == "afbeelding")
                                {
                                    <img src="@("bestand/" + kiesId)" alt="" />
                                }
                                else
                                {
                                    <p class="uitleg">
                                        Dit bestandstype is hier niet te tonen; gebruik de downloadknop.
                                    </p>
                                }
                            }
                            else if (_keuzeLos is not null)
                            {
                                var soort = SoortVan(_keuzeLos.Naam);
                                if (_losUrl.Length > 0 && soort == "pdf")
                                {
                                    <iframe src="@_losUrl" title="@_keuzeLos.Naam"></iframe>
                                }
                                else if (_losUrl.Length > 0 && soort == "afbeelding")
                                {
                                    <img src="@_losUrl" alt="" />
                                }
                                else if (soort == "office")
                                {
                                    <p class="uitleg">
                                        Word/Excel is pas te tonen nadat de factuur is opgeslagen.
                                    </p>
                                }
                                else
                                {
                                    <p class="uitleg">Dit bestandstype is hier niet te tonen.</p>
                                }
                            }
                            else
                            {
                                <p class="uitleg">
                                    Sleep of kies een document; het verschijnt hier groot in beeld.
                                </p>
                            }
                        </div>
                    </div>
                    </div>
                }
            </div>

            <div class="bijlagevoet">
                <button class="klein" @onclick="Afbreken">Annuleren</button>
                <button class="primair" disabled="@(_bewaren || _bezig)" @onclick="Bewaar">
                    @(_bewaren ? "Bezig…" : _nieuw ? "Toevoegen" : "Opslaan")
                </button>
            </div>
        </div>
    </div>
}

<PoVenster OrderId="_bekijkPo" Sluiten="() => _bekijkPo = null" />

<PoKoppelen Open="_koppelOpen"
            LeverancierId="_factuur.BedrijfId ?? 0"
            LeverancierNaam="@_factuur.Bedrijf"
            Restant="KoppelRestant"
            Factuurnummer="@_factuur.Factuurnummer"
            PoHint="@_poHint"
            Sluiten="() => _koppelOpen = false"
            PoGekozen="PoGekozen"
            WerkorderGekozen="WerkorderGekozen" />

@code {
    private const int StoreTypeFactuur = 1;

    /// <summary>0 = nieuw, een getal = die factuur, null = dicht.</summary>
    [Parameter] public int? FactuurId { get; set; }

    /// <summary>Geeft door of er iets is gewijzigd, zodat de lijst kan verversen.</summary>
    [Parameter] public EventCallback<bool> Sluiten { get; set; }

    /// <summary>
    /// Meldt het id van een zojuist toegevoegde factuur, zodat de ouder weet dat
    /// dit venster niet meer 'nieuw' is. Zonder dat zou de volgende hertekening
    /// het formulier leeggooien en kun je per ongeluk een tweede factuur invoeren.
    /// </summary>
    [Parameter] public EventCallback<int> Toegevoegd { get; set; }

    private Factuur _factuur = new();
    private bool _nieuw;
    private bool _bezig;
