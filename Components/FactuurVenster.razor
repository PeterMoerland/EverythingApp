    /// <summary>Een koppeling die klaarstaat bij een nog niet opgeslagen factuur;
    /// wordt echt gemaakt zodra de factuur is toegevoegd. Bewust een class en
    /// geen record: twee keer hetzelfde bedrag op dezelfde PO zou als record
    /// dezelfde @key opleveren en de rij-rendering laten omvallen.</summary>
    private sealed class WachtKoppeling
    {
        public int? OrderId { get; init; }
        public int? WerkbonId { get; init; }
        public string Naam { get; init; } = "";
        public decimal Bedrag { get; init; }
    }

    private readonly List<WachtKoppeling> _wachtKoppelingen = new();
    private bool _koppelOpen;
    private int? _bekijkPo;

    /// <summary>PO-verwijzing die de AI op de factuur vond; vult het koppelscherm voor.</summary>
    private string _poHint = "";

    /// <summary>Gaat omhoog als een factuurdeel-invoer teruggedraaid moet worden.</summary>
    private int _koppelRonde;

    private int AlleKoppelingen => _pos.Count + _wachtKoppelingen.Count;

    private decimal GekoppeldTotaal => _pos.Sum(p => p.Bedrag) + _wachtKoppelingen.Sum(w => w.Bedrag);

    private decimal KoppelRestant => _factuur.BedragExBtw - GekoppeldTotaal;

    /// <summary>Koppelen kan zolang er iets te verdelen is; bij een creditfactuur
    /// werkt dat gespiegeld. Zelfde grens als Access' Toevoegen-knop.</summary>
    private bool KanKoppelen => _factuur.BedrijfId is not null
        && (_factuur.BedragExBtw < 0 ? KoppelRestant < -0.005m : KoppelRestant > 0.005m);

    /// <summary>
    /// Maakt de wachtende koppelingen echt (de factuur heeft nu een id). Wat
    /// lukt gaat uit de rij; wat misgaat blijft staan en is in de tabel te
    /// zien. Geeft terug of alles gelukt is.
    /// </summary>
    private async Task<bool> VerwerkWachtKoppelingen()
    {
        if (_wachtKoppelingen.Count == 0) return true;

        var allesGelukt = true;
        var holdNodig = false;

        foreach (var wacht in _wachtKoppelingen.ToList())
        {
            try
            {
                if (wacht.OrderId is int poId)
                {
                    if (await Repo.KoppelAsync(_factuur.Id, poId, wacht.Bedrag, Ik.WerknemerId))
                        holdNodig = true;
                }
                else if (wacht.WerkbonId is int wbId && _factuur.BedrijfId is int lev)
                {
                    await Repo.MaakPoEnKoppelAsync(_factuur.Id, _factuur.Factuurnummer, wbId,
                                                   lev, wacht.Bedrag, Ik.WerknemerId);
                }
                _wachtKoppelingen.Remove(wacht);
            }
            catch (Exception ex)
            {
                allesGelukt = false;
                Toon($"Koppelen aan {wacht.Naam} mislukte: {ex.Message}", true);
            }
        }

        // Hing er een PO met geblokkeerde betalingen tussen, dan hoort de
        // factuur op hold — alsnog vastleggen.
        if (holdNodig && !_factuur.OpHold)
        {
            _factuur.OpHold = true;
            try { await Repo.BewaarAsync(_factuur, Ik.WerknemerId); } catch { }
        }

        try { _pos = await Repo.GetPosAsync(_factuur.Id); } catch { }
        return allesGelukt;
    }

    private async Task PoGekozen(PoKoppelen.PoUit uit)
    {
        _koppelOpen = false;

        if (_factuur.Id == 0)
        {
            _wachtKoppelingen.Add(new WachtKoppeling
                { OrderId = uit.OrderId, Naam = uit.Nummer, Bedrag = uit.Bedrag });
            return;
        }

        try
        {
            var geblokkeerd = await Repo.KoppelAsync(_factuur.Id, uit.OrderId, uit.Bedrag, Ik.WerknemerId);
            _erIsGewijzigd = true;
            _pos = await Repo.GetPosAsync(_factuur.Id);

            // Access zette dan het hold-vinkje op het formulier; wij ook, met uitleg.
            if (geblokkeerd && !_factuur.OpHold)
            {
                _factuur.OpHold = true;
                Toon("Gekoppeld. Op deze PO staan betalingen geblokkeerd; 'Betaling op hold' "
                   + "is aangevinkt — vergeet niet op te slaan.", false);
            }
            else Toon("Gekoppeld.", false);
        }
        catch (Exception ex) { Toon("Koppelen mislukt: " + ex.Message, true); }
    }

    private async Task WerkorderGekozen(PoKoppelen.WerkorderUit uit)
    {
        _koppelOpen = false;

        if (_factuur.Id == 0)
        {
            _wachtKoppelingen.Add(new WachtKoppeling
                { WerkbonId = uit.WerkbonId, Naam = uit.Nummer + " (nieuwe PO)", Bedrag = uit.Bedrag });
            return;
        }

        if (_factuur.BedrijfId is not int leverancier)
        {
            Toon("Kies eerst een leverancier.", true);
            return;
        }

        try
        {
            await Repo.MaakPoEnKoppelAsync(_factuur.Id, _factuur.Factuurnummer, uit.WerkbonId,
                                           leverancier, uit.Bedrag, Ik.WerknemerId);
            _erIsGewijzigd = true;
            _pos = await Repo.GetPosAsync(_factuur.Id);
            Toon($"PO aangemaakt onder {uit.Nummer} en gekoppeld.", false);
        }
        catch (Exception ex) { Toon("PO aanmaken mislukt: " + ex.Message, true); }
    }

    private async Task Ontkoppel(FactuurPo po)
    {
        try
        {
            // Een PO die destijds automatisch uit déze factuur is ontstaan en
            // waar verder niets aan hangt, gaat mee weg — anders blijft er een
            // lege spook-PO achter. Een echte PO blijft altijd staan.
            var eigen = await Repo.IsEigenAutoPoAsync(po.OrderId, _factuur.Id);
            var vraag = eigen
                ? $"Koppeling met {po.Nummer} weghalen? Deze PO is automatisch vanuit deze "
                  + "factuur aangemaakt en wordt dan ook verwijderd."
                : $"Koppeling met {po.Nummer} weghalen? De PO zelf blijft bestaan.";
            if (!await Vraag(vraag)) return;

            await Repo.OntkoppelAsync(po.LinkId, eigen);
            _erIsGewijzigd = true;
            _pos = await Repo.GetPosAsync(_factuur.Id);
            Toon("Koppeling weggehaald.", false);
        }
        catch (Exception ex) { Toon("Weghalen mislukt: " + ex.Message, true); }
    }

    private async Task KoppelBedragGewijzigd(FactuurPo po, ChangeEventArgs e)
    {
        var tekst = ((string?)e.Value ?? "").Trim();
        if (Getal(tekst) is not decimal bedrag)
        {
            _koppelRonde++;
            Toon($"'{tekst}' is geen bedrag; het oude bedrag staat er nog.", true);
            return;
        }

        // Samen nooit meer (of bij credit: minder) verdelen dan de factuur groot is.
        var anderen = GekoppeldTotaal - po.Bedrag;
        var teVeel = _factuur.BedragExBtw >= 0
            ? bedrag <= 0 || anderen + bedrag > _factuur.BedragExBtw + 0.005m
            : bedrag >= 0 || anderen + bedrag < _factuur.BedragExBtw - 0.005m;
        if (teVeel)
        {
            _koppelRonde++;
            Toon("Zo wordt er meer verdeeld dan het factuurbedrag; het oude bedrag staat er nog.", true);
            return;
        }

        try
        {
            await Repo.ZetKoppelBedragAsync(po.LinkId, bedrag, Ik.WerknemerId);
            po.Bedrag = bedrag;
            _erIsGewijzigd = true;
            Toon("Opgeslagen.", false);
        }
        catch (Exception ex)
        {
            _koppelRonde++;
            Toon("Opslaan mislukt: " + ex.Message, true);
        }
    }

