    /// <summary>Roept elke seconde de meegegeven actie aan zolang hij bestaat;
    /// houdt de secondeteller van de voortgangsbalk bij de tijd.</summary>
    private sealed class Tikker : IAsyncDisposable
    {
        private readonly System.Threading.Timer _timer;
        public Tikker(Action tik) => _timer = new System.Threading.Timer(
            _ => tik(), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        public ValueTask DisposeAsync() => _timer.DisposeAsync();
    }

