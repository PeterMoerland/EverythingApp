    protected override async Task OnParametersSetAsync()
    {
        if (FactuurId == _geladenVoor) return;
        _geladenVoor = FactuurId;

        // Alles van de vorige factuur weg. Het venster blijft namelijk bestaan
        // tussen twee facturen; zonder dit opruimen zou een eerder gekozen PDF
        // aan de volgende factuur gehangen worden.
        _melding = null;
        _leveranciers = new();
        _leverancierZoek = "";
        _bankWaarschuwing = "";
        _erIsGewijzigd = false;
        _gekozen.Clear();
        _sleep = false;
        _zoekOpen = false;
        _aliasVraag = "";
        _ibanUitRelaties = "";
        _aiOpmerkingen = new();
        _automatisch.Clear();
        _uploadRonde++;
        _keuzeDoc = null;
        _keuzeLos = null;
        await WisLosUrl();
        _wachtKoppelingen.Clear();
        _koppelOpen = false;
        _bekijkPo = null;
        _poHint = "";

        // Ook de factuur zelf en wat erbij hoort meteen leegmaken. Zou het
        // ophalen hieronder mislukken, dan stonden anders de gegevens en
        // documenten van de vórige factuur nog in beeld — en zou Opslaan
        // die onder het oude id wegschrijven.
        _factuur = new();
        _documenten = new();
        _pos = new();

        if (FactuurId is null) return;

        _bezig = true;
        try
        {
            if (_administraties.Count == 0)
                _administraties = await Repo.GetAdministratiesAsync();

            _nieuw = FactuurId == 0;
            if (_nieuw)
            {
                _factuur = new Factuur
                {
                    Factuurdatum = DateOnly.FromDateTime(DateTime.Today),
                    Betalingstermijn = 30,
                    Doorbelasten = 100,
                };
                _pos = new();
                _documenten = new();
            }
            else
            {
                _factuur = await Repo.GetAsync(FactuurId.Value) ?? new Factuur();
                try { _pos = await Repo.GetPosAsync(FactuurId.Value); } catch { _pos = new(); }
                await LaadDocumenten();
                await ControleerBank();     // ook bij openen: mist er een IBAN?
            }

            ZetBedragen();
            _zoalsGeopend = Vingerafdruk();
        }
        catch (Exception ex) { Toon("Ophalen mislukt: " + ex.Message, true); }
        finally { _bezig = false; }
    }

    private async Task LaadDocumenten()
    {
        if (!WnRepo.Beschikbaar || _factuur.Id == 0) return;
        try { _documenten = await WnRepo.GetBestandenAsync(StoreTypeFactuur, _factuur.Id); }
        catch { _documenten = new(); }

        // Het voorbeeld meebewegen: een zojuist bewaard bestand staat nu in de
        // documentenlijst, dus daar de keuze op zetten. En zonder keuze pakt
        // het voorbeeld het eerste document — meestal is er toch maar één.
        if (_keuzeLos is { Bewaard: true } net)
        {
            _keuzeLos = null;
            await WisLosUrl();
            // De lijst staat nieuwste-eerst, dus First pakt het net bewaarde exemplaar.
            _keuzeDoc = _documenten
                .FirstOrDefault(d => d.Bestandsnaam.Equals(net.Naam, StringComparison.OrdinalIgnoreCase))
                ?.FileStoreId;
        }
        if (_keuzeDoc is int k && _documenten.All(d => d.FileStoreId != k)) _keuzeDoc = null;
        if (_keuzeDoc is null && _keuzeLos is null && _documenten.Count > 0)
            _keuzeDoc = _documenten[0].FileStoreId;
    }

    // ============================================================
    //  Bedragen: drie velden die elkaar bijwerken
    //  Access rekende op basis van wat het laatst is ingevuld. Dat houden we aan:
    //  vul je het bedrag in, dan volgt de btw; vul je het totaal in, dan volgt de rest.
    // ============================================================
    private void ZetBedragen()
    {
        _exInvoer = _factuur.BedragExBtw == 0 ? "" : _factuur.BedragExBtw.ToString("0.00", Nl);
        _btwInvoer = _factuur.Btw == 0 ? "" : _factuur.Btw.ToString("0.00", Nl);
        _totaalInvoer = _factuur.Totaal == 0 ? "" : _factuur.Totaal.ToString("0.00", Nl);
        Controleer();
    }

    private void OmschrijvingGewijzigd(ChangeEventArgs e)
    {
        _factuur.Omschrijving = Tekst(e);
        Handmatig("Omschrijving");
    }

    private void ExGewijzigd(ChangeEventArgs e)
    {
        Handmatig("BedragExBtw");
        _exInvoer = ((string?)e.Value ?? "").Trim();
        if (Getal(_exInvoer) is decimal ex)
        {
            _factuur.BedragExBtw = ex;
            _totaalInvoer = (ex + _factuur.Btw).ToString("0.00", Nl);
        }
        else if (_exInvoer.Length == 0) _factuur.BedragExBtw = 0;
        Controleer();
    }

    private void BtwGewijzigd(ChangeEventArgs e)
    {
        Handmatig("Btw");
        _btwInvoer = ((string?)e.Value ?? "").Trim();
        if (Getal(_btwInvoer) is decimal btw)
        {
            _factuur.Btw = btw;
            _totaalInvoer = (_factuur.BedragExBtw + btw).ToString("0.00", Nl);
        }
        else if (_btwInvoer.Length == 0) _factuur.Btw = 0;
        Controleer();
    }

    /// <summary>
    /// Totaal ingevuld. Wat er al staat blijft staan: is het bedrag bekend, dan is
    /// het verschil de btw; is de btw bekend, dan is het verschil het bedrag. Pas
    /// als er nog niets is, rekenen we met 21% terug — het gangbare tarief.
    /// </summary>
    private void TotaalGewijzigd(ChangeEventArgs e)
    {
        // Het totaal aanpassen herrekent bedrag of btw; die zijn dan niet meer
        // 'door de computer ingevuld'.
        Handmatig("BedragExBtw");
        Handmatig("Btw");
        _totaalInvoer = ((string?)e.Value ?? "").Trim();
        if (Getal(_totaalInvoer) is decimal totaal)
        {
            if (_factuur.BedragExBtw != 0)
            {
                _factuur.Btw = Math.Round(totaal - _factuur.BedragExBtw, 2);
                _btwInvoer = _factuur.Btw.ToString("0.00", Nl);
            }
            else if (_factuur.Btw != 0)
            {
                _factuur.BedragExBtw = Math.Round(totaal - _factuur.Btw, 2);
                _exInvoer = _factuur.BedragExBtw.ToString("0.00", Nl);
            }
            else
            {
                _factuur.BedragExBtw = Math.Round(totaal / 1.21m, 2);
                _factuur.Btw = Math.Round(totaal - _factuur.BedragExBtw, 2);
                _exInvoer = _factuur.BedragExBtw.ToString("0.00", Nl);
                _btwInvoer = _factuur.Btw.ToString("0.00", Nl);
            }
        }
        Controleer();
    }

    /// <summary>Btw uitrekenen over het bedrag met dit tarief.</summary>
    private void ZetTarief(int procent)
    {
        Handmatig("Btw");
        _factuur.Btw = Math.Round(_factuur.BedragExBtw * procent / 100m, 2);
        _btwInvoer = _factuur.Btw.ToString("0.00", Nl);
        _totaalInvoer = _factuur.Totaal.ToString("0.00", Nl);
        Controleer();
    }

    /// <summary>
    /// Access controleerde met een timer of ex + btw wel gelijk was aan het totaal.
    /// Hier gebeurt dat meteen bij het typen.
    /// </summary>
    private void Controleer()
    {
        // Eerst: staat er ergens iets wat geen bedrag is? Dan zou er stilletjes een
        // oude waarde bewaard worden terwijl het scherm iets anders toont.
        var onleesbaar = new List<string>();
        if (_exInvoer.Length > 0 && Getal(_exInvoer) is null) onleesbaar.Add("het bedrag");
        if (_btwInvoer.Length > 0 && Getal(_btwInvoer) is null) onleesbaar.Add("de btw");
        if (_totaalInvoer.Length > 0 && Getal(_totaalInvoer) is null) onleesbaar.Add("het totaal");

        if (onleesbaar.Count > 0)
        {
            _optellingFout = $"Ik kan {string.Join(" en ", onleesbaar)} niet lezen als bedrag.";
            return;
        }

        var getypt = Getal(_totaalInvoer);
        _optellingFout = getypt is decimal t && Math.Abs(_factuur.Totaal - t) >= 0.01m
            ? $"De optelling klopt niet: {Geld(_factuur.BedragExBtw)} + {Geld(_factuur.Btw)} "
              + $"is {Geld(_factuur.Totaal)}, niet {Geld(t)}."
            : "";
    }

    /// <summary>
    /// Een bedrag uit een invoerveld. Nederlandse notatie is de norm ("1.250,00"),
    /// maar geplakte tekst uit een PDF staat er soms Engels in ("1,250.00").
    /// Het láátste scheidingsteken is het decimaalteken; de rest is duizendtal.
    ///
    /// Blind de punt door een komma vervangen zou fataal zijn: van "1.250" wordt
    /// dan € 1,25 in plaats van € 1250.
    /// </summary>
    private static decimal? Getal(string tekst)
    {
        var s = tekst.Replace("€", "").Replace(" ", "").Replace(" ", "").Trim();
        if (s.Length == 0) return null;

        int komma = s.LastIndexOf(','), punt = s.LastIndexOf('.');

        if (komma >= 0 && punt >= 0)
            s = komma > punt ? s.Replace(".", "").Replace(',', '.')    // 1.250,00
                             : s.Replace(",", "");                      // 1,250.00
        else if (komma >= 0) s = s.Replace(',', '.');
        else if (punt >= 0)
        {
            // Alleen een punt: decimaalteken als er twee cijfers achter staan
            // ("12.50"), anders een duizendtalscheiding ("1.250").
            var achter = s.Length - punt - 1;
            if (achter == 3 && s.Count(c => c == '.') >= 1 && punt > 0) s = s.Replace(".", "");
        }

        return decimal.TryParse(s,
            System.Globalization.NumberStyles.AllowLeadingSign |
            System.Globalization.NumberStyles.AllowDecimalPoint,
            System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : null;
    }

