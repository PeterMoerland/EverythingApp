    private void AdminGewijzigd(ChangeEventArgs e)
        => _factuur.AdministratieId = int.TryParse((string?)e.Value, out var v) ? v : null;

    private void DatumGewijzigd(DateOnly? datum)
    {
        Handmatig("Factuurdatum");
        _factuur.Factuurdatum = datum;
    }

    private void TermijnGewijzigd(ChangeEventArgs e)
    {
        Handmatig("Betalingstermijn");
        if (int.TryParse((string?)e.Value, out var v) && v >= 0) _factuur.Betalingstermijn = v;
    }

    private void ZetTermijn(int dagen)
    {
        Handmatig("Betalingstermijn");
        _factuur.Betalingstermijn = dagen;
    }

    private void DoorbelastenGewijzigd(ChangeEventArgs e)
    {
        var tekst = ((string?)e.Value ?? "").Replace('.', ',').Trim();
        if (double.TryParse(tekst, System.Globalization.NumberStyles.Any, Nl, out var v))
            _factuur.Doorbelasten = Math.Clamp(v, 0, 100);
    }

    /// <summary>
    /// SEPA laat alleen gewone tekens toe in het factuurnummer; dat controleerde
    /// Access ook, want anders klapt de betaalopdracht er later op.
    /// </summary>
    private void FactuurnummerGewijzigd(ChangeEventArgs e)
    {
        Handmatig("Factuurnummer");
        var waarde = Tekst(e);
        var vreemd = waarde.Where(c => c < 32 || c > 126).Distinct().ToArray();

        if (vreemd.Length > 0)
        {
            waarde = new string(waarde.Where(c => c >= 32 && c <= 126).ToArray());
            Toon($"De tekens {string.Join(" ", vreemd)} zijn uit het factuurnummer gehaald: "
               + "SEPA staat die niet toe.", true);
        }
        _factuur.Factuurnummer = waarde;
    }

    // ---- leverancier ----
    private async Task LeverancierZoekGewijzigd(ChangeEventArgs e)
    {
        _leverancierZoek = (string?)e.Value ?? "";
        var zoek = _leverancierZoek.Trim();

        if (zoek.Length < 2) { _leveranciers = new(); return; }

        try
        {
            _leveranciers = await Relaties.ZoekAsync(zoek, false, true, 0, 15);

            // Ziet het eruit als een rekeningnummer? Dan daar ook op proberen; dat
            // is de kortste weg naar de juiste leverancier.
            if (_leveranciers.Count == 0 && zoek.Replace(" ", "").Length >= 15)
            {
                var opIban = await Repo.ZoekOpIbanAsync(zoek);
                if (opIban is not null)
                    _leveranciers = new List<Keuze> { new(opIban.Value.Id, opIban.Value.Naam) };
            }
        }
        catch { _leveranciers = new(); }
    }

    private async Task KiesLeverancier(Keuze l)
    {
        Handmatig("Leverancier");

        // Stond er een andere naam op de factuur? Dan is dit het moment om te
        // vragen of de app dat verband mag onthouden.
        var opFactuur = _leverancierZoek.Trim();
        _aliasVraag = opFactuur.Length >= 3 && !Gelijk(opFactuur, l.Naam) ? opFactuur : "";

        // Andere leverancier? Dan slaan wachtende PO-koppelingen nergens meer
        // op — die PO's horen bij de vórige leverancier.
        if (_factuur.BedrijfId != l.Id) WisWachtPos();

        _factuur.BedrijfId = l.Id;
        _factuur.Bedrijf = l.Naam;
        _leveranciers = new();
        _leverancierZoek = "";
        _zoekOpen = false;

        await ControleerBank();
    }

    /// <summary>Haalt wachtende PO-koppelingen weg na een leverancierwissel
    /// (werkorder-koppelingen mogen blijven: die PO wordt pas straks, onder de
    /// nieuwe leverancier, aangemaakt).</summary>
    private void WisWachtPos()
    {
        var weg = _wachtKoppelingen.RemoveAll(w => w.OrderId is not null);
        if (weg > 0)
            Toon($"{weg} wachtende PO-koppeling(en) vervallen: die PO's horen bij de "
               + "vorige leverancier.", true);
    }

    /// <summary>
    /// Zonder IBAN en BIC kan de factuur straks niet betaald worden. Access weigerde
    /// dan te bewaren; hier waarschuwen we, want de factuur mag wel bestaan.
    /// </summary>
    /// <summary>De IBAN die bij de leverancier in Relaties staat, voor de vergelijking.</summary>
    private string _ibanUitRelaties = "";

    /// <summary>
    /// Vergelijkt de IBAN op de factuur met die bij de leverancier. Wijkt hij af,
    /// dan is dat het klassieke teken van een omgeleide betaling — of gewoon een
    /// nieuwe rekening, maar dat wil je zelf vaststellen.
    /// </summary>
    private void ControleerIban(FactuurUitPdf uit)
    {
        if (uit.Iban.Length == 0 || _ibanUitRelaties.Length == 0) return;

        var opFactuur = uit.Iban.Replace(" ", "").ToUpperInvariant();
        var bekend = _ibanUitRelaties.Replace(" ", "").ToUpperInvariant();

        if (opFactuur != bekend)
            uit.Opmerkingen.Add($"LET OP: op de factuur staat {opFactuur}, maar bij deze "
                              + $"leverancier staat {bekend}. Controleer dit vóór je betaalt — "
                              + "een gewijzigd rekeningnummer is de bekendste vorm van factuurfraude.");
    }

    private async Task ControleerBank()
    {
        _bankWaarschuwing = "";
        if (_factuur.BedrijfId is null || _factuur.Betaald) return;

        try
        {
            var (iban, bic) = await Repo.GetBankgegevensAsync(_factuur.BedrijfId.Value);
            _ibanUitRelaties = iban;

            var mist = new List<string>();
            if (iban.Length == 0) mist.Add("IBAN");
            if (bic.Length == 0) mist.Add("BIC");

            if (mist.Count > 0)
                _bankWaarschuwing = $"Van deze leverancier ontbreekt {string.Join(" en ", mist)}. "
                                  + "Vul dat aan bij Relaties, anders kan de betaling niet klaargezet worden.";
        }
        catch { }
    }

    // ---- opslaan ----
    private bool MagInvoeren => Ik.Mag("Financial") || Ik.Mag("Directie");

    private async Task Bewaar()
    {
        if (!MagInvoeren)
        {
            Toon("Je hebt geen recht om facturen in te voeren of te wijzigen.", true);
            return;
        }

        var fouten = new List<string>();
        if (_factuur.AdministratieId is null) fouten.Add("kies een administratie");
        if (_factuur.BedrijfId is null) fouten.Add("kies een leverancier");
        if (_factuur.Factuurdatum is null) fouten.Add("vul de factuurdatum in");
        if (_factuur.BedragExBtw == 0 && _factuur.Btw == 0) fouten.Add("vul een bedrag in");
        if (_factuur.Factuurnummer.Trim().Length == 0) fouten.Add("vul het factuurnummer in");

        // Liever een melding dan stilletjes afkappen: een half factuurnummer maakt
        // de betaling straks onherkenbaar voor de leverancier.
        if (_factuur.Factuurnummer.Length > 45)
            fouten.Add($"het factuurnummer is {_factuur.Factuurnummer.Length} tekens, er passen er 45");
        if (_factuur.Omschrijving.Length > 100)
            fouten.Add($"de omschrijving is {_factuur.Omschrijving.Length} tekens, er passen er 100");

        if (fouten.Count > 0)
        {
            Toon("Nog even: " + string.Join(", ", fouten) + ".", true);
            return;
        }

        if (_optellingFout.Length > 0)
        {
            Toon(_optellingFout, true);
            return;
        }

        // Dubbele invoer is de klassieke fout: zelfde dag, zelfde leverancier, zelfde bedrag.
        try
        {
            if (await Repo.BestaatAlAsync(_factuur.Factuurdatum, _factuur.BedrijfId,
                                          _factuur.BedragExBtw, _factuur.Id))
            {
                var door = await Vraag("Er staat al een factuur met dezelfde datum, leverancier en "
                                     + "bedrag. Toch opslaan?");
                if (!door) return;
            }
        }
        catch { }

        _bewaren = true;
        try
        {
            var id = await Repo.BewaarAsync(_factuur, Ik.WerknemerId);
            _erIsGewijzigd = true;

            if (_nieuw)
            {
                _factuur.Id = id;
                _nieuw = false;
                _geladenVoor = id;
                await Toegevoegd.InvokeAsync(id);

                // Vooraf aangevinkte vlaggen (een factuur die al betaald of
                // goedgekeurd binnenkwam) nu echt zetten, mét wie en wanneer.
                var vlagFout = false;
                try
                {
                    if (_factuur.Goedgekeurd)
                        await Repo.ZetVlagAsync(id, FactuurVlag.Goedgekeurd, true, Ik.WerknemerId);
                    if (_factuur.Betaald)
                        await Repo.ZetVlagAsync(id, FactuurVlag.Betaald, true, Ik.WerknemerId);
                }
                catch (Exception ex)
                {
                    vlagFout = true;
                    Toon("De factuur is toegevoegd, maar het vinkje zetten mislukte: "
                       + ex.Message + " Zet het alsnog in de lijst.", true);
                }

                var koppelFout = !await VerwerkWachtKoppelingen();

                // De gekozen bestanden hingen nog in het geheugen; nu is er een id
                // om ze aan te hangen.
                await BewaarBestanden();

                // Pas nu de meetlat leggen: alles wat verwerkt is telt niet meer
                // als te verliezen werk, wat bleef staan juist wel.
                _zoalsGeopend = Vingerafdruk();

                // Ging alles goed, dan is het venster klaar en gaat het dicht; de
                // lijst eronder toont de nieuwe factuur. Bleef er een bestand
                // liggen (of een vinkje of koppeling), dan blijft het venster staan.
                if (_gekozen.All(b => b.Bewaard) && !vlagFout && !koppelFout)
                {
                    await Sluiten.InvokeAsync(true);
                    return;
                }

                await LaadDocumenten();
                // Alleen over de bestanden beginnen als dáár iets bleef liggen;
                // anders zou deze melding de echte fout hierboven overschrijven.
                if (_gekozen.Any(b => !b.Bewaard))
                    Toon($"De factuur is toegevoegd, maar {_gekozen.Count(b => !b.Bewaard)} "
                       + "bestand(en) zijn nog niet opgeslagen. Probeer het nog eens.", true);
            }
            else
            {
                // Ook hier: bestanden die er nog los bij hangen (bijvoorbeeld omdat
                // het opslaan bij het kiezen misging) alsnog wegschrijven — de
                // lijst belooft immers "dat gebeurt zodra je de factuur bewaart".
                // En koppelingen die na een eerdere mislukking bleven staan, gaan
                // hier ook alsnog mee.
                var koppelFout = !await VerwerkWachtKoppelingen();
                await BewaarBestanden();
                _zoalsGeopend = Vingerafdruk();

                // Alles netjes weggeschreven? Dan is het venster klaar en gaat het
                // dicht, net als bij toevoegen. Bleef er iets liggen, dan blijft
                // het staan zodat je het kunt oplossen.
                if (!koppelFout && _gekozen.All(b => b.Bewaard))
                {
                    await Sluiten.InvokeAsync(true);
                    return;
                }

                if (!koppelFout)
                    Toon($"Opgeslagen, maar {_gekozen.Count(b => !b.Bewaard)} bestand(en) "
                       + "zijn nog niet in de filestore beland. Probeer het nog eens.", true);
            }
        }
        catch (Exception ex) { Toon("Opslaan mislukt: " + ex.Message, true); }
        finally { _bewaren = false; }
    }

    // ============================================================
    //  De factuur erbij, en laten uitlezen
    //
    //  Het bestand blijft eerst in het geheugen. Zo kun je een nieuwe factuur
    //  laten uitlezen vóórdat er iets is opgeslagen; bij het opslaan gaat het
    //  bestand mee naar de filestore.
    // ============================================================
    private async Task BestandenGekozen(InputFileChangeEventArgs e)
    {
        _sleep = false;

        if (!MagInvoeren)
        {
            Toon("Je hebt geen recht om documenten aan facturen te hangen.", true);
            return;
        }

        var fouten = new List<string>();
        var erbij = 0;

        // Meerdere bestanden tegelijk: de factuur en de bijlagen uit de mail.
        // Meer dan 20 zou GetMultipleFiles laten ontploffen; dan liever een melding.
        if (e.FileCount > 20)
        {
            Toon($"Dat zijn er {e.FileCount}; maximaal 20 tegelijk.", true);
            _uploadRonde++;
            return;
        }

        foreach (var bestand in e.GetMultipleFiles(20))
        {
            // Zelf op grootte controleren geeft een leesbare melding; de grens van
            // de leesstroom gooit een Engelse fout met bytes erin.
            var grens = Afbeelding(bestand.Name) ? 5_000_000 : 25_000_000;
            if (bestand.Size > grens)
            {
                fouten.Add($"{bestand.Name} is {bestand.Size / 1024.0 / 1024.0:0.#} MB "
                         + $"(maximaal {grens / 1_000_000} MB)");
                continue;
            }

            if (_gekozen.Any(b => b.Naam.Equals(bestand.Name, StringComparison.OrdinalIgnoreCase)))
            {
                fouten.Add($"{bestand.Name} stond er al bij");
                continue;
            }

            try
            {
                using var geheugen = new MemoryStream();
                await bestand.OpenReadStream(maxAllowedSize: grens).CopyToAsync(geheugen);

                _gekozen.Add(new GekozenBestand { Naam = bestand.Name, Inhoud = geheugen.ToArray() });
                erbij++;
            }
            catch (Exception ex) { fouten.Add($"{bestand.Name}: {ex.Message}"); }
        }

        _uploadRonde++;

        // Staat de factuur al in de database? Dan hangen de bestanden er meteen
        // aan; het voorbeeld pakt het bewaarde document dan vanzelf op. Eerst
        // een geheugen-voorbeeld maken zou de bytes voor niets naar de browser
        // sturen.
        if (_factuur.Id != 0 && erbij > 0) await BewaarBestanden();

        // Het zojuist gekozen bestand meteen groot in beeld; meestal is dat
        // de factuur zelf, en die wil je naast de velden zien.
        if (erbij > 0 && _gekozen.LastOrDefault(b => !b.Bewaard) is { } nieuwste)
            await KiesLos(nieuwste);
        else if (erbij > 0 && _documenten.Count > 0)
            _keuzeDoc = _documenten[0].FileStoreId;   // net bewaard; nieuwste staat voorop

        if (fouten.Count > 0) Toon("Niet meegenomen: " + string.Join("; ", fouten) + ".", true);
        else if (erbij > 0 && _factuur.Id == 0)
            Toon(erbij == 1 ? "Bestand klaargezet." : $"{erbij} bestanden klaargezet.", false);
    }

    private async Task Verwijder(GekozenBestand best)
    {
        _gekozen.Remove(best);
        _uploadRonde++;

        // Stond dit bestand in het voorbeeld? Dan door naar het eerste document,
        // of anders naar een ander nog los bestand.
        if (_keuzeLos == best)
        {
            _keuzeLos = null;
            await WisLosUrl();
            if (_documenten.Count > 0) _keuzeDoc = _documenten[0].FileStoreId;
            else if (_gekozen.FirstOrDefault(b => !b.Bewaard) is { } ander) await KiesLos(ander);
        }
    }

    /// <summary>
    /// Laat de AI de factuur lezen en vult de velden in. Er wordt niets opgeslagen:
    /// jij kijkt ernaar en drukt daarna zelf op opslaan.
    /// </summary>
    private static bool Afbeelding(string naam)
        => Path.GetExtension(naam).ToLowerInvariant() is ".jpg" or ".jpeg" or ".png" or ".webp" or ".gif";

    private async Task Lees(GekozenBestand best)
    {
        // Twee keer klikken zou twee keer werk kosten en de velden door elkaar zetten.
        if (_lezen) return;

        if (!MagInvoeren)
        {
            Toon("Je hebt geen recht om facturen te laten uitlezen.", true);
            return;
        }

        _lezen = true;
        _aiOpmerkingen = new();
        _leesStand = "voorbereiden…";
        _leesBestand = best.Naam;
        _leesStart = DateTime.Now;
        await KiesLos(best);    // wat gelezen wordt, staat ook in het voorbeeld
        StateHasChanged();      // de voortgangsbalk meteen in beeld

        // De lezer meldt zijn fases; het tikkertje ververst elke seconde de
        // teller, zodat zichtbaar blijft dat er echt gewerkt wordt.
        var voortgang = new Progress<string>(stand =>
        {
            _leesStand = stand;
            _ = InvokeAsync(StateHasChanged);
        });
        await using var tikker = new Tikker(() => _ = InvokeAsync(StateHasChanged));

        try
        {
            var (uit, fout) = await Lezer.LeesAsync(best.Inhoud, best.Naam, voortgang);
            if (uit is null) { Toon(fout, true); return; }

            NeemOver(uit);
            await ZoekLeverancier(uit);

            // Vond de AI een PO-verwijzing, dan zoekt het koppelscherm daar
            // straks alvast op voor.
            _poHint = uit.PoNummer;

            _aiOpmerkingen = uit.Opmerkingen;
            Toon(_automatisch.Count == 0
                ? $"Er is niets bruikbaars uit de factuur gekomen ({uit.Bron}); vul hem met de hand in."
                : $"{_automatisch.Count} velden ingevuld ({uit.Bron}) — controleer ze even; "
                  + "ze staan geel.", false);
        }
        catch (Exception ex) { Toon("Uitlezen mislukt: " + ex.Message, true); }
        finally { _lezen = false; }
    }

    /// <summary>Zet over wat er gevonden is. Wie op uitlezen drukt, vraagt om de
    /// waarden uit het document — die vervangen dus wat er stond; alles wat de
    /// AI invulde kleurt geel zodat het te controleren is.</summary>
    private void NeemOver(FactuurUitPdf uit)
    {
        _automatisch.Clear();

        if (uit.Factuurdatum is not null)
        {
            _factuur.Factuurdatum = uit.Factuurdatum;
            _automatisch.Add("Factuurdatum");
        }
        if (uit.Factuurnummer.Length > 0)
        {
            _factuur.Factuurnummer = uit.Factuurnummer;
            _automatisch.Add("Factuurnummer");
        }
        if (uit.Omschrijving.Length > 0)
        {
            _factuur.Omschrijving = uit.Omschrijving.Length > 100
                ? uit.Omschrijving[..100] : uit.Omschrijving;
            _automatisch.Add("Omschrijving");
        }
        if (uit.Betalingstermijn is int dagen)
        {
            _factuur.Betalingstermijn = dagen;
            _automatisch.Add("Betalingstermijn");
        }

        // Bedragen: het bedrag en de btw zijn leidend; klopt het totaal daar niet
        // mee, dan zegt de controleregel dat vanzelf.
        if (uit.BedragExBtw is decimal ex)
        {
            _factuur.BedragExBtw = ex;
            _automatisch.Add("BedragExBtw");
        }
        if (uit.Btw is decimal btw)
        {
            _factuur.Btw = btw;
            _automatisch.Add("Btw");
        }
        else if (uit.BedragExBtw is decimal e2 && uit.Totaal is decimal t2)
        {
            _factuur.Btw = Math.Round(t2 - e2, 2);
            _automatisch.Add("Btw");
        }
        else if (uit.Totaal is decimal t3)
        {
            // Alleen een totaal: dat is het normale geval bij een kassabon. Met 21%
            // terugrekenen en dat er duidelijk bij zeggen, want het tarief kan 9 zijn.
            _factuur.BedragExBtw = Math.Round(t3 / 1.21m, 2);
            _factuur.Btw = Math.Round(t3 - _factuur.BedragExBtw, 2);
            _automatisch.Add("BedragExBtw");
            _automatisch.Add("Btw");
            uit.Opmerkingen.Add($"Op de bon stond alleen het totaal ({t3:0.00}). Bedrag en btw "
                              + "zijn met 21% teruggerekend — controleer of dat tarief klopt.");
        }

        ZetBedragen();
    }

    /// <summary>
    /// Zoekt de leverancier op naam bij Relaties. Eén treffer koppelen we meteen;
    /// bij meer laten we de keuze staan, want de verkeerde leverancier is erger
    /// dan zelf even kiezen.
    /// </summary>
    /// <summary>
    /// Zoekt de leverancier op, in de volgorde van betrouwbaar naar minder:
    ///
    ///   1. een eerder gekoppelde naam uit de aliastabel — die heeft iemand zelf
    ///      goedgekeurd, dus daar is geen twijfel over;
    ///   2. het rekeningnummer — dat verandert niet als een bedrijf van naam wisselt;
    ///   3. de naam zoeken in de relaties.
    ///
    /// Blijft er twijfel, dan zetten we de zoeklijst open in plaats van te kiezen.
    /// De verkeerde leverancier is erger dan zelf even klikken.
    /// </summary>
    private async Task ZoekLeverancier(FactuurUitPdf uit)
    {
        if (_factuur.BedrijfId is not null) return;

        try
        {
            // 1. Kennen we deze naam al?
            if (uit.Leverancier.Length > 0)
            {
                var alias = await Repo.ZoekOpAliasAsync(uit.Leverancier);
                if (alias is not null)
                {
                    await ZetLeverancier(alias.Value.Id, alias.Value.Naam, uit);
                    uit.Opmerkingen.Add($"'{uit.Leverancier}' is eerder gekoppeld aan "
                                      + $"'{alias.Value.Naam}'; die is genomen.");
                    return;
                }
            }

            // 2. Het rekeningnummer is betrouwbaarder dan een naam.
            if (uit.Iban.Length > 0)
            {
                var opIban = await Repo.ZoekOpIbanAsync(uit.Iban);
                if (opIban is not null)
                {
                    await ZetLeverancier(opIban.Value.Id, opIban.Value.Naam, uit);
                    uit.Opmerkingen.Add($"Gevonden op het rekeningnummer: '{opIban.Value.Naam}'. "
                                      + $"Op de factuur staat de naam '{uit.Leverancier}'.");

                    // Naam wijkt af? Dan is dit precies het geval om te onthouden.
                    if (uit.Leverancier.Length > 0
                        && !Gelijk(uit.Leverancier, opIban.Value.Naam)) _aliasVraag = uit.Leverancier;
                    return;
                }
            }

            if (uit.Leverancier.Length == 0) return;

            // 3. Op naam zoeken.
            var gevonden = await Relaties.ZoekAsync(uit.Leverancier, false, true, 0, 10);

            if (gevonden.Count == 1)
            {
                await ZetLeverancier(gevonden[0].Id, gevonden[0].Naam, uit);
                uit.Opmerkingen.Add($"Leverancier gekoppeld aan '{gevonden[0].Naam}' op basis van "
                                  + $"'{uit.Leverancier}' op de factuur. Klopt dat?");

                if (!Gelijk(uit.Leverancier, gevonden[0].Naam)) _aliasVraag = uit.Leverancier;
            }
            else
            {
                // Niets of meerdere treffers: laat de gebruiker kiezen, met de naam
                // van de factuur al ingevuld en de zoeklijst open.
                _leveranciers = gevonden;
                _leverancierZoek = uit.Leverancier;
                _zoekOpen = true;
                _aliasVraag = "";

                uit.Opmerkingen.Add(gevonden.Count == 0
                    ? $"'{uit.Leverancier}' staat niet onder die naam bij Relaties. Zoek hem op — "
                      + "na je keuze kan de app de naam onthouden voor de volgende keer."
                    : $"Er zijn {gevonden.Count} leveranciers die op '{uit.Leverancier}' lijken; "
                      + "kies de juiste.");
            }
        }
        catch { }
    }

    private async Task ZetLeverancier(int id, string naam, FactuurUitPdf uit)
    {
        if (_factuur.BedrijfId != id) WisWachtPos();
        _factuur.BedrijfId = id;
        _factuur.Bedrijf = naam;
        _automatisch.Add("Leverancier");

        await ControleerBank();
        ControleerIban(uit);
    }

    /// <summary>Zijn twee namen in de kern hetzelfde? Rechtsvorm en leestekens doen niet mee.</summary>
    private static bool Gelijk(string a, string b)
        => MySqlFactuurRepository.AliasSleutel(a) == MySqlFactuurRepository.AliasSleutel(b);

    /// <summary>De naam van de factuur onthouden bij de gekozen leverancier.</summary>
    private async Task OnthoudAlias()
    {
        if (_aliasVraag.Length == 0 || _factuur.BedrijfId is null) return;

        var naam = _aliasVraag;
        try
        {
            await Repo.BewaarAliasAsync(naam, _factuur.BedrijfId.Value, Ik.WerknemerId);
            _aliasVraag = "";
            Toon($"Onthouden: '{naam}' hoort bij {_factuur.Bedrijf}. "
               + "De volgende factuur van dit bedrijf gaat vanzelf goed.", false);
        }
        catch (Exception ex)
        {
            Toon("Onthouden mislukt: " + ex.Message + " — is de tabel LeverancierAlias al aangemaakt? "
               + "Zie LeverancierAlias_MariaDB.sql.", true);
        }
    }

    /// <summary>
    /// Schrijft het gekozen bestand naar de filestore. Geeft terug of er iets is
    /// weggeschreven; zonder gekozen bestand gebeurt er niets.
    /// </summary>
    /// <summary>
    /// Schrijft de nog niet bewaarde bestanden naar de filestore — dezelfde plek als
    /// Access gebruikt (soort 1, met het factuurnummer als sleutel), zodat beide
    /// programma's dezelfde documenten zien.
    ///
    /// De inhoud blijft in het geheugen staan, zodat je een factuur daarna alsnog
    /// kunt laten uitlezen.
    /// </summary>
    private async Task<int> BewaarBestanden()
    {
        var tedoen = _gekozen.Where(b => !b.Bewaard).ToList();
        if (tedoen.Count == 0 || _factuur.Id == 0) return 0;

        _uploadBezig = true;
        var gelukt = 0;
        var fouten = new List<string>();

        try
        {
            foreach (var best in tedoen)
            {
                try
                {
                    using var stroom = new MemoryStream(best.Inhoud);
                    await Filestore.ToevoegenAsync(stroom, best.Naam, StoreTypeFactuur,
                                                   _factuur.Id, Ik.WerknemerId ?? 0);
                    best.Bewaard = true;
                    gelukt++;
                }
                catch (Exception ex) { fouten.Add($"{best.Naam}: {ex.Message}"); }
            }

            if (gelukt > 0)
            {
                _erIsGewijzigd = true;
                await LaadDocumenten();
            }
            if (fouten.Count > 0) Toon("Niet opgeslagen: " + string.Join("; ", fouten), true);

            return gelukt;
        }
        finally
        {
            _uploadBezig = false;
            _uploadRonde++;
        }
    }

    /// <summary>
    /// Zoals de factuur was toen het venster openging. Daarmee weten we of er iets
    /// te verliezen valt bij het sluiten.
    /// </summary>
    private string _zoalsGeopend = "";

    /// <summary>
    /// Een korte samenvatting van alles wat je kunt wijzigen. Simpeler dan veld voor
    /// veld vergelijken, en het mist niets zolang het hier compleet is.
    /// </summary>
    private string Vingerafdruk() => string.Join("|",
        _factuur.AdministratieId, _factuur.BedrijfId, _factuur.Factuurdatum,
        _factuur.Factuurnummer, _factuur.Omschrijving, _factuur.ReferentieMde,
        _factuur.Betalingstermijn, _factuur.BedragExBtw, _factuur.Btw,
        _factuur.Doorbelasten, _factuur.OpHold,
        // Alleen bij een nieuwe factuur: daar gaan de vinkjes pas mee bij het
        // toevoegen. Bij een bestaande zijn ze al direct opgeslagen, dus die
        // horen niet in de "ben je iets kwijt?"-vergelijking.
        _factuur.Id == 0 && _factuur.Goedgekeurd,
        _factuur.Id == 0 && _factuur.Betaald,
        // Ook gekozen maar nog niet bewaarde bestanden zijn werk dat je kwijt kunt,
        // net als koppelingen die nog in de wachtrij staan.
        string.Join(",", _gekozen.Where(b => !b.Bewaard).Select(b => b.Naam)),
        string.Join(",", _wachtKoppelingen.Select(w => w.Naam + w.Bedrag)));

    private bool ErIsIetsGewijzigd => Vingerafdruk() != _zoalsGeopend;

    /// <summary>Waar: de laatste muisdruk begon op de achtergrond zelf.</summary>
    private bool _overlayDruk;

    private async Task OverlayGeklikt()
    {
        var begonOpAchtergrond = _overlayDruk;
        _overlayDruk = false;
        if (begonOpAchtergrond) await Afbreken();
    }

    private async Task Afbreken()
    {
        // Werk mag niet verdwijnen door een klik naast het venster — niet bij een
        // nieuwe factuur, en net zomin bij het bewerken van een bestaande.
        if (ErIsIetsGewijzigd)
        {
            var weg = await Vraag(_nieuw
                ? "Deze factuur is nog niet opgeslagen. Toch sluiten?"
                : "Er zijn wijzigingen die nog niet zijn opgeslagen. Toch sluiten?");
            if (!weg) return;
        }

        await Sluiten.InvokeAsync(_erIsGewijzigd);
    }

    private async Task<bool> Vraag(string tekst)
    {
        try { return await JS.InvokeAsync<bool>("mdeBevestig", tekst); }
        catch { return false; }
    }

    private void Toon(string tekst, bool fout) { _melding = tekst; _meldingFout = fout; }

    // ============================================================
    //  De vlaggen (stand van zaken)
    // ============================================================

    private bool MagGoedkeuren => Ik.Mag("MagFacturenGoedkeuren") || Ik.Mag("Directie");

    /// <summary>Gaat omhoog als een vinkje moet worden teruggedraaid; zie de @@key.</summary>
    private int _vlagRonde;

    /// <summary>"12-08-2026 · Peter" — of leeg als de vlag niet gezet is.</summary>
    private static string Stempel(DateTime? wanneer, string door)
    {
        var datum = wanneer?.ToString("dd-MM-yyyy") ?? "";
        if (datum.Length == 0) return "";
        return door.Length > 0 ? $"{datum} · {door}" : datum;
    }

    private async Task ZetVlagHier(FactuurVlag vlag, ChangeEventArgs e)
    {
        var aan = Vink(e);

        // Zelfde controle als in de lijst; het uitgrijzen houdt niemand tegen
        // die het echt wil.
        var magHet = vlag == FactuurVlag.Goedgekeurd ? MagGoedkeuren : MagInvoeren;
        if (!magHet)
        {
            _vlagRonde++;
            Toon("Je hebt hier geen recht voor.", true);
            return;
        }

        // Nieuwe factuur: nog geen id, dus alleen onthouden. De vlag wordt
        // echt gezet (mét wie en wanneer) zodra de factuur is toegevoegd.
        if (_factuur.Id == 0)
        {
            ZetVlagLokaal(vlag, aan);
            return;
        }

        // Een factuur die al naar Basecone is, wil je niet stil terugdraaien.
        if (vlag == FactuurVlag.Basecone && !aan
            && !await Vraag("Deze factuur staat als 'naar Basecone'. Echt terugdraaien?"))
        {
            _vlagRonde++;
            return;
        }

        try
        {
            await Repo.ZetVlagAsync(_factuur.Id, vlag, aan, Ik.WerknemerId);
            ZetVlagLokaal(vlag, aan);
            _erIsGewijzigd = true;
        }
        catch (Exception ex)
        {
            _vlagRonde++;
            Toon("Vinkje zetten mislukt: " + ex.Message, true);
        }
    }

    /// <summary>Houdt het scherm gelijk aan wat de database nu zegt, zonder
    /// opnieuw op te halen. De database schrijft dezelfde stempels.</summary>
    private void ZetVlagLokaal(FactuurVlag vlag, bool aan)
    {
        var nu = aan ? DateTime.Now : (DateTime?)null;
        var wie = aan ? Ik.Naam : "";
        switch (vlag)
        {
            case FactuurVlag.Goedgekeurd:
                _factuur.Goedgekeurd = aan; _factuur.GoedgekeurdOp = nu; _factuur.GoedgekeurdDoor = wie;
                break;
            case FactuurVlag.Betaald:
                _factuur.Betaald = aan;
                _factuur.BetaaldOp = aan ? DateOnly.FromDateTime(DateTime.Today) : null;
                _factuur.BetaaldDoor = wie;
                break;
            case FactuurVlag.Sepa:
                _factuur.SepaVerzonden = aan; _factuur.SepaOp = nu; _factuur.SepaDoor = wie;
                break;
            case FactuurVlag.Basecone:
                _factuur.NaarBasecone = aan; _factuur.BaseconeOp = nu;
                break;
        }
    }
}
