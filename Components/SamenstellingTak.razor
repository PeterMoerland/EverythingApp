@* Eén regel uit een samenstelling, die zichzelf opnieuw gebruikt voor de
   onderdelen daaronder. Zo ontstaat een boom die zo diep mag zijn als de
   stuklijst zelf. De onderdelen worden pas opgehaald als je uitklapt. *@

<div class="stuk-regel @(Regel.IsSamenstelling ? "assy" : "")"
     style="@($"padding-left: {0.2 + Niveau * 1.1:0.##}rem")">

    @if (Regel.IsSamenstelling)
    {
        <button class="stuk-pijl" title="@(_open ? "Dichtklappen" : "Openklappen")" @onclick="Klap">
            @(_open ? "▾" : "▸")
        </button>
    }
    else
    {
        <span class="stuk-pijl leeg"></span>
    }

    <span class="stuk-aantal">
        <input class="r" value="@Regel.Aantal.ToString("0.##")" @onchange="AantalGewijzigd" />
    </span>
    <span class="stuk-nummer">@Regel.ArtikelId</span>
    <span class="stuk-code" title="@Regel.Code">@Regel.Code</span>
    <span class="stuk-oms" title="@Regel.Omschrijving">@Regel.Omschrijving</span>
    <span class="stuk-opm">
        <input value="@Regel.Opmerking" maxlength="250" placeholder="opmerking"
               @onchange="OpmerkingGewijzigd" />
    </span>
    <span class="stuk-prijs">
        @if (Regel.IsSamenstelling)
        {
            @* prijs van een samenstelling volgt uit zijn eigen onderdelen *@
            <span title="Berekend uit de onderdelen">@Bedrag(Regel.Kostprijs)</span>
        }
        else
        {
            <button class="prijsknop" title="Inkoopprijs invoeren" @onclick="Prijs">
                @(Regel.Kostprijs is null or 0 ? "prijs…" : Bedrag(Regel.Kostprijs))
            </button>
        }
    </span>
    <span class="stuk-totaal">@Bedrag(Regel.Totaal)</span>
    <span class="stuk-weg">
        <button class="klein rood" title="Onderdeel verwijderen" @onclick="Weg">✕</button>
    </span>
</div>

@if (_open)
{
    @if (_bezig)
    {
        <div class="stuk-regel laden" style="@($"padding-left: {1.3 + Niveau * 1.1:0.##}rem")">
            <span class="zij-extra">bezig…</span>
        </div>
    }
    else if (_onder.Count == 0)
    {
        <div class="stuk-regel laden" style="@($"padding-left: {1.3 + Niveau * 1.1:0.##}rem")">
            <span class="zij-extra">geen onderdelen gevonden</span>
        </div>
    }
    else
    {
        @foreach (var kind in _onder)
        {
            <SamenstellingTak Regel="kind" Niveau="Niveau + 1" Ophalen="Ophalen"
                              OpSlaan="OpSlaan" OpVerwijderen="Verwijderd" OpPrijs="OpPrijs"
                              Ouder="Regel.ArtikelId" @key="kind.Id" />
        }
    }
}

@code {
    [Parameter, EditorRequired] public Samenstellingregel Regel { get; set; } = default!;

    /// <summary>Hoe diep deze regel zit; bepaalt alleen het inspringen.</summary>
    [Parameter] public int Niveau { get; set; }

    /// <summary>Haalt de onderdelen van een artikel op.</summary>
    [Parameter, EditorRequired] public Func<int, Task<List<Samenstellingregel>>> Ophalen { get; set; } = default!;

    /// <summary>Het artikel waar deze regel onder hangt; nodig om op te slaan.</summary>
    [Parameter] public int Ouder { get; set; }

    /// <summary>Bewaart een gewijzigde regel: (ouder, regel).</summary>
    [Parameter] public EventCallback<(int Ouder, Samenstellingregel Regel)> OpSlaan { get; set; }

    /// <summary>Verwijdert een regel.</summary>
    [Parameter] public EventCallback<Samenstellingregel> OpVerwijderen { get; set; }

    /// <summary>Vraagt om de inkoopprijs van dit onderdeel.</summary>
    [Parameter] public EventCallback<Samenstellingregel> OpPrijs { get; set; }

    private Task Prijs() => OpPrijs.InvokeAsync(Regel);

    private bool _open;
    private bool _bezig;
    private List<Samenstellingregel> _onder = new();

    private async Task AantalGewijzigd(ChangeEventArgs e)
    {
        var tekst = ((string?)e.Value ?? "").Replace(',', '.').Trim();
        Regel.Aantal = double.TryParse(tekst, System.Globalization.NumberStyles.Any,
                                       System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 0;
        await OpSlaan.InvokeAsync((Ouder, Regel));
    }

    private async Task OpmerkingGewijzigd(ChangeEventArgs e)
    {
        Regel.Opmerking = (string?)e.Value ?? "";
        await OpSlaan.InvokeAsync((Ouder, Regel));
    }

    private Task Weg() => OpVerwijderen.InvokeAsync(Regel);

    /// <summary>Een onderdeel onder deze tak is weg; die tak opnieuw ophalen.</summary>
    private async Task Verwijderd(Samenstellingregel regel)
    {
        await OpVerwijderen.InvokeAsync(regel);
        if (_open) _onder = await Ophalen(Regel.ArtikelId);
    }

    private async Task Klap()
    {
        _open = !_open;
        if (!_open || _onder.Count > 0) return;

        // Een stuklijst die zichzelf bevat zou eindeloos doorlopen; twaalf niveaus
        // is ruim genoeg voor een echte machine.
        if (Niveau >= 12) return;

        _bezig = true;
        try { _onder = await Ophalen(Regel.ArtikelId); }
        catch { _onder = new(); }
        finally { _bezig = false; }
    }

    private static string Bedrag(decimal? waarde)
        => waarde is null or 0 ? "" : waarde.Value.ToString("C2", new System.Globalization.CultureInfo("nl-NL"));
}
