    private async Task SchrijfAlias()
    {
        var wijz = AliasWijzigingen.ToList();
        if (wijz.Count == 0 || !Mag) return;
        var dubbel = wijz.Select(w => w.Nieuw!.Value).Where(n => n != 0).GroupBy(n => n).Where(g => g.Count() > 1).Select(g => g.Key).ToList();
        if (dubbel.Count > 0) { Toon("Hetzelfde nummer bij meerdere slaves: " + string.Join(", ", dubbel), true); return; }
        var tekst = string.Join("\n", wijz.Select(w => $"  • positie {w.Positie} {w.Naam}: {(w.Alias?.ToString() ?? "?")} → {w.Nieuw}"));
        if (!await Bevestig("Deze node-nummers in de slaves schrijven (EEPROM)?\n" + tekst)) return;
        var adressen = wijz.ToDictionary(w => w.Positie.ToString(), w => w.Nieuw!.Value);
        await VoerTaakUit("ecat.alias", JsonSerializer.Serialize(new { wat = "schrijf", adressen }), "EtherCAT node-adressen schrijven (Write to slaves)", 120, async res =>
        {
            VulAlias(res);
            var geschreven = _aliasSlaves.Count(a => a.Geschreven);
            await Repo.VoegHistorieToeAsync(ProductId, "EtherCAT node-adressen geschreven: " + string.Join(", ", _aliasSlaves.Where(a => a.Geschreven).Select(a => $"pos {a.Positie} → {a.Alias}")),
                                            SoortId("Test"), Ik.WerknemerId, uitkomst: true);
            return $"{geschreven} van {wijz.Count} geschreven · {_aliasSamenvatting}";
        });
    }

