@inject IProductRepository Repo
@inject HuidigeGebruiker Ik
@inject IConfiguration Config
@inject IJSRuntime JS
@inject FirmwarePakketten Firmware
@inject IDriveRepository Drives
@inject FilestoreService Store
@inject DuurtestService Duurtest
@inject NavigationManager Nav
@using System.Text.Json
@implements IDisposable

@* Het werk aan één exemplaar: automatisch uitlezen, programmeren (drives, eRob, chips,
   servo), testen, en optioneel opbouw/eindcontrole en duurtest — alles wat via de
   werkplek-agent op deze pc loopt. Gebruikt door Productie ▸ Half-fabricaten (werkplek,
   met stapnummers) en door Producten ▸ exemplaar ▸ tab Programmeren (zonder nummers).
   De aanroeper toont zelf de kaart en de historie en ververst die via OpGewijzigd. *@

@if (_melding is not null)
{
    <div class="melding @(_fout ? "fout" : "ok")" @onclick="() => _melding = null">@_melding</div>
}

@if (!Mag)
{
    <p class="uitleg">Je hebt geen rechten om te programmeren of te testen (@_recht); de knoppen staan uit.</p>
}

@* ---------- automatisch uitlezen ---------- *@
@if (ToonUitlezen)
{
    <div class="btngroup prod-acties">
        @if (HeeftFeetech)
        {
            <button class="klein" disabled="@(!Mag || _taakBezig || _agentUrl.Length == 0)" @onclick="LeesServo"
                    title="Leest de servo uit via de USB-adapter op deze pc: ID, model, firmware, alle registers">
                ⌁ Servo uitlezen
            </button>
        }
        else if (HeeftCan && _agentUrl.Length > 0)
        {
            <button class="klein" disabled="@(!Mag || _leest || _taakBezig)" @onclick="LeesErobCan"
                    title="Leest de eRob uit over CAN (USBCAN op deze pc, ZeroErr-protocol): serienummer, model, hardware, partnummer — en zet ze in de attributen">
                @(_leest ? "⌁ Bezig met uitlezen…" : "⌁ eRob uitlezen (CAN)")
            </button>
            <label class="bankveld" title="Leeg = automatisch (luistert wie er praat, anders ID 1..8)"><span>Drive-ID</span>
                <input type="number" min="1" max="127" placeholder="auto" value="@_erobCanId" style="width:4.5rem" disabled="@(_leest || _taakBezig)"
                       @onchange="e => _erobCanId = int.TryParse((string?)e.Value, out var v) && v is >= 1 and <= 127 ? v : null" /></label>
        }
        else if (_agentUrl.Length > 0)
        {
            <button class="klein" disabled="@(!Mag || _leest || _taakBezig)" @onclick="LeesDrives"
                    title="Leest de print uit via de werkplek-agent op deze pc en zet de waarden in de attributen">
                @(_leest ? "⌁ Bezig met uitlezen…" : "⌁ Automatisch uitlezen")
            </button>
        }
        else
        {
            <button class="klein" disabled title="Productie:UitleesAgent is niet ingesteld">⌁ Automatisch uitlezen</button>
        }
    </div>
}

@* Uitgelezen servo (Feetech): versie en alle registers, inklapbaar. *@
@if (_servo is not null)
{
    <div class="prod-drives go">
        <div class="prod-drives-kop">
            <b>SERVO</b>
            <span>ID @_servo.Id · @_servo.Model · firmware @_servo.Firmware · servoversie @_servo.Servoversie · @_servo.Poort @@ @_servo.Baud baud</span>
            <button class="klein" @onclick="() => _servoRegistersOpen = !_servoRegistersOpen">@(_servoRegistersOpen ? "Registers verbergen" : "Registers tonen")</button>
            <button class="klein" @onclick="() => _servo = null">Sluiten</button>
        </div>
        @if (_servoRegistersOpen)
        {
            <table class="kiezer-tabel smal-tabel prod-servo-regs">
                <thead><tr><th style="width:4rem">Adres</th><th>Register</th><th style="width:6rem" class="r">Waarde</th><th style="width:5rem">Geheugen</th><th style="width:3rem">RW</th></tr></thead>
                <tbody>
                    @foreach (var r in _servo.Registers)
                    {
                        <tr class="@(r.Fout.Length > 0 ? "ec-fout" : "")">
                            <td>@r.Adres</td><td>@r.Naam</td>
                            <td class="r" title="@r.Fout">@(r.Waarde?.ToString() ?? "—")</td>
                            <td>@r.Geheugen</td><td>@r.Rw</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@* Controle van de drives tegen de drivetypen-tabel. Blijft staan na opslaan. *@
@if (_controles.Count > 0)
{
    <table class="kiezer-tabel prod-controle">
        <thead>
            <tr>
                <th style="width:17rem">Node</th>
                <th style="width:16rem">Type</th>
                <th>Firmware</th>
                @if (MetParameters) { <th>Parameterset</th> }
            </tr>
        </thead>
        <tbody>
            @foreach (var c in _controles)
            {
                <tr>
                    <td><b>@c.Positie</b> @c.Naam
                        <small class="uitleg">@(c.Serienummer.Length > 0 ? $"SN {c.Serienummer}" : "geen SN")</small></td>
                    <td><span class="stand-chip @c.TypeKleur">@c.TypeTekst</span></td>
                    <td><span class="stand-chip @c.FirmwareKleur">@c.FirmwareTekst</span></td>
                    @if (MetParameters) { <td>@c.ParametersTekst</td> }
                </tr>
            }
        </tbody>
    </table>
}

@* De uitgelezen drives. Go = precies één drive per as en overal een serienummer. *@
@if (_drives is not null)
{
    <div class="prod-drives @(_drivesGo ? "go" : "nogo")">
        <div class="prod-drives-kop">
            <b>@(_drivesGo ? "GO" : "NO-GO")</b>
            <span>@_drivesOordeel</span>
            @if (_drivesGo && !_drivesOpgeslagen)
            {
                <button class="primair klein" disabled="@(!Mag || _bezig)" @onclick="BewaarDrives">Alsnog opslaan</button>
            }
            <button class="klein" @onclick="() => _drives = null">Sluiten</button>
        </div>
        @if (_drives.Count > 0)
        {
            <table class="kiezer-tabel smal-tabel">
                <thead>
                    <tr>
                        <th style="width:4rem">Pos.</th>
                        <th style="width:12rem" title="Attribuut waarin het serienummer komt">Naar attribuut</th>
                        <th title="Type volgens de productcode (Controllertypen); daarachter de naam zoals die in de EEPROM van de drive staat — bij Ingenia is die generiek en zegt hij niets over het model">Type (EEPROM-naam)</th>
                        <th style="width:9rem">Productcode</th>
                        <th style="width:8rem">Revisie</th>
                        <th style="width:8rem">Firmware</th>
                        <th style="width:11rem">Serienummer</th>
                        <th>Meldingen</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in _drives)
                    {
                        <tr class="@(d.Ok ? "" : "ec-fout")">
                            <td>@d.Positie</td>
                            <td>@d.As</td>
                            <td title="@($"EEPROM-naam: {d.Naam}" + (d.ApparaatNaam.Length > 0 ? $" · 0x1008: {d.ApparaatNaam}" : ""))">
                                @if (d.TypeUitTabel.Length > 0) { <b>@d.TypeUitTabel</b> <small class="uitleg">@d.Naam</small> }
                                else { @d.Naam }
                            </td>
                            <td>@d.ProductCode</td>
                            <td>@d.Revisie</td>
                            <td>@d.Firmware</td>
                            <td><b>@(d.Serienummer.Length > 0 ? d.Serienummer : "—")</b>
                                @if (d.SerienummerViaCan) { <span class="stand-chip s-blauw" title="@($"Over CAN gelezen (ZeroErr-protocol, drive-ID {d.CanId}): {d.Model} · hw {d.Hardware} · PN {d.Partnummer}")">CAN</span> }
                            </td>
                            <td class="omschrijving">@(d.Model.Length > 0 ? d.Model + (d.Fouten.Count > 0 ? "; " : "") : "")@string.Join("; ", d.Fouten)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        @foreach (var f in _driveFouten)
        {
            <p class="uitleg fout-tekst">@f</p>
        }
    </div>
}

@* ---------- programmeren (weg bij bv. een kabel) ---------- *@
@if (!ToonProgrammeren && !ToonTesten && AantalTechnieken == 0 && !MotorModus)
{
    <p class="uitleg">Geen techniek op dit producttype: niets te programmeren of automatisch te testen
        (anders: Producten ▸ producttype ▸ tab Techniek).</p>
}
@if (ToonProgrammeren)
{
    @Kop(NrProgrammeren, "Programmeren")
    @if (HeeftChip || AantalTechnieken == 0)
    {
        @* Alles wat via de USB-kabel gaat: chip programmeren en de seriële monitor *@
        <div class="bankfilters prod-prog prod-usb">
            <span class="prod-prog-pos"><b>USB</b> <small class="uitleg">@(_technieken.Contains(ProductTechniek.Stm32) && !_technieken.Contains(ProductTechniek.Esp32) ? "ST-LINK" : "USB-UART")</small></span>
            <button class="klein" disabled="@(!Mag || _taakBezig || _agentUrl.Length == 0)" @onclick="OpenFirmware"
                    title="ESP32 of STM32 op de print programmeren">
                ⚡ @(_technieken.Contains(ProductTechniek.Esp32) && !_technieken.Contains(ProductTechniek.Stm32) ? "ESP32 programmeren…"
                   : _technieken.Contains(ProductTechniek.Stm32) && !_technieken.Contains(ProductTechniek.Esp32) ? "STM32 programmeren…"
                   : "Chip programmeren (ESP32/STM32)…")
            </button>
            @if (_technieken.Contains(ProductTechniek.Esp32) || AantalTechnieken == 0)
            {
                <button class="klein" disabled="@(!Mag || _agentUrl.Length == 0)" @onclick="OpenSerieel"
                        title="De seriële uitvoer van de ESP32 via de USB-UART live meelezen en tekst sturen, zoals de seriële monitor van de Arduino-IDE">🖥 Seriële monitor…</button>
            }
        </div>
    }
    @if (AantalTechnieken == 0 && DrivePosities.Count == 0)
    {
        <p class="uitleg">Bij dit producttype is nog niet vastgelegd wat erop zit (Producten ▸ tab Techniek).</p>
    }
    @if (HeeftDrives && DrivePosities.Count == 0)
    {
        <p class="uitleg">Dit producttype heeft drives maar nog geen drive-posities (Producten ▸ tab Techniek).</p>
    }
    @foreach (var p in HeeftDrives ? DrivePosities : new List<DrivePositie>())
    {
        var keuze = Keuze(p.Positie);
        <div class="bankfilters prod-prog">
            <span class="prod-prog-pos"><b>@p.Positie</b> @p.Naam <small class="uitleg">@p.DriveTypeNaam</small></span>
            <label class="bankveld">
                <span>Firmwareversie</span>
                <select value="@keuze.FirmwareId" disabled="@_taakBezig" @onchange="e => KiesFirmware(p.Positie, e)">
                    <option value="0">— kies —</option>
                    @foreach (var f in FirmwaresVoor(p))
                    {
                        <option value="@f.Id">@f.Versie · @f.Status@(f.FirmwareFileId is null ? " (geen bestand)" : "")</option>
                    }
                </select>
            </label>
            <button class="klein" disabled="@(!Mag || _taakBezig || !KanFirmware(keuze))" @onclick="() => LaadDriveFirmware(p)"
                    title="Firmware via EtherCAT in de drive laden (FoE)">⚡ Firmware laden</button>
            @if (MetParameters)
            {
                <label class="bankveld">
                    <span>Parameterset</span>
                    <select value="@keuze.ParametersId" disabled="@_taakBezig" @onchange="e => KiesParameters(p.Positie, e)">
                        <option value="0">— kies —</option>
                        @foreach (var ps in ParametersVoor(p, keuze.FirmwareId))
                        {
                            <option value="@ps.Id">@(ps.Omschrijving.Length > 0 ? ps.Omschrijving : ps.ParameterBestand) · fw @ps.FirmwareVersie@(ps.ParameterFileId is null ? " (geen bestand)" : "")</option>
                        }
                    </select>
                </label>
                <button class="klein" disabled="@(!Mag || _taakBezig || !KanParameters(keuze, p))" @onclick="() => LaadParameters(p)"
                        title="@ParamTitel(p)">⚙ Parameters laden</button>
            }
            @if (IsMde(p))
            {
                @* Eigen MDE-slave: objectdictionary/losse SDO's en live meekijken, in dezelfde rij. *@
                <button class="klein" disabled="@(!Mag || _taakBezig || _agentUrl.Length == 0)" @onclick="() => OpenDictionary(p)"
                        title="De complete objectdictionary van de slave lezen en losse SDO's lezen/schrijven">🔎 Objecten…</button>
                <button class="klein" disabled="@(!Mag || _agentUrl.Length == 0)" @onclick="() => OpenTest(MonitorCode(p))"
                        title="Objecten van deze slave live meekijken (druk, joints, statusword …), alleen lezen">📈 Meekijken…</button>
                @if (EepromVullenAan || SnSchrijven)
                {
                    @* EEPROM-acties onder elkaar: eerst de hele EEPROM, daaronder alleen het serienummer *@
                    <div class="prod-eeprom">
                        @if (EepromVullenAan)
                        {
                            <div>
                                <button class="klein" disabled="@(!Mag || _taakBezig || _agentUrl.Length == 0 || EsiVoor(p) is null)" @onclick="() => VergelijkEeprom(p)"
                                        title="@(EsiVoor(p) is null ? "Geen ESI-bestand bij dit controllertype" : "De EEPROM van de slave vergelijken met wat het ESI zou schrijven; er wordt niets veranderd")">🧩 EEPROM vergelijken</button>
                                <button class="klein" disabled="@(!Mag || _taakBezig || _agentUrl.Length == 0 || EsiVoor(p) is null)" @onclick="() => VulEeprom(p)"
                                        title="De complete EEPROM-inhoud uit het ESI schrijven (PDI/SPI, identiteit, serienummer, mailboxen, PDO's); daarna spanning uit/aan">💾 EEPROM vullen…</button>
                            </div>
                        }
                        @if (SnSchrijven)
                        {
                            <div>
                                <button class="klein" disabled="@(!Mag || _taakBezig || _agentUrl.Length == 0 || SerienummerGetal is null)" @onclick="() => SchrijfSerienummer(p)"
                                        title="@(SerienummerGetal is uint sn ? $"Serienummer {sn} in de EEPROM van de slave zetten (SII 0x0E); de print meldt het daarna zelf" : "Het serienummer van dit exemplaar bevat geen getal")">🔢 Serienummer schrijven</button>
                            </div>
                        }
                    </div>
                }
            }
            @if (!IsCoe(p))
            {
                @if (MetParameters)
                {
                    <button class="klein" disabled="@(_taakBezig || !KanParameters(keuze, p))" @onclick="() => VergelijkParameters(p)"
                            title="Parameter compare: elk register uit de gekozen parameterset in de drive lezen en de verschillen tonen — er wordt niets geschreven">⇄ Vergelijken</button>
                }
                <button class="klein" disabled="@(_taakBezig || _agentUrl.Length == 0 || StroomlusFirmware(p.Positie) is null)" @onclick="() => LeesRegisters(p)"
                        title="Alle registers uit de dictionary van de drive lezen, ook de alleen-lezen statusregisters (duurt ½–2 minuten)">📋 Alle registers…</button>
                <button class="klein" disabled="@(_taakBezig || _agentUrl.Length == 0 || StroomlusFirmware(p.Positie) is null)" @onclick="() => OpenEncoder(p)"
                        title="Encoderwaarde live: wijzerplaat (singleturn), ruwe positie, omwentelingen en waarschuwing bij de 32-bit-grens">◎ Encoder…</button>
            }
        </div>
        @if (IsErob(p))
        {
            @* eRob e.d.: de as in een hoek zetten (profile position) en de positie uitlezen. *@
            <div class="bankfilters prod-prog prod-hoek">
                <span class="prod-prog-pos"><small class="uitleg">as @p.Positie</small></span>
                <label class="bankveld">
                    <span>Hoek (°, absoluut)</span>
                    <input type="number" step="0.01" style="width:7rem" value="@HoekVoor(p.Positie)" disabled="@_taakBezig"
                           @onchange="e => _hoek[p.Positie] = (string?)e.Value ?? string.Empty" />
                </label>
                <label class="bankveld">
                    <span>Snelheid (°/s)</span>
                    <input type="number" step="1" min="1" max="60" style="width:5rem" value="@_hoekSnelheid" disabled="@_taakBezig"
                           @onchange="e => _hoekSnelheid = int.TryParse((string?)e.Value, out var v) ? Math.Clamp(v, 1, 60) : 10" />
                </label>
                <button class="primair klein" disabled="@(!Mag || _taakBezig || _agentUrl.Length == 0 || HoekVoor(p.Positie).Length == 0)" @onclick="() => NaarHoek(p)"
                        title="De actuator via EtherCAT naar deze hoek bewegen (48 V en STO nodig); de gemeten hoek komt in de historie">↻ Naar hoek</button>
                <button class="klein" disabled="@(!Mag || _taakBezig || _agentUrl.Length == 0)" @onclick="() => LeesPositie(p)"
                        title="Positie, statusword, foutcode en temperatuur lezen">📍 Positie</button>
                <button class="klein" disabled="@(!Mag || _taakBezig || _agentUrl.Length == 0)" @onclick="() => VrijgevenAs(p)"
                        title="Motor uitschakelen (rem valt in)">⏻ Vrijgeven</button>
                <button class="klein" disabled="@(!Mag || _taakBezig || _agentUrl.Length == 0)" @onclick="() => OpenDictionary(p)"
                        title="De complete objectdictionary van de drive lezen (ook ongedocumenteerde objecten) en losse SDO's lezen/schrijven">🔎 Objecten…</button>
            </div>
        }
    }
    @if (HeeftFeetech)
    {
        <div class="bankfilters prod-prog">
            <span class="prod-prog-pos"><b>Servo</b> <small class="uitleg">Feetech</small></span>
            <label class="bankveld">
                <span>Parameterset (.json)</span>
                <select value="@_servoParamsId" disabled="@_taakBezig" @onchange="e => _servoParamsId = int.TryParse((string?)e.Value, out var v) ? v : 0">
                    <option value="0">— kies —</option>
                    @foreach (var ps in _parametersets.Where(p => p.ParameterFileId is not null))
                    {
                        <option value="@ps.Id">@(ps.Omschrijving.Length > 0 ? ps.Omschrijving : ps.ParameterBestand) · @ps.DriveTypeNaam @ps.FirmwareVersie · @ps.Status</option>
                    }
                </select>
            </label>
            <label class="bankveld">
                <span>Huidig bus-ID (leeg = enige servo)</span>
                <input value="@_servoId" style="width:7rem" placeholder="auto" disabled="@_taakBezig"
                       @onchange="e => _servoId = ((string?)e.Value ?? string.Empty).Trim()" />
            </label>
            <button class="primair klein" disabled="@(!Mag || _taakBezig || _agentUrl.Length == 0 || _servoParamsId == 0)" @onclick="ProgrammeerServo"
                    title="Alle rw-EEPROM-registers uit de parameterset schrijven, terugkijken en opslaan bij het exemplaar">⚙ Programmeren</button>
        </div>
        @if (_parametersets.Count == 0)
        {
            <p class="uitleg">Nog geen parameterset bij dit product: Producten ▸ Techniek ▸ Parametersets (upload een .json, sjabloon: MdeAgent\voorbeelden\feetech-sts3215.json).</p>
        }
    }

}

@* ---------- testen ---------- *@
@* ---------- EtherCAT node-adressen (stap NodeAdres): nummers lezen, nieuw nummer invoeren, Write to slaves ---------- *@
@if (ToonNodeAdres)
{
    @Kop(NrNodeAdres, "EtherCAT node-adressen")
    <div class="btngroup prod-acties">
        <button class="klein" disabled="@(!Mag || _taakBezig || _agentUrl.Length == 0)" @onclick="OpenAlias"
                title="Leest de huidige node-nummers van alle slaves op de bus en laat je nieuwe nummers invoeren (Write to slaves)">🏷 Node-adressen…</button>
        @if (_aliasSamenvatting.Length > 0) { <span class="uitleg">huidig: @_aliasSamenvatting</span> }
        else if (_agentUrl.Length == 0) { <span class="uitleg">Productie:UitleesAgent is niet ingesteld</span> }
    </div>
}

@if (ToonTesten)
{
    @Kop(NrTesten, "Testen")
    <div class="btngroup prod-acties">
        @foreach (var t in _testen)
        {
            var code = t.Code;
            <button class="klein" disabled="@(!Mag || _agentUrl.Length == 0)" @onclick="() => OpenTest(code)"
                    title="@TestUitlegVoor(code)">@TestIcoon(code) @t.Naam…</button>
        }
        @if (_agentUrl.Length == 0) { <span class="uitleg">Productie:UitleesAgent is niet ingesteld</span> }
        @if (_testLaatste.Length > 0) { <span class="uitleg">laatste: @_testLaatste</span> }
    </div>
}

@* ---------- testvenster: test kiezen, parameters, starten, verloop en uitslag ---------- *@
@if (_testOpen)
{
    <div class="cmdk-overlay midden">
        <div class="fusion-kijker ec-venster verplaatsbaar prod-test-venster">
            <div class="sleepkop fusion-kijker-kop">
                <b>@TestIcoon(_testCode) @TestNaam — @Naam.Naam · @Exemplaar.Serienummer</b>
                <span style="flex:1"></span>
                <button class="klein" @onclick="() => _testOpen = false" title="Een lopende test loopt door; die volg je in het voortgangsvenster">✕ Sluiten</button>
            </div>
            <div class="fusion-kijker-inhoud">
                <p class="uitleg">@TestUitleg</p>
                <div class="bankfilters">
                    @if (IsDriveTest && _testCode != "dualmotion")
                    {
                        <label class="bankveld"><span>Drive</span>
                            <select value="@_slPositie" disabled="@_taakBezig" @onchange="e => _slPositie = int.TryParse((string?)e.Value, out var v) ? v : 0">
                                @foreach (var p in DrivePosities.Where(p => !IsCoe(p))) { <option value="@p.Positie">@p.Positie · @p.Naam</option> }
                            </select>
                        </label>
                    }
                    @if (IsStroomlus)
                    {
                        <label class="bankveld"><span>Amplitude (A)</span><input type="number" step="0.1" min="0.1" max="10" value="@_slAmplitude" style="width:5rem" disabled="@_taakBezig"
                               @onchange="e => _slAmplitude = double.TryParse((string?)e.Value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 1.0" /></label>
                        <label class="bankveld"><span>Hz</span><input type="number" min="10" max="2000" value="@_slFrequentie" style="width:5rem" disabled="@_taakBezig"
                               @onchange="e => _slFrequentie = int.TryParse((string?)e.Value, out var v) ? v : 200" /></label>
                    }
                    @if (_testCode == "encodertest")
                    {
                        <label class="bankveld"><span>Verwachte increments</span><input type="number" min="1" placeholder="uit de drive" value="@_etVerwacht" style="width:7rem" disabled="@_taakBezig"
                               @onchange="e => _etVerwacht = int.TryParse((string?)e.Value, out var v) && v > 0 ? v : null" /></label>
                        <label class="bankveld"><span>Marge (%)</span><input type="number" step="0.1" min="0.1" max="50" value="@_etMarge" style="width:4.5rem" disabled="@_taakBezig"
                               @onchange="e => _etMarge = double.TryParse((string?)e.Value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 2.0" /></label>
                        <label class="bankveld" title="Teststroom als deel van de nominale stroom (minimum van motor-nominaal en drive-continu). MotionLab gebruikt 80 %."><span>Stroom (% nominaal)</span>
                            <input type="number" step="5" min="10" max="100" value="@_etStroomPct" style="width:4.5rem" disabled="@_taakBezig"
                                   @onchange="e => _etStroomPct = int.TryParse((string?)e.Value, out var v) ? Math.Clamp(v, 10, 100) : 80" /></label>
                    }
                    @if (_testCode == "motiontest")
                    {
                        <label class="bankveld"><span>Snelheden (rpm)</span><input value="@_mtSnelheden" style="width:8rem" disabled="@_taakBezig"
                               @onchange="e => _mtSnelheden = (string?)e.Value ?? string.Empty" /></label>
                        <label class="bankveld"><span>Herhalingen</span><input type="number" min="1" max="100" value="@_mtHerhalingen" style="width:4.5rem" disabled="@_taakBezig"
                               @onchange="e => _mtHerhalingen = int.TryParse((string?)e.Value, out var v) && v > 0 ? v : 3" /></label>
                        <label class="bankveld"><span>Acc. (rev/s²)</span><input type="number" step="1" min="1" value="@_mtAcc" style="width:4.5rem" disabled="@_taakBezig"
                               @onchange="e => _mtAcc = double.TryParse((string?)e.Value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 500" /></label>
                        <label class="bankveld" title="Maximaal toegestane positievolgfout tijdens de beweging, in omwentelingen (1 = 131072 increments bij een 17-bit encoder)"><span>Max. volgfout (omw)</span>
                            <input type="number" step="0.1" min="0.01" max="10" value="@_mtVolgfout" style="width:4.5rem" disabled="@_taakBezig"
                                   @onchange="e => _mtVolgfout = double.TryParse((string?)e.Value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v) && v > 0 ? v : 1.0" /></label>
                    }
                    @if (_testCode == "dualmotion")
                    {
                        <span class="uitleg">@(DualDrives() is { } dd ? $"A = drive {dd.A.Positie} ({dd.A.Naam}), B = drive {dd.B.Positie} ({dd.B.Naam})" : "twee Ingenia-drives met dictionary nodig")</span>
                        <label class="bankveld"><span>Snelheid (rpm)</span><input type="number" min="1" max="3000" value="@_dmSnelheid" style="width:5rem" disabled="@_taakBezig"
                               @onchange="e => _dmSnelheid = int.TryParse((string?)e.Value, out var v) && v > 0 ? v : 200" /></label>
                        <label class="bankveld"><span>Acc. (rev/s²)</span><input type="number" min="1" value="@_dmAcc" style="width:5rem" disabled="@_taakBezig"
                               @onchange="e => _dmAcc = double.TryParse((string?)e.Value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v) && v > 0 ? v : 500" /></label>
                        <label class="bankveld"><span>Herhalingen</span><input type="number" min="1" max="1000" value="@_dmHerhalingen" style="width:4.5rem" disabled="@_taakBezig"
                               @onchange="e => _dmHerhalingen = int.TryParse((string?)e.Value, out var v) && v > 0 ? v : 10" /></label>
                        <label class="vink" title="Lineair geïnterpoleerd: de as met de langste weg krijgt de ingestelde snelheid/acceleratie, de andere evenredig minder, zodat beide tegelijk vertrekken en aankomen">
                            <input type="checkbox" checked="@_dmInterpoleren" disabled="@_taakBezig" @onchange="e => _dmInterpoleren = e.Value is bool b && b" /> geïnterpoleerd
                        </label>
                    }
                    <button class="primair" disabled="@(!Mag || _taakBezig || _agentUrl.Length == 0 || _testCode.Length == 0 || (IsDriveTest && _testCode != "dualmotion" && StroomlusFirmware(_slPositie) is null) || (_testCode == "dualmotion" && !DualKlaar))" @onclick="StartTest">▶ Start</button>
                    @if (IsDriveTest && _testCode != "dualmotion" && StroomlusFirmware(_slPositie) is null) { <span class="uitleg">geen firmware met dictionary (.xdf) voor dit drivetype</span> }
                    @if (ReceptVan(_testCode) is { } rc)
                    {
                        <ol class="prod-recept-stappen">
                            @foreach (var s in rc.Recept.StapNamen()) { <li>@s</li> }
                        </ol>
                        @if (!rc.Recept.Stappen.Contains("\"monitor\"", StringComparison.OrdinalIgnoreCase))
                        {
                            <p class="uitleg">Tip: een stap <code>{"stap": "monitor", "objecten": [ … ]}</code> bovenaan het recept laat de waarden hieronder live meelopen.</p>
                        }
                    }
                    @if (MonitorPositie(_testCode) is { } mp)
                    {
                        <p class="uitleg">Alleen lezen: de agent leest deze objecten elke 0,2 s uit en toont ze hieronder, tot Stop of tot de tijd om is.
                           Index, sub, type en naam per object; type UINT/INT/UDINT/DINT/BOOL/USINT/SINT/REAL/STRING.</p>
                        @if (_esiObjecten.Count > 0)
                        {
                            <div class="prod-esi-objecten">
                                <div class="prod-esi-kop"><b>Uit het ESI</b> <span class="uitleg">@_esiBron</span>
                                    <button class="klein" disabled="@_taakBezig" @onclick="() => ZetEsiAlles(true)">alles</button>
                                    <button class="klein" disabled="@_taakBezig" @onclick="() => ZetEsiAlles(false)">niets</button></div>
                                @foreach (var groep in _esiObjecten.GroupBy(x => x.Groep))
                                {
                                    <div class="prod-esi-groep"><small class="uitleg">@groep.Key</small>
                                        @foreach (var x in groep)
                                        {
                                            var o = x;
                                            <label class="of-vink" title="@($"{o.Index}:{o.Sub} · {o.Type}")">
                                                <input type="checkbox" checked="@o.Aan" disabled="@_taakBezig" @onchange="e => ZetEsiObject(o, e.Value is bool b && b)" /> @o.Naam
                                            </label>
                                        }
                                    </div>
                                }
                            </div>
                            <details class="prod-esi-json"><summary class="uitleg">objectenlijst als JSON (bewerken kan ook)</summary>
                                <textarea class="drv-stappen prod-monitor-objecten" spellcheck="false" value="@_monitorObjecten"
                                          @onchange="e => _monitorObjecten = (string?)e.Value ?? string.Empty"></textarea>
                            </details>
                        }
                        else
                        {
                            @if (_esiBron.Length > 0) { <p class="uitleg">@_esiBron</p> }
                            <textarea class="drv-stappen prod-monitor-objecten" spellcheck="false" value="@_monitorObjecten"
                                      @onchange="e => _monitorObjecten = (string?)e.Value ?? string.Empty"></textarea>
                        }
                        <label class="bankveld"><span>Seconden</span>
                            <input type="number" min="5" max="1800" style="width:5rem" value="@_monitorSeconden" disabled="@_taakBezig"
                                   @onchange="e => _monitorSeconden = int.TryParse((string?)e.Value, out var v) ? Math.Clamp(v, 5, 1800) : 120" /></label>
                    }
                    @if (_mdeReeks.Count > 0 || _mdeWaarden.Count > 0)
                    {
                        @* Per waarde een knopje: aan = lijn in de grafiek, in de kleur van het blokje. *@
                        <div class="prod-mde-waarden">
                            @foreach (var kv in _mdeWaarden)
                            {
                                var naam = kv.Key;
                                var kleur = MdeKleur(naam);
                                var aan = kleur is not null;
                                <button class="prod-mde-waarde @(aan ? "aan" : "")" title="@(aan ? "Uit de grafiek halen" : "In de grafiek zetten")"
                                        @onclick="() => WisselMdeLijn(naam)">
                                    <span class="prod-mde-kleur" style="@(aan ? $"background:{kleur}" : "")"></span>
                                    <span>@naam</span><b>@(kv.Value ?? "—")</b>
                                </button>
                            }
                            @if (_mdeReeks.Count > 0) { <div class="prod-mde-tijd"><span>Tijd</span><b>@_mdeReeks[^1].T.ToString("0.0") s · @_mdeReeks.Count metingen</b></div> }
                        </div>
                        @if (_mdeGekozen.Any(_mdeWaarden.ContainsKey) && _mdeReeks.Count > 1)
                        {
                            <div class="bankfilters prod-mde-opties">
                                <label class="bankveld prod-vink"><span>&nbsp;</span>
                                    <label title="Elke lijn op zijn eigen hoogte schalen (handig als druk en joints samen in beeld staan); uit = één gezamenlijke as">
                                        <input type="checkbox" checked="@_mdeEigenSchaal" @onchange="e => _mdeEigenSchaal = e.Value is bool b && b" /> eigen schaal per lijn</label></label>
                                <label class="bankveld"><span>Venster</span>
                                    <select value="@_mdeVenster" @onchange="e => _mdeVenster = int.TryParse((string?)e.Value, out var v) ? v : 0">
                                        <option value="0">alles</option>
                                        <option value="10">laatste 10 s</option>
                                        <option value="30">laatste 30 s</option>
                                        <option value="60">laatste minuut</option>
                                        <option value="300">laatste 5 min</option>
                                    </select></label>
                            </div>
                            @MdeGrafiek()
                        }
                        else if (_mdeWaarden.Count > 0)
                        {
                            <p class="uitleg">Klik op een waarde om hem in de grafiek te zetten.</p>
                        }
                    }
                    @if (_testCode == "dualmotion")
                    {
                        <div class="prod-dual-teach">
                            <div>
                                <b>Positie 1</b>
                                <button class="klein" disabled="@(!Mag || _taakBezig)" @onclick="() => DualTeach(1)" title="Assen met de hand op positie 1 zetten en dan de encoderstanden vastleggen">⌖ Teach pos 1</button>
                                <span class="uitleg">@DualTekst(_dmPos1)</span>
                            </div>
                            <div>
                                <b>Positie 2</b>
                                <button class="klein" disabled="@(!Mag || _taakBezig)" @onclick="() => DualTeach(2)" title="Assen met de hand op positie 2 zetten en dan de encoderstanden vastleggen">⌖ Teach pos 2</button>
                                <span class="uitleg">@DualTekst(_dmPos2)</span>
                            </div>
                        </div>
                    }
                    <label class="bankveld prod-keuze">
                        <span>Opmerking bij het resultaat (optioneel)</span>
                        <input value="@_resultaat" placeholder="bv. 3V3 = 3,31 V"
                               @oninput="e => _resultaat = (string?)e.Value ?? string.Empty" />
                    </label>
                </div>

                @if (_taakTitel.Length > 0 && _taakIsTest)
                {
                    <div class="prod-taak @(_taakFout is not null ? "nogo" : _taakKlaar ? "go" : "")">
                        <div class="prod-drives-kop">
                            <b>@_taakTitel</b>
                            <span>@(_taakBezig ? "bezig…" : _taakFout ?? _taakResultaat)</span>
                            @if (_taakBezig && _taakJobId is not null)
                            {
                                <button class="klein rood" disabled="@_taakStopGevraagd" @onclick="StopTaak">@(_taakStopGevraagd ? "stoppen…" : "■ Stop")</button>
                            }
                        </div>
                        @if (_taakBezig || _taakRegels.Count > 0)
                        {
                            <div class="prod-voortgang"><div style="width:@(_taakProcent)%"></div></div>
                        }
                        @if (_taakRegels.Count > 0)
                        {
                            <pre class="prod-log prod-log-kort">@string.Join("\n", _taakRegels.TakeLast(12))</pre>
                        }
                    </div>
                }

                @if (_sl is { } sl)
                {
                    <div class="prod-drives @(sl.Geslaagd ? "go" : "nogo")">
                        <div class="prod-drives-kop">
                            <b>@(sl.Geslaagd ? "GO" : "NO-GO")</b>
                            <span>@sl.Samenvatting</span>
                            <button class="klein" @onclick="() => _sl = null">Sluiten</button>
                        </div>
                        <svg class="prod-scope" viewBox="0 0 800 260" preserveAspectRatio="none">
                            <rect x="0" y="0" width="800" height="260" fill="#111" />
                            @for (var g = 1; g < 4; g++) { <line x1="0" y1="@(g * 65)" x2="800" y2="@(g * 65)" stroke="#333" stroke-width="1" /> }
                            <line x1="0" y1="130" x2="800" y2="130" stroke="#555" stroke-width="1" />
                            <polyline points="@sl.DemandPunten" fill="none" stroke="#e53935" stroke-width="1.5" vector-effect="non-scaling-stroke" />
                            <polyline points="@sl.WaardePunten" fill="none" stroke="#ffb300" stroke-width="1.5" vector-effect="non-scaling-stroke" />
                            <text x="6" y="14" fill="#e53935" font-size="12">demand</text>
                            <text x="66" y="14" fill="#ffb300" font-size="12">werkelijk</text>
                            <text x="794" y="14" fill="#aaa" font-size="12" text-anchor="end">±@sl.Schaal.ToString("0.##") A · @sl.Ms.ToString("0.#") ms · @sl.Hz Hz</text>
                        </svg>
                        <div class="randlabels">
                            <span class="stand-chip s-grijs">stijgtijd @sl.Stijgtijd ms (max @sl.StijgtijdMax)</span>
                            <span class="stand-chip s-grijs">overshoot @sl.Overshoot %</span>
                            <span class="stand-chip s-grijs">fout @sl.Fout %</span>
                            <span class="stand-chip s-grijs">rimpel @sl.Rimpel %</span>
                        </div>
                    </div>
                }

                @if (_testCode == "encodertest" && _etLive is { } el)
                {
                    <div class="prod-encoder-rij">
                        @WijzerPlaat(el)
                        <div class="prod-encoder-cijfers">
                            <div><span>Fase</span><b>@(el.Fase.Length > 0 ? el.Fase : "—")</b></div>
                            <div><span>Ruwe positie</span><b>@el.Positie.ToString("N0", new System.Globalization.CultureInfo("nl-NL"))</b></div>
                            <div><span>Singleturn</span><b>@el.Singleturn.ToString("N0", new System.Globalization.CultureInfo("nl-NL")) incr</b></div>
                            <div><span>Omwenteling</span><b>@el.Multiturn</b></div>
                            @if (el.StartGraden is double sg) { <div><span>Start (groene stip)</span><b>@sg.ToString("0.00")°</b></div> }
                        </div>
                    </div>
                }
                @if (_testCode == "motiontest" && _mtReeks.Count > 1)
                {
                    @RolGrafiek(_mtReeks, _mtInc)
                }
                @if (_testCode == "dualmotion" && _dm is { } dm)
                {
                    <div class="prod-drives @(dm.Geslaagd ? "go" : dm.Bezig ? "" : "nogo")">
                        <div class="prod-drives-kop"><b>@(dm.Bezig ? "BEZIG" : dm.Geslaagd ? "GO" : "NO-GO")</b><span>@dm.Samenvatting</span>@if (!dm.Bezig) { <button class="klein" @onclick="() => _dm = null">Sluiten</button> }</div>
                        <table class="kiezer-tabel smal-tabel">
                            <thead><tr><th style="width:4rem">#</th><th style="width:6rem">naar</th><th style="width:6rem">duur (s)</th><th style="width:9rem">volgfout A</th><th style="width:9rem">volgfout B</th><th>melding</th></tr></thead>
                            <tbody>
                                @foreach (var b in dm.Bewegingen)
                                {
                                    <tr class="@(b.Ok ? "" : "hist-fout")"><td>@b.Herhaling</td><td>@b.Doel</td><td>@b.Duur.ToString("0.00")</td><td>@b.VfA</td><td>@b.VfB</td><td><small>@b.Reden</small></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                @if (_testCode == "phasing" && _ph.Count > 1)
                {
                    <div class="prod-scopes-rij">
                        <div>
                            <div class="uitleg">Stroom</div>
                            @SporenGrafiek(_ph.Select(p => (p.T, p.Icmd, p.Iact)).ToList(), "Current command value", "Current actual value", "A")
                        </div>
                        <div>
                            <div class="uitleg">Hoek</div>
                            @SporenGrafiek(_ph.Select(p => (p.T, p.Ref, p.Commu)).ToList(), "Reference angle value", "Commutation angle value", "")
                        </div>
                    </div>
                }
                @if (_et is { } et)
                {
                    <div class="prod-drives @(et.Geslaagd ? "go" : "nogo")">
                        <div class="prod-drives-kop"><b>@(et.Geslaagd ? "GO" : "NO-GO")</b><span>@et.Samenvatting</span><button class="klein" @onclick="() => _et = null">Sluiten</button></div>
                        <div class="randlabels">
                            <span class="stand-chip s-grijs">verwacht @et.Verwacht</span>
                            <span class="stand-chip @(et.FoutVooruit <= et.Marge ? "s-groen" : "s-rood")">vooruit @et.Vooruit (@et.FoutVooruit.ToString("0.00") %)</span>
                            <span class="stand-chip @(et.FoutTerug <= et.Marge ? "s-groen" : "s-rood")">terug @et.Terug (@et.FoutTerug.ToString("0.00") %)</span>
                            <span class="stand-chip @(et.Symmetrie <= et.Marge ? "s-groen" : "s-rood")">symmetrie @et.Symmetrie.ToString("0.00") %</span>
                            <span class="stand-chip s-grijs">polariteit @et.Polariteit · @et.Poolparen poolparen</span>
                        </div>
                    </div>
                }
                @if (_mt is { } mt)
                {
                    <div class="prod-drives @(mt.Geslaagd ? "go" : "nogo")">
                        <div class="prod-drives-kop"><b>@(mt.Geslaagd ? "GO" : "NO-GO")</b><span>@mt.Samenvatting</span><button class="klein" @onclick="() => _mt = null">Sluiten</button></div>
                        <table class="kiezer-tabel smal-tabel">
                            <thead><tr><th style="width:6rem">rpm</th><th style="width:4rem">#</th><th style="width:6rem">richting</th><th style="width:6rem">duur (s)</th><th style="width:8rem">volgfout max</th><th>melding</th></tr></thead>
                            <tbody>
                                @foreach (var b in mt.Bewegingen)
                                {
                                    <tr class="@(b.Ok ? "" : "hist-fout")"><td>@b.Rpm</td><td>@b.Herhaling</td><td>@b.Richting</td><td>@b.Duur.ToString("0.00")</td><td>@b.Volgfout</td><td><small>@b.Reden</small></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (_testHistorie.Count > 0)
                {
                    <h4 class="wn-kop">Eerdere testen van dit exemplaar</h4>
                    <table class="kiezer-tabel smal-tabel">
                        <tbody>
                            @foreach (var h in _testHistorie)
                            {
                                <tr class="@(h.Uitkomst == false ? "hist-fout" : h.Uitkomst == true ? "hist-ok" : "")">
                                    <td style="width:9rem">@(h.Wanneer?.ToString("dd-MM-yyyy HH:mm") ?? "")</td>
                                    <td>@h.Event</td>
                                    <td style="width:8rem">@h.Door</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
}

@* Gedeeld voortgangsvenster voor alle taken via de agent. Blijft staan tot de volgende taak. *@
@if (_taakTitel.Length > 0 && !(_taakIsTest && _testOpen))
{
    <div class="prod-taak @(_taakFout is not null ? "nogo" : _taakKlaar ? "go" : "")">
        <div class="prod-drives-kop">
            <b>@_taakTitel</b>
            <span>@(_taakBezig ? "bezig…" : _taakFout ?? _taakResultaat)</span>
            @if (_taakBezig && _taakJobId is not null)
            {
                <button class="klein rood" disabled="@_taakStopGevraagd" @onclick="StopTaak"
                        title="Vraagt de agent de taak netjes af te ronden; bij CAN meeluisteren krijg je het resultaat tot nu toe">
                    @(_taakStopGevraagd ? "stoppen…" : "■ Stop")
                </button>
            }
            else if (!_taakBezig)
            {
                <button class="klein" @onclick="() => _taakTitel = string.Empty">Sluiten</button>
            }
        </div>
        @if (_taakBezig || _taakRegels.Count > 0)
        {
            <div class="prod-voortgang"><div style="width:@(_taakProcent)%"></div></div>
        }
        @if (_taakRegels.Count > 0)
        {
            <pre class="prod-log">@string.Join("\n", _taakRegels)</pre>
        }
    </div>
}

@* ---------- opbouw en eindcontrole (werkplek) ---------- *@
@if (ToonOpbouwStap && ToonOpbouw)
{
    @Kop(NrOpbouw, "Opbouw en eindcontrole")
    <OpbouwLijst ProductNameId="Naam.Id" ProductId="ProductId" HuidigeStatus="@Exemplaar.StatusKort" OpGewijzigd="OpGewijzigd" OpGereed="OpGereed" />
}

@* ---------- duurtest (producten): log van de testrig-PLC als document ---------- *@
@if (ToonDuurtestStap && Duurtest.Beschikbaar && Naam.ToonStap(ProductStap.Duurtest))
{
    @Kop(NrDuurtest, "Duurtest")
    <p class="uitleg">
        Zet het product in de testrig, koppel het aan de PLC en draai het testprogramma (de PLC maakt de logmap
        leeg bij het starten). Is de test klaar, haal dan de log op: die wordt als zip bij dit exemplaar bewaard.
        <small>(@Duurtest.Omschrijving)</small>
    </p>
    <div class="btngroup">
        <button class="primair" disabled="@(!Mag || _duurBezig)" @onclick="HaalDuurtestLog"
                title="Logmap via FTP van de testrig-PLC ophalen, zippen en als document opslaan">
            @(_duurBezig ? "⏳ Bezig met ophalen…" : "⬇ Duurtestlog ophalen")
        </button>
        @if (_duurResultaat is { } dr)
        {
            <span class="stand-chip s-groen">✔ @dr.Bestanden bestand(en) → <a href="@("bestand/" + dr.FileStoreId + "/download")">@dr.Bestandsnaam</a></span>
        }
        @if (_duurFout is not null)
        {
            <span class="uitleg fout-tekst">@_duurFout</span>
        }
    </div>
    @if (_duurRegels.Count > 0)
    {
        <pre class="prod-log">@string.Join("\n", _duurRegels)</pre>
    }
}

@* ---------- EtherCAT node-adressen (station alias): lezen, nieuw nummer invoeren, Write to slaves ---------- *@
@if (_aliasOpen)
{
    <div class="cmdk-overlay midden">
        <div class="fusion-kijker ec-venster verplaatsbaar prod-alias-venster">
            <div class="sleepkop fusion-kijker-kop">
                <b>🏷 EtherCAT node-adressen — @Naam.Naam · @Exemplaar.Serienummer</b>
                <span style="flex:1"></span>
                <button class="klein" @onclick="() => _aliasOpen = false">✕ Sluiten</button>
            </div>
            <div class="fusion-kijker-inhoud">
                <div class="bankfilters">
                    <button class="klein" disabled="@_taakBezig" @onclick="LeesAlias" title="Alle slaves op de bus opnieuw lezen">↻ Lezen</button>
                    <button class="klein primair" disabled="@(!Mag || _taakBezig || !AliasWijzigingen.Any())" @onclick="SchrijfAlias"
                            title="Schrijft de gewijzigde node-nummers in de EEPROM van de slaves (EtherCAT 'Configured Station Alias', register 0x0012) — TwinCAT 'Write to slaves'">
                        ✎ Write to slaves (@AliasWijzigingen.Count())
                    </button>
                    <span class="uitleg">Nieuw nummer leeg laten = ongewijzigd. Bereik 0–65535; 0 = geen node-nummer.</span>
                </div>
                @if (_aliasSlaves.Count == 0)
                {
                    <p class="uitleg">@(_taakBezig ? "Bus wordt gelezen…" : "Nog niets gelezen.")</p>
                }
                else
                {
                    <table class="kiezer-tabel smal-tabel">
                        <thead><tr><th style="width:4rem">Pos.</th><th>Slave</th><th style="width:8rem">Productcode</th><th style="width:7rem">Huidig node</th><th style="width:8rem">Nieuw node</th><th>Melding</th></tr></thead>
                        <tbody>
                            @foreach (var a in _aliasSlaves)
                            {
                                var rij = a;
                                <tr @key="rij.Positie" class="@(rij.Melding.StartsWith("schrijven mislukt") ? "ec-fout" : rij.Geschreven ? "hist-ok" : "")">
                                    <td><b>@rij.Positie</b></td>
                                    <td>@rij.Naam</td>
                                    <td><small>@rij.ProductCode</small></td>
                                    <td><b>@(rij.Alias?.ToString() ?? "?")</b>@if (rij.AliasEeprom is int ee && rij.AliasRegister is int rr && ee != rr) { <small class="uitleg" title="EEPROM en register verschillen: het EEPROM-nummer geldt na spanning uit/aan"> (EEPROM @ee)</small> }</td>
                                    <td><input type="number" min="0" max="65535" style="width:6.5rem" placeholder="@rij.Alias" value="@rij.Nieuw" disabled="@_taakBezig"
                                               @onchange="ev => rij.Nieuw = int.TryParse((string?)ev.Value, out var v) && v is >= 0 and <= 65535 ? v : null" /></td>
                                    <td><small class="uitleg">@rij.Melding</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
}



