@if (_encOpen && _encPositie is { } ep)
{
    <div class="cmdk-overlay midden">
        <div class="fusion-kijker ec-venster verplaatsbaar prod-encoder-venster">
            <div class="sleepkop fusion-kijker-kop">
                <b>◎ Encoder — drive @ep.Positie (@ep.Naam) · @Naam.Naam @Exemplaar.Serienummer</b>
                <span style="flex:1"></span>
                <button class="klein" @onclick="SluitEncoder">✕ Sluiten</button>
            </div>
            <div class="fusion-kijker-inhoud prod-encoder">
                <div class="bankfilters">
                    @if (!_encLoopt)
                    {
                        <button class="primair klein" disabled="@_taakBezig" @onclick="() => StartEncoder(ep)">▶ Live</button>
                    }
                    else
                    {
                        <button class="klein rood" @onclick="StopEncoder">■ Stop</button>
                    }
                    <span class="uitleg">@_encStatus</span>
                </div>
                <div class="prod-encoder-rij">
                    @WijzerPlaat(_enc)
                    <div class="prod-encoder-cijfers">
                        <div title="CL_POS_FBK_VALUE"><span>Position actual value <small class="uitleg">CL_POS_FBK_VALUE · 0x2030</small></span><b>@_enc.Positie.ToString("N0", new System.Globalization.CultureInfo("nl-NL"))</b></div>
                        <div title="@_enc.BissPositionUid"><span>Primary Absolute Slave 1 - Position <small class="uitleg">FBK_BISS1_SSI1_POS_VALUE · 0x204A</small></span><b>@(_enc.BissPosition.Length > 0 ? Groot(_enc.BissPosition) : "—")</b></div>
                        <div title="@_enc.FullFrameUid"><span>Primary Absolute Slave 1 - Full frame <small class="uitleg">FBK_BISS1_SSI1_FULL_FRAME_VALUE · 0x204B</small></span><b>@(_enc.FullFrame.Length > 0 ? Groot(_enc.FullFrame) : "—")</b></div>
                        @if (long.TryParse(_enc.FullFrame, out var ff))
                        {
                            // BiSS-C frame van de Mosrac (LSB eerst): bit 0–5 CRC-6, bit 6 warning, bit 7 error (beide actief-laag:
                            // 1 = in orde), bit 8–24 singleturn (17), bit 25–39 multiturn (15).
                            var crc = ff & 0x3F;
                            var warn = (ff >> 6) & 1;
                            var err = (ff >> 7) & 1;
                            var st = (ff >> 8) & 0x1FFFF;
                            // Is het register maar 32 bits breed, dan levert de drive alleen de onderste 7 MT-bits (bit 25–31).
                            var breed = _enc.FullFrameDtype.Contains("64", StringComparison.OrdinalIgnoreCase) || ff > 0xFFFFFFFFL;
                            var mtBits = breed ? 15 : 7;
                            var mt = (ff >> 25) & ((1L << mtBits) - 1);
                            <div class="prod-bits">
                                <span>Full frame ontleed <small class="uitleg">BiSS-C frame Mosrac, LSB eerst: bit 25–39 MT, 8–24 ST, 7 error, 6 warning, 0–5 CRC-6 · register @(_enc.FullFrameDtype.Length > 0 ? _enc.FullFrameDtype : "?")</small></span>
                                @if (!breed)
                                {
                                    <p class="fout-tekst">⚠ Het register 0x204B is 32 bits breed (@_enc.FullFrameDtype): van de 15 multiturn-bits komen er maar 7 door (bit 25–31), de bovenste 8 worden door de drive afgekapt. Het volledige 40-bit frame is via dit register niet op te halen.</p>
                                }
                                <table class="kiezer-tabel smal-tabel bits-tabel">
                                    <colgroup><col class="k-veld" /><col class="k-bits" /><col class="k-bin" /><col class="k-dec" /><col class="k-bet" /></colgroup>
                                    <thead><tr><th style="width:7rem">Veld</th><th style="width:8rem">Bits</th><th class="r">Binair</th><th class="r" style="width:9rem">Decimaal</th><th style="width:14rem">Betekenis</th></tr></thead>
                                    <tbody>
                                        <tr><td><b>Multiturn</b></td><td>@(breed ? "39–25 (15)" : "31–25 (7 van 15)")</td><td class="r"><span class="bits-mt">@Groepen(Convert.ToString(mt, 2).PadLeft(mtBits, '0'))</span></td><td class="r">@mt.ToString("N0", new System.Globalization.CultureInfo("nl-NL"))</td><td>@(breed ? "omwentelingen" : "onderste 7 bits")</td></tr>
                                        <tr><td><b>Singleturn</b></td><td>24–8 (17)</td><td class="r"><span class="bits-st">@Groepen(Convert.ToString(st, 2).PadLeft(17, '0'))</span></td><td class="r">@st.ToString("N0", new System.Globalization.CultureInfo("nl-NL"))</td><td>@((st / 131072.0 * 360).ToString("0.00"))°</td></tr>
                                        <tr class="@(err == 1 ? "" : "bits-rij-fout")"><td><b>Error</b></td><td>7 (1)</td><td class="r"><span class="@(err == 1 ? "bits-ok" : "bits-fout")">@err</span></td><td class="r">@err</td><td>@(err == 1 ? "geen fout" : "FOUT (actief-laag)")</td></tr>
                                        <tr class="@(warn == 1 ? "" : "bits-rij-waarschuwing")"><td><b>Warning</b></td><td>6 (1)</td><td class="r"><span class="@(warn == 1 ? "bits-ok" : "bits-waarschuwing")">@warn</span></td><td class="r">@warn</td><td>@(warn == 1 ? "geen waarschuwing" : "WAARSCHUWING (actief-laag)")</td></tr>
                                        <tr><td><b>CRC-6</b></td><td>5–0 (6)</td><td class="r"><span class="bits-crc">@Convert.ToString(crc, 2).PadLeft(6, '0')</span></td><td class="r">@crc (0x@(crc.ToString("X2")))</td><td>x⁶+x+1, geïnverteerd</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        }
                        <div title="@_enc.PositionOffsetUid"><span>Primary Absolute Slave 1 - Position offset <small class="uitleg">FBK_BISS1_SSI1_OFFSET · 0x2438</small></span><b>@(_enc.PositionOffset.Length > 0 ? Groot(_enc.PositionOffset) : "—")</b></div>
                        <div><span>Singleturn</span><b>@_enc.Singleturn.ToString("N0", new System.Globalization.CultureInfo("nl-NL")) incr</b></div>
                        <div><span>Multiturn <small class="uitleg">uit Position actual value ÷ resolutie</small></span><b>@_enc.Multiturn</b></div>
                        <div><span>Resolutie</span><b>@_enc.Resolutie incr/omw</b></div>
                        <div><span>Snelheid</span><b>@_enc.Snelheid.ToString("0.000") rev/s (@((_enc.Snelheid * 60).ToString("0")) rpm)</b></div>
                        <div><span>Metingen</span><b>@_enc.N (@_enc.T.ToString("0") s)</b></div>
                        @if (_enc.NabijGrens)
                        {
                            <p class="fout-tekst">⚠ Positie vlak bij 2³¹: bij omgekeerde encoderpolariteit rekent de drive positie = 2³¹ − telling (Ingenia); zie de positie-offset (0x2438) in MotionLab.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* ---------- objectdictionary van een CoE-drive (eRob): alles lezen, losse SDO's testen, CAN meeluisteren ---------- *@
@if (_odOpen && _odPositie is { } odp)
{
    <div class="cmdk-overlay midden">
        <div class="fusion-kijker ec-venster verplaatsbaar prod-od-venster">
            <div class="sleepkop fusion-kijker-kop">
                <b>🔎 Objectdictionary — drive @odp.Positie (@odp.Naam) · @odp.DriveTypeNaam</b>
                <span style="flex:1"></span>
                <button class="klein" @onclick="() => _odOpen = false" title="Een lopende taak loopt gewoon door; die volg je in het voortgangsvenster">✕ Sluiten</button>
            </div>
            <div class="fusion-kijker-inhoud">
                <div class="bankfilters">
                    <button class="primair klein" disabled="@_taakBezig" @onclick="() => LeesDictionary(odp)"
                            title="Elk objectindex proberen te lezen en de waarde van elk leesbaar object tonen (½–3 minuten)">
                        @(_taakBezig ? "⏳ Bezig…" : "⟳ Alles lezen")
                    </button>
                    <label class="bankveld prod-keuze">
                        <span>Filter (index, naam, waarde)</span>
                        <input value="@_odFilter" placeholder="bv. 3B6, torque, 0x60" @oninput="e => _odFilter = ((string?)e.Value ?? string.Empty).Trim()" />
                    </label>
                    <label class="bankveld prod-vink">
                        <span>&nbsp;</span>
                        <label><input type="checkbox" checked="@_odAlleenOngedoc" @onchange="e => _odAlleenOngedoc = (bool)e.Value!" /> alleen wat in ESI noch handleiding staat</label>
                    </label>
                    <label class="bankveld prod-vink" title="Ook subindex 1+ proberen bij indexen zonder sub 0 (vendorobjecten zonder teller); duurt ongeveer twee keer zo lang">
                        <span>&nbsp;</span>
                        <label><input type="checkbox" checked="@_odGrondig" disabled="@_taakBezig" @onchange="e => _odGrondig = (bool)e.Value!" /> grondig (ook subs zonder sub 0)</label>
                    </label>
                    @if (_od.Count > 0)
                    {
                        <a class="knopje" href="@OdCsvUrl" download="@OdCsvNaam" title="Als CSV opslaan (voor ZeroErr of ter vergelijking)">⬇ CSV (@_od.Count)</a>
                    }
                </div>

                @* Losse SDO: lezen of schrijven — voor het testen van de objecten die ZeroErr opgeeft. *@
                <div class="bankfilters prod-sdo">
                    <span class="prod-prog-pos"><b>SDO</b> <small class="uitleg">lezen / schrijven</small></span>
                    <label class="bankveld"><span>Index</span><input value="@_sdoIndex" style="width:6rem" placeholder="0x3B64" @onchange="e => _sdoIndex = ((string?)e.Value ?? string.Empty).Trim()" /></label>
                    <label class="bankveld"><span>Sub</span><input value="@_sdoSub" style="width:3.5rem" @onchange="SdoSubGewijzigd" /></label>
                    <label class="bankveld"><span>Type</span>
                        <select value="@_sdoType" @onchange="SdoTypeGewijzigd">
                            @foreach (var t in new[] { "UDINT", "DINT", "UINT", "INT", "USINT", "SINT", "REAL", "STRING" }) { <option value="@t">@t</option> }
                        </select>
                    </label>
                    <label class="bankveld"><span>Waarde (leeg = alleen lezen)</span><input value="@_sdoWaarde" style="width:8rem" @onchange="e => _sdoWaarde = ((string?)e.Value ?? string.Empty).Trim()" /></label>
                    <label class="bankveld prod-vink"><span>&nbsp;</span><label><input type="checkbox" checked="@_sdoOpslaan" @onchange="e => _sdoOpslaan = (bool)e.Value!" /> daarna opslaan (0x1010)</label></label>
                    <button class="klein" disabled="@(_taakBezig || _sdoIndex.Length == 0)" @onclick="() => DoeSdo(odp, false)">Lees</button>
                    <button class="klein rood" disabled="@(!Mag || _taakBezig || _sdoIndex.Length == 0 || _sdoWaarde.Length == 0)" @onclick="() => DoeSdo(odp, true)"
                            title="Schrijft de waarde en leest hem terug — alleen doen als je weet wat het object doet">Schrijf</button>
                    @if (_sdoUitkomst is not null) { <span class="uitleg">@_sdoUitkomst</span> }
                </div>

                @* CAN meeluisteren met een tweede USBCAN: wat schrijft/leest eRob-Studio? *@
                <div class="bankfilters prod-sdo prod-can">
                    <span class="prod-prog-pos"><b>🎧 CAN</b> <small class="uitleg">meeluisteren (2e USBCAN)</small></span>
                    <label class="bankveld"><span>Seconden</span><input type="number" min="5" max="600" value="@_canSeconden" style="width:5rem" disabled="@_taakBezig"
                           @onchange="e => _canSeconden = int.TryParse((string?)e.Value, out var v) ? Math.Clamp(v, 5, 600) : 30" /></label>
                    <label class="bankveld"><span>kbit/s</span>
                        <select value="@_canBaud" disabled="@_taakBezig" @onchange="e => _canBaud = int.TryParse((string?)e.Value, out var v) ? v : 1000">
                            @foreach (var b in new[] { 1000, 500, 250, 125 }) { <option value="@b">@b</option> }
                        </select>
                    </label>
                    <label class="bankveld"><span>Kanaal</span>
                        <select value="@_canKanaal" disabled="@_taakBezig" @onchange="e => _canKanaal = int.TryParse((string?)e.Value, out var v) ? v : 0">
                            <option value="0">CAN1</option><option value="1">CAN2</option>
                        </select>
                    </label>
                    <button class="klein" disabled="@_taakBezig" @onclick="StartCanSniff"
                            title="Start, en doe daarna in eRob-Studio 'Apply' of open het Information-venster; elk bericht (CANopen-SDO of eRob CAN-protocol) wordt vertaald naar index:sub = waarde">▶ Luisteren</button>
                    @if (_can.Count > 0) { <span class="uitleg">@_can.Count berichten · <a href="@CanCsvUrl" download="@CanCsvNaam">⬇ CSV</a></span> }
                </div>

                @* eRob identificatie via het ZeroErr CAN-protocol (index 0x232): serienummer, model, hardware, partnummer *@
                <div class="bankfilters prod-sdo prod-can">
                    <span class="prod-prog-pos"><b>🪪 eRob-info</b> <small class="uitleg">via CAN (ZeroErr-protocol, index 0x232)</small></span>
                    <label class="bankveld"><span>Drive-ID</span><input type="number" min="1" max="127" placeholder="auto" value="@_erobCanId" style="width:5rem" disabled="@_taakBezig"
                           @onchange="e => _erobCanId = int.TryParse((string?)e.Value, out var v) && v is >= 1 and <= 127 ? v : null" /></label>
                    <button class="klein primair" disabled="@_taakBezig" @onclick="() => LeesErobInfo(odp)"
                            title="Zendt leesopdrachten over de tweede USBCAN. Sluit eRob-Studio liefst even, dan praten er geen twee masters">🪪 Info lezen</button>
                    @if (_erobInfo is { } ei)
                    {
                        <span class="uitleg">
                            @if (ei.Serienummer.Length > 0) { <text>SN <b>@ei.Serienummer</b> · </text> }
                            @if (ei.Model.Length > 0) { <text>@ei.Model · </text> }
                            @if (ei.Hardware.Length > 0) { <text>hw @ei.Hardware · </text> }
                            @if (ei.Partnummer.Length > 0) { <text>PN @ei.Partnummer · </text> }
                            @if (ei.Firmware.Length > 0) { <text>fw @ei.Firmware</text> }
                        </span>
                        @if (ei.Serienummer.Length > 0 && Mag)
                        {
                            <button class="klein" disabled="@_taakBezig" @onclick="() => ZetErobInfoInAttributen(odp)"
                                    title="Schrijft serienummer, hardware en firmware in de attributen van drive @odp.Positie (bronnen drive:n:serienummer / hardware / firmware)">→ in attributen</button>
                        }
                    }
                </div>
                @if (_can.Count > 0)
                {
                    <table class="kiezer-tabel od-tabel">
                        <thead><tr><th style="width:5rem">t (s)</th><th style="width:4rem">node</th><th style="width:4.5rem">protocol</th><th style="width:7rem">richting</th><th style="width:7rem">index:sub</th><th>naam (ESI/handleiding)</th><th style="width:10rem">waarde</th><th style="width:8rem">hex</th></tr></thead>
                        <tbody>
                            @foreach (var c in _can)
                            {
                                <tr @key="@($"{c.T}-{c.Index}-{c.Sub}-{c.Richting}")" class="@(c.Richting is "download" or "schrijf" or "commando" ? "hist-ok" : c.Richting is "abort" or "fout" or "foutcode" ? "hist-fout" : "")">
                                    <td>@c.T.ToString("0.000")</td><td>@c.Node</td><td><small>@c.Protocol</small></td><td>@c.Richting</td>
                                    <td>@if (c.Protocol == "erob") { <span>@c.Index:@c.Sub</span> } else { <button class="knopje" title="In het SDO-vak zetten" @onclick="() => KiesCan(c)">@c.Index:@c.Sub</button> }</td>
                                    <td>@NaamVoor(c)</td><td>@c.Waarde</td><td><small>@c.Hex</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p class="uitleg">Groen = eRob-Studio schrijft (CANopen 'download' of eRob 'schrijf'/'commando') — dat zijn de instellingen; 'antwoord' = waarde die de drive teruggeeft op een leesverzoek; rood = afgewezen. eRob-indexen (protocol 'erob') zijn het eigen ZeroErr-protocol en bestaan niet als EtherCAT-object.</p>
                }

                @if (_od.Count > 0)
                {
                    <table class="kiezer-tabel od-tabel">
                        <thead>
                            <tr>
                                <th style="width:5rem">Index</th><th style="width:3rem">Sub</th><th>Naam</th>
                                <th style="width:6rem">Type</th><th style="width:5rem">Toegang</th><th style="width:10rem">Waarde</th><th style="width:8rem">Hex</th><th>Fout</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in OdGefilterd)
                            {
                                <tr @key="@($"{r.Index}:{r.Sub}")" class="@(r.Fout.Length > 0 ? "hist-fout" : "")">
                                    <td><button class="knopje" title="In het SDO-vak zetten" @onclick="() => KiesOd(r)">@r.Index</button></td>
                                    <td>@r.Sub</td><td>@r.Naam</td><td>@r.Type</td><td>@r.Toegang</td>
                                    <td>@r.Waarde</td><td><small>@r.Hex</small></td><td><small class="uitleg">@r.Fout</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p class="uitleg">
                        Toegang: bij objecten uit het ESI of de handleiding is dit wat die zeggen (ro/rw, B = backup). Bij '(niet in ESI)' staat alleen <b>r</b>: de agent weet
                        enkel dat lezen lukte — of schrijven ook kan, test je met de SDO-regel (dezelfde waarde terugschrijven; een abort
                        'read-only object' betekent nee). Rode regels: lezen mislukte (bv. alleen schrijfbaar of niet in deze toestand).
                    </p>
                }
                else if (!_taakBezig)
                {
                    <p class="uitleg">Klik 'Alles lezen'. De agent probeert elk objectindex te lezen (0x1000…, 0x2000–0x5FFF, 0x6000–0x6FFF; duurt ½–3 minuten, voortgang in het log) en de app plakt de namen uit het ESI-bestand en de handleiding erbij. Wat overblijft als '(niet in ESI)' zijn de kandidaten voor de eRob-Studio-instellingen.</p>
                }
            </div>
        </div>
    </div>
}

@* ---------- firmware laden (popup) ---------- *@
@if (_firmwareOpen)
{
    <div class="cmdk-overlay midden">
        <div class="fusion-kijker ec-venster verplaatsbaar prod-flash">
            <div class="sleepkop fusion-kijker-kop">
                <b>⚡ Firmware laden — @Naam.Naam · @Exemplaar.Serienummer</b>
                <span style="flex:1"></span>
                <button class="klein" disabled="@(_flashJob is not null)" @onclick="SluitFirmware">✕ Sluiten</button>
            </div>
            <div class="fusion-kijker-inhoud">
                <div class="bankfilters">
                    <label class="bankveld">
                        <span>Chip</span>
                        <select value="@_chip" disabled="@(_flashJob is not null)"
                                @onchange="ChipGewijzigd">
                            <option value="esp32">ESP32 (USB-UART, esptool)</option>
                            <option value="stm32">STM32 (ST-LINK)</option>
                        </select>
                    </label>
                    @if (ChipFirmwares.Any())
                    {
                        <label class="bankveld prod-keuze">
                            <span>Firmware (uit de tabel)</span>
                            <select value="@_firmwareKeuzeId" disabled="@(_flashJob is not null)" @onchange="FirmwareKeuzeGewijzigd">
                                @foreach (var f in ChipFirmwares)
                                {
                                    <option value="@f.Id">@FirmwareOptie(f)</option>
                                }
                                <option value="0">— eigen bestand kiezen… —</option>
                            </select>
                        </label>
                    }
                    @if (!ChipFirmwares.Any())
                    {
                        <span class="uitleg">@(ChipTypenOpPrint.Count == 0 && _posities.Any(p => p.DriveTypeId is not null)
                            ? $"Geen positie van dit halffabricaat heeft een {_chip.ToUpper()}- of MDE-controllertype; alleen een eigen bestand kan."
                            : "Geen firmwareversies in de tabel voor dit halffabricaat (Controllertypen ▸ firmware).")</span>
                    }
                    @if (_firmwareKeuzeId == 0)
                    {
                        <label class="bankveld prod-keuze">
                            <span>Firmwarebestand (@(_chip == "esp32" ? ".hex of samengevoegde .bin" : ".hex / .elf / .bin"))</span>
                            <InputFile OnChange="FirmwareGekozen" disabled="@(_flashJob is not null)" accept=".hex,.bin,.elf" />
                        </label>
                    }
                    @if (_chip == "esp32" && !FirmwareIsHex)
                    {
                        <label class="bankveld" title="0x0 voor een samengevoegd image (bootloader + partitietabel + app), 0x10000 voor een los app-image. De agent herkent het soort bestand en zet een app-image nooit op 0x0 (dat overschrijft de bootloader).">
                            <span>Offset</span>
                            <input value="@_offset" style="width:7rem" disabled="@(_flashJob is not null)"
                                   @onchange="OffsetGewijzigd" />
                        </label>
                        <label class="bankveld prod-vink">
                            <span>&nbsp;</span>
                            <label><input type="checkbox" checked="@_wissen" disabled="@(_flashJob is not null)"
                                          @onchange="e => _wissen = (bool)e.Value!" /> eerst flash wissen</label>
                        </label>
                    }
                    else if (_chip == "esp32")
                    {
                        <label class="bankveld prod-vink">
                            <span>&nbsp;</span>
                            <label><input type="checkbox" checked="@_wissen" disabled="@(_flashJob is not null)"
                                          @onchange="e => _wissen = (bool)e.Value!" /> eerst flash wissen</label>
                        </label>
                    }
                    else if (!FirmwareIsHex)
                    {
                        <label class="bankveld">
                            <span>Adres (alleen .bin)</span>
                            <input value="@_adres" style="width:8rem" disabled="@(_flashJob is not null)"
                                   @onchange="AdresGewijzigd" />
                        </label>
                    }
                    <button class="primair" disabled="@(!Mag || _flashJob is not null || !KanFlashen)" @onclick="StartFlash">
                        @(_flashJob is not null ? "Bezig…" : "Start")
                    </button>
                </div>
                @if (GekozenFirmware is { } gf)
                {
                    <p class="uitleg">
                        Versie <b>@gf.Versie</b> <span class="stand-chip @DriveStatus.Kleur(gf.Status)">@gf.Status</span>
                        · @gf.FirmwareBestand
                        @if (gf.Status == DriveStatus.Geblokkeerd) { <b class="fout-tekst"> — geblokkeerd, niet laden</b> }
                        @if (gf.FirmwareFileId is null) { <b class="fout-tekst"> — geen bestand bij deze versie (Controllertypen en firmware)</b> }
                    </p>
                }
                else if (_firmwareNaam.Length > 0)
                {
                    <p class="uitleg">Klaargezet: <b>@_firmwareNaam</b> (@(_firmwareBytes / 1024) kB)</p>
                }

                @if (_flashJob is not null || _flashRegels.Count > 0)
                {
                    <div class="prod-voortgang"><div style="width:@(_flashProcent)%"></div></div>
                    <pre class="prod-log">@string.Join("\n", _flashRegels)</pre>
                }
                @if (_flashFout is not null)
                {
                    <p class="uitleg fout-tekst">@_flashFout</p>
                }
                @if (_flashResultaat is not null)
                {
                    <p class="uitleg"><b>Gelukt.</b> @_flashResultaat — opgeslagen bij het exemplaar.</p>
                }
            </div>
        </div>
    </div>
}

@code {
    // ---------------------------------------------------------------- parameters

    /// <summary>Het producttype (met de Stappen-vlaggen en groep).</summary>
    [Parameter, EditorRequired] public ProductNaam Naam { get; set; } = null!;
    /// <summary>Het exemplaar zoals het in de lijst staat (serienummer, status).</summary>
    [Parameter, EditorRequired] public ProductRegel Exemplaar { get; set; } = null!;
    [Parameter, EditorRequired] public int ProductId { get; set; }
    /// <summary>Motor programmeren: servo ook zonder vastgelegde techniek.</summary>
    [Parameter] public bool MotorModus { get; set; }
    /// <summary>Stapnummers tonen (werkplek); in een tabblad zonder.</summary>
    [Parameter] public bool MetNummers { get; set; } = true;
    /// <summary>Nummer van de eerste stap hier (werkplek: 4, na halffabricaat/serienummer/exemplaar).</summary>
    [Parameter] public int StartNummer { get; set; } = 4;
    /// <summary>De afvinklijst (opbouw + eindcontrole + Product gereed) hier tonen — op de werkplek wel, in Producten heeft dat eigen tabs.</summary>
    [Parameter] public bool ToonOpbouwStap { get; set; }
    /// <summary>De duurtest (log van de testrig-PLC) hier tonen — alleen bij eindproducten.</summary>
    [Parameter] public bool ToonDuurtestStap { get; set; }
    /// <summary>Na elke wijziging aan attributen/historie/status, zodat de aanroeper kaart en historie kan verversen.</summary>
    [Parameter] public EventCallback OpGewijzigd { get; set; }
    /// <summary>Doorgegeven aan de afvinklijst: status op 'Gereed' gezet.</summary>
    [Parameter] public EventCallback<string> OpGereed { get; set; }

    // ---------------------------------------------------------------- rechten

    /// <summary>Recht (naam uit de rechtentabel) dat nodig is om te bedienen; leeg = iedereen. Productie:RechtProgrammeren.</summary>
    private string _recht = "";
    private bool Mag => _recht.Length == 0 || !Ik.Gekoppeld || Ik.Mag(_recht);

    // ---------------------------------------------------------------- toestand

    private List<Keuze> _soorten = new();
    private int? _soortId;
    private List<ProductAttribuut> _attributen = new();
    private List<ProductAttribuut> _sjabloon = new();   // standaardattributen van het type, met Bron
    private int _geladenVoor = -1;

    private string _resultaat = "";
    private bool _bezig;
    private string? _melding;
    private bool _fout;

    private List<DrivePositie> _posities = new();
    private HashSet<string> _technieken = new(StringComparer.OrdinalIgnoreCase);   // drives / esp32 / stm32 / feetech
    private bool HeeftDrives => AantalTechnieken == 0 ? DrivePosities.Count > 0 : _technieken.Contains(ProductTechniek.Drives);

    /// <summary>Posities van echte drives/servo's; een ESP32/STM32-positie (chip) hoort bij 'chip programmeren', niet op de bus.</summary>
    private List<DrivePositie> DrivePosities => _posities
        .Where(p => !(p.DriveTypeId is int t && _driveTypen.FirstOrDefault(x => x.Id == t) is { } dt && DriveProtocol.IsChip(dt.Protocol)))
        .ToList();
    private bool HeeftChip => _technieken.Contains(ProductTechniek.Esp32) || _technieken.Contains(ProductTechniek.Stm32);
    // ---- EEPROM vullen uit het ESI (mde.eeprom) ----
    private bool EepromVullenAan => _technieken.Contains(ProductTechniek.EepromVullen);

    /// <summary>De firmwareversie van dit type met een ESI-bestand (actueel eerst); null als er geen ESI is.</summary>
    private DriveFirmware? EsiVoor(DrivePositie p)
        => _alleFirmwares.Where(f => f.DriveTypeId == p.DriveTypeId && f.EsiFileId is not null)
                         .OrderBy(f => f.Status == DriveStatus.Actueel ? 0 : 1).FirstOrDefault();

    private object EepromBody(DrivePositie p, bool vergelijken, bool overschrijven) => new
    {
        positie = p.Positie, esi = BestandUrl(EsiVoor(p)!.EsiFileId!.Value), serienummer = SerienummerGetal ?? 0,
        alleen_vergelijken = vergelijken, overschrijven,
    };

    private async Task VergelijkEeprom(DrivePositie p)
    {
        if (EsiVoor(p) is null) return;
        await VoerTaakUit("mde.eeprom", JsonSerializer.Serialize(EepromBody(p, true, false)), $"EEPROM vergelijken — slave {p.Positie} ({p.Naam})", 120,
            res => Task.FromResult(res.ValueKind == JsonValueKind.Object && res.TryGetProperty("gelijk", out var g) && g.ValueKind == JsonValueKind.True
                ? "de EEPROM is gelijk aan het ESI"
                : $"de EEPROM wijkt af van het ESI ({(res.ValueKind == JsonValueKind.Object && res.TryGetProperty("verschillen", out var v) && v.ValueKind == JsonValueKind.Array ? v.GetArrayLength() : 0)} delen, zie het logboek)"));
    }

    private async Task VulEeprom(DrivePositie p, bool overschrijven = false)
    {
        var fw = EsiVoor(p);
        if (fw is null) return;
        var sn = SerienummerGetal;
        if (!overschrijven && !await Bevestig($"De EEPROM van slave {p.Positie} ({p.Naam}) vullen uit het ESI {fw.EsiBestand} (firmware {fw.Versie})" +
                                              (sn is uint n ? $", met serienummer {n}" : ", zonder serienummer") +
                                              "?\n\nDaarna moet de print spanning uit/aan krijgen.")) return;
        await VoerTaakUit("mde.eeprom", JsonSerializer.Serialize(EepromBody(p, false, overschrijven)), $"EEPROM vullen — slave {p.Positie} ({p.Naam})", 240, async res =>
        {
            var geschreven = res.ValueKind == JsonValueKind.Object ? Getal(res, "geschreven") : 0;
            if (geschreven == 0) return "de EEPROM was al gelijk aan het ESI";
            if (sn is uint n) await ZetViaBron($"drive:{p.Positie}:serienummer", n.ToString());
            await Repo.VoegHistorieToeAsync(ProductId,
                $"Slave {p.Positie} ({p.Naam}): EEPROM gevuld uit ESI {fw.EsiBestand} — {Tekst(res, "productcode")}, rev {Tekst(res, "revisie")}, sn {(sn?.ToString() ?? "-")}, PDI {Tekst(res, "pdi")}" + Opm(),
                SoortId("Programmeren") ?? SoortId("Test"), Ik.WerknemerId, uitkomst: true);
            try { await JS.InvokeVoidAsync("mdeMelding", "EEPROM geschreven. Geef de print nu spanning uit/aan: de EtherCAT-chip leest de EEPROM alleen bij het opstarten.", "✅ Spanning uit/aan nodig"); } catch { }
            return $"{geschreven} woorden geschreven en teruggelezen";
        });
        if (!overschrijven && _taakFout is { } f && f.Contains("andere identiteit", StringComparison.OrdinalIgnoreCase)
            && await Bevestig($"{f}\n\nToch overschrijven met wat het ESI zegt?"))
            await VulEeprom(p, overschrijven: true);
    }

    /// <summary>Serienummer in de EEPROM schrijven (Producten ▸ Techniek ▸ EtherCAT ▸ "Serienummer schrijven").</summary>
    private bool SnSchrijven => _technieken.Contains(ProductTechniek.SerienummerSchrijven);

    /// <summary>Het serienummer van het exemplaar als getal (de cijfers eruit, bv. "MPR-0036" → 36); null als er geen cijfers in staan.</summary>
    private uint? SerienummerGetal
    {
        get
        {
            var cijfers = new string((Exemplaar.Serienummer ?? "").Where(char.IsDigit).ToArray());
            return uint.TryParse(cijfers, out var n) && n > 0 ? n : null;
        }
    }

    private async Task SchrijfSerienummer(DrivePositie p, bool overschrijven = false)
    {
        if (SerienummerGetal is not uint sn) return;
        if (!overschrijven && !await Bevestig($"Serienummer {sn} in de EEPROM van slave {p.Positie} ({p.Naam}) zetten?")) return;
        var body = JsonSerializer.Serialize(new { positie = p.Positie, serienummer = sn, overschrijven });
        string? bestaand = null;
        await VoerTaakUit("mde.serienummer", body, $"Serienummer {sn} → slave {p.Positie} ({p.Naam})", 90, async res =>
        {
            var coe = res.ValueKind == JsonValueKind.Object && res.TryGetProperty("coe", out var c) && c.ValueKind == JsonValueKind.Number ? c.GetInt64() : (long?)null;
            await ZetViaBron($"drive:{p.Positie}:serienummer", sn.ToString());
            await Repo.VoegHistorieToeAsync(ProductId, $"Slave {p.Positie} ({p.Naam}): serienummer {sn} in de EEPROM gezet" + Opm(),
                                            SoortId("Programmeren") ?? SoortId("Test"), Ik.WerknemerId, uitkomst: true);
            return $"serienummer {sn} geschreven" + (coe is long w && w != sn ? $"; 0x1018:4 meldt nog {w} (firmware leest de EEPROM pas na een herstart, of niet)" : "");
        });
        // stond er al een ander nummer: vragen of het overschreven mag, en dan nog eens
        if (_taakFout is { } f && f.Contains("staat al serienummer", StringComparison.OrdinalIgnoreCase))
            bestaand = f;
        if (bestaand is not null && !overschrijven
            && await Bevestig($"{bestaand}\n\nOverschrijven met {sn}?"))
            await SchrijfSerienummer(p, overschrijven: true);
    }

    /// <summary>Parametersets laden (Producten ▸ Techniek ▸ EtherCAT ▸ "Parametersets laden"); standaard aan.</summary>
    private bool MetParameters => !_technieken.Contains(ProductTechniek.GeenParameters);
    private bool HeeftCan => _technieken.Contains(ProductTechniek.Can);
    private int AantalTechnieken => _technieken.Count;
    private bool HeeftFeetech => _technieken.Contains(ProductTechniek.Feetech) || (MotorModus && AantalTechnieken == 0);

    // Welke stappen dit type toont (Producten ▸ Techniek ▸ 'Stappen'). Zonder techniek (bv. een kabel)
    // is er bovendien niets te programmeren of automatisch te testen.
    private bool IetsTeDoen => AantalTechnieken > 0 || DrivePosities.Count > 0 || MotorModus;
    private bool ToonUitlezen => Naam.ToonStap(ProductStap.Uitlezen) && IetsTeDoen;
    private bool ToonProgrammeren => Naam.ToonStap(ProductStap.Programmeren) && IetsTeDoen;
    private bool ToonTesten => Naam.ToonStap(ProductStap.Testen) && IetsTeDoen;
    private bool ToonOpbouw => Naam.ToonStap(ProductStap.Opbouw);
    private bool ToonNodeAdres => Naam.ToonStap(ProductStap.NodeAdres);
    // nummering loopt door over de zichtbare stappen
    private int NrProgrammeren => StartNummer;
    private int NrNodeAdres => NrProgrammeren + (ToonProgrammeren ? 1 : 0);
    private int NrTesten => NrNodeAdres + (ToonNodeAdres ? 1 : 0);
    private int NrOpbouw => NrTesten + (ToonTesten ? 1 : 0);
    private int NrDuurtest => NrOpbouw + (ToonOpbouwStap && ToonOpbouw ? 1 : 0);

    /// <summary>Stapkop, met of zonder nummer.</summary>
    private RenderFragment Kop(int nr, string titel) => __builder =>
    {
        <h3 class="wn-kop prod-stapkop">
            @if (MetNummers) { <span class="prod-nr">@nr</span> }
            @titel
        </h3>
    };

    // Feetech-servo: laatst uitgelezen gegevens en de programmeerkeuze.
    private sealed class ServoInfo
    {
        public int Id; public string Model = "", Firmware = "", Servoversie = "", Poort = ""; public int Baud;
        public List<ServoRegister> Registers = new();
    }
    private sealed record ServoRegister(int Adres, string Naam, long? Waarde, string Geheugen, string Rw, string Fout = "");
    private ServoInfo? _servo;
    private bool _servoRegistersOpen;
    private int _servoParamsId;
    private string _servoId = "";
    private List<DriveSoort> _driveTypen = new();
    private List<DriveFirmware> _alleFirmwares = new();        // van alle drivetypen
    private List<DriveParameterset> _parametersets = new();    // van dit type
    private readonly Dictionary<int, ProgKeuze> _keuzes = new();
    private sealed class ProgKeuze { public int FirmwareId; public int ParametersId; }

    private List<(string Code, string Naam)> _testen = new();
    private string _testCode = "";
    private int _uitgangenPerDrive = 4;
    private readonly Dictionary<int, int> _uitgangen = new();   // positie → laatst teruggelezen bitmasker
    private int UitgangStand(int positie) => _uitgangen.TryGetValue(positie, out var m) ? m : 0;

    private bool _taakBezig, _taakKlaar;
    private string _taakTitel = "";
    private string? _taakFout, _taakResultaat;
    private int _taakProcent;
    private List<string> _taakRegels = new();
    private CancellationTokenSource? _taakStop;
    private string? _taakJobId;
    private bool _taakStopGevraagd;

    /// <summary>Vraagt de agent de lopende job te stoppen; de taak rondt zelf af (resultaat tot nu toe).</summary>
    private async Task StopTaak()
    {
        if (_taakJobId is null || _taakStopGevraagd) return;
        _taakStopGevraagd = true;
        try
        {
            var r = await Agent($"/jobs/{_taakJobId}/stop", 10, "{}");
            if (r.status != 200) _taakRegels.Add($"… stoppen niet gelukt ({r.status}: {r.tekst})");
        }
        catch (Exception ex) { _taakRegels.Add("… stoppen niet gelukt: " + ex.Message); }
    }

    // De werkplek-agent op deze pc (MdeAgent/): drives uitlezen, chips flashen.
    private string _agentUrl = "";
    private string _agentToken = "";

    // ---------------------------------------------------------------- laden

    protected override async Task OnInitializedAsync()
    {
        await Ik.ZorgGeladenAsync();
        _recht = (Config["Productie:RechtProgrammeren"] ?? "").Trim();
        _agentUrl = (Config["Productie:UitleesAgent"] ?? "").Trim().TrimEnd('/');
        _agentToken = (Config["Productie:AgentToken"] ?? "").Trim();

        // De testen die de agent kent (Productie:Testen in appsettings); standaardlijst als er niets staat.
        _testen = Config.GetSection("Productie:Testen").GetChildren()
            .Select(s => (Code: s["Code"] ?? s.Key, Naam: s["Naam"] ?? s["Code"] ?? s.Key))
            .Where(t => t.Code.Length > 0).ToList();
        if (_testen.Count == 0)
            _testen = new() { ("basistest", "Basistest"), ("iotest", "IO test") };
        _testen.RemoveAll(t => t.Code == "test3");
        _testCode = _testen[0].Code;
        _uitgangenPerDrive = int.TryParse(Config["Productie:UitgangenPerDrive"], out var u) && u > 0 ? u : 4;

        try
        {
            _soorten = await Repo.GetHistorieSoortenAsync();
            _soortId = (_soorten.FirstOrDefault(s => s.Naam.Contains("Test", StringComparison.OrdinalIgnoreCase))
