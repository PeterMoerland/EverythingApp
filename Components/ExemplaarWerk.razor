    private string EncNaaldY => (78 * Math.Sin((_enc.Graden - 90) * Math.PI / 180)).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);

    private async Task OpenEncoder(DrivePositie p)
    {
        _encPositie = p; _encOpen = true; _enc = new(); _encStatus = "";
        await StartEncoder(p);
    }

    private async Task StartEncoder(DrivePositie p)
    {
        var fw = StroomlusFirmware(p.Positie);
        if (fw?.DictionaryFileId is null || _encLoopt) return;
        _encLoopt = true; _encStatus = "verbinden …";
        _encStop = new CancellationTokenSource();
        var ct = _encStop.Token;
        try
        {
            var body = JsonSerializer.Serialize(new { positie = p.Positie, dictionary = BestandUrl(fw.DictionaryFileId.Value), seconden = 300, interval = 0.1 });
            var start = await Agent("/taken/drives.encoderlive", 30, body);
            if (start.status != 202) { _encStatus = FoutUit(start.tekst) ?? $"agent antwoordde {start.status}"; return; }
            using (var doc = JsonDocument.Parse(start.tekst)) _encJobId = doc.RootElement.GetProperty("job").GetString();
            var vanaf = 0;
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(150, ct);
                var st = await Agent($"/jobs/{_encJobId}?vanaf={vanaf}", 10);
                if (st.status != 200) continue;
                using var d = JsonDocument.Parse(st.tekst);
                var w = d.RootElement;
                vanaf = Getal(w, "regelsTotaal");
                if (w.TryGetProperty("resultaat", out var r) && r.ValueKind == JsonValueKind.Object)
                {
                    double D(string n) => r.TryGetProperty(n, out var v) && v.ValueKind == JsonValueKind.Number ? v.GetDouble() : 0;
                    _enc = new EncoderStand
                    {
                        Positie = (long)D("positie"), Resolutie = Math.Max(1, (int)D("resolutie")), Singleturn = (int)D("singleturn"),
                        Graden = D("graden"), Multiturn = (long)D("multiturn"), Snelheid = D("snelheid"), T = D("t"), N = (int)D("n"),
                        NabijGrens = r.TryGetProperty("nabijGrens", out var ng) && ng.ValueKind == JsonValueKind.True,
                        FullFrame = Tekst(r, "fullFrame"), PositionOffset = Tekst(r, "positionOffset"), PositionActual = Tekst(r, "positionActual"), BissPosition = Tekst(r, "bissPosition"),
                        FullFrameUid = Tekst(r, "fullFrameUid"), PositionOffsetUid = Tekst(r, "positionOffsetUid"), PositionActualUid = Tekst(r, "positionActualUid"), BissPositionUid = Tekst(r, "bissPositionUid"), FullFrameDtype = Tekst(r, "fullFrameDtype"),
                    };
                    _encStatus = "live";
                }
                var stand = Tekst(w, "stand");
                if (stand == "klaar") { _encStatus = "gestopt"; break; }
                if (stand == "mislukt") { _encStatus = "fout: " + Tekst(w, "fout"); break; }
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { _encStatus = "gestopt"; }
        catch (Exception ex) { _encStatus = "fout: " + ex.Message; }
        finally
        {
            _encLoopt = false;
            _encStop?.Dispose(); _encStop = null;
            StateHasChanged();
        }
    }

    private async Task StopEncoder()
    {
        if (_encJobId is not null)
            try { await Agent($"/jobs/{_encJobId}/stop", 10, "{}"); } catch { }
        _encStop?.Cancel();
    }

    private async Task SluitEncoder()
    {
        await StopEncoder();
        _encOpen = false;
    }


