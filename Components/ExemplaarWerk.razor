                Verwacht = Getal(res, "verwacht"), Vooruit = Getal(res, "vooruit"), Terug = Getal(res, "terug"), Poolparen = Getal(res, "poolparen"),
                FoutVooruit = D("foutVooruitPct"), FoutTerug = D("foutTerugPct"), Symmetrie = D("symmetriePct"), Marge = _etMarge,
            };
            return _et.Samenvatting;
        });

    private Task StartMotiontest() => VoerDriveTestUit("drives.motiontest", "Motiontest",
