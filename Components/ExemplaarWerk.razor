    private string OdCsvNaam => $"eRob_objecten_{Naam.Naam}_{Exemplaar.Serienummer}_{DateTime.Now:yyyyMMdd-HHmm}.csv";
    private string OdCsvUrl
    {
        get
        {
            static string C(string s) => "\"" + s.Replace("\"", "\"\"") + "\"";
            var sb = new System.Text.StringBuilder("Index;Sub;Naam;Type;Toegang;Waarde;Hex;Fout\n");
            foreach (var r in _od)
                sb.Append(r.Index).Append(';').Append(r.Sub).Append(';').Append(C(r.Naam)).Append(';').Append(r.Type).Append(';')
                  .Append(r.Toegang).Append(';').Append(C(r.Waarde)).Append(';').Append(r.Hex).Append(';').Append(C(r.Fout)).Append('\n');
            return "data:text/csv;charset=utf-8," + Uri.EscapeDataString(sb.ToString());
        }
    }

    private void OpenDictionary(DrivePositie p)
    {
