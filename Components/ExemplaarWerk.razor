    private string ProtocolVan(DrivePositie p)
        => _driveTypen.FirstOrDefault(t => t.Id == p.DriveTypeId)?.Protocol ?? DriveProtocol.EtherCat;
    /// <summary>Praat met SDO's (eRob én MDE-slaves): JSON-parametersets, geen Ingenia-registers of -testen.</summary>
    private bool IsCoe(DrivePositie p) => DriveProtocol.ViaSdo(ProtocolVan(p));
    private bool IsErob(DrivePositie p) => ProtocolVan(p) == DriveProtocol.Coe;
    private bool IsMde(DrivePositie p) => ProtocolVan(p) == DriveProtocol.Mde;

    private string ParamTitel(DrivePositie p) => IsCoe(p)
