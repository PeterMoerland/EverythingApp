    private ErobInfo? _erobInfo;

    private async Task LeesErobInfo(DrivePositie p)
    {
        _erobInfo = null;
        var body = JsonSerializer.Serialize(new { id = _erobCanId, baud = _canBaud, kanaal = _canKanaal });
        await VoerTaakUit("can.erob_info", body, $"eRob-info lezen via CAN (drive {p.Positie})", 150, res =>
        {
            if (res.ValueKind != JsonValueKind.Object) return Task.FromResult("geen resultaat");
            string T(string n) => res.TryGetProperty(n, out var v) ? (v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : v.ValueKind == JsonValueKind.Number ? v.GetRawText() : "") : "";
            _erobInfo = new ErobInfo(Getal(res, "id"), T("serienummer"), T("model"), T("hardware_info"), T("partnummer"), T("firmware_versie"), T("can_adres"));
            if (_erobInfo.Id > 0) _erobCanId = _erobInfo.Id;
            var delen = new List<string>();
            if (_erobInfo.Serienummer.Length > 0) delen.Add("SN " + _erobInfo.Serienummer);
            if (_erobInfo.Model.Length > 0) delen.Add(_erobInfo.Model);
            if (_erobInfo.Hardware.Length > 0) delen.Add("hw " + _erobInfo.Hardware);
            if (_erobInfo.Partnummer.Length > 0) delen.Add("PN " + _erobInfo.Partnummer);
            if (_erobInfo.Firmware.Length > 0) delen.Add("fw " + _erobInfo.Firmware);
            return Task.FromResult(delen.Count > 0 ? string.Join(" · ", delen) : "eRob antwoordde, maar index 0x232 gaf niets (firmware te oud?)");
        });
