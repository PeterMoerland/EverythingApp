                q = _od.Any(r => r.Naam == "(niet in ESI)")
                    ? q.Where(r => r.Naam == "(niet in ESI)")
                    : q.Where(r => int.TryParse(r.Index.AsSpan(2), System.Globalization.NumberStyles.HexNumber, null, out var i) && i is >= 0x2000 and < 0x6000);
            if (_odFilter.Length > 0)
