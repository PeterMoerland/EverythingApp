        : "Parameterset (.xcf) in de drive schrijven en opslaan";
    private readonly Dictionary<int, string> _hoek = new();
    private int _hoekSnelheid = 10;
    private string HoekVoor(int positie) => _hoek.TryGetValue(positie, out var h) ? h : "";

    /// <summary>eRob naar een absolute hoek (profile position); de gemeten hoek komt in de historie.</summary>
    private async Task NaarHoek(DrivePositie p)
    {
        if (!double.TryParse(HoekVoor(p.Positie).Replace(',', '.'), System.Globalization.NumberStyles.Float,
                             System.Globalization.CultureInfo.InvariantCulture, out var graden)) return;
        var body = JsonSerializer.Serialize(new { positie = p.Positie, graden, snelheid = _hoekSnelheid, versnelling = _hoekSnelheid * 2, timeout = 120 });
        await VoerTaakUit("coe.hoek", body, $"Drive {p.Positie} ({p.Naam}) naar {graden:0.00}°", 150, async res =>
        {
            var hoek = res.ValueKind == JsonValueKind.Object && res.TryGetProperty("hoek", out var h) ? h.GetDouble() : double.NaN;
            var afw = res.ValueKind == JsonValueKind.Object && res.TryGetProperty("afwijking", out var a) ? a.GetDouble() : double.NaN;
            var ok = !double.IsNaN(afw) && Math.Abs(afw) <= 0.1;
            await Repo.VoegHistorieToeAsync(ProductId,
                $"Drive {p.Positie} ({p.Naam}): naar {graden:0.00}° gezet, gemeten {hoek:0.000}° (afwijking {afw:+0.000;-0.000}°)" + Opm(),
                SoortId("Programmeren") ?? SoortId("Test"), Ik.WerknemerId, uitkomst: ok);
            return $"gemeten {hoek:0.000}° (afwijking {afw:+0.000;-0.000}°)";
        });
    }

    private async Task LeesPositie(DrivePositie p)
    {
        var body = JsonSerializer.Serialize(new { positie = p.Positie });
        await VoerTaakUit("coe.positie", body, $"Drive {p.Positie} ({p.Naam}): positie lezen", 40, res =>
        {
            if (res.ValueKind != JsonValueKind.Object) return Task.FromResult("geen antwoord");
            var hoek = res.TryGetProperty("hoek", out var h) ? h.GetDouble() : double.NaN;
            var delen = new List<string> { $"{hoek:0.000}°", $"status {Tekst(res, "statusword")}", $"fout {Tekst(res, "foutcode")}" };
            if (res.TryGetProperty("temperatuur", out var t)) delen.Add($"{t} °C");
            if (res.TryGetProperty("spanning", out var u)) delen.Add($"{u.GetDouble() / 1000:0.0} V");
            var fw = Tekst(res, "firmware");
            if (fw.Length > 0) delen.Add("fw " + fw);
            _hoek[p.Positie] = double.IsNaN(hoek) ? "" : hoek.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
            return Task.FromResult(string.Join(" · ", delen));
        });
    }

