            return u.Samenvatting;
        });


    // ---- phasing (drives.phasing): live stroom- en hoekreeks
    private List<(double T, double? Icmd, double? Iact, double? Ref, double? Commu)> _ph = new();

    private void PhasingLive(JsonElement r)
    {
        if (r.TryGetProperty("reeks", out var rk) && rk.ValueKind == JsonValueKind.Array)
        {
            var lijst = new List<(double, double?, double?, double?, double?)>();
            foreach (var punt in rk.EnumerateArray())
            {
                if (punt.ValueKind != JsonValueKind.Array) continue;
                var a = punt.EnumerateArray().Select(x => x.ValueKind == JsonValueKind.Number ? (double?)x.GetDouble() : null).ToArray();
                if (a.Length >= 5 && a[0] is double t) lijst.Add((t, a[1], a[2], a[3], a[4]));
            }
            if (lijst.Count > 0) _ph = lijst;
        }
        StateHasChanged();
    }

    /// <summary>Twee-sporen grafiek over de hele reeks (tijd 0..T), auto-schaal; sporen a (rood) en b (geel).</summary>
    private RenderFragment SporenGrafiek(List<(double T, double? A, double? B)> reeks, string naamA, string naamB, string eenheid) => __builder =>
    {
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        var tMax = Math.Max(0.5, reeks.Count > 0 ? reeks[^1].T : 1);
        var waarden = reeks.SelectMany(p => new[] { p.A, p.B }).Where(v => v.HasValue).Select(v => v!.Value).ToList();
        var yMin = waarden.Count > 0 ? waarden.Min() : 0;
        var yMax = waarden.Count > 0 ? waarden.Max() : 1;
        if (yMax - yMin < 1e-6) { yMax = yMin + 1; }
        var marge = (yMax - yMin) * 0.08; yMin -= marge; yMax += marge;
        if (yMin > 0 && yMin < (yMax - yMin) * 0.5) yMin = 0;
        string X(double t) => (t / tMax * 800).ToString("0.#", ci);
        string Y(double v) => (250 - (v - yMin) / (yMax - yMin) * 230).ToString("0.#", ci);
        var a = string.Join(" ", reeks.Where(p => p.A.HasValue).Select(p => X(p.T) + "," + Y(p.A!.Value)));
        var b = string.Join(" ", reeks.Where(p => p.B.HasValue).Select(p => X(p.T) + "," + Y(p.B!.Value)));
        <svg class="prod-scope prod-scope-half" viewBox="0 0 800 260" preserveAspectRatio="none">
            <rect x="0" y="0" width="800" height="260" fill="#111" />
            @for (var g = 1; g < 5; g++) { <line x1="0" y1="@(20 + g * 46)" x2="800" y2="@(20 + g * 46)" stroke="#333" stroke-width="1" /> }
            @if (yMin < 0 && yMax > 0) { <line x1="0" y1="@Y(0)" x2="800" y2="@Y(0)" stroke="#666" stroke-width="1" /> }
            <polyline points="@a" fill="none" stroke="#e53935" stroke-width="1.5" vector-effect="non-scaling-stroke" />
            <polyline points="@b" fill="none" stroke="#ffb300" stroke-width="1.5" vector-effect="non-scaling-stroke" />
            @SvgTekst(6, 14, naamA, "#e53935", 12, false, "start")
            @SvgTekst(6, 30, naamB, "#ffb300", 12, false, "start")
            @SvgTekst(794, 14, $"{yMax.ToString("0.##", ci)} {eenheid}", "#aaa", 11, false, "end")
            @SvgTekst(794, 252, $"{yMin.ToString("0.##", ci)} {eenheid} · {tMax.ToString("0.0", ci)} s", "#aaa", 11, false, "end")
        </svg>
    };

