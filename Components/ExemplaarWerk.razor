            if (res.TryGetProperty("alle", out var al) && al.ValueKind == JsonValueKind.Array)
                foreach (var a in al.EnumerateArray())
                    u.Alle.Add(new PcRegel(Tekst(a, "id"), Tekst(a, "dtype"), Tekst(a, "verwacht"), Tekst(a, "gelezen"),
                                           a.TryGetProperty("gelijk", out var gl) && gl.ValueKind == JsonValueKind.True));
            _pc = u; _pcOpen = true;
            await Repo.VoegHistorieToeAsync(ProductId,
                $"Drive {p.Positie} ({p.Naam}): parameter compare met '{naam}' — {u.Registers} registers, {u.Afwijkingen} afwijkend"
                + (u.Afwijkingen > 0 ? ": " + string.Join(", ", u.Regels.Take(6).Select(r => r.Id)) + (u.Afwijkingen > 6 ? " …" : "") : "") + Opm(),
                SoortId("Programmeren") ?? SoortId("Test"), Ik.WerknemerId, uitkomst: u.Afwijkingen == 0);
            return u.Afwijkingen == 0 ? $"{u.Registers} registers, alles gelijk" : $"{u.Afwijkingen} van {u.Registers} registers wijken af";
        });
    }


