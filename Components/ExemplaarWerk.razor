    private async Task StuurSerieel()
    {
        if (_serJobId is null || !_serLoopt || _serInvoer.Length == 0) return;
        var tekst = _serInvoer;
        _serInvoer = ""; _serInvoerVersie++;
        try
        {
            // de agent zet de verstuurde tekst zelf als "» tekst" in de uitvoer, dus hier niets toevoegen
            var r = await Agent($"/jobs/{_serJobId}/invoer", 10, JsonSerializer.Serialize(new { tekst }));
            if (r.status != 200) _serStatus = "sturen mislukt: " + (FoutUit(r.tekst) ?? r.tekst);
        }
        catch (Exception ex) { _serStatus = "sturen mislukt: " + ex.Message; }
    }

    // ---- nulpunt (positie-offset 0x2438) en phasing — agenttaak drives.nulpunt
    private string _nulpuntUitslag = "";

    private Task NulpuntOffset(DrivePositie p) => NulpuntStap(p, "offset");
    private Task NulpuntPhasing(DrivePositie p) => NulpuntStap(p, "phasing");

    private async Task NulpuntStap(DrivePositie p, string wat)
    {
        var fw = StroomlusFirmware(p.Positie);
        if (fw?.DictionaryFileId is null) return;
        if (wat == "offset" && !await Bevestig($"Het nulpunt van drive {p.Positie} ({p.Naam}) op de huidige positie zetten?\n\nDe positie-offset wordt in de drive opgeslagen; daarna is spanning uit/aan en phasing nodig."))
            return;
        if (wat == "phasing" && !await Bevestig($"Phasing van drive {p.Positie} ({p.Naam}) starten?\n\nDe motor wordt ingeschakeld en de as draait een stukje — as vrij laten."))
            return;
        await StopEncoder();                      // de live-meting houdt de drive vast; eerst loslaten
        await Task.Delay(300);
        _taakIsTest = false;
        var body = JsonSerializer.Serialize(new { positie = p.Positie, dictionary = BestandUrl(fw.DictionaryFileId.Value), wat });
        await VoerTaakUit("drives.nulpunt", body, wat == "offset" ? $"Nulpunt drive {p.Positie} ({p.Naam})" : $"Phasing drive {p.Positie} ({p.Naam})", 300, async res =>
        {
            if (res.ValueKind != JsonValueKind.Object) throw new InvalidOperationException("geen resultaat");
            if (res.TryGetProperty("sto_ontbreekt", out var sto) && sto.ValueKind == JsonValueKind.True)
            {
                var tekst = Tekst(res, "samenvatting");
                try { await JS.InvokeVoidAsync("mdeMelding", tekst, "⛔ STO niet vrijgegeven — phasing afgebroken"); } catch { }
                throw new InvalidOperationException(tekst);
            }
            var geslaagd = res.TryGetProperty("geslaagd", out var g) && g.ValueKind == JsonValueKind.True;
            var samenvatting = Tekst(res, "samenvatting");
            _nulpuntUitslag = (wat == "offset" ? "nulpunt: " : "phasing: ") + samenvatting;
            await Repo.VoegHistorieToeAsync(ProductId, $"Drive {p.Positie} ({p.Naam}): {(wat == "offset" ? "nulpunt gezet" : "phasing")} — {samenvatting}" + Opm(),
                                            SoortId("Programmeren") ?? SoortId("Test"), Ik.WerknemerId, uitkomst: geslaagd);
            if (res.TryGetProperty("herstartNodig", out var h) && h.ValueKind == JsonValueKind.True)
                try { await JS.InvokeVoidAsync("mdeMelding", (wat == "offset" ? "Nulpunt opgeslagen. " : "Phasing opgeslagen. ") + "Nu de drive spanning uit/aan geven" + (wat == "offset" ? " en daarna Phasing uitvoeren." : "."), "✅ Spanning uit/aan nodig"); } catch { }
            if (!geslaagd) throw new InvalidOperationException(samenvatting);
            return samenvatting;
        });
    }


