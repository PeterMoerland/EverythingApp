    /// <summary>De drives volgens het product: één per 'drive:n:serienummer'-attribuut, op
    /// volgorde van n. Leeg = het type heeft geen automatisch te vullen attributen.</summary>
    private string[] Assen()
    {
        var drives = _sjabloon
            .Select(a => (Attr: a, D: AttribuutBronnen.Drive(a.Bron)))
            .Where(x => x.D is { Veld: "serienummer" })
            .OrderBy(x => x.D!.Value.Nummer)
            .ToList();
        if (drives.Count == 0) return Array.Empty<string>();
        var max = drives.Max(x => x.D!.Value.Nummer);
        return Enumerable.Range(1, max)
            .Select(n => drives.FirstOrDefault(x => x.D!.Value.Nummer == n).Attr?.Attribuut ?? $"Drive {n}")
            .ToArray();
    }

    /// <summary>Posities, firmwares en parametersets van dit type; per positie de
    /// actuele firmware en bijbehorende parameterset alvast voorselecteren.</summary>
    private async Task LaadProgrammeerKeuzes()
    {
        _posities = new(); _alleFirmwares = new(); _parametersets = new(); _keuzes.Clear();
        _technieken = new(StringComparer.OrdinalIgnoreCase);
        if (!Drives.Beschikbaar) return;
        try { _technieken = await Repo.GetTechniekenAsync(Naam.Id); } catch { }
        try
        {
            _posities = await Drives.GetPositiesAsync(Naam.Id);
            _driveTypen = await Drives.GetTypenAsync();
            // Stroomlus alleen bij EtherCAT-drives van Ingenia (niet bij eRob/CoE)
            _testen.RemoveAll(t => t.Code is "stroomlus" or "encodertest" or "phasing" or "motiontest" or "dualmotion");
            // Basistest (serienummers) en IO-test (uitgangen 0x2602/0x2601) zijn voor Ingenia-drives: een eRob of
            // MDE-slave heeft geen elektronisch serienummer en die registers niet. Alleen tonen als er een
            // Ingenia-positie is (of als de posities nog niet zijn vastgelegd).
            if (DrivePosities.Count > 0 && !DrivePosities.Any(p => ProtocolVan(p) == DriveProtocol.EtherCat))
                _testen.RemoveAll(t => t.Code is "basistest" or "iotest");
            if (DrivePosities.Any(p => !IsCoe(p)))
            {
                _testen.Add(("stroomlus", "Stroomlus"));
                _testen.Add(("encodertest", "Encodertest"));
                _testen.Add(("phasing", "Phasing"));
                _testen.Add(("motiontest", "Motiontest"));
                if (DrivePosities.Count(p => !IsCoe(p)) >= 2) _testen.Add(("dualmotion", "Dual motion"));
            }
            // Testrecepten van de controllertypen op de posities (Controllertypen ▸ Testrecepten): één knop per slave × recept.
            _recepten = new();
            _testen.RemoveAll(t => t.Code.StartsWith("recept:", StringComparison.Ordinal));
            var receptTypen = DrivePosities.Where(p => p.DriveTypeId is int t && DriveProtocol.ViaSdo(ProtocolVan(p))).Select(p => p.DriveTypeId!.Value).ToList();
            foreach (var r in await Drives.GetReceptenVoorTypenAsync(receptTypen))
                foreach (var p in DrivePosities.Where(p => p.DriveTypeId == r.DriveTypeId))
                {
                    _recepten.Add((p, r));
                    _testen.Add(($"recept:{r.Id}:{p.Positie}", DrivePosities.Count > 1 ? $"{r.Naam} · {p.Naam}" : r.Naam));
                }
            foreach (var t in _driveTypen)
                _alleFirmwares.AddRange(await Drives.GetFirmwaresAsync(t.Id));
            _parametersets = await Drives.GetParametersetsAsync(Naam.Id);

            foreach (var p in _posities)
            {
                var k = Keuze(p.Positie);
                var actueel = FirmwaresVoor(p).FirstOrDefault(f => f.Status == DriveStatus.Actueel) ?? FirmwaresVoor(p).FirstOrDefault();
                k.FirmwareId = actueel?.Id ?? 0;
                k.ParametersId = ParametersVoor(p, k.FirmwareId).FirstOrDefault(ps => ps.Status == DriveStatus.Actueel)?.Id ?? 0;
            }
            // Servo: de actuele parameterset (met bestand) alvast kiezen.
            _servoParamsId = (_parametersets.FirstOrDefault(ps => ps.Status == DriveStatus.Actueel && ps.ParameterFileId is not null)
                              ?? _parametersets.FirstOrDefault(ps => ps.ParameterFileId is not null))?.Id ?? 0;
        }
        catch { /* drive-tabellen ontbreken: programmeren blijft leeg */ }
    }

    private ProgKeuze Keuze(int positie)
    {
        if (!_keuzes.TryGetValue(positie, out var k)) _keuzes[positie] = k = new ProgKeuze();
        return k;
    }

    private IEnumerable<DriveFirmware> FirmwaresVoor(DrivePositie p)
        => p.DriveTypeId is int t ? _alleFirmwares.Where(f => f.DriveTypeId == t) : _alleFirmwares;

    private IEnumerable<DriveParameterset> ParametersVoor(DrivePositie p, int firmwareId)
        => _parametersets.Where(ps => ps.Positie == p.Positie && (firmwareId == 0 || ps.DriveFirmwareId == firmwareId));

    private void KiesFirmware(int positie, ChangeEventArgs e)
    {
        var k = Keuze(positie);
        k.FirmwareId = int.TryParse((string?)e.Value, out var id) ? id : 0;
        var p = _posities.First(x => x.Positie == positie);
        k.ParametersId = ParametersVoor(p, k.FirmwareId).FirstOrDefault(ps => ps.Status == DriveStatus.Actueel)?.Id ?? 0;
    }

    private void KiesParameters(int positie, ChangeEventArgs e)
        => Keuze(positie).ParametersId = int.TryParse((string?)e.Value, out var id) ? id : 0;

    private bool KanFirmware(ProgKeuze k)
        => _agentUrl.Length > 0 && _alleFirmwares.FirstOrDefault(f => f.Id == k.FirmwareId)?.FirmwareFileId is not null;

    private bool KanParameters(ProgKeuze k, DrivePositie p)
    {
        if (_agentUrl.Length == 0) return false;
        var ps = _parametersets.FirstOrDefault(x => x.Id == k.ParametersId);
        if (ps?.ParameterFileId is null) return false;
        if (IsCoe(p)) return true;                      // JSON met SDO's, geen dictionary nodig
        var fw = _alleFirmwares.FirstOrDefault(f => f.Id == ps.DriveFirmwareId);
        return fw?.DictionaryFileId is not null;
    }

