    private string CanCsvNaam => $"eRob_CAN_{DateTime.Now:yyyyMMdd-HHmm}.csv";
    private string CanCsvUrl
    {
        get
        {
            var sb = new System.Text.StringBuilder("t;node;protocol;richting;index;sub;naam;waarde;hex\n");
            foreach (var c in _can)
                sb.Append(c.T.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture)).Append(';').Append(c.Node).Append(';').Append(c.Protocol).Append(';').Append(c.Richting).Append(';')
                  .Append(c.Index).Append(';').Append(c.Sub).Append(';').Append('"').Append(NaamVoor(c).Replace("\"", "\"\"")).Append("\";")
                  .Append(c.Waarde).Append(';').Append(c.Hex).Append('\n');
            return "data:text/csv;charset=utf-8," + Uri.EscapeDataString(sb.ToString());
        }
    }

