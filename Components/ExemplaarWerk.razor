    // ---- dual motion (drives.dualmotion): twee assen, geteachte posities
    private sealed record DualBeweging(int Herhaling, string Doel, double Duur, int VfA, int VfB, bool Ok, string Reden);
    private sealed class DualUitslag { public bool Geslaagd, Bezig; public string Samenvatting = ""; public List<DualBeweging> Bewegingen = new(); }
    private DualUitslag? _dm;
    private int _dmPositieB, _dmSnelheid = 200, _dmHerhalingen = 10;
    private bool _dmInterpoleren = true;
    private double _dmAcc = 500;
    private Dictionary<int, long>? _dmPos1, _dmPos2;
    private bool DualKlaar => DualDrives() is not null && _dmPos1 is not null && _dmPos2 is not null;
    private string DualTekst(Dictionary<int, long>? p) => p is null ? "nog niet geteacht" : string.Join(" · ", p.OrderBy(k => k.Key).Select(k => $"drive {k.Key}: {k.Value:N0}"));

    private (DrivePositie A, DrivePositie B, DriveFirmware FwA, DriveFirmware FwB)? DualDrives()
    {
        // A = eerste Ingenia-drive (positie 1), B = tweede (positie 2)
        var ing = DrivePosities.Where(x => !IsCoe(x)).OrderBy(x => x.Positie).ToList();
        if (ing.Count < 2) return null;
        var a = ing[0]; var b = ing[1];
        var fa = StroomlusFirmware(a.Positie); var fb = StroomlusFirmware(b.Positie);
        if (fa?.DictionaryFileId is null || fb?.DictionaryFileId is null) return null;
        return (a, b, fa, fb);
    }

    private object DualBody(string actie, object? extra = null)
    {
        var d = DualDrives()!.Value;
        var basis = new Dictionary<string, object?>
        {
            ["actie"] = actie,
            ["drives"] = new[]
            {
                new { positie = d.A.Positie, dictionary = BestandUrl(d.FwA.DictionaryFileId!.Value), naam = d.A.Naam },
                new { positie = d.B.Positie, dictionary = BestandUrl(d.FwB.DictionaryFileId!.Value), naam = d.B.Naam },
            },
        };
        if (extra is not null) foreach (var prop in extra.GetType().GetProperties()) basis[prop.Name] = prop.GetValue(extra);
        return basis;
    }

    private async Task DualTeach(int welke)
    {
        if (DualDrives() is null) { Toon("Kies twee verschillende Ingenia-drives met een firmware-dictionary.", true); return; }
        _taakIsTest = true;
        await VoerTaakUit("drives.dualmotion", JsonSerializer.Serialize(DualBody("teach")), $"Teach pos {welke}", 90, res =>
        {
            var posities = new Dictionary<int, long>();
            if (res.ValueKind == JsonValueKind.Object && res.TryGetProperty("posities", out var ps) && ps.ValueKind == JsonValueKind.Object)
                foreach (var kv in ps.EnumerateObject())
                    if (int.TryParse(kv.Name, out var pos) && kv.Value.ValueKind == JsonValueKind.Number) posities[pos] = kv.Value.GetInt64();
            if (posities.Count < 2) throw new InvalidOperationException("geen posities gelezen");
            if (welke == 1) _dmPos1 = posities; else _dmPos2 = posities;
            return Task.FromResult($"pos {welke}: " + DualTekst(posities));
        });
    }

    private async Task StartDualmotion()
    {
        var d = DualDrives();
        if (d is null || !DualKlaar) return;
        _dm = new DualUitslag { Bezig = true, Samenvatting = "bezig…" };
        _taakIsTest = true;
        var titel = $"Dual motion drives {d.Value.A.Positie}+{d.Value.B.Positie} ({_dmSnelheid} rpm, {_dmHerhalingen}×{(_dmInterpoleren ? ", geïnterpoleerd" : "")})";
        var body = JsonSerializer.Serialize(DualBody("run", new
        {
            pos1 = _dmPos1!.ToDictionary(k => k.Key.ToString(), k => k.Value),
            pos2 = _dmPos2!.ToDictionary(k => k.Key.ToString(), k => k.Value),
            snelheid = _dmSnelheid, acceleratie = _dmAcc, herhalingen = _dmHerhalingen, maxVolgfoutPct = _mtVolgfout * 100.0,
            interpoleren = _dmInterpoleren,
        }));
        await VoerTaakUit("drives.dualmotion", body, titel, 1800, async res =>
        {
            if (res.ValueKind != JsonValueKind.Object) throw new InvalidOperationException("geen resultaat");
            if (res.TryGetProperty("sto_ontbreekt", out var sto) && sto.ValueKind == JsonValueKind.True)
            {
                var tekst = Tekst(res, "samenvatting");
                _dm = null;
                try { await JS.InvokeVoidAsync("mdeMelding", tekst, "⛔ STO niet vrijgegeven — test afgebroken"); } catch { }
                throw new InvalidOperationException(tekst);
            }
            DualLive(res);
            var geslaagd = res.TryGetProperty("geslaagd", out var g) && g.ValueKind == JsonValueKind.True;
            var samenvatting = Tekst(res, "samenvatting");
            _dm!.Bezig = false; _dm.Geslaagd = geslaagd; _dm.Samenvatting = samenvatting;
            _testLaatste = $"Dual motion {(geslaagd ? "GESLAAGD" : "AFGEKEURD")}";
            await Repo.VoegHistorieToeAsync(ProductId, $"{titel}: {(geslaagd ? "GESLAAGD" : "AFGEKEURD")} — {samenvatting}" + Opm(), SoortId("Test"), Ik.WerknemerId, uitkomst: geslaagd);
            if (!geslaagd) throw new InvalidOperationException(samenvatting);
            return samenvatting;
        }, DualLive);
        if (_dm is { Bezig: true }) { _dm.Bezig = false; _dm.Samenvatting = _taakFout ?? _dm.Samenvatting; }
        await LaadTestHistorie();
    }

    private void DualLive(JsonElement r)
    {
        if (_dm is null) return;
        if (r.TryGetProperty("bewegingen", out var bw) && bw.ValueKind == JsonValueKind.Array)
        {
            var d = DualDrives();
            var lijst = new List<DualBeweging>();
            foreach (var b in bw.EnumerateArray())
                lijst.Add(new DualBeweging(Getal(b, "herhaling"), Tekst(b, "doel"),
                    b.TryGetProperty("duur", out var du) && du.ValueKind == JsonValueKind.Number ? du.GetDouble() : 0,
                    d is null ? 0 : Getal(b, $"vf{d.Value.A.Positie}"), d is null ? 0 : Getal(b, $"vf{d.Value.B.Positie}"),
                    b.TryGetProperty("ok", out var ok) && ok.ValueKind == JsonValueKind.True, Tekst(b, "reden")));
            _dm.Bewegingen = lijst;
            if (_dm.Bezig && r.TryGetProperty("n", out var n) && r.TryGetProperty("totaal", out var t)) _dm.Samenvatting = $"beweging {n.GetRawText()} van {t.GetRawText()}";
        }
        StateHasChanged();
    }

    // ---- stroomlus (Current Direct Tuning) — agenttaak drives.stroomlus
    private sealed class StroomlusUitslag
    {
        public bool Geslaagd; public string Samenvatting = "";
        public string DemandPunten = "", WaardePunten = "";
        public double Schaal, Ms; public int Hz;
        public string Stijgtijd = "", StijgtijdMax = "", Overshoot = "", Fout = "", Rimpel = "";
    }
    private StroomlusUitslag? _sl;
    private int _slPositie;
    private double _slAmplitude = 1.0;
    private int _slFrequentie = 200;

    /// <summary>Firmware met dictionary voor de drive op deze positie: de gekozen, anders de eerste die er een heeft.</summary>
    private DriveFirmware? StroomlusFirmware(int positie)
    {
        var p = DrivePosities.FirstOrDefault(x => x.Positie == positie) ?? DrivePosities.FirstOrDefault(x => !IsCoe(x));
        if (p is null) return null;
        var gekozen = _alleFirmwares.FirstOrDefault(f => f.Id == Keuze(p.Positie).FirmwareId);
        if (gekozen?.DictionaryFileId is not null) return gekozen;
        return FirmwaresVoor(p).FirstOrDefault(f => f.DictionaryFileId is not null);
    }

    private async Task StartStroomlus()
    {
        var p = DrivePosities.FirstOrDefault(x => x.Positie == _slPositie) ?? DrivePosities.FirstOrDefault(x => !IsCoe(x));
        var fw = p is null ? null : StroomlusFirmware(p.Positie);
        if (p is null || fw?.DictionaryFileId is null) return;
        _slPositie = p.Positie;
        _sl = null;
        var sec = Config.GetSection("Productie:Stroomlus");
        double G(string n, double d) => double.TryParse(sec[n], System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : d;
        var body = JsonSerializer.Serialize(new
        {
            positie = p.Positie, dictionary = BestandUrl(fw.DictionaryFileId.Value),
            amplitude = _slAmplitude, frequentie = _slFrequentie, perioden = (int)G("Perioden", 3),
            stijgtijdMs = G("StijgtijdMs", 0.5), overshootPct = G("OvershootPct", 15), foutPct = G("FoutPct", 5), rimpelPct = G("RimpelPct", 10),
            maxDeelMaxstroom = G("MaxDeelMaxstroom", 0.2),
        });
        _taakIsTest = true;
        await VoerTaakUit("drives.stroomlus", body, $"Stroomlus drive {p.Positie} ({p.Naam}) ±{_slAmplitude} A / {_slFrequentie} Hz", 180, async res =>
        {
            if (res.ValueKind != JsonValueKind.Object) throw new InvalidOperationException("geen resultaat");
            if (res.TryGetProperty("sto_ontbreekt", out var sto) && sto.ValueKind == JsonValueKind.True)
            {
                var tekst = Tekst(res, "samenvatting");
                _testLaatste = "Stroomlus AFGEBROKEN (STO)";
                try { await JS.InvokeVoidAsync("mdeMelding", tekst, "⛔ STO niet vrijgegeven — test afgebroken"); } catch { }
                throw new InvalidOperationException(tekst);
            }
            var u = new StroomlusUitslag
            {
                Geslaagd = res.TryGetProperty("geslaagd", out var g) && g.ValueKind == JsonValueKind.True,
                Samenvatting = Tekst(res, "samenvatting"),
                Hz = (int)Math.Round(res.TryGetProperty("blokgolf_hz", out var bh) && bh.ValueKind == JsonValueKind.Number ? bh.GetDouble() : _slFrequentie),
            };
            List<double> Reeks(string n) => res.TryGetProperty(n, out var a) && a.ValueKind == JsonValueKind.Array
                ? a.EnumerateArray().Select(x => x.ValueKind == JsonValueKind.Number ? x.GetDouble() : 0).ToList() : new();
            var t = Reeks("t"); var dem = Reeks("demand"); var w = Reeks("waarde");
            var n = Math.Min(t.Count, Math.Min(dem.Count, w.Count));
            if (n > 1)
            {
                var schaal = Math.Max(0.001, Math.Max(dem.Take(n).Select(Math.Abs).Max(), w.Take(n).Select(Math.Abs).Max()) * 1.15);
                var tMax = Math.Max(1e-6, t[n - 1]);
                var ci = System.Globalization.CultureInfo.InvariantCulture;
                string Punten(List<double> y) => string.Join(" ", Enumerable.Range(0, n).Select(i =>
                    (t[i] / tMax * 800).ToString("0.#", ci) + "," + (130 - y[i] / schaal * 130).ToString("0.#", ci)));
                u.DemandPunten = Punten(dem); u.WaardePunten = Punten(w);
                u.Schaal = schaal; u.Ms = tMax * 1000;
            }
            if (res.TryGetProperty("metingen", out var m) && m.ValueKind == JsonValueKind.Object)
            {
                u.Stijgtijd = Tekst(m, "stijgtijd_ms"); u.StijgtijdMax = Tekst(m, "stijgtijd_max_ms");
                u.Overshoot = Tekst(m, "overshoot_pct"); u.Fout = Tekst(m, "fout_pct"); u.Rimpel = Tekst(m, "rimpel_pct");
            }
            _sl = u;
            _testLaatste = $"Stroomlus drive {p.Positie} {(u.Geslaagd ? "GESLAAGD" : "AFGEKEURD")}";
            await Repo.VoegHistorieToeAsync(ProductId,
                $"Stroomlus drive {p.Positie} ({p.Naam}): {(u.Geslaagd ? "GESLAAGD" : "AFGEKEURD")} — {u.Samenvatting}" + Opm(),
                SoortId("Test"), Ik.WerknemerId, uitkomst: u.Geslaagd);
            if (!u.Geslaagd) throw new InvalidOperationException(u.Samenvatting);
            return u.Samenvatting;
        });
    }


    // ---- uitgangen handmatig (io.zet), zonder historie en zonder het grote taakvenster ----
    private static string IoTitel(int positie, int uitgang, bool aan)
        => $"Drive {positie} uitgang {uitgang} {(aan ? "uit" : "aan")}";

    private Task SchakelUitgang(int positie, int uitgang, bool aan)
        => IoZet(positie, JsonSerializer.Serialize(new { positie, uitgang, aan }));

    private Task ZetMasker(int positie, int masker)
        => IoZet(positie, JsonSerializer.Serialize(new { positie, masker }));

    private async Task IoZet(int positie, string body)
    {
        if (_taakBezig) return;
        _taakBezig = true;
        try
        {
            var start = await Agent("/taken/io.zet", 30, body);
            if (start.status != 202) { Toon(FoutUit(start.tekst) ?? start.tekst, true); return; }
            string? jobId;
            using (var doc = JsonDocument.Parse(start.tekst)) jobId = doc.RootElement.GetProperty("job").GetString();

            for (var i = 0; i < 60; i++)
            {
                await Task.Delay(300);
                var st = await Agent($"/jobs/{jobId}", 20);
                if (st.status != 200) continue;
                using var doc = JsonDocument.Parse(st.tekst);
                var stand = Tekst(doc.RootElement, "stand");
                if (stand == "klaar")
                {
                    if (doc.RootElement.TryGetProperty("resultaat", out var res) && res.ValueKind == JsonValueKind.Object)
                        _uitgangen[positie] = Getal(res, "gelezen");
                    return;
                }
                if (stand == "mislukt") { Toon("Uitgang zetten mislukt: " + Tekst(doc.RootElement, "fout"), true); return; }
            }
            Toon("Uitgang zetten: geen antwoord van de agent.", true);
        }
        catch (Exception ex) { Toon("Uitgang zetten mislukt: " + ex.Message, true); }
        finally { _taakBezig = false; }
    }

    // ---------------------------------------------------------------- de gedeelde taak-runner

    /// <summary>
    /// Start een job bij de agent, volgt hem (log + voortgang) en roept bij 'klaar' de afronding
    /// aan, die de historie bijwerkt en een samenvatting teruggeeft. Mislukt de taak, dan komt dat
    /// ook in de historie. Daarna wordt de aanroeper geïnformeerd (OpGewijzigd).
    /// </summary>
    private async Task VoerTaakUit(string taak, string body, string titel, int maxSeconden, Func<JsonElement, Task<string>> afronden, Action<JsonElement>? live = null)
    {
        if (_taakBezig) return;
        _taakBezig = true; _taakKlaar = false;
        _taakTitel = titel; _taakFout = null; _taakResultaat = null; _taakProcent = 0; _taakRegels = new();
        _taakJobId = null; _taakStopGevraagd = false;
        if (!taak.StartsWith("test.") && taak is not ("drives.stroomlus" or "drives.encodertest" or "drives.motiontest" or "drives.phasing" or "drives.dualmotion")) _taakIsTest = false;
        _taakStop = new CancellationTokenSource(TimeSpan.FromSeconds(maxSeconden));
        try
        {
            var start = await Agent("/taken/" + taak, 30, body);
            if (start.status != 202)
            {
                _taakFout = start.status switch
                {
                    0 => start.tekst,
                    401 => "De agent weigert: token klopt niet (Productie:AgentToken).",
                    404 => $"De agent kent de taak '{taak}' niet (agent bijwerken).",
                    503 => FoutUit(start.tekst) ?? "Taak niet beschikbaar op deze pc.",
                    _ => FoutUit(start.tekst) ?? $"Agent antwoordde {start.status}."
                };
                return;
            }
            string? jobId;
            using (var doc = JsonDocument.Parse(start.tekst))
                jobId = doc.RootElement.GetProperty("job").GetString();
            _taakJobId = jobId;

            var vanaf = 0;
            var gemist = 0;
            while (!_taakStop.IsCancellationRequested)
            {
                await Task.Delay(live is null ? 800 : 250, _taakStop.Token);
                var st = await Agent($"/jobs/{jobId}?vanaf={vanaf}", 20);
                if (st.status != 200)
                {
                    // Hapert de verbinding browser ↔ app even, dan loopt de taak bij de agent gewoon door:
                    // niet opgeven zolang de tijdslimiet niet om is — alleen bij 401/404 meteen stoppen.
                    if (st.status is 401 or 404) { _taakFout = st.tekst; break; }
                    gemist++;
                    if (gemist == 1 || gemist % 5 == 0)
                        _taakRegels.Add($"… verbinding hapert ({gemist}×, {st.tekst}); de taak loopt door, blijven proberen");
                    StateHasChanged();
                    continue;
                }
                if (gemist > 0) _taakRegels.Add($"… verbinding hersteld na {gemist} gemiste poll(s)");
                gemist = 0;

                using var doc = JsonDocument.Parse(st.tekst);
                var w = doc.RootElement;
                _taakProcent = Getal(w, "procent");
                if (w.TryGetProperty("regels", out var regels) && regels.ValueKind == JsonValueKind.Array)
                    foreach (var r in regels.EnumerateArray())
                        if (r.GetString() is { } t) _taakRegels.Add(t);
                vanaf = Getal(w, "regelsTotaal");
                if (_taakRegels.Count > 400) _taakRegels.RemoveRange(0, _taakRegels.Count - 400);

                var stand = Tekst(w, "stand");
                if (live is not null && stand == "bezig" && w.TryGetProperty("resultaat", out var tussen) && tussen.ValueKind == JsonValueKind.Object
                    && tussen.TryGetProperty("live", out var lv) && lv.ValueKind == JsonValueKind.True)
                {
                    try { live(tussen); } catch { }
                }
                if (stand == "klaar")
                {
                    try
                    {
                        _taakResultaat = await afronden(w.TryGetProperty("resultaat", out var res) ? res : default);
                        _taakKlaar = true;
                    }
                    catch (Exception ex) { _taakFout = ex.Message; }
                    break;
                }
                if (stand == "mislukt")
                {
                    _taakFout = Tekst(w, "fout");
                    await Repo.VoegHistorieToeAsync(ProductId, $"{titel}: MISLUKT — {_taakFout}", SoortId("Test"), Ik.WerknemerId, uitkomst: false);
                    break;
                }
                StateHasChanged();
            }
            if (_taakStop.IsCancellationRequested && !_taakKlaar && _taakFout is null)
                _taakFout = "Taak duurde te lang; afgebroken door de app.";
        }
        catch (TaskCanceledException) { _taakFout ??= "Afgebroken."; }
        catch (Exception ex) { _taakFout = "Volgen van de taak mislukt: " + ex.Message; }
        finally
        {
            _taakBezig = false; _taakJobId = null; _taakStopGevraagd = false;
            _taakStop?.Dispose(); _taakStop = null;
            _resultaat = "";
            try { _attributen = await Repo.GetAttributenAsync(ProductId); } catch { }
            await Gewijzigd();
        }
    }

    // ---------------------------------------------------------------- drives uitlezen

    private bool _leest;
    private List<DriveRegel>? _drives;
    private List<string> _driveFouten = new();
    private bool _drivesGo;
    private bool _drivesOpgeslagen;
    private string _drivesOordeel = "";
    private string _driveAdapter = "";

    // Controle tegen de drivetypen-tabel (Controllertypen en firmware, Producten ▸ Techniek).
    private sealed class DriveControle
    {
        public int Positie;
        public string Naam = "";
        public string Serienummer = "";
        public string TypeTekst = "", TypeKleur = "s-grijs";
        public string FirmwareTekst = "", FirmwareKleur = "s-grijs";
        public string ParametersTekst = "";
        public bool TypeFout;
    }
    private List<DriveControle> _controles = new();

    private sealed class DriveRegel
    {
        public int Positie;
        public string As = "";
        public string Naam = "";
        public string VendorId = "";       // EtherCAT Vendor ID (0x1018:1), hex
        public string ProductCode = "";
        public string Revisie = "";
        public string Serienummer = "";
        public string Firmware = "";
        public string Hardware = "";
        public string ApparaatNaam = "";
        public string TypeUitTabel = "";   // Productie:DriveTypen[productcode]
        /// <summary>Type zonder elektronisch serienummer (eRob): ontbreken ervan is geen NO-GO;
        /// het serienummer van het typeplaatje wordt met de hand in het attribuut gezet.</summary>
        public bool ZonderElektronischSn;
        /// <summary>eRob: serienummer/model/hardware over CAN gelezen (ZeroErr-protocol, index 0x232).</summary>
        public bool SerienummerViaCan;
        public string Model = "";
        public string Partnummer = "";
        public int CanId;
        /// <summary>Leesbaar type: eerst de tabel op productcode, dan 0x1008, dan de EEPROM-naam.</summary>
        public string Type
        {
            get
            {
                var n = TypeUitTabel.Length > 0 ? TypeUitTabel
                      : ApparaatNaam.Length > 0 ? ApparaatNaam
                      : Naam.Replace(" Drv", "", StringComparison.OrdinalIgnoreCase).Trim();
                return n + (ProductCode.Length > 0 ? $" ({ProductCode})" : "");
            }
        }
        public List<string> Fouten = new();
        public bool Ok => Serienummer.Length > 0 && As.Length > 0 && Fouten.Count == 0;
    }

    /// <summary>Per drive: type herkennen op productcode, vergelijken met de verwachte positie,
    /// firmwarestatus opzoeken en kijken of er een parameterset is.</summary>
    private async Task ControleerDrives(List<DriveRegel> regels)
    {
        _controles = new();
        if (!Drives.Beschikbaar) return;
        List<DrivePositie> posities;
        try { posities = await Drives.GetPositiesAsync(Naam.Id); }
        catch { return; }   // tabellen ontbreken nog: dan geen controle

        for (var i = 0; i < regels.Count; i++)
        {
            var r = regels[i];
            var c = new DriveControle { Positie = i + 1, Naam = r.As, Serienummer = r.Serienummer };
            var verwacht = posities.FirstOrDefault(p => p.Positie == i + 1);

            var type = await Drives.ZoekTypeOpCodeAsync(r.ProductCode, r.VendorId);
            if (type is null)
            {
                c.TypeTekst = $"onbekend type {r.ProductCode}" + (r.VendorId.Length > 0 ? $" van fabrikant {r.VendorId}" : "");
                c.TypeKleur = "s-geel";
                c.FirmwareTekst = r.Firmware.Length > 0 ? r.Firmware : "—";
                c.ParametersTekst = "—";
                _controles.Add(c);
                continue;
            }
            r.TypeUitTabel = type.Naam;
            if (DriveProtocol.ViaSdo(type.Protocol))
            {
                // eRob en MDE-slaves: geen elektronisch serienummer (0x1018:4 = 0) en geen Ingenia-registers.
                r.ZonderElektronischSn = true;
                r.Fouten.RemoveAll(f => f.Contains("0x26E6") || f.Contains("0x1018"));
            }

            if (verwacht?.DriveTypeId is int vt && vt != type.Id)
            {
                c.TypeTekst = $"{type.Naam} — verwacht {verwacht.DriveTypeNaam}";
                c.TypeKleur = "s-rood";
                c.TypeFout = true;
            }
            else
            {
                c.TypeTekst = type.Naam + (verwacht?.DriveTypeId is null ? " (niet gecontroleerd)" : " ✓");
                c.TypeKleur = verwacht?.DriveTypeId is null ? "s-grijs" : "s-groen";
                // Herkend op productcode alleen: de fabrikantcode is bij Controllertypen nog niet vastgelegd.
                if (type.VendorId.Trim().Length == 0 && r.VendorId.Length > 0)
                    c.TypeTekst += $" — fabrikantcode {r.VendorId} nog niet vastgelegd";
            }

            DriveFirmware? fw = null;
            if (r.Firmware.Length > 0)
                fw = await Drives.ZoekFirmwareAsync(type.Id, r.Firmware);
            if (r.Firmware.Length == 0)
            {
                c.FirmwareTekst = "niet gelezen";
                c.FirmwareKleur = "s-grijs";
            }
            else if (fw is null)
            {
                c.FirmwareTekst = $"{r.Firmware} — onbekende versie";
                c.FirmwareKleur = "s-geel";
            }
            else
            {
                c.FirmwareTekst = fw.Status switch
                {
                    DriveStatus.Actueel => $"{fw.Versie} · actueel",
                    DriveStatus.Toegestaan => $"{fw.Versie} · toegestaan (nieuwere beschikbaar)",
                    DriveStatus.Geblokkeerd => $"{fw.Versie} · GEBLOKKEERD",
                    _ => fw.Versie
                };
                c.FirmwareKleur = DriveStatus.Kleur(fw.Status);
            }

            if (fw is not null)
            {
                var ps = await Drives.ZoekParametersetAsync(Naam.Id, i + 1, fw.Id);
                c.ParametersTekst = ps is null
                    ? "geen parameterset voor deze positie en firmware"
                    : (ps.Omschrijving.Length > 0 ? ps.Omschrijving : ps.ParameterBestand);
            }
            else c.ParametersTekst = "—";

            _controles.Add(c);
        }
    }

    /// <summary>De drives op de print uitlezen via de agent en beoordelen: per as één drive,
    /// in volgorde van slave-positie, allemaal met serienummer. Anders no-go.</summary>
    private async Task LeesDrives()
    {
        if (_leest || _agentUrl.Length == 0) return;

        // Zonder aangewezen attributen valt er niets te plaatsen — dan ook niet uitlezen.
        if (Assen().Length == 0)
        {
            Toon($"'{Naam.Naam}' heeft geen attributen met een automatische bron (drive 1/2 · serienummer). " +
                 "Stel die in bij Producten ▸ producttype ▸ Attributen ▸ 'Automatisch gevuld uit'" +
                 (_sjabloon.Count > 0 && _sjabloon.All(s => s.Bron.Length == 0)
                    ? " (en controleer dat ProductAttribuutBron_MariaDB.sql is uitgevoerd)." : "."), true);
            return;
        }

        _leest = true;
        _drives = null;
        _drivesOpgeslagen = false;
        _driveFouten = new();
        _controles = new();
        try
        {
            var antwoord = await Agent("/drives", 120);
            if (antwoord.status == 0 || antwoord.status == 401)
            {
                _driveFouten.Add(antwoord.status == 401 ? "De agent weigert: token klopt niet (Productie:AgentToken)." : antwoord.tekst);
                Beoordeel(new());
                return;
            }

            using var doc = JsonDocument.Parse(antwoord.tekst);
            var wortel = doc.RootElement;
            var regels = new List<DriveRegel>();

            _driveAdapter = Tekst(wortel, "adapter");
            if (wortel.TryGetProperty("errors", out var errs) && errs.ValueKind == JsonValueKind.Array)
                foreach (var e in errs.EnumerateArray())
                    if (e.GetString() is { Length: > 0 } t) _driveFouten.Add(t);

            if (wortel.TryGetProperty("drives", out var drives) && drives.ValueKind == JsonValueKind.Array)
            {
                foreach (var d in drives.EnumerateArray())
                {
                    var r = new DriveRegel
                    {
                        Positie = Getal(d, "slave_position"),
                        Naam = Tekst(d, "name"),
                        VendorId = Tekst(d, "vendor_id"),
                        ProductCode = Tekst(d, "product_code"),
                        Revisie = Tekst(d, "revision_number"),
                        Serienummer = Tekst(d, "serial_number"),
                        Firmware = Tekst(d, "software_version"),
                        Hardware = Tekst(d, "hardware_version"),
                        ApparaatNaam = Tekst(d, "device_name"),
                    };
                    r.TypeUitTabel = Config[$"Productie:DriveTypen:{r.ProductCode}"] ?? "";
                    if (d.TryGetProperty("errors", out var df) && df.ValueKind == JsonValueKind.Array)
                        foreach (var e in df.EnumerateArray())
                            if (e.GetString() is { Length: > 0 } t) r.Fouten.Add(t);
                    if (r.Serienummer is "0" or "None") r.Serienummer = "";
                    regels.Add(r);
                }
            }

            regels = regels.OrderBy(r => r.Positie).ToList();
            var assen = Assen();
            for (var i = 0; i < regels.Count; i++)
                regels[i].As = i < assen.Length ? assen[i] : "";

            await ControleerDrives(regels);
            Beoordeel(regels);

            // GO? Dan meteen opslaan. Alleen als er al een (andere) waarde in een attribuut staat, eerst vragen.
            if (_drivesGo)
            {
                var overschrijft = new List<string>();
                for (var i = 0; i < regels.Count; i++)
                {
                    var r = regels[i];
                    foreach (var s in _sjabloon.Where(s => AttribuutBronnen.Drive(s.Bron) is { } d && d.Nummer == i + 1))
                    {
                        var nieuw = AttribuutBronnen.Drive(s.Bron)!.Value.Veld switch
                        {
                            "serienummer" => r.Serienummer,
                            "type" => r.Type,
                            "firmware" => r.Firmware,
                            "hardware" => r.Hardware,
                            _ => ""
                        };
                        if (nieuw.Length == 0) continue;
                        var huidig = (_attributen.FirstOrDefault(x => x.SjabloonId == s.Id)
                                      ?? _attributen.FirstOrDefault(x => string.Equals(x.Attribuut, s.Attribuut, StringComparison.OrdinalIgnoreCase)))
                                     ?.Waarde.Trim() ?? "";
                        if (huidig.Length > 0 && huidig != nieuw)
                            overschrijft.Add($"  • {s.Attribuut}: {huidig}  →  {nieuw}");
                    }
                }

                if (overschrijft.Count == 0 ||
                    await Bevestig("Deze attributen hebben al een andere waarde:\n" + string.Join("\n", overschrijft) +
                                   "\n\nOverschrijven?"))
                    await BewaarDrives();
            }
        }
        catch (Exception ex)
        {
            _driveFouten.Add("Antwoord van de agent niet te lezen: " + ex.Message);
            Beoordeel(new());
        }
        finally { _leest = false; }
    }

    /// <summary>
    /// Techniek 'eRob via CAN': de losse eRob aan de USBCAN uitlezen met het ZeroErr-protocol
    /// (index 0x232) — serienummer, model, hardware-info, partnummer, firmware — en als drive 1
    /// in de attributen zetten (bronnen drive:1:serienummer / model / hardware / partnummer / firmware).
    /// Zelfde beoordeling en opslag als de EtherCAT-uitlezing, zonder positie-/typecontrole.
    /// </summary>
    private async Task LeesErobCan()
    {
        if (_leest || _agentUrl.Length == 0) return;
        var snAttribuut = _sjabloon.FirstOrDefault(s => AttribuutBronnen.Can(s.Bron) is { Veld: "serienummer" });
        if (snAttribuut is null)
        {
            Toon($"'{Naam.Naam}' heeft geen attribuut met de bron 'eRob via CAN · serienummer'. " +
                 "Stel die in bij Producten ▸ producttype ▸ Attributen ▸ 'Automatisch gevuld uit'.", true);
            return;
        }
        _leest = true;
        _drives = null; _drivesOpgeslagen = false; _driveFouten = new(); _controles = new(); _driveAdapter = "";
        try
        {
            var r = new DriveRegel { Positie = 0, Naam = "eRob", As = snAttribuut.Attribuut, ZonderElektronischSn = true };
            var body = JsonSerializer.Serialize(new { id = _erobCanId, baud = _canBaud, kanaal = _canKanaal });
            await VoerTaakUit("can.erob_info", body, "eRob uitlezen via CAN", 150, res =>
            {
                if (res.ValueKind != JsonValueKind.Object) return Task.FromResult("geen resultaat");
                r.Serienummer = Tekst(res, "serienummer");
                r.Model = Tekst(res, "model");
                r.Partnummer = Tekst(res, "partnummer");
                r.Hardware = Tekst(res, "hardware_info");
                r.Firmware = Tekst(res, "firmware_versie");
                r.CanId = Getal(res, "id");
                r.SerienummerViaCan = r.Serienummer.Length > 0;
                r.TypeUitTabel = r.Model.Length > 0 ? r.Model : "eRob";
                if (r.CanId > 0) _erobCanId = r.CanId;
                if (res.TryGetProperty("meldingen", out var m) && m.ValueKind == JsonValueKind.Object)
                    foreach (var kv in m.EnumerateObject()) r.Fouten.Add($"{kv.Name}: {kv.Value.GetString()}");
                if (Getal(res, "andere_master") > 0) _driveFouten.Add("Let op: een andere master (eRob-Studio?) praatte mee op de CAN-bus; de waarden zijn dubbel gelezen en kwamen overeen.");
                return Task.FromResult(r.Serienummer.Length > 0
                    ? $"SN {r.Serienummer} · {r.Model} · hw {r.Hardware} · PN {r.Partnummer} (CAN-ID {r.CanId})"
                    : "eRob antwoordde, maar zonder serienummer (index 0x232 vraagt firmware X5061715X of nieuwer)");
            });
            if (_taakFout is not null) { _driveFouten.Add(_taakFout); Beoordeel(new()); return; }
            if (r.Serienummer.Length == 0) r.Fouten.Add("geen serienummer (index 0x232)");
            r.ZonderElektronischSn = false;      // via CAN hóórt er een nummer te zijn: ontbreken is NO-GO
            _controles.Add(new DriveControle
            {
                Positie = 1, Naam = r.As, TypeTekst = r.TypeUitTabel, TypeKleur = "s-groen",
                FirmwareTekst = r.Firmware.Length > 0 ? r.Firmware : "—", FirmwareKleur = "s-grijs",
                ParametersTekst = r.Partnummer.Length > 0 ? $"PN {r.Partnummer} · hw {r.Hardware}" : "—"
            });
            // eigen beoordeling (Beoordeel() telt EtherCAT-assen): één eRob, met serienummer, zonder meldingen
            _drives = new List<DriveRegel> { r };
            var redenen = new List<string>();
            if (r.Serienummer.Length == 0) redenen.Add("geen serienummer gelezen");
            if (r.Fouten.Count > 0) redenen.Add($"{r.Fouten.Count} melding(en)");
            _drivesGo = redenen.Count == 0;
            _drivesOordeel = _drivesGo ? $"eRob {r.Model} · SN {r.Serienummer} (CAN-ID {r.CanId})" : string.Join(" · ", redenen);
            _driveAdapter = "";
            if (_drivesGo)
            {
                var overschrijft = new List<string>();
                foreach (var s in _sjabloon.Where(s => AttribuutBronnen.Can(s.Bron) is not null))
                {
                    var nieuw = AttribuutBronnen.Can(s.Bron)!.Value.Veld switch
                    {
                        "serienummer" => r.Serienummer, "firmware" => r.Firmware,
                        "hardware" => r.Hardware, "model" => r.Model, "partnummer" => r.Partnummer, _ => ""
                    };
                    if (nieuw.Length == 0) continue;
                    var huidig = (_attributen.FirstOrDefault(x => x.SjabloonId == s.Id)
                                  ?? _attributen.FirstOrDefault(x => string.Equals(x.Attribuut, s.Attribuut, StringComparison.OrdinalIgnoreCase)))
                                 ?.Waarde.Trim() ?? "";
                    if (huidig.Length > 0 && huidig != nieuw) overschrijft.Add($"  • {s.Attribuut}: {huidig}  →  {nieuw}");
                }
                if (overschrijft.Count == 0 ||
                    await Bevestig("Deze attributen hebben al een andere waarde:\n" + string.Join("\n", overschrijft) + "\n\nOverschrijven?"))
                    await BewaarDrives();
            }
        }
        catch (Exception ex) { _driveFouten.Add("eRob uitlezen mislukt: " + ex.Message); Beoordeel(new()); }
        finally { _leest = false; }
    }

    private void Beoordeel(List<DriveRegel> regels)
    {
        _drives = regels;
        var assen = Assen();
        var redenen = new List<string>();
        if (regels.Count != assen.Length)
            redenen.Add($"{regels.Count} drive(s) gevonden, {assen.Length} verwacht ({string.Join(", ", assen)})");
        var zonder = regels.Count(r => r.Serienummer.Length == 0 && !r.ZonderElektronischSn);
        if (zonder > 0) redenen.Add($"{zonder} drive(s) zonder serienummer");
        var handmatig = regels.Count(r => r.Serienummer.Length == 0 && r.ZonderElektronischSn);
        if (handmatig > 0) _driveFouten.Add($"{handmatig} drive(s) zonder elektronisch serienummer (eRob): vul het nummer van het typeplaatje in bij het attribuut.");
        var metFout = regels.Count(r => r.Fouten.Count > 0);
        if (metFout > 0) redenen.Add($"{metFout} drive(s) met meldingen");
        var verkeerdType = _controles.Count(c => c.TypeFout);
        if (verkeerdType > 0) redenen.Add($"{verkeerdType} drive(s) van een ander type dan verwacht");
        if (_driveFouten.Count > 0 && regels.Count == 0) redenen.Add("uitlezen mislukt");

        _drivesGo = redenen.Count == 0;
        _drivesOordeel = _drivesGo
            ? $"{regels.Count} drives, alle serienummers gelezen."
            : string.Join(" · ", redenen);
        if (_driveAdapter.Length > 0) _drivesOordeel += $" (adapter: {_driveAdapter})";
    }

    /// <summary>De uitgelezen waarden als attributen bij het exemplaar zetten (via Bron) plus historie.</summary>
    private async Task BewaarDrives()
    {
        if (_drives is null || !_drivesGo || _bezig) return;
        _bezig = true;
        _drivesOpgeslagen = false;
        try
        {
            for (var i = 0; i < _drives.Count; i++)
            {
                var d = _drives[i];
                if (d.SerienummerViaCan)
                {
                    // eRob via CAN: eigen bronnen (can:1:…), los van de EtherCAT-drives
                    await ZetViaBron("can:1:serienummer", d.Serienummer);
                    if (d.Model.Length > 0) await ZetViaBron("can:1:model", d.Model);
                    if (d.Partnummer.Length > 0) await ZetViaBron("can:1:partnummer", d.Partnummer);
                    if (d.Hardware.Length > 0) await ZetViaBron("can:1:hardware", d.Hardware);
                    if (d.Firmware.Length > 0) await ZetViaBron("can:1:firmware", d.Firmware);
                    continue;
                }
                if (d.Serienummer.Length > 0) await ZetViaBron($"drive:{i + 1}:serienummer", d.Serienummer);   // eRob: handmatig nummer niet wissen
                await ZetViaBron($"drive:{i + 1}:type", d.Type);
                if (d.Firmware.Length > 0) await ZetViaBron($"drive:{i + 1}:firmware", d.Firmware);
                if (d.Hardware.Length > 0) await ZetViaBron($"drive:{i + 1}:hardware", d.Hardware);
            }

            var tekstDelen = _drives.Select(d => $"{d.As} {d.Serienummer}").ToList();
            var soort = (_soorten.FirstOrDefault(s => s.Naam.Contains("uitlezen", StringComparison.OrdinalIgnoreCase))
                         ?? _soorten.FirstOrDefault(s => s.Naam.Contains("Test", StringComparison.OrdinalIgnoreCase)))?.Id
                        ?? _soortId;
            for (var i = 0; i < _drives.Count; i++)
            {
                var d = _drives[i];
                var delen = new List<string> { $"SN {(d.Serienummer.Length > 0 ? d.Serienummer : "— (typeplaatje)")}", d.Type };
                if (d.Firmware.Length > 0) delen.Add($"firmware {d.Firmware}");
                if (d.Hardware.Length > 0) delen.Add($"hardware {d.Hardware}");
                if (d.Model.Length > 0) delen.Add(d.Model);
                if (d.Partnummer.Length > 0) delen.Add($"PN {d.Partnummer}");
                if (d.SerienummerViaCan) delen.Add($"via CAN (ID {d.CanId})");
                if (d.Revisie.Length > 0) delen.Add($"rev {d.Revisie}");
                await Repo.VoegHistorieToeAsync(ProductId,
                    $"Drive {i + 1} uitgelezen ({d.As}): {string.Join(", ", delen)}", soort, Ik.WerknemerId);
            }

            _attributen = await Repo.GetAttributenAsync(ProductId);
            _drivesOpgeslagen = true;
            _drives = null;   // het resultaat staat nu in de attributen zelf
            Toon("Uitgelezen en opgeslagen: " + string.Join(", ", tekstDelen), false);
            await Gewijzigd();
        }
        catch (Exception ex) { Toon("Opslaan mislukt: " + ex.Message, true); }
        finally { _bezig = false; }
    }

    /// <summary>Een waarde wegschrijven in het attribuut dat volgens het producttype deze bron heeft.
    /// Geen attribuut met die bron = niets doen. Geeft terug of er iets is weggeschreven.</summary>
    private async Task<bool> ZetViaBron(string bron, string waarde)
    {
        var geschreven = false;
        foreach (var s in _sjabloon.Where(s => string.Equals(s.Bron, bron, StringComparison.OrdinalIgnoreCase)))
        {
            var a = _attributen.FirstOrDefault(x => x.SjabloonId == s.Id)
                    ?? _attributen.FirstOrDefault(x => string.Equals(x.Attribuut, s.Attribuut, StringComparison.OrdinalIgnoreCase))
                    ?? new ProductAttribuut
                    {
                        ProductId = ProductId, Attribuut = s.Attribuut, Eenheid = s.Eenheid,
                        Opmerking = s.Opmerking, Verplicht = s.Verplicht, SjabloonId = s.Id
                    };
            a.Waarde = waarde;
            var id = await Repo.BewaarAttribuutAsync(ProductId, a, Ik.WerknemerId);
            if (a.Id == 0) { a.Id = id; _attributen.Add(a); }
            geschreven = true;
        }
        return geschreven;
    }

    // ---------------------------------------------------------------- Feetech-servo

    private ServoInfo ServoUit(JsonElement res)
    {
        var s = new ServoInfo { Poort = Tekst(res, "poort"), Baud = Getal(res, "baud") };
        if (res.ValueKind == JsonValueKind.Object && res.TryGetProperty("servo", out var sv) && sv.ValueKind == JsonValueKind.Object)
        {
            s.Id = Getal(sv, "id"); s.Model = Tekst(sv, "model"); s.Firmware = Tekst(sv, "firmware"); s.Servoversie = Tekst(sv, "servoversie");
            if (sv.TryGetProperty("registers", out var regs) && regs.ValueKind == JsonValueKind.Array)
                foreach (var r in regs.EnumerateArray())
                    s.Registers.Add(new ServoRegister(Getal(r, "adres"), Tekst(r, "naam"),
                        r.TryGetProperty("waarde", out var w) && w.ValueKind == JsonValueKind.Number ? w.GetInt64() : null,
                        Tekst(r, "geheugen"), Tekst(r, "rw"), Tekst(r, "fout")));
        }
        return s;
    }

    private async Task LeesServo()
    {
        var body = JsonSerializer.Serialize(new { id = _servoId.Length > 0 ? _servoId : null });
        await VoerTaakUit("feetech.uitlezen", body, "Servo uitlezen", 120, async res =>
        {
            _servo = ServoUit(res);
            _servoId = _servo.Id > 0 ? _servo.Id.ToString() : _servoId;
            await ZetViaBron("motor:id", _servo.Id.ToString());
            await ZetViaBron("motor:model", _servo.Model);
            await ZetViaBron("motor:firmware", _servo.Firmware);
            await Repo.VoegHistorieToeAsync(ProductId,
                $"Servo uitgelezen: ID {_servo.Id}, {_servo.Model}, firmware {_servo.Firmware}, servoversie {_servo.Servoversie}",
                SoortId("uitlezen") ?? SoortId("Test"), Ik.WerknemerId, uitkomst: true);
            return $"ID {_servo.Id}, firmware {_servo.Firmware}";
        });
    }

    private async Task ProgrammeerServo()
    {
        var ps = _parametersets.FirstOrDefault(p => p.Id == _servoParamsId);
        if (ps?.ParameterFileId is null) return;
        var naam = ps.Omschrijving.Length > 0 ? ps.Omschrijving : ps.ParameterBestand;
        if (ps.Status == DriveStatus.Geblokkeerd && !await Bevestig($"Parameterset '{naam}' is GEBLOKKEERD. Toch laden?")) return;

        var body = JsonSerializer.Serialize(new
        {
            parameters = BestandUrl(ps.ParameterFileId.Value),
            id = _servoId.Length > 0 ? _servoId : null,
        });
        await VoerTaakUit("feetech.parameters", body, $"Servo programmeren: {naam}", 180, async res =>
        {
            var afwijkingen = Getal(res, "afwijkingen");
            var registers = Getal(res, "registers");
            var nieuwId = Getal(res, "id");
            if (nieuwId > 0) { _servoId = nieuwId.ToString(); await ZetViaBron("motor:id", nieuwId.ToString()); }
            if (Tekst(res, "firmware").Length > 0) await ZetViaBron("motor:firmware", Tekst(res, "firmware"));
            if (Tekst(res, "model").Length > 0) await ZetViaBron("motor:model", Tekst(res, "model"));
            await ZetViaBron("motor:parameters", naam);
            await Repo.VoegHistorieToeAsync(ProductId,
                $"Servo geprogrammeerd met '{naam}': {registers} registers, {afwijkingen} afwijkingen, ID {nieuwId}" + Opm(),
                SoortId("Programmeren") ?? SoortId("Test"), Ik.WerknemerId, uitkomst: afwijkingen == 0);
            if (afwijkingen > 0) throw new InvalidOperationException($"{afwijkingen} registers wijken af na terugkijken");
            return $"{registers} registers geschreven en gecontroleerd; servo is nu ID {nieuwId}";
        });
    }

    // ---------------------------------------------------------------- chip (ESP32/STM32) flashen

    private bool _firmwareOpen;
    private string _chip = "esp32";
    private string _offset = "0x0";
    private string _adres = "0x08000000";
    private bool _wissen;
    private Guid? _firmwareId;
    private string _firmwareNaam = "";
    private long _firmwareBytes;
    private int _firmwareKeuzeId;                              // DriveFirmwareID uit de tabel; 0 = eigen bestand
    private string _flashNaam = "";                            // wat er in historie/attribuut komt: versie of bestandsnaam
    private string? _flashJob;
    private int _flashProcent;
    private List<string> _flashRegels = new();
    private string? _flashFout;
    private string? _flashResultaat;
    private CancellationTokenSource? _flashStop;

    /// <summary>
    /// Firmwareversies voor de gekozen chip, beperkt tot dit halffabricaat: de typen op zijn posities met dat
    /// chip-protocol, én de MDE-slaves erop (een M-Pede-print krijgt de eerste firmware via USB en daarna via
    /// EtherCAT/FoE; het is hetzelfde bestand van hetzelfde type). Zo kan er geen Display-firmware in een Swivel.
    /// Alleen als het product nog helemaal geen typen op zijn posities heeft, vallen we terug op alle typen met
    /// dat protocol. Actueel eerst, geblokkeerd achteraan.
    /// </summary>
    private IEnumerable<DriveFirmware> ChipFirmwares
    {
        get
        {
            var typen = ChipTypenOpPrint;
            if (typen.Count == 0 && !_posities.Any(p => p.DriveTypeId is not null))
                typen = _driveTypen.Where(t => t.Protocol == _chip).Select(t => t.Id).ToHashSet();
            return _alleFirmwares.Where(f => typen.Contains(f.DriveTypeId))
                .OrderBy(f => f.Status == DriveStatus.Actueel ? 0 : f.Status == DriveStatus.Geblokkeerd ? 2 : 1)
                .ThenByDescending(f => f.Versie);
        }
    }

    /// <summary>Typen op de posities van dit product die met de gekozen chip geprogrammeerd worden: het chip-protocol zelf, of een MDE-slave.</summary>
    private HashSet<int> ChipTypenOpPrint
        => _posities.Where(p => p.DriveTypeId is int t && _driveTypen.FirstOrDefault(x => x.Id == t) is { } dt
                              && (dt.Protocol == _chip || dt.Protocol == DriveProtocol.Mde))
                    .Select(p => p.DriveTypeId!.Value).ToHashSet();

    private DriveFirmware? GekozenFirmware => _firmwareKeuzeId == 0 ? null : _alleFirmwares.FirstOrDefault(f => f.Id == _firmwareKeuzeId);

    private string FirmwareOptie(DriveFirmware f)
    {
        var type = _driveTypen.FirstOrDefault(t => t.Id == f.DriveTypeId)?.Naam ?? "";
        return $"{f.Versie} ({f.Status}){(f.FirmwareBestand.Length > 0 ? " · " + f.FirmwareBestand : " · geen bestand")}{(type.Length > 0 ? " — " + type : "")}";
    }

    /// <summary>.hex heeft de adressen al in zich: geen offset/adres vragen.</summary>
    private bool FirmwareIsHex => (GekozenFirmware?.FirmwareBestand ?? _firmwareNaam).EndsWith(".hex", StringComparison.OrdinalIgnoreCase);

    private bool KanFlashen => GekozenFirmware is { } f
        ? f.FirmwareFileId is not null && f.Status != DriveStatus.Geblokkeerd
        : _firmwareId is not null;

    /// <summary>De chip- of targetnaam uit het controllertype van de gekozen firmware (Productcode bij een chip-type).
    /// Bij een MDE-slave is de productcode de EtherCAT-code, dus dan laat de agent de chip zelf herkennen.</summary>
    private string ChipCodeVanType
    {
        get
        {
            var type = _driveTypen.FirstOrDefault(t => t.Id == GekozenFirmware?.DriveTypeId);
            if (type is null || !DriveProtocol.IsChip(type.Protocol)) return "";
            var code = type.ProductCode.Trim();
            return code.Length == 0 || code.Equals(_chip, StringComparison.OrdinalIgnoreCase) ? "" : code;
        }
    }

    private void FirmwareKeuzeGewijzigd(ChangeEventArgs e)
    {
        _firmwareKeuzeId = int.TryParse((string?)e.Value, out var id) ? id : 0;
        _flashFout = null;
    }

    /// <summary>De actuele versie voorkiezen (anders de eerste); niets in de tabel → eigen bestand.</summary>
    private void KiesActueleChipFirmware()
    {
        var lijst = ChipFirmwares.ToList();
        _firmwareKeuzeId = (lijst.FirstOrDefault(f => f.Status == DriveStatus.Actueel && f.FirmwareFileId is not null)
                            ?? lijst.FirstOrDefault(f => f.FirmwareFileId is not null)
                            ?? lijst.FirstOrDefault())?.Id ?? 0;
    }

    private void OpenFirmware()
    {
        // De chip voorkiezen op wat het product heeft.
        if (_technieken.Contains(ProductTechniek.Stm32) && !_technieken.Contains(ProductTechniek.Esp32)) _chip = "stm32";
        else if (_technieken.Contains(ProductTechniek.Esp32)) _chip = "esp32";
        _firmwareOpen = true;
        _flashRegels = new();
        _flashFout = null;
        _flashResultaat = null;
        _flashProcent = 0;
        KiesActueleChipFirmware();
    }

    private void SluitFirmware()
    {
        if (_flashJob is not null) return;
        _firmwareOpen = false;
    }

    private void ChipGewijzigd(ChangeEventArgs e)
    {
        _chip = (string?)e.Value ?? "esp32";
        KiesActueleChipFirmware();
    }
    private void OffsetGewijzigd(ChangeEventArgs e) => _offset = ((string?)e.Value ?? "0x0").Trim();
    private void AdresGewijzigd(ChangeEventArgs e) => _adres = ((string?)e.Value ?? "0x08000000").Trim();

    /// <summary>Het bestand klaarzetten op /api/firmware/{id}; de agent haalt het daar op.</summary>
    private async Task FirmwareGekozen(InputFileChangeEventArgs e)
    {
        try
        {
            var f = e.File;
            using var ms = new MemoryStream();
            await f.OpenReadStream(64 * 1024 * 1024).CopyToAsync(ms);
            _firmwareId = Firmware.Bewaar(f.Name, ms.ToArray());
            _firmwareNaam = f.Name;
            _firmwareBytes = ms.Length;
            _flashFout = null;
        }
        catch (Exception ex) { _flashFout = "Bestand lezen mislukt: " + ex.Message; }
    }

    /// <summary>De flash-taak bij de agent starten en volgen. Het resultaat (MAC of UID) wordt als attribuut gezet.</summary>
    private async Task StartFlash()
    {
        if (!KanFlashen || _flashJob is not null) return;
        _flashRegels = new();
        _flashFout = null;
        _flashResultaat = null;
        _flashProcent = 0;

        // Adres waarop de agent (op de werkplek-pc) de app bereikt.
        var basis = (Config["Productie:AppAdresVoorAgent"] ?? Nav.BaseUri).TrimEnd('/');
        // Uit de tabel: het bestand in de filestore; anders het zojuist geüploade bestand.
        var tabel = GekozenFirmware;
        var firmwareUrl = tabel?.FirmwareFileId is int fid ? BestandUrl(fid) : $"{basis}/api/firmware/{_firmwareId}";
        _flashNaam = tabel is not null ? tabel.Versie : _firmwareNaam;
        var hex = FirmwareIsHex;

        string taak; string body;
        if (_chip == "esp32")
        {
            taak = "esp32.flashen";
            var chipCode = ChipCodeVanType;
            body = JsonSerializer.Serialize(new
            {
                firmware = firmwareUrl,
                offset = hex ? "0x0" : _offset,     // .hex: adressen zitten in het bestand
                wissen = _wissen,
                chip = chipCode.Length > 0 ? chipCode : "auto",
            });
        }
        else
        {
            taak = "stm32.flashen";
            var target = ChipCodeVanType;
            body = JsonSerializer.Serialize(new { firmware = firmwareUrl, adres = _adres, target });
        }

        try
        {
            var start = await Agent("/taken/" + taak, 30, body);
            if (start.status != 202)
            {
                _flashFout = start.status switch
                {
                    0 => start.tekst,
                    401 => "De agent weigert: token klopt niet (Productie:AgentToken).",
                    _ => FoutUit(start.tekst) ?? $"Agent antwoordde {start.status}."
                };
                return;
            }
            using (var doc = JsonDocument.Parse(start.tekst))
                _flashJob = doc.RootElement.GetProperty("job").GetString();

            _flashStop = new CancellationTokenSource();
            var vanaf = 0;
            while (!_flashStop.IsCancellationRequested)
            {
                await Task.Delay(800, _flashStop.Token);
                var st = await Agent($"/jobs/{_flashJob}?vanaf={vanaf}", 20);
                if (st.status != 200) { _flashFout = st.tekst; break; }

                using var doc = JsonDocument.Parse(st.tekst);
                var w = doc.RootElement;
                _flashProcent = Getal(w, "procent");
                if (w.TryGetProperty("regels", out var regels) && regels.ValueKind == JsonValueKind.Array)
                    foreach (var r in regels.EnumerateArray())
                        if (r.GetString() is { } t) _flashRegels.Add(t);
                vanaf = Getal(w, "regelsTotaal");
                if (_flashRegels.Count > 400) _flashRegels.RemoveRange(0, _flashRegels.Count - 400);

                var stand = Tekst(w, "stand");
                if (stand == "klaar")
                {
                    await VerwerkFlashResultaat(w.TryGetProperty("resultaat", out var res) ? res : default);
                    break;
                }
                if (stand == "mislukt")
                {
                    _flashFout = Tekst(w, "fout");
                    await Repo.VoegHistorieToeAsync(ProductId,
                        $"Firmware laden MISLUKT ({_chip.ToUpper()}, {_flashNaam}): {_flashFout}",
                        SoortId("Firmware") ?? _soortId, Ik.WerknemerId, uitkomst: false);
                    break;
                }
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
        catch (Exception ex) { _flashFout = "Volgen van de taak mislukt: " + ex.Message; }
        finally
        {
            _flashJob = null;
            _flashStop?.Dispose();
            _flashStop = null;
            await Gewijzigd();
        }
    }

    private async Task VerwerkFlashResultaat(JsonElement res)
    {
        var stukken = new List<string>();
        var nietOpgeslagen = new List<string>();
        if (res.ValueKind == JsonValueKind.Object)
        {
            var mac = Tekst(res, "mac");
            var uid = Tekst(res, "uid");
            var chip = Tekst(res, "chip");
            var device = Tekst(res, "device");
            // Alleen opslaan in attributen die het product daarvoor heeft aangewezen (Bron).
            if (mac.Length > 0) { stukken.Add("MAC " + mac); if (!await ZetViaBron("esp32:mac", mac)) nietOpgeslagen.Add("esp32:mac"); }
            if (uid.Length > 0) { stukken.Add("UID " + uid); if (!await ZetViaBron("stm32:uid", uid)) nietOpgeslagen.Add("stm32:uid"); }
            if (chip.Length > 0) stukken.Add(chip);
            if (device.Length > 0) stukken.Add(device);
        }
        // Attribuut 'firmware:versie': de versie uit de tabel, of anders de bestandsnaam.
        await ZetViaBron("firmware:versie", _flashNaam);
        // Firmware van een MDE-slave via USB geladen: ook de drive-positie(s) van dat type bijwerken, zoals bij FoE.
        if (GekozenFirmware is { } gf)
            foreach (var p in _posities.Where(p => p.DriveTypeId == gf.DriveTypeId && !DriveProtocol.IsChip(ProtocolVan(p))))
                await ZetViaBron($"drive:{p.Positie}:firmware", _flashNaam);
        if (nietOpgeslagen.Count > 0)
            Toon($"Gelezen maar niet opgeslagen: het producttype heeft geen attribuut met bron {string.Join("/", nietOpgeslagen)} " +
                 "(instellen bij Producten ▸ Attributen ▸ Automatisch gevuld uit).", true);
        var bestand = GekozenFirmware?.FirmwareBestand ?? _firmwareNaam;
        var tekst = $"Firmware geladen ({_chip.ToUpper()}): {_flashNaam}" +
                    (bestand.Length > 0 && bestand != _flashNaam ? $" ({bestand})" : "") +
                    (stukken.Count > 0 ? " — " + string.Join(", ", stukken) : "");
        await Repo.VoegHistorieToeAsync(ProductId, tekst, SoortId("Firmware") ?? _soortId, Ik.WerknemerId, uitkomst: true);
        _attributen = await Repo.GetAttributenAsync(ProductId);
        _flashResultaat = $"firmware {_flashNaam}" + (stukken.Count > 0 ? ", " + string.Join(", ", stukken) : "");
    }

    // ---------------------------------------------------------------- duurtest

    private bool _duurBezig;
    private string? _duurFout;
    private DuurtestService.Resultaat? _duurResultaat;
    private List<string> _duurRegels = new();

    /// <summary>Logmap van de testrig-PLC ophalen (server-side FTP), zippen en als document bij het exemplaar zetten.</summary>
    private async Task HaalDuurtestLog()
    {
        if (_duurBezig) return;
        _duurBezig = true; _duurFout = null; _duurResultaat = null; _duurRegels = new();
        try
        {
            _duurResultaat = await Duurtest.HaalLogAsync(ProductId, Naam.Naam, Exemplaar.Serienummer, Ik.WerknemerId ?? 0,
                regel => { _duurRegels.Add($"{DateTime.Now:HH:mm:ss} {regel}"); InvokeAsync(StateHasChanged); });
            Toon($"Duurtestlog opgeslagen: {_duurResultaat.Bestandsnaam}", false);
        }
        catch (Exception ex)
        {
            _duurFout = ex.Message;
            _duurRegels.Add($"{DateTime.Now:HH:mm:ss} FOUT: {ex.Message}");
            try
            {
                await Repo.VoegHistorieToeAsync(ProductId, $"Duurtest: log ophalen MISLUKT — {ex.Message}",
                    ProductVelden.HistorieLevensloop, Ik.WerknemerId, uitkomst: false);
            }
            catch { }
        }
        finally { _duurBezig = false; await Gewijzigd(); }
    }

    // ---------------------------------------------------------------- hulpjes

    private int? SoortId(string bevat)
        => _soorten.FirstOrDefault(s => s.Naam.Contains(bevat, StringComparison.OrdinalIgnoreCase))?.Id;

    private async Task<bool> Bevestig(string vraag)
    {
        try { return await JS.InvokeAsync<bool>("mdeBevestig", vraag); }
        catch { return true; }
    }

    private static string Tekst(JsonElement e, string naam)
    {
        if (e.ValueKind != JsonValueKind.Object || !e.TryGetProperty(naam, out var v)) return "";
        return v.ValueKind switch
        {
            JsonValueKind.String => v.GetString()?.Trim() ?? "",
            JsonValueKind.Number => v.GetRawText(),
            _ => ""
        };
    }

    private static int Getal(JsonElement e, string naam)
        => e.ValueKind == JsonValueKind.Object && e.TryGetProperty(naam, out var v) && v.ValueKind == JsonValueKind.Number && v.TryGetInt32(out var n) ? n : 0;

    private static string? FoutUit(string json)
    {
        try
        {
            using var doc = JsonDocument.Parse(json);
            return doc.RootElement.TryGetProperty("fout", out var f) ? f.GetString() : null;
        }
        catch { return null; }
    }

    private sealed class AgentAntwoord
    {
        public int status { get; set; }
        public string tekst { get; set; } = "";
    }

    /// <summary>Een verzoek aan de werkplek-agent op deze pc, via de browser. Body = JSON → POST.
    /// Met eigen time-out: zonder CancellationToken breekt Blazor een JS-aanroep na 60 s af.</summary>
    private async ValueTask<AgentAntwoord> Agent(string pad, int seconden, string? body = null)
    {
        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(seconden + 15));
        try
        {
            return await JS.InvokeAsync<AgentAntwoord>("mdeAgent.haal", cts.Token, _agentUrl + pad, seconden, _agentToken, body);
        }
        catch (OperationCanceledException)
        {
            return new AgentAntwoord { status = 0, tekst = $"time-out: de agent antwoordde niet binnen {seconden} s" };
        }
        catch (JSException ex)
        {
            return new AgentAntwoord { status = 0, tekst = "aanroep van de agent mislukt: " + ex.Message };
        }
    }

    private void Toon(string tekst, bool fout) { _melding = tekst; _fout = fout; }

    public void Dispose()
    {
        _flashStop?.Cancel();
        _flashStop?.Dispose();
        _taakStop?.Cancel();
        _taakStop?.Dispose();
        _encStop?.Cancel();
    }
}
