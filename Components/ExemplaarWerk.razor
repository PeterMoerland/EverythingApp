    private void OpenSerieel() { _serOpen = true; _serStatus = ""; }

    private async Task StartSerieel()
    {
        if (_serLoopt) return;
        _serLoopt = true; _serStatus = "poort openen …";
        _serStop = new CancellationTokenSource();
        var ct = _serStop.Token;
        try
        {
            var body = JsonSerializer.Serialize(new { poort = _serPoort, baud = _serBaud, seconden = _serSeconden, reset = _serReset });
            var start = await Agent("/taken/serieel.monitor", 30, body);
            if (start.status != 202)
            {
                _serStatus = start.status switch
                {
                    404 => "de agent kent serieel.monitor niet (agent bijwerken naar 1.13)",
                    409 => "er loopt al een taak bij de agent",
                    _ => FoutUit(start.tekst) ?? $"agent antwoordde {start.status}",
                };
                return;
            }
            using (var doc = JsonDocument.Parse(start.tekst)) _serJobId = doc.RootElement.GetProperty("job").GetString();
            var vanaf = 0;
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(300, ct);
                var st = await Agent($"/jobs/{_serJobId}/uitvoer?vanaf={vanaf}", 10);
                if (st.status != 200) continue;
                using var d = JsonDocument.Parse(st.tekst);
                var w = d.RootElement;
                var nieuw = false;
                if (w.TryGetProperty("regels", out var regels) && regels.ValueKind == JsonValueKind.Array)
                    foreach (var r in regels.EnumerateArray())
                        if (r.GetString() is { } tekst)
                        {
                            _serRegels.Add(tekst.StartsWith("» ", StringComparison.Ordinal) ? (tekst[2..], true) : (tekst, false));
                            nieuw = true;
                        }
                vanaf = Getal(w, "totaal");
                if (_serRegels.Count > 3000) _serRegels.RemoveRange(0, _serRegels.Count - 3000);
                var stand = Tekst(w, "stand");
                _serStatus = stand == "bezig" ? $"verbonden ({Tekst(w, "poort")} · {vanaf} regels)" : stand;
                if (stand == "klaar") { _serStatus = "gestopt"; break; }
                if (stand == "mislukt") { _serStatus = "fout: " + Tekst(w, "fout"); break; }
                StateHasChanged();
                if (nieuw && _serAutoScroll)
                {
                    await Task.Yield();
                    try { await JS.InvokeVoidAsync("mdeConsole.onder", "prod-console"); } catch { }
                }
            }
        }
        catch (TaskCanceledException) { _serStatus = "gestopt"; }
        catch (Exception ex) { _serStatus = "fout: " + ex.Message; }
        finally
        {
            _serLoopt = false;
            _serStop?.Dispose(); _serStop = null;
            StateHasChanged();
        }
    }

    private async Task StopSerieel()
    {
        if (_serJobId is not null)
            try { await Agent($"/jobs/{_serJobId}/stop", 10, "{}"); } catch { }
        _serStop?.Cancel();
    }

