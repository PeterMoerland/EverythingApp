    }

    private async Task LeesDictionary(DrivePositie p)
    {
        var body = JsonSerializer.Serialize(new { positie = p.Positie, grondig = _odGrondig });
        await VoerTaakUit("coe.scan", body, $"Drive {p.Positie} ({p.Naam}): objectdictionary lezen", 1500, res =>
        {
            var lijst = new List<OdRegel>();
            if (res.ValueKind == JsonValueKind.Object && res.TryGetProperty("objecten", out var objs) && objs.ValueKind == JsonValueKind.Array)
                foreach (var o in objs.EnumerateArray())
                    lijst.Add(new OdRegel(Tekst(o, "index"), Getal(o, "sub"), Tekst(o, "naam"), Tekst(o, "type"), Tekst(o, "toegang"),
                                          Tekst(o, "waarde"), Tekst(o, "hex"), Tekst(o, "fout")));
            _od = lijst; _odVoorPositie = p.Positie;
            return Task.FromResult($"{lijst.Count} objecten/subindexen gelezen, {lijst.Count(r => r.Fout.Length > 0)} niet leesbaar");
        });
        await VulEsiNamen(p);
        VulHandleidingNamen();
    }

    /// <summary>Namen, typen en toegang uit het ESI-bestand van dit controllertype bij de gelezen objecten zetten.</summary>
    private async Task VulEsiNamen(DrivePositie p)
    {
        if (_od.Count == 0) return;
        var esiId = _alleFirmwares.Where(f => f.DriveTypeId == p.DriveTypeId && f.EsiFileId is not null)
                                  .OrderBy(f => f.Status == DriveStatus.Actueel ? 0 : 1).Select(f => f.EsiFileId).FirstOrDefault();
        if (esiId is null) { _taakRegels.Add("Geen ESI-bestand bij dit controllertype (Controllertypen en firmware ▸ ESI): namen uit het ESI blijven leeg."); return; }
        try
        {
            var gevonden = await Store.ZoekAsync(esiId.Value);
            if (gevonden is null) { _taakRegels.Add("ESI-bestand niet gevonden in de filestore."); return; }
            var doc = System.Xml.Linq.XDocument.Load(gevonden.Value.Pad);
            var namen = new Dictionary<string, (string Naam, string Type, string Toegang)>(StringComparer.OrdinalIgnoreCase);
            foreach (var obj in doc.Descendants("Object"))
            {
                var index = (obj.Element("Index")?.Value ?? "").Trim();
                if (!index.StartsWith("#x", StringComparison.OrdinalIgnoreCase)) continue;
                index = "0x" + index[2..].ToUpperInvariant().PadLeft(4, '0');
                var naam = (obj.Element("Name")?.Value ?? "").Trim();
                var type = (obj.Element("Type")?.Value ?? "").Trim();
                var toegang = (obj.Element("Flags")?.Element("Access")?.Value ?? "").Trim();
                namen[index + ":0"] = (naam, type, toegang);
                var subs = obj.Element("Info")?.Elements("SubItem").ToList() ?? new();
                for (var i = 0; i < subs.Count; i++)
                {
                    var subNaam = (subs[i].Element("Name")?.Value ?? "").Trim();
                    namen[$"{index}:{i}"] = (naam + " · " + subNaam, type, toegang);
                }
            }
            _od = _od.Select(r =>
            {
                if (namen.TryGetValue($"{r.Index}:{r.Sub}", out var n))
                    return r with { Naam = n.Naam, Type = r.Type.EndsWith(" B") ? $"{n.Type} ({r.Type})" : n.Type, Toegang = n.Toegang.Length > 0 ? n.Toegang : r.Toegang };
                if (namen.TryGetValue($"{r.Index}:0", out var o0))
                    return r with { Naam = o0.Naam + $" · sub {r.Sub}", Type = r.Type };
                return r with { Naam = "(niet in ESI)" };
            }).ToList();
            var onbekend = _od.Count(r => r.Naam == "(niet in ESI)");
            _taakRegels.Add($"Namen uit ESI '{gevonden.Value.Naam}': {_od.Count - onbekend} bekend, {onbekend} niet in het ESI.");
        }
        catch (Exception ex) { _taakRegels.Add("ESI lezen mislukt: " + ex.Message); }
    }

    /// <summary>Tweede bron: de objectbeschrijvingen uit de eRob-handleiding (Templates\erob-objecten.json), met toegang en Backup-vlag.</summary>
    private void VulHandleidingNamen()
    {
        if (_od.Count == 0) return;
        try
        {
            var pad = Path.Combine(AppContext.BaseDirectory, "Templates", "erob-objecten.json");
            if (!File.Exists(pad)) return;
            using var doc = JsonDocument.Parse(File.ReadAllText(pad));
            var lijst = new Dictionary<string, (string Naam, string Type, string Toegang, bool Backup)>(StringComparer.OrdinalIgnoreCase);
            foreach (var o in doc.RootElement.GetProperty("objecten").EnumerateArray())
                lijst[$"{Tekst(o, "index")}:{Getal(o, "sub")}"] = (Tekst(o, "naam"), Tekst(o, "type"), Tekst(o, "toegang"),
                    o.TryGetProperty("backup", out var b) && b.ValueKind == JsonValueKind.True);
            var extra = 0;
            _od = _od.Select(r =>
            {
                if (!lijst.TryGetValue($"{r.Index}:{r.Sub}", out var h)) return r.Naam.Length == 0 ? r with { Naam = "(niet in ESI)" } : r;
                var uitEsi = r.Naam.Length > 0 && r.Naam != "(niet in ESI)" && !r.Naam.EndsWith($" · sub {r.Sub}");
                if (!uitEsi) extra++;
                var toegang = h.Toegang + (h.Backup ? " B" : "");
                return r with
                {
                    Naam = uitEsi ? r.Naam : h.Naam + " (handleiding)",
                    Type = r.Type.EndsWith(" B") ? $"{h.Type} ({r.Type})" : r.Type,
                    Toegang = toegang,
                };
            }).ToList();
            var rest = _od.Count(r => r.Naam == "(niet in ESI)");
            _taakRegels.Add($"Handleiding (hoofdstuk 8): {extra} extra benoemd, toegang/backup aangevuld; {rest} objecten in ESI noch handleiding.");
        }
        catch (Exception ex) { _taakRegels.Add("erob-objecten.json lezen mislukt: " + ex.Message); }
    }

    // ---- CAN meeluisteren (tweede USBCAN parallel op de bus van eRob-Studio) ----
    private sealed record CanRegel(double T, int Node, string Richting, string Index, int Sub, string Waarde, string Hex, string Protocol = "canopen", string Naam = "");
    private List<CanRegel> _can = new();
    private int _canSeconden = 30, _canBaud = 1000, _canKanaal;

    private string NaamVoor(CanRegel c)
    {
        if (c.Protocol == "erob") return c.Naam.Length > 0 ? c.Naam : "(eRob CAN-protocol, niet in handleiding)";
        var r = _od.FirstOrDefault(x => x.Index.Equals(c.Index, StringComparison.OrdinalIgnoreCase) && x.Sub == c.Sub);
        return r is null ? "(niet in scan)" : r.Naam;
    }

    private async Task StartCanSniff()
    {
        var body = JsonSerializer.Serialize(new { seconden = _canSeconden, baud = _canBaud, kanaal = _canKanaal });
        await VoerTaakUit("can.meeluisteren", body, $"CAN meeluisteren ({_canSeconden} s, {_canBaud} kbit)", _canSeconden + 60, res =>
        {
            var lijst = new List<CanRegel>();
            if (res.ValueKind == JsonValueKind.Object && res.TryGetProperty("sdo", out var sdos) && sdos.ValueKind == JsonValueKind.Array)
                foreach (var s in sdos.EnumerateArray())
                {
                    var t = s.TryGetProperty("t", out var tv) && tv.ValueKind == JsonValueKind.Number ? tv.GetDouble() : 0;
                    var waarde = Tekst(s, "waarde");
                    if (s.TryGetProperty("signed", out var sg) && sg.ValueKind == JsonValueKind.Number && sg.GetRawText() != waarde) waarde += $" (signed {sg.GetRawText()})";
                    lijst.Add(new CanRegel(t, Getal(s, "node"), Tekst(s, "richting"), Tekst(s, "index"), Getal(s, "sub"), waarde, Tekst(s, "hex"),
                                           Tekst(s, "protocol") is { Length: > 0 } pr ? pr : "canopen", Tekst(s, "naam")));
                }
            _can = lijst;
            var frames = Getal(res, "frames");
            var bestand = res.ValueKind == JsonValueKind.Object ? Tekst(res, "bestand") : "";
            var gestopt = res.ValueKind == JsonValueKind.Object && res.TryGetProperty("gestopt", out var g) && g.ValueKind == JsonValueKind.True;
            return Task.FromResult($"{(gestopt ? "gestopt na " : "")}{frames} frames, {lijst.Count} berichten ({lijst.Count(c => c.Richting is "download" or "schrijf" or "commando")} geschreven door eRob-Studio)"
                                   + (bestand.Length > 0 ? $" · alle frames: {bestand}" : ""));
        });
    }

    // ---- EtherCAT node-adressen (station alias) — agenttaak ecat.alias
    private sealed class AliasRegel
    {
        public int Positie;
        public string Naam = "", ProductCode = "", Melding = "";
        public int? Alias, AliasEeprom, AliasRegister, Nieuw;
        public bool Geschreven;
    }
    private bool _aliasOpen;
    private List<AliasRegel> _aliasSlaves = new();
    private string _aliasSamenvatting = "";
    private IEnumerable<AliasRegel> AliasWijzigingen => _aliasSlaves.Where(a => a.Nieuw is int n && n != a.Alias);

    private async Task OpenAlias()
    {
        _aliasOpen = true;
        if (_aliasSlaves.Count == 0) await LeesAlias();
    }

    private void VulAlias(JsonElement res)
    {
        var lijst = new List<AliasRegel>();
        if (res.ValueKind == JsonValueKind.Object && res.TryGetProperty("slaves", out var sl) && sl.ValueKind == JsonValueKind.Array)
            foreach (var s in sl.EnumerateArray())
            {
                int? G(string n) => s.TryGetProperty(n, out var v) && v.ValueKind == JsonValueKind.Number && v.TryGetInt32(out var i) ? i : null;
                var oud = _aliasSlaves.FirstOrDefault(a => a.Positie == Getal(s, "positie"));
                lijst.Add(new AliasRegel
                {
                    Positie = Getal(s, "positie"), Naam = Tekst(s, "naam"), ProductCode = Tekst(s, "product_code"),
                    Alias = G("alias"), AliasEeprom = G("alias_eeprom"), AliasRegister = G("alias_register"),
                    Geschreven = s.TryGetProperty("geschreven", out var g) && g.ValueKind == JsonValueKind.True,
                    Melding = Tekst(s, "melding"),
                    Nieuw = oud?.Nieuw is int n && n != G("alias") && !(s.TryGetProperty("geschreven", out var g2) && g2.ValueKind == JsonValueKind.True) ? n : null
                });
            }
        _aliasSlaves = lijst;
        _aliasSamenvatting = lijst.Count == 0 ? "" : string.Join(" · ", lijst.Select(a => $"{a.Positie}: {(a.Alias?.ToString() ?? "?")}"));
    }

