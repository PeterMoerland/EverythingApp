    /// <summary>Een test op de print uitvoeren via de agent; uitkomst in de historie.</summary>
    private async Task StartTest()
    {
        // Meekijken staat niet in _testen (geen test); eerst afhandelen, anders stopt de controle hieronder hem.
        if (_testCode.StartsWith("monitor:", StringComparison.Ordinal)) { _taakIsTest = false; await StartMonitor(); return; }
        var test = _testen.FirstOrDefault(t => t.Code == _testCode);
        if (test.Code is null) return;
        _taakIsTest = true;
        if (_testCode.StartsWith("recept:", StringComparison.Ordinal)) { _mdeWaarden = new(); _mdeReeks = new(); await StartRecept(); return; }
        if (IsStroomlus) { await StartStroomlus(); await LaadTestHistorie(); return; }
        if (_testCode == "encodertest") { await StartEncodertest(); return; }
        if (_testCode == "phasing") { await StartPhasingTest(); return; }
        if (_testCode == "dualmotion") { await StartDualmotion(); return; }
        if (_testCode == "motiontest") { await StartMotiontest(); return; }
        var body = JsonSerializer.Serialize(new
        {
            test = test.Code, serienummer = Exemplaar.Serienummer, product = Naam.Naam,
            posities = DrivePosities.Count, uitgangen = _uitgangenPerDrive
        });
        await VoerTaakUit("test.uitvoeren", body, test.Naam, 600, async res =>
        {
            var geslaagd = res.ValueKind == JsonValueKind.Object && res.TryGetProperty("geslaagd", out var g) && g.ValueKind == JsonValueKind.True;
            var samenvatting = res.ValueKind == JsonValueKind.Object ? Tekst(res, "samenvatting") : "";
            // De concrete fouten (welke drive/uitgang/ingang) horen in de historie, niet alleen een telling.
            if (res.ValueKind == JsonValueKind.Object && res.TryGetProperty("fouten", out var fl) && fl.ValueKind == JsonValueKind.Array)
            {
                var fouten = fl.EnumerateArray().Select(f => f.GetString() ?? "").Where(f => f.Length > 0).ToList();
                if (fouten.Count > 0)
                    samenvatting += (samenvatting.Length > 0 ? ": " : "") + string.Join("; ", fouten.Take(8)) + (fouten.Count > 8 ? $" (+{fouten.Count - 8})" : "");
            }

            // Sommige testen (IO-test: LED's op de rig) vragen om een oordeel van de operator.
            if (geslaagd && res.ValueKind == JsonValueKind.Object &&
                res.TryGetProperty("operator_bevestiging", out var ob) && ob.ValueKind == JsonValueKind.True)
            {
                if (!await Bevestig($"{test.Naam}: teruglezen was in orde.\n\nHebben alle LED's op de testrig één voor één gebrand?"))
                {
                    geslaagd = false;
                    samenvatting = (samenvatting.Length > 0 ? samenvatting + "; " : "") + "operator: niet alle LED's gezien";
                }
            }
            foreach (var p in DrivePosities) _uitgangen[p.Positie] = 0;
            await Repo.VoegHistorieToeAsync(ProductId,
                $"{test.Naam}: {(geslaagd ? "GESLAAGD" : "MISLUKT")}" + (samenvatting.Length > 0 ? " — " + samenvatting : "") + Opm(),
                SoortId("Test"), Ik.WerknemerId, uitkomst: geslaagd);
            _testLaatste = $"{test.Naam} {(geslaagd ? "GESLAAGD" : "MISLUKT")}";
            if (!geslaagd) throw new InvalidOperationException(samenvatting.Length > 0 ? samenvatting : "test niet geslaagd");
            return samenvatting.Length > 0 ? samenvatting : "geslaagd";
        });
        await LaadTestHistorie();
    }

