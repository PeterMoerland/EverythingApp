    private static readonly string[] MdeKleuren = { "#e53935", "#ffb300", "#43a047", "#1e88e5", "#8e24aa", "#00acc1", "#f4511e", "#c0ca33" };

    private string? MdeKleur(string naam)
    {
        var i = _mdeGekozen.IndexOf(naam);
        return i < 0 ? null : MdeKleuren[i % MdeKleuren.Length];
    }

    private void WisselMdeLijn(string naam)
    {
        if (!_mdeGekozen.Remove(naam)) _mdeGekozen.Add(naam);
    }

    private RenderFragment MdeGrafiek() => __builder =>
    {
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        var tEind = _mdeReeks[^1].T;
        var tBegin = _mdeVenster > 0 ? Math.Max(_mdeReeks[0].T, tEind - _mdeVenster) : _mdeReeks[0].T;
        var reeks = _mdeReeks.Where(r => r.T >= tBegin).ToList();
        var tSpan = Math.Max(0.5, tEind - tBegin);
        string X(double t) => ((t - tBegin) / tSpan * 800).ToString("0.#", ci);

        // schaal per lijn of gezamenlijk; een vlakke lijn krijgt een kleine marge zodat hij in beeld blijft
        (double Min, double Max) Bereik(IEnumerable<double> w)
        {
            var l = w.ToList();
            if (l.Count == 0) return (0, 1);
            double lo = l.Min(), hi = l.Max();
            if (hi - lo < 1e-9) { lo -= 1; hi += 1; }
            var m = (hi - lo) * 0.08;
            return (lo - m, hi + m);
        }
        var lijnen = _mdeGekozen.Where(_mdeWaarden.ContainsKey).ToList();
        var perLijn = lijnen.ToDictionary(n => n, n => Bereik(reeks.Select(r => Lees(r.Waarden, n)).Where(v => v.HasValue).Select(v => v!.Value)));
        var samen = Bereik(perLijn.Values.SelectMany(b => new[] { b.Min, b.Max }));
        <svg class="prod-scope prod-mde-grafiek" viewBox="0 0 800 260" preserveAspectRatio="none">
            <rect x="0" y="0" width="800" height="260" fill="#111" />
            @for (var g = 1; g < 5; g++) { <line x1="0" y1="@(20 + g * 46)" x2="800" y2="@(20 + g * 46)" stroke="#333" stroke-width="1" /> }
            @foreach (var naam in lijnen)
            {
                var (lo, hi) = _mdeEigenSchaal ? perLijn[naam] : samen;
                string Y(double v) => (250 - (v - lo) / (hi - lo) * 230).ToString("0.#", ci);
                var punten = string.Join(" ", reeks.Where(r => Lees(r.Waarden, naam).HasValue).Select(r => X(r.T) + "," + Y(Lees(r.Waarden, naam)!.Value)));
                <polyline points="@punten" fill="none" stroke="@MdeKleur(naam)" stroke-width="1.6" vector-effect="non-scaling-stroke" />
            }
            @for (var i = 0; i < lijnen.Count; i++)
            {
                var naam = lijnen[i];
                var (lo, hi) = _mdeEigenSchaal ? perLijn[naam] : samen;
                var bereik = _mdeEigenSchaal ? $" ({lo.ToString("0.##", ci)} … {hi.ToString("0.##", ci)})" : "";
                @SvgTekst(6, 14 + i * 15, naam + bereik, MdeKleur(naam)!, 12, false, "start")
            }
            @if (!_mdeEigenSchaal)
            {
                @SvgTekst(794, 14, samen.Max.ToString("0.##", ci), "#aaa", 11, false, "end")
                @SvgTekst(794, 252, samen.Min.ToString("0.##", ci), "#aaa", 11, false, "end")
            }
            @SvgTekst(400, 252, $"{tSpan.ToString("0.0", ci)} s", "#888", 11)
        </svg>
    };

    /// <summary>Tussenstand van de agent: {"t": s, "waarden": {naam: waarde}} — tabel bijwerken en aan de reeks toevoegen.</summary>
    private void MdeLive(JsonElement res)
    {
        if (!res.TryGetProperty("waarden", out var w) || w.ValueKind != JsonValueKind.Object) return;
        var t = res.TryGetProperty("t", out var tt) && tt.ValueKind == JsonValueKind.Number ? tt.GetDouble() : 0;
        if (_mdeReeks.Count > 0 && Math.Abs(_mdeReeks[^1].T - t) < 1e-6) return;   // dezelfde meting nog eens gepolld
        var getallen = new Dictionary<string, double?>();
        foreach (var p in w.EnumerateObject())
        {
            double? g = p.Value.ValueKind == JsonValueKind.Number ? p.Value.GetDouble()
                      : p.Value.ValueKind == JsonValueKind.True ? 1 : p.Value.ValueKind == JsonValueKind.False ? 0 : null;
            getallen[p.Name] = g;
            _mdeWaarden[p.Name] = p.Value.ValueKind switch
            {
                JsonValueKind.Null => null,
                JsonValueKind.Number => p.Value.GetRawText(),
                _ => p.Value.ToString(),
            };
        }
        _mdeReeks.Add((t, getallen));
        if (!_mdeGekozen.Any(getallen.ContainsKey) && getallen.FirstOrDefault(kv => kv.Value.HasValue).Key is { } eerste) _mdeGekozen.Add(eerste);
        if (_mdeReeks.Count > 3000) _mdeReeks.RemoveRange(0, _mdeReeks.Count - 3000);
    }

    private static string MonitorCode(DrivePositie p) => "monitor:" + p.Positie;

    // ---- meekijk-objecten uit het ESI van het controllertype: alle PDO-objecten (wat de print meldt en wat hij krijgt) ----
    private sealed class EsiObject
    {
        public string Groep = "", Naam = "", Index = "", Type = "";
        public int Sub;
        public bool Aan;
    }
    private List<EsiObject> _esiObjecten = new();
    private string _esiBron = "";

    /// <summary>Datatypes uit het ESI die de agent kan lezen (mde._lees_waarde: TYPEN plus STRING).</summary>
    private static string? AgentType(string esiType)
    {
        var t = esiType.Trim().ToUpperInvariant();
        if (t.StartsWith("STRING")) return "STRING";
        return t is "BOOL" or "USINT" or "SINT" or "UINT" or "INT" or "UDINT" or "DINT" or "ULINT" or "LINT" or "REAL" ? t : null;
    }

    private static string EsiHex(string s)
    {
        s = s.Trim();
        if (s.StartsWith("#x", StringComparison.OrdinalIgnoreCase)) return "0x" + s[2..].ToUpperInvariant().PadLeft(4, '0');
        return int.TryParse(s, out var d) ? $"0x{d:X4}" : s;
    }

    private async Task LaadMonitorUitEsi(DrivePositie p)
    {
        _esiObjecten = new(); _esiBron = "";
        var fw = _alleFirmwares.Where(f => f.DriveTypeId == p.DriveTypeId && f.EsiFileId is not null)
                               .OrderBy(f => f.Status == DriveStatus.Actueel ? 0 : 1).FirstOrDefault();
        if (fw?.EsiFileId is null) { _esiBron = "Geen ESI-bestand bij dit controllertype (Controllertypen ▸ firmware ▸ ESI); vul de objecten hieronder zelf in."; return; }
        try
        {
            var gevonden = await Store.ZoekAsync(fw.EsiFileId.Value);
            if (gevonden is null) { _esiBron = "ESI-bestand niet gevonden in de filestore."; return; }
            var doc = System.Xml.Linq.XDocument.Load(gevonden.Value.Pad);
            var lijst = new List<EsiObject>();
            // TxPdo = wat de slave meldt (standen, druk, statusword): standaard aan. RxPdo = wat hij krijgt (doelen,
            // kleppen, controlword): ook te volgen, standaard uit.
            foreach (var (soort, groep, aan) in new[] { ("TxPdo", "Wat de print meldt (TxPDO)", true), ("RxPdo", "Wat de print krijgt (RxPDO)", false) })
                foreach (var pdo in doc.Descendants(soort))
                    foreach (var e in pdo.Elements("Entry"))
                    {
                        var index = EsiHex(e.Element("Index")?.Value ?? "");
                        if (index is "0x0000" or "") continue;                      // opvulbits
                        var type = AgentType(e.Element("DataType")?.Value ?? "");
                        if (type is null) continue;
                        var sub = int.TryParse((e.Element("SubIndex")?.Value ?? "0").Replace("#x", ""), System.Globalization.NumberStyles.HexNumber, null, out var s) ? s : 0;
                        if (lijst.Any(x => x.Index == index && x.Sub == sub)) continue;
                        lijst.Add(new EsiObject { Groep = groep, Index = index, Sub = sub, Type = type, Aan = aan,
                                                  Naam = (e.Element("Name")?.Value ?? $"{index}:{sub}").Trim() });
                    }
            // dubbele namen (Joint 1 in 0x6010 én 0x7010) onderscheiden
            foreach (var g in lijst.GroupBy(x => x.Naam).Where(g => g.Count() > 1))
                foreach (var x in g) x.Naam += x.Groep.Contains("krijgt") ? " (doel)" : " (stand)";
            _esiObjecten = lijst;
            _esiBron = $"{gevonden.Value.Naam} · {lijst.Count} objecten";
            if (lijst.Count > 0) ZetMonitorJson();
            else _esiBron += " — geen PDO-objecten gevonden; vul de objecten hieronder zelf in.";
        }
        catch (Exception ex) { _esiBron = "ESI lezen mislukt: " + ex.Message; }
    }

    private void ZetEsiObject(EsiObject o, bool aan) { o.Aan = aan; ZetMonitorJson(); }
    private void ZetEsiAlles(bool aan) { foreach (var o in _esiObjecten) o.Aan = aan; ZetMonitorJson(); }

    /// <summary>De aangevinkte ESI-objecten als objectenlijst voor de agent (zelfde vorm als het JSON-vak).</summary>
    private void ZetMonitorJson()
        => _monitorObjecten = JsonSerializer.Serialize(_esiObjecten.Where(o => o.Aan).Select(o => new { index = o.Index, sub = o.Sub, type = o.Type, naam = o.Naam }),
                                                        new JsonSerializerOptions { WriteIndented = true, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping });

    private int? MonitorPositie(string code)
        => code.StartsWith("monitor:", StringComparison.Ordinal) && int.TryParse(code[8..], out var p) ? p : null;

    private async Task StartMonitor()
    {
        if (MonitorPositie(_testCode) is not int pos) return;
        var p = DrivePosities.FirstOrDefault(x => x.Positie == pos);
        JsonElement objecten;
        try
        {
            objecten = JsonDocument.Parse(_monitorObjecten).RootElement.Clone();
            if (objecten.ValueKind != JsonValueKind.Array || objecten.GetArrayLength() == 0) { Toon("Geef een lijst objecten op.", true); return; }
        }
        catch (Exception ex) { Toon("De objectenlijst is geen geldige JSON: " + ex.Message, true); return; }
        _mdeWaarden = new(); _mdeReeks = new();
        var body = JsonSerializer.Serialize(new { positie = pos, objecten, seconden = _monitorSeconden });
        await VoerTaakUit("mde.monitor", body, $"Meekijken — slave {pos}{(p is null ? "" : $" ({p.Naam})")}", _monitorSeconden + 60,
            res => Task.FromResult(res.ValueKind == JsonValueKind.Object ? $"{Getal(res, "metingen")} metingen" : "klaar"), live: MdeLive);
    }

    private (DrivePositie Positie, DriveRecept Recept)? ReceptVan(string code)
    {
        var d = code.Split(':');
        if (d.Length != 3 || d[0] != "recept" || !int.TryParse(d[1], out var id) || !int.TryParse(d[2], out var pos)) return null;
        var x = _recepten.FirstOrDefault(r => r.Recept.Id == id && r.Positie.Positie == pos);
        return x.Recept is null ? null : x;
    }

    private async Task StartRecept()
    {
        if (ReceptVan(_testCode) is not { } rc) return;
        var (p, r) = rc;
        JsonElement stappen;
        try { stappen = JsonDocument.Parse(r.Stappen).RootElement.Clone(); }
        catch (Exception ex) { Toon("Het recept is geen geldige JSON: " + ex.Message, true); return; }
        var body = JsonSerializer.Serialize(new { positie = p.Positie, naam = r.Naam, stappen });
        var titel = $"{r.Naam} — slave {p.Positie} ({p.Naam})";
        await VoerTaakUit("mde.test", body, titel, 900, async res =>
        {
            var geslaagd = res.ValueKind == JsonValueKind.Object && res.TryGetProperty("geslaagd", out var g) && g.ValueKind == JsonValueKind.True;
            var samenvatting = res.ValueKind == JsonValueKind.Object ? Tekst(res, "samenvatting") : "";
            // per stap de uitkomst in het logboek van het venster
            if (res.ValueKind == JsonValueKind.Object && res.TryGetProperty("stappen", out var st) && st.ValueKind == JsonValueKind.Array)
                foreach (var s in st.EnumerateArray())
                    _taakRegels.Add($"{(s.TryGetProperty("geslaagd", out var ok) && ok.ValueKind == JsonValueKind.True ? "✓" : "✗")} {Tekst(s, "naam")}: {Tekst(s, "tekst")}");
            await Repo.VoegHistorieToeAsync(ProductId,
                $"{titel}: {(geslaagd ? "GESLAAGD" : "MISLUKT")}" + (samenvatting.Length > 0 ? " — " + samenvatting : "") + Opm(),
                SoortId("Test"), Ik.WerknemerId, uitkomst: geslaagd);
            _testLaatste = $"{r.Naam} {(geslaagd ? "GESLAAGD" : "MISLUKT")}";
            await LaadTestHistorie();
            if (!geslaagd) throw new InvalidOperationException(samenvatting.Length > 0 ? samenvatting : "recept niet geslaagd");
            return samenvatting;
        }, live: MdeLive);
    }

