    /// <summary>Gezamenlijke start voor de drive-testen: STO-popup, historie, 'laatste'.</summary>
    private async Task VoerDriveTestUit(string taak, string titel, object parameters, Func<JsonElement, string> verwerk)
    {
        Action<JsonElement>? live = taak == "drives.encodertest" ? EncoderLive : taak == "drives.motiontest" ? MotionLive : taak == "drives.phasing" ? PhasingLive : null;
        var p = DrivePosities.FirstOrDefault(x => x.Positie == _slPositie) ?? DrivePosities.FirstOrDefault(x => !IsCoe(x));
        var fw = p is null ? null : StroomlusFirmware(p.Positie);
        if (p is null || fw?.DictionaryFileId is null) return;
        _slPositie = p.Positie;
        var basis = new Dictionary<string, object?> { ["positie"] = p.Positie, ["dictionary"] = BestandUrl(fw.DictionaryFileId.Value) };
        foreach (var prop in parameters.GetType().GetProperties()) basis[prop.Name] = prop.GetValue(parameters);
        _taakIsTest = true;
        var naam = $"{titel} drive {p.Positie} ({p.Naam})";
        await VoerTaakUit(taak, JsonSerializer.Serialize(basis), naam, 900, async res =>
        {
            if (res.ValueKind != JsonValueKind.Object) throw new InvalidOperationException("geen resultaat");
            if (res.TryGetProperty("sto_ontbreekt", out var sto) && sto.ValueKind == JsonValueKind.True)
            {
                var tekst = Tekst(res, "samenvatting");
                _testLaatste = $"{titel} AFGEBROKEN (STO)";
                try { await JS.InvokeVoidAsync("mdeMelding", tekst, "⛔ STO niet vrijgegeven — test afgebroken"); } catch { }
                throw new InvalidOperationException(tekst);
            }
            var geslaagd = res.TryGetProperty("geslaagd", out var g) && g.ValueKind == JsonValueKind.True;
            var samenvatting = verwerk(res);
            _testLaatste = $"{titel} drive {p.Positie} {(geslaagd ? "GESLAAGD" : "AFGEKEURD")}";
            await Repo.VoegHistorieToeAsync(ProductId, $"{naam}: {(geslaagd ? "GESLAAGD" : "AFGEKEURD")} — {samenvatting}" + Opm(),
                                            SoortId("Test"), Ik.WerknemerId, uitkomst: geslaagd);
            if (!geslaagd) throw new InvalidOperationException(samenvatting);
            return samenvatting;
        }, live);
        await LaadTestHistorie();
    }

    private EncoderStand? _etLive;
    private List<(double T, double Dem, double Act)> _mtReeks = new();
    private int _mtInc = 131072;

    private void EncoderLive(JsonElement r)
    {
        double D(string n) => r.TryGetProperty(n, out var v) && v.ValueKind == JsonValueKind.Number ? v.GetDouble() : 0;
        var st = new EncoderStand
        {
            Positie = (long)D("positie"), Resolutie = Math.Max(1, (int)D("resolutie")), Singleturn = (int)D("singleturn"),
            Graden = D("graden"), Multiturn = (long)D("multiturn"), Fase = Tekst(r, "fase"),
        };
        if (r.TryGetProperty("start", out var sv) && sv.ValueKind == JsonValueKind.Number)
        {
            var start = sv.GetInt64();
            var single = ((start % st.Resolutie) + st.Resolutie) % st.Resolutie;
            st.StartGraden = single / (double)st.Resolutie * 360;
        }
        _etLive = st;
        StateHasChanged();
    }

    private void MotionLive(JsonElement r)
    {
        if (r.TryGetProperty("incrementen", out var iv) && iv.ValueKind == JsonValueKind.Number) _mtInc = Math.Max(1, iv.GetInt32());
        if (r.TryGetProperty("reeks", out var rk) && rk.ValueKind == JsonValueKind.Array)
        {
            var lijst = new List<(double, double, double)>();
            foreach (var punt in rk.EnumerateArray())
            {
                if (punt.ValueKind != JsonValueKind.Array) continue;
                var a = punt.EnumerateArray().Select(x => x.ValueKind == JsonValueKind.Number ? x.GetDouble() : 0).ToArray();
                if (a.Length >= 3) lijst.Add((a[0], a[1], a[2]));
            }
            if (lijst.Count > 0) _mtReeks = lijst;
        }
        StateHasChanged();
    }

    /// <summary>Rolgrafiek gewenste (rood) en gemeten (geel) positie, in omwentelingen t.o.v. de start; laatste ~10 s.</summary>
    private RenderFragment RolGrafiek(List<(double T, double Dem, double Act)> reeks, int inc) => __builder =>
    {
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        var venster = 10.0;
        var tMax = reeks.Count > 0 ? reeks[^1].T : venster;
        var tMin = Math.Max(0, tMax - venster);
        var zicht = reeks.Where(p => p.T >= tMin).ToList();
        var yMax = Math.Max(1.0, zicht.Count > 0 ? zicht.Max(p => Math.Max(Math.Abs(p.Dem), Math.Abs(p.Act))) / inc * 1.15 : 1.0);
        string X(double t) => ((t - tMin) / venster * 800).ToString("0.#", ci);
        string Y(double v) => (130 - v / inc / yMax * 120).ToString("0.#", ci);
        var dem = string.Join(" ", zicht.Select(p => X(p.T) + "," + Y(p.Dem)));
        var act = string.Join(" ", zicht.Select(p => X(p.T) + "," + Y(p.Act)));
        <svg class="prod-scope" viewBox="0 0 800 260" preserveAspectRatio="none">
            <rect x="0" y="0" width="800" height="260" fill="#111" />
            @for (var g = 1; g < 4; g++) { <line x1="0" y1="@(g * 65)" x2="800" y2="@(g * 65)" stroke="#333" stroke-width="1" /> }
            <line x1="0" y1="130" x2="800" y2="130" stroke="#555" stroke-width="1" />
            <polyline points="@dem" fill="none" stroke="#e53935" stroke-width="1.5" vector-effect="non-scaling-stroke" />
            <polyline points="@act" fill="none" stroke="#ffb300" stroke-width="1.5" vector-effect="non-scaling-stroke" />
            @SvgTekst(6, 14, "gewenst", "#e53935", 12, false, "start")
            @SvgTekst(66, 14, "gemeten", "#ffb300", 12, false, "start")
            @SvgTekst(794, 14, $"±{yMax.ToString("0.0", ci)} omw · {tMin.ToString("0", ci)}–{tMax.ToString("0", ci)} s", "#aaa", 12, false, "end")
        </svg>
    };

    private Task StartEncodertest() => VoerDriveTestUit("drives.encodertest", "Encodertest",
