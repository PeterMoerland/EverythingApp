    /// <summary>Drive-firmware (.lfu) via EtherCAT in de drive op deze positie laden.</summary>
    private async Task LaadDriveFirmware(DrivePositie p)
    {
        var k = Keuze(p.Positie);
        var fw = _alleFirmwares.FirstOrDefault(f => f.Id == k.FirmwareId);
        if (fw?.FirmwareFileId is null) return;
        if (fw.Status == DriveStatus.Geblokkeerd &&
            !await Bevestig($"Firmware {fw.Versie} is GEBLOKKEERD. Toch laden?")) return;

        // Eerst kijken wat er nu in de drive zit: zelfde versie → vragen, andere versie → meteen door.
        var huidig = await HuidigeFirmware(p);
        if (huidig.Length > 0 && VersieGelijk(huidig, fw.Versie) &&
            !await Bevestig($"Drive {p.Positie} ({p.Naam}) heeft al firmware {huidig}.\n\nToch opnieuw laden (duurt enkele minuten)?"))
            return;

        var body = JsonSerializer.Serialize(new
        {
            positie = p.Positie,
            firmware = BestandUrl(fw.FirmwareFileId.Value),
            versie = fw.Versie,
            bestandsnaam = fw.FirmwareBestand,
        });
        // Ingenia-drives via ingeniamotion; eigen MDE-slaves via FoE met pysoem (mde.firmware).
        var taak = IsMde(p) ? "mde.firmware" : "drives.firmware";
        await VoerTaakUit(taak, body, $"Firmware {fw.Versie} → drive {p.Positie} ({p.Naam})", 900, async res =>
        {
            // De agent leest na de herstart de versie terug uit de drive (bv. 2.10.0.000); die gaat het attribuut in.
            var gelezen = Tekst(res, "versie");
            var versie = gelezen.Length > 0 ? gelezen : fw.Versie;
            await ZetViaBron($"drive:{p.Positie}:firmware", versie);
            await Repo.VoegHistorieToeAsync(ProductId,
                $"Drive {p.Positie} ({p.Naam}): firmware {fw.Versie} geladen, drive meldt {versie}" + Opm(),
                SoortId("Firmware") ?? SoortId("Test"), Ik.WerknemerId, uitkomst: true);
            return $"firmware {versie} geladen en teruggelezen";
        });
    }

    /// <summary>
    /// Firmwareversie die nu in de drive zit: uit de laatste uitlezing, anders uit het attribuut
    /// (bron drive:n:firmware), anders een snelle uitlezing via de agent. Leeg = onbekend.
    /// </summary>
    private async Task<string> HuidigeFirmware(DrivePositie p)
    {
        var uitgelezen = _drives?.FirstOrDefault(d => d.Positie + 1 == p.Positie)?.Firmware ?? "";
        if (uitgelezen.Length > 0) return uitgelezen;
        var sj = _sjabloon.FirstOrDefault(s => string.Equals(s.Bron, $"drive:{p.Positie}:firmware", StringComparison.OrdinalIgnoreCase));
        if (sj is not null)
        {
            var a = _attributen.FirstOrDefault(x => x.SjabloonId == sj.Id)
                    ?? _attributen.FirstOrDefault(x => string.Equals(x.Attribuut, sj.Attribuut, StringComparison.OrdinalIgnoreCase));
            if (a?.Waarde.Trim() is { Length: > 0 } w) return w;
        }
        try
        {
            var antwoord = await Agent("/drives", 60);
            if (antwoord.status != 200) return "";
            using var doc = JsonDocument.Parse(antwoord.tekst);
            if (doc.RootElement.TryGetProperty("drives", out var drives) && drives.ValueKind == JsonValueKind.Array)
                foreach (var d in drives.EnumerateArray())
                    if (Getal(d, "slave_position") + 1 == p.Positie) return Tekst(d, "software_version");
        }
        catch { }
        return "";
    }

    /// <summary>'2.11.0' en '2.11.0.000' gelden als dezelfde versie: numerieke delen vergelijken, nullen aan het eind negeren.</summary>
    private static bool VersieGelijk(string a, string b)
    {
        static List<string> Delen(string v) => System.Text.RegularExpressions.Regex.Matches(v, @"\d+").Select(m => m.Value.TrimStart('0').Length == 0 ? "0" : m.Value.TrimStart('0')).ToList();
        var da = Delen(a); var db = Delen(b);
        if (da.Count == 0 || db.Count == 0) return string.Equals(a.Trim(), b.Trim(), StringComparison.OrdinalIgnoreCase);
        while (da.Count > 1 && da[^1] == "0") da.RemoveAt(da.Count - 1);
        while (db.Count > 1 && db[^1] == "0") db.RemoveAt(db.Count - 1);
        return da.SequenceEqual(db);
    }

    /// <summary>Parameterset in de drive schrijven en opslaan; de agent leest terug ter controle.</summary>
    private async Task LaadParameters(DrivePositie p)
    {
        var k = Keuze(p.Positie);
        var ps = _parametersets.FirstOrDefault(x => x.Id == k.ParametersId);
        var fw = _alleFirmwares.FirstOrDefault(f => f.Id == ps?.DriveFirmwareId);
        if (ps?.ParameterFileId is null) return;
        var naam = ps.Omschrijving.Length > 0 ? ps.Omschrijving : ps.ParameterBestand;

        if (IsCoe(p))
        {
            // eRob e.d.: JSON met SDO's; de agent schrijft, leest terug, bewaart (0x1010) en leest nog eens.
            var coeBody = JsonSerializer.Serialize(new { positie = p.Positie, parameters = BestandUrl(ps.ParameterFileId.Value) });
            await VoerTaakUit("coe.parameters", coeBody, $"Parameters '{naam}' → drive {p.Positie} ({p.Naam})", 200, async res =>
            {
                var afwijkingen = res.ValueKind == JsonValueKind.Object ? Getal(res, "afwijkingen") : 0;
                var registers = res.ValueKind == JsonValueKind.Object ? Getal(res, "registers") : 0;
                await ZetViaBron($"drive:{p.Positie}:parameters", naam);
                var fwGelezen = Tekst(res, "firmware");
                if (fwGelezen.Length > 0) await ZetViaBron($"drive:{p.Positie}:firmware", fwGelezen);
                await Repo.VoegHistorieToeAsync(ProductId,
                    $"Drive {p.Positie} ({p.Naam}): parameterset '{naam}' geladen ({registers} SDO's, {afwijkingen} afwijkingen)" + Opm(),
                    SoortId("Programmeren") ?? SoortId("Test"), Ik.WerknemerId, uitkomst: afwijkingen == 0);
                return afwijkingen == 0 ? $"{registers} SDO's geschreven, opgeslagen en gecontroleerd" : $"LET OP: {afwijkingen} afwijkingen na terugkijken";
            });
            return;
        }

        if (fw?.DictionaryFileId is null) return;
        var body = JsonSerializer.Serialize(new
        {
            positie = p.Positie,
            parameters = BestandUrl(ps.ParameterFileId.Value),
            dictionary = BestandUrl(fw.DictionaryFileId.Value),
            firmwareVersie = fw.Versie,
        });
        await VoerTaakUit("drives.parameters", body, $"Parameters '{naam}' → drive {p.Positie} ({p.Naam})", 300, async res =>
        {
            var afwijkingen = res.ValueKind == JsonValueKind.Object ? Getal(res, "afwijkingen") : 0;
            var registers = res.ValueKind == JsonValueKind.Object ? Getal(res, "registers") : 0;
            await ZetViaBron($"drive:{p.Positie}:parameters", naam);
            await Repo.VoegHistorieToeAsync(ProductId,
                $"Drive {p.Positie} ({p.Naam}): parameterset '{naam}' geladen ({registers} registers, {afwijkingen} afwijkingen)" + Opm(),
                SoortId("Programmeren") ?? SoortId("Test"), Ik.WerknemerId, uitkomst: afwijkingen == 0);
            return afwijkingen == 0 ? $"{registers} registers geschreven en gecontroleerd" : $"LET OP: {afwijkingen} registers wijken af na terugkijken";
        });
    }

