    private sealed class EncoderStand
    {
        public long Positie; public int Resolutie = 131072, Singleturn, N; public double Graden, Snelheid, T; public long Multiturn; public bool NabijGrens;
        public string Fase = ""; public double? StartGraden;
        public string FullFrame = "", PositionOffset = "", PositionActual = "", BissPosition = "";
        public string FullFrameUid = "", PositionOffsetUid = "", PositionActualUid = "", BissPositionUid = "", FullFrameDtype = "";
    }

    /// <summary>Wijzerplaat met de singleturn-hoek van een encoderstand (SVG).</summary>
    private RenderFragment WijzerPlaat(EncoderStand st) => __builder =>
    {
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        var nx = (78 * Math.Cos((st.Graden - 90) * Math.PI / 180)).ToString("0.0", ci);
        var ny = (78 * Math.Sin((st.Graden - 90) * Math.PI / 180)).ToString("0.0", ci);
        <svg class="prod-wijzer" viewBox="-110 -110 220 220">
            <circle cx="0" cy="0" r="100" fill="#111" stroke="#555" stroke-width="2" />
            @for (var g = 0; g < 360; g += 10)
            {
                var r1 = g % 90 == 0 ? 82 : g % 30 == 0 ? 88 : 94;
                var rad = (g - 90) * Math.PI / 180;
                <line x1="@((r1 * Math.Cos(rad)).ToString("0.0", ci))" y1="@((r1 * Math.Sin(rad)).ToString("0.0", ci))"
                      x2="@((98 * Math.Cos(rad)).ToString("0.0", ci))" y2="@((98 * Math.Sin(rad)).ToString("0.0", ci))"
                      stroke="@(g % 90 == 0 ? "#ddd" : "#777")" stroke-width="@(g % 90 == 0 ? 2 : 1)" />
            }
            @SvgTekst(0, -66, "0°", "#aaa", 11)
            @SvgTekst(70, 4, "90°", "#aaa", 11)
            @SvgTekst(0, 74, "180°", "#aaa", 11)
            @SvgTekst(-70, 4, "270°", "#aaa", 11)
            @if (st.StartGraden is double sg)
            {
                var sx = (90 * Math.Cos((sg - 90) * Math.PI / 180)).ToString("0.0", ci);
                var sy = (90 * Math.Sin((sg - 90) * Math.PI / 180)).ToString("0.0", ci);
                <circle cx="@sx" cy="@sy" r="4" fill="#4caf50" />
            }
            <line x1="0" y1="0" x2="@nx" y2="@ny" stroke="#ffb300" stroke-width="3" stroke-linecap="round" />
            <circle cx="0" cy="0" r="5" fill="#ffb300" />
            @SvgTekst(0, 36, st.Graden.ToString("0.00") + "°", "#fff", 20, true)
            @SvgTekst(0, 52, $"{st.Singleturn} / {st.Resolutie}", "#aaa", 10)
            @if (st.Fase.Length > 0)
            {
                @SvgTekst(0, -40, st.Fase, "#4caf50", 11)
            }
        </svg>
    };

    /// <summary>SVG-tekst als MarkupString: in een RenderFragment ziet Razor &lt;text&gt; als zijn eigen tag (RZ1023).</summary>
    private static MarkupString SvgTekst(double x, double y, string tekst, string kleur, int grootte, bool vet = false, string anker = "middle")
    {
        // Let op: de letterlijke tekenreeks van de SVG-teksttag mag nergens in @code staan (ook niet in een
        // C#-string of commentaar): Razor leest die als zijn eigen pseudo-tag. Daarom in stukjes opgebouwd.
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        const string tag = "te" + "xt";
        var sb = new System.Text.StringBuilder();
        sb.Append('<').Append(tag)
          .Append(" x=\"").Append(x.ToString("0.#", ci)).Append("\" y=\"").Append(y.ToString("0.#", ci))
          .Append("\" fill=\"").Append(kleur).Append("\" font-size=\"").Append(grootte).Append("\" text-anchor=\"").Append(anker).Append('"');
        if (vet) sb.Append(" font-weight=\"bold\"");
        sb.Append('>').Append(System.Net.WebUtility.HtmlEncode(tekst)).Append("</").Append(tag).Append('>');
        return new MarkupString(sb.ToString());
    }

