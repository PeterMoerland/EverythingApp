    private static string Groot(string t) => long.TryParse(t, out var v) ? v.ToString("N0", new System.Globalization.CultureInfo("nl-NL")) : t;
    /// <summary>Bitreeks in groepjes van vier, van rechts af (zoals in een bitviewer).</summary>
    private static string Groepen(string bits)
    {
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < bits.Length; i++)
        {
            if (i > 0 && (bits.Length - i) % 4 == 0) sb.Append(' ');
            sb.Append(bits[i]);
        }
        return sb.ToString();
    }
    private static MarkupString Hex(string t) => new(long.TryParse(t, out var v) ? $" <small>0x{(v & 0xFFFFFFFFL):X8}</small>" : "");
