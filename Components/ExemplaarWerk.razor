        var body = JsonSerializer.Serialize(new
        {
            positie = p.Positie, index = _sdoIndex, sub = _sdoSub, type = _sdoType,
            waarde = schrijven ? _sdoWaarde : "", opslaan = schrijven && _sdoOpslaan,
        });
        _sdoUitkomst = null;
        await VoerTaakUit("coe.sdo", body, $"SDO {_sdoIndex}:{_sdoSub} {(schrijven ? "schrijven" : "lezen")} — drive {p.Positie}", 60, async res =>
        {
            var gelezen = Tekst(res, "gelezen"); var ruw = Tekst(res, "ruw");
            _sdoUitkomst = $"{_sdoIndex}:{_sdoSub} = {gelezen} (ruw {ruw})" + (res.ValueKind == JsonValueKind.Object && res.TryGetProperty("opgeslagen", out var og) ? (og.GetBoolean() ? " · opgeslagen" : " · NIET opgeslagen") : "");
            if (schrijven)
                await Repo.VoegHistorieToeAsync(ProductId, $"Drive {p.Positie} ({p.Naam}): SDO {_sdoIndex}:{_sdoSub} ← {_sdoWaarde} ({_sdoType}), teruggelezen {gelezen}" + (_sdoOpslaan ? ", opgeslagen" : ""),
                    SoortId("Programmeren") ?? SoortId("Test"), Ik.WerknemerId, uitkomst: gelezen == _sdoWaarde ? true : null);
            return _sdoUitkomst;
        });
    }

